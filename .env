# ===========================================
# GCC WEB APPLICATION - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and update the values

# Database Configuration
DB_PASSWORD=GCC_Secure_DB_Password_2025!
DB_ROOT_PASSWORD=GCC_Root_Password_2025!

# JWT Configuration (REQUIRED - must be 64+ characters)
JWT_SECRET_KEY=GCC-JWT-Secret-Key-For-Docker-Deployment-2025-Must-Be-At-Least-64-Characters-Long-For-Security

# SMTP Configuration (for 2FA emails - using mock for now)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=demo@example.com
SMTP_PASSWORD=demo_password
SMTP_FROM_EMAIL=noreply@gcc-demo.com

# 2FA Configuration
ENABLE_2FA=true

# SMS Configuration (choose one: mock, twilio, textbelt)
SMS_PROVIDER=mock

# Twilio SMS Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TEST_PHONE_NUMBER=+1234567890

# TextBelt SMS Configuration (if using TextBelt)
TEXTBELT_API_KEY=your_textbelt_api_key_here

# Redis Configuration (optional)
REDIS_PASSWORD=GCC_Redis_Password_2025!

# Application URLs (update with your actual domain)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com