# ===========================================
# GCC WEB APPLICATION - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and update the values

# Database Configuration
DB_PASSWORD=your_secure_database_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here

# JWT Configuration (REQUIRED - must be 64+ characters)
JWT_SECRET_KEY=your-super-secret-jwt-key-must-be-at-least-64-characters-long-for-security-compliance

# SMTP Configuration (for 2FA emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# 2FA Configuration
ENABLE_2FA=true

# SMS Configuration (choose one: mock, twilio, textbelt)
SMS_PROVIDER=mock

# Twilio SMS Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TEST_PHONE_NUMBER=+1234567890

# TextBelt SMS Configuration (if using TextBelt)
TEXTBELT_API_KEY=your_textbelt_api_key_here

# Redis Configuration (optional)
REDIS_PASSWORD=your_secure_redis_password_here

# Application URLs (update with your actual domain)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com