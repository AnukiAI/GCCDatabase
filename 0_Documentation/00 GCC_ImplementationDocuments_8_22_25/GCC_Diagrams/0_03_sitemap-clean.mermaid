flowchart TD
    %% Main Sections
    subgraph MAIN ["GreenCircle Certification System"]
        PublicInterface["Public Interface"]
        AdminInterface["Administrative Interface"]
        AdminManagement["Admin Management"]
        UserAccess["User Access Levels"]
        APIIntegration["API Integration"]
    end
    
    %% Public Interface
    subgraph PUBLIC ["Public Interface"]
        CertificateList["Certificate List"]
        SingleCertView["Certificate View"]
        
        %% Certificate List Details
        subgraph CertListFeatures["Certificate List Features"]
            SearchFunc["Search Functionality"]
            FilterOptions["Filter Options"]
            CertTiles["Certificate Tiles"]
        end
        
        %% Filter Options Details
        subgraph FilterCategories["Filter Categories"]
            CertType["Certification Type"]
            ProdCat["Product Categories"]
            CompanyFilter["Company"]
            CountryFilter["Countries"]
            AddFilters["Additional Filters"]
        end
        
        %% Certificate View Details
        subgraph CertViewFeatures["Certificate View Features"]
            CertDetails["Certificate Details"]
            DownloadCert["Download Certificate"]
            ReturnButton["Close Button"]
        end
    end
    
    %% Administrative Interface
    subgraph ADMIN ["Administrative Interface"]
        Dashboard["Dashboard"]
        CertificatesAdmin["Certificates"]
        AddCertificate["Add Certificate"]
        EditDeleteCert["Edit/Delete Certificate"]
        ClientCerts["Client Certificates"]
        
        %% Dashboard Details
        subgraph DashboardFeatures["Dashboard Features"]
            AnalyticsDash["Analytics Dashboard"]
            PrebuiltExports["Prebuilt List Exports"]
        end
        
        %% Analytics Components
        subgraph AnalyticsComponents["Analytics Components"]
            ActiveCerts["Total Active Certificates"]
            CertsByType["Certificates by Type"]
            CompWithCerts["Companies with Certificates"]
            CertsByStatus["Certificates by Status"]
            ExpiringCerts["Expiring Certificates"]
        end
        
        %% Certificate Admin Components
        subgraph CertAdminFeatures["Certificate Admin Features"]
            CertListing["Certificate Listing"]
            ExportOptions["Export Options"]
            AddCertButton["Add Certificate Button"]
            EditOptions["Edit/Delete Options"]
            ViewToggle["List/Tile View Toggle"]
        end
    end
    
    %% Admin Management
    subgraph MANAGEMENT ["Admin Management"]
        AdminMain["Administration Main"]
        UsersRoles["Users & Roles"]
        CertTypes["Certificate Types"]
        ProductTypes["Product Types"]
        Tags["Tags"]
        
        %% Users Management
        subgraph UserFeatures["User Management Features"]
            AddUser["Add User"]
            EditDeleteUser["Edit/Delete User"]
            RoleManagement["Role Management"]
        end
        
        %% Certificate Types Management
        subgraph CertTypeFeatures["Certificate Type Features"]
            AddCertType["Add Certificate Type"]
            EditDeleteCertType["Edit Certificate Type"]
        end
        
        %% Product Types Management
        subgraph ProductTypeFeatures["Product Type Features"]
            AddProdType["Add Product Types"]
            EditDeleteProdType["Edit Product Types"]
        end
        
        %% Tags Management
        subgraph TagFeatures["Tag Features"]
            AddTags["Add Tags"]
            EditDeleteTags["Edit Tags"]
        end
    end
    
    %% User Access Levels
    subgraph ACCESS ["User Access Levels"]
        PublicUser["Public User"]
        ExternalUser["External User"]
        AnalystUser["Analyst"]
        AdminUser["Admin"]
        
        %% Access Details
        subgraph AccessDetails["Access Level Details"]
            PublicAccess["Public Certificate Access"]
            ClientAccess["Company-Specific Access"]
            AnalystAccess["Certificate Creation Access"]
            AdminAccess["Complete Admin Access"]
        end
    end
    
    %% API Integration
    subgraph API ["API Integration"]
        AmazonAPI["Amazon API Integration"]
        ProductIDMgmt["Product Identifier Management"]
        CertStatusUpdates["Certificate Status Updates"]
    end
    
    %% Main connections
    PublicInterface --> PUBLIC
    AdminInterface --> ADMIN
    AdminManagement --> MANAGEMENT
    UserAccess --> ACCESS
    APIIntegration --> API
    
    %% Public Interface Connections
    CertificateList --> CertListFeatures
    FilterOptions --> FilterCategories
    SingleCertView --> CertViewFeatures
    
    %% Admin Interface Connections
    Dashboard --> DashboardFeatures
    AnalyticsDash --> AnalyticsComponents
    CertificatesAdmin --> CertAdminFeatures
    
    %% Admin Management Connections
    UsersRoles --> UserFeatures
    CertTypes --> CertTypeFeatures
    ProductTypes --> ProductTypeFeatures
    Tags --> TagFeatures
    
    %% User Access Connections
    PublicUser --> PublicAccess
    ExternalUser --> ClientAccess
    AnalystUser --> AnalystAccess
    AdminUser --> AdminAccess
    
    %% Style the nodes
    classDef public fill:#d4edda,stroke:#28a745,color:#155724
    classDef admin fill:#d1ecf1,stroke:#0c5460,color:#0c5460
    classDef management fill:#f8d7da,stroke:#721c24,color:#721c24
    classDef access fill:#fff3cd,stroke:#856404,color:#856404
    classDef api fill:#e2e3e5,stroke:#383d41,color:#383d41
    classDef main fill:#f8f9fa,stroke:#6c757d,color:#343a40,font-weight:bold
    
    class PUBLIC,CertificateList,SingleCertView,CertListFeatures,FilterCategories,CertViewFeatures public
    class ADMIN,Dashboard,CertificatesAdmin,AddCertificate,EditDeleteCert,ClientCerts,DashboardFeatures,AnalyticsComponents,CertAdminFeatures admin
    class MANAGEMENT,AdminMain,UsersRoles,CertTypes,ProductTypes,Tags,UserFeatures,CertTypeFeatures,ProductTypeFeatures,TagFeatures management
    class ACCESS,PublicUser,ExternalUser,AnalystUser,AdminUser,AccessDetails access
    class API,AmazonAPI,ProductIDMgmt,CertStatusUpdates api
    class MAIN main
