%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontSize": "14px",
    "fontFamily": "Inter, Segoe UI, system-ui, sans-serif",
    "primaryColor": "#92C83E",
    "primaryTextColor": "#0F172A",
    "primaryBorderColor": "#4C7A1B",
    "lineColor": "#475467",
    "tertiaryColor": "#F6F8FA",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#D0D5DD"
  }
}}%%
flowchart LR
  %% Sources
  PU["Public Users"]
  AU["Admin Users"]
  EXT["External API Consumers"]
  AMZ["Amazon (Partner)"]

  %% Presentation
  subgraph PRES["Presentation"]
    direction TB
    PublicUI["Public UI"]
    AdminUI["Admin Portal"]
  end

  %% API
  subgraph API["API Gateway + Auth"]
    direction TB
    REST["REST API Gateway"]
    OAuth["OAuth2 / OIDC"]
    Rate["Rate Limiter / WAF"]
    subgraph EP["Endpoints"]
      direction LR
      EAuth["/auth"]
      ECert["/certificates"]
      EProd["/products"]
      ESrch["/search"]
      EAmz["/amazon"]
    end
  end

  %% Application
  subgraph APP["Application Services"]
    direction LR
    Views["Django Views / Controllers"]
    Biz["Business Services"]
    Valid["Validation / Sanitization"]
    Authz["Authorization Policies"]
    Cache["Read Cache (optional)"]
  end

  %% Data Access
  subgraph DAL["Data Access"]
    direction LR
    ORM["Django ORM"]
    QRY["Custom Query Services"]
  end

  %% Storage
  subgraph STORE["Storage"]
    direction LR
    DB[("PostgreSQL")]:::db
    Files["Object Storage (Certificates)"]
    Idx["Search Index (optional)"]
  end

  %% Ops
  subgraph OPS["Observability & DR"]
    direction LR
    Logs["Centralized Logs"]
    Trc["Tracing"]
    Met["Metrics / APM"]
    Bkp["Backups & DR"]
  end

  %% Flows
  PU --> PublicUI
  AU --> AdminUI
  PublicUI --> REST
  AdminUI --> REST
  EXT --> REST
  AMZ --> EAmz

  REST --> Rate --> EP
  REST --> OAuth --> Authz
  EP --> Views
  Views --> Biz
  Biz --> Valid
  Biz --> Authz
  Biz --> Cache
  Biz --> ORM
  Biz --> QRY

  ORM --> DB
  ORM --> Files
  QRY --> DB
  QRY --> Idx

  APP -.-> Logs
  APP -.-> Trc
  API -.-> Met
  STORE -.-> Bkp

  %% Styles
  classDef block fill:#FFFFFF,stroke:#D0D5DD,stroke-width:2px,color:#101828;
  classDef db fill:#FFFFFF,stroke:#8E44AD,stroke-width:3px;
  classDef group fill:#F8FAFC,stroke:#CBD5E1,stroke-width:2px;

  class PRES group
  class API group
  class APP group
  class DAL group
  class STORE group
  class OPS group
  class DB db
