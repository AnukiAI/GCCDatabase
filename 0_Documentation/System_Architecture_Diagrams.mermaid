%% 5. ETL Data Processing Flow
graph LR
    subgraph "Data Sources"
        Amazon[Amazon Product API]
        CSV[CSV Files]
        Excel[Excel Files]
        Database[External Databases]
    end
    
    subgraph "ETL Pipeline"
        Scheduler[ETL Scheduler]
        Config[ETL Configuration]
        Extractor[Data Extractor]
        Transformer[Data Transformer]
        Validator[Data Validator]
        Loader[Data Loader]
        Monitor[ETL Monitor]
    end
    
    subgraph "Target Systems"
        MainDB[(Main Database)]
        AuditDB[(Audit Database)]
        Cache[(Cache)]
        Alerts[Alert System]
    end
    
    subgraph "Quality Assurance"
        QualityRules[Quality Rules Engine]
        QualityReport[Quality Reports]
        AlertSystem[Alert Management]
    end
    
    Scheduler --> Config
    Config --> Extractor
    
    Amazon --> Extractor
    CSV --> Extractor
    Excel --> Extractor
    Database --> Extractor
    
    Extractor --> Transformer
    Transformer --> Validator
    Validator --> QualityRules
    QualityRules --> QualityReport
    QualityRules --> AlertSystem
    
    Validator --> Loader
    Loader --> MainDB
    Loader --> AuditDB
    Loader --> Cache
    
    Monitor --> Alerts
    AlertSystem --> Alerts

