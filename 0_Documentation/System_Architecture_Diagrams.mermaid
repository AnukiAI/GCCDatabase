%% 3. Database Entity Relationships
erDiagram
    Certificate {
        int Id PK
        string Number UK
        string Status
        date EffectiveDate
        date ExpirationDate
        string Location
        string Country
        int CompanyId FK
        int ProductId FK
        int CertificationTypeId FK
        int CreatedBy FK
        int UpdatedBy FK
    }
    
    Company {
        int Id PK
        string Name UK
        string ContactInfo
        string Location
        string Country
        boolean IsActive
    }
    
    Product {
        int Id PK
        string Name
        string Description
        int CategoryId FK
        int ProductTypeId FK
        int ProductSubcategoryId FK
        int CompanyId FK
        boolean IsActive
    }
    
    ProductCategory {
        int Id PK
        string Name UK
        string Description
        int SortOrder
        boolean IsActive
    }
    
    ProductType {
        int Id PK
        string Name
        int CategoryId FK
        int ParentId FK
        int Level
        int SortOrder
        boolean IsActive
    }
    
    ProductSubcategory {
        int Id PK
        string Name
        int ProductTypeId FK
        string Description
        int SortOrder
        boolean IsActive
    }
    
    ProductIdentifier {
        int Id PK
        int ProductId FK
        string IdentifierType
        string IdentifierValue
    }
    
    CertificationType {
        int Id PK
        string Name UK
        string AmazonCode
        string Description
        boolean IsActive
        int SortOrder
    }
    
    CustomField {
        int Id PK
        string Name
        string FieldType
        boolean IsRequired
        boolean IsVisible
        boolean IsPublic
        int CertificateTypeId FK
    }
    
    CustomFieldValue {
        int Id PK
        int CertificateId FK
        int FieldId FK
        string TextValue
        decimal NumberValue
        date DateValue
        boolean BooleanValue
    }
    
    User {
        int Id PK
        string Username UK
        string Email UK
        string Name
        string PasswordHash
        string Status
        boolean IsActive
        boolean IsStaff
        boolean IsSuperuser
    }
    
    Role {
        int Id PK
        string Name UK
        string Description
        boolean IsSystem
    }
    
    Permission {
        int Id PK
        string Name
        string Codename UK
        string Category
        string Description
    }
    
    Tag {
        int Id PK
        string Name UK
        string TagType
        string Description
        boolean IsActive
    }
    
    Certificate ||--|| Company : "belongs to"
    Certificate ||--|| Product : "describes"
    Certificate ||--|| CertificationType : "has type"
    Certificate ||--o{ CustomFieldValue : "has values"
    Certificate ||--o| User : "created by"
    Certificate ||--o| User : "updated by"
    Certificate }o--o{ Tag : "tagged with"
    
    Product ||--|| ProductCategory : "belongs to"
    Product ||--o{ ProductType : "has type"
    Product ||--o{ ProductSubcategory : "has subcategory"
    Product ||--o| Company : "owned by"
    Product ||--o{ ProductIdentifier : "has identifiers"
    Product }o--o{ Tag : "tagged with"
    
    ProductCategory ||--o{ ProductType : "contains"
    ProductType ||--o{ ProductSubcategory : "contains"
    ProductType ||--o| ProductType : "parent of"
    
    CustomFieldValue ||--|| CustomField : "references"
    CustomField ||--|| CertificationType : "belongs to"
    
    User }o--o{ Role : "has roles"
    User }o--o{ Company : "belongs to"
    Role }o--o{ Permission : "has permissions"

---

%% 4. Authentication & Authorization Flow
sequenceDiagram
    participant User
    participant Browser
    participant WebApp
    participant AuthMiddleware
    participant AzureB2C
    participant SessionStore
    participant AuthzService
    participant Controller
    
    User->>Browser: Access Protected Resource
    Browser->>WebApp: HTTP Request
    WebApp->>AuthMiddleware: Process Request
    
    alt Not Authenticated
        AuthMiddleware->>AzureB2C: Redirect to Login
        AzureB2C->>User: Login Form
        User->>AzureB2C: Credentials
        AzureB2C->>AuthMiddleware: Token Response
        AuthMiddleware->>SessionStore: Store User Claims
    else Already Authenticated
        AuthMiddleware->>SessionStore: Get User Claims
    end
    
    AuthMiddleware->>AuthzService: Check Authorization
    AuthzService->>AuthzService: Evaluate Policies
    
    alt Authorized
        AuthzService->>Controller: Allow Access
        Controller->>Browser: Requested Resource
    else Unauthorized
        AuthzService->>Browser: Access Denied (403)
    end

