%% 10. Performance & Scaling Architecture
graph TB
    subgraph "Load Balancing"
        DNS[DNS Load Balancing]
        LB[Application Load Balancer]
        HealthCheck[Health Checks]
    end
    
    subgraph "Application Tier"
        App1[App Instance 1]
        App2[App Instance 2]
        App3[App Instance N...]
        SessionStore[Distributed Session Store]
    end
    
    subgraph "Caching Layer"
        L1Cache[L1: Memory Cache]
        L2Cache[L2: Distributed Cache]
        CDN[CDN for Static Assets]
    end
    
    subgraph "Database Tier"
        Master[(Master Database)]
        ReadReplica1[(Read Replica 1)]
        ReadReplica2[(Read Replica 2)]
        DBProxy[Database Connection Pool]
    end
    
    subgraph "Monitoring & Analytics"
        APM[Application Performance Monitoring]
        Metrics[Performance Metrics]
        Alerts[Alert Management]
        Logs[Centralized Logging]
    end
    
    DNS --> LB
    LB --> HealthCheck
    HealthCheck --> App1
    HealthCheck --> App2
    HealthCheck --> App3
    
    App1 --> SessionStore
    App2 --> SessionStore
    App3 --> SessionStore
    
    App1 --> L1Cache
    App2 --> L1Cache
    App3 --> L1Cache
    L1Cache --> L2Cache
    CDN --> LB
    
    App1 --> DBProxy
    App2 --> DBProxy
    App3 --> DBProxy
    DBProxy --> Master
    DBProxy --> ReadReplica1
    DBProxy --> ReadReplica2
    Master --> ReadReplica1
    Master --> ReadReplica2
    
    App1 --> APM
    App2 --> APM
    App3 --> APM
    APM --> Metrics
    Metrics --> Alerts
    APM --> Logs