flowchart TD
    %% Updated User Entry Points
    subgraph "User Entry Points"
        PublicEntry(["🌐 Public User"])
        AdminEntry(["👨‍💼 Admin User"])
        AnalystEntry(["📊 Analyst User"])
        ClientEntry(["👤 Client User (No API)"])
        PartnerEntry(["🤝 Partner User (API Only)"])
    end
    
    %% Authentication Layer
    Login["🔐 Login Screen<br/>Azure AD B2C"]
    PartnerAuth["🎫 Partner Authentication<br/>OAuth2 + API Key"]
    
    %% Public User Flow (Unchanged)
    subgraph "Public User Flow"
        PublicHome["🌐 Public Database Home<br/>Active Certificates Only"]
        PublicSearch["🔍 Public Search<br/>Limited Results"]
        PublicCertDetail["📄 Certificate Detail<br/>Public View"]
        PublicDownload["📥 PDF Download<br/>Public Certificates"]
    end
    
    %% Client User Flow (Simplified - NO API)
    subgraph "Client User Flow (Web UI Only)"
        ClientCertList["📋 Client Certificate List<br/>Status Filtering"]
        ClientCertDetail["📄 Certificate Detail<br/>Client View"]
        ClientExport["📤 Certificate Export<br/>Assigned Certificates"]
        ClientStatusFilter["🎛️ Status Filter<br/>Active/Expired/Pending"]
        ClientProducts["📦 Products Page<br/>Handle Thousands of ASINs"]
    end
    
    %% Partner Flow (API Access Only)
    subgraph "Partner User Flow (API Only)"
        PartnerAPI["🔗 Partner API Access<br/>Amazon/Wayfair Specific"]
        PartnerCertAPI["📡 Certificate API<br/>GET/POST/PUT"]
        PartnerDataFilter["🔒 Partner Data Filter<br/>Segregated Access"]
        PartnerWebhook["📡 Webhook Notifications<br/>Certificate Updates"]
    end
    
    %% Administrative User Flow (Enhanced)
    subgraph "Admin User Flow"
        AdminDashboard["🏠 Admin Dashboard<br/>Full System View"]
        AdminReports["📊 Dashboard Reports<br/>No Cross-Company Analytics"]
        
        %% Certificate Management (Enhanced)
        subgraph "Certificate Management"
            AddCert["➕ Add Certificate<br/>Partner Assignment"]
            EditCert["✏️ Edit Certificate<br/>Status Type Control"]
            CertStatusMgmt["📋 Status Management<br/>Client Progression"]
            CertPartnerMgmt["🤝 Partner Assignment<br/>Amazon/Wayfair/None"]
        end
        
        %% Administration (Updated)
        subgraph "Administration"
            AdminSettings["⚙️ Administration Settings"]
            
            subgraph "User Management"
                UserManagement["👥 User Management<br/>Partner Association"]
                AddUser["➕ Add User<br/>Partner Assignment"]
                EditUser["✏️ Edit User<br/>Role & Partner"]
                RoleMgmt["🛡️ Role Management<br/>Partner-Specific"]
            end
            
            subgraph "Partner Management (NEW)"
                PartnerMgmt["🤝 Partner Management<br/>Amazon/Wayfair Config"]
                PartnerAPI_Config["🔧 Partner API Config<br/>Rate Limits & Permissions"]
                PartnerDataSeg["🔒 Data Segregation<br/>Access Control"]
            end
            
            subgraph "Reference Data Management"
                RefDataManagement["📚 Reference Data"]
                CertTypesMgmt["📄 Certificate Types<br/>Partner-Specific"]
                ProductHierarchy["🏗️ Product Hierarchy"]
                TagManagement["🏷️ Tag Management<br/>Visibility Control"]
                CompanyMgmt["🏢 Company Management<br/>Contact Field Split"]
            end
        end
    end
    
    %% Analyst User Flow (Read-Only)
    subgraph "Analyst User Flow"
        AnalystDashboard["📊 Analyst Dashboard<br/>Read-Only View"]
        AnalystCertList["📋 Certificate List<br/>Status Type Updates"]
        AnalystReports["📈 Reports<br/>Single Company Only"]
        AnalystStatusUpdate["📝 Status Type Update<br/>Client Progression"]
    end
    
    %% User Authentication Flows
    PublicEntry ==> PublicHome
    ClientEntry ==> Login
    AdminEntry ==> Login
    AnalystEntry ==> Login
    PartnerEntry ==> PartnerAuth
    
    %% Public Flow (Active Certificates Only)
    PublicHome ==> PublicSearch
    PublicSearch ==> PublicCertDetail
    PublicCertDetail ==> PublicDownload
    
    %% Client Flow (NO API ACCESS - Web UI Only)
    Login ==> |"Client User"| ClientStatusFilter
    ClientStatusFilter ==> ClientCertList
    ClientCertList ==> |"View"| ClientCertDetail
    ClientCertList ==> |"Export Assigned"| ClientExport
    ClientCertList ==> |"Many ASINs"| ClientProducts
    
    %% Partner Flow (API ACCESS ONLY)
    PartnerAuth ==> |"Authenticated"| PartnerDataFilter
    PartnerDataFilter ==> PartnerAPI
    PartnerAPI ==> PartnerCertAPI
    PartnerCertAPI -.-> PartnerWebhook
    
    %% Admin Flow
    Login ==> |"Admin User"| AdminDashboard
    AdminDashboard ==> AdminReports
    AdminDashboard ==> AdminSettings
    AdminDashboard ==> AddCert
    
    %% Certificate Management Flows
    AddCert ==> |"Set Partner"| CertPartnerMgmt
    AddCert ==> |"Set Status Type"| CertStatusMgmt
    EditCert ==> CertStatusMgmt
    EditCert ==> CertPartnerMgmt
    
    %% Admin Settings Flows
    AdminSettings ==> UserManagement
    AdminSettings ==> PartnerMgmt
    AdminSettings ==> RefDataManagement
    
    %% Partner Management (NEW)
    PartnerMgmt ==> PartnerAPI_Config
    PartnerMgmt ==> PartnerDataSeg
    
    %% User Management (Updated)
    UserManagement ==> AddUser
    UserManagement ==> EditUser
    UserManagement ==> RoleMgmt
    
    %% Reference Data (Updated)
    RefDataManagement ==> CertTypesMgmt
    RefDataManagement ==> ProductHierarchy
    RefDataManagement ==> TagManagement
    RefDataManagement ==> CompanyMgmt
    
    %% Analyst Flow
    Login ==> |"Analyst User"| AnalystDashboard
    AnalystDashboard ==> AnalystCertList
    AnalystDashboard ==> AnalystReports
    AnalystCertList ==> AnalystStatusUpdate
    
    %% REMOVED FLOWS (Deferred Features)
    %% Cross-company access flows - REMOVED
    %% Dynamic tag creation for external users - REMOVED
    %% General additional access requests - REMOVED
    %% Cross-company analytics - REMOVED
    
    %% Tag Visibility Rules (NEW)
    subgraph "Tag Visibility Control"
        PublicTagVis["❌ Public: No Internal Tags"]
        ClientTagVis["🎯 Client: Assigned Internal Tags Only"]
        InternalTagVis["👁️ Internal: All Internal Tags"]
    end
    
    PublicCertDetail --> PublicTagVis
    ClientCertDetail --> ClientTagVis
    AdminDashboard --> InternalTagVis
    AnalystDashboard --> InternalTagVis
    
    %% Status-Based Filtering (NEW)
    subgraph "Status-Based Access"
        PublicStatusAccess["✅ Public: Active Only"]
        ClientStatusAccess["📊 Client: Active/Expired + Assigned"]
        InternalStatusAccess["🔧 Internal: All Statuses"]
    end
    
    PublicSearch --> PublicStatusAccess
    ClientStatusFilter --> ClientStatusAccess
    AdminDashboard --> InternalStatusAccess
    
    %% Enhanced Styling
    classDef publicUser fill:#28a745,stroke:#1e7e34,color:white
    classDef clientUser fill:#ffc107,stroke:#d39e00,color:black
    classDef partnerUser fill:#0d6efd,stroke:#084298,color:white
    classDef adminUser fill:#dc3545,stroke:#b02a37,color:white
    classDef analystUser fill:#17a2b8,stroke:#138496,color:white
    classDef newFeature fill:#6f42c1,stroke:#59359a,color:white
    classDef removedFeature fill:#6c757d,stroke:#495057,color:white,stroke-dasharray: 5 5
    classDef apiOnly fill:#fd7e14,stroke:#e8590c,color:white
    classDef webOnly fill:#20c997,stroke:#198754,color:white
    
    class PublicEntry,PublicHome,PublicSearch,PublicCertDetail,PublicDownload,PublicTagVis,PublicStatusAccess publicUser
    class ClientEntry,ClientCertList,ClientCertDetail,ClientExport,ClientStatusFilter,ClientProducts,ClientTagVis,ClientStatusAccess clientUser
    class PartnerEntry,PartnerAuth,PartnerAPI,PartnerCertAPI,PartnerDataFilter,PartnerWebhook partnerUser
    class AdminEntry,AdminDashboard,AdminReports,AdminSettings,AddCert,EditCert adminUser
    class AnalystEntry,AnalystDashboard,AnalystCertList,AnalystReports,AnalystStatusUpdate analystUser
    class CertStatusMgmt,CertPartnerMgmt,PartnerMgmt,PartnerAPI_Config,PartnerDataSeg,CompanyMgmt newFeature
    class PartnerAPI,PartnerCertAPI,PartnerAuth apiOnly
    class Login,ClientCertList,ClientExport webOnly