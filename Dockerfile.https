# HTTPS-enabled Dockerfile for GCC Web Application
# Supports both development certificates and production certificates

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app

# Expose both HTTP and HTTPS ports
EXPOSE 8080
EXPOSE 8081

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Use the SDK image to build the application
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copy the project file and restore dependencies
COPY ["GCCWebApp.csproj", "."]
RUN dotnet restore "./GCCWebApp.csproj"

# Copy the rest of the source code
COPY . .
WORKDIR "/src/."

# Build the application
RUN dotnet build "./GCCWebApp.csproj" -c $BUILD_CONFIGURATION -o /app/build

# Publish the application
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./GCCWebApp.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# Generate development certificate (for dev/test environments)
FROM build AS devcert
RUN dotnet dev-certs https -ep /https/aspnetapp.pfx -p SecurePassword123!

# Final stage: runtime image
FROM base AS final
WORKDIR /app

# Create directories for logs and certificates
RUN mkdir -p /app/logs /https /root/.aspnet/https

# Copy the published application
COPY --from=publish /app/publish .

# Fix case sensitivity issues for Linux containers
RUN if [ -f /app/wwwroot/img/GCCLogo.png ]; then \
    cp /app/wwwroot/img/GCCLogo.png /app/wwwroot/img/gcclogo.png; \
    fi

# Copy development certificate (optional - will be overridden by volume mount in production)
COPY --from=devcert /https/aspnetapp.pfx /https/aspnetapp.pfx

# Create a non-root user for security
RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser /app && \
    chown -R appuser /https && \
    chmod 400 /https/aspnetapp.pfx

USER appuser

# Default environment variables
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS="https://+:8081;http://+:8080"
ENV ASPNETCORE_HTTPS_PORT=8081
ENV ASPNETCORE_HTTP_PORTS=8080

# Certificate configuration (override these in production)
ENV ASPNETCORE_Kestrel__Certificates__Default__Password="SecurePassword123!"
ENV ASPNETCORE_Kestrel__Certificates__Default__Path="/https/aspnetapp.pfx"

# Health check - tries HTTPS first, falls back to HTTP
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f -k https://localhost:8081/health || curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "GCCWebApp.dll"]