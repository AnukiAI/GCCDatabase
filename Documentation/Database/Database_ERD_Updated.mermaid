erDiagram
    %% =====================================================
    %% GCC Database ERD - Updated with all system changes
    %% Last Updated: 2025-08-06
    %% =====================================================

    %% Core business entities and relationships
    Certificate ||--|| Company : "belongs to"
    Certificate ||--|| Product : describes
    Certificate ||--|| CertificationType : "has type"
    Certificate }o--o{ CSFAttribute : "has"
    Certificate }o--o{ ExternalTag : "has"
    Certificate }o--o{ InternalTag : "has"
    Certificate ||--o{ CustomFieldValue : has
    Certificate ||--o| User : "created by"
    Certificate ||--o| User : "updated by"
    
    Product ||--|| ProductCategory : "belongs to"
    Product ||--o{ ProductType : "has type"
    Product ||--o{ ProductSubcategory : "has subcategory"
    Product ||--o| Company : "owned by"
    Product }o--o{ Tag : "has tags"
    
    ProductCategory ||--o{ ProductType : contains
    ProductType ||--o{ ProductSubcategory : contains
    ProductType ||--o| ProductType : "parent"
    
    CustomFieldValue ||--|| CustomField : "references"
    CustomField ||--|| CertificationType : "belongs to"
    
    APIClient ||--o{ APIToken : "has"
    APIClient ||--o{ APIRequestLog : "generates"
    
    User ||--o{ Certificate : "creates"
    User }o--o{ Role : "has roles"
    User }o--o{ Company : "belongs to companies"
    User }o--o{ Partner : "belongs to partners"
    User ||--o{ UserActivity : "generates"
    
    Role }o--o{ Permission : has
    
    Partner ||--o{ User : "has users"
    Partner ||--o{ Certificate : "associated with"
    
    Company ||--o{ Product : "owns"
    Company ||--o{ Certificate : "has"
    Company ||--o{ User : "has users"
    
    %% Admin Settings
    AdminSettings ||--|| GoogleAnalyticsSettings : contains
    AdminSettings ||--|| AmazonAPISettings : contains
    AdminSettings ||--|| SystemConfiguration : contains

    %% Entity definitions with key attributes
    Certificate {
        int id PK
        varchar certificate_number UK "7 chars"
        varchar status "active/expired/pending"
        date effective_date
        date expiration_date
        varchar location "175 chars"
        varchar country "100 chars"
        text asin "Amazon Standard ID"
        text upc "Universal Product Code"
        text gtin "Global Trade Item Number"
        text ean "European Article Number"
        varchar certificate_file "file path"
        int company_id FK
        int product_id FK
        int certificate_type_id FK
        int created_by FK
        int updated_by FK
        timestamp created_at
        timestamp updated_at
    }

    Company {
        int id PK
        varchar name UK "255 chars"
        varchar contact_info "255 chars"
        varchar location "175 chars"
        varchar country "100 chars"
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    Product {
        int id PK
        varchar name "255 chars"
        text description
        int category_id FK
        int product_type_id FK
        int product_subcategory_id FK
        int company_id FK
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    ProductCategory {
        int id PK
        varchar name UK "255 chars"
        text description
        int sort_order
        boolean is_active
    }

    ProductType {
        int id PK
        varchar name "255 chars"
        int category_id FK
        int parent_id FK "self-referencing"
        int level "hierarchy level"
        int sort_order
        boolean is_active
    }

    ProductSubcategory {
        int id PK
        varchar name "255 chars"
        int product_type_id FK
        text description
        int sort_order
        boolean is_active
    }

    CertificationType {
        int id PK
        varchar name UK "255 chars"
        varchar amazon_code "255 chars"
        text description
        boolean is_active
        int sort_order
    }

    CSFAttribute {
        int id PK
        varchar name UK "255 chars"
        text description
        boolean is_active
    }

    ExternalTag {
        int id PK
        varchar name UK "100 chars"
        text description
        boolean is_active
    }

    InternalTag {
        int id PK
        varchar name UK "100 chars"
        text description
        boolean is_active
    }

    Tag {
        int id PK
        varchar name UK "50 chars"
        varchar tag_type "internal/external"
        text description
        boolean is_active
    }

    CustomField {
        int id PK
        varchar name "100 chars"
        varchar field_type "text/number/date/boolean/select"
        boolean is_required
        boolean is_visible
        boolean is_public
        int sort_order
        text options "for select fields"
        varchar default_value
        text validation_rules
        int certificate_type_id FK
    }

    CustomFieldValue {
        int id PK
        int certificate_id FK
        int field_id FK
        text text_value
        decimal number_value
        date date_value
        boolean boolean_value
    }

    User {
        int id PK
        varchar username UK "255 chars"
        varchar email UK "255 chars"
        varchar name "100 chars"
        varchar password_hash "255 chars"
        varchar status "active/inactive/locked"
        boolean is_active
        boolean is_staff
        boolean is_superuser
        boolean require_password_reset
        datetime last_login
        datetime password_changed_at
        int failed_login_attempts
        datetime locked_until
        timestamp created_at
        timestamp updated_at
    }

    Role {
        int id PK
        varchar name UK "50 chars"
        text description
        boolean is_system "system role flag"
        timestamp created_at
        timestamp updated_at
    }

    Permission {
        int id PK
        varchar name "255 chars"
        varchar codename UK "100 chars"
        varchar category "module category"
        text description
    }

    Partner {
        int id PK
        varchar name UK "100 chars"
        text description
        varchar website "255 chars"
        varchar contact_email "100 chars"
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    UserActivity {
        int id PK
        int user_id FK
        varchar activity_type "login/logout/create/update/delete"
        varchar entity_type "certificate/product/company"
        int entity_id
        text description
        varchar ip_address
        varchar user_agent
        timestamp created_at
    }

    APIClient {
        int id PK
        varchar name "255 chars"
        varchar client_id UK "100 chars"
        varchar client_secret "255 chars"
        boolean is_active
        text allowed_scopes
        timestamp created_at
        timestamp updated_at
    }

    APIToken {
        int id PK
        int api_client_id FK
        varchar access_token UK "255 chars"
        varchar refresh_token UK "255 chars"
        timestamp expires_at
        text scopes
        timestamp created_at
    }

    APIRequestLog {
        int id PK
        int api_client_id FK
        varchar endpoint "255 chars"
        varchar method "GET/POST/PUT/DELETE"
        int response_code
        int response_time "milliseconds"
        text request_body
        text response_body
        varchar ip_address
        timestamp timestamp
    }

    GoogleAnalyticsSettings {
        int id PK
        varchar tracking_id "20 chars"
        boolean is_enabled
        boolean track_page_views
        boolean track_events
        boolean track_conversions
        varchar updated_by
        timestamp last_updated
    }

    AmazonAPISettings {
        int id PK
        varchar access_key_id "encrypted"
        varchar secret_access_key "encrypted"
        varchar region "50 chars"
        varchar marketplace_id "100 chars"
        boolean is_enabled
        int sync_interval_hours
        datetime last_sync
        varchar last_sync_status
        timestamp updated_at
    }

    SystemConfiguration {
        int id PK
        varchar key UK "100 chars"
        text value
        varchar data_type "string/number/boolean/json"
        text description
        boolean is_encrypted
        timestamp updated_at
    }

    AdminSettings {
        int id PK
        int google_analytics_id FK
        int amazon_api_id FK
        int system_config_id FK
        timestamp created_at
        timestamp updated_at
    }

    %% Audit and History Tables
    AuditLog {
        int id PK
        int user_id FK
        varchar table_name
        int record_id
        varchar action "INSERT/UPDATE/DELETE"
        text old_values "JSON"
        text new_values "JSON"
        varchar ip_address
        timestamp created_at
    }

    AuditLog ||--o| User : "performed by"