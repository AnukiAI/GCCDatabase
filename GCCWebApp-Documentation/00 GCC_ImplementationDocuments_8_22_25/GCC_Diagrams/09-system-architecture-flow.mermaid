flowchart TD
    A[User Interface] --> B[Controller Layer]
    B --> C[Service Layer]
    C --> D[Repository Layer]
    D --> E[Database]
    
    B --> F{Authentication}
    F --> G[JWT Token Service]
    F --> H[2FA Service]
    F --> I[Email Service]
    
    C --> J[Admin Service]
    C --> K[Certificate Service]
    C --> L[Company Service]
    C --> M[API Key Service]
    
    B --> N{Authorization}
    N --> O[Role-Based Access]
    N --> P[Permission Checks]
    
    E --> Q[SQLite Database]
    Q --> R[Users & Roles]
    Q --> S[Certificates]
    Q --> T[Companies & Products]
    Q --> U[Audit Logs]
    
    style A fill:#e3f2fd
    style B fill:#f1f8e9
    style C fill:#fff3e0
    style D fill:#fce4ec
    style E fill:#f3e5f5