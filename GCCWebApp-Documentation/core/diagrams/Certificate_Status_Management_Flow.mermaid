flowchart TD
    %% Certificate Creation
    subgraph "Certificate Creation"
        CreateCert["📄 New Certificate<br/>Created"]
        SetInitStatus["Set Initial Status<br/>Active/Pending"]
        SetStatusType["Set Status Type<br/>Client Progression"]
    end

    %% Certificate Status Values
    subgraph "Certificate Status"
        ActiveStatus["✅ Active<br/>Currently Valid"]
        ExpiredStatus["⏳ Expired<br/>Past Expiration Date"]
        PendingStatus["⏸️ Pending<br/>Awaiting Approval"]
        SuspendedStatus["⏹️ Suspended<br/>Temporarily Invalid"]
        RevokedStatus["❌ Revoked<br/>Permanently Invalid"]
    end

    %% Status Type Values (Client Progression)
    subgraph "Status Type (Client Progression)"
        InitialContact["📞 Initial Contact<br/>First client interaction"]
        InProgress["🔄 In Progress<br/>Working with client"]
        ClientDeclined["❌ Client Declined<br/>Not moving forward"]
        OnHold["⏸️ On Hold<br/>Paused by client"]
        Completed["✅ Completed<br/>Certification issued"]
        FollowUpRequired["📋 Follow-up Required<br/>Additional info needed"]
    end

    %% User Role Access Control
    subgraph "User Access Control"
        AdminControl["👨‍💼 Admin Users<br/>Full Status Control"]
        AnalystControl["📊 Analyst Users<br/>Status Type Updates"]
        PartnerControl["🤝 Partner Users<br/>Limited Status View"]
        ClientControl["👤 Client Users<br/>Status Filter Only"]
        PublicControl["🌐 Public Users<br/>Active Only"]
    end

    %% Status Transition Rules
    subgraph "Status Transition Rules"
        AutoExpire["⏰ Auto-Expiration<br/>System Process"]
        AdminApproval["👨‍💼 Admin Approval<br/>Required for some changes"]
        StatusHistory["📈 Status History<br/>Audit Trail"]
        NotificationTrigger["📧 Notification Trigger<br/>Status change alerts"]
    end

    %% Status-Based Filtering
    subgraph "Certificate Filtering"
        PublicFilter["🌐 Public View<br/>Active certificates only"]
        ClientFilter["👤 Client Filter<br/>Active + Expired + Assigned"]
        PartnerFilter["🤝 Partner Filter<br/>Partner-specific status"]
        InternalFilter["🏢 Internal Filter<br/>All statuses visible"]
    end

    %% Certificate Lifecycle Flow
    CreateCert --> SetInitStatus
    SetInitStatus --> SetStatusType
    SetInitStatus --> ActiveStatus
    SetStatusType --> InitialContact

    %% Status Transitions
    ActiveStatus -->|"Expiration Date Reached"| AutoExpire
    AutoExpire --> ExpiredStatus
    ActiveStatus -->|"Admin Action"| SuspendedStatus
    ActiveStatus -->|"Admin Action"| RevokedStatus
    PendingStatus -->|"Admin Approval"| ActiveStatus
    PendingStatus -->|"Rejected"| RevokedStatus
    SuspendedStatus -->|"Admin Reactivation"| ActiveStatus

    %% Status Type Transitions
    InitialContact -->|"Client Engaged"| InProgress
    InitialContact -->|"No Response"| OnHold
    InProgress -->|"Client Says No"| ClientDeclined
    InProgress -->|"Needs More Info"| FollowUpRequired
    InProgress -->|"Certificate Issued"| Completed
    OnHold -->|"Client Re-engaged"| InProgress
    FollowUpRequired -->|"Info Received"| InProgress

    %% Access Control Rules
    AdminControl -->|"Can Change All"| ActiveStatus
    AdminControl -->|"Can Change All"| ExpiredStatus
    AdminControl -->|"Can Change All"| PendingStatus
    AdminControl -->|"Can Change All"| SuspendedStatus
    AdminControl -->|"Can Change All"| RevokedStatus

    AnalystControl -->|"Can Update"| InitialContact
    AnalystControl -->|"Can Update"| InProgress
    AnalystControl -->|"Can Update"| ClientDeclined
    AnalystControl -->|"Can Update"| OnHold
    AnalystControl -->|"Can Update"| FollowUpRequired

    %% User Filtering Rules
    PublicControl --> PublicFilter
    ClientControl --> ClientFilter
    PartnerControl --> PartnerFilter
    AdminControl --> InternalFilter
    AnalystControl --> InternalFilter

    PublicFilter -->|"Shows Only"| ActiveStatus
    ClientFilter -->|"Shows"| ActiveStatus
    ClientFilter -->|"Shows"| ExpiredStatus
    PartnerFilter -->|"Partner Data"| ActiveStatus
    PartnerFilter -->|"Partner Data"| ExpiredStatus
    InternalFilter -->|"Shows All"| ActiveStatus
    InternalFilter -->|"Shows All"| ExpiredStatus
    InternalFilter -->|"Shows All"| PendingStatus
    InternalFilter -->|"Shows All"| SuspendedStatus
    InternalFilter -->|"Shows All"| RevokedStatus

    %% Status Change Triggers
    ActiveStatus --> NotificationTrigger
    ExpiredStatus --> NotificationTrigger
    ClientDeclined --> NotificationTrigger
    Completed --> NotificationTrigger

    %% History and Auditing
    ActiveStatus --> StatusHistory
    ExpiredStatus --> StatusHistory
    PendingStatus --> StatusHistory
    InitialContact --> StatusHistory
    InProgress --> StatusHistory
    ClientDeclined --> StatusHistory

    %% Admin Approval Requirements
    PendingStatus --> AdminApproval
    RevokedStatus --> AdminApproval
    SuspendedStatus --> AdminApproval

    %% Business Logic Rules
    subgraph "Business Rules"
        Rule1["📋 Status + Status Type<br/>Independent tracking"]
        Rule2["⏰ Auto-expiration<br/>Based on expiration_date"]
        Rule3["👨‍💼 Admin Override<br/>Can change any status"]
        Rule4["📧 Client Notifications<br/>Status change emails"]
        Rule5["🔍 Search Integration<br/>Filter by status/type"]
    end

    StatusHistory -.-> Rule1
    AutoExpire -.-> Rule2
    AdminApproval -.-> Rule3
    NotificationTrigger -.-> Rule4
    ClientFilter -.-> Rule5

    %% Certificate Display Logic
    subgraph "UI Display Logic"
        StatusBadge["🏷️ Status Badge<br/>Color-coded display"]
        ProgressIndicator["📊 Progress Indicator<br/>Status type visualization"]
        FilterControls["🎛️ Filter Controls<br/>User-specific options"]
        BulkActions["📦 Bulk Actions<br/>Status updates"]
    end

    ActiveStatus --> StatusBadge
    InitialContact --> ProgressIndicator
    ClientFilter --> FilterControls
    AdminControl --> BulkActions

    %% Styling
    classDef active fill:#28a745,stroke:#1e7e34,color:white
    classDef expired fill:#ffc107,stroke:#d39e00,color:black
    classDef pending fill:#17a2b8,stroke:#138496,color:white
    classDef suspended fill:#fd7e14,stroke:#e8590c,color:white
    classDef revoked fill:#dc3545,stroke:#b02a37,color:white
    classDef admin fill:#6f42c1,stroke:#59359a,color:white
    classDef analyst fill:#20c997,stroke:#198754,color:white
    classDef client fill:#0d6efd,stroke:#084298,color:white
    classDef public fill:#6c757d,stroke:#495057,color:white
    classDef process fill:#f8f9fa,stroke:#495057,color:black
    classDef business fill:#ffe5b4,stroke:#ffb347,color:black

    class ActiveStatus active
    class ExpiredStatus expired
    class PendingStatus pending
    class SuspendedStatus suspended
    class RevokedStatus revoked
    class AdminControl admin
    class AnalystControl analyst
    class ClientControl,ClientFilter client
    class PublicControl,PublicFilter public
    class AutoExpire,StatusHistory,NotificationTrigger,AdminApproval process
    class Rule1,Rule2,Rule3,Rule4,Rule5 business