%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontSize": "15px",
    "fontFamily": "Inter, Segoe UI, system-ui, sans-serif",
    "primaryColor": "#002B76",
    "primaryTextColor": "#0B1220",
    "primaryBorderColor": "#002B76",
    "lineColor": "#334155",
    "tertiaryColor": "#EEF2F6",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#CBD5E1",
    "edgeLabelBackground": "#FFFFFF"
  }
}}%%
flowchart TB
  %% Groups
  subgraph CLIENT["Client Layer"]
    direction LR
    PU["Public Users"]
    AU["Admin Users"]
    EXT["3rd-Party APIs"]
    AMZ["Amazon"]
  end

  subgraph UI["Presentation"]
    direction LR
    PublicUI["Public Interface"]
    AdminUI["Admin Interface"]
  end

  subgraph GATE["API & Security"]
    direction LR
    REST["REST API Gateway"]
    OAuth["OAuth2 / OIDC"]
    EP_Auth["Auth"]
    EP_Cert["Certificates"]
    EP_Prod["Products"]
    EP_Search["Search"]
    EP_Amazon["Amazon Connector"]
  end

  subgraph SVC["Application Services"]
    direction LR
    Views["Views / Controllers"]
    Biz["Business Logic"]
    Valid["Validation"]
    Authz["Authorization"]
  end

  subgraph DATA["Data Access"]
    direction LR
    ORM["Entity Framework"]
    QRY["Query Services"]
  end

  subgraph PERSIST["Storage"]
    direction LR
    DB[("SQL Server")]:::db
    Files["Object Storage"]
    Cache["Cache (optional)"]
  end

  subgraph OPS["Ops & Observability"]
    direction LR
    Logs["Logging"]
    Mon["Monitoring / APM"]
    Trc["Tracing"]
    Bkp["Backups / DR"]
  end

  %% Flow
  PU --> PublicUI
  AU --> AdminUI
  EXT --> REST
  AMZ --> EP_Amazon

  PublicUI --> REST
  AdminUI --> REST
  REST --> EP_Auth & EP_Cert & EP_Prod & EP_Search
  REST --> OAuth
  OAuth --> Authz

  EP_Cert --> Views
  EP_Prod --> Views
  EP_Search --> Views
  Views --> Biz
  Biz --> Valid
  Biz --> Authz
  Biz --> ORM & QRY & Cache
  ORM --> DB
  ORM --> Files
  QRY --> DB

  SVC -.-> Logs
  DATA -.-> Logs
  PERSIST -.-> Mon
  OPS -.-> Trc
  DB -.-> Bkp
  Files -.-> Bkp

  %% Styles
  classDef band fill:#FFFFFF,stroke:#CBD5E1,stroke-width:2px,color:#0B1220;
  classDef db fill:#FFFFFF,stroke:#8E44AD,stroke-width:3px;

  class CLIENT,UI,GATE,SVC,DATA,PERSIST,OPS band
  class DB db

  %% Click targets (wire to your docs/anchors)
  click REST "https://your.docs/architecture/api-gateway" "API Gateway"
  click OAuth "https://your.docs/security/oauth" "OAuth2 / OIDC"
  click EP_Cert "https://your.docs/api/certificates" "Certificates API"
  click EP_Prod "https://your.docs/api/products" "Products API"
  click EP_Search "https://your.docs/api/search" "Search API"
  click DB "https://your.docs/data/postgresql" "Database"
  click Files "https://your.docs/data/object-storage" "Certificates storage"
  click Logs "https://your.docs/ops/logging" "Logging"
  click Mon "https://your.docs/ops/monitoring" "Monitoring"
  click Bkp "https://your.docs/ops/backup-dr" "Backup & DR"
