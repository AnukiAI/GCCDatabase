erDiagram
    %% Core business entities and relationships
    Certificate ||--|| Company : "belongs to"
    Certificate ||--|| Product : describes
    Certificate ||--|| CertificationType : "has type"
    Certificate }o--o{ CSFAttribute : "has"
    Certificate }o--o{ ExternalTag : "has"
    Certificate }o--o{ InternalTag : "has"
    Certificate ||--o{ CustomFieldValue : has
    Certificate }o--o{ Partner : "accessible by"
    Certificate ||--|| User : "created by"
    Certificate ||--|| User : "modified by"
    
    Product ||--|| ProductCategory : "belongs to"
    Product ||--o{ ProductType : "has type"
    Product ||--o{ ProductSubcategory : "has subcategory"
    Product ||--o{ ProductIdentifier : "has identifiers"
    
    ProductCategory ||--o{ ProductType : contains
    ProductType ||--o{ ProductSubcategory : contains
    
    CustomFieldValue ||--|| CustomField : "references"
    
    %% Partner relationships
    Partner ||--o{ Company : "has access to"
    Partner ||--o{ User : "has users"
    Partner ||--o{ APIClient : "uses"
    
    %% API relationships (Partner-only access)
    APIClient ||--o{ APIToken : "has"
    APIClient ||--o{ APIRequestLog : "generates"
    
    User ||--o{ Certificate : "creates"
    User }o--o{ Group : "belongs to"
    Group }o--o{ Permission : has
    
    %% Entity definitions with key attributes
    Certificate {
        id int PK
        certificate_number varchar(7) UK
        status varchar(30)
        status_type varchar(50) "NEW: Client progression"
        effective_date date
        expiration_date date
        location varchar(175)
        country varchar(100)
        partner varchar(100) "NEW: Amazon/Wayfair/None"
        auto_generated boolean "NEW: Number generation"
        manual_override boolean "NEW: Number override"
        certificate_file varchar(255)
        created_by_id int FK
        modified_by_id int FK
        created_at timestamp
        updated_at timestamp
    }

    Company {
        id int PK
        name varchar(255) UK
        contact_email varchar(255) "UPDATED: Split field"
        contact_phone varchar(50) "UPDATED: Split field"
        website_url varchar(255) "NEW: Separate URL"
        partner_id int FK "NEW: Partner association"
    }

    Partner {
        id int PK
        name varchar(100) UK "e.g. Amazon, Wayfair"
        code varchar(50) UK
        api_enabled boolean
        data_segregation boolean "Security flag"
        created_at timestamp
    }

    Product {
        id int PK
        name varchar(255)
        created_at timestamp
        updated_at timestamp
    }

    ProductIdentifier {
        id int PK
        product_id int FK
        identifier_type varchar(20) "ASIN, UPC, GTIN, EAN"
        identifier_value varchar(255)
        is_primary boolean
    }

    ProductCategory {
        id int PK
        name varchar(255) UK
    }

    ProductType {
        id int PK
        name varchar(255)
        category_id int FK
    }

    ProductSubcategory {
        id int PK
        name varchar(255)
        product_type_id int FK
    }

    CertificationType {
        id int PK
        name varchar(255) UK
        amazon_code varchar(255)
        partner_specific boolean "NEW: Partner-specific type"
        is_active boolean
    }

    CSFAttribute {
        id int PK
        name varchar(255) UK
    }

    ExternalTag {
        id int PK
        name varchar(100) UK
        visible_to_external boolean "NEW: Visibility control"
    }

    InternalTag {
        id int PK
        name varchar(100) UK
        external_visibility varchar(50) "NEW: none/assigned/all"
    }

    CustomField {
        id int PK
        name varchar(100)
        field_type varchar(10)
        is_public boolean
    }

    CustomFieldValue {
        id int PK
        certificate_id int FK
        field_id int FK
        text_value text
        number_value decimal
        date_value date
        boolean_value boolean
    }

    User {
        id int PK
        username varchar(255) UK
        email varchar(255) UK
        password_hash varchar(255)
        partner_id int FK "NEW: Partner association"
        is_active boolean
        is_staff boolean
        is_superuser boolean
    }

    Group {
        id int PK
        name varchar(150) UK
    }

    Permission {
        id int PK
        name varchar(255)
        codename varchar(100) UK
    }

    APIClient {
        id int PK
        name varchar(255)
        partner_id int FK "NEW: Partner-only API"
        client_id varchar(100) UK
        client_secret varchar(255)
        is_active boolean
    }

    APIToken {
        id int PK
        api_client_id int FK
        access_token varchar(255) UK
        refresh_token varchar(255)
        expires_at timestamp
    }

    APIRequestLog {
        id int PK
        api_client_id int FK
        endpoint varchar(255)
        method varchar(10)
        response_code int
        response_time int
        timestamp timestamp
    }