flowchart TD
    %% External Users & Systems
    subgraph "External Access"
        PublicUser["🌐 Public User (No Auth)"]
        ClientUser["👤 Client User (Login)"]
        PartnerAmazon["🛒 Amazon Partner (API)"]
        PartnerWayfair["🏠 Wayfair Partner (API)"]
        OtherPartner["🤝 Other Partners (API)"]
    end

    %% Internal Users
    subgraph "Internal Access"
        AdminUser["👨‍💼 Admin User"]
        AnalystUser["📊 Analyst User"]
    end

    %% Authentication Layer
    APIGateway["🔒 API Gateway"]
    Auth["🔐 Authentication Service"]
    PartnerAuth["🎫 Partner Authentication (OAuth2)"]
    UserAuth["👤 User Authentication (Azure AD B2C)"]

    %% Partner Data Segregation
    subgraph "Partner Data Segregation"
        PartnerFilter["Partner Data Filter"]
        AmazonData["Amazon Certificates"]
        WayfairData["Wayfair Certificates"]
        GeneralData["General Certificates"]
    end

    %% Certificate API
    subgraph "Certificate API"
        CertGet["GET /certifications/:id"]
        CertList["GET /certifications"]
        CertPush["POST /certifications"]
        CertUpdate["PUT /certifications/:id"]
        CertExport["GET /certifications/export"]
    end

    %% Status & Access Control
    subgraph "Access Control"
        StatusFilter["Certificate Status Filter"]
        StatusType["Status Type Control"]
        TagVisibility["Tag Visibility Control"]
        InternalTagFilter["Internal Tag Filter"]
    end

    %% Database
    DB[(Database)]

    %% Admin Interface
    AdminUI["Admin Interface (Full Access)"]

    %% Authentication Flow - Public
    PublicUser -->|No Auth Required| CertList
    PublicUser -->|Limited View| CertGet

    %% Authentication Flow - Clients (NO API ACCESS)
    ClientUser -->|Login via Azure AD B2C| UserAuth
    UserAuth -->|Authenticated| StatusFilter
    StatusFilter -->|Filter by Status| CertList

    %% Authentication Flow - Partners (API ACCESS ONLY)
    PartnerAmazon -->|OAuth2 + API Key| PartnerAuth
    PartnerWayfair -->|OAuth2 + API Key| PartnerAuth
    OtherPartner -->|OAuth2 + API Key| PartnerAuth
    PartnerAuth -->|Validated Partner| APIGateway
    APIGateway -->|Route with Partner Context| PartnerFilter

    %% Partner Data Segregation
    PartnerFilter -->|Amazon Only| AmazonData
    PartnerFilter -->|Wayfair Only| WayfairData
    PartnerFilter -->|Others| GeneralData
    
    AmazonData --> CertGet
    WayfairData --> CertGet
    GeneralData --> CertGet

    %% Internal User Flow
    AdminUser -->|Full Access| AdminUI
    AnalystUser -->|Read Access| UserAuth
    AdminUI -->|Manage All| CertPush
    AdminUI -->|Set Status Types| StatusType
    AdminUI -->|Control Tag Visibility| TagVisibility

    %% Status Type Control (NEW)
    StatusType -->|Client Progression| DB
    StatusFilter -->|Active/Expired/Pending| CertList

    %% Tag Visibility Control (NEW)
    TagVisibility -->|External Tags| CertGet
    InternalTagFilter -->|Assigned Only| ClientUser
    InternalTagFilter -->|None| PublicUser
    InternalTagFilter -->|All| AdminUser

    %% API Endpoints with Access Control
    CertGet -->|Retrieve with Filters| DB
    CertList -->|List with Pagination| DB
    CertPush -->|Partner/Admin Only| DB
    CertUpdate -->|Partner/Admin Only| DB
    CertExport -->|Authorized Users| DB

    %% Security Controls
    APIGateway -.->|Rate Limiting| RateLimit["⚡ Rate Limiting"]
    APIGateway -.->|Audit Logging| Logs["📝 API Logging"]
    APIGateway -.->|Permission Checks| RBAC["🛡️ Role-Based Access"]
    PartnerFilter -.->|Data Isolation| DataSeg["🔐 Data Segregation"]
    
    %% Styling
    classDef public fill:#d4edda,stroke:#28a745
    classDef client fill:#fff3cd,stroke:#ffc107
    classDef partner fill:#cce5ff,stroke:#0d6efd
    classDef internal fill:#f8d7da,stroke:#dc3545
    classDef security fill:#f5b942,stroke:#d69e31
    classDef apiGateway fill:#67b7dc,stroke:#4a8aa9
    classDef endpoints fill:#a5d6a7,stroke:#75a478
    classDef database fill:#ce93d8,stroke:#9c64a6
    classDef control fill:#e2e3e5,stroke:#495057
    classDef restricted stroke:#ff0000,stroke-width:3px

    class PublicUser public
    class ClientUser client
    class PartnerAmazon,PartnerWayfair,OtherPartner partner
    class AdminUser,AnalystUser internal
    class APIGateway,Auth,PartnerAuth,UserAuth apiGateway
    class CertGet,CertList,CertPush,CertUpdate,CertExport endpoints
    class DB database
    class StatusFilter,StatusType,TagVisibility,InternalTagFilter,PartnerFilter control
    class RateLimit,Logs,RBAC,DataSeg restricted