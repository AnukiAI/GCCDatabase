<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Accessibility tests for GCC Web Application ensuring WCAG 2.1 compliance</Description>
  </PropertyGroup>

  <!-- Test framework packages (Mixed xUnit and NUnit) -->
  <ItemGroup Label="Test Frameworks">
    <PackageReference Include="FluentAssertions" Version="8.7.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <!-- Accessibility testing specific packages -->
  <ItemGroup Label="Accessibility Testing Tools">
    <PackageReference Include="Microsoft.Playwright" Version="1.48.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.48.0" />
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.10.1" />
    <PackageReference Include="Selenium.Axe" Version="4.0.21" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\GCCWebApp\GCCWebApp.csproj" />
  </ItemGroup>

  <!-- Global usings (Test frameworks NOT included to avoid ambiguity) -->
  <ItemGroup Label="Global Usings">
    <Using Include="Microsoft.Playwright" />
    <Using Include="Deque.AxeCore.Playwright" />
    <Using Include="Deque.AxeCore.Commons" />
  </ItemGroup>

</Project>
