<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Accessibility tests for GCC Web Application ensuring WCAG 2.1 compliance</Description>
  </PropertyGroup>

  <!-- xUnit test framework packages -->
  <ItemGroup Label="xUnit Test Framework">
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Accessibility testing specific packages -->
  <ItemGroup Label="Accessibility Testing Tools">
    <PackageReference Include="Microsoft.Playwright" Version="1.48.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.48.0" />
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.10.1" />
    <PackageReference Include="Selenium.Axe" Version="4.0.21" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\GCCWebApp\GCCWebApp.csproj" />
    <ProjectReference Include="..\GCCWebApp.Tests.Common\GCCWebApp.Tests.Common.csproj" />
  </ItemGroup>

  <!-- Global usings -->
  <ItemGroup Label="Global Usings">
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
    <Using Include="Microsoft.Playwright.NUnit" />
    <Using Include="Deque.AxeCore.Playwright" />
    <Using Include="Deque.AxeCore.Commons" />
    <Using Include="GCCWebApp.Tests.Common.TestUtilities" />
  </ItemGroup>

</Project>
