<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Behavior-Driven Development tests for GCC Web Application using SpecFlow</Description>
  </PropertyGroup>

  <!-- SpecFlow BDD framework packages -->
  <ItemGroup Label="SpecFlow BDD Framework">
    <PackageReference Include="SpecFlow.xUnit" Version="3.9.74" />
    <PackageReference Include="SpecFlow.Plus.LivingDocPlugin" Version="3.9.57" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\GCCWebApp\GCCWebApp.csproj" />
    <ProjectReference Include="..\GCCWebApp.Tests.Common\GCCWebApp.Tests.Common.csproj" />
  </ItemGroup>

  <!-- Global usings -->
  <ItemGroup Label="Global Usings">
    <Using Include="Xunit" />
    <Using Include="TechTalk.SpecFlow" />
    <Using Include="GCCWebApp.Tests.Common.TestUtilities" />
  </ItemGroup>

</Project>
