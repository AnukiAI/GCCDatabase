{
  "BaseUrl": "http://localhost:5101",
  
  "TestUsers": {
    "Admin": {
      "Email": "admin@test.com",
      "Password": "TestPass123!",
      "Role": "Admin"
    },
    "Analyst": {
      "Email": "analyst@test.com", 
      "Password": "TestPass123!",
      "Role": "Analyst"
    },
    "External": {
      "Email": "external@test.com",
      "Password": "TestPass123!", 
      "Role": "External"
    },
    "Public": {
      "Email": "public@test.com",
      "Password": "TestPass123!",
      "Role": "Public"
    }
  },

  "TestSettings": {
    "BrowserHeadless": false,
    "ScreenshotOnFailure": true,
    "ScreenshotOnSuccess": true,
    "DefaultTimeout": 30000,
    "NavigationTimeout": 60000,
    "MaxRetries": 3,
    "RetryDelay": 2000,
    "ScreenshotQuality": 90,
    "ViewportWidth": 1920,
    "ViewportHeight": 1080
  },

  "Browser": {
    "Type": "chromium",
    "LaunchOptions": {
      "SlowMo": 100,
      "Args": [
        "--start-maximized",
        "--disable-web-security",
        "--disable-features=VizDisplayCompositor",
        "--no-sandbox"
      ]
    }
  },

  "TestData": {
    "SampleCertificateNumber": "TEST-CERT-001",
    "SampleProductName": "Test Product",
    "SampleCompanyName": "Test Company",
    "SampleUserEmail": "testuser@example.com",
    "DefaultPassword": "TestPass123!"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Playwright": "Information"
    }
  },

  "AllowedHosts": "*"
}