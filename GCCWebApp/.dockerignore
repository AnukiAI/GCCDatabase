.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker files (not needed inside the image)
Dockerfile
docker-compose*.yml
.dockerignore

# Deployment scripts
deploy.sh
deploy.cmd