**/GCCWebApp.E2E.Tests/
**/GCCWebApp.RoleBasedUI.Tests/
**/GCCWebApp.RoleBasedUI.Tests2/
**/GCCWebApp.Accessibility.Tests/

# Archived files
pages/
pages_old/
archive/

# Log files
logs/
*.log

# Database files (not needed in image - use containers)
*.db
*.sqlite
*.sqlite3

# Environment files (security sensitive)
.env
.env.*
!.env.example

# Git and version control
.git/
.gitignore
.gitattributes

# IDE and editor files
.vscode/
.vs/
*.swp
*.swo
*~

