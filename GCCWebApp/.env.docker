# Docker Environment Configuration
# For deployment to Plesk server with PostgreSQL

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTP_PORTS=8080

# PostgreSQL Connection (Update with your actual PostgreSQL details)
# Format for PostgreSQL: Host=server;Database=dbname;Username=user;Password=pass;Port=5432
ConnectionStrings__DefaultConnection=Host=your-postgres-host;Database=GCCDatabase;Username=gccuser;Password=YourPassword;Port=5432

# Data Protection (Use file system instead of Azure)
DataProtection__PersistToFileSystem=true
DataProtection__UseAzureKeyVault=false

# JWT Configuration
Jwt__Key=your-very-long-secret-key-at-least-64-characters-for-production-use
Jwt__Issuer=https://your-domain.com
Jwt__Audience=https://your-domain.com

# Feature Flags
FeatureFlags__EnableDetailedErrorMessages=false
FeatureFlags__EnableSwagger=false

# Session Configuration  
Session__TimeoutMinutes=30
Session__CookieName=__Host-SessionId

# CORS Settings (if needed)
AllowedOrigins__0=https://your-domain.com