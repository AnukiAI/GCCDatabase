# ---------------------------------------------------------------------------
# TEMPLATE -- generated from `.env`, which is gitignored and holds live values.
# Copy to `.env` and fill in every <ANGLE_BRACKET> placeholder. Never commit the
# filled-in copy. Values marked REQUEST come from the project owner.
# ---------------------------------------------------------------------------
# ===========================================
# GCC WEB APPLICATION - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and update the values

# Database Configuration
DB_PASSWORD=<REQUEST: from project owner>
DB_ROOT_PASSWORD=<REQUEST: from project owner>

# JWT Configuration (REQUIRED - must be 64+ characters)
JWT_SECRET_KEY=<GENERATE: openssl rand -base64 64>

# SMTP Configuration (for 2FA emails - using mock for now)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=demo@example.com
SMTP_PASSWORD=<REQUEST: SMTP mailbox password>
SMTP_FROM_EMAIL=noreply@gcc-demo.com

# 2FA Configuration
ENABLE_2FA=true

# SMS Configuration (choose one: mock, twilio, textbelt)
SMS_PROVIDER=mock

# Twilio SMS Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=<REQUEST: from project owner>
TWILIO_PHONE_NUMBER=+1234567890
TEST_PHONE_NUMBER=+1234567890

# TextBelt SMS Configuration (if using TextBelt)
TEXTBELT_API_KEY=<GENERATE: openssl rand -hex 32>

# Redis Configuration (optional)
REDIS_PASSWORD=<REQUEST: from project owner>

# Application URLs (update with your actual domain)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
