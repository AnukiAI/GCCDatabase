# ---------------------------------------------------------------------------
# TEMPLATE -- generated from `.env.https`, which is gitignored and holds live values.
# Copy to `.env.https` and fill in every <ANGLE_BRACKET> placeholder. Never commit the
# filled-in copy. Values marked REQUEST come from the project owner.
# ---------------------------------------------------------------------------
# HTTPS Docker Environment Configuration
# For deployment with HTTPS support

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://+:8081;http://+:8080
ASPNETCORE_HTTPS_PORT=8081
ASPNETCORE_HTTP_PORTS=8080

# Force HTTPS Redirection
ASPNETCORE_HTTPS_REDIRECTION=true
ASPNETCORE_HSTS=true

# Database Connection (choose one)
# SQLite (simplest for testing)
ConnectionStrings__DefaultConnection=<REPLACE>

# PostgreSQL
#ConnectionStrings__DefaultConnection=Host=postgres;Database=gccdb;Username=gccuser;Password=YourPassword;Port=5432

# MariaDB/MySQL
#ConnectionStrings__DefaultConnection=Server=mariadb;Port=3306;Database=gccdb;User=gccuser;Password=YourPassword;

# SQL Server
#ConnectionStrings__DefaultConnection=Server=sqlserver;Database=GCCDatabase;User Id=sa;Password=YourPassword123!;TrustServerCertificate=true

# Certificate Configuration (Development - auto-generated)
ASPNETCORE_Kestrel__Certificates__Default__Password=<REQUEST: from project owner>
ASPNETCORE_Kestrel__Certificates__Default__Path=/https/aspnetapp.pfx

# For Production - Use real certificate
#ASPNETCORE_Kestrel__Certificates__Default__Path=/https/your-domain.pfx
#ASPNETCORE_Kestrel__Certificates__Default__Password=YourCertPassword

# Or use Let's Encrypt certificate files
#ASPNETCORE_Kestrel__Endpoints__Https__Url=https://+:8081
#ASPNETCORE_Kestrel__Endpoints__Https__Certificate__Path=/https/fullchain.pem
#ASPNETCORE_Kestrel__Endpoints__Https__Certificate__KeyPath=/https/privkey.pem

# Security Configuration
Jwt__Key=<GENERATE: openssl rand -base64 64>
Jwt__Issuer=https://localhost:8081
Jwt__Audience=https://localhost:8081

# Data Protection (for secure cookie/session storage)
DataProtection__PersistToFileSystem=true
DataProtection__UseAzureKeyVault=false

# Session Configuration
Session__TimeoutMinutes=30
Session__CookieName=__Host-SessionId
Session__Cookie__SecurePolicy=Always
Session__Cookie__SameSite=Strict

# CORS Settings (update for your domain)
AllowedOrigins__0=https://localhost:8081
AllowedOrigins__1=https://your-domain.com

# Feature Flags
FeatureFlags__EnableDetailedErrorMessages=false
FeatureFlags__EnableSwagger=false
FeatureFlags__ForceHttps=true

# Dummy values for optional services (prevents startup errors)
GCC_AZURE_AD_B2C_CLIENT_SECRET=<AZURE: App registrations -> Certificates & secrets>
GCC_AZURE_AD_CLIENT_SECRET=<AZURE: App registrations -> Certificates & secrets>
GCC_APPLICATION_INSIGHTS_CONNECTION_STRING=<AZURE: Application Insights -> Connection String>
GCC_SMTP_PASSWORD=<REQUEST: SMTP mailbox password>

# Container Configuration
CONTAINER_NAME=gcc-webapp-https
EXTERNAL_HTTPS_PORT=8443
EXTERNAL_HTTP_PORT=8080
INTERNAL_HTTPS_PORT=8081
INTERNAL_HTTP_PORT=8080
