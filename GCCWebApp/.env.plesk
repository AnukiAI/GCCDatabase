# GCC Web App - Plesk Production Environment Configuration
# Copy this file to your Plesk server and update the values

# PostgreSQL Database Configuration
ConnectionStrings__DefaultConnection=Host=localhost;Database=gccdb;Username=gccuser;Password=YourSecurePassword123!;Port=5432

# Security Configuration
Jwt__Key=ThisIsAVeryLongSecretKeyForJwtTokenGenerationAtLeast64CharactersLong123456789
Jwt__Issuer=https://your-domain.com
Jwt__Audience=https://your-domain.com

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080
ASPNETCORE_HTTP_PORTS=8080

# Dummy values for optional services (required to prevent errors)
GCC_AZURE_AD_B2C_CLIENT_SECRET=dummy-secret
GCC_AZURE_AD_CLIENT_SECRET=dummy-secret
GCC_APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000
GCC_SMTP_PASSWORD=dummy-password

# Domain Configuration
DOMAIN=your-domain.com

# Container Configuration
CONTAINER_NAME=gcc-webapp
IMAGE_NAME=ghcr.io/anukiai/gcc-webapp:latest
EXTERNAL_PORT=5102
INTERNAL_PORT=8080