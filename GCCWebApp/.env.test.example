# ---------------------------------------------------------------------------
# TEMPLATE -- generated from `.env.test`, which is gitignored and holds live values.
# Copy to `.env.test` and fill in every <ANGLE_BRACKET> placeholder. Never commit the
# filled-in copy. Values marked REQUEST come from the project owner.
# ---------------------------------------------------------------------------
# =================================================================
# GCC Test Environment Configuration
# =================================================================
# This file contains environment variables for Docker Test deployment
# Copy this file and update values before deployment
# IMPORTANT: Never commit actual passwords to version control
# =================================================================

# Build Information
BUILD_NUMBER=latest
ENVIRONMENT=Test

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# SQL Server SA Password (Strong password required)
# Requirements: 8+ chars, uppercase, lowercase, number, special char
DB_SA_PASSWORD=<REQUEST: from project owner>

# Database Connection Settings
DB_HOST=sqlserver-test
DB_PORT=1433
DB_NAME=GCC_Test
DB_USER=sa

# =================================================================
# JWT CONFIGURATION
# =================================================================
# JWT Secret Key (Minimum 64 characters for security)
JWT_SECRET_KEY=<GENERATE: openssl rand -base64 64>

# JWT Token Settings
JWT_ISSUER=GCCWebApp-Test-Docker
JWT_AUDIENCE=GCCWebApp-Test-Docker
JWT_EXPIRY_MINUTES=60

# =================================================================
# REDIS CONFIGURATION
# =================================================================
# Redis Password
REDIS_PASSWORD=<REQUEST: from project owner>

# Redis Settings
REDIS_HOST=redis-test
REDIS_PORT=6379
REDIS_DB=0

# =================================================================
# SMTP CONFIGURATION
# =================================================================
# Email Service Provider (Examples: smtp.gmail.com, smtp.sendgrid.net, smtp.mailtrap.io)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_ENABLE_SSL=true

# SMTP Credentials
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=<REQUEST: SMTP mailbox password>

# Email Settings
SMTP_FROM_EMAIL=test@greencirclecertified.com
SMTP_FROM_NAME=GCC Test Environment

# =================================================================
# AUTHENTICATION SETTINGS
# =================================================================
# Two-Factor Authentication
ENABLE_2FA=false

# Test Mode Settings
ENABLE_TEST_MODE=true
REQUIRE_EMAIL_CONFIRMATION=false
BYPASS_CAPTCHA=true

# Session Settings
SESSION_TIMEOUT_MINUTES=30
REMEMBER_ME_DAYS=7

# =================================================================
# AZURE AD B2C CONFIGURATION (Optional)
# =================================================================
# Azure AD B2C Settings
AZURE_AD_B2C_INSTANCE=https://your-tenant.b2clogin.com/
AZURE_AD_B2C_CLIENT_ID=your-client-id
AZURE_AD_B2C_CLIENT_SECRET=<AZURE: App registrations -> Certificates & secrets>
AZURE_AD_B2C_DOMAIN=your-tenant.onmicrosoft.com
AZURE_AD_B2C_SIGNUP_SIGNIN_POLICY=B2C_1_SignUpSignIn
AZURE_AD_B2C_RESET_PASSWORD_POLICY=B2C_1_PasswordReset
AZURE_AD_B2C_EDIT_PROFILE_POLICY=B2C_1_ProfileEdit

# =================================================================
# API CONFIGURATION
# =================================================================
# API Rate Limiting
API_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_PER_HOUR=1000

# API Keys (Generate secure keys for production)
API_MASTER_KEY=<GENERATE: openssl rand -hex 32>
API_WEBHOOK_SECRET=<GENERATE: openssl rand -hex 32>

# =================================================================
# SECURITY SETTINGS
# =================================================================
# HTTPS Configuration
ENABLE_HTTPS_REDIRECTION=false
ENABLE_HSTS=false

# CORS Settings
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5102,http://localhost:8090

# Security Headers
ENABLE_SECURITY_HEADERS=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';

# =================================================================
# LOGGING AND MONITORING
# =================================================================
# Log Levels: Trace, Debug, Information, Warning, Error, Critical
LOG_LEVEL_DEFAULT=Debug
LOG_LEVEL_MICROSOFT=Information
LOG_LEVEL_EF_CORE=Debug

# Application Insights (Optional)
APP_INSIGHTS_CONNECTION_STRING=
APP_INSIGHTS_INSTRUMENTATION_KEY=

# Serilog Settings (Optional)
SERILOG_MINIMUM_LEVEL=Debug
SERILOG_WRITE_TO_FILE=true
SERILOG_WRITE_TO_CONSOLE=true

# =================================================================
# PERFORMANCE SETTINGS
# =================================================================
# Connection Pool Settings
DB_CONNECTION_POOL_SIZE=<REPLACE>
DB_CONNECTION_TIMEOUT=<REPLACE>

# Cache Settings
CACHE_SLIDING_EXPIRATION_MINUTES=20
CACHE_ABSOLUTE_EXPIRATION_MINUTES=60

# Request Limits
MAX_REQUEST_SIZE_MB=100
MAX_UPLOAD_SIZE_MB=50

# =================================================================
# FEATURE FLAGS
# =================================================================
# Enable/Disable Features
FEATURE_ENABLE_SWAGGER=true
FEATURE_ENABLE_HEALTH_CHECKS=true
FEATURE_ENABLE_METRICS=true
FEATURE_ENABLE_AUDIT_LOG=true
FEATURE_ENABLE_API_VERSIONING=true

# Test Features
FEATURE_AUTO_SEED_DATA=true
FEATURE_ENABLE_TEST_ENDPOINTS=true
FEATURE_SHOW_DETAILED_ERRORS=true

# =================================================================
# DOCKER SPECIFIC SETTINGS
# =================================================================
# Container Resource Limits
CONTAINER_MEMORY_LIMIT=2G
CONTAINER_CPU_LIMIT=2

# Volume Paths (Internal to container)
DATA_PROTECTION_PATH=/app/DataProtectionKeys
UPLOAD_PATH=/app/wwwroot/uploads
LOG_PATH=/app/logs
CERTIFICATE_PATH=/app/certificates

# =================================================================
# TEST DATA CONFIGURATION
# =================================================================
# Test Data Seeding
SEED_ADMIN_EMAIL=admin@greencirclecertified.com
SEED_ADMIN_PASSWORD=<CHOOSE: local-only seed password>

SEED_ANALYST_EMAIL=analyst@greencirclecertified.com
SEED_ANALYST_PASSWORD=<CHOOSE: local-only seed password>

SEED_EXTERNAL_EMAIL=partner@amazon.com
SEED_EXTERNAL_PASSWORD=<CHOOSE: local-only seed password>

# Number of test records to create
SEED_CERTIFICATE_COUNT=100
SEED_COMPANY_COUNT=20
SEED_PRODUCT_COUNT=50

# =================================================================
# BACKUP AND RECOVERY
# =================================================================
# Backup Settings
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily

# Recovery Settings
ENABLE_AUTO_RECOVERY=true
RECOVERY_MAX_ATTEMPTS=3

# =================================================================
# NOTES
# =================================================================
# 1. Update all placeholder values before deployment
# 2. Use strong, unique passwords for all services
# 3. Never commit this file with real credentials
# 4. Consider using Docker secrets for production
# 5. Rotate keys and passwords regularly
# 6. Monitor logs for security issues
# =================================================================
