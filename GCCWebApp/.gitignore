# Build artifacts
**/bin/
**/obj/
**/publish/
**/publish-output/
**/publish-production/
**/backups/

# Deployment artifacts
*.zip
*.tar.gz
*.7z

# Test results
**/TestResults/
**/*.trx
**/*.coverage

# Database files (development only)
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/

# IDE
.vs/
.vscode/
*.user
*.suo

# Environment files with secrets
.env.local
.env.production
appsettings.Production.json

# Node modules (if any)
node_modules/

# Temporary files
*.tmp
*.temp
cookies.txt

# Windows reserved device names (can be accidentally created in bash/Unix shells)
nul
NUL
con
CON
prn
PRN
aux
AUX
com[1-9]
COM[1-9]
lpt[1-9]
LPT[1-9]
customfields.xml
filters_*.json

# Old deployment artifacts
WebApp/
DeploymentPackage/
TempGCCDeploy/

# Temp pages and problematic filenames
temp_page.html
*tempcompany*.html

# Data Protection Keys (keep folder, ignore keys)
DataProtectionKeys/*.xml
