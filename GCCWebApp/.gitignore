# Build artifacts
**/bin/
**/obj/
**/publish/
**/publish-output/
**/publish-production/
**/backups/
deploy-output/

# Deployment artifacts
# Canonical staging path is deployment-drops/staging/ (see scripts/deploy.ps1).
# Anything under deployment-drops/ is a build artifact and should never be tracked.
deployment-drops/
publish-*/
deploy-staging/
deploy-staging-*/
*.zip
*.tar.gz
*.7z

# Test results
**/TestResults/
**/*.trx
**/*.coverage

# Database files (development only)
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/

# IDE
.vs/
.vscode/
*.user
*.suo

# Environment files with secrets
.env
.env.*
# Sanitized templates ARE tracked -- they carry the shape of each file, never a live value.
# Real values live only in the un-suffixed files above. See SETUP.md, "Configuration".
!.env.example
!.env.*.example
appsettings.Production.json
appsettings.Staging.json
appsettings.Test.json
appsettings.Security.json

# Node modules (if any)
node_modules/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
cookies*.txt
admin_cookies.txt
headers.txt
response.json
response.txt
c6.txt
_ul
_ul-*

# Windows reserved device names (can be accidentally created in bash/Unix shells)
nul
NUL
con
CON
prn
PRN
aux
AUX
com[1-9]
COM[1-9]
lpt[1-9]
LPT[1-9]
customfields.xml
filters_*.json

# Old deployment artifacts
WebApp/
DeploymentPackage/
TempGCCDeploy/

# Temp pages and problematic filenames
temp_page.html
*tempcompany*.html

# Data Protection Keys (keep folder, ignore keys)
DataProtectionKeys/*.xml

# Root-level one-off scripts and SQL
/migration*.sql
/prod_*.sql
/alter_column.ps1
/check_csv.ps1
/check_import.ps1

# Test artifacts at root
test_results/

# Gate 2 pre-deploy smoke scripts are now TRACKED (they are regression assets, not throwaway).
# Only their run OUTPUT stays ignored.
Scripts/smoke-prod/_results/gate2-*.json
Scripts/smoke-prod/_axe-public.js

# Runtime-generated import safety backups (CR-023 R5 writes these per-import; not source)
App_Data/uploads/import-backups/

# Untracked test-helper fixtures (the tracked TEST_Sample.csv + run-tests scripts stay tracked)
Scripts/testing/GCC_Certificate_Import_COLLISION_Example.csv
Scripts/testing/README.md
