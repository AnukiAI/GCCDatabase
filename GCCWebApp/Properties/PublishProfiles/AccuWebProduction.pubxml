<?xml version="1.0" encoding="utf-8"?>
<!--
  AccuWeb Windows Hosting - Production Deployment Profile
  This profile builds and publishes the application for deployment to AccuWeb Windows hosting with IIS
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>00000000-0000-0000-0000-000000000000</ProjectGuid>
    <PublishUrl>bin\Release\net8.0\publish\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <!-- Exclude test projects and documentation from publish -->
  <ItemGroup>
    <Content Remove="GCCWebApp.Tests\**" />
    <Content Remove="GCCWebApp.E2E.Tests\**" />
    <Content Remove="GCCWebApp.UAT.Tests\**" />
    <Content Remove="GCCWebApp.Security.Tests\**" />
    <Content Remove="GCCWebApp.Performance.Tests\**" />
    <Content Remove="GCCWebApp.BDD.Tests\**" />
    <Content Remove="GCCWebApp.Api.Tests\**" />
    <Content Remove="GCCWebApp.Tests.Common\**" />
    <Content Remove="Documentation\**" />
    <Content Remove="0_Documentation\**" />
    <Content Remove="pages\**" />
  </ItemGroup>
</Project>
