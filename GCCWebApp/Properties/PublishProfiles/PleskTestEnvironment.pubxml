<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>00000000-0000-0000-0000-000000000000</ProjectGuid>
    <PublishUrl>bin\Release\net8.0\publish\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Production env loads appsettings.Production.json which has the real DB + AAD B2C config. -->
    <!-- appsettings.Test.json has placeholders only; setting this to Test breaks the deployed app. -->
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <!-- Exclude test projects, documentation, and stale deploy folders from publish -->
  <ItemGroup>
    <!-- Test projects + docs that should never ship -->
    <Content Remove="GCCWebApp.Tests\**" />
    <Content Remove="GCCWebApp.E2E.Tests\**" />
    <Content Remove="GCCWebApp.UAT.Tests\**" />
    <Content Remove="GCCWebApp.Security.Tests\**" />
    <Content Remove="GCCWebApp.Performance.Tests\**" />
    <Content Remove="GCCWebApp.BDD.Tests\**" />
    <Content Remove="GCCWebApp.Api.Tests\**" />
    <Content Remove="GCCWebApp.Tests.Common\**" />
    <Content Remove="Documentation\**" />
    <Content Remove="0_Documentation\**" />
    <Content Remove="pages\**" />

    <!-- Stale deploy/publish staging folders at project root.
         The canonical staging path is `deployment-drops/staging/` (see scripts/deploy.ps1).
         These three globs cover every historical naming convention without needing per-run additions. -->
    <Content Remove="publish\**" />
    <Content Remove="publish-*\**" />
    <Content Remove="deploy*\**" />

    <!-- CRITICAL: Never ship dev wwwroot/uploads/ — it will overwrite user-uploaded PDFs on the server. -->
    <!-- Lost all prod uploads once (2026-04-23). Keep this exclusion permanent. -->
    <Content Remove="wwwroot\uploads\**" />

    <!-- CRITICAL (DEF-286, 2026-06-24): DEF-208 moved the upload store to App_Data/uploads, but
         ExcludeApp_Data=false ships App_Data — so the publish was carrying dev uploads and an
         extract-over-live would CLOBBER the prod PDF store. This is a contributor to the
         2026-06-15 all-PDFs-missing incident. Never ship the upload tree. Durable fix is to point
         FileStorage:StoragePath at a folder OUTSIDE the deploy folder (see
         docs/tracking/upload-storage-persistence.md); this exclusion is the safety net regardless. -->
    <Content Remove="App_Data\uploads\**" />

    <!-- Deploy hygiene (added 2026-06-02): keep dev-only tooling, internal docs, and
         credential-bearing dev config OUT of the prod publish. Prior zips shipped all of
         this to the server. appsettings.Development.json carries the dev DB password;
         Scripts/, docs/, qc*-live-check/, _verify-*/ are dev/test artifacts. The app only
         loads appsettings.json + appsettings.Production.json (EnvironmentName=Production,
         no explicit AddJsonFile in Program.cs), so the other appsettings variants are inert
         on prod and safe to drop. -->
    <Content Remove="Scripts\**" />
    <Content Remove="docs\**" />
    <Content Remove="qc159-live-check\**" />
    <Content Remove="qc184-live-check\**" />
    <Content Remove="qc-import-test\**" />
    <Content Remove="_verify-*\**" />
    <Content Remove="response.json" />
    <Content Remove="appsettings.Development.json" />
    <Content Remove="appsettings.Test.json" />
    <Content Remove="appsettings.Staging.json" />
    <Content Remove="appsettings.Security.json" />
    <Content Remove="appsettings.Performance.json" />
    <Content Remove="appsettings.SqlServerScriptGen.json" />
    <!-- Gate 10, 2026-09-17: EVERY *.template.json is excluded, not just Production's.
         The 20260917-1539 bundle was found carrying five of them. They are dev aids the server
         never reads, and their prose documents real infrastructure that a config file's
         placeholders do not hide - the two appsettings.Secrets.*.template.json files each name
         live host/port/mailbox details (see DEF-429 and the 20260917-1545 runbook for specifics;
         deliberately not repeated here, since this file is now tracked). No passwords - those are
         placeholders - but that disclosure does not belong in the web root. Two of these shipped
         in every bundle to date; excluding them here does NOT remove the copies already on the
         server, which is a manual delete. -->
    <Content Remove="appsettings.*.template.json" />
    <Content Remove="appsettings.Production.template.json" />
  </ItemGroup>
</Project>