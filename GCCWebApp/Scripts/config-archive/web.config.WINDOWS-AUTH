<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Self-contained deployment for AccuWebHosting -->
      <aspNetCore processPath=".\GCCWebApp.exe"
                  arguments=""
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- WINDOWS AUTHENTICATION (Integrated Security) -->
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="Server=tcp:68.71.129.120,1533;Database=gccwebap_certificates;Integrated Security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;" />

          <environmentVariable name="GCC_JWT_SECRET" value="your-jwt-secret-key-minimum-64-characters-long-change-this-in-production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
