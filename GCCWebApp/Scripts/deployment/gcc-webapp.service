[Unit]
Description=GCC Web Application (ASP.NET Core MVC)
After=network.target
After=syslog.target

[Service]
Type=simple
User=plesk
Group=psacln
WorkingDirectory=/var/www/vhosts/yourdomain.com/httpdocs
ExecStart=/usr/bin/dotnet /var/www/vhosts/yourdomain.com/httpdocs/GCCWebApp.dll

# Restart configuration
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=90
SyslogIdentifier=gcc-webapp

# Environment variables
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5000
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# Performance and security settings
LimitNOFILE=100000
LimitNPROC=4096
PrivateTmp=true
NoNewPrivileges=true

# Additional security hardening (optional)
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/vhosts/yourdomain.com/httpdocs/App_Data
ReadWritePaths=/var/www/vhosts/yourdomain.com/httpdocs/logs
ReadWritePaths=/var/www/vhosts/yourdomain.com/httpdocs/wwwroot/uploads
ReadWritePaths=/var/www/vhosts/yourdomain.com/httpdocs/DataProtectionKeys

[Install]
WantedBy=multi-user.target