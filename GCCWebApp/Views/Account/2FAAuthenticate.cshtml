@{
    ViewData["Title"] = "Two-Factor Authentication";
    ViewData["BodyClass"] = "login-page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.5.1/css/all.min.css" rel="stylesheet" />
</head>
<body class="login-page">
    <main class="auth-container" role="main">
        <a href="@Url.Action("Login", "Account")" class="back-link">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            Back to login
        </a>

        <div class="auth-header">
            <div class="auth-icon">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>
            </div>
            <h2>Two-Factor Authentication</h2>
            <p id="2fa-instructions">Enter the 6-digit code from your authenticator app or email</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert-error" role="alert">
                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                @ViewBag.Error
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.Success))
        {
            <div class="alert-success" role="alert">
                <i class="fas fa-check-circle" aria-hidden="true"></i>
                @ViewBag.Success
            </div>
        }

        <form asp-controller="Account" asp-action="Verify2FA" method="post">
            <div class="form-group">
                <label class="sr-only" id="code-label">Enter 6-digit verification code</label>
                <div class="code-input-group" role="group" aria-labelledby="code-label" aria-describedby="2fa-instructions">
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required aria-label="Digit 1 of 6" inputmode="numeric" autocomplete="one-time-code" />
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required aria-label="Digit 2 of 6" inputmode="numeric" />
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required aria-label="Digit 3 of 6" inputmode="numeric" />
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required aria-label="Digit 4 of 6" inputmode="numeric" />
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required aria-label="Digit 5 of 6" inputmode="numeric" />
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required aria-label="Digit 6 of 6" inputmode="numeric" />
                </div>
                <input type="hidden" id="AuthCode" name="AuthCode" />
            </div>

            <div class="trust-device">
                <input type="checkbox" id="TrustDevice" name="TrustDevice" />
                <label for="TrustDevice">Trust this device for 30 days</label>
            </div>

            <button type="submit" class="btn-lime" aria-label="Verify authentication code">
                <i class="fas fa-lock" aria-hidden="true"></i>
                Verify Code
            </button>
        </form>

        <div class="resend-section">
            <p>Didn't receive a code?</p>
            <a href="#" class="resend-link" id="resendLink" aria-describedby="resend-status">
                Resend code <span class="timer" id="timer" aria-live="polite"></span>
            </a>
            <span id="resend-status" class="sr-only">Resend available after countdown</span>
        </div>

        <div style="margin-top: 20px; text-align: center; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 16px;">
            <a href="#" id="toggleRecovery" style="color: #adb5bd; font-size: 14px; text-decoration: none;">
                <i class="fas fa-key" aria-hidden="true"></i> Use a recovery code instead
            </a>
            <div id="recoverySection" style="display: none; margin-top: 16px;">
                <input type="text" id="recoveryCodeInput" class="form-control"
                       placeholder="XXXX-XXXX" maxlength="9"
                       style="text-align: center; letter-spacing: 3px; font-size: 18px; font-weight: 600; font-family: 'Courier New', monospace; padding: 12px; border-radius: 8px; border: 2px solid #dee2e6; max-width: 220px; margin: 0 auto;"
                       aria-label="Enter 8-character recovery code" />
                <button type="button" class="btn-lime" style="margin-top: 12px; width: auto; padding: 10px 24px;" onclick="submitRecoveryCode()">
                    <i class="fas fa-key" aria-hidden="true"></i> Verify Recovery Code
                </button>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus and auto-advance for code inputs
            const codeInputs = document.querySelectorAll('.code-input');
            const authCodeField = document.getElementById('AuthCode');
            
            codeInputs[0].focus();
            
            codeInputs.forEach((input, index) => {
                input.addEventListener('input', function() {
                    if (this.value.length === 1) {
                        if (index < codeInputs.length - 1) {
                            codeInputs[index + 1].focus();
                        }
                    }
                    updateAuthCode();
                });
                
                input.addEventListener('keydown', function(e) {
                    if (e.key === 'Backspace' && this.value === '') {
                        if (index > 0) {
                            codeInputs[index - 1].focus();
                        }
                    }
                });
                
                input.addEventListener('paste', function(e) {
                    e.preventDefault();
                    const pastedData = e.clipboardData.getData('text').slice(0, 6);
                    const digits = pastedData.split('');
                    digits.forEach((digit, i) => {
                        if (i < codeInputs.length && /[0-9]/.test(digit)) {
                            codeInputs[i].value = digit;
                        }
                    });
                    updateAuthCode();
                });
            });
            
            function updateAuthCode() {
                let code = '';
                codeInputs.forEach(input => {
                    code += input.value;
                });
                authCodeField.value = code;
            }
            
            // Resend timer
            let countdown = 60;
            const resendLink = document.getElementById('resendLink');
            const timer = document.getElementById('timer');
            
            function updateTimer() {
                if (countdown > 0) {
                    timer.textContent = `(${countdown}s)`;
                    resendLink.style.pointerEvents = 'none';
                    resendLink.style.opacity = '0.5';
                    countdown--;
                    setTimeout(updateTimer, 1000);
                } else {
                    timer.textContent = '';
                    resendLink.style.pointerEvents = 'auto';
                    resendLink.style.opacity = '1';
                }
            }
            
            updateTimer();
            
            resendLink.addEventListener('click', function(e) {
                if (countdown > 0) {
                    e.preventDefault();
                    return;
                }
                countdown = 60;
                updateTimer();
                // Add actual resend logic here
            });

            // Recovery code toggle
            const toggleLink = document.getElementById('toggleRecovery');
            const recoverySection = document.getElementById('recoverySection');
            if (toggleLink && recoverySection) {
                toggleLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    const isHidden = recoverySection.style.display === 'none';
                    recoverySection.style.display = isHidden ? 'block' : 'none';
                    toggleLink.textContent = isHidden ? 'Use a verification code instead' : 'Use a recovery code instead';
                    if (isHidden) {
                        document.getElementById('recoveryCodeInput').focus();
                    } else {
                        codeInputs[0].focus();
                    }
                });
            }
        });
        function submitRecoveryCode() {
            var code = document.getElementById('recoveryCodeInput').value.replace('-', '').trim();
            if (code.length !== 8) {
                if (typeof AdminCore !== 'undefined' && AdminCore.showNotification) {
                    AdminCore.showNotification('Please enter a valid 8-character recovery code.', 'warning');
                }
                return;
            }
            document.getElementById('AuthCode').value = code;
            document.querySelector('form').submit();
        }
    </script>
</body>
</html>