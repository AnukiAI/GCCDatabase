@{
    ViewData["Title"] = "Account Locked";
    ViewData["BodyClass"] = "login-page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        /* AccountLocked page-specific */
        .auth-container { text-align: center; }
        .auth-header h2 { font-size: 32px; color: #dc2626; margin-bottom: 20px; }
        .btn-primary {
            background: linear-gradient(135deg, #002B76 0%, #0369a1 100%);
        }
        .btn-primary:hover {
            box-shadow: 0 8px 25px rgba(0, 43, 118, 0.3);
        }
        .btn-secondary:hover {
            border-color: #4a7c23;
            color: #4a7c23;
        }
        @@media (max-width: 480px) {
            .time-remaining .timer { font-size: 24px; }
        }
    </style>
</head>
<body class="login-page">
    <main class="auth-container" role="main">
        <div class="auth-icon danger">
            <i class="fas fa-lock" aria-hidden="true"></i>
        </div>

        <div class="auth-header">
            <h2>Account Locked</h2>
        </div>

        <div class="auth-content" role="alert">
            <p>Your account has been temporarily locked due to multiple failed login attempts. This is a security measure to protect your account.</p>
        </div>

        <div class="time-remaining">
            <h3><i class="fas fa-clock" aria-hidden="true"></i> Time Remaining</h3>
            <div class="timer" id="timer" aria-live="polite" aria-atomic="true">@(ViewBag.LockoutTimeRemaining ?? "15:00")</div>
            <div class="timer-label">minutes until unlock</div>
        </div>

        <div class="help-section">
            <h3><i class="fas fa-info-circle" aria-hidden="true"></i> What you can do:</h3>
            <ul>
                <li><i class="fas fa-check" aria-hidden="true"></i> Wait for the lockout period to expire</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> Contact support if you need immediate access</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> Reset your password if you've forgotten it</li>
            </ul>
        </div>

        <div class="action-buttons">
            <a href="@Url.Action("ForgotPassword", "Account")" class="btn-primary" aria-label="Reset your password">
                <i class="fas fa-key" aria-hidden="true"></i>
                Reset Password
            </a>

            <a href="@Url.Action("Login", "Account")" class="btn-secondary" aria-label="Return to login page">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Back to Login
            </a>
        </div>

        <div class="contact-info">
            <p>Need immediate assistance?</p>
            <p>Contact support: <a href="mailto:support@greencirclecertified.com">support@greencirclecertified.com</a></p>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const timerElement = document.getElementById('timer');
            let timeString = timerElement.textContent;
            
            function parseTime(timeStr) {
                const parts = timeStr.split(':');
                return parseInt(parts[0]) * 60 + parseInt(parts[1]);
            }
            
            function formatTime(seconds) {
                const minutes = Math.floor(seconds / 60);
                const remainingSeconds = seconds % 60;
                return minutes.toString().padStart(2, '0') + ':' + remainingSeconds.toString().padStart(2, '0');
            }
            
            let totalSeconds = parseTime(timeString);
            
            if (totalSeconds > 0) {
                const countdown = setInterval(function() {
                    totalSeconds--;
                    
                    if (totalSeconds <= 0) {
                        clearInterval(countdown);
                        timerElement.textContent = '00:00';
                        setTimeout(function() {
                            window.location.href = '@Url.Action("Login", "Account")';
                        }, 1000);
                    } else {
                        timerElement.textContent = formatTime(totalSeconds);
                    }
                }, 1000);
            }
        });
    </script>
</body>
</html>