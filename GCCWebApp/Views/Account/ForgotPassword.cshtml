            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            background: linear-gradient(135deg, #0078d4 0%, #106ebe 100%);
            color: white;
            text-decoration: none;
            padding: 15px 30px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            margin-bottom: 20px;
        }

            .microsoft-login-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 120, 212, 0.3);
                text-decoration: none;
                color: white;
            }

            .microsoft-login-button i {
                font-size: 20px;
            }
 */
        .security-notice {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px;
            background-color: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 8px;
            text-align: left;
        }

            .security-notice i {
                color: #075985;
                font-size: 20px;
                flex-shrink: 0;
            }

            .security-notice strong {
                display: block;
                color: #075985;
                font-size: 14px;
                margin-bottom: 2px;
            }

            .security-notice p {
                font-size: 12px;
                color: #0369a1;
                margin: 0;
                line-height: 1.3;
            }

        .divider {
            text-align: center;
            margin: 30px 0;
            position: relative;
            color: #6b7280;
            font-size: 14px;
        }

            .divider::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 0;
                right: 0;
                height: 1px;
                background-color: #d1d5db;
                z-index: 1;
            }

            .divider span {
                background-color: white;
                padding: 0 20px;
                position: relative;
                z-index: 2;
            }

        .guest-access {
            text-align: center;
        }

        .guest-button {
            color: #4a7c23;
            text-decoration: none;
            font-weight: 600;
            border: 2px solid #4a7c23;
            padding: 12px 25px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-block;
        }

            .guest-button:hover {
                background-color: #4a7c23;
                color: white;
                text-decoration: none;
            }

        .alert-error {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding: 15px;
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #dc2626;
        }

        .alert-success {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding: 15px;
            background-color: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            color: #16a34a;
        }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .login-container

        {
            grid-template-columns: 1fr;
            max-width: 400px;
            margin: 20px;
        }

        .login-left {
            padding: 30px 20px;
            min-height: 200px;
        }

        .login-logo {
            width: 80px;
            height: 80px;
            margin-bottom: 20px;
        }

        .login-brand h1 {
            font-size: 24px;
        }

        .login-right {
            padding: 30px 20px;
        }

        .login-header h2 {
            font-size: 28px;
        }

        }

        @@media (max-width: 480px) {
            .login-page

        {
            padding: 10px;
        }

        .login-container {
            margin: 10px;
        }

        .login-left {
            padding: 20px 15px;
        }

        .login-right {
            padding: 20px 15px;
        }

        .login-header h2 {
            font-size: 24px;
        }

        }

        /* Reset default styles */
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }



    </style>
</head>
<body class="login-page">
    <main class="login-container" role="main">
        <div class="login-left">
            <img src="~/img/gcclogo.png" alt="GreenCircle Logo" class="login-logo" />
            <div class="login-brand">
                <h1>GreenCircle Certified Database</h1>
                <p>Access your sustainability certification database.</p>
            </div>
        </div>

        <div class="login-right">
            <div class="login-header">
                <h2>Forgot Password</h2>
                <p>Enter your email to reset your password</p>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert-error" role="alert">
                    <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                    @ViewBag.Error
                </div>
            }

            @if (!string.IsNullOrEmpty(ViewBag.Success))
            {
                <div class="alert-success" role="alert">
                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                    @ViewBag.Success
                </div>
            }

            @if (TempData["Message"] != null)
            {
                <div class="alert-error" role="alert">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    @TempData["Message"]
                </div>
            }

            <div class="login-form-section">
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="form-group">
                        <label for="Email">Email Address <span class="text-danger" aria-hidden="true">*</span><span class="sr-only">required</span></label>
                        <input type="email" id="Email" name="Email" class="form-control" placeholder="Enter your email address" required aria-required="true" />
                    </div>

                    <button type="submit" class="btn-lime" aria-label="Send password reset link">Send Reset Link</button>

                    <div class="link">
                        <a asp-controller="Account" asp-action="Login">Back to Login</a>
                    </div>
                </form>
            </div>
            <div class="security-notice">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                <div>
                    <strong>Secure Authentication</strong>
                    <p>Your credentials are protected with industry-standard encryption</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Optional: Add some loading functionality -->
    <script>
              document.addEventListener('DOMContentLoaded', function() {
            // Add loading state to login button
            const loginButton = document.querySelector('.login-button');
            const loginForm = document.querySelector('form');

            if (loginForm) {
                loginForm.addEventListener('submit', function() {
                    if (loginButton) {
                        loginButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Signing in...</span>';
                        loginButton.style.pointerEvents = 'none';
                    }
                });
            }

            // Rest of your existing JavaScript code...
        });
    </script>
</body>
</html>