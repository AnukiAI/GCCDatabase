@{
    ViewData["Title"] = "Sign In";
    ViewData["BodyClass"] = "login-page";
    Layout = null; // Use minimal layout for login
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        /* ForgotPassword page-specific overrides */
        :root {
            --auth-left-gradient: linear-gradient(135deg, #4a7c23 0%, #447638 100%);
        }
        .form-group label { font-size: 14px; }
        .link { font-size: 0.9rem; }
        .security-notice strong { font-size: 14px; }
        .security-notice p { font-size: 12px; }
        .divider { font-size: 14px; }
    </style>
</head>
<body class="login-page">
    <main class="login-container" role="main">
        <div class="login-left">
            <img src="~/img/gcclogo.png" alt="GreenCircle Logo" class="login-logo" />
            <div class="login-brand">
                <h1>GreenCircle Certified Database</h1>
                <p>Access your sustainability certification database.</p>
            </div>
        </div>

        <div class="login-right">
            <div class="login-header">
                <h2>Forgot Password</h2>
                <p>Enter your email to reset your password</p>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert-error" role="alert">
                    <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                    @ViewBag.Error
                </div>
            }

            @if (!string.IsNullOrEmpty(ViewBag.Success))
            {
                <div class="alert-success" role="alert">
                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                    @ViewBag.Success
                </div>
            }

            @if (TempData["Message"] != null)
            {
                <div class="alert-error" role="alert">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    @TempData["Message"]
                </div>
            }

            <div class="login-form-section">
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="form-group">
                        <label for="Email">Email Address <span class="text-danger" aria-hidden="true">*</span><span class="sr-only">required</span></label>
                        <input type="email" id="Email" name="Email" class="form-control" placeholder="Enter your email address" required aria-required="true" />
                    </div>

                    <button type="submit" class="btn-lime" aria-label="Send password reset link">Send Reset Link</button>

                    <div class="link">
                        <a asp-controller="Account" asp-action="Login">Back to Login</a>
                    </div>
                </form>
            </div>
            <div class="security-notice">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                <div>
                    <strong>Secure Authentication</strong>
                    <p>Your credentials are protected with industry-standard encryption</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Optional: Add some loading functionality -->
    <script>
              document.addEventListener('DOMContentLoaded', function() {
            // Add loading state to login button
            const loginButton = document.querySelector('.login-button');
            const loginForm = document.querySelector('form');

            if (loginForm) {
                loginForm.addEventListener('submit', function() {
                    if (loginButton) {
                        loginButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Signing in...</span>';
                        loginButton.style.pointerEvents = 'none';
                    }
                });
            }

            // Rest of your existing JavaScript code...
        });
    </script>
</body>
</html>