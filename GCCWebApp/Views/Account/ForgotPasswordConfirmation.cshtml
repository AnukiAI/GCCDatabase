@{
    ViewData["Title"] = "Password Reset Email Sent";
    ViewData["BodyClass"] = "login-page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        .confirmation-icon {
            font-size: 64px;
            color: #4a7c23;
            margin-bottom: 20px;
        }
        .confirmation-message {
            text-align: center;
            padding: 20px;
        }
        .confirmation-message h3 {
            color: #333;
            margin-bottom: 15px;
        }
        .confirmation-message p {
            color: #666;
            margin-bottom: 20px;
            line-height: 1.6;
        }
        .btn-lime {
            display: inline-block;
            margin-top: 10px;
        }
    </style>
</head>
<body class="login-page">
    <main class="login-container" role="main">
        <div class="login-left">
            <img src="~/img/gcclogo.png" alt="GreenCircle Logo" class="login-logo" />
            <div class="login-brand">
                <h1>GreenCircle Certified Database</h1>
                <p>Access your sustainability certification database.</p>
            </div>
        </div>

        <div class="login-right">
            <div class="login-header">
                <h2>Check Your Email</h2>
                <p>Password reset instructions sent</p>
            </div>

            <div class="confirmation-message">
                <i class="fas fa-envelope-circle-check confirmation-icon" aria-hidden="true"></i>
                <h3>Password Reset Email Sent</h3>
                <p>
                    If an account with that email address exists, you will receive a password reset link shortly.
                    Please check your email inbox (and spam folder) for instructions on how to reset your password.
                </p>
                <p>
                    <strong>Note:</strong> For security reasons, we display this message regardless of whether an account exists with the provided email address.
                </p>

                <a asp-controller="Account" asp-action="Login" class="btn-lime" aria-label="Return to login page">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Login
                </a>
            </div>

            <div class="security-notice">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                <div>
                    <strong>Secure Password Reset</strong>
                    <p>Reset links expire after 24 hours for your security</p>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
