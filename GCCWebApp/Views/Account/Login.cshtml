@model GCCWebApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["BodyClass"] = "login-page";
    Layout = null; // Use minimal layout for login
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
</head>
<body class="login-page">
    <main class="login-container" role="main">
        <div class="login-left">
            <img src="~/img/gcclogo.png" alt="GreenCircle Logo" class="login-logo" />
            <div class="login-brand">
                <h1>GreenCircle Certified Database</h1>
                <p>Access your sustainability certification database.</p>
            </div>
        </div>

        <div class="login-right">
            <div class="login-header">
                <h2>Welcome Back</h2>
                <p>Sign in to your account</p>
            </div>
            

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    @ViewBag.Error
                </div>
            }

            @if (TempData["Message"] != null)
            {
                <div class="alert-error">
                    <i class="fas fa-info-circle"></i>
                    @TempData["Message"]
                </div>
            }

            <div class="login-form-section">
                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                       <label for="Email" class="form-label">Email or Username <span class="text-danger" aria-label="required">*</span></label>
                       <input asp-for="Email" type="text" id="Email" name="Email" class="form-control" placeholder="Enter your email or username" required aria-required="true" aria-describedby="email-help" />
                       <small id="email-help" class="form-text text-muted">You can login with either your email address or username.</small>
                       <span asp-validation-for="Email" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label for="Password" class="form-label">Password <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="Password" type="password" id="Password" name="Password" class="form-control" placeholder="Enter your password" required aria-required="true" />
                        <span asp-validation-for="Password" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group checkbox-group">
                        <input asp-for="RememberMe" type="checkbox" id="RememberMe" name="RememberMe" />
                        <label asp-for="RememberMe">Remember me</label>
                    </div>

                    <button type="submit" class="btn-lime" aria-label="Login to your account">Login</button>

                    <div class="link">
                        <a asp-controller="Account" asp-action="ForgotPassword">Forgot Password</a>
                    </div>
                </form>

                
            </div>

            <div class="security-notice">
                <i class="fas fa-shield-alt"></i>
                <div>
                    <strong>Secure Authentication</strong>
                    <p>Your credentials are protected with industry-standard encryption</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Login button behavior handled by /js/auth.js -->
    <script src="~/js/auth.js"></script>
</body>
</html>