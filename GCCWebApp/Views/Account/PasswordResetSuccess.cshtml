@{
    ViewData["Title"] = "Password Reset Successful";
    ViewData["BodyClass"] = "login-page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        /* PasswordResetSuccess page-specific */
        .auth-container { text-align: center; }
        .auth-header h2 { font-size: 32px; color: #16a34a; margin-bottom: 20px; }
        @@media (max-width: 480px) {
            .success-icon-animated { width: 80px; height: 80px; }
            .success-icon-animated i { font-size: 36px; }
        }
    </style>
</head>
<body class="login-page">
    <main class="auth-container" role="main">
        <div class="success-icon-animated">
            <i class="fas fa-check" aria-hidden="true"></i>
        </div>

        <div class="auth-header">
            <h2>Password Reset Successful!</h2>
        </div>

        <div class="auth-content" role="status">
            <p>Your password has been successfully updated. You can now sign in to your account with your new password.</p>
        </div>

        <div class="success-details">
            <h3><i class="fas fa-shield-alt" aria-hidden="true"></i> What happened:</h3>
            <ul>
                <li><i class="fas fa-check" aria-hidden="true"></i> Your password was securely encrypted and updated</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> All existing sessions have been terminated for security</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> You'll need to sign in again on all devices</li>
            </ul>
        </div>

        <div class="security-tips">
            <h3><i class="fas fa-lightbulb" aria-hidden="true"></i> Security Tips:</h3>
            <ul>
                <li><i class="fas fa-info" aria-hidden="true"></i> Keep your password confidential and unique</li>
                <li><i class="fas fa-info" aria-hidden="true"></i> Enable two-factor authentication for extra security</li>
                <li><i class="fas fa-info" aria-hidden="true"></i> Sign out from shared or public devices</li>
                <li><i class="fas fa-info" aria-hidden="true"></i> Update your password regularly</li>
            </ul>
        </div>

        <div class="action-buttons">
            <a href="@Url.Action("Login", "Account")" class="btn-primary" aria-label="Sign in to your account">
                <i class="fas fa-sign-in-alt" aria-hidden="true"></i>
                Sign In Now
            </a>

            <a href="@Url.Action("Index", "Home")" class="btn-secondary" aria-label="Go to homepage">
                <i class="fas fa-home" aria-hidden="true"></i>
                Go to Homepage
            </a>
        </div>

        <div class="auto-redirect">
            <p>Redirecting you to the login page in:</p>
            <div class="countdown" id="countdown" aria-live="polite" aria-atomic="true">10</div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let countdown = 10;
            const countdownElement = document.getElementById('countdown');
            
            const timer = setInterval(function() {
                countdown--;
                countdownElement.textContent = countdown;
                
                if (countdown <= 0) {
                    clearInterval(timer);
                    window.location.href = '@Url.Action("Login", "Account")';
                }
            }, 1000);
            
            // Allow users to cancel auto-redirect by clicking anywhere
            document.addEventListener('click', function() {
                clearInterval(timer);
                countdownElement.textContent = 'Auto-redirect cancelled';
            });
        });
    </script>
</body>
</html>