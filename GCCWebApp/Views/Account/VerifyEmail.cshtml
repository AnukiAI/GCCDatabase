@{
    ViewData["Title"] = "Verify Email Address";
    ViewData["BodyClass"] = "login-page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        /* VerifyEmail page-specific */
        .auth-container { text-align: center; }
        .auth-header h2 { font-size: 32px; margin-bottom: 20px; }
    </style>
</head>
<body class="login-page">
    <main class="auth-container" role="main">
        <div class="email-icon">
            <i class="fas fa-envelope" aria-hidden="true"></i>
        </div>

        <div class="auth-header">
            <h2>Check Your Email</h2>
        </div>

        <div class="auth-content">
            <p>We've sent a verification link to your email address. Please check your email and click the link to verify your account.</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert-error" role="alert">
                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                @ViewBag.Error
            </div>
        }

        <div class="email-details">
            <p>Verification email sent to:</p>
            <div class="email-address">@(ViewBag.Email ?? "your-email@example.com")</div>
        </div>

        <div class="steps-list">
            <h3><i class="fas fa-list-ol" aria-hidden="true"></i> What to do next:</h3>
            <ol>
                <li>Check your email inbox (including spam/junk folder)</li>
                <li>Click the verification link in the email</li>
                <li>Complete your account setup if required</li>
                <li>Sign in to your new account</li>
            </ol>
        </div>

        <div class="action-buttons">
            <a href="@Url.Action("ResendVerification", "Account")" class="btn-primary" aria-label="Resend verification email">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                Resend Verification Email
            </a>

            <a href="@Url.Action("Login", "Account")" class="btn-secondary" aria-label="Go back to login page">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Back to Login
            </a>
        </div>

        <div class="support-info">
            <p>Didn't receive the email or having trouble?</p>
            <p>Contact support: <a href="mailto:support@greencirclecertified.com">support@greencirclecertified.com</a></p>
        </div>
    </main>
</body>
</html>