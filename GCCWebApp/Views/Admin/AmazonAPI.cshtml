@{
    ViewData["Title"] = "Amazon API Integration";
    ViewData["BodyClass"] = "admin-amazon-api";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">API Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Amazon Integration</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Configure Amazon Selling Partner API connection and sync settings</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="test-connection-btn" class="admin-btn admin-btn--secondary" aria-label="Test Amazon API connection">
                        <i class="fas fa-plug" aria-hidden="true"></i> Test Connection
                    </button>
                    <button id="sync-now-btn" class="admin-btn admin-btn--secondary" aria-label="Trigger immediate sync">
                        <i class="fas fa-sync" aria-hidden="true"></i> Sync Now
                    </button>
                    <button id="save-settings-btn" class="admin-btn admin-btn--primary" aria-label="Save Amazon API settings">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Settings
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Status Panel -->
    <div class="admin-info-panel" style="background: #f5f9ff; border: 1px solid #d0e3ff; border-radius: 4px; padding: 20px; margin-bottom: 24px;">
        <h3 style="color: #002B76; font-size: 16px; margin: 0 0 16px 0; font-weight: 600;">
            <i class="fas fa-chart-line" style="color: #00AEEF; margin-right: 8px;"></i>Integration Status
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
            <div>
                <label style="font-size: 12px; color: #666; display: block; margin-bottom: 4px;">Connection Status</label>
                <div id="connection-status" style="font-weight: 600; font-size: 16px;">
                    <span style="color: #999;"><i class="fas fa-circle" style="font-size: 8px; margin-right: 6px;"></i>Not Configured</span>
                </div>
            </div>
            <div>
                <label style="font-size: 12px; color: #666; display: block; margin-bottom: 4px;">Last Sync</label>
                <div id="last-sync" style="font-weight: 500; font-size: 14px; color: #333;">
                    Never
                </div>
            </div>
            <div>
                <label style="font-size: 12px; color: #666; display: block; margin-bottom: 4px;">Sync Status</label>
                <div id="sync-status" style="font-weight: 500; font-size: 14px; color: #333;">
                    <span class="admin-badge admin-badge--secondary">Idle</span>
                </div>
            </div>
            <div>
                <label style="font-size: 12px; color: #666; display: block; margin-bottom: 4px;">Records Synced</label>
                <div id="records-synced" style="font-weight: 500; font-size: 14px; color: #333;">
                    0
                </div>
            </div>
        </div>
    </div>

    <!-- Configuration Form -->
    <div class="admin-content">
        <form id="amazon-api-form" class="admin-form">

            <!-- Enable/Disable Integration -->
            <div class="admin-form-section">
                <h3 class="admin-form-section-title">Integration Settings</h3>

                <div class="admin-form-group">
                    <label class="admin-checkbox-container">
                        <input type="checkbox" id="is-enabled" class="admin-checkbox">
                        <span class="admin-checkbox-label">Enable Amazon API Integration</span>
                    </label>
                    <span class="admin-form-help">When enabled, the system will automatically sync certificates with Amazon on the configured schedule</span>
                </div>

                <div class="admin-form-group">
                    <label for="sync-interval" class="admin-label">Sync Interval (hours)</label>
                    <input type="number" id="sync-interval" class="admin-input" min="1" max="168" value="24" aria-describedby="sync-interval-help">
                    <span id="sync-interval-help" class="admin-form-help">How often to automatically sync certificate data (1-168 hours)</span>
                </div>
            </div>

            <!-- Amazon SP-API Credentials -->
            <div class="admin-form-section">
                <h3 class="admin-form-section-title">Amazon Selling Partner API Credentials</h3>
                <p style="font-size: 13px; color: #666; margin: -8px 0 16px 0;">
                    <i class="fas fa-info-circle" style="color: #00AEEF;"></i>
                    Get your credentials from
                    <a href="https://sellercentral.amazon.com/apps/manage" target="_blank" style="color: #00AEEF;">Amazon Seller Central <i class="fas fa-external-link-alt" style="font-size: 10px;"></i></a>
                </p>

                <div class="admin-form-group">
                    <label for="access-key-id" class="admin-label admin-label--required">Access Key ID (LWA Client ID)</label>
                    <input type="text" id="access-key-id" class="admin-input" required placeholder="amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" aria-describedby="access-key-help">
                    <span id="access-key-help" class="admin-form-help">Your Amazon LWA (Login with Amazon) Client ID</span>
                </div>

                <div class="admin-form-group">
                    <label for="secret-access-key" class="admin-label admin-label--required">Secret Access Key (LWA Client Secret)</label>
                    <div style="position: relative;">
                        <input type="password" id="secret-access-key" class="admin-input" required placeholder="••••••••••••••••••••••••••••••••" style="padding-right: 40px;" aria-describedby="secret-key-help">
                        <button type="button" id="toggle-secret-btn" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #666; padding: 4px 8px;">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span id="secret-key-help" class="admin-form-help">Your Amazon LWA Client Secret (stored encrypted)</span>
                </div>

                <div class="admin-form-group">
                    <label for="refresh-token" class="admin-label admin-label--required">Refresh Token</label>
                    <textarea id="refresh-token" class="admin-textarea" rows="3" required placeholder="Atzr|IwEBIP..." aria-describedby="refresh-token-help"></textarea>
                    <span id="refresh-token-help" class="admin-form-help">LWA refresh token for API access</span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="admin-form-group">
                        <label for="region" class="admin-label admin-label--required">Region</label>
                        <select id="region" class="admin-select" required aria-describedby="region-help">
                            <option value="">Select Region</option>
                            <option value="na">North America (US, CA, MX)</option>
                            <option value="eu">Europe</option>
                            <option value="fe">Far East</option>
                        </select>
                        <span id="region-help" class="admin-form-help">Amazon marketplace region</span>
                    </div>

                    <div class="admin-form-group">
                        <label for="marketplace-id" class="admin-label admin-label--required">Marketplace ID</label>
                        <select id="marketplace-id" class="admin-select" required aria-describedby="marketplace-help">
                            <option value="">Select Marketplace</option>
                            <option value="ATVPDKIKX0DER">US - ATVPDKIKX0DER</option>
                            <option value="A2EUQ1WTGCTBG2">CA - A2EUQ1WTGCTBG2</option>
                            <option value="A1AM78C64UM0Y8">MX - A1AM78C64UM0Y8</option>
                            <option value="A1F83G8C2ARO7P">UK - A1F83G8C2ARO7P</option>
                            <option value="A13V1IB3VIYZZH">FR - A13V1IB3VIYZZH</option>
                            <option value="A1PA6795UKMFR9">DE - A1PA6795UKMFR9</option>
                            <option value="APJ6JRA9NG5V4">IT - APJ6JRA9NG5V4</option>
                            <option value="A1RKKUPIHCS9HS">ES - A1RKKUPIHCS9HS</option>
                        </select>
                        <span id="marketplace-help" class="admin-form-help">Target marketplace for certificate sync</span>
                    </div>
                </div>
            </div>

            <!-- Sync Options -->
            <div class="admin-form-section">
                <h3 class="admin-form-section-title">Sync Configuration</h3>

                <div class="admin-form-group">
                    <label class="admin-checkbox-container">
                        <input type="checkbox" id="sync-products" class="admin-checkbox" checked>
                        <span class="admin-checkbox-label">Sync Product Information</span>
                    </label>
                    <span class="admin-form-help">Update product details from Amazon catalog</span>
                </div>

                <div class="admin-form-group">
                    <label class="admin-checkbox-container">
                        <input type="checkbox" id="sync-certificates" class="admin-checkbox" checked>
                        <span class="admin-checkbox-label">Push Certificates to Amazon</span>
                    </label>
                    <span class="admin-form-help">Automatically upload certificate PDFs to Amazon</span>
                </div>

                <div class="admin-form-group">
                    <label class="admin-checkbox-container">
                        <input type="checkbox" id="sync-compliance" class="admin-checkbox" checked>
                        <span class="admin-checkbox-label">Sync Compliance Status</span>
                    </label>
                    <span class="admin-form-help">Update product compliance fields in Amazon Seller Central</span>
                </div>

                <div class="admin-form-group">
                    <label for="webhook-url" class="admin-label">Webhook URL (Optional)</label>
                    <input type="url" id="webhook-url" class="admin-input" placeholder="https://example.com/webhook" aria-describedby="webhook-help">
                    <span id="webhook-help" class="admin-form-help">Receive notifications when sync completes or errors occur</span>
                </div>
            </div>
        </form>
    </div>

    <!-- Sync History -->
    <div class="admin-content" style="margin-top: 32px;">
        <h3 style="color: #002B76; font-size: 16px; margin: 0 0 16px 0; font-weight: 600;">
            <i class="fas fa-history" style="color: #92C83E; margin-right: 8px;"></i>Recent Sync History
        </h3>
        <div class="admin-table-container">
            <table id="sync-history-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th" width="20%">Timestamp</th>
                        <th class="admin-table-th" width="15%">Type</th>
                        <th class="admin-table-th" width="15%">Records</th>
                        <th class="admin-table-th" width="15%">Duration</th>
                        <th class="admin-table-th" width="15%">Status</th>
                        <th class="admin-table-th" width="20%">Message</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: #666;">
                            <i class="fas fa-clock" style="font-size: 48px; color: #ccc; margin-bottom: 12px;"></i>
                            <p style="margin: 0;">No sync history available</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/amazonapi.js"></script>
    <script>
        // Initialize Amazon API management
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof initializeAmazonAPI === 'function') {
                initializeAmazonAPI();
            }
        });
    </script>
}
