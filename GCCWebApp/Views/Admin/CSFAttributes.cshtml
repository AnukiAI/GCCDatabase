@{
    ViewData["Title"] = "CSF Attributes Management";
    ViewData["BodyClass"] = "admin-csf-attributes";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <style>
        /* CSF Attributes table-specific styles */
        .csf-add-row {
            display: none;
            background-color: #f8f9fa;
        }

        .csf-add-row.active {
            display: table-row;
        }

        .csf-edit-input {
            width: 100%;
            padding: 8px;
            border: 1px solid #00AEEF;
            border-radius: 4px;
            font-family: 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;
            box-sizing: border-box;
        }

        .csf-btn-save,
        .csf-btn-cancel {
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            border: none;
            transition: all 0.2s;
        }

        .csf-btn-save {
            background-color: #447638;
            color: white;
        }

        .csf-btn-save:hover {
            background-color: #92C83E;
        }

        .csf-btn-cancel {
            background-color: #f8f9fa;
            color: #333;
            border: 1px solid #ddd;
        }

        .csf-btn-cancel:hover {
            background-color: #e2e6ea;
        }

        .edit-row {
            background-color: rgba(0, 174, 239, 0.05);
        }

        .edit-row .view-mode {
            display: none;
        }

        .edit-mode {
            display: none;
        }

        .edit-row .edit-mode {
            display: block;
        }

        .edit-row .action-buttons {
            display: none;
        }

        .edit-actions {
            display: none;
        }

        .edit-row .edit-actions {
            display: flex;
            gap: 5px;
        }

        /* Ensure footer count is right-aligned */
        .footer-info {
            text-align: right !important;
            display: block !important;
        }
    </style>
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">CSF Attributes</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export CSF attributes to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-csf-btn" class="admin-btn admin-btn--primary" aria-label="Add a new CSF attribute">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New CSF Attribute
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="search-filter-bar">
        <div class="search-box">
            <input type="text" id="search-input" placeholder="Search">
            <i class="fas fa-search search-icon"></i>
        </div>
    </div>

    <div class="table-container">
        <table id="csf-table">
            <thead>
                <tr>
                    <th width="30%" data-sort="name">Attribute Name <span class="sort-icon">▼</span></th>
                    <th width="50%" data-sort="description">Description <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="isActive">Active <span class="sort-icon">▼</span></th>
                    <th width="10%" class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Add CSF Attribute row (initially hidden) -->
                <tr id="csf-add-row" class="csf-add-row">
                    <td>
                        <input type="text" id="new-csf-name" class="csf-edit-input" placeholder="Enter attribute name" required>
                    </td>
                    <td>
                        <input type="text" id="new-csf-description" class="csf-edit-input" placeholder="Enter description">
                    </td>
                    <td>
                        <input type="checkbox" id="new-csf-active" checked>
                    </td>
                    <td>
                        <div class="csf-add-actions" style="display: flex; gap: 5px;">
                            <button class="csf-btn-save" onclick="saveNewCsfAttribute()">
                                <i class="fas fa-check"></i> Save
                            </button>
                            <button class="csf-btn-cancel" onclick="cancelAddCsfAttribute()">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                        </div>
                    </td>
                </tr>
                <!-- Data will be populated by JavaScript -->
            </tbody>
        </table>
    </div>

    <div class="footer-info">
        <span id="csf-count">Showing 0 of 0 CSF attributes</span>
    </div>
</div>


@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/validation.js"></script>
    <script src="~/js/admin/csfAttributes.js"></script>
    <script>
        // Add export functionality to CSF Attributes
        document.addEventListener('DOMContentLoaded', function() {
            const exportBtn = document.getElementById('export-btn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function() {
                    // Sample data structure for CSF Attributes
                    const sampleData = [
                        { id: 1, name: 'Biobased Content', certificationType: 'GREENGUARD', dataType: 'number', description: 'Percentage of biobased materials' },
                        { id: 2, name: 'VOC Emissions', certificationType: 'GREENGUARD Gold', dataType: 'number', description: 'Volatile organic compound emissions level' },
                        { id: 3, name: 'Formaldehyde Free', certificationType: 'GREENGUARD', dataType: 'boolean', description: 'Contains no formaldehyde' },
                        { id: 4, name: 'Recycled Content', certificationType: 'Cradle to Cradle', dataType: 'number', description: 'Percentage of recycled materials' },
                        { id: 5, name: 'Biodegradable', certificationType: 'GREENGUARD', dataType: 'boolean', description: 'Material is biodegradable' }
                    ];

                    const columns = [
                        { key: 'id', header: 'ID' },
                        { key: 'name', header: 'Attribute Name' },
                        { key: 'certificationType', header: 'Certification Type' },
                        { key: 'dataType', header: 'Data Type' },
                        { key: 'description', header: 'Description' }
                    ];
                    
                    ExportUtils.showExportModal(
                        sampleData, 
                        columns, 
                        'csf_attributes',
                        (message, type) => alert(message)
                    );
                });
            }
        });
    </script>
}