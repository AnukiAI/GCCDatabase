@{
    ViewData["Title"] = "CSF Attributes Management";
    ViewData["BodyClass"] = "admin-csf-attributes";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/admin/admin-inline-editing.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <a href="@Url.Action("Index", "Admin")">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span>Data Management</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">CSF Attributes</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">CSF Attributes Management</h1>
                <p class="admin-page-subtitle">Manage CSF certification attributes</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export CSF attributes to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export to CSV
                    </button>
                    <button id="add-csf-btn" class="admin-btn admin-btn--primary" aria-label="Add a new CSF attribute">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New CSF Attribute
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <i class="fas fa-search admin-search-icon"></i>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search">
                </div>
            </div>
        </div>

        <div class="admin-content">
        <div class="admin-table-container">
            <table id="csf-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="30%">
                            Attribute Name <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="description" width="50%">
                            Description <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="isActive" width="10%">
                            Active <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="10%">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Add CSF Attribute row (initially hidden) -->
                    <tr id="csf-add-row" class="admin-inline-add-row">
                        <td>
                            <input type="text" id="new-csf-name" class="admin-inline-input" placeholder="Enter attribute name" required>
                        </td>
                        <td>
                            <input type="text" id="new-csf-description" class="admin-inline-input" placeholder="Enter description">
                        </td>
                        <td>
                            <input type="checkbox" id="new-csf-active" checked>
                        </td>
                        <td>
                            <div class="admin-inline-add-actions">
                                <button type="button" class="admin-action-btn admin-action-btn--save" onclick="saveNewCsfAttribute()" title="Save" aria-label="Save new attribute">
                                    <i class="fas fa-check" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="admin-action-btn admin-action-btn--cancel" onclick="cancelAddCsfAttribute()" title="Cancel" aria-label="Cancel adding attribute">
                                    <i class="fas fa-times" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

        <div class="admin-footer-info">
            <span id="csf-count" class="admin-count-display">Showing 0 of 0 CSF attributes</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>


@section Scripts {
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/validation.js"></script>
    <script src="~/js/admin/csfAttributes.js"></script>
    @* Export functionality is handled by csfAttributes.js using real database data *@
}