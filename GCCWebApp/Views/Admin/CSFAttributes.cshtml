@{
    ViewData["Title"] = "CSF Attributes Management";
    ViewData["BodyClass"] = "admin-csf-attributes";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/admin/admin-inline-editing.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">CSF Attributes</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Manage CSF certification attributes</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export CSF attributes to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-csf-btn" class="admin-btn admin-btn--primary" aria-label="Add a new CSF attribute">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New CSF Attribute
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <i class="fas fa-search admin-search-icon"></i>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search CSF attributes...">
            </div>
        </div>
    </div>

    <div class="admin-content">
        <div class="admin-table-container">
            <table id="csf-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="30%">
                            Attribute Name <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="description" width="50%">
                            Description <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="isActive" width="10%">
                            Active <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="10%">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Add CSF Attribute row (initially hidden) -->
                    <tr id="csf-add-row" class="admin-inline-add-row">
                        <td>
                            <input type="text" id="new-csf-name" class="admin-inline-input" placeholder="Enter attribute name" required>
                        </td>
                        <td>
                            <input type="text" id="new-csf-description" class="admin-inline-input" placeholder="Enter description">
                        </td>
                        <td>
                            <input type="checkbox" id="new-csf-active" checked>
                        </td>
                        <td>
                            <div class="admin-inline-add-actions">
                                <button type="button" class="admin-inline-btn-cancel" onclick="cancelAddCsfAttribute()" aria-label="Cancel adding attribute">
                                    <i class="fas fa-times" aria-hidden="true"></i> Cancel
                                </button>
                                <button type="button" class="admin-inline-btn-save" onclick="saveNewCsfAttribute()" aria-label="Save new attribute">
                                    <i class="fas fa-check" aria-hidden="true"></i> Save
                                </button>
                            </div>
                        </td>
                    </tr>
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-footer-info">
        <span id="csf-count" class="admin-count-display">Showing 0 of 0 CSF attributes</span>
    </div>
</div>


@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/validation.js"></script>
    <script src="~/js/admin/csfAttributes.js"></script>
    <script>
        // Add export functionality to CSF Attributes
        document.addEventListener('DOMContentLoaded', function() {
            const exportBtn = document.getElementById('export-btn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function() {
                    // Sample data structure for CSF Attributes
                    const sampleData = [
                        { id: 1, name: 'Biobased Content', certificationType: 'GREENGUARD', dataType: 'number', description: 'Percentage of biobased materials' },
                        { id: 2, name: 'VOC Emissions', certificationType: 'GREENGUARD Gold', dataType: 'number', description: 'Volatile organic compound emissions level' },
                        { id: 3, name: 'Formaldehyde Free', certificationType: 'GREENGUARD', dataType: 'boolean', description: 'Contains no formaldehyde' },
                        { id: 4, name: 'Recycled Content', certificationType: 'Cradle to Cradle', dataType: 'number', description: 'Percentage of recycled materials' },
                        { id: 5, name: 'Biodegradable', certificationType: 'GREENGUARD', dataType: 'boolean', description: 'Material is biodegradable' }
                    ];

                    const columns = [
                        { key: 'id', header: 'ID' },
                        { key: 'name', header: 'Attribute Name' },
                        { key: 'certificationType', header: 'Certification Type' },
                        { key: 'dataType', header: 'Data Type' },
                        { key: 'description', header: 'Description' }
                    ];
                    
                    // US-015: Use AdminCore.showNotification instead of alert()
                    ExportUtils.showExportModal(
                        sampleData,
                        columns,
                        'csf_attributes',
                        (message, type) => AdminCore.showNotification(message, type)
                    );
                });
            }
        });
    </script>
}