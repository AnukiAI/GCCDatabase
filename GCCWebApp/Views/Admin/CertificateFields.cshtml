@{
    ViewData["Title"] = "Certificate Field Management";
    ViewData["BodyClass"] = "admin-certificate-fields";
}

@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/certificate-fields.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Certificate Fields</a>
    </span>
}

@section PageActions {
    <button class="admin-btn admin-btn--secondary" id="export-btn" aria-label="Export certificate fields to CSV file">
        <i class="fas fa-download" aria-hidden="true"></i> Export
    </button>
    <button class="admin-btn admin-btn--primary" id="add-field-btn" aria-label="Add a new certificate field">
        <i class="fas fa-plus" aria-hidden="true"></i> Add New Field
    </button>
}

<div class="admin-container">
    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <i class="fas fa-search admin-search-icon"></i>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search fields...">
                </div>
            </div>
        </div>

        <div class="admin-content">
            <div class="table-container">
        <table id="certificate-fields-table">
            <thead>
                <tr>
                    <th width="14%">Section <span class="info-icon">i</span></th>
                    <th width="16%">Field Name <span class="info-icon">i</span></th>
                    <th width="10%">Control Type <span class="info-icon">i</span></th>
                    <th width="10%">Required <span class="info-icon">i</span></th>
                    <th width="10%">Visibility <span class="info-icon">i</span></th>
                    <th width="30%">Notes <span class="info-icon">i</span></th>
                    <th width="10%">Actions</th>
                </tr>
            </thead>
            <tbody id="fields-table-body">
                <!-- Fields will be populated by JavaScript -->
            </tbody>
        </table>
            </div>
        </div> <!-- End admin-content -->

        <div class="admin-footer-info">
            <span id="field-count">Showing 0 of 0 fields</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

<!-- Toast Container -->
<div id="toast-container"></div>

@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/admin/certificate-fields.js"></script>
}