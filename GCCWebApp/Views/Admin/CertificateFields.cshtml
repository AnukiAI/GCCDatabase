@{
    ViewData["Title"] = "Certificate Field Management";
    ViewData["BodyClass"] = "admin-certificate-fields";
}

@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/certificate-fields.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificate Fields</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage certificate field configurations</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button class="admin-btn admin-btn--secondary" id="export-btn" aria-label="Export certificate fields to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button class="admin-btn admin-btn--primary" id="add-field-btn" aria-label="Add a new certificate field">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Field
                    </button>
                </div>
            </div>
        </div>
    </header>
    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <i class="fas fa-search admin-search-icon"></i>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search">
                </div>
            </div>
        </div>

        <div class="admin-content">
            <div class="table-container">
        <table id="certificate-fields-table" class="admin-table">
            <thead class="admin-table-header">
                <tr>
                    <th width="14%" data-sort="section" class="admin-table-th admin-table-th--sortable">Section <span class="sort-icon">▼</span></th>
                    <th width="16%" data-sort="fieldName" class="admin-table-th admin-table-th--sortable">Field Name <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="controlType" class="admin-table-th admin-table-th--sortable">Control Type <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="required" class="admin-table-th admin-table-th--sortable">Required <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="visibility" class="admin-table-th admin-table-th--sortable">Visibility <span class="sort-icon">▼</span></th>
                    <th width="30%" data-sort="notes" class="admin-table-th admin-table-th--sortable">Notes <span class="sort-icon">▼</span></th>
                    <th width="10%" class="admin-table-th admin-table-th--actions">Actions</th>
                </tr>
            </thead>
            <tbody id="fields-table-body">
                <!-- Fields will be populated by JavaScript -->
            </tbody>
        </table>
            </div>
        </div> <!-- End admin-content -->

        <div class="admin-footer-info">
            <span id="field-count">Showing 0 of 0 fields</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

<!-- Toast Container -->
<div id="toast-container"></div>

@section Scripts {
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/admin/certificate-fields.js"></script>
}