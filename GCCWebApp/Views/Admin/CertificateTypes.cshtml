@{
    ViewData["Title"] = "Certificate Types Management";
    ViewData["BodyClass"] = "admin-certificate-types";
}

@section Styles {
    <link href="~/css/certificate-types.css" rel="stylesheet" />
    <link href="~/css/admin-company-style.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Certificate Types</a>
    </span>
}

@section PageActions {
    <button id="export-btn" class="btn">
        <i class="fas fa-download"></i> Export
    </button>
    <button id="add-certtype-btn" class="btn btn-add">
        <i class="fas fa-plus"></i> Add New Certificate Type
    </button>
}

@Html.AntiForgeryToken()

<div class="admin-container">

    <div class="search-filter-bar">
        <div class="search-box">
            <input type="text" id="search-input" placeholder="Search certificate types...">
            <i class="fas fa-search search-icon"></i>
        </div>
    </div>

    <div class="table-container">
        <table class="cert-types-table" id="cert-types-table">
            <thead>
                <tr>
                    <th width="90%" data-sort="name">Certificate Type Name</th>
                    <th width="10%" class="actions-col no-sort">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Certificate type data will be populated here -->
            </tbody>
        </table>
    </div>

    <div class="footer-info" id="certtypes-count">
        Showing 0 of 0 certificate types
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/admin/certificate-types.js"></script>
}