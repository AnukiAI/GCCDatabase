@{
    ViewData["Title"] = "Certificate Types Management";
    ViewData["BodyClass"] = "admin-certificate-types";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Certificate Types</a>
    </span>
}

@section PageActions {
    <div class="admin-button-group">
        <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export certificate types to CSV file">
            <i class="fas fa-download" aria-hidden="true"></i> Export
        </button>
        <button id="add-certtype-btn" class="admin-btn admin-btn--primary" aria-label="Add a new certificate type">
            <i class="fas fa-plus" aria-hidden="true"></i> Add New Certificate Type
        </button>
    </div>
}

@Html.AntiForgeryToken()

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Define and manage certificate type classifications</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export certificate types to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-certtype-btn" class="admin-btn admin-btn--primary" aria-label="Add a new certificate type">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Certificate Type
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <label for="search-input" class="admin-sr-only">Search certificate types</label>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search certificate types..." aria-label="Search certificate types">
                <i class="fas fa-search admin-search-icon"></i>
            </div>
        </div>
    </div>

    <div class="admin-content">
        <div class="admin-table-container">
            <table class="admin-table" id="cert-types-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="90%">
                            Certificate Type Name <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="10%">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Certificate type data will be populated here -->
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-footer-info">
        <span id="certtypes-count" class="admin-count-display">Showing 0 of 0 certificate types</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/admin/certificate-types.js"></script>
}