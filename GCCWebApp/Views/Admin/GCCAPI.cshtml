@{
    ViewData["Title"] = "API Management";
    ViewData["BodyClass"] = "admin-api-management";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <a href="@Url.Action("Index", "Admin")">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span>API Management</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">GCC API Keys</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage API keys and access to GCC endpoints</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="swagger-btn" class="admin-btn admin-btn--secondary" aria-label="View API documentation in Swagger">
                        <i class="fas fa-book" aria-hidden="true"></i> API Docs
                    </button>
                    <button id="generate-key-btn" class="admin-btn admin-btn--primary" aria-label="Generate a new API key">
                        <i class="fas fa-key" aria-hidden="true"></i> Generate API Key
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Unified content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <!-- API Information Panel -->
        <div class="admin-info-panel" style="background: #f5f9ff; border: 1px solid #d0e3ff; border-radius: 4px; padding: 16px; margin-bottom: 20px;">
        <div style="display: flex; gap: 24px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
                <h4 style="margin: 0 0 8px 0; color: #002B76; font-size: 14px; font-weight: 600;">
                    <i class="fas fa-server" style="color: #92C83E; margin-right: 8px;"></i>API Base URL
                </h4>
                <code style="background: white; padding: 6px 10px; border-radius: 3px; display: block; font-size: 13px; border: 1px solid #d0e3ff;">
                    @(Context.Request.Scheme)://@(Context.Request.Host)/api/v1
                </code>
            </div>
            <div style="flex: 1; min-width: 250px;">
                <h4 style="margin: 0 0 8px 0; color: #002B76; font-size: 14px; font-weight: 600;">
                    <i class="fas fa-book-open" style="color: #00AEEF; margin-right: 8px;"></i>Documentation
                </h4>
                <a href="/swagger" target="_blank" style="color: #00AEEF; text-decoration: none; font-size: 13px; font-weight: 500;">
                    @(Context.Request.Scheme)://@(Context.Request.Host)/swagger <i class="fas fa-external-link-alt" style="font-size: 11px; margin-left: 4px;"></i>
                </a>
            </div>
            <div style="flex: 1; min-width: 250px;">
                <h4 style="margin: 0 0 8px 0; color: #002B76; font-size: 14px; font-weight: 600;">
                    <i class="fas fa-shield-alt" style="color: #447638; margin-right: 8px;"></i>Authentication
                </h4>
                <span style="font-size: 13px; color: #666;">Header: <code style="background: white; padding: 2px 6px; border-radius: 3px; border: 1px solid #d0e3ff;">X-API-Key: {your-key}</code></span>
            </div>
        </div>
    </div>

    <!-- Available Endpoints Section -->
    <div style="margin-bottom: 24px;">
        <h3 style="color: #002B76; font-size: 16px; margin: 0 0 12px 0; font-weight: 600;">Available API Endpoints</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
            <div style="background: white; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px;">
                <span style="background: #92C83E; color: white; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600;">GET</span>
                <code style="margin-left: 8px; font-size: 14px;">/api/v1/certificates</code>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #666;">List all certificates</p>
            </div>
            <div style="background: white; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px;">
                <span style="background: #92C83E; color: white; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600;">GET</span>
                <code style="margin-left: 8px; font-size: 14px;">/api/v1/certificates/{id}</code>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #666;">Get certificate by ID</p>
            </div>
            <div style="background: white; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px;">
                <span style="background: #00AEEF; color: white; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600;">POST</span>
                <code style="margin-left: 8px; font-size: 14px;">/api/v1/certificates</code>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #666;">Create new certificate</p>
            </div>
            <div style="background: white; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px;">
                <span style="background: #FFA500; color: white; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600;">PUT</span>
                <code style="margin-left: 8px; font-size: 14px;">/api/v1/certificates/{id}</code>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #666;">Update certificate</p>
            </div>
            <div style="background: white; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px;">
                <span style="background: #92C83E; color: white; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600;">GET</span>
                <code style="margin-left: 8px; font-size: 14px;">/api/v1/products</code>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #666;">List all products</p>
            </div>
            <div style="background: white; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px;">
                <span style="background: #92C83E; color: white; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600;">GET</span>
                <code style="margin-left: 8px; font-size: 14px;">/api/v1/bulk-certificates</code>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #666;">Bulk certificate operations</p>
            </div>
        </div>
    </div>

    <!-- API Keys Table -->
    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <label for="search-input" class="admin-sr-only">Search API keys</label>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search" aria-label="Search API keys">
                <i class="fas fa-search admin-search-icon"></i>
            </div>
        </div>
        <div class="admin-filter-section">
            <div class="admin-filter-group">
                <label for="status-filter" class="admin-sr-only">Filter by status</label>
                <select id="status-filter" class="admin-filter-select" aria-label="Filter by status">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="expired">Expired</option>
                    <option value="revoked">Revoked</option>
                </select>
            </div>
        </div>
    </div>

    <div class="admin-content">
        <div class="admin-table-container">
            <table id="apikey-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="20%">
                            Key Name <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th admin-table-th--hidden-mobile" width="15%">
                            Key Preview
                        </th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="createdAt" width="15%">
                            Created <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th admin-table-th--hidden-mobile" width="15%">
                            Last Used
                        </th>
                        <th class="admin-table-th admin-table-th--hidden-mobile" width="15%">
                            Expires
                        </th>
                        <th class="admin-table-th" width="10%">
                            Status
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="10%">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

        <div class="admin-footer-info">
            <span id="apikey-count" class="admin-count-display">Showing 0 of 0 API keys</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

<!-- Generate API Key Modal (US-015 Modal Backdrop Standard) -->
<div id="apikey-modal" class="admin-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
    <!-- Backdrop (sibling) -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container (sibling) -->
    <div class="admin-modal-container" style="position: relative; z-index: 9999; max-width: 600px; background-color: white; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);" aria-labelledby="generate-key-modal-title-gcc">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef;">
            <h3 class="admin-modal-title" id="generate-key-modal-title-gcc" style="color: #002B76; font-weight: 600;">Generate New API Key</h3>
            <button class="admin-modal-close" aria-label="Close modal">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="admin-modal-body" style="background-color: white;">
            <form id="apikey-form" class="admin-form" data-validate>
                <div class="admin-form-group">
                    <label for="key-name" class="admin-label admin-label--required" style="color: #333; font-weight: 500;">Key Name</label>
                    <input type="text" id="key-name" class="admin-input" required aria-required="true" aria-describedby="key-name-help" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                    <span id="key-name-help" class="admin-form-help" style="color: #6c757d;">A descriptive name for this API key (e.g., "Production Mobile App")</span>
                </div>

                <div class="admin-form-group">
                    <label for="key-description" class="admin-label admin-label--required" style="color: #333; font-weight: 500;">Description</label>
                    <textarea id="key-description" class="admin-textarea" rows="3" required aria-required="true" aria-describedby="key-description-help" style="border: 1px solid #ced4da; background-color: white; color: #333;"></textarea>
                    <span id="key-description-help" class="admin-form-help" style="color: #6c757d;">Describe the purpose and intended use of this API key</span>
                </div>

                <div class="admin-form-group">
                    <label for="key-expiry" class="admin-label" style="color: #333; font-weight: 500;">Expiration Date (Optional)</label>
                    <input type="date" id="key-expiry" class="admin-input" aria-describedby="key-expiry-help" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                    <span id="key-expiry-help" class="admin-form-help" style="color: #6c757d;">Leave blank for no expiration</span>
                </div>
            </form>
        </div>
        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef;">
            <button type="button" class="admin-btn admin-btn--secondary" id="cancel-btn" aria-label="Cancel and close modal"><i class="fas fa-times" aria-hidden="true"></i> Cancel</button>
            <button type="submit" class="admin-btn admin-btn--primary" id="save-btn" form="apikey-form" aria-label="Generate new API key"><i class="fas fa-save" aria-hidden="true"></i> Generate Key</button>
        </div>
    </div>
</div>

<!-- API Key Success Modal (shows generated key once) (US-015 Modal Backdrop Standard) -->
<div id="apikey-success-modal" class="admin-modal" aria-hidden="true" role="dialog">
    <!-- Backdrop (sibling) -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container (sibling) -->
    <div class="admin-modal-container" style="position: relative; z-index: 9999; max-width: 600px; background-color: white; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);" aria-labelledby="key-generated-modal-title-gcc">
        <div class="admin-modal-header" style="background: #92C83E; color: white; border-bottom: 2px solid #7ab32e;">
            <h3 id="key-generated-modal-title-gcc" class="admin-modal-title" style="color: white; font-weight: 600;">
                <i class="fas fa-check-circle"></i> API Key Generated Successfully
            </h3>
        </div>
        <div class="admin-modal-body" style="background-color: white;">
            <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; padding: 12px; margin-bottom: 16px;">
                <strong style="color: #856404;"><i class="fas fa-exclamation-triangle"></i> Important:</strong>
                <p style="margin: 8px 0 0 0; color: #856404; font-size: 14px;">This is the only time you will see the full API key. Please copy it now and store it securely.</p>
            </div>

            <div class="admin-form-group">
                <label class="admin-label" style="color: #333; font-weight: 500;">API Key</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="generated-key" class="admin-input" readonly style="font-family: monospace; background: #f8f9fa; border: 1px solid #ced4da; color: #333;">
                    <button type="button" id="copy-key-btn" class="admin-btn admin-btn--secondary" style="white-space: nowrap;">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                </div>
            </div>

            <div class="admin-form-group">
                <label class="admin-label" style="color: #333; font-weight: 500;">Key Name</label>
                <input type="text" id="generated-key-name" class="admin-input" readonly style="background: #f8f9fa; border: 1px solid #ced4da; color: #333;">
            </div>

            <div class="admin-form-group">
                <label class="admin-label" style="color: #333; font-weight: 500;">Usage Example</label>
                <pre style="background: #2d2d2d; color: #f8f8f2; padding: 12px; border-radius: 4px; overflow-x: auto; font-size: 12px; margin: 0; border: 1px solid #1a1a1a;"><code id="usage-example">curl -H "X-API-Key: YOUR_KEY_HERE" \
  @(Context.Request.Scheme)://@(Context.Request.Host)/api/v1/certificates</code></pre>
            </div>
        </div>
        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef;">
            <button type="button" class="admin-btn admin-btn--primary" id="close-success-btn">I've Saved the Key</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/gccapi.js"></script>
    <script>
        // Initialize API management
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof initializeAPIManagement === 'function') {
                initializeAPIManagement();
            }
        });
    </script>
}
