@model GCCWebApp.Models.GoogleAnalyticsViewModel
@{
    ViewData["Title"] = "Google Analytics Integration";
    ViewData["BodyClass"] = "admin-google-analytics";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/google-analytics.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span>Administration</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span>System Settings</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Google Analytics</span>
    </span>
}

@Html.AntiForgeryToken()

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Configure Google Analytics tracking for your site</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <span class="ga-status-badge @(Model.IsEnabled ? "enabled" : "disabled")" id="status-badge">
                        Status: <strong>@(Model.IsEnabled ? "Enabled" : "Disabled")</strong>
                    </span>
                    <button id="save-settings-btn" class="admin-btn admin-btn--primary">Save Settings</button>
                </div>
            </div>
        </div>
    </header>
    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">

        <div class="admin-content analytics-form">
            <div class="form-group">
                <label for="ga-tracking-id">Tracking ID (G-XXXXXXX)</label>
                <input type="text" id="ga-tracking-id" class="admin-input" placeholder="e.g., G-XXXXXXXXXX" value="@Model.TrackingId">
                <div class="form-help">
                    Enter your Google Analytics 4 Measurement ID to start tracking your website traffic.
                    <a href="https://support.google.com/analytics/answer/9304153" target="_blank">Learn more</a>
                </div>
            </div>

            <div class="toggle-switch-container @(Model.IsEnabled ? "enabled" : "")" id="toggle-container">
                <label class="toggle-switch">
                    <input type="checkbox" id="enable-tracking" onchange="toggleTracking()" @(Model.IsEnabled ? "checked" : "")>
                    <span class="toggle-slider"></span>
                </label>
                <div class="toggle-switch-label">
                    <span class="toggle-switch-title">Google Analytics Tracking</span>
                    <span class="toggle-switch-status" id="status-display">
                        @if (Model.IsEnabled && !string.IsNullOrEmpty(Model.TrackingId))
                        {
                            <text>Enabled - Tracking @Model.TrackingId</text>
                        }
                        else if (Model.IsEnabled)
                        {
                            <text>Enabled - No tracking ID configured</text>
                        }
                        else
                        {
                            <text>Disabled - Analytics not being collected</text>
                        }
                    </span>
                </div>
            </div>

            <div class="form-group">
                <label for="custom-script">Custom Analytics Script (Optional)</label>
                <textarea id="custom-script" class="admin-textarea" placeholder="Paste your complete Google Analytics script here..." rows="8">@Model.CustomScript</textarea>
                <div class="form-help">
                    You can paste the complete script provided by Google Analytics here, or use the Tracking ID field above for automatic script generation.
                </div>
            </div>

            <div class="form-group">
                <label>Additional Configuration Options</label>
                <div class="config-options">
                    <label class="toggle-label">
                        <input type="checkbox" id="anonymize-ip" @(Model.AnonymizeIp ? "checked" : "")>
                        <span class="checkbox-text">Anonymize IP addresses</span>
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" id="enhanced-link" @(Model.EnhancedLinkAttribution ? "checked" : "")>
                        <span class="checkbox-text">Enhanced Link Attribution</span>
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" id="debug-mode" @(Model.DebugMode ? "checked" : "")>
                        <span class="checkbox-text">Debug Mode</span>
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label>Script Preview</label>
                @{
                    var previewId = string.IsNullOrEmpty(Model.TrackingId) ? "G-XXXXXXXXXX" : Model.TrackingId;
                }
                <pre id="script-preview">&lt;script async src="https://www.googletagmanager.com/gtag/js?id=@previewId"&gt;&lt;/script&gt;
&lt;script&gt;
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '@previewId');
&lt;/script&gt;</pre>
            </div>

            <div class="history-section">
                <h3>Change History</h3>
                <div class="admin-table-container">
                    <table id="history-table" class="admin-table">
                        <thead class="admin-table-header">
                            <tr>
                                <th class="admin-table-th" width="25%">Date</th>
                                <th class="admin-table-th" width="25%">User</th>
                                <th class="admin-table-th" width="30%">Tracking ID</th>
                                <th class="admin-table-th" width="20%">Action</th>
                            </tr>
                        </thead>
                        <tbody id="history-log" class="admin-table-body">
                            <tr>
                                <td>2025-04-29 10:15</td>
                                <td>Admin</td>
                                <td>G-XXXXXX1234</td>
                                <td>Enabled</td>
                            </tr>
                            <!-- More entries will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="privacy-notice">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                <strong>Privacy Notice:</strong> You may be required to display a cookie consent banner for GDPR or CCPA compliance.
            </div>
        </div>

        <div class="admin-footer-info">
            <span id="last-updated">Last updated: @(Model.LastUpdated.HasValue ? Model.LastUpdated.Value.ToString("yyyy-MM-dd HH:mm") + (string.IsNullOrEmpty(Model.UpdatedBy) ? "" : " by " + Model.UpdatedBy) : "Not configured")</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

@section Scripts {
    <script src="~/js/admin/googleAnalytics.js" asp-append-version="true"></script>
}