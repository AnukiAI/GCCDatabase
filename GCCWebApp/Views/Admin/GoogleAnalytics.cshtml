@{
    ViewData["Title"] = "Google Analytics Integration";
    ViewData["BodyClass"] = "admin-google-analytics";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/google-analytics.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">System Settings</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Google Analytics</a>
    </span>
}

@section PageActions {
    <button id="save-settings-btn" class="admin-btn admin-btn--primary">Save Settings</button>
}

@Html.AntiForgeryToken()

<div class="admin-container">
    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <!-- No search needed for settings page -->
            </div>
            <div class="admin-filter-section">
                <div class="stats-bar">
                    <div class="stat-item">
                        <span id="tracking-status-indicator" class="stat-number" style="color: #FF5252;">Disabled</span> Status
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-content analytics-form">
            <div class="form-group">
                <label for="ga-tracking-id">Tracking ID (G-XXXXXXX)</label>
                <input type="text" id="ga-tracking-id" class="admin-input" placeholder="e.g., G-XXXXXXXXXX">
                <div class="form-help">
                    Enter your Google Analytics 4 Measurement ID to start tracking your website traffic.
                    <a href="https://support.google.com/analytics/answer/9304153" target="_blank">Learn more</a>
                </div>
            </div>

            <div class="toggle-group">
                <label class="toggle-label">
                    <input type="checkbox" id="enable-tracking" onchange="toggleTracking()">
                    <span class="checkbox-text">Enable Google Analytics Tracking</span>
                </label>
            </div>

            <div class="status-display disabled" id="status-display">
                Tracking is currently <strong>disabled</strong>.
            </div>

            <div class="form-group">
                <label for="custom-script">Custom Analytics Script (Optional)</label>
                <textarea id="custom-script" class="admin-textarea" placeholder="Paste your complete Google Analytics script here..." rows="8"></textarea>
                <div class="form-help">
                    You can paste the complete script provided by Google Analytics here, or use the Tracking ID field above for automatic script generation.
                </div>
            </div>

            <div class="form-group">
                <label>Additional Configuration Options</label>
                <div class="config-options">
                    <label class="toggle-label">
                        <input type="checkbox" id="anonymize-ip">
                        <span class="checkbox-text">Anonymize IP addresses</span>
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" id="enhanced-link">
                        <span class="checkbox-text">Enhanced Link Attribution</span>
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" id="debug-mode">
                        <span class="checkbox-text">Debug Mode</span>
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label>Script Preview</label>
                <pre id="script-preview">&lt;script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"&gt;&lt;/script&gt;
&lt;script&gt;
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XXXXXXXXXX');
&lt;/script&gt;</pre>
            </div>

            <div class="history-section">
                <h3>Change History</h3>
                <div class="admin-table-container">
                    <table id="history-table" class="admin-table">
                        <thead class="admin-table-header">
                            <tr>
                                <th class="admin-table-th" width="25%">Date</th>
                                <th class="admin-table-th" width="25%">User</th>
                                <th class="admin-table-th" width="30%">Tracking ID</th>
                                <th class="admin-table-th" width="20%">Action</th>
                            </tr>
                        </thead>
                        <tbody id="history-log" class="admin-table-body">
                            <tr>
                                <td>2025-04-29 10:15</td>
                                <td>Admin</td>
                                <td>G-XXXXXX1234</td>
                                <td>Enabled</td>
                            </tr>
                            <!-- More entries will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="privacy-notice">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                <strong>Privacy Notice:</strong> You may be required to display a cookie consent banner for GDPR or CCPA compliance.
            </div>
        </div>

        <div class="admin-footer-info">
            <span id="last-updated">Last updated: Not configured</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

@section Scripts {
    <script src="~/js/admin/googleAnalytics.js"></script>
}