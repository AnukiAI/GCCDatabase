@{
    ViewData["Title"] = "Partner API Access";
    ViewData["BodyClass"] = "admin-partner-api";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">API Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Partner API Access</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Manage API keys for external partners to access GCC REST API endpoints</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="refresh-btn" class="admin-btn admin-btn--secondary" title="Refresh data" aria-label="Refresh partner and API key data">
                        <i class="fas fa-sync" aria-hidden="true"></i> Refresh
                    </button>
                    <button id="generate-key-btn" class="admin-btn admin-btn--primary" title="Generate new API key for a partner" aria-label="Generate new API key for a partner">
                        <i class="fas fa-key" aria-hidden="true"></i> Generate API Key
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Partners Overview -->
    <div class="admin-content">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-handshake" style="color: #00AEEF; margin-right: 8px;"></i>Partners
                </h3>
            </div>
            <div class="admin-card-body">
                <div id="partners-loading" role="status" aria-live="polite" aria-label="Loading partners" style="text-align: center; padding: 40px; color: #666;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 32px; color: #00AEEF;" aria-hidden="true"></i>
                    <p style="margin: 16px 0 0 0;">Loading partners...</p>
                </div>
                <div id="partners-container" style="display: none;">
                    <div id="partners-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
                        <!-- Partners will be loaded dynamically -->
                    </div>
                </div>
                <div id="partners-error" style="display: none; text-align: center; padding: 40px; color: #FF5252;">
                    <i class="fas fa-exclamation-triangle" style="font-size: 32px;"></i>
                    <p style="margin: 16px 0 0 0;">Failed to load partners</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Selected Partner Details -->
    <div id="partner-details-section" class="admin-content" style="display: none; margin-top: 24px;">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-chart-bar" style="color: #92C83E; margin-right: 8px;"></i>
                    <span id="partner-name">Partner</span> - Usage Statistics
                </h3>
            </div>
            <div class="admin-card-body">
                <div id="usage-stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin-bottom: 24px;">
                    <div class="stat-card">
                        <label style="font-size: 14px; color: #666; display: block; margin-bottom: 4px;">Total API Keys</label>
                        <div id="stat-total-keys" style="font-weight: 600; font-size: 24px; color: #002B76;">0</div>
                    </div>
                    <div class="stat-card">
                        <label style="font-size: 14px; color: #666; display: block; margin-bottom: 4px;">Active Keys</label>
                        <div id="stat-active-keys" style="font-weight: 600; font-size: 24px; color: #92C83E;">0</div>
                    </div>
                    <div class="stat-card">
                        <label style="font-size: 14px; color: #666; display: block; margin-bottom: 4px;">Revoked Keys</label>
                        <div id="stat-revoked-keys" style="font-weight: 600; font-size: 24px; color: #FF5252;">0</div>
                    </div>
                    <div class="stat-card">
                        <label style="font-size: 14px; color: #666; display: block; margin-bottom: 4px;">Total Requests</label>
                        <div id="stat-total-requests" style="font-weight: 600; font-size: 24px; color: #00AEEF;">0</div>
                    </div>
                    <div class="stat-card">
                        <label style="font-size: 14px; color: #666; display: block; margin-bottom: 4px;">Last Used</label>
                        <div id="stat-last-used" style="font-weight: 500; font-size: 16px; color: #333;">N/A</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- API Keys Table -->
        <div class="admin-card" style="margin-top: 24px;">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-key" style="color: #002B76; margin-right: 8px;"></i>API Keys
                </h3>
            </div>
            <div class="admin-card-body">
                <div class="admin-table-container">
                    <table id="api-keys-table" class="admin-table">
                        <thead class="admin-table-header">
                            <tr>
                                <th class="admin-table-th" width="30%">API Key</th>
                                <th class="admin-table-th" width="15%">Description</th>
                                <th class="admin-table-th" width="12%">Created</th>
                                <th class="admin-table-th" width="12%">Expires</th>
                                <th class="admin-table-th" width="10%">Requests</th>
                                <th class="admin-table-th" width="10%">Last Used</th>
                                <th class="admin-table-th" width="8%">Status</th>
                                <th class="admin-table-th admin-table-th--actions" width="8%">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="admin-table-body" id="api-keys-tbody">
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 40px; color: #666;">
                                    <i class="fas fa-key" style="font-size: 48px; color: #ccc; margin-bottom: 12px;"></i>
                                    <p style="margin: 0;">No API keys found for this partner</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- All API Keys (Overview) -->
    <div class="admin-content" style="margin-top: 24px;">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-list" style="color: #002B76; margin-right: 8px;"></i>All API Keys
                </h3>
            </div>
            <div class="admin-card-body">
                <div id="all-keys-loading" role="status" aria-live="polite" aria-label="Loading API keys" style="text-align: center; padding: 40px; color: #666;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 32px; color: #00AEEF;" aria-hidden="true"></i>
                    <p style="margin: 16px 0 0 0;">Loading API keys...</p>
                </div>
                <div id="all-keys-container" style="display: none;">
                    <div class="admin-table-container">
                        <table id="all-api-keys-table" class="admin-table">
                            <thead class="admin-table-header">
                                <tr>
                                    <th class="admin-table-th" width="15%">Partner</th>
                                    <th class="admin-table-th" width="25%">API Key</th>
                                    <th class="admin-table-th" width="12%">Description</th>
                                    <th class="admin-table-th" width="10%">Created</th>
                                    <th class="admin-table-th" width="10%">Expires</th>
                                    <th class="admin-table-th" width="8%">Requests</th>
                                    <th class="admin-table-th" width="10%">Last Used</th>
                                    <th class="admin-table-th" width="8%">Status</th>
                                    <th class="admin-table-th admin-table-th--actions" width="7%">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="admin-table-body" id="all-keys-tbody">
                                <!-- Loaded dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="all-keys-error" style="display: none; text-align: center; padding: 40px; color: #FF5252;">
                    <i class="fas fa-exclamation-triangle" style="font-size: 32px;"></i>
                    <p style="margin: 16px 0 0 0;">Failed to load API keys</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Generate API Key Modal -->
<div id="generate-key-modal" class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="generate-key-modal-title">
    <!-- Backdrop -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Content -->
    <div class="admin-modal-container" style="position: relative; z-index: 9999; max-width: 600px; background-color: white; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);" aria-labelledby="generate-key-modal-title">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef;">
            <h3 id="generate-key-modal-title" class="admin-modal-title" style="color: #002B76; font-weight: 600;">Generate API Key</h3>
            <button class="admin-modal-close" aria-label="Close modal">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="admin-modal-body" style="background-color: white;">
            <form id="generate-key-form" class="admin-form">
                <div class="admin-form-group">
                    <label for="key-partner-id" class="admin-label admin-label--required" style="color: #333; font-weight: 500;">Partner</label>
                    <select id="key-partner-id" class="admin-select" required style="border: 1px solid #ced4da; background-color: white; color: #333;">
                        <option value="">Select Partner</option>
                        <!-- Partners loaded dynamically -->
                    </select>
                </div>

                <div class="admin-form-group">
                    <label for="key-description" class="admin-label" style="color: #333; font-weight: 500;">Description</label>
                    <input type="text" id="key-description" class="admin-input" placeholder="e.g., Production API Access" maxlength="255" aria-describedby="key-description-help" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                    <span id="key-description-help" class="admin-form-help" style="color: #6c757d;">Optional label to identify this key</span>
                </div>

                <div class="admin-form-group">
                    <label for="key-expires-at" class="admin-label" style="color: #333; font-weight: 500;">Expiration Date</label>
                    <input type="datetime-local" id="key-expires-at" class="admin-input" aria-describedby="key-expires-help" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                    <span id="key-expires-help" class="admin-form-help" style="color: #6c757d;">Leave empty for no expiration</span>
                </div>
            </form>
        </div>
        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef;">
            <button id="cancel-generate-btn" class="admin-btn admin-btn--secondary" aria-label="Cancel and close modal"><i class="fas fa-times" aria-hidden="true"></i> Cancel</button>
            <button id="confirm-generate-btn" class="admin-btn admin-btn--primary" aria-label="Generate new API key"><i class="fas fa-save" aria-hidden="true"></i> Generate Key</button>
        </div>
    </div>
</div>

<!-- API Key Display Modal -->
<div id="key-display-modal" class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="key-display-modal-title">
    <!-- Backdrop -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Content -->
    <div class="admin-modal-container" style="position: relative; z-index: 9999; max-width: 700px; background-color: white; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);" aria-labelledby="key-display-modal-title">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef;">
            <h3 id="key-display-modal-title" class="admin-modal-title" style="color: #002B76; font-weight: 600;">API Key Generated Successfully</h3>
            <button class="admin-modal-close" aria-label="Close modal">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="admin-modal-body" style="background-color: white;">
            <div class="admin-alert admin-alert--warning" style="margin-bottom: 20px; padding: 12px 16px; background-color: #fff3cd; border-left: 4px solid #ffc107; color: #856404;">
                <i class="fas fa-exclamation-triangle" style="color: #ffc107;"></i>
                <strong>Important:</strong> Copy this API key now. You won't be able to see it again!
            </div>

            <div class="admin-form-group">
                <label class="admin-label" style="color: #333; font-weight: 500;">API Key</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="generated-key-value" class="admin-input" readonly style="font-family: monospace; font-size: 14px; border: 1px solid #ced4da; background-color: #f8f9fa; color: #333;">
                    <button id="copy-key-btn" class="admin-btn admin-btn--secondary" style="flex-shrink: 0;">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
                <div>
                    <label style="font-size: 12px; color: #666; display: block; margin-bottom: 4px; font-weight: 500;">Partner</label>
                    <div id="generated-key-partner" style="font-weight: 500; font-size: 14px; color: #333;">-</div>
                </div>
                <div>
                    <label style="font-size: 12px; color: #666; display: block; margin-bottom: 4px; font-weight: 500;">Created</label>
                    <div id="generated-key-created" style="font-weight: 500; font-size: 14px; color: #333;">-</div>
                </div>
            </div>

            <div style="margin-top: 16px;">
                <label style="font-size: 12px; color: #666; display: block; margin-bottom: 4px; font-weight: 500;">Description</label>
                <div id="generated-key-description" style="font-weight: 500; font-size: 14px; color: #333;">-</div>
            </div>
        </div>
        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef;">
            <button id="close-key-display-btn" class="admin-btn admin-btn--primary">Done</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/partnerapi.js"></script>
    <script>
        // Initialize Partner API management
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof initializePartnerAPI === 'function') {
                initializePartnerAPI();
            }
        });
    </script>
}
