@{
    ViewData["Title"] = "Partners Management";
    ViewData["BodyClass"] = "role-admin";
    ViewData["UserName"] = "Jane Smith";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/admin/admin-inline-editing.css" rel="stylesheet" />
    <link href="~/css/partners.css" rel="stylesheet" />
    <link href="~/css/admin-company-style.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Partners</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Manage partner organizations</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="partners-export-btn" class="admin-btn admin-btn--secondary" aria-label="Export partners to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button id="partners-add-btn" class="admin-btn admin-btn--primary" aria-label="Add a new partner">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Partner
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <i class="fas fa-search admin-search-icon"></i>
                <input type="text" id="partners-search-input" class="admin-search-input" placeholder="Search partners...">
            </div>
        </div>
    </div>

    <div class="admin-content">
        <div class="admin-table-container">
            <table id="partners-table" class="admin-table">
            <thead class="admin-table-header">
                <tr>
                    <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="90%">
                        Partner Name <i class="admin-sort-icon fas fa-sort"></i>
                    </th>
                    <th class="admin-table-th admin-table-th--actions" width="10%">Actions</th>
                </tr>
            </thead>
            <tbody id="partners-table-body" class="admin-table-body">
            <!-- Add partner row (initially hidden) -->
            <tr id="partners-add-row" class="admin-inline-add-row">
                <td>
                    <input type="text" id="new-partner-name" class="admin-inline-input" placeholder="Enter partner name">
                </td>
                <td>
                    <div class="admin-inline-add-actions">
                        <button type="button" class="admin-action-btn admin-action-btn--save" onclick="saveNewPartner()" title="Save" aria-label="Save new partner">
                            <i class="fas fa-check" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="admin-action-btn admin-action-btn--cancel" onclick="cancelAddPartner()" title="Cancel" aria-label="Cancel adding partner">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                </td>
            </tr>
            <!-- Table rows will be populated by JavaScript -->
            </tbody>
        </table>
        </div>
    </div>

    <div class="admin-footer-info">
        <span id="partners-count" class="admin-count-display">Showing 0 of 0 partners</span>
    </div>
</div>

<!-- Antiforgery token for AJAX requests -->
@Html.AntiForgeryToken()

<!-- Toast notifications handled by AdminCore.showNotification -->

@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script>
        // Initialize partners management
        let partnersData = [];
        let sortColumn = 'name';
        let sortDirection = 'asc';

        document.addEventListener('DOMContentLoaded', function() {
            initializePartnersManagement();
        });

        function initializePartnersManagement() {
            // Load initial data
            loadPartners();

            // Initialize search
            const searchInput = document.getElementById('partners-search-input');
            if (searchInput) {
                searchInput.addEventListener('input', handlePartnersSearch);
            }

            // Initialize sorting
            initializePartnersSorting();

            // Initialize page actions
            initializePartnersPageActions();
        }

        function loadPartners() {
            // Show loading state - preserve add row
            const tableBody = document.getElementById('partners-table-body');
            const addRow = document.getElementById('partners-add-row');
            if (tableBody) {
                // Save the add row before clearing
                const savedAddRow = addRow ? addRow.cloneNode(true) : null;
                tableBody.innerHTML = '<tr><td colspan="2" class="partners-loading">Loading partners...</td></tr>';
                // Re-append the add row at the beginning
                if (savedAddRow) {
                    tableBody.insertBefore(savedAddRow, tableBody.firstChild);
                }
            }

            // Make AJAX call to get partners from server
            fetch('/Admin/GetPartners', {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(result => {
                if (result.success && result.data) {
                    partnersData = result.data.map(partner => ({
                        id: partner.id,
                        name: partner.name,
                        description: partner.description || '',
                        website: partner.website || '',
                        isActive: partner.isActive,
                        userCount: partner.userCount || 0,
                        createdDate: partner.createdDate
                    }));
                    populatePartnersTable(partnersData);
                } else {
                    throw new Error(result.message || 'Failed to load partners');
                }
            })
            .catch(error => {
                console.error('Error loading partners:', error);
                showPartnersToast('Error loading partners: ' + error.message, 'error');

                // Show empty state - preserve add row
                const tableBody = document.getElementById('partners-table-body');
                const addRow = document.getElementById('partners-add-row');
                if (tableBody) {
                    const savedAddRow = addRow ? addRow.cloneNode(true) : null;
                    tableBody.innerHTML = '<tr><td colspan="2" class="partners-empty-state"><h3>Error Loading Partners</h3><p>Unable to load partners data. Please try refreshing the page.</p></td></tr>';
                    if (savedAddRow) {
                        tableBody.insertBefore(savedAddRow, tableBody.firstChild);
                    }
                }
            });
        }

        function populatePartnersTable(data) {
            const tableBody = document.getElementById('partners-table-body');
            if (!tableBody) return;

            // Clear existing data rows but keep the add row
            const addRow = document.getElementById('partners-add-row');
            tableBody.innerHTML = '';
            if (addRow) {
                tableBody.appendChild(addRow);
            }

            // Add existing partners
            data.forEach(partner => {
                const row = document.createElement('tr');
                row.setAttribute('data-id', partner.id);

                // Partner Name cell
                const nameCell = document.createElement('td');

                // View mode
                const nameSpan = document.createElement('span');
                nameSpan.className = 'admin-inline-view';
                nameSpan.textContent = partner.name;
                nameCell.appendChild(nameSpan);

                // Edit mode
                const nameEditDiv = document.createElement('div');
                nameEditDiv.className = 'admin-inline-edit';
                nameEditDiv.innerHTML = `<input type="text" class="admin-inline-input" value="${partner.name}">`;
                nameCell.appendChild(nameEditDiv);

                // Actions cell
                const actionsCell = document.createElement('td');

                // Regular action buttons (view mode)
                const actionButtons = document.createElement('div');
                actionButtons.className = 'admin-inline-actions';
                actionButtons.innerHTML = `
                    <button class="admin-inline-action-btn admin-inline-action-btn--edit" onclick="editPartner(${partner.id})" title="Edit Partner" aria-label="Edit partner ${partner.name}">
                        <i class="fas fa-edit" aria-hidden="true"></i>
                    </button>
                    <button class="admin-inline-action-btn admin-inline-action-btn--delete" onclick="deletePartner(${partner.id})" title="Delete Partner" aria-label="Delete partner ${partner.name}">
                        <i class="fas fa-trash" aria-hidden="true"></i>
                    </button>
                `;
                actionsCell.appendChild(actionButtons);

                // Edit action buttons (edit mode)
                const editActions = document.createElement('div');
                editActions.className = 'admin-inline-edit-actions';
                editActions.innerHTML = `
                    <button type="button" class="admin-action-btn admin-action-btn--save" onclick="savePartner(${partner.id})" title="Save" aria-label="Save changes"><i class="fas fa-check" aria-hidden="true"></i></button>
                    <button type="button" class="admin-action-btn admin-action-btn--cancel" onclick="cancelEdit(${partner.id})" title="Cancel" aria-label="Cancel editing"><i class="fas fa-times" aria-hidden="true"></i></button>
                `;
                actionsCell.appendChild(editActions);

                row.appendChild(nameCell);
                row.appendChild(actionsCell);
                tableBody.appendChild(row);
            });

            // Update partner count
            updatePartnersCount(data.length);
        }

        function initializePartnersSorting() {
            const headers = document.querySelectorAll('#partners-table th[data-sort]');

            headers.forEach(header => {
                header.addEventListener('click', () => {
                    const column = header.getAttribute('data-sort');

                    // Toggle sort direction if clicking the same column
                    if (sortColumn === column) {
                        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortColumn = column;
                        sortDirection = 'asc';
                    }

                    // Update header styling
                    headers.forEach(h => {
                        h.classList.remove('active-sort');
                        const icon = h.querySelector('.admin-sort-icon');
                        if (icon) {
                            icon.className = 'admin-sort-icon fas fa-sort';
                        }
                    });

                    header.classList.add('active-sort');
                    const sortIcon = header.querySelector('.admin-sort-icon');
                    if (sortIcon) {
                        sortIcon.className = 'admin-sort-icon fas ' + (sortDirection === 'asc' ? 'fa-sort-up' : 'fa-sort-down');
                    }

                    // Sort the data
                    sortPartnersData();
                });
            });
        }

        function sortPartnersData() {
            const filteredData = getFilteredPartnersData();

            filteredData.sort((a, b) => {
                const valueA = a[sortColumn].toString().toLowerCase();
                const valueB = b[sortColumn].toString().toLowerCase();

                if (sortDirection === 'asc') {
                    return valueA.localeCompare(valueB);
                } else {
                    return valueB.localeCompare(valueA);
                }
            });

            populatePartnersTable(filteredData);
        }

        function getFilteredPartnersData() {
            const searchInput = document.getElementById('partners-search-input');
            const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';

            if (!searchTerm) {
                return [...partnersData];
            }

            return partnersData.filter(partner =>
                partner.name.toLowerCase().includes(searchTerm)
            );
        }

        function handlePartnersSearch() {
            sortPartnersData();
        }

        function updatePartnersCount(count) {
            const countElement = document.getElementById('partners-count');
            if (countElement) {
                countElement.textContent = `Showing ${count} of ${partnersData.length} partners`;
            }
        }

        function initializePartnersPageActions() {
            const addBtn = document.getElementById('partners-add-btn');
            const exportBtn = document.getElementById('partners-export-btn');

            if (addBtn) {
                addBtn.addEventListener('click', showAddPartnerRow);
            }

            if (exportBtn) {
                exportBtn.addEventListener('click', exportPartners);
            }
        }

        // Partner Management Functions
        function showAddPartnerRow() {
            const addRow = document.getElementById('partners-add-row');
            if (addRow) {
                addRow.classList.add('active');
                const input = addRow.querySelector('.admin-inline-input');
                if (input) {
                    input.value = '';
                    input.focus();
                }
            }
        }

        function saveNewPartner() {
            const nameInput = document.getElementById('new-partner-name');
            const name = nameInput ? nameInput.value.trim() : '';

            if (!name) {
                showPartnersToast('Partner name cannot be empty', 'error');
                if (nameInput) nameInput.focus();
                return;
            }

            // Check for duplicate names
            const existingPartner = partnersData.find(p => p.name.toLowerCase() === name.toLowerCase());
            if (existingPartner) {
                showPartnersToast('Partner name already exists', 'error');
                if (nameInput) nameInput.focus();
                return;
            }

            // Get antiforgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // Make AJAX call to create new partner
            fetch('/Admin/CreatePartner', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    name: name,
                    description: '',
                    website: '',
                    ContactEmail: '',
                    isActive: true
                })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(result => {
                if (result.success) {
                    // Reset add row
                    if (nameInput) nameInput.value = '';
                    const addRow = document.getElementById('partners-add-row');
                    if (addRow) addRow.classList.remove('active');

                    // Reload partners from server
                    loadPartners();
                    showPartnersToast('Partner added successfully', 'success');
                } else {
                    throw new Error(result.message || 'Failed to create partner');
                }
            })
            .catch(error => {
                console.error('Error creating partner:', error);
                showPartnersToast('Error creating partner: ' + error.message, 'error');
                if (nameInput) nameInput.focus();
            });
        }

        function cancelAddPartner() {
            const nameInput = document.getElementById('new-partner-name');
            if (nameInput) nameInput.value = '';

            const addRow = document.getElementById('partners-add-row');
            if (addRow) addRow.classList.remove('active');
        }

        function editPartner(id) {
            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (!row) return;

            row.classList.add('admin-inline-edit-row');
            const input = row.querySelector('.admin-inline-input');
            if (input) {
                input.focus();
                input.select();
            }
        }

        function savePartner(id) {
            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (!row) return;

            const input = row.querySelector('.admin-inline-input');
            const newName = input ? input.value.trim() : '';

            if (!newName) {
                showPartnersToast('Partner name cannot be empty', 'error');
                if (input) input.focus();
                return;
            }

            // Check for duplicate names (excluding current partner)
            const existingPartner = partnersData.find(p => p.id !== id && p.name.toLowerCase() === newName.toLowerCase());
            if (existingPartner) {
                showPartnersToast('Partner name already exists', 'error');
                if (input) input.focus();
                return;
            }

            // Get current partner data and antiforgery token
            const currentPartner = partnersData.find(p => p.id === id);
            if (!currentPartner) {
                showPartnersToast('Partner not found', 'error');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // Make AJAX call to update partner
            fetch(`/Admin/UpdatePartner/${id}`, {
                method: 'PUT',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    id: id,
                    name: newName,
                    description: currentPartner.description || '',
                    website: currentPartner.website || '',
                    contactEmail: currentPartner.contactEmail || '',
                    isActive: currentPartner.isActive
                })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(result => {
                if (result.success) {
                    // Update local data
                    const partnerIndex = partnersData.findIndex(p => p.id === id);
                    if (partnerIndex !== -1) {
                        partnersData[partnerIndex].name = newName;
                    }

                    // Update display
                    const nameSpan = row.querySelector('.admin-inline-view');
                    if (nameSpan) nameSpan.textContent = newName;

                    // Remove edit class
                    row.classList.remove('admin-inline-edit-row');
                    showPartnersToast('Partner updated successfully', 'success');
                } else {
                    throw new Error(result.message || 'Failed to update partner');
                }
            })
            .catch(error => {
                console.error('Error updating partner:', error);
                showPartnersToast('Error updating partner: ' + error.message, 'error');
                if (input) input.focus();
            });
        }

        function cancelEdit(id) {
            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (!row) return;

            // Get original name
            const partner = partnersData.find(p => p.id === id);
            if (!partner) return;

            // Reset input value to original
            const input = row.querySelector('.admin-inline-input');
            if (input) input.value = partner.name;

            // Remove edit class
            row.classList.remove('admin-inline-edit-row');
        }

        async function deletePartner(id) {
            const partner = partnersData.find(p => p.id === id);
            if (!partner) return;

            // Use AdminCore.showConfirmation instead of native confirm
            const confirmed = await AdminCore.showConfirmation({
                title: 'Delete Confirmation',
                message: `Are you sure you want to delete <strong>${partner.name}</strong>? This action cannot be undone.`,
                confirmText: 'Delete',
                cancelText: 'Cancel',
                type: 'danger',
                allowHtml: true
            });

            if (!confirmed) {
                return;
            }

            // Get antiforgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // Make AJAX call to delete partner
            fetch(`/Admin/DeletePartner/${id}`, {
                method: 'DELETE',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': token
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(result => {
                if (result.success) {
                    // Remove from local data and refresh display
                    partnersData = partnersData.filter(partner => partner.id !== id);
                    sortPartnersData();
                    showPartnersToast('Partner deleted successfully', 'success');
                } else {
                    throw new Error(result.message || 'Failed to delete partner');
                }
            })
            .catch(error => {
                console.error('Error deleting partner:', error);
                showPartnersToast('Error deleting partner: ' + error.message, 'error');
            });
        }

        function exportPartners() {
            if (partnersData.length === 0) {
                showPartnersToast('No partners to export', 'warning');
                return;
            }

            // Use server-side export for properly formatted data
            const exportUrl = '/Admin/ExportData?entityType=Partners&format=csv';
            
            // Create temporary link to trigger download
            const a = document.createElement('a');
            a.href = exportUrl;
            a.download = `partners_${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);

            showPartnersToast('Partners exported successfully', 'success');
        }

        // Use AdminCore.showNotification for all toast notifications (US-015 compliant)
        function showPartnersToast(message, type = 'info') {
            AdminCore.showNotification(message, type);
        }
    </script>
}