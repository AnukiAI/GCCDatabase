@{
    ViewData["Title"] = "Product Management";
    ViewData["BodyClass"] = "admin-product-management";
}

@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span>Administration</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span>Data Management</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Product Management</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage product categories and types</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="template-btn" class="admin-btn admin-btn--secondary" aria-label="Download CSV template for bulk product import">
                        <i class="fas fa-file-download" aria-hidden="true"></i> Template
                    </button>
                    <button id="import-btn" class="admin-btn admin-btn--secondary" aria-label="Import products from CSV file">
                        <i class="fas fa-file-arrow-down" aria-hidden="true"></i> Import
                    </button>
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export products to CSV file">
                        <i class="fas fa-file-arrow-up" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-product-btn" class="admin-btn admin-btn--primary" aria-label="Add a new product">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Product
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <label for="search-input" class="admin-sr-only">Search products</label>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search" aria-label="Search products">
                    <i class="fas fa-search admin-search-icon"></i>
                </div>
            </div>
        </div>

        <div class="admin-content">
        <div class="admin-table-container">
            <table id="products-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="30%">
                            Product Name <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th" width="30%">Parent Identifiers</th>
                        <th class="admin-table-th" width="15%">Status</th>
                        <th class="admin-table-th admin-table-th--actions" width="25%">Actions</th>
                    </tr>
                </thead>
                <tbody id="products-table-body" class="admin-table-body">
                    <!-- Add product row (initially hidden) -->
                    <tr id="add-row" class="admin-table-row admin-table-row--add" style="display: none;">
                        <td class="admin-table-cell" data-label="Product Name">
                            <input type="text" id="new-product-input" class="admin-input admin-input--inline" placeholder="Enter product name" aria-label="New product name">
                        </td>
                        <td class="admin-table-cell" data-label="Parent Identifiers">
                            <span class="text-muted">—</span>
                        </td>
                        <td class="admin-table-cell admin-table-cell--actions" data-label="Actions">
                            <div class="admin-action-group">
                                <button class="admin-btn admin-btn--sm admin-btn--secondary" id="cancel-new-btn" aria-label="Cancel adding product">
                                    <i class="fas fa-times" aria-hidden="true"></i> Cancel
                                </button>
                                <button class="admin-btn admin-btn--sm admin-btn--success" id="save-new-btn" aria-label="Save new product">
                                    <i class="fas fa-check" aria-hidden="true"></i> Save
                                </button>
                            </div>
                        </td>
                    </tr>
                    <!-- Product data will be populated here -->
                </tbody>
            </table>
        </div>
    </div>

        <div class="admin-footer-info">
            <span id="products-count" class="admin-count-display">Showing 0 of 0 products</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

<!-- Import Preview Modal (US-015 Backdrop Standard) -->
<div id="import-preview-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9997;">
    <!-- Backdrop (sibling) -->
    <div class="import-modal-backdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container (sibling) -->
    <div class="import-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; width: 95%; max-width: 1100px; max-height: 90vh; background-color: white; border-radius: 8px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column; opacity: 1;">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 8px 8px 0 0;">
            <h3 class="admin-modal-title" style="color: #002B76; font-weight: 600; margin: 0; font-size: 18px;">
                <i class="fas fa-file-arrow-down" style="margin-right: 8px;"></i> Import Preview - Products
                <span id="import-filename" style="font-weight: normal; font-size: 14px; color: #666; margin-left: 12px;"></span>
            </h3>
            <button class="admin-modal-close" onclick="productManagement.closeImportPreviewModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #666; padding: 4px 8px;">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="admin-modal-body" style="background-color: white; padding: 20px; overflow-y: auto; flex: 1;">
            <!-- Summary Stats -->
            <div id="import-summary" class="import-summary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 20px;">
                <div class="import-stat" style="background: #e8f5e1; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-new" style="font-size: 24px; font-weight: 600; color: #447638;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">New</div>
                </div>
                <div class="import-stat" style="background: #e6f7ff; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-modified" style="font-size: 24px; font-weight: 600; color: #002B76;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Modified</div>
                </div>
                <div class="import-stat" style="background: #f5f5f5; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-unchanged" style="font-size: 24px; font-weight: 600; color: #999;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Unchanged</div>
                </div>
                <div class="import-stat" style="background: #ffebee; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-errors" style="font-size: 24px; font-weight: 600; color: #ff5252;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Errors</div>
                </div>
            </div>

            <!-- Preview Table -->
            <div class="import-preview-table-container" style="border: 1px solid #e9ecef; border-radius: 6px; overflow: hidden; overflow-x: auto;">
                <table class="import-preview-table" style="width: 100%; border-collapse: collapse; font-size: 14px; min-width: 800px;">
                    <thead>
                        <tr style="background: #f8f9fa;">
                            <th style="padding: 12px; text-align: center; border-bottom: 2px solid #e9ecef; width: 40px;">
                                <input type="checkbox" id="import-select-all" checked>
                            </th>
                            <th style="padding: 12px; text-align: center; border-bottom: 2px solid #e9ecef; width: 50px;">Row</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 90px;">Status</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Product Name</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Description</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 150px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="import-preview-tbody">
                        <!-- Rows populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Legend -->
            <div class="import-legend" style="margin-top: 16px; display: flex; gap: 20px; flex-wrap: wrap; font-size: 12px; color: #666;">
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #92C83E; border-radius: 2px; margin-right: 4px;"></span> New - Will be created</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #ffc107; border-radius: 2px; margin-right: 4px;"></span> Modified - Has changes</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #999; border-radius: 2px; margin-right: 4px;"></span> Unchanged - No action needed</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #ff5252; border-radius: 2px; margin-right: 4px;"></span> Error - Has validation errors</span>
            </div>
        </div>

        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 0 0 8px 8px;">
            <div class="import-selected-count" style="font-size: 14px; color: #666;">
                <span id="import-selected-count">0 of 0 rows will be imported</span>
            </div>
            <div class="admin-modal-actions" style="display: flex; gap: 12px;">
                <button type="button" class="admin-btn admin-btn--secondary" onclick="productManagement.closeImportPreviewModal()">
                    Cancel
                </button>
                <button type="button" id="import-apply-btn" class="admin-btn admin-btn--primary" onclick="productManagement.applySelectedImport()">
                    <i class="fas fa-check"></i> Apply Import
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-pagination.js"></script>
    <script src="~/js/admin/productManagement.js?v=5"></script>
    <script>
        // Enhanced product management with admin framework
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize product management
            if (typeof initializeProductManagement === 'function') {
                initializeProductManagement();
            }

            // Enhanced inline add functionality
            const addProductBtn = document.getElementById('add-product-btn');
            const addRow = document.getElementById('add-row');
            const newProductInput = document.getElementById('new-product-input');
            const saveNewBtn = document.getElementById('save-new-btn');
            const cancelNewBtn = document.getElementById('cancel-new-btn');

            if (addProductBtn) {
                addProductBtn.addEventListener('click', function() {
                    // Show add row
                    addRow.style.display = 'table-row';
                    newProductInput.focus();
                    AdminCore.announceToScreenReader('Add product form opened');
                });
            }

            if (cancelNewBtn) {
                cancelNewBtn.addEventListener('click', function() {
                    // Hide add row and reset input
                    addRow.style.display = 'none';
                    newProductInput.value = '';
                    AdminCore.announceToScreenReader('Add product cancelled');
                });
            }

            if (saveNewBtn) {
                saveNewBtn.addEventListener('click', async function() {
                    const productName = newProductInput.value.trim();

                    if (!productName) {
                        AdminCore.showNotification('Product name is required', 'error');
                        newProductInput.focus();
                        return;
                    }

                    // Show loading state
                    AdminCore.showLoading(saveNewBtn);

                    try {
                        // Get anti-forgery token
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                        // Call real API to create product
                        const response = await fetch('/Admin/CreateProduct', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({ name: productName })
                        });

                        const result = await response.json();

                        AdminCore.hideLoading(saveNewBtn);

                        if (result.success) {
                            addRow.style.display = 'none';
                            newProductInput.value = '';
                            AdminCore.showNotification('Product added successfully!', 'success');

                            // Refresh product list using ProductManagement class
                            if (window.productManagement && typeof window.productManagement.loadProducts === 'function') {
                                await window.productManagement.loadProducts();
                                window.productManagement.renderProducts();
                                window.productManagement.updateProductCount();
                            }
                        } else {
                            AdminCore.showNotification(result.message || 'Failed to create product', 'error');
                        }
                    } catch (error) {
                        console.error('Error creating product:', error);
                        AdminCore.hideLoading(saveNewBtn);
                        AdminCore.showNotification('Error creating product. Please try again.', 'error');
                    }
                });
            }

            // Handle Enter key in new product input
            if (newProductInput) {
                newProductInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        saveNewBtn.click();
                    } else if (e.key === 'Escape') {
                        cancelNewBtn.click();
                    }
                });
            }

            // Enhanced search functionality
            const searchInput = document.getElementById('search-input');
            if (searchInput) {
                // Debounced search
                const debouncedSearch = AdminCore.debounce(function(value) {
                    AdminCore.announceToScreenReader(`Searching for: ${value}`);
                    // Implement search logic
                    if (typeof handleProductSearch === 'function') {
                        handleProductSearch(value);
                    }
                }, 300);

                searchInput.addEventListener('input', function() {
                    debouncedSearch(this.value);
                });
            }

            // Table action handling with admin framework
            document.addEventListener('click', function(e) {
                if (e.target.matches('.admin-action-btn--edit') || e.target.closest('.admin-action-btn--edit')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const productId = row.dataset.id;
                        editProduct(productId, row);
                    }
                }

                if (e.target.matches('.admin-action-btn--delete') || e.target.closest('.admin-action-btn--delete')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const productId = row.dataset.id;
                        const productName = row.querySelector('.product-name')?.textContent || 'this product';

                        // Use AdminCore.showConfirmation instead of native confirm
                        AdminCore.showConfirmation({
                            title: 'Delete Confirmation',
                            message: `Are you sure you want to delete <strong>${productName}</strong>? This action cannot be undone.`,
                            confirmText: 'Delete',
                            cancelText: 'Cancel',
                            type: 'danger',
                            allowHtml: true
                        }).then(confirmed => {
                            if (confirmed) {
                                deleteProduct(productId, row);
                            }
                        });
                    }
                }
            });

            // Real implementations connected to backend APIs
            window.editProduct = function(productId, row) {
                // Use ProductManagement class for inline editing
                if (window.productManagement) {
                    window.productManagement.currentEditingId = parseInt(productId);
                    window.productManagement.renderProducts();
                    AdminCore.announceToScreenReader('Edit mode activated for product ' + productId);
                }
            };

            window.deleteProduct = async function(productId, row) {
                AdminCore.showLoading(row);

                try {
                    // Get anti-forgery token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                    // Call real API to delete product
                    const response = await fetch(`/Admin/DeleteProduct?id=${productId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        AdminCore.showNotification('Product deleted successfully!', 'success');
                        // Refresh product list
                        if (window.productManagement && typeof window.productManagement.loadProducts === 'function') {
                            await window.productManagement.loadProducts();
                            window.productManagement.renderProducts();
                            window.productManagement.updateProductCount();
                        }
                    } else {
                        AdminCore.showNotification(result.message || 'Failed to delete product', 'error');
                    }
                } catch (error) {
                    console.error('Error deleting product:', error);
                    AdminCore.showNotification('Error deleting product. Please try again.', 'error');
                }
            };

            // Export functionality - real CSV export
            const exportBtn = document.getElementById('export-btn');
            if (exportBtn) {
                exportBtn.addEventListener('click', async function() {
                    AdminCore.showLoading(exportBtn);

                    try {
                        // Get products from ProductManagement class
                        const products = window.productManagement?.products || [];

                        if (products.length === 0) {
                            AdminCore.hideLoading(exportBtn);
                            AdminCore.showNotification('No products to export', 'warning');
                            return;
                        }

                        // CSV columns must match UI table headers: Product Name, Parent Identifiers, Status
                        const headers = ['Product Name', 'Parent Identifiers', 'Status'];
                        const csvRows = [headers.join(',')];

                        const formatParentIdentifiers = (product) => {
                            const list = product.productIdentifiers || [];
                            if (!list.length) return '';
                            const grouped = {};
                            list.forEach(pi => {
                                const t = (pi.identifierType || '').toString();
                                if (!grouped[t]) grouped[t] = [];
                                grouped[t].push(pi.identifierValue || '');
                            });
                            return Object.keys(grouped)
                                .map(t => `${t}: ${grouped[t].join(', ')}`)
                                .join('; ');
                        };

                        products.forEach(product => {
                            const row = [
                                `"${(product.name || '').replace(/"/g, '""')}"`,
                                `"${formatParentIdentifiers(product).replace(/"/g, '""')}"`,
                                product.isActive ? 'Active' : 'Inactive'
                            ];
                            csvRows.push(row.join(','));
                        });

                        const csvContent = csvRows.join('\n');
                        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                        const link = document.createElement('a');
                        link.href = URL.createObjectURL(blob);
                        link.download = `products_export_${new Date().toISOString().split('T')[0]}.csv`;
                        link.click();

                        AdminCore.hideLoading(exportBtn);
                        AdminCore.showNotification(`Exported ${products.length} products successfully!`, 'success');
                    } catch (error) {
                        console.error('Error exporting products:', error);
                        AdminCore.hideLoading(exportBtn);
                        AdminCore.showNotification('Error exporting products. Please try again.', 'error');
                    }
                });
            }

        });
    </script>
}