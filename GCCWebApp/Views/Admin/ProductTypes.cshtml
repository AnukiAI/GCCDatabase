@{
    ViewData["Title"] = "Product Types Management";
    ViewData["BodyClass"] = "admin-product-types";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/product-types.css" rel="stylesheet" />
    <link href="~/css/product-types-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Product Types</a>
    </span>
}

@Html.AntiForgeryToken()
<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Manage product categories, types, and subcategories</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export product types to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button class="admin-btn admin-btn--primary" onclick="showAddForm('category')" aria-label="Add a new product category">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Category
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <label for="search-input" class="admin-sr-only">Search product types</label>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search hierarchy..." onkeyup="filterTree(this.value)" aria-label="Search product types">
                <i class="fas fa-search admin-search-icon"></i>
            </div>
        </div>
        <div class="admin-filter-section">
            <div class="stats-bar">
                <div class="stat-item">
                    <span class="stat-number">0</span> Categories
                </div>
                <div class="stat-item">
                    <span class="stat-number">0</span> Types
                </div>
                <div class="stat-item">
                    <span class="stat-number">0</span> Subcategories
                </div>
                <div class="stat-item">
                    <span class="stat-number">0</span> Products
                </div>
            </div>
        </div>
    </div>

    <div class="toolbar">
        <div class="view-options">
            <button class="view-btn active" data-view="tree" onclick="switchView('tree')">
                <i class="fas fa-sitemap"></i> Tree View
            </button>
            <button class="view-btn" data-view="table" onclick="switchView('table')">
                <i class="fas fa-table"></i> Table View
            </button>
        </div>
        <div class="bulk-actions">
            <button class="btn btn-outline btn-sm" onclick="expandAll()">
                <i class="fas fa-expand-alt"></i> Expand All
            </button>
            <button class="btn btn-outline btn-sm" onclick="collapseAll()">
                <i class="fas fa-compress-alt"></i> Collapse All
            </button>
        </div>
    </div>

    <!-- Tree View -->
    <div class="hierarchy-tree" id="treeView">
        <div class="tree-header">
            <div class="tree-header-content">
                <div class="tree-header-label">
                    Product Hierarchy
                </div>
                <div class="tree-header-columns">
                    <div class="tree-column-header products-header">Products</div>
                    <div class="tree-column-header actions-header">Actions</div>
                </div>
            </div>
        </div>
        <div class="tree-content">
            <!-- Loading state - will be replaced by API data -->
            <div class="loading-state" id="tree-loading">
                <i class="fas fa-spinner fa-spin"></i>
                <span>Loading product types...</span>
            </div>
            <!-- Empty state - shown when no data -->
            <div class="empty-state" id="tree-empty" style="display: none;">
                <i class="fas fa-folder-open"></i>
                <span>No product types found. Click "Add New Category" to create one.</span>
            </div>
            <!-- Tree nodes will be dynamically inserted here by JavaScript -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/product-types.js"></script>
}