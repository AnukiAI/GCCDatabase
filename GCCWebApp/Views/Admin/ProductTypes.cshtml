@{
    ViewData["Title"] = "Product Types Management";
    ViewData["BodyClass"] = "admin-product-types";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/product-types.css" rel="stylesheet" />
    <link href="~/css/product-types-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span>Administration</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span>Data Management</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Product Types</span>
    </span>
}


@Html.AntiForgeryToken()

<!-- Help Modal Script - must be before button that calls it -->
<script>
    function openHelpModal() {
        var modal = document.getElementById('hierarchy-help-modal');
        if (modal) {
            modal.style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
    }

    function closeHelpModal() {
        var modal = document.getElementById('hierarchy-help-modal');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeHelpModal();
        }
    });
</script>

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage product categories, types, and subcategories</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="help-hierarchy-btn" class="admin-btn admin-btn--secondary" title="Learn how the hierarchy works" aria-label="Help: Understanding the product hierarchy" onclick="openHelpModal()">
                        <i class="fas fa-question-circle" aria-hidden="true"></i> Help
                    </button>
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export product types to CSV file">
                        <i class="fas fa-upload" aria-hidden="true"></i> Export
                    </button>
                    <button class="admin-btn admin-btn--primary" onclick="showAddForm('category')" aria-label="Add a new product category">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Category
                    </button>
                </div>
            </div>
        </div>
    </header>
    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <label for="search-input" class="admin-sr-only">Search product types</label>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search" onkeyup="filterTree(this.value)" aria-label="Search product types">
                    <i class="fas fa-search admin-search-icon"></i>
                </div>
            </div>
            <div class="admin-filter-section">
                <div class="admin-filter-group view-options">
                    <button class="view-btn active" data-view="tree" onclick="switchView('tree')" aria-label="Switch to tree view">
                        <i class="fas fa-sitemap" aria-hidden="true"></i> Tree View
                    </button>
                    <button class="view-btn" data-view="table" onclick="switchView('table')" aria-label="Switch to table view">
                        <i class="fas fa-table" aria-hidden="true"></i> Table View
                    </button>
                </div>
                <div class="admin-filter-group bulk-actions">
                    <button class="admin-btn admin-btn--secondary btn-sm" onclick="expandAll()" aria-label="Expand all items">
                        <i class="fas fa-expand-alt" aria-hidden="true"></i> Expand All
                    </button>
                    <button class="admin-btn admin-btn--secondary btn-sm" onclick="collapseAll()" aria-label="Collapse all items">
                        <i class="fas fa-compress-alt" aria-hidden="true"></i> Collapse All
                    </button>
                </div>
                <div class="stats-bar">
                    <div class="stat-item">
                        <span class="stat-number" id="category-count">0</span> Categories
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" id="type-count">0</span> Types
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" id="subcategory-count">0</span> Subcategories
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" id="product-count">0</span> Products
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-content">
            <!-- Tree View -->
            <div class="hierarchy-tree" id="treeView">
                <div class="tree-header">
                    <div class="tree-header-content">
                        <div class="tree-header-label">
                            Product Hierarchy
                        </div>
                        <div class="tree-header-columns">
                            <div class="tree-column-header products-header" title="Number of products and certificates that reference this item. An item cannot be deleted while this is non-zero.">Usage <span style="font-weight: normal; font-size: 11px; color: #6c757d;">(Products / Certs)</span></div>
                            <div class="tree-column-header actions-header">Actions</div>
                        </div>
                    </div>
                </div>
                <div class="tree-content">
                    <!-- Loading state - will be replaced by API data -->
                    <div class="loading-state" id="tree-loading">
                        <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
                        <span>Loading product types...</span>
                    </div>
                    <!-- Empty state - shown when no data -->
                    <div class="empty-state" id="tree-empty" style="display: none;">
                        <i class="fas fa-folder-open" aria-hidden="true"></i>
                        <span>No product types found. Click "Add New Category" to create one.</span>
                    </div>
                    <!-- Tree nodes will be dynamically inserted here by JavaScript -->
                </div>
            </div>
        </div>

        <div class="admin-footer-info">
            <span id="item-count">Showing 0 items</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

<!-- Help Modal: Understanding the Product Hierarchy -->
<!-- Note: Using unique class names (help-modal-*) to avoid CSS conflicts with admin framework -->
<div id="hierarchy-help-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 10000;">
    <!-- Backdrop -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); backdrop-filter: blur(3px); z-index: 10000;" onclick="closeHelpModal()"></div>

    <!-- Modal Container - using purely inline styles to avoid CSS conflicts -->
    <div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10001; max-width: 750px; width: 90%; max-height: 90vh; background-color: #ffffff; border-radius: 8px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column; opacity: 1;">
        <!-- Header -->
        <div style="padding: 16px 20px; background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; border-radius: 8px 8px 0 0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; color: #002B76; font-weight: 600; font-size: 1.25rem;">
                <i class="fas fa-sitemap" style="margin-right: 10px;"></i>Understanding the Product Hierarchy
            </h3>
            <button type="button" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #666; padding: 0; line-height: 1;" onclick="closeHelpModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <!-- Body -->
        <div style="padding: 20px; overflow-y: auto; flex: 1; background-color: #ffffff;">

            <!-- Section 1: Hierarchy Structure -->
            <div style="margin-bottom: 24px;">
                <h4 style="color: #002B76; font-size: 1rem; margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px;">
                    <span style="background: #002B76; color: white; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">1</span>
                    The 3-Level Hierarchy Structure
                </h4>
                <div style="background: linear-gradient(135deg, #f8f9fa, #e9ecef); border-radius: 8px; padding: 16px;">
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <!-- Category Level -->
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="background: #002B76; color: white; padding: 10px 16px; border-radius: 6px; font-weight: 600; min-width: 120px; text-align: center;">
                                Category
                            </div>
                            <div style="flex: 1; font-size: 14px; color: #495057;">
                                <strong>Level 1</strong> - Broadest grouping for your products
                            </div>
                        </div>
                        <div style="margin-left: 60px; color: #6c757d;"><i class="fas fa-arrow-down"></i></div>
                        <!-- Type Level -->
                        <div style="display: flex; align-items: center; gap: 12px; margin-left: 30px;">
                            <div style="background: #5a7bc0; color: white; padding: 10px 16px; border-radius: 6px; font-weight: 600; min-width: 120px; text-align: center;">
                                Type
                            </div>
                            <div style="flex: 1; font-size: 14px; color: #495057;">
                                <strong>Level 2</strong> - Product types within a category
                            </div>
                        </div>
                        <div style="margin-left: 90px; color: #6c757d;"><i class="fas fa-arrow-down"></i></div>
                        <!-- Subcategory Level -->
                        <div style="display: flex; align-items: center; gap: 12px; margin-left: 60px;">
                            <div style="background: #92C83E; color: white; padding: 10px 16px; border-radius: 6px; font-weight: 600; min-width: 120px; text-align: center;">
                                Subcategory
                            </div>
                            <div style="flex: 1; font-size: 14px; color: #495057;">
                                <strong>Level 3</strong> - Most specific classification for product assignment
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Product Assignment -->
            <div style="margin-bottom: 24px;">
                <h4 style="color: #002B76; font-size: 1rem; margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px;">
                    <span style="background: #002B76; color: white; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">2</span>
                    How Products Are Assigned
                </h4>
                <div style="background: #e8f4fd; border-radius: 8px; padding: 16px; border-left: 4px solid #00AEEF;">
                    <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px;">
                        <i class="fas fa-box" style="color: #00AEEF; margin-top: 3px;"></i>
                        <div>
                            <strong style="color: #002B76;">Products are assigned at the Subcategory level</strong>
                            <p style="margin: 4px 0 0 0; font-size: 14px; color: #495057;">
                                When you assign a product to a subcategory, it automatically "rolls up" to the parent Type and Category.
                            </p>
                        </div>
                    </div>
                    <div style="background: white; border-radius: 6px; padding: 12px; margin-top: 12px;">
                        <div style="font-size: 13px; color: #495057;">
                            <strong>Example:</strong> A product assigned to a subcategory will roll up through the hierarchy:
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 13px; flex-wrap: wrap;">
                            <span style="background: #92C83E; color: white; padding: 4px 8px; border-radius: 4px;">Subcategory</span>
                            <i class="fas fa-arrow-right" style="color: #6c757d;"></i>
                            <span style="color: #6c757d;">rolls up to</span>
                            <span style="background: #5a7bc0; color: white; padding: 4px 8px; border-radius: 4px;">Type</span>
                            <i class="fas fa-arrow-right" style="color: #6c757d;"></i>
                            <span style="background: #002B76; color: white; padding: 4px 8px; border-radius: 4px;">Category</span>
                        </div>
                    </div>
                    <div style="margin-top: 12px; font-size: 13px; color: #495057;">
                        <i class="fas fa-calculator" style="color: #00AEEF; margin-right: 6px;"></i>
                        The <strong>Usage</strong> column shows <strong>products / certificates</strong> at each level, including those rolled up from children. An item cannot be deleted while either count is greater than zero.
                    </div>
                </div>
            </div>

            <!-- Section 3: Impact of Changes -->
            <div style="margin-bottom: 12px;">
                <h4 style="color: #002B76; font-size: 1rem; margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px;">
                    <span style="background: #002B76; color: white; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">3</span>
                    Impact of Changes (Cascade Behavior)
                </h4>
                <div style="display: grid; gap: 12px;">
                    <!-- Edit Impact -->
                    <div style="background: #fff3cd; border-radius: 8px; padding: 14px; border-left: 4px solid #ffc107;">
                        <div style="display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fas fa-edit" style="color: #856404; margin-top: 2px;"></i>
                            <div>
                                <strong style="color: #856404;">Editing a Parent</strong>
                                <p style="margin: 4px 0 0 0; font-size: 14px; color: #664d03;">
                                    Renaming a Category or Type updates its name everywhere, but <strong>does not affect</strong> the children or product assignments.
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- Delete Impact -->
                    <div style="background: #f8d7da; border-radius: 8px; padding: 14px; border-left: 4px solid #dc3545;">
                        <div style="display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fas fa-trash" style="color: #842029; margin-top: 2px;"></i>
                            <div>
                                <strong style="color: #842029;">Deleting a Parent (Cascade Delete)</strong>
                                <p style="margin: 4px 0 0 0; font-size: 14px; color: #58151c;">
                                    <i class="fas fa-exclamation-triangle" style="margin-right: 4px;"></i>
                                    Deleting a Category will <strong>delete all its Types and Subcategories</strong>.
                                    Deleting a Type will <strong>delete all its Subcategories</strong>.
                                </p>
                                <p style="margin: 8px 0 0 0; font-size: 13px; color: #58151c;">
                                    <strong>Note:</strong> Items with assigned products cannot be deleted until products are reassigned or removed.
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- Move/Reassign -->
                    <div style="background: #d1e7dd; border-radius: 8px; padding: 14px; border-left: 4px solid #198754;">
                        <div style="display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fas fa-arrows-alt" style="color: #0f5132; margin-top: 2px;"></i>
                            <div>
                                <strong style="color: #0f5132;">Moving Items</strong>
                                <p style="margin: 4px 0 0 0; font-size: 14px; color: #0a3622;">
                                    You can move a Type to a different Category, or a Subcategory to a different Type by editing and changing the parent.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- Footer -->
        <div style="padding: 16px 20px; background-color: #f8f9fa; border-top: 2px solid #e9ecef; border-radius: 0 0 8px 8px; display: flex; justify-content: flex-end;">
            <button type="button" style="padding: 10px 24px; background: #002B76; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer; font-size: 16px;" onclick="closeHelpModal()">
                Got it!
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/exportUtils.js" asp-append-version="true"></script>
    <script src="~/js/product-types.js" asp-append-version="true"></script>
}