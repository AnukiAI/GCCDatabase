@{
    ViewData["Title"] = "Role Management";
    ViewData["BodyClass"] = "admin-role-management";
}

@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/pages/role-management.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Role Management</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage user roles and permissions</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export roles to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-role-btn" class="admin-btn admin-btn--primary" aria-label="Add a new role">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Role
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <label for="search-input" class="admin-sr-only">Search roles</label>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search" aria-label="Search roles">
                    <i class="fas fa-search admin-search-icon"></i>
                </div>
            </div>
        </div>

        <div class="admin-content">
        <div class="admin-table-container">
            <table id="role-table" class="admin-table" role="table" aria-label="Role management table">
                <thead class="admin-table-header">
                    <tr role="row">
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="20%" role="columnheader" aria-sort="none" tabindex="0">
                            Role Name <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="description" width="30%" role="columnheader" aria-sort="none" tabindex="0">
                            Description <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th" width="35%" role="columnheader">Permissions</th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="users" width="10%" role="columnheader" aria-sort="none" tabindex="0">
                            Users <span class="sort-icon">▼</span>
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="5%" role="columnheader">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body" role="rowgroup">
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

        <div class="admin-footer-info">
            <span id="role-count" class="admin-count-display">Showing 0 roles</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

<!-- Add/Edit Role Modal - Wide layout with categorized permissions -->
<div id="role-modal" class="admin-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
    <!-- Backdrop -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container - 800px wide for 3-column permission grid -->
    <div class="admin-modal-container" style="position: relative; z-index: 9999; max-width: 800px; background-color: white; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); border-radius: 12px;">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; border-radius: 12px 12px 0 0;">
            <h3 class="admin-modal-title" id="modal-title" style="color: #002B76; font-weight: 600;">Add New Role</h3>
            <button class="admin-modal-close" aria-label="Close modal">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="admin-modal-body" style="background-color: white;">
            <form id="role-form" class="admin-form" data-validate>
                <input type="hidden" id="role-id">

                <!-- Role Name and Description side-by-side -->
                <div class="admin-form-row">
                    <div class="admin-form-group" style="margin-bottom: 0;">
                        <label for="role-name" class="admin-label admin-label--required">Role Name</label>
                        <input type="text" id="role-name" class="admin-input" required aria-required="true" placeholder="e.g., Partner Manager">
                    </div>
                    <div class="admin-form-group" style="margin-bottom: 0;">
                        <label for="role-description" class="admin-label">Description</label>
                        <input type="text" id="role-description" class="admin-input" placeholder="Brief description of role">
                    </div>
                </div>

                <!-- Permissions Section -->
                <div class="admin-form-group">
                    <div class="admin-permissions-section">
                        <div class="admin-permissions-header">
                            <span class="admin-permissions-title">Permissions</span>
                            <div class="admin-permissions-actions">
                                <button type="button" onclick="roleManager.selectAllPermissions()">Select All</button>
                                <button type="button" onclick="roleManager.clearAllPermissions()">Clear All</button>
                            </div>
                        </div>
                        <div id="permissions-container" class="admin-permissions-grid">
                            <!-- Permissions will be populated by JavaScript -->
                        </div>

                        <!-- System Role Warning -->
                        <div id="system-role-warning" class="admin-alert admin-alert--warning" style="display: none;">
                            <i class="fas fa-exclamation-triangle"></i>
                            This is a system role. The role name cannot be changed, but you can modify the description and permissions.
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef; border-radius: 0 0 12px 12px;">
            <button type="button" class="admin-btn admin-btn--secondary" id="cancel-btn" aria-label="Cancel and close modal">Cancel</button>
            <button type="submit" class="admin-btn admin-btn--primary" id="save-btn" form="role-form" aria-label="Save role changes"><i class="fas fa-save"></i> Save Role</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/roleManagement.js"></script>
    <script>
        // Enhanced role management with admin framework
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize role management
            if (typeof initializeRoleManagement === 'function') {
                initializeRoleManagement();
            }

            // Enhanced modal handling with admin framework
            const addRoleBtn = document.getElementById('add-role-btn');
            const cancelBtn = document.getElementById('cancel-btn');
            const roleForm = document.getElementById('role-form');

            if (addRoleBtn) {
                addRoleBtn.addEventListener('click', function() {
                    document.getElementById('modal-title').textContent = 'Add New Role';
                    document.getElementById('system-role-warning').style.display = 'none';
                    roleForm.reset();
                    AdminCore.openModal('role-modal');
                });
            }

            if (cancelBtn) {
                cancelBtn.addEventListener('click', function() {
                    AdminCore.closeModal('role-modal');
                });
            }

            // Enhanced form submission with validation
            if (roleForm) {
                roleForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    // Use roleManager's saveRole method if available
                    if (window.roleManager && typeof window.roleManager.saveRole === 'function') {
                        window.roleManager.saveRole(e);
                    }
                });
            }

            // Enhanced search functionality
            const searchInput = document.getElementById('search-input');
            if (searchInput) {
                // Debounced search
                const debouncedSearch = AdminCore.debounce(function(value) {
                    AdminCore.announceToScreenReader(`Searching for: ${value}`);
                    // Implement search logic
                    if (typeof handleRoleSearch === 'function') {
                        handleRoleSearch(value);
                    }
                }, 300);

                searchInput.addEventListener('input', function() {
                    debouncedSearch(this.value);
                });
            }

            // Keyboard Navigation for Table Rows
            const setupKeyboardNavigation = function() {
                const tbody = document.querySelector('.admin-table-body');
                if (!tbody) return;

                tbody.addEventListener('keydown', function(e) {
                    const currentRow = e.target.closest('tr[role="row"]');
                    if (!currentRow) return;

                    const allRows = Array.from(tbody.querySelectorAll('tr[role="row"]'));
                    const currentIndex = allRows.indexOf(currentRow);

                    switch(e.key) {
                        case 'ArrowDown':
                            e.preventDefault();
                            if (currentIndex < allRows.length - 1) {
                                allRows[currentIndex + 1].focus();
                            }
                            break;
                        case 'ArrowUp':
                            e.preventDefault();
                            if (currentIndex > 0) {
                                allRows[currentIndex - 1].focus();
                            }
                            break;
                        case 'Enter':
                        case ' ':
                            e.preventDefault();
                            const editBtn = currentRow.querySelector('.admin-action-btn--edit');
                            if (editBtn) {
                                editBtn.click();
                            }
                            break;
                        case 'Delete':
                            e.preventDefault();
                            const deleteBtn = currentRow.querySelector('.admin-action-btn--delete');
                            if (deleteBtn && !deleteBtn.disabled) {
                                deleteBtn.click();
                            }
                            break;
                        case 'Escape':
                            e.preventDefault();
                            currentRow.blur();
                            break;
                    }
                });
            };

            // Initialize keyboard navigation
            setupKeyboardNavigation();

            // Re-initialize keyboard navigation when table updates
            const observer = new MutationObserver(function(mutations) {
                setupKeyboardNavigation();
            });

            const tableBody = document.querySelector('.admin-table-body');
            if (tableBody) {
                observer.observe(tableBody, { childList: true });
            }

            // Table action handling with admin framework
            document.addEventListener('click', function(e) {
                if (e.target.matches('.admin-action-btn--edit') || e.target.closest('.admin-action-btn--edit')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const roleId = row.dataset.id;
                        editRole(roleId);
                    }
                }

                if (e.target.matches('.admin-action-btn--delete') || e.target.closest('.admin-action-btn--delete')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const roleId = row.dataset.id;
                        const roleName = row.querySelector('.role-name')?.textContent || 'this role';
                        const isSystemRole = row.dataset.system === 'true';

                        if (isSystemRole) {
                            AdminCore.showNotification('System roles cannot be deleted', 'warning');
                            return;
                        }

                        AdminCore.showConfirmation({
                            title: 'Delete Confirmation',
                            message: `Are you sure you want to delete the role <strong>${roleName}</strong>? This action cannot be undone.`,
                            confirmText: 'Delete',
                            cancelText: 'Cancel',
                            type: 'danger',
                            allowHtml: true
                        }).then(confirmed => {
                            if (confirmed) {
                                deleteRole(roleId);
                            }
                        });
                    }
                }
            });

            // Role management functions - connected to database via API
            window.editRole = function(roleId) {
                document.getElementById('modal-title').textContent = 'Edit Role';

                // Check if system role
                const row = document.querySelector(`[data-id="${roleId}"]`);
                const isSystemRole = row?.dataset.system === 'true';
                document.getElementById('system-role-warning').style.display = isSystemRole ? 'block' : 'none';

                // Load role data into form
                AdminCore.openModal('role-modal');
            };

            window.deleteRole = async function(roleId) {
                // Confirm deletion first
                const confirmed = await AdminCore.showConfirmation({
                    title: 'Delete Role',
                    message: 'Are you sure you want to delete this role? This action cannot be undone.',
                    confirmText: 'Delete',
                    type: 'danger'
                });

                if (!confirmed) return;

                AdminCore.showLoading(`#role-row-${roleId}`);

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch(`/Admin/DeleteRole/${roleId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        }
                    });

                    const result = await response.json();
                    AdminCore.hideLoading(`#role-row-${roleId}`);

                    if (result.success) {
                        AdminCore.showNotification('Role deleted successfully!', 'success');
                        // Remove the row from the table
                        const row = document.querySelector(`[data-id="${roleId}"]`);
                        if (row) row.remove();
                    } else {
                        AdminCore.showNotification(result.message || 'Failed to delete role', 'error');
                    }
                } catch (error) {
                    console.error('Error deleting role:', error);
                    AdminCore.hideLoading(`#role-row-${roleId}`);
                    AdminCore.showNotification('Error deleting role. Please try again.', 'error');
                }
            };

        });
    </script>
}