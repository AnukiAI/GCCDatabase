@{
    ViewData["Title"] = "Role Management";
    ViewData["BodyClass"] = "admin-role-management";
}

@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <style>
        /* Enhanced Modal Styling */
        .admin-modal {
            z-index: 10000;
        }

        .admin-modal-overlay {
            background: rgba(0, 43, 118, 0.6);
            backdrop-filter: blur(4px);
        }

        .admin-modal-container {
            max-width: 650px;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 0 1px rgba(0, 0, 0, 0.2);
            animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @@keyframes modalSlideIn {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .admin-modal-header {
            background: linear-gradient(135deg, #002B76 0%, #003d9e 100%);
            color: white;
            padding: 24px 28px;
            border-radius: 12px 12px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-modal-title {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.3px;
        }

        .admin-modal-close {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: white;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .admin-modal-close:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: rotate(90deg);
        }

        .admin-modal-body {
            padding: 32px 28px;
            background: white;
            max-height: calc(90vh - 220px);
            overflow-y: auto;
        }

        .admin-modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .admin-modal-body::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .admin-modal-body::-webkit-scrollbar-thumb {
            background: #92C83E;
            border-radius: 4px;
        }

        .admin-modal-body::-webkit-scrollbar-thumb:hover {
            background: #7ab02d;
        }

        .admin-form-group {
            margin-bottom: 24px;
        }

        .admin-label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .admin-label--required::after {
            content: " *";
            color: #e74c3c;
        }

        .admin-input,
        .admin-textarea {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.2s;
            font-family: inherit;
        }

        .admin-input:focus,
        .admin-textarea:focus {
            outline: none;
            border-color: #92C83E;
            box-shadow: 0 0 0 3px rgba(146, 200, 62, 0.1);
        }

        .admin-textarea {
            resize: vertical;
            min-height: 80px;
        }

        .admin-permissions-container {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            max-height: 300px;
            overflow-y: auto;
        }

        .admin-permissions-container::-webkit-scrollbar {
            width: 8px;
        }

        .admin-permissions-container::-webkit-scrollbar-track {
            background: #e9ecef;
            border-radius: 4px;
        }

        .admin-permissions-container::-webkit-scrollbar-thumb {
            background: #92C83E;
            border-radius: 4px;
        }

        .admin-permission-group {
            margin-bottom: 20px;
        }

        .admin-permission-group:last-child {
            margin-bottom: 0;
        }

        .admin-permission-category {
            font-size: 15px;
            font-weight: 700;
            color: #002B76;
            margin: 0 0 12px 0;
            padding-bottom: 8px;
            border-bottom: 2px solid #92C83E;
        }

        .admin-checkbox-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 12px;
        }

        .admin-checkbox-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px;
            background: white;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .admin-checkbox-item:hover {
            background: #e8f5d8;
            transform: translateX(4px);
        }

        .admin-checkbox-item input[type="checkbox"] {
            margin-top: 3px;
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #92C83E;
        }

        .admin-checkbox-item span {
            flex: 1;
            font-size: 14px;
            font-weight: 500;
            color: #2c3e50;
        }

        .admin-checkbox-item small {
            display: block;
            font-size: 12px;
            color: #7f8c8d;
            margin-top: 4px;
        }

        .admin-alert {
            padding: 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-alert--warning {
            background: #fff3cd;
            border: 2px solid #ffc107;
            color: #856404;
        }

        .admin-alert--warning i {
            color: #ffc107;
            font-size: 20px;
        }

        .admin-modal-footer {
            padding: 20px 28px;
            background: #f8f9fa;
            border-radius: 0 0 12px 12px;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .admin-btn {
            padding: 12px 28px;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .admin-btn--secondary {
            background: white;
            color: #6c757d;
            border: 2px solid #dee2e6;
        }

        .admin-btn--secondary:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
            transform: translateY(-1px);
        }

        .admin-btn--primary {
            background: linear-gradient(135deg, #92C83E 0%, #7ab02d 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(146, 200, 62, 0.3);
        }

        .admin-btn--primary:hover {
            background: linear-gradient(135deg, #7ab02d 0%, #6a9e26 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(146, 200, 62, 0.4);
        }

        .admin-btn--primary:active {
            transform: translateY(0);
        }
    </style>
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Role Management</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Manage user roles and permissions</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export roles to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-role-btn" class="admin-btn admin-btn--primary" aria-label="Add a new role">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Role
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <label for="search-input" class="admin-sr-only">Search roles</label>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search roles..." aria-label="Search roles">
                <i class="fas fa-search admin-search-icon"></i>
            </div>
        </div>
    </div>

    <div class="admin-content">
        <div class="admin-table-container">
            <table id="role-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="20%">
                            Role Name <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="description" width="30%">
                            Description <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th" width="35%">Permissions</th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="users" width="10%">
                            Users <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="5%">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-footer-info">
        <span id="role-count" class="admin-count-display">Showing 0 roles</span>
    </div>
</div>

<!-- Add/Edit Role Modal -->
<div id="role-modal" class="admin-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
    <div class="admin-modal-overlay"></div>
    <div class="admin-modal-container">
        <div class="admin-modal-header">
            <h3 class="admin-modal-title" id="modal-title">Add New Role</h3>
            <button class="admin-modal-close" aria-label="Close modal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="admin-modal-body">
            <form id="role-form" class="admin-form" data-validate>
                <input type="hidden" id="role-id">

                <div class="admin-form-group">
                    <label for="role-name" class="admin-label admin-label--required">Role Name</label>
                    <input type="text" id="role-name" class="admin-input" required aria-required="true">
                </div>

                <div class="admin-form-group">
                    <label for="role-description" class="admin-label">Description</label>
                    <textarea id="role-description" class="admin-textarea" rows="3" placeholder="Describe the role's purpose and responsibilities"></textarea>
                </div>

                <div class="admin-form-group">
                    <label class="admin-label">Permissions</label>
                    <div id="permissions-container" class="admin-permissions-container">
                        <!-- Permissions will be populated by JavaScript -->
                    </div>
                </div>

                <div class="admin-form-group" id="system-role-warning" style="display: none;">
                    <div class="admin-alert admin-alert--warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        This is a system role. Changes to permissions may affect core functionality.
                    </div>
                </div>
            </form>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="admin-btn admin-btn--secondary" id="cancel-btn">Cancel</button>
            <button type="submit" class="admin-btn admin-btn--primary" id="save-btn" form="role-form">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/roleManagement.js"></script>
    <script>
        // Enhanced role management with admin framework
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize role management
            if (typeof initializeRoleManagement === 'function') {
                initializeRoleManagement();
            }

            // Enhanced modal handling with admin framework
            const addRoleBtn = document.getElementById('add-role-btn');
            const cancelBtn = document.getElementById('cancel-btn');
            const roleForm = document.getElementById('role-form');

            if (addRoleBtn) {
                addRoleBtn.addEventListener('click', function() {
                    document.getElementById('modal-title').textContent = 'Add New Role';
                    document.getElementById('system-role-warning').style.display = 'none';
                    roleForm.reset();
                    AdminCore.openModal('role-modal');
                });
            }

            if (cancelBtn) {
                cancelBtn.addEventListener('click', function() {
                    AdminCore.closeModal('role-modal');
                });
            }

            // Enhanced form submission with validation
            if (roleForm) {
                roleForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    // Use roleManager's saveRole method if available
                    if (window.roleManager && typeof window.roleManager.saveRole === 'function') {
                        window.roleManager.saveRole(e);
                    }
                });
            }

            // Enhanced search functionality
            const searchInput = document.getElementById('search-input');
            if (searchInput) {
                // Debounced search
                const debouncedSearch = AdminCore.debounce(function(value) {
                    AdminCore.announceToScreenReader(`Searching for: ${value}`);
                    // Implement search logic
                    if (typeof handleRoleSearch === 'function') {
                        handleRoleSearch(value);
                    }
                }, 300);

                searchInput.addEventListener('input', function() {
                    debouncedSearch(this.value);
                });
            }

            // Table action handling with admin framework
            document.addEventListener('click', function(e) {
                if (e.target.matches('.admin-action-btn--edit') || e.target.closest('.admin-action-btn--edit')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const roleId = row.dataset.id;
                        editRole(roleId);
                    }
                }

                if (e.target.matches('.admin-action-btn--delete') || e.target.closest('.admin-action-btn--delete')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const roleId = row.dataset.id;
                        const roleName = row.querySelector('.role-name')?.textContent || 'this role';
                        const isSystemRole = row.dataset.system === 'true';

                        if (isSystemRole) {
                            AdminCore.showNotification('System roles cannot be deleted', 'warning');
                            return;
                        }

                        if (confirm(`Are you sure you want to delete the role "${roleName}"? This action cannot be undone.`)) {
                            deleteRole(roleId);
                        }
                    }
                }
            });

            // Sample functions for demonstration (replace with actual implementations)
            window.editRole = function(roleId) {
                document.getElementById('modal-title').textContent = 'Edit Role';

                // Check if system role
                const row = document.querySelector(`[data-id="${roleId}"]`);
                const isSystemRole = row?.dataset.system === 'true';
                document.getElementById('system-role-warning').style.display = isSystemRole ? 'block' : 'none';

                // Load role data into form
                AdminCore.openModal('role-modal');
            };

            window.deleteRole = function(roleId) {
                AdminCore.showLoading(`#role-row-${roleId}`);

                // Simulate deletion
                setTimeout(() => {
                    AdminCore.showNotification('Role deleted successfully!', 'success');
                    // Remove row or refresh list
                }, 1000);
            };

            // Show initial success message
            setTimeout(() => {
                AdminCore.showNotification('Role management loaded successfully!', 'success', { duration: 3000 });
            }, 500);
        });
    </script>
}