@{
    ViewData["Title"] = "Tag Management";
    ViewData["BodyClass"] = "admin-tags";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Tags</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Organize content with tags and categories</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="template-btn" class="admin-btn admin-btn--secondary" title="Download CSV template for bulk import">
                        <i class="fas fa-file-download"></i> Template
                    </button>
                    <button id="import-btn" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-upload"></i> Import
                    </button>
                    <button id="export-btn" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-download"></i> Export
                    </button>
                    <button id="add-tag-btn" class="admin-btn admin-btn--primary">
                        <i class="fas fa-plus"></i> Add New Tag
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <label for="search-input" class="admin-sr-only">Search tags</label>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search tags..." aria-label="Search tags">
                <i class="fas fa-search admin-search-icon"></i>
            </div>
        </div>
        <div class="admin-filter-section">
            <div class="admin-filter-group">
                <label for="type-filter" class="admin-sr-only">Filter by tag type</label>
                <select id="type-filter" class="admin-filter-select" aria-label="Filter by tag type">
                    <option value="all">All Types</option>
                    <option value="external">External</option>
                    <option value="internal">Internal</option>
                </select>
            </div>
        </div>
    </div>

    <div class="admin-content">
        <div class="admin-table-container">
            <table id="tag-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="25%">
                            Tag Name <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="type" width="20%">
                            Tag Type <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="description" width="45%">
                            Description <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="10%">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-footer-info">
        <span id="tag-count" class="admin-count-display">Showing 0 of 0 tags</span>
    </div>
</div>

<!-- Add/Edit Tag Modal -->
<div id="tag-modal" class="admin-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
    <div class="admin-modal-overlay"></div>
    <div class="admin-modal-container">
        <div class="admin-modal-header">
            <h3 class="admin-modal-title" id="modal-title">Add New Tag</h3>
            <button class="admin-modal-close" aria-label="Close modal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="admin-modal-body">
            <form id="tag-form" class="admin-form" data-validate>
                <input type="hidden" id="tag-id">

                <div class="admin-form-group">
                    <label for="tag-name" class="admin-label admin-label--required">Tag Name</label>
                    <input type="text" id="tag-name" class="admin-input" required aria-describedby="tag-name-help">
                    <span id="tag-name-help" class="admin-form-help">Enter a unique, descriptive name for this tag</span>
                </div>

                <div class="admin-form-group">
                    <label for="tag-type" class="admin-label admin-label--required">Tag Type</label>
                    <select id="tag-type" class="admin-select" required aria-describedby="tag-type-help">
                        <option value="">Select a type</option>
                        <option value="external">External</option>
                        <option value="internal">Internal</option>
                    </select>
                    <span id="tag-type-help" class="admin-form-help">External tags are visible to customers, internal tags are for organizational use only</span>
                </div>

                <div class="admin-form-group">
                    <label for="tag-description" class="admin-label">Description</label>
                    <textarea id="tag-description" class="admin-textarea" rows="3" placeholder="Optional description..." aria-describedby="tag-description-help"></textarea>
                    <span id="tag-description-help" class="admin-form-help">Provide additional context about when and how to use this tag</span>
                </div>
            </form>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="admin-btn admin-btn--secondary" id="cancel-btn">Cancel</button>
            <button type="submit" class="admin-btn admin-btn--primary" id="save-btn" form="tag-form">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/admin/exportUtils.js"></script>
    <script src="~/js/tags.js"></script>
    <script>
        // Enhanced tag management with admin framework
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tag management
            if (typeof initializeTagManagement === 'function') {
                initializeTagManagement();
            }

            // Enhanced modal handling with admin framework
            const addTagBtn = document.getElementById('add-tag-btn');
            const cancelBtn = document.getElementById('cancel-btn');
            const tagForm = document.getElementById('tag-form');

            if (addTagBtn) {
                addTagBtn.addEventListener('click', function() {
                    document.getElementById('modal-title').textContent = 'Add New Tag';
                    tagForm.reset();
                    AdminCore.openModal('tag-modal');
                });
            }

            if (cancelBtn) {
                cancelBtn.addEventListener('click', function() {
                    AdminCore.closeModal('tag-modal');
                });
            }

            // Enhanced form submission with validation
            if (tagForm) {
                tagForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = AdminCore.serializeForm(tagForm);
                    const errors = AdminCore.validateForm(tagForm);

                    if (errors.length > 0) {
                        AdminCore.showNotification(errors.join('<br>'), 'error');
                        return;
                    }

                    // Show loading state
                    const saveBtn = document.getElementById('save-btn');
                    AdminCore.showLoading(saveBtn);

                    // Simulate API call (replace with actual implementation)
                    setTimeout(() => {
                        AdminCore.hideLoading(saveBtn);
                        AdminCore.closeModal('tag-modal');
                        AdminCore.showNotification('Tag saved successfully!', 'success');

                        // Refresh tag list (implement actual refresh logic)
                        if (typeof refreshTagList === 'function') {
                            refreshTagList();
                        }
                    }, 1500);
                });
            }

            // Enhanced search functionality
            const searchInput = document.getElementById('search-input');
            if (searchInput) {
                // Debounced search
                const debouncedSearch = AdminCore.debounce(function(value) {
                    AdminCore.announceToScreenReader(`Searching for: ${value}`);
                    // Implement search logic
                    if (typeof handleTagSearch === 'function') {
                        handleTagSearch(value);
                    }
                }, 300);

                searchInput.addEventListener('input', function() {
                    debouncedSearch(this.value);
                });
            }

            // Enhanced filter handling
            const typeFilter = document.getElementById('type-filter');
            if (typeFilter) {
                typeFilter.addEventListener('change', function() {
                    AdminCore.announceToScreenReader(`Filter changed to: ${this.value}`);
                    // Implement filter logic
                    if (typeof handleTagFilter === 'function') {
                        handleTagFilter(this.value);
                    }
                });
            }

            // Table action handling with admin framework
            document.addEventListener('click', function(e) {
                if (e.target.matches('.admin-action-btn--edit') || e.target.closest('.admin-action-btn--edit')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const tagId = row.dataset.id;
                        editTag(tagId);
                    }
                }

                if (e.target.matches('.admin-action-btn--delete') || e.target.closest('.admin-action-btn--delete')) {
                    const row = e.target.closest('.admin-table-row');
                    if (row) {
                        const tagId = row.dataset.id;
                        const tagName = row.querySelector('.tag-name')?.textContent || 'this tag';

                        if (confirm(`Are you sure you want to delete the tag "${tagName}"?`)) {
                            deleteTag(tagId);
                        }
                    }
                }
            });

            // Sample functions for demonstration (replace with actual implementations)
            window.editTag = function(tagId) {
                document.getElementById('modal-title').textContent = 'Edit Tag';
                // Load tag data into form
                AdminCore.openModal('tag-modal');
            };

            window.deleteTag = function(tagId) {
                AdminCore.showLoading(`#tag-row-${tagId}`);

                // Simulate deletion
                setTimeout(() => {
                    AdminCore.showNotification('Tag deleted successfully!', 'success');
                    // Remove row or refresh list
                }, 1000);
            };

            // Enhanced export functionality with admin framework
            const exportBtn = document.getElementById('export-btn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function() {
                    AdminCore.showLoading(exportBtn);

                    // Sample data structure for Tags
                    const sampleData = [
                        { id: 1, name: 'Sustainable', type: 'external', description: 'Products with sustainability features' },
                        { id: 2, name: 'Energy Efficient', type: 'external', description: 'Energy saving products' },
                        { id: 3, name: 'Indoor Air Quality', type: 'internal', description: 'Products that improve indoor air quality' },
                        { id: 4, name: 'Low VOC', type: 'external', description: 'Low volatile organic compound emissions' },
                        { id: 5, name: 'Recycled Materials', type: 'external', description: 'Made from recycled content' },
                        { id: 6, name: 'Priority Product', type: 'internal', description: 'High priority for marketing' },
                        { id: 7, name: 'Eco-Friendly', type: 'external', description: 'Environmentally friendly products' }
                    ];

                    const columns = [
                        { key: 'id', header: 'ID' },
                        { key: 'name', header: 'Tag Name' },
                        { key: 'type', header: 'Tag Type' },
                        { key: 'description', header: 'Description' }
                    ];

                    setTimeout(() => {
                        AdminCore.hideLoading(exportBtn);
                        ExportUtils.showExportModal(
                            sampleData,
                            columns,
                            'tags',
                            (message, type) => AdminCore.showNotification(message, type)
                        );
                    }, 1000);
                });
            }

            // Show initial success message
            setTimeout(() => {
                AdminCore.showNotification('Tag management loaded successfully!', 'success', { duration: 3000 });
            }, 500);
        });
    </script>
}