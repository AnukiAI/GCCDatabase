@{
    ViewData["Title"] = "User Management";
    ViewData["BodyClass"] = "admin-user-management";
}

@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">User Management</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Manage user accounts, roles, and permissions</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="template-btn" class="admin-btn admin-btn--secondary" aria-label="Download CSV template for bulk user import">
                        <i class="fas fa-file-download" aria-hidden="true"></i> Template
                    </button>
                    <button id="import-btn" class="admin-btn admin-btn--secondary" aria-label="Import users from CSV file">
                        <i class="fas fa-upload" aria-hidden="true"></i> Import
                    </button>
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export users to CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-user-btn" class="admin-btn admin-btn--primary" aria-label="Add a new user account">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New User
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-toolbar">
        <div class="admin-search-section">
            <div class="admin-search-box">
                <label for="search-input" class="admin-sr-only">Search users</label>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search users..." aria-label="Search users">
                <i class="fas fa-search admin-search-icon"></i>
            </div>
        </div>
        <div class="admin-filter-section">
            <div class="admin-filter-group">
                <label for="status-filter" class="admin-sr-only">Filter by status</label>
                <select id="status-filter" class="admin-filter-select" aria-label="Filter by status">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
                <label for="role-filter" class="admin-sr-only">Filter by role</label>
                <select id="role-filter" class="admin-filter-select" aria-label="Filter by role">
                    <option value="all">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="Analyst">Analyst</option>
                    <option value="External">External</option>
                    <option value="Public">Public</option>
                </select>
                <label for="company-filter" class="admin-sr-only">Filter by company</label>
                <select id="company-filter" class="admin-filter-select" aria-label="Filter by company">
                    <option value="all">All Companies</option>
                    <option value="acme-corp">ACME Corp</option>
                    <option value="tech-solutions">Tech Solutions</option>
                    <option value="global-industries">Global Industries</option>
                </select>
            </div>
        </div>
    </div>

    <div class="admin-content">
        <!-- Screen reader announcements for table updates -->
        <div class="sr-only" aria-live="polite" aria-atomic="true" id="tableAnnouncement"></div>

        <div class="admin-table-container">
            <table id="user-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="name" width="18%">
                            Name <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="company" width="20%">
                            Company <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="email" width="22%">
                            Email <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="role" width="12%">
                            Role <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable" data-sort="status" width="10%">
                            Status <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--sortable admin-table-th--hidden-mobile" data-sort="lastLogin" width="12%">
                            Last Login <i class="admin-sort-icon fas fa-sort"></i>
                        </th>
                        <th class="admin-table-th admin-table-th--actions" width="8%">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-footer-info">
        <span id="user-count" class="admin-count-display" aria-live="polite" aria-atomic="true">Showing 0 of 0 users</span>
    </div>
</div>

<!-- Add/Edit User Modal -->
<div id="user-modal" class="admin-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
    <!-- Backdrop (sibling) -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container (sibling) -->
    <div class="admin-modal-container" style="position: relative; z-index: 9999; max-width: 650px; background-color: white; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef;">
            <h3 class="admin-modal-title" id="modal-title" style="color: #002B76; font-weight: 600;">Add New User</h3>
            <button class="admin-modal-close" aria-label="Close modal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="admin-modal-body" style="background-color: white;">
            <form id="user-form" class="admin-form" data-validate>
                <input type="hidden" id="user-id">

                <div class="admin-form-group">
                    <label for="user-name" class="admin-label admin-label--required" style="color: #333; font-weight: 500;">Name</label>
                    <input type="text" id="user-name" class="admin-input" required aria-required="true" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                </div>

                <div class="admin-form-group">
                    <label class="admin-label" style="color: #333; font-weight: 500;">Companies</label>
                    <div id="user-companies-container" class="admin-checkbox-list" aria-describedby="company-help">
                        <!-- Company checkboxes will be populated by JavaScript -->
                    </div>
                    <span class="admin-form-help" id="company-help" style="color: #6c757d;">Select all companies this user should have access to</span>
                </div>

                <div class="admin-form-group">
                    <label for="user-email" class="admin-label admin-label--required" style="color: #333; font-weight: 500;">Email</label>
                    <input type="email" id="user-email" class="admin-input" required aria-required="true" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                </div>

                <div class="admin-form-group">
                    <label for="user-role" class="admin-label admin-label--required" style="color: #333; font-weight: 500;">Role</label>
                    <select id="user-role" class="admin-select" required aria-required="true" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                        <option value="">Select a role</option>
                        <option value="Admin">Admin</option>
                        <option value="Analyst">Analyst</option>
                        <option value="External">External</option>
                        <option value="Public">Public</option>
                    </select>
                </div>

                <div class="admin-form-group">
                    <label for="user-status" class="admin-label admin-label--required" style="color: #333; font-weight: 500;">Status</label>
                    <select id="user-status" class="admin-select" required aria-required="true" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                <div class="admin-form-group" id="password-group">
                    <label for="user-password" class="admin-label" style="color: #333; font-weight: 500;">Password</label>
                    <input type="password" id="user-password" class="admin-input" aria-describedby="password-help" style="border: 1px solid #ced4da; background-color: white; color: #333;">
                    <span class="admin-form-help" id="password-help" style="color: #6c757d;">Leave blank to keep current password</span>
                </div>

                <div class="admin-form-group">
                    <label for="require-password-reset" class="admin-checkbox-label">
                        <input type="checkbox" id="require-password-reset" class="admin-checkbox">
                        <span class="admin-checkbox-text">Require password reset on next login</span>
                    </label>
                </div>
            </form>
        </div>
        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef;">
            <button type="button" class="admin-btn admin-btn--secondary" id="cancel-btn">Cancel</button>
            <button type="submit" class="admin-btn admin-btn--primary" id="save-btn" form="user-form">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/userManagement.js"></script>
    <script>
        // User management initialization - connects to UserManagement class
        document.addEventListener('DOMContentLoaded', function() {
            console.log('User Management page loaded');

            // userManagement instance is created automatically by userManagement.js
            // No additional initialization needed - the class handles everything
        });
    </script>
}