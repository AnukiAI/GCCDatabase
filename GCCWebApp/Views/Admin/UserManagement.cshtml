@{
    ViewData["Title"] = "User Management";
    ViewData["BodyClass"] = "admin-user-management";
}

@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()

@section Styles {
    <style>
        /* Admin Container */
        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: var(--space-lg);
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-lg);
            flex-wrap: wrap;
            gap: 20px;
            padding: 0;
        }

        .buttons-area {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: flex-start;
            flex-shrink: 0;
        }

        /* Search and Filter Bar */
        .search-filter-bar {
            display: flex;
            gap: 16px;
            align-items: center;
            margin-bottom: var(--space-lg);
            flex-wrap: wrap;
            background: var(--white);
            padding: 16px;
            border-radius: var(--border-radius-md);
            border: 1px solid var(--border-color);
        }

        .search-box {
            position: relative;
            flex: 1;
            min-width: 250px;
        }

        .search-box input {
            width: 100%;
            padding: 8px 40px 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: 16px;
            font-family: 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;
        }

        .search-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 16px;
        }

        .filters {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-select {
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            background: var(--white);
            font-size: 16px;
            font-family: 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;
            min-width: 140px;
        }

        /* Table Styling */
        .table-container {
            background: var(--white);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-md);
            overflow: hidden;
            margin-bottom: var(--space-lg);
        }

        #user-table {
            width: 100%;
            border-collapse: collapse;
        }

        #user-table thead {
            background: var(--light-gray);
            border-bottom: 2px solid var(--border-color);
        }

        #user-table th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: var(--text-color);
            font-size: 16px;
            cursor: pointer;
            -webkit-user-select: none;
            -moz-user-select: none;
            user-select: none;
        }

        #user-table th:hover {
            background-color: #f0f0f0;
        }

        .sort-icon {
            margin-left: 8px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        #user-table tbody tr {
            border-bottom: 1px solid var(--border-color);
        }

        #user-table tbody tr:hover {
            background-color: #f9f9f9;
        }

        #user-table td {
            padding: 12px;
            font-size: 16px;
            color: var(--text-color);
        }

        .actions-col {
            text-align: center;
            width: 120px;
        }
        
        /* Action Button Dropdown Styles */
        .dropdown-container {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-btn {
            position: relative;
            padding-right: 24px !important;
        }
        
        .dropdown-arrow {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            transition: transform 0.3s ease;
        }
        
        .dropdown-btn:hover .dropdown-arrow,
        .dropdown-menu.show ~ .dropdown-btn .dropdown-arrow {
            transform: translateY(-50%) rotate(180deg);
        }
        
        .dropdown-menu {
            position: absolute;
            top: 100%;
            right: 0;
            background: white;
            border: 2px solid var(--blue-primary);
            border-radius: 6px;
            box-shadow: 0 4px 12px rgba(0, 43, 118, 0.25);
            min-width: 180px;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            margin-top: 2px;
            max-height: 0;
            overflow: hidden;
        }
        
        .dropdown-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            max-height: 200px;
        }
        
        /* Ensure dropdown appears above table content */
        .dropdown-container {
            position: relative;
            display: inline-block;
            z-index: 1001;
        }
        
        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 12px 16px;
            font-size: 16px;
            color: var(--text-color);
            text-decoration: none;
            border: none;
            background: none;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: var(--font-primary);
        }
        
        .dropdown-item:first-child {
            border-radius: 6px 6px 0 0;
        }
        
        .dropdown-item:last-child {
            border-radius: 0 0 6px 6px;
        }
        
        .dropdown-item:hover {
            background-color: #f8f9fa;
            color: var(--blue-primary);
        }
        
        .dropdown-item i {
            width: 16px;
            text-align: center;
            font-size: 14px;
        }

        /* Footer Info */
        .footer-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            color: var(--text-secondary);
            font-size: 16px;
        }

        /* Modal Styling */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
        }

        .modal-overlay {
            background-color: rgba(0, 40, 118, 0.7);
            position: absolute;
            width: 100%;
            height: 100%;
        }

        .modal-content {
            background-color: var(--white);
            margin: 5% auto;
            padding: 0;
            border-radius: var(--border-radius-md);
            width: 90%;
            max-width: 500px;
            position: relative;
            box-shadow: var(--shadow-strong);
        }

        .modal-header {
            padding: 20px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            margin: 0;
            color: var(--blue-dark);
            font-size: 20px;
            font-weight: 600;
        }

        .modal-close {
            font-size: 24px;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 5px;
            border: none;
            background: none;
        }

        .modal-close:hover {
            color: var(--text-color);
        }

        .modal-body {
            padding: 20px;
        }

        .modal-footer {
            padding: 20px;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        /* Form Styling */
        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: var(--text-color);
            font-size: 16px;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: 16px;
            font-family: 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--blue-primary);
            box-shadow: 0 0 0 3px rgba(0, 174, 239, 0.1);
        }

        .password-help {
            font-size: 14px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .btn-primary {
            background-color: var(--blue-primary);
            color: white;
            border: none;
        }

        .btn-primary:hover {
            background-color: #0095d8;
        }

        .btn-cancel {
            background-color: #f8f9fa;
            color: var(--text-color);
            border: 1px solid var(--border-color);
        }

        .btn-cancel:hover {
            background-color: #e2e6ea;
        }

        /* Responsive Design */
        @@media (max-width: 1024px) {
            .admin-container {
                padding: var(--space-md);
            }

            .buttons-area {
                width: 100%;
                justify-content: space-between;
            }

            .search-filter-bar {
                flex-direction: column;
                gap: 12px;
            }

            .filters {
                width: 100%;
                justify-content: space-between;
            }

            .filter-select {
                flex: 1;
                min-width: 120px;
            }
        }

        @@media (max-width: 768px) {
            .admin-container {
                padding: var(--space-sm);
            }

            .admin-header {
                flex-direction: column;
                align-items: stretch;
                gap: 16px;
            }

            .buttons-area {
                flex-direction: column;
                gap: 8px;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .search-box {
                min-width: auto;
            }

            .filters {
                flex-direction: column;
                gap: 8px;
            }

            .filter-select {
                min-width: auto;
            }

            /* Hide less important columns on mobile */
            #user-table th:nth-child(2),
            #user-table td:nth-child(2),
            #user-table th:nth-child(6),
            #user-table td:nth-child(6) {
                display: none;
            }

            .modal-content {
                width: 95%;
                margin: 10% auto;
            }
        }

        @@media (max-width: 480px) {
            .modal-content {
                width: 98%;
                margin: 15% auto;
            }

            .modal-header,
            .modal-body,
            .modal-footer {
                padding: 16px;
            }

            .modal-footer {
                flex-direction: column;
            }

            .modal-footer .btn {
                width: 100%;
            }
        }

        /* Loading Overlay */
        #loading-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 40, 118, 0.8);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }

        .loading-content {
            text-align: center;
            color: white;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-top: 4px solid white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 16px;
        }

        .loading-message {
            font-size: 16px;
            font-weight: 500;
        }

        /* Notifications */
        .notification {
            position: fixed;
            top: 20px;
            right: -400px;
            background: white;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-md);
            box-shadow: var(--shadow-strong);
            z-index: 10000;
            min-width: 300px;
            max-width: 400px;
            transition: right 0.3s ease;
        }

        .notification.show {
            right: 20px;
        }

        .notification-content {
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .notification-message {
            flex: 1;
            font-size: 14px;
        }

        .notification-close {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: var(--text-secondary);
            padding: 0;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .notification-close:hover {
            color: var(--text-color);
        }

        .notification-success .notification-content {
            border-left: 4px solid var(--success-color);
        }

        .notification-error .notification-content {
            border-left: 4px solid var(--danger-color);
        }

        .notification-warning .notification-content {
            border-left: 4px solid var(--warning-color);
        }

        .notification-info .notification-content {
            border-left: 4px solid var(--blue-primary);
        }

        .notification-success i {
            color: var(--success-color);
        }

        .notification-error i {
            color: var(--danger-color);
        }

        .notification-warning i {
            color: var(--warning-color);
        }

        .notification-info i {
            color: var(--blue-primary);
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 5px;
            justify-content: center;
        }

        .action-btn {
            padding: 6px 8px;
            border: none;
            background: transparent;
            border-radius: 3px;
            cursor: pointer;
            font-size: 14px;
            color: var(--text-secondary);
            transition: all 0.2s ease;
        }

        .action-btn:hover {
            background: var(--light-gray);
            color: var(--text-color);
        }

        .action-btn.edit-btn:hover {
            background: var(--blue-light);
            color: var(--blue-primary);
        }

        .action-btn.delete-btn:hover {
            background: var(--danger-light);
            color: var(--danger-color);
        }

        /* Role and Status Badges */
        .role-badge, .status-badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
        }

        .role-badge.role-admin {
            background: var(--danger-light);
            color: var(--danger-color);
        }

        .role-badge.role-analyst {
            background: var(--blue-light);
            color: var(--blue-primary);
        }

        .role-badge.role-external {
            background: var(--warning-light);
            color: var(--warning-color);
        }

        .role-badge.role-internal {
            background: var(--success-light);
            color: var(--success-color);
        }

        .status-badge.status-active {
            background: var(--success-light);
            color: var(--success-color);
        }

        .status-badge.status-inactive {
            background: var(--text-light);
            color: var(--text-secondary);
        }

        /* Table loading and no data states */
        .no-data {
            text-align: center;
            padding: 40px;
            color: var(--text-secondary);
        }

        .no-data-message {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .no-data-message i {
            font-size: 48px;
            color: var(--text-muted);
        }

        /* Sorted table headers */
        #user-table th.sorted {
            background-color: #e8f4fd;
        }

        /* Admin user protection indicators */
        .admin-user-note {
            font-size: 11px;
            color: var(--warning-color);
            font-style: italic;
            margin-left: 8px;
        }
    </style>
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">User Management</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="buttons-area">
            <button id="import-btn" class="btn">
                <i class="fas fa-upload"></i> Import
            </button>
            <button id="export-btn" class="btn">
                <i class="fas fa-download"></i> Export
            </button>
            <button id="add-user-btn" class="btn btn-add">
                <i class="fas fa-plus"></i> Add New User
            </button>
        </div>
    </header>

    <div class="search-filter-bar">
        <div class="search-box">
            <label for="search-input" class="visually-hidden">Search users</label>
            <input type="text" id="search-input" placeholder="Search users..." aria-label="Search users">
            <i class="fas fa-search search-icon"></i>
        </div>
        <div class="filters">
            <label for="status-filter" class="visually-hidden">Filter by status</label>
            <select id="status-filter" class="filter-select" aria-label="Filter by status">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            <label for="role-filter" class="visually-hidden">Filter by role</label>
            <select id="role-filter" class="filter-select" aria-label="Filter by role">
                <option value="all">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="Analyst">Analyst</option>
                <option value="External">External</option>
                <option value="Public">Public</option>
            </select>
            <label for="company-filter" class="visually-hidden">Filter by company</label>
            <select id="company-filter" class="filter-select" aria-label="Filter by company">
                <option value="all">All Companies</option>
                <option value="acme-corp">ACME Corp</option>
                <option value="tech-solutions">Tech Solutions</option>
                <option value="global-industries">Global Industries</option>
            </select>
        </div>
    </div>

    <div class="table-container">
        <table id="user-table">
            <thead>
                <tr>
                    <th width="18%" data-sort="name">Name <span class="sort-icon">▼</span></th>
                    <th width="20%" data-sort="company">Company <span class="sort-icon">▼</span></th>
                    <th width="22%" data-sort="email">Email <span class="sort-icon">▼</span></th>
                    <th width="12%" data-sort="role">Role <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="status">Status <span class="sort-icon">▼</span></th>
                    <th width="12%" data-sort="lastLogin">Last Login <span class="sort-icon">▼</span></th>
                    <th width="8%" class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be populated by JavaScript -->
            </tbody>
        </table>
    </div>

    <div class="footer-info">
        <span id="user-count">Showing 0 of 0 users</span>
    </div>
</div>

<!-- Add/Edit User Modal -->
<div id="user-modal" class="modal">
    <div class="modal-overlay"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="modal-title">Add New User</h3>
            <span class="modal-close">&times;</span>
        </div>
        <div class="modal-body">
            <form id="user-form">
                <input type="hidden" id="user-id">

                <div class="form-group">
                    <label for="user-name">Name</label>
                    <input type="text" id="user-name" required>
                </div>

                <div class="form-group">
                    <label for="user-company">Company</label>
                    <select id="user-company" multiple size="4">
                        <!-- Options will be populated by JavaScript -->
                    </select>
                    <small>Hold Ctrl/Cmd to select multiple companies</small>
                </div>

                <div class="form-group">
                    <label for="user-email">Email</label>
                    <input type="email" id="user-email" required>
                </div>

                <div class="form-group">
                    <label for="user-role">Role</label>
                    <select id="user-role" required>
                        <option value="">Select a role</option>
                        <option value="Admin">Admin</option>
                        <option value="Analyst">Analyst</option>
                        <option value="External">External</option>
                        <option value="Public">Public</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="user-status">Status</label>
                    <select id="user-status" required>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                <div class="form-group" id="password-group">
                    <label for="user-password">Password</label>
                    <input type="password" id="user-password">
                    <div class="password-help" id="password-help">Leave blank to keep current password</div>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" id="require-password-reset"> Require password reset on next login
                    </label>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-cancel" id="cancel-btn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="save-btn" form="user-form">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/userManagement.js"></script>
}