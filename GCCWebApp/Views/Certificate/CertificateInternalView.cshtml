@model GCCWebApp.Models.CertificateDetailsViewModelSimple
@{
    ViewData["Title"] = "Certificate Details - Internal";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get certificate data with safe defaults
    var certificateId = Model.Certificate?.Id.ToString() ?? "0";
    var certificateNumber = Model.Certificate?.Number ?? "";
    var certificationType = Model.Certificate?.CertificationType?.Name ?? "Certified Environmental Facts";
    var company = Model.Certificate?.Company?.Name ?? "Unknown Company";
    var productName = Model.Certificate?.Product?.Name ?? "Unknown Product";
    var productType = Model.Certificate?.Product?.ProductType?.Name ?? "General Product";
}

<!-- Certificate Details -->
<div class="certificate-single-container" data-id="@certificateId">
    <!-- Certificate Card styled like tile view -->
    <div class="certificate-card certificate-single-card">
        <div class="card-header">
            <div class="header-row">
                <div class="certificate-category">@certificationType.ToUpper()</div>
                <div class="certificate-id">@certificateNumber</div>
            </div>
            <div class="company-name">@company</div>
        </div>
        <div class="card-body">
            <div class="product-info">
                <div class="product-name">@productName</div>
                <div class="product-type">@productType</div>
            </div>
            <!-- Main Detail Grid -->
            <div class="certificate-details-grid">
                <!-- Left Column: Certificate Info -->
                <div class="details-column">
                    <!-- Certification Details -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Details</h3>
                        <div class="certificate-field"><strong>Status:</strong> <span class="status-@(Model.Certificate?.Status?.ToLower())">@(Model.Certificate?.Status ?? "Unknown")</span></div>
                        <div class="certificate-field">
                            <strong>Category:</strong>
                            <span class="tag-type External">@productType</span>
                        </div>
                        <div class="certificate-field"><strong>Product Type:</strong> <span>@productType</span></div>
                        @if (!string.IsNullOrEmpty(Model.Certificate?.Partner) && Model.Certificate.Partner != "None")
                        {
                            <div class="certificate-field"><strong>Partner:</strong> <span>@Model.Certificate.Partner</span></div>
                        }
                        <div class="certificate-location">
                            <i class="fas fa-map-marker-alt"></i>
                            @(Model.Certificate?.Location ?? "Unknown Location"), @(Model.Certificate?.Country ?? "Unknown Country")
                        </div>
                    </div>

                    <!-- Certification Period -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Period</h3>
                        <div class="certificate-period">
                            <strong>Effective Date:</strong> @(Model.Certificate?.EffectiveDate.ToString("M/d/yyyy") ?? "Unknown")<br>
                            <strong>Expiration Date:</strong> @(Model.Certificate?.ExpirationDate.ToString("M/d/yyyy") ?? "Unknown")
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Contact Information</h3>
                        <div class="certificate-field">
                            <strong>Company Email:</strong>
                            <span>
                                @if (!string.IsNullOrEmpty(Model.Certificate?.Company?.Email))
                                {
                                    <a href="mailto:@Model.Certificate.Company.Email">@Model.Certificate.Company.Email</a>
                                }
                                else
                                {
                                    <text>Available upon request</text>
                                }
                            </span>
                        </div>
                        <div class="certificate-field">
                            <strong>Company URL:</strong>
                            <span>
                                @if (!string.IsNullOrEmpty(Model.Certificate?.Company?.Website))
                                {
                                    <a href="@Model.Certificate.Company.Website" target="_blank" rel="noopener">@Model.Certificate.Company.Website</a>
                                }
                                else
                                {
                                    <text>Not provided</text>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Product Identifiers (Always show for Internal users) -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Product Identifiers</h3>
                        @if (!string.IsNullOrEmpty(Model.Certificate?.Asin))
                        {
                            <div class="certificate-field"><strong>ASIN:</strong> <span>@Model.Certificate.Asin</span></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Certificate?.Upc))
                        {
                            <div class="certificate-field"><strong>UPC:</strong> <span>@Model.Certificate.Upc</span></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Certificate?.Gtin))
                        {
                            <div class="certificate-field"><strong>GTIN:</strong> <span>@Model.Certificate.Gtin</span></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Certificate?.Ean))
                        {
                            <div class="certificate-field"><strong>EAN:</strong> <span>@Model.Certificate.Ean</span></div>
                        }
                        @if (string.IsNullOrEmpty(Model.Certificate?.Asin) && string.IsNullOrEmpty(Model.Certificate?.Upc) && string.IsNullOrEmpty(Model.Certificate?.Gtin) && string.IsNullOrEmpty(Model.Certificate?.Ean))
                        {
                            <div class="certificate-field"><em>No product identifiers available</em></div>
                        }
                    </div>

                    <!-- Record Information (Always show for Internal users) -->
                    <div class="detail-section record-info">
                        <h3 class="certificate-section-title">Record Information</h3>
                        <div class="certificate-field"><strong>Created Date:</strong> <span>@(Model.Certificate?.CreatedAt.ToString("M/d/yyyy") ?? "Unknown")</span></div>
                        <div class="certificate-field"><strong>Last Updated:</strong> <span>@(Model.Certificate?.UpdatedAt.ToString("M/d/yyyy") ?? "Unknown")</span></div>
                        @if (Model.Certificate?.CreatedByUser != null)
                        {
                            <div class="certificate-field"><strong>Created By:</strong> <span>@Model.Certificate.CreatedByUser.Email</span></div>
                        }
                        @if (Model.Certificate?.UpdatedByUser != null)
                        {
                            <div class="certificate-field"><strong>Last Edited By:</strong> <span>@Model.Certificate.UpdatedByUser.Email</span></div>
                        }
                    </div>

                    <!-- Tags (Both Internal and External for Internal users) -->
                    <div class="certificate-tags">
                        @if (Model.Certificate?.Tags != null && Model.Certificate.Tags.Any())
                        {
                            @foreach (var tag in Model.Certificate.Tags)
                            {
                                <div class="tag @(tag.TagType?.ToLower() ?? "external")">@tag.Name</div>
                            }
                        }
                    </div>
                </div>
                <!-- Right Column: Certificate Image -->
                <div class="certificate-image-column">
                    @{
                        string certificateImageSrc;
                        if (!string.IsNullOrEmpty(Model.Certificate?.CertificateImagePath))
                        {
                            certificateImageSrc = Model.Certificate.CertificateImagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? Model.Certificate.CertificateImagePath
                                : Model.Certificate.CertificateImagePath.StartsWith("/")
                                    ? Model.Certificate.CertificateImagePath
                                    : $"/uploads/{Model.Certificate.CertificateImagePath}";
                        }
                        else if (!string.IsNullOrEmpty(Model.Certificate?.CertificateFile))
                        {
                            certificateImageSrc = Model.Certificate.CertificateFile.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? Model.Certificate.CertificateFile
                                : Model.Certificate.CertificateFile.StartsWith("/")
                                    ? Model.Certificate.CertificateFile
                                    : $"/uploads/{Model.Certificate.CertificateFile}";
                        }
                        else
                        {
                            certificateImageSrc = Url.Content("~/img/certpreview.png");
                        }
                    }
                    <img src="@certificateImageSrc" alt="Certificate Details" class="certificate-image" onerror="this.src='@Url.Content("~/img/certpreview.png")';this.onerror=null;" />
                </div>
            </div>
            <!-- Action Buttons -->
            <div class="card-actions">
                <div class="action-icon download" title="Download PDF" onclick="downloadCertificate('@certificateNumber')">
                    <i class="fas fa-download"></i>
                </div>
                @if (Model.CanEdit)
                {
                    <div class="action-icon edit" title="Edit Certificate" onclick="editCertificate('@certificateNumber')">
                        <i class="fas fa-edit"></i>
                    </div>
                }
                @if (Model.CanDelete)
                {
                    <div class="action-icon delete" title="Delete Certificate" onclick="deleteCertificate('@certificateId')">
                        <i class="fas fa-trash"></i>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/js/certificates.js"></script>
<script>
    // Make certificate action functions available globally for this page
    window.editCertificate = function(certificateNumber) {
        if (!certificateNumber) {
            console.error('Certificate number is missing');
            return;
        }
        // Use certificate number (e.g., "24-1605") instead of ID for URL
        window.location.href = `/Certificate/Edit/${encodeURIComponent(certificateNumber)}`;
    };

    window.deleteCertificate = function(certificateId) {
        if (!certificateId) {
            console.error('Certificate ID is missing');
            return;
        }

        if (confirm('Are you sure you want to delete this certificate? This action cannot be undone.')) {
            // Submit delete request
            fetch(`/Certificate/Delete/${certificateId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            })
            .then(response => {
                if (response.ok) {
                    alert('Certificate deleted successfully');
                    window.location.href = '/Certificate/CertificateTileViewInternal';
                } else {
                    alert('Failed to delete certificate');
                }
            })
            .catch(error => {
                console.error('Error deleting certificate:', error);
                alert('An error occurred while deleting the certificate');
            });
        }
    };

    window.downloadCertificate = function(certificateNumber) {
        if (!certificateNumber) {
            console.error('Certificate number is missing');
            return;
        }
        try {
            window.open(`/Certificate/Download/${certificateNumber}`, '_blank');
            console.log('Certificate download started');
        } catch (error) {
            console.error('Error downloading certificate:', error);
        }
    };
</script>