@model GCCWebApp.Models.CertificateDetailsViewModelSimple
@{
    ViewData["Title"] = "Certificate Details - Internal";
    ViewData["BodyClass"] = "certificate-single-view";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get certificate data with safe defaults
    var certificateId = Model.Certificate?.Id.ToString() ?? "0";
    var certificateNumber = Model.Certificate?.Number ?? "";
    var certificationType = Model.Certificate?.CertificationType?.Name ?? "Certified Environmental Facts";
    var company = Model.Certificate?.Company?.Name ?? "—";
    var productName = Model.Certificate?.Product?.Name ?? "—";
    var productType = Model.Certificate?.ProductType?.Name ?? Model.Certificate?.Product?.ProductType?.Name ?? "—";

    // CR-037: all associated countries, primary first, comma-joined.
    var allCountries = Model.Certificate?.Countries != null && Model.Certificate.Countries.Any()
        ? string.Join(", ", Model.Certificate.Countries
            .OrderByDescending(cc => cc.Country == Model.Certificate.Country)
            .ThenBy(cc => cc.Country)
            .Select(cc => cc.Country))
        : Model.Certificate?.Country;

    // Format certificate number as YY-####
    string GetFormattedCertificateNumber()
    {
        if (string.IsNullOrEmpty(certificateNumber)) return "—";
        if (System.Text.RegularExpressions.Regex.IsMatch(certificateNumber, @"^\d{2}-\d{4}$"))
            return certificateNumber;
        var year = Model.Certificate?.EffectiveDate != null
            ? Model.Certificate.EffectiveDate.Year.ToString().Substring(2)
            : DateTime.Now.Year.ToString().Substring(2);
        if (System.Text.RegularExpressions.Regex.IsMatch(certificateNumber, @"^\d+$"))
        {
            var paddedNumber = certificateNumber.PadLeft(4, '0');
            return $"{year}-{paddedNumber}";
        }
        return certificateNumber;
    }
}

@* CR-031 (QC #188, client 2026-07-31): the CR-030 post-save "ExpiryCorrectionAlert" reader that
   lived here has been REMOVED. The client replaced that toast with a pre-save confirmation on the
   Edit form (Views/Certificate/Edit.cshtml), because "please confirm all fields are accurate" only
   means something while the analyst can still change them. Its writer in CertificateController's
   Edit POST was removed in the same change — per DEF-318, a TempData key must never be left with
   a writer and no reader (an unread entry is re-saved indefinitely and surfaces on some unrelated
   later page). Do not reintroduce a reader here without a writer, or vice versa. *@

@* DEF-339 (client, 2026-08-04): "I don't see the toast notification." Saving a certificate — the
   single most common action in the app — had no confirmation on either the Create "Save" path or
   the Edit save path. Only "Save & Add Another" and CSV import ever confirmed anything, because
   DEF-318 deleted the orphaned Edit write rather than pairing it with a reader.

   This is that reader. Two writers (Create's plain-Save path and Edit's save path in
   CertificateController), both of which redirect HERE, so the entry is consumed on the very next
   request — the DEF-330 leak is not reintroduced. Multiple writers to one reader is fine and
   already the pattern for AccountController's three writes into TwoFactorPreferences; what must
   never happen is a writer whose redirect target does not read the key. *@
@if (TempData["SaveSuccessMessage"] is string saveSuccessMsg)
{
    @* Same nonce guard as Create.cshtml/CertificateTileView.cshtml: keyed on a per-render nonce
       rather than the message text, so a bfcache/Back restore replaying this inline script cannot
       re-fire it, while two genuine saves of the same certificate each still confirm. *@
    <script>
        (function () {
            var nonce = '@(Guid.NewGuid().ToString("N"))';
            var msg = '@Html.Raw(saveSuccessMsg.Replace("\\", "\\\\").Replace("'", "\\'"))';
            var seenKey = 'saveSuccessMsgShown:' + nonce;
            function showOnce() {
                try {
                    if (sessionStorage.getItem(seenKey)) return;
                    sessionStorage.setItem(seenKey, '1');
                } catch (e) { /* sessionStorage unavailable — fall through and show once */ }
                if (typeof AdminCore === 'undefined' || !AdminCore.showToastNotification) return;
                // Must run before showToastNotification: it appends into a container that only
                // initializeNotifications() creates, and AdminCore.init() does that from its own
                // DOMContentLoaded handler (admin-core.js:975) registered AFTER this one, since
                // this script is in the view body and admin-core.js loads at the end of _Layout.
                // Idempotent — admin-core.js:112 guards on an existing container.
                AdminCore.initializeNotifications();
                AdminCore.showToastNotification(msg, 'success');
            }
            window.addEventListener('pageshow', function (e) { if (e.persisted) showOnce(); });
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', showOnce);
            } else {
                showOnce();
            }
        })();
    </script>
}

<!-- Certificate Details -->
<div class="certificate-single-container" data-id="@certificateId">
    <!-- Certificate Card styled like tile view -->
    <div class="certificate-card certificate-single-card">
        <div class="card-header">
            <div class="header-row">
                <div class="certificate-category">@certificationType.ToUpper()</div>
                <div class="certificate-id">@GetFormattedCertificateNumber()</div>
            </div>
            <div class="company-name">@company</div>
        </div>
        <div class="card-body">
            <div class="product-info">
                <div class="product-name">@productName</div>
                @if (productType != "—") { <div class="product-type">@productType</div> }
            </div>
            <!-- Main Detail Grid -->
            <div class="certificate-details-grid">
                <!-- Left Column: Certificate Info -->
                <div class="details-column">
                    <!-- Certification Details -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Details</h3>
                        <div class="certificate-field"><strong>Status:</strong> <span class="status-@(Model.Certificate?.Status?.ToLower())">@(Model.Certificate?.Status ?? "—")</span></div>
                        <div class="certificate-field"><strong>Product Category:</strong> <span>@Html.Raw(Model.Certificate?.ProductCategory?.Name ?? "<span class='no-data'>—</span>")</span></div>
                        <div class="certificate-field"><strong>Product Type:</strong> <span>@Html.Raw(Model.Certificate?.ProductType?.Name ?? Model.Certificate?.Product?.ProductType?.Name ?? "<span class='no-data'>—</span>")</span></div>
                        <div class="certificate-field"><strong>Product Subcategory:</strong> <span>@Html.Raw(Model.Certificate?.ProductSubcategory?.Name ?? Model.Certificate?.Product?.ProductSubcategory?.Name ?? "<span class='no-data'>—</span>")</span></div>
                        @*
                            DEF-344 (client 2026-08-07, cert 26-10091): render the Partners M2M
                            collection, not the denormalized Certificates.Partner column. That column
                            holds only the *first* matched name (SyncCertificatePartnersAsync), so a
                            certificate carrying Amazon + Novi showed "Amazon" here while Edit and the
                            tile listing — both of which read the collection — correctly showed both.
                            Falls back to the denormalized string for rows written before CR-171.
                        *@
                        @{
                            var partnerNames = Model.Certificate?.Partners?
                                .Where(p => !string.IsNullOrWhiteSpace(p.Name) && p.Name != "None")
                                .Select(p => p.Name)
                                .ToList() ?? new List<string>();

                            if (!partnerNames.Any()
                                && !string.IsNullOrEmpty(Model.Certificate?.Partner)
                                && Model.Certificate.Partner != "None")
                            {
                                partnerNames.Add(Model.Certificate.Partner);
                            }
                        }
                        @if (partnerNames.Any())
                        {
                            <div class="certificate-field"><strong>Partner:</strong> <span>@string.Join(", ", partnerNames)</span></div>
                        }
                        @if (Model.Certificate?.Pathway != null)
                        {
                            <div class="certificate-field"><strong>Pathway:</strong> <span>@Model.Certificate.Pathway.Name</span></div>
                        }
                        @if (Model.Certificate?.CertificationTypeSubcategories != null && Model.Certificate.CertificationTypeSubcategories.Any())
                        {
                            <div class="certificate-field">
                                <strong>Subcategories:</strong>
                                <span>@string.Join(", ", Model.Certificate.CertificationTypeSubcategories.Select(s => s.Name))</span>
                            </div>
                        }
                        <div class="certificate-location">
                            <i class="fas fa-map-marker-alt"></i>
                            @* CR-037: allCountries lists every country, not just the primary. *@
                            @if (!string.IsNullOrEmpty(Model.Certificate?.Location) && !string.IsNullOrEmpty(allCountries))
                            {
                                <text>@Model.Certificate.Location, @allCountries</text>
                            }
                            else if (!string.IsNullOrEmpty(Model.Certificate?.Location))
                            {
                                @Model.Certificate.Location
                            }
                            else if (!string.IsNullOrEmpty(allCountries))
                            {
                                @allCountries
                            }
                            else
                            {
                                <span class="no-data">—</span>
                            }
                        </div>
                    </div>

                    <!-- Certification Period -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Period</h3>
                        <div class="certificate-period">
                            <strong>Effective Date:</strong> @(Model.Certificate?.EffectiveDate.ToString("M/d/yyyy") ?? "—")<br>
                            <strong>Expiration Date:</strong> @(Model.Certificate?.ExpirationDate.ToString("M/d/yyyy") ?? "—")
                        </div>
                    </div>

                    @* Certification Results - Admin/Analyst only *@
                    @if (!string.IsNullOrWhiteSpace(Model.Certificate?.CertificationResults))
                    {
                        <div class="detail-section">
                            <h3 class="certificate-section-title">Certification Results</h3>
                            <div class="certificate-field">@Model.Certificate.CertificationResults</div>
                        </div>
                    }

                    <!-- Contact Info -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Contact Information</h3>
                        <div class="certificate-field">
                            <strong>Company Email:</strong>
                            <span>
                                @if (!string.IsNullOrEmpty(Model.Certificate?.Company?.Email))
                                {
                                    <a href="mailto:@Model.Certificate.Company.Email">@Model.Certificate.Company.Email</a>
                                }
                                else
                                {
                                    <span class="no-data">—</span>
                                }
                            </span>
                        </div>
                        <div class="certificate-field">
                            <strong>Company URL:</strong>
                            <span>
                                @if (!string.IsNullOrEmpty(Model.Certificate?.Company?.Website))
                                {
                                    <a href="@Model.Certificate.Company.Website" target="_blank" rel="noopener">@Model.Certificate.Company.Website</a>
                                }
                                else
                                {
                                    <span class="no-data">—</span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Product Identifiers (Always show for Internal users) -->
                    <div class="detail-section">
                        @{
                            var allPids = Model.Certificate?.ProductIds?.OrderBy(p => p.ProductIdType).ToList() ?? new List<GCCWebApp.Models.CertificateProductId>();
                            var pidCount = allPids.Count;
                            var initialLimit = 20;
                            var hasMore = pidCount > initialLimit;
                        }
                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
                            <h3 class="certificate-section-title" style="margin-bottom: 0;">Product Identifiers <span style="font-size: 14px; font-weight: 400; color: #666;">(@pidCount)</span></h3>
                            @if (hasMore)
                            {
                                <button type="button" id="pid-toggle-btn" onclick="togglePidShowAll()"
                                    aria-expanded="false" aria-controls="pid-remaining"
                                    style="padding: 6px 14px; background: #f8f9fa; border: 1px solid #ced4da; border-radius: 4px; cursor: pointer; font-size: 14px;">
                                    Show all @pidCount
                                </button>
                            }
                        </div>
                        @if (pidCount > 0)
                        {
                            <div style="max-height: 400px; overflow-y: auto; border: 1px solid #e9ecef; border-radius: 6px; padding: 8px; margin-top: 8px;" id="pid-container">
                                @foreach (var pid in allPids.Take(initialLimit))
                                {
                                    <div class="certificate-field"><strong>@pid.ProductIdType:</strong> <span>@pid.ProductIdValue</span></div>
                                }
                                @if (hasMore)
                                {
                                    <div id="pid-remaining" style="display: none;">
                                        @foreach (var pid in allPids.Skip(initialLimit))
                                        {
                                            <div class="certificate-field"><strong>@pid.ProductIdType:</strong> <span>@pid.ProductIdValue</span></div>
                                        }
                                    </div>
                                }
                            </div>
                            @if (hasMore)
                            {
                                <script>
                                    function togglePidShowAll() {
                                        var remaining = document.getElementById('pid-remaining');
                                        var btn = document.getElementById('pid-toggle-btn');
                                        var expanded = remaining.style.display === 'block';
                                        if (expanded) {
                                            remaining.style.display = 'none';
                                            btn.textContent = 'Show all @pidCount';
                                            btn.setAttribute('aria-expanded', 'false');
                                            document.getElementById('pid-container').scrollTop = 0;
                                        } else {
                                            remaining.style.display = 'block';
                                            btn.textContent = 'Show less';
                                            btn.setAttribute('aria-expanded', 'true');
                                        }
                                    }
                                </script>
                            }
                        }
                        else
                        {
                            <div class="certificate-field"><em>No product identifiers available</em></div>
                        }
                    </div>

                    <!-- Record Information (Always show for Internal users) -->
                    <div class="detail-section record-info">
                        <h3 class="certificate-section-title">Record Information</h3>
                        <div class="certificate-field"><strong>Created Date:</strong> <span>@(Model.Certificate?.CreatedAt.ToString("M/d/yyyy") ?? "—")</span></div>
                        <div class="certificate-field"><strong>Last Updated:</strong> <span>@(Model.Certificate?.UpdatedAt.ToString("M/d/yyyy") ?? "—")</span></div>
                        @if (Model.Certificate?.CreatedByUser != null)
                        {
                            <div class="certificate-field"><strong>Created By:</strong> <span>@Model.Certificate.CreatedByUser.Email</span></div>
                        }
                        @if (Model.Certificate?.UpdatedByUser != null)
                        {
                            <div class="certificate-field"><strong>Last Edited By:</strong> <span>@Model.Certificate.UpdatedByUser.Email</span></div>
                        }
                    </div>

                    @* Custom Fields *@
                    @if (Model.CustomFieldValues != null && Model.CustomFieldValues.Any())
                    {
                        @foreach (var fieldSection in Model.CustomFieldValues.GroupBy(f => f.Field.Section ?? "Additional Information"))
                        {
                            <div class="detail-section">
                                <h3 class="certificate-section-title">@fieldSection.Key</h3>
                                @foreach (var fieldValue in fieldSection)
                                {
                                    @if (!string.IsNullOrWhiteSpace(fieldValue.Value))
                                    {
                                        <div class="certificate-field"><strong>@fieldValue.Field.Name:</strong> <span>@fieldValue.DisplayValue</span></div>
                                    }
                                }
                            </div>
                        }
                    }

                    <!-- Tags (Both Internal and External for Internal users) -->
                    <div class="certificate-tags">
                        @if (Model.Certificate?.Tags != null && Model.Certificate.Tags.Any())
                        {
                            @foreach (var tag in Model.Certificate.Tags)
                            {
                                <div class="tag @(tag.TagType?.ToLower() ?? "external")">@tag.Name</div>
                            }
                        }
                    </div>
                </div>
                <!-- Right Column: Certificate Image -->
                <div class="certificate-image-column">
                    @{
                        // DEF-208: route image through controller (gate enforced) instead of
                        // rendering the raw /uploads/* path that static-file middleware would serve.
                        var imagePath = Model.Certificate?.CertificateImagePath ?? "";
                        bool hasValidSnapshot = !string.IsNullOrEmpty(imagePath);
                        string certificateImageSrc = "";
                        if (hasValidSnapshot)
                        {
                            certificateImageSrc = imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? imagePath
                                // DEF-310 (QC #191): `v` busts a stale cache after a document replace.
                                : Url.Action("ViewCertificateImage", "Certificate", new { id = Model.Certificate.Id, v = UploadCacheBusting.VersionToken(imagePath) }) ?? "";
                        }
                    }
                    <!-- Consistent preview container (US-016: uses CSS class instead of inline styles) -->
                    <div class="certificate-preview-box">
                        @if (hasValidSnapshot)
                        {
                            <img src="@certificateImageSrc" alt="Certificate @GetFormattedCertificateNumber()"
                                 onclick="openImageZoom('@certificateImageSrc')" />
                        }
                        else
                        {
                            <!-- Certificate Unavailable placeholder -->
                            <div class="preview-placeholder">
                                <i class="fas fa-file-pdf"></i>
                                <p>Certificate Unavailable</p>
                                <small>Preview not generated</small>
                            </div>
                        }
                    </div>

                    <!-- Action icons below image: zoom + download, right-aligned -->
                    @{
                        var hasFile = !string.IsNullOrEmpty(Model.Certificate?.CertificateFile);
                        var zoomClass = hasValidSnapshot ? "action-icon zoom" : "action-icon zoom disabled";
                        var zoomTitle = hasValidSnapshot ? "Click to zoom" : "No preview available";
                        var downloadClass = hasFile ? "action-icon download" : "action-icon download disabled";
                        var downloadTitle = hasFile ? "Download PDF" : "No PDF available";
                    }
                    <div class="certificate-download-action">
                        @if (hasValidSnapshot)
                        {
                            <div class="@zoomClass" title="@zoomTitle" onclick="openImageZoom('@certificateImageSrc')">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        }
                        else
                        {
                            <div class="@zoomClass" title="@zoomTitle">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        }
                        @if (hasFile)
                        {
                            <div class="@downloadClass" title="@downloadTitle" onclick="downloadCertificate('@GetFormattedCertificateNumber()', @Model.Certificate.Id)">
                                <i class="fas fa-download"></i>
                            </div>
                        }
                        else
                        {
                            <div class="@downloadClass" title="@downloadTitle">
                                <i class="fas fa-download"></i>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Database Listing URL -->
            @{
                // DEF-369: this is the "Database Listing URL" the client copies, prints and shares as
                // proof of certification. CR-038 lets several certificates share a number, so the
                // bare form resolves to whichever sibling the shared-number rule picks — meaning the
                // published link for 175 certificates pointed at a DIFFERENT product's listing.
                // The disambiguator is appended only when the number is actually shared, so the
                // clean, short URL is preserved for the overwhelming majority.
                var verifyBase = $"{Context.Request.Scheme}://{Context.Request.Host}/Certificate/Verify/{GetFormattedCertificateNumber()}";
                var verifyUrl = Model.SharesCertificateNumber
                    ? $"{verifyBase}?cid={Model.Certificate.Id}"
                    : verifyBase;
            }
            <div class="detail-section" style="margin-top: 20px; padding-top: 15px; border-top: 1px solid #dee2e6;">
                <div class="certificate-field">
                    <strong>Database Listing URL:</strong>
                    <a href="@verifyUrl" target="_blank" rel="noopener" style="word-break: break-all; overflow-wrap: anywhere;">@verifyUrl</a>
                </div>
            </div>

            <!-- Edit/Delete Actions at end of card-body, right-aligned -->
            @if (Model.CanEdit || Model.CanDelete)
            {
                <div class="certificate-internal-actions" style="display: flex; justify-content: flex-end; gap: 15px; margin-top: 20px; padding: 15px 0;">
                    @if (Model.CanEdit)
                    {
                        <div class="action-icon edit" title="Edit Certificate" onclick="editCertificate('@GetFormattedCertificateNumber()', @Model.Certificate.Id)">
                            <i class="fas fa-edit"></i>
                        </div>
                    }
                    @if (Model.CanDelete)
                    {
                        <div class="action-icon delete" title="Delete Certificate" onclick="deleteCertificate('@GetFormattedCertificateNumber()', @Model.Certificate.Id)">
                            <i class="fas fa-trash"></i>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="image-zoom-modal" onclick="closeImageZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
    <div class="zoom-caption" id="imageCaption">Certificate Preview</div>
</div>

<script>
    // Image zoom functionality
    function openImageZoom(imageSrc) {
        const modal = document.getElementById('imageZoomModal');
        const modalImg = document.getElementById('zoomedImage');
        const caption = document.getElementById('imageCaption');

        modal.style.display = 'block';
        modalImg.src = imageSrc;
        caption.innerHTML = 'Certificate @GetFormattedCertificateNumber() - Click anywhere to close';

        // Prevent body scroll when modal is open
        document.body.style.overflow = 'hidden';
    }

    function closeImageZoom() {
        const modal = document.getElementById('imageZoomModal');
        modal.style.display = 'none';

        // Restore body scroll
        document.body.style.overflow = 'auto';
    }

    // Close on ESC key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeImageZoom();
        }
    });

    // Make certificate action functions available globally for this page
        window.editCertificate = function(certificateNumber, certificateId) {
        if (!certificateNumber) {
            console.error('Certificate number is missing');
            return;
        }
        // Use certificate number (e.g., "24-1605") instead of ID for URL
        const editCid = Number(certificateId) > 0 ? `?cid=${Number(certificateId)}` : '';
        window.location.href = `/Certificate/Edit/${encodeURIComponent(certificateNumber)}${editCid}`;
    };

        // DEF-369: pass the id of the certificate this page is showing. Delete is permanent
    // (no soft-delete, DEF-288), and where several certificates share a number the
    // number-only lookup would have deleted a sibling instead of the one on screen.
    window.deleteCertificate = async function(certificateNumber, certificateId) {
        if (!certificateNumber) {
            console.error('Certificate number is missing');
            return;
        }

        const confirmed = await AdminCore.showConfirmation({
            title: 'Delete Certificate',
            message: 'Are you sure you want to delete this certificate? This action cannot be undone.',
            confirmText: 'Delete',
            cancelText: 'Cancel',
            type: 'danger'
        });

        if (confirmed) {
            try {
                const delCid = Number(certificateId) > 0 ? `?cid=${Number(certificateId)}` : '';
                const response = await fetch(`/Certificate/Delete/${encodeURIComponent(certificateNumber)}${delCid}`, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });
                let payload = null;
                try { payload = await response.json(); } catch (_) { /* non-JSON response */ }

                if (response.ok && payload && payload.success) {
                    AdminCore.showNotification(payload.message || 'Certificate deleted successfully', 'success');
                    const target = payload.redirectUrl || '/Certificate/CertificateTileViewInternal';
                    setTimeout(() => { window.location.href = target; }, 1200);
                } else {
                    const msg = (payload && payload.message) || `Failed to delete certificate (HTTP ${response.status})`;
                    console.error('Delete failed:', response.status, payload);
                    AdminCore.showNotification(msg, 'error');
                }
            } catch (error) {
                console.error('Error deleting certificate:', error);
                AdminCore.showNotification('An error occurred while deleting the certificate', 'error');
            }
        }
    };

        // DEF-369: CR-038 allows several certificates to share one number, so this page passes
    // the id of the certificate it actually rendered. Without it the buttons fall back to
    // the number and resolve to a sibling — the same wrong-certificate defect one step on.
    window.downloadCertificate = async function(certificateNumber, certificateId) {
        if (!certificateNumber) {
            AdminCore.showNotification('Certificate number is missing', 'error');
            return;
        }
        try {
            const cidQuery = Number(certificateId) > 0 ? `?cid=${Number(certificateId)}` : '';
            const response = await fetch(`/Certificate/Download/${encodeURIComponent(certificateNumber)}${cidQuery}`);
            if (response.ok) {
                const blob = await response.blob();
                let filename = `Certificate_${certificateNumber}.pdf`;
                const cd = response.headers.get('Content-Disposition');
                if (cd) {
                    const match = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (match && match[1]) filename = match[1].replace(/['"]/g, '');
                }
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url; a.download = filename;
                document.body.appendChild(a); a.click();
                window.URL.revokeObjectURL(url); document.body.removeChild(a);
                AdminCore.showNotification('Certificate download started', 'success');
            } else if (response.status === 404) {
                AdminCore.showNotification(
                    `No certificate PDF has been uploaded for ${certificateNumber}. Download is unavailable until an analyst uploads the certificate file.`,
                    'error'
                );
            } else {
                AdminCore.showNotification('Failed to download certificate', 'error');
            }
        } catch (error) {
            console.error('Error downloading certificate:', error);
            AdminCore.showNotification('Failed to download certificate', 'error');
        }
    };
</script>