@model CertificateDetailsViewModelSimple
@{
    ViewData["Title"] = "Certificate Details";
    ViewData["BodyClass"] = "certificate-single-view";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get data from model with safe defaults
    var certificateId = Model.Certificate?.Id.ToString() ?? "0";
    // Use Number from model, fallback to URL path segment if empty
    var certificateNumber = !string.IsNullOrEmpty(Model.Certificate?.Number)
        ? Model.Certificate.Number
        : Context.Request.RouteValues["id"]?.ToString() ?? "";
    var certificationType = Model.Certificate?.CertificationType?.Name ?? "Certified Environmental Facts";
    var company = Model.Certificate?.Company?.Name ?? "Unknown Company";
    var productName = Model.Certificate?.Product?.Name ?? "Unknown Product";
    var productType = Model.Certificate?.Product?.ProductType?.Name ?? "General Product";
    var location = Model.Certificate?.Location ?? "Unknown Location";
    var country = Model.Certificate?.Country ?? "Unknown Country";
    var effectiveDate = Model.Certificate?.EffectiveDate.ToString("M/d/yyyy") ?? "Unknown";
    var expirationDate = Model.Certificate?.ExpirationDate.ToString("M/d/yyyy") ?? "Unknown";
    var companyContact = "";
    var companyUrl = "";
    var companyEmail = "";

    // Format certificate number as YY-####
    string GetFormattedCertificateNumber()
    {
        if (string.IsNullOrEmpty(certificateNumber)) return "N/A";

        // If already in correct format, return as is
        if (System.Text.RegularExpressions.Regex.IsMatch(certificateNumber, @"^\d{2}-\d{4}$"))
            return certificateNumber;

        // Try to get year from effective date
        var year = "";
        if (Model.Certificate?.EffectiveDate != null)
        {
            year = Model.Certificate.EffectiveDate.Year.ToString().Substring(2);
        }
        else
        {
            year = DateTime.Now.Year.ToString().Substring(2);
        }

        // If certificate number is just digits, format as YY-####
        if (System.Text.RegularExpressions.Regex.IsMatch(certificateNumber, @"^\d+$"))
        {
            var paddedNumber = certificateNumber.PadLeft(4, '0');
            return $"{year}-{paddedNumber}";
        }

        return certificateNumber; // Return as-is if we can't format it
    }

    // Helper methods
    string GetProductCategoryDisplay()
    {
        var type = (productType ?? "").ToLower();
        if (type.Contains("door") || type.Contains("exit") || type.Contains("lock"))
            return "Construction / Building Products";
        if (type.Contains("cable") || type.Contains("copper"))
            return "Electronics / Telecommunications";
        if (type.Contains("insulation") || type.Contains("roof"))
            return "Construction / Building Products";
        if (type.Contains("paper"))
            return "Office Supplies";
        if (type.Contains("plastic") || type.Contains("film"))
            return "Materials / Components";
        return "Construction / Building Products";
    }

    string GetProductSubcategory()
    {
        var type = (productType ?? "").ToLower();
        if (type.Contains("exit")) return "Door Hardware";
        if (type.Contains("lock")) return "Door Hardware";
        if (type.Contains("cable")) return "Cables & Wiring";
        if (type.Contains("insulation")) return "Insulation Materials";
        if (type.Contains("roof")) return "Roofing Materials";
        if (type.Contains("paper")) return "Paper Products";
        if (type.Contains("plastic") || type.Contains("film")) return "Plastic Materials";
        return "General Hardware";
    }

    string GetCertificationTypeTag()
    {
        var type = (certificationType ?? "").ToLower();
        if (type.Contains("environmental")) return "Environmental Facts";
        if (type.Contains("sustainability")) return "Sustainability Facts";
        if (type.Contains("recycled")) return "Recycled Content";
        if (type.Contains("energy")) return "Energy Savings";
        if (type.Contains("lca")) return "LCA Optimized";
        return "Certified Product";
    }
}
<!-- Certificate Details -->
<div class="certificate-single-container" data-id="@certificateId">
    <!-- Certificate Card styled like tile view -->
    <div class="certificate-card certificate-single-card">
        <div class="card-header">
            <div class="header-row">
                <div class="certificate-category">@certificationType.ToUpper()</div>
                <div class="certificate-id">@GetFormattedCertificateNumber()</div>
            </div>
            <div class="company-name">@company</div>
        </div>
        <div class="card-body">
            <div class="product-info">
                <div class="product-name" style="font-size: 22px; font-weight: 700;">@productName</div>
                <div class="product-type" style="font-size: 18px;">@productType</div>
            </div>
            <!-- Main Detail Grid -->
            <div class="certificate-details-grid">
                <!-- Left Column: Certificate Info -->
                <div class="details-column">
                    <!-- Certification Details -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Details</h3>
                        <div class="certificate-field">
                            <strong>Category:</strong>
                            <span class="tag-type External">@GetProductCategoryDisplay()</span>
                        </div>
                        <div class="certificate-field"><strong>Product Type:</strong> <span>@productType</span></div>
                        <div class="certificate-field"><strong>Product Subcategory:</strong> <span>@GetProductSubcategory()</span></div>
                        <div class="certificate-location">
                            <i class="fas fa-map-marker-alt"></i>
                            @location@if (!string.IsNullOrEmpty(country))
                            {
                                <text>, @country</text>
                            }
                        </div>
                    </div>
                    <!-- Certification Period -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Period</h3>
                        <div class="certificate-period">
                            <strong>Effective Date:</strong> @effectiveDate<br>
                            <strong>Expiration Date:</strong> @expirationDate
                        </div>
                    </div>
                    <!-- Contact Info -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Contact Information</h3>
                        <div class="certificate-field"><strong>Company Contact:</strong> <span>@(!string.IsNullOrEmpty(companyContact) ? companyContact : "Available upon request")</span></div>
                        <div class="certificate-field"><strong>Company URL:</strong> <span>@(!string.IsNullOrEmpty(companyUrl) ? companyUrl : "Not provided")</span></div>
                        <div class="certificate-field"><strong>Company Email:</strong> <span>@(!string.IsNullOrEmpty(companyEmail) ? companyEmail : "Not provided")</span></div>
                    </div>
                    <!-- Tags -->
                    <div class="certificate-tags">
                        <div class="tag external">@GetProductCategoryDisplay()</div>
                        <div class="tag external">@GetCertificationTypeTag()</div>
                    </div>
                </div>
                <!-- Right Column: Certificate Image/PDF Preview -->
                <div class="certificate-image-column">
                    @{
                        // Use direct path to uploaded certificate image
                        string certificateImageSrc;
                        if (!string.IsNullOrEmpty(Model.Certificate?.CertificateImagePath))
                        {
                            certificateImageSrc = Model.Certificate.CertificateImagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? Model.Certificate.CertificateImagePath
                                : Model.Certificate.CertificateImagePath.StartsWith("/")
                                    ? Model.Certificate.CertificateImagePath
                                    : $"/uploads/{Model.Certificate.CertificateImagePath}";
                        }
                        else if (!string.IsNullOrEmpty(Model.Certificate?.CertificateFile))
                        {
                            certificateImageSrc = Model.Certificate.CertificateFile.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? Model.Certificate.CertificateFile
                                : Model.Certificate.CertificateFile.StartsWith("/")
                                    ? Model.Certificate.CertificateFile
                                    : $"/uploads/{Model.Certificate.CertificateFile}";
                        }
                        else
                        {
                            certificateImageSrc = Url.Content("~/img/certpreview.png");
                        }
                        var altText = $"Certificate {GetFormattedCertificateNumber()}";
                    }
                    <div class="certificate-image-container" style="position: relative;">
                        <img src="@certificateImageSrc" alt="@altText" class="certificate-image" onerror="this.src='@Url.Content("~/img/certpreview.png")';this.onerror=null;" onclick="openImageZoom('@certificateImageSrc')" />

                        <!-- Magnifying Glass Icon overlay -->
                        <div class="zoom-icon-overlay" onclick="openImageZoom('@certificateImageSrc')" title="Click to zoom">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>

                    <!-- Download Button directly below image -->
                    <div class="certificate-download-action">
                        <div class="action-icon download" title="Download PDF" onclick="downloadCertificate('@GetFormattedCertificateNumber()')">
                            <i class="fas fa-download"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="image-zoom-modal" onclick="closeImageZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
    <div class="zoom-caption" id="imageCaption">Certificate Preview</div>
</div>

<script src="~/js/certificates.js"></script>
<script>
    // Make downloadCertificate available globally for this page
    window.downloadCertificate = function(certificateNumber) {
        try {
            window.open(`/Certificate/Download/${certificateNumber}`, '_blank');
            console.log('Certificate download started');
        } catch (error) {
            console.error('Error downloading certificate:', error);
        }
    };

    // Image zoom functionality
    function openImageZoom(imageSrc) {
        const modal = document.getElementById('imageZoomModal');
        const modalImg = document.getElementById('zoomedImage');
        const caption = document.getElementById('imageCaption');

        modal.style.display = 'block';
        modalImg.src = imageSrc;
        caption.innerHTML = 'Certificate @GetFormattedCertificateNumber() - Click anywhere to close';

        // Prevent body scroll when modal is open
        document.body.style.overflow = 'hidden';
    }

    function closeImageZoom() {
        const modal = document.getElementById('imageZoomModal');
        modal.style.display = 'none';

        // Restore body scroll
        document.body.style.overflow = 'auto';
    }

    // Close on ESC key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeImageZoom();
        }
    });
</script>