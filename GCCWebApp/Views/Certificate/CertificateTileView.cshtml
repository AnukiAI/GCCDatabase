@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/certificatetileview.css" asp-append-version="true" />

<!-- Main Container -->
<div class="main-container">
    <!-- Show Filters button (visible when sidebar collapsed) -->
    <button class="sidebar-toggle-tab" id="sidebarToggleTab" aria-label="Show filters" aria-controls="filterSidebar" aria-expanded="false">
        <span>Show Filters</span>
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
    </button>

    <!-- Sidebar (Filters) -->
    <aside id="filterSidebar" class="sidebar" role="complementary" aria-label="Certificate filters">
        <!-- Hide Filters button - desktop only, matches internal/external views -->
        <button class="sidebar-collapse-btn" id="sidebarCollapseBtn" aria-label="Hide filters" aria-expanded="true">
            <span>Hide Filters</span>
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>

        <button class="mobile-filter-toggle" id="mobileFilterToggle">
            <span>Show Filters & Search</span>
            <i class="fas fa-chevron-down"></i>
        </button>

        <!-- Search Bar -->
        <div class="search-bar">
            <label for="searchInput" class="admin-sr-only">Search certificates</label>
            <i class="fas fa-search search-icon" aria-hidden="true"></i>
            <input type="text" id="searchInput" class="search-input" placeholder="Search" aria-label="Search certificates by company, product, or certification type">
            <!-- Autocomplete dropdown will be created dynamically by JavaScript -->
        </div>

        <div class="filters-header">
            <h3 class="filters-title">Filters</h3>
            <a href="#" class="clear-filters">Clear Filters</a>
        </div>

        <!-- Certification Type Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="cert-type" aria-expanded="true" aria-controls="cert-type-content">
                <span>Certification Type</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="cert-type-content">
                <legend class="admin-sr-only">Filter by certification type</legend>
                <ul class="filter-tree">
                    <!-- Skeleton placeholders replaced when data loads -->
                    <!-- Populated by JS -->
                </ul>
            </fieldset>
        </div>

        <!-- Product Categories Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="product-cat" aria-expanded="true" aria-controls="product-cat-content">
                <span>Product Categories</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="product-cat-content">
                <legend class="admin-sr-only">Filter by product category</legend>
                <ul class="filter-tree">
                    <!-- Populated by JS -->
                </ul>
            </fieldset>
        </div>

        <!-- Company Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="company" aria-expanded="true" aria-controls="company-content">
                <span>Company</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="company-content">
                <legend class="admin-sr-only">Filter by company</legend>
                <ul class="filter-tree">
                    <!-- Populated by JS -->
                    </ul>
            </fieldset>
        </div>

        <!-- Countries Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="countries" aria-expanded="true" aria-controls="countries-content">
                <span>Countries</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="countries-content">
                <legend class="admin-sr-only">Filter by country</legend>
                <ul class="filter-tree">
                    <!-- Populated by JS -->
                    </ul>
            </fieldset>
        </div>

        <!-- Additional Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="additional" aria-expanded="true" aria-controls="additional-content">
                <span>Additional</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="additional-content">
                <legend class="admin-sr-only">Filter by additional tags</legend>
                <ul class="filter-tree">
                    <!-- Populated by JS -->
                    </ul>
            </fieldset>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="tile-view-content">
        <!-- Screen reader announcements for dynamic updates -->
        <div class="sr-only" aria-live="polite" aria-atomic="true" id="searchAnnouncement"></div>
        <!-- Active filter tags -->
        <div class="active-filter-tags" id="activeFilterTags" aria-label="Active filters" role="list"></div>

        <div class="results-header">
            <div class="results-count" id="resultsCount" aria-live="polite" aria-atomic="true">Loading…</div>
            <div class="results-actions">
                <div class="sort-controls">
                    <label for="sortDropdownBtn" class="sort-label" id="sortByLabel">Sort By</label>
                    <div class="sort-dropdown" id="sortDropdown">
                    <button class="sort-dropdown-button" id="sortDropdownBtn" aria-expanded="false" aria-haspopup="listbox" aria-controls="sortContent" aria-label="Sort certificates. Current sort: Default">
                        <span id="sortLabel">Default</span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="sort-dropdown-content" id="sortContent" role="listbox" aria-label="Sort options">
                        <!-- Certificate Information -->
                        <div class="sort-group-header" role="presentation">By Certificate</div>
                        <div class="sort-option" data-sort="cert-number-newest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Newest)
                        </div>
                        <div class="sort-option" data-sort="cert-number-oldest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Oldest)
                        </div>
                        <div class="sort-option" data-sort="cert-type" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type A-Z
                        </div>
                        <div class="sort-option" data-sort="cert-type-za" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type Z-A
                        </div>

                        <!-- Alphabetical sorting -->
                        <div class="sort-group-header" role="presentation">Alphabetical</div>
                        <div class="sort-option" data-sort="company-az" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company A-Z
                        </div>
                        <div class="sort-option" data-sort="company-za" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company Z-A
                        </div>
                        <div class="sort-option" data-sort="product-az" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name A-Z
                        </div>
                        <div class="sort-option" data-sort="product-za" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name Z-A
                        </div>
                        <!-- Location sorting -->
                        <div class="sort-group-header" role="presentation">By Location</div>
                        <div class="sort-option" data-sort="location-az" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location A-Z
                        </div>
                        <div class="sort-option" data-sort="location-za" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location Z-A
                        </div>
                        <div class="sort-option" data-sort="country" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country A-Z
                        </div>
                        <div class="sort-option" data-sort="country-za" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country Z-A
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>

        <div class="certificates-grid" id="certificatesGrid">
            <!-- Simple loading state — replaced by JS once certificates arrive -->
            <div id="initialLoadingState" style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #6c757d;">
                <i class="fas fa-spinner fa-spin" style="font-size: 28px; color: #00AEEF; margin-bottom: 12px; display: block;"></i>
                <span style="font-size: 16px;">Loading certificates...</span>
            </div>
            <div class="end-of-results" id="endOfResults" style="display: none;">
                <div class="end-message">
                    <i class="fas fa-check-circle"></i>
                    <span>You've reached the end of the results</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/certificate-tile-view.js" asp-append-version="true"></script>