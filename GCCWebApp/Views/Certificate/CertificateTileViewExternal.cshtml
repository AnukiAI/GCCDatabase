@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/certificatetileview.css?v=20260316" />
<link rel="stylesheet" href="~/css/pages/certificate-tile-external.css?v=20260316" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Main Container -->
<div class="main-container" style="width: 100%;">
    <!-- Sidebar Toggle Tab (visible when sidebar is collapsed) -->
    <button class="sidebar-toggle-tab" id="sidebarToggleTab" aria-label="Show filters" aria-controls="sidebar">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
    </button>

    <!-- Sidebar (Filters) -->
    <aside id="sidebar" class="sidebar" role="complementary" aria-label="Certificate filters">
        <!-- Hide Filters button - matches mobile toggle style -->
        <button class="sidebar-collapse-btn" id="sidebarCollapseBtn" aria-label="Hide filters" aria-expanded="true">
            <span>Hide Filters</span>
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>

        <button class="mobile-filter-toggle" id="mobileFilterToggle">
            <span>Show Filters & Search</span>
            <i class="fas fa-chevron-down"></i>
        </button>

        <!-- Search Bar -->
        <div class="search-bar">
            <label for="certificate-search" class="admin-sr-only">Search certificates</label>
            <i class="fas fa-search search-icon" aria-hidden="true"></i>
            <input type="text" id="certificate-search" class="search-input" placeholder="Search" aria-label="Search certificates by company, product, or certification type">
        </div>

        <div class="filters-header">
            <h3 class="filters-title">Filters</h3>
            <a href="#" class="clear-filters">Clear Filters</a>
        </div>

        <!-- Certification Type Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="cert-type" aria-expanded="true" aria-controls="cert-type-content">
                <span>Certification Type</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="cert-type-content">
                <legend class="admin-sr-only">Filter by certification type</legend>
                <ul class="filter-tree" role="group">
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:85%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:70%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:90%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:60%"></span></li>
                </ul>
            </fieldset>
        </div>

        <!-- Product Categories Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="product-cat" aria-expanded="true" aria-controls="product-cat-content">
                <span>Product Categories</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="product-cat-content">
                <legend class="admin-sr-only">Filter by product category</legend>
                <ul class="filter-tree" role="group">
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:75%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:90%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:65%"></span></li>
                </ul>
            </fieldset>
        </div>

        <!-- Company Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="company" aria-expanded="true" aria-controls="company-content">
                <span>Company</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="company-content">
                <legend class="admin-sr-only">Filter by company</legend>
                <ul class="filter-tree" role="group">
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:80%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:70%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:85%"></span></li>
                </ul>
            </fieldset>
        </div>

        <!-- Countries Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="countries" aria-expanded="true" aria-controls="countries-content">
                <span>Countries</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="countries-content">
                <legend class="admin-sr-only">Filter by country</legend>
                <ul class="filter-tree" role="group">
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:65%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:80%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:55%"></span></li>
                </ul>
            </fieldset>
        </div>

        <!-- Additional Filter -->
        <div class="filter-panel">
            <button class="filter-header" data-filter="additional" aria-expanded="true" aria-controls="additional-content">
                <span>Additional</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <fieldset class="filter-content" id="additional-content">
                <legend class="admin-sr-only">Filter by additional tags</legend>
                <ul class="filter-tree" role="group">
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:70%"></span></li>
                    <li class="filter-item skeleton-filter-item"><span class="skeleton-checkbox"></span><span class="skeleton-line" style="width:85%"></span></li>
                </ul>
            </fieldset>
        </div>
    </aside>
    <!-- Main Content Area -->
    <div class="tile-view-content">
        <!-- Active filter tags -->
        <div class="active-filter-tags" id="activeFilterTags" aria-label="Active filters" role="list"></div>
        <div class="results-header">
            <div class="results-count" id="resultsCount">15 Results</div>


            <div class="sort-controls">
                <label for="sortDropdownButton" class="sort-label" id="sortByLabel">Sort By</label>
                <div class="sort-dropdown" id="sortDropdown">
                    <button id="sortDropdownButton" class="sort-dropdown-button" aria-expanded="false" aria-haspopup="listbox" aria-controls="sortContent" aria-label="Sort certificates. Current sort: Default">
                        <span id="sortLabel">Default</span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="sort-dropdown-content" id="sortContent" role="listbox" aria-label="Sort options">
                        <!-- Date-based sorting -->
                        <div class="sort-group-header" role="presentation">By Date</div>
                        <div class="sort-option" data-sort="newest" role="option">
                            <i class="fas fa-calendar-plus" aria-hidden="true"></i>
                            Newest Effective Date
                        </div>
                        <div class="sort-option" data-sort="oldest-effective" role="option">
                            <i class="fas fa-calendar-minus" aria-hidden="true"></i>
                            Oldest Effective Date
                        </div>
                        <div class="sort-option" data-sort="longest-validity" role="option">
                            <i class="fas fa-hourglass-end" aria-hidden="true"></i>
                            Longest Validity Period
                        </div>
                        <div class="sort-option" data-sort="recently-issued" role="option">
                            <i class="fas fa-calendar-check" aria-hidden="true"></i>
                            Recently Issued (Last 30 Days)
                        </div>

                        <!-- Certificate Information -->
                        <div class="sort-group-header" role="presentation">By Certificate</div>
                        <div class="sort-option" data-sort="cert-number-newest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Newest)
                        </div>
                        <div class="sort-option" data-sort="cert-number-oldest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Oldest)
                        </div>
                        <div class="sort-option" data-sort="cert-type" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type A-Z
                        </div>
                        <div class="sort-option" data-sort="cert-type-za" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type Z-A
                        </div>

                        <!-- Alphabetical sorting -->
                        <div class="sort-group-header" role="presentation">Alphabetical</div>
                        <div class="sort-option" data-sort="company-az" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company A-Z
                        </div>
                        <div class="sort-option" data-sort="company-za" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company Z-A
                        </div>
                        <div class="sort-option" data-sort="product-az" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name A-Z
                        </div>
                        <div class="sort-option" data-sort="product-za" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name Z-A
                        </div>

                        <!-- Location sorting -->
                        <div class="sort-group-header" role="presentation">By Location</div>
                        <div class="sort-option" data-sort="location-az" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location A-Z
                        </div>
                        <div class="sort-option" data-sort="location-za" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location Z-A
                        </div>
                        <div class="sort-option" data-sort="country" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country A-Z
                        </div>
                        <div class="sort-option" data-sort="country-za" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country Z-A
                        </div>

                        <!-- Advanced sorting -->
                        <div class="sort-group-header" role="presentation">Advanced</div>
                        <div class="sort-option" data-sort="popularity" role="option">
                            <i class="fas fa-star" aria-hidden="true"></i>
                            Most Popular Companies
                        </div>
                        <div class="sort-option" data-sort="product-type" role="option">
                            <i class="fas fa-boxes" aria-hidden="true"></i>
                            Product Type A-Z
                        </div>
                        <div class="sort-option" data-sort="relevance" role="option">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            Relevance Score
                        </div>
                        <div class="sort-option" data-sort="status" role="option">
                            <i class="fas fa-check-circle" aria-hidden="true"></i>
                            Status
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- After results-header div -->
        <div class="results-controls">
            <div class="left-controls">
                <div class="export-options">
                    <!-- Add Certificate button removed for External users -->
                    <button class="btn btn-primary" id="downloadSelectedBtn" disabled title="Select certificates in table view to download" aria-label="Download selected certificates. Currently disabled - select certificates first.">
                        <i class="fas fa-download" aria-hidden="true"></i> Download Selected
                    </button>
                    <button class="btn btn-primary" id="exportAllBtn" aria-label="Export all visible certificates to Excel file">
                        <i class="fas fa-file-excel" aria-hidden="true"></i> Export All to Excel
                    </button>
                </div>
            </div>

            <div class="right-controls">
                <div class="view-toggle-container">
                    <div class="view-toggle" role="group" aria-label="View mode">
                        <button class="toggle-btn active" data-view="tile" aria-pressed="true" aria-label="Tile view">
                            <i class="fas fa-th" aria-hidden="true"></i> Tile
                        </button>
                        <button class="toggle-btn" data-view="list" aria-pressed="false" aria-label="List view">
                            <i class="fas fa-list" aria-hidden="true"></i> List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="certificates-grid" id="certificatesGrid">
            <div id="initialLoadingState" style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #6c757d;">
                <i class="fas fa-spinner fa-spin" style="font-size: 28px; color: #00AEEF; margin-bottom: 12px; display: block;"></i>
                <span style="font-size: 16px;">Loading certificates...</span>
            </div>
        </div>

        <!-- LOADING INDICATOR FOR LAZY LOADING -->
        <div id="loadingIndicator" class="loading-indicator" role="status" aria-live="polite" aria-atomic="true" aria-busy="false">
            <div class="loading-spinner" aria-hidden="true"></div>
            <div class="loading-text">Loading more certificates...</div>
        </div>

        <!-- Skip to footer link for infinite scroll accessibility -->
        <a href="#footer" class="skip-to-footer admin-sr-only" tabindex="0">Skip to footer</a>

        <!-- TABLE VIEW CONTAINER -->
        <div id="tableView" class="view-container" style="display: none;">
            <!-- Bulk Actions Bar -->
            <div class="bulk-actions-bar" style="display: none;" id="bulkActionsBar" role="region" aria-label="Bulk actions">
                <div class="bulk-actions-left">
                    <span class="selected-count" id="selectedCount" aria-live="polite" aria-atomic="true">0 certificates selected</span>
                    <button class="clear-selection-btn" data-action="clear-selection" aria-label="Clear all selections">Clear Selection</button>
                </div>
            </div>

            <!-- STICKY BLOCK: Toolbar + Scrollbar + Headers (no column toggle for external) -->
            <div class="sticky-table-block" id="stickyTableBlock">
                <!-- Toolbar Row -->
                <div class="table-toolbar-row">
                    <div class="table-toolbar-left">
                        <span id="tableResultsCount">Showing <strong>0</strong> certificates</span>
                    </div>
                </div>

                <!-- Sticky Scrollbar -->
                <div class="sticky-scrollbar-row" id="stickyScrollbar">
                    <div class="scrollbar-sizer" id="scrollbarSizer"></div>
                </div>

                <!-- Sticky Column Headers -->
                <div class="sticky-header-row" id="stickyHeaderRow">
                    <div class="sticky-header-inner" id="stickyHeaderInner">
                        <div class="sticky-header-cell tc-select"><input type="checkbox" id="selectAll" title="Select all visible rows" aria-label="Select all certificates"></div>
                        <div class="sticky-header-cell tc-actions">Actions</div>
                        <div class="sticky-header-cell tc-cert" data-sort-column="certificate">Certificate # <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-type" data-sort-column="certificationType">Certification Type <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-status" data-sort-column="status">Status <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-eff" data-sort-column="effectiveDate">Effective Date <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-exp" data-sort-column="expirationDate">Expiration Date <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-company" data-sort-column="company">Company <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-contact" data-sort-column="companyContact">Contact <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-product" data-sort-column="productName">Product Name <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-prodcat" data-sort-column="productCategory">Product Category <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-prodtype" data-sort-column="productType">Product Type <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-prodsub" data-sort-column="productSubcategory">Subcategory <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-location" data-sort-column="location">Location <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-country" data-sort-column="country">Country <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-exttag" data-sort-column="externalTag">External Tag <span class="sort-icon">▼</span></div>
                        <!-- Internal Tag column omitted for External users -->
                        <div class="sticky-header-cell tc-partner" data-sort-column="partner">Partner <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-asin" data-sort-column="asin">ASIN <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-upc" data-sort-column="upc">UPC <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-gtin" data-sort-column="gtin">GTIN <span class="sort-icon">▼</span></div>
                        <div class="sticky-header-cell tc-ean" data-sort-column="ean">EAN <span class="sort-icon">▼</span></div>
                    </div>
                </div>
            </div>

            <!-- Table Body (scrollable, native bottom scrollbar hidden) -->
            <div class="table-body-wrap" id="tableBodyWrap">
                <div class="table-body-inner" id="gridBody" role="table" aria-label="Certificates data table">
                    <!-- Rows rendered by JS -->
                </div>
            </div>
        </div>


        <!-- Modern External View Scripts -->
        <script src="~/js/certificateExternalService.js?v=20260316"></script>
        <script src="~/js/certificateTileViewExternal.js?v=20260316"></script>
        <script>
            // Initialize the Certificate Tile View External
            document.addEventListener('DOMContentLoaded', () => {
                window.certificateTileViewExternal = new CertificateTileViewExternal();
                console.log('CertificateTileViewExternal initialized successfully');
            });
        </script>
    </div>
</div>
