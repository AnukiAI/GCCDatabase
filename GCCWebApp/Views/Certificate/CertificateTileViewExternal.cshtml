@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs {
    <span class="role-element role-external-show role-analyst-show role-admin-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificates</span>
    </span>
}
<link rel="stylesheet" href="~/css/certificatetileview.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    /* ====================================================
       EXTERNAL VIEW SPECIFIC STYLES
       Grid layout: 20 columns (NO Internal Tag column)
       Action buttons: Download + View only (NO Edit)
       ====================================================*/

    /* Fix product name width for external view */
    .certificate-card .product-name {
        max-width: 100% !important;
        width: 100% !important;
        word-wrap: break-word !important;
        word-break: break-word !important;
        white-space: normal !important;
    }

    /* Grid layout for table - External view (NO Internal Tag column, 2 action buttons) */
    .table-grid {
        display: grid;
        grid-template-columns:
            40px      /* Select checkbox */
            160px     /* Actions (Download + View) */
            120px     /* Certificate # */
            180px     /* Certification Type */
            150px     /* CSF Attributes */
            80px      /* Status */
            110px     /* Effective Date */
            110px     /* Expiration Date */
            200px     /* Company */
            200px     /* Company Contact */
            180px     /* Product Name */
            150px     /* Product Category */
            150px     /* Product Type */
            170px     /* Product Subcategory */
            120px     /* Location */
            100px     /* Country */
            120px     /* External Tag */
            100px     /* ASIN */
            100px     /* UPC */
            100px     /* GTIN */
            100px;    /* EAN */
        min-width: max-content;
        width: 100%;
    }

    /* Loading spinner animation specific to this view */
    .loading-spinner {
        width: 24px;
        height: 24px;
        border: 3px solid #f3f3f3;
        border-top: 3px solid #007bff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-right: 12px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* ====================================================
       TABLE SCROLL FIX - Ensure all columns are visible
       ====================================================*/

    /* Override base CSS max-width constraint to allow full table scroll */
    .table-scroll-wrapper {
        max-width: none !important;
        width: 100% !important;
        overflow-x: scroll !important;
        overflow-y: visible;
        display: block !important;
    }

    /* Ensure the table grid container doesn't collapse */
    .table-grid-container {
        min-width: 2400px;
        width: max-content;
        display: block !important;
    }

    /* Table grid must maintain full width */
    .table-grid {
        width: max-content !important;
        min-width: 2400px !important;
    }

    /* Ensure main content allows table to expand and scroll */
    .main-content {
        overflow-x: auto !important;
        min-width: 0;
        flex: 1;
    }

    /* Table view container needs proper overflow */
    #tableView {
        overflow-x: auto !important;
        width: 100%;
    }

    /* ====================================================
       WIDER LAYOUT FOR TABLE VIEW ONLY
       Tiles remain at standard width
       ====================================================*/

    /* Only expand when table view is active */
    body.table-view-active .main-container {
        max-width: 1800px !important;
    }

    /* ====================================================
       COLLAPSIBLE SIDEBAR - MATCHING INTERNAL VIEW
       ====================================================*/

    /* Show Filters button - visible when sidebar collapsed, narrow strip */
    .sidebar-toggle-tab {
        display: none;
        width: 44px;
        min-width: 44px;
        height: 100%;
        padding: 0;
        margin: 0;
        background: var(--blue-primary, #00AEEF);
        color: var(--white, #fff);
        border: none;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: var(--transition-fast, 0.15s ease);
    }

    .sidebar-toggle-tab:hover {
        background: var(--blue-dark, #002876);
    }

    .sidebar-toggle-tab i {
        color: var(--white, #fff);
        font-size: 16px;
    }

    .sidebar-toggle-tab span {
        display: none;
    }

    .sidebar-toggle-tab.visible {
        display: flex;
    }

    /* Hide Filters button - inside sidebar, full width */
    .sidebar-collapse-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 10px 16px;
        margin-bottom: 15px;
        background: var(--blue-primary, #00AEEF);
        color: var(--white, #fff);
        border: none;
        border-radius: var(--border-radius-sm, 4px);
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: var(--transition-fast, 0.15s ease);
    }

    .sidebar-collapse-btn:hover {
        background: var(--blue-dark, #002876);
    }

    .sidebar-collapse-btn i {
        margin-left: 10px;
        transition: transform 0.3s ease;
        font-size: 14px;
    }

    /* Sidebar collapsed state */
    .sidebar.collapsed {
        display: none !important;
    }

    /* Main container adjustments when sidebar collapsed */
    .main-container.sidebar-collapsed {
        max-width: 100% !important;
    }

    .main-container.sidebar-collapsed .main-content {
        max-width: 100%;
    }

    .main-container.sidebar-collapsed .table-scroll-wrapper {
        max-width: calc(100vw - 50px) !important;
    }

    /* ====================================================
       BULK ACTIONS BAR AND TABLE STYLING
       ====================================================*/

    /* Compact bulk actions bar */
    #tableView .bulk-actions-bar {
        padding: 4px 10px !important;
        margin-bottom: 8px !important;
        gap: 8px;
    }

    #tableView .bulk-actions-left {
        gap: 8px !important;
    }

    #tableView .selected-count {
        font-size: 14px !important;
    }

    #tableView .clear-selection-btn {
        padding: 4px 10px !important;
        font-size: 14px !important;
    }

    /* Improved Actions column alignment */
    .grid-header-cell.actions-column,
    .grid-cell.actions-column {
        min-width: 160px !important;
        width: 160px !important;
        justify-content: center !important;
        text-align: center;
    }

    .grid-cell.actions-column .action-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        width: 100%;
    }

    .grid-cell.actions-column .action-btn {
        margin: 0;
        padding: 4px 6px;
        min-width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* ====================================================
       REDUCE SPACING BETWEEN BUTTONS AND TABLE
       ====================================================*/
    .main-content .results-header {
        margin-bottom: 8px !important;
        padding-top: 5px !important;
        padding-bottom: 0 !important;
    }

    .main-content .results-controls {
        margin-bottom: 8px !important;
        margin-top: 0 !important;
        padding: 0 !important;
    }

    .main-content {
        padding: 10px 15px 15px 15px !important;
    }

    /* Remove any extra space before tableView */
    #tableView {
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    /* Remove extra space on certificates grid too */
    .certificates-grid {
        margin-top: 0 !important;
    }

    /* Fix loading indicator - hide completely when not active */
    .loading-indicator {
        display: none !important;
        padding: 10px !important;
    }

    .loading-indicator.active {
        display: flex !important;
    }
</style>
<!-- Main Container -->
<div class="main-container" style="width: 100%;">
    <!-- Sidebar Toggle Tab (visible when sidebar is collapsed) -->
    <button class="sidebar-toggle-tab" id="sidebarToggleTab">
        <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Sidebar (Filters) -->
    <div class="sidebar">
        <!-- Hide Filters button - matches mobile toggle style -->
        <button class="sidebar-collapse-btn" id="sidebarCollapseBtn">
            <span>Hide Filters</span>
            <i class="fas fa-chevron-left"></i>
        </button>

        <button class="mobile-filter-toggle" style="display: none;">
            <span>Show Filters & Search</span>
            <i class="fas fa-chevron-down"></i>
        </button>

        <!-- Search Bar -->
        <div class="search-bar">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search...">
        </div>

        <div class="filters-header">
            <h3 class="filters-title">Filters</h3>
            <a href="#" class="clear-filters">Clear Filters</a>
        </div>

        <!-- Certification Type Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="cert-type">
                <span>Certification Type</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="cert-type-content">
                <ul class="filter-tree">
                    <!-- Certification types will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading certification types...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Product Categories Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="product-cat">
                <span>Product Categories</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="product-cat-content">
                <ul class="filter-tree">
                    <!-- Product categories will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading categories...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Company Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="company">
                <span>Company</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="company-content">
                <ul class="filter-tree">
                    <!-- Companies will be dynamically populated from the database via JavaScript (only companies with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading companies...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Countries Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="countries">
                <span>Countries</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="countries-content">
                <ul class="filter-tree">
                    <!-- Countries will be dynamically populated from the database via JavaScript (only countries with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading countries...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Additional Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="additional">
                <span>Additional</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="additional-content">
                <ul class="filter-tree">
                    <!-- Additional tags will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading additional tags...</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!-- Main Content Area -->
    <div class="main-content">
        <div class="results-header">
            <div class="results-count" id="resultsCount">15 Results</div>


            <div class="sort-controls">
                <span class="sort-label">Sort By</span>
                <div class="sort-dropdown" id="sortDropdown">
                    <button class="sort-dropdown-button">
                        <span id="sortLabel">Default</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="sort-dropdown-content" id="sortContent">
                        <!-- Date-based sorting -->
                        <div class="sort-group-header">By Date</div>
                        <div class="sort-option" data-sort="newest">
                            <i class="fas fa-calendar-plus"></i>
                            Newest Effective Date
                        </div>
                        <div class="sort-option" data-sort="oldest-effective">
                            <i class="fas fa-calendar-minus"></i>
                            Oldest Effective Date
                        </div>
                        <div class="sort-option" data-sort="expiring">
                            <i class="fas fa-clock"></i>
                            Expiring Soon
                        </div>
                        <div class="sort-option" data-sort="longest-validity">
                            <i class="fas fa-hourglass-end"></i>
                            Longest Validity Period
                        </div>
                        <div class="sort-option" data-sort="recently-issued">
                            <i class="fas fa-calendar-check"></i>
                            Recently Issued (Last 30 Days)
                        </div>

                        <!-- Certificate Information -->
                        <div class="sort-group-header">By Certificate</div>
                        <div class="sort-option" data-sort="cert-number-newest">
                            <i class="fas fa-certificate"></i>
                            Certificate Number (Newest)
                        </div>
                        <div class="sort-option" data-sort="cert-number-oldest">
                            <i class="fas fa-certificate"></i>
                            Certificate Number (Oldest)
                        </div>
                        <div class="sort-option" data-sort="cert-type">
                            <i class="fas fa-award"></i>
                            Certification Type A-Z
                        </div>
                        <div class="sort-option" data-sort="cert-type-za">
                            <i class="fas fa-award"></i>
                            Certification Type Z-A
                        </div>

                        <!-- Alphabetical sorting -->
                        <div class="sort-group-header">Alphabetical</div>
                        <div class="sort-option" data-sort="company-az">
                            <i class="fas fa-building"></i>
                            Company A-Z
                        </div>
                        <div class="sort-option" data-sort="company-za">
                            <i class="fas fa-building"></i>
                            Company Z-A
                        </div>
                        <div class="sort-option" data-sort="product-az">
                            <i class="fas fa-tag"></i>
                            Product Name A-Z
                        </div>
                        <div class="sort-option" data-sort="product-za">
                            <i class="fas fa-tag"></i>
                            Product Name Z-A
                        </div>

                        <!-- Location sorting -->
                        <div class="sort-group-header">By Location</div>
                        <div class="sort-option" data-sort="location-az">
                            <i class="fas fa-map-marker-alt"></i>
                            Location A-Z
                        </div>
                        <div class="sort-option" data-sort="location-za">
                            <i class="fas fa-map-marker-alt"></i>
                            Location Z-A
                        </div>
                        <div class="sort-option" data-sort="country">
                            <i class="fas fa-globe"></i>
                            Country A-Z
                        </div>
                        <div class="sort-option" data-sort="country-za">
                            <i class="fas fa-globe"></i>
                            Country Z-A
                        </div>

                        <!-- Advanced sorting -->
                        <div class="sort-group-header">Advanced</div>
                        <div class="sort-option" data-sort="popularity">
                            <i class="fas fa-star"></i>
                            Most Popular Companies
                        </div>
                        <div class="sort-option" data-sort="product-type">
                            <i class="fas fa-boxes"></i>
                            Product Type A-Z
                        </div>
                        <div class="sort-option" data-sort="relevance">
                            <i class="fas fa-search"></i>
                            Relevance Score
                        </div>
                        <div class="sort-option" data-sort="status">
                            <i class="fas fa-check-circle"></i>
                            Status
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- After results-header div -->
        <div class="results-controls">
            <div class="left-controls">
                <div class="export-options">
                    <!-- Add Certificate button removed for External users -->
                    <button class="btn btn-primary" id="downloadSelectedBtn" disabled title="Select certificates in table view to download">
                        <i class="fas fa-download"></i> Download Selected
                    </button>
                    <button class="btn btn-primary" id="exportAllBtn">
                        <i class="fas fa-file-excel"></i> Export All to Excel
                    </button>
                </div>
            </div>

            <div class="right-controls">
                <div class="view-toggle-container">
                    <div class="view-toggle">
                        <button class="toggle-btn active" data-view="tile">
                            <i class="fas fa-th"></i> Tile
                        </button>
                        <button class="toggle-btn" data-view="list">
                            <i class="fas fa-list"></i> List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="certificates-grid" id="certificatesGrid">
            <!-- Certificates will be loaded dynamically by JavaScript -->
        </div>

        <!-- LOADING INDICATOR FOR LAZY LOADING -->
        <div id="loadingIndicator" class="loading-indicator">
            <div class="loading-spinner"></div>
            <div class="loading-text">Loading more certificates...</div>
        </div>

        <!-- TABLE VIEW CONTAINER -->
        <div id="tableView" class="view-container" style="display: none;">
            <!-- Bulk Actions Bar - Compact Selection Info Only -->
            <div class="bulk-actions-bar" style="display: none;" id="bulkActionsBar">
                <div class="bulk-actions-left">
                    <span class="selected-count" id="selectedCount">0 certificates selected</span>
                    <button class="clear-selection-btn" data-action="clear-selection">Clear Selection</button>
                </div>
            </div>

            <!-- Table Grid Container -->
            <div class="table-scroll-wrapper">
                <div class="table-grid-container">
                    <div class="table-grid" id="certificateGrid">

                        <!-- HEADER ROW -->
                        <div class="grid-header">
                            <div class="grid-header-cell select-cell">
                                <input type="checkbox" id="selectAll" title="Select all visible rows">
                            </div>
                            <div class="grid-header-cell actions-column" style="min-width: 160px;">
                                Actions
                            </div>
                            <div class="grid-header-cell" data-sort-column="certificate">
                                Certificate #
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="certificationType">
                                Certification Type
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="csfAttributes">
                                CSF Attributes
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="status">
                                Status
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="effectiveDate">
                                Effective Date
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="expirationDate">
                                Expiration Date
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="company">
                                Company
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="companyContact">
                                Company Contact Email/URL
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productName">
                                Product Name
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productCategory">
                                Product Category
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productType">
                                Product Type
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productSubcategory">
                                Product Type Subcategory
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="location">
                                Location
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="country">
                                Country
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="externalTag">
                                External Tag
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <!-- Internal Tag column omitted for External users -->
                            <div class="grid-header-cell" data-sort-column="asin">
                                ASIN
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="upc">
                                UPC
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="gtin">
                                GTIN
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="ean">
                                EAN
                                <i class="fas fa-sort sort-indicator"></i>
                            </div>
                        </div>

                        <!-- BODY CONTAINER -->
                        <div class="grid-body" id="gridBody">
                            <!-- Grid rows will be populated here - equivalent to tableBody -->
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Modern External View Scripts -->
        <script src="~/js/certificateExternalService.js"></script>
        <script src="~/js/certificateTileViewExternal.js"></script>
        <script>
            // Initialize the Certificate Tile View External
            document.addEventListener('DOMContentLoaded', () => {
                window.certificateTileViewExternal = new CertificateTileViewExternal();
                console.log('CertificateTileViewExternal initialized successfully');
            });
        </script>
    </div>
</div>
