@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/certificatetileview.css" />
<link rel="stylesheet" href="~/css/pages/certificate-tile-internal.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Main Container -->
<div class="main-container" style="width: 100%;">
    <!-- Show Filters button (visible when sidebar collapsed) -->
    <button class="sidebar-toggle-tab" id="sidebarToggleTab">
        <span>Show Filters</span>
        <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Sidebar (Filters) -->
    <div class="sidebar" id="filterSidebar">
        <!-- Hide Filters button - matches mobile toggle style -->
        <button class="sidebar-collapse-btn" id="sidebarCollapseBtn">
            <span>Hide Filters</span>
            <i class="fas fa-chevron-left"></i>
        </button>

        <button class="mobile-filter-toggle" style="display: none;">
            <span>Show Filters & Search</span>
            <i class="fas fa-chevron-down"></i>
        </button>

        <!-- Search Bar -->
        <div class="search-bar">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search">
        </div>

        <div class="filters-header">
            <h3 class="filters-title">Filters</h3>
            <a href="#" class="clear-filters">Clear Filters</a>
        </div>

        <!-- Certification Type Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="cert-type">
                <span>Certification Type</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="cert-type-content">
                <ul class="filter-tree">
                    <!-- Certification types will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading certification types...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Product Categories Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="product-cat">
                <span>Product Categories</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="product-cat-content">
                <ul class="filter-tree">
                    <!-- Product categories will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading categories...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Company Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="company">
                <span>Company</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="company-content">
                <ul class="filter-tree">
                    <!-- Companies will be dynamically populated from the database via JavaScript (only companies with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading companies...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Countries Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="countries">
                <span>Countries</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="countries-content">
                <ul class="filter-tree">
                    <!-- Countries will be dynamically populated from the database via JavaScript (only countries with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading countries...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Additional Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="additional">
                <span>Additional</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="additional-content">
                <ul class="filter-tree">
                    <!-- Additional tags will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading additional tags...</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!-- Main Content Area -->
    <div class="main-content">
        <div class="results-header">
            <div class="results-count" id="resultsCount">15 Results</div>


            <div class="sort-controls">
                <span class="sort-label" id="sortByLabel">Sort By</span>
                <div class="sort-dropdown" id="sortDropdown">
                    <button class="sort-dropdown-button" aria-expanded="false" aria-haspopup="listbox" aria-controls="sortContent" aria-labelledby="sortByLabel sortLabel">
                        <span id="sortLabel">Default</span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="sort-dropdown-content" id="sortContent" role="listbox" aria-label="Sort options">
                        <!-- Date-based sorting -->
                        <div class="sort-group-header" role="presentation">By Date</div>
                        <div class="sort-option" data-sort="newest" role="option">
                            <i class="fas fa-calendar-plus" aria-hidden="true"></i>
                            Newest Effective Date
                        </div>
                        <div class="sort-option" data-sort="oldest-effective" role="option">
                            <i class="fas fa-calendar-minus" aria-hidden="true"></i>
                            Oldest Effective Date
                        </div>
                        <div class="sort-option" data-sort="expiring" role="option">
                            <i class="fas fa-clock" aria-hidden="true"></i>
                            Expiring Soon
                        </div>
                        <div class="sort-option" data-sort="longest-validity" role="option">
                            <i class="fas fa-hourglass-end" aria-hidden="true"></i>
                            Longest Validity Period
                        </div>
                        <div class="sort-option" data-sort="recently-issued" role="option">
                            <i class="fas fa-calendar-check" aria-hidden="true"></i>
                            Recently Issued (Last 30 Days)
                        </div>

                        <!-- Certificate Information -->
                        <div class="sort-group-header" role="presentation">By Certificate</div>
                        <div class="sort-option" data-sort="cert-number-newest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Newest)
                        </div>
                        <div class="sort-option" data-sort="cert-number-oldest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Oldest)
                        </div>
                        <div class="sort-option" data-sort="cert-type" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type A-Z
                        </div>
                        <div class="sort-option" data-sort="cert-type-za" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type Z-A
                        </div>

                        <!-- Alphabetical sorting -->
                        <div class="sort-group-header" role="presentation">Alphabetical</div>
                        <div class="sort-option" data-sort="company-az" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company A-Z
                        </div>
                        <div class="sort-option" data-sort="company-za" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company Z-A
                        </div>
                        <div class="sort-option" data-sort="product-az" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name A-Z
                        </div>
                        <div class="sort-option" data-sort="product-za" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name Z-A
                        </div>

                        <!-- Location sorting -->
                        <div class="sort-group-header" role="presentation">By Location</div>
                        <div class="sort-option" data-sort="location-az" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location A-Z
                        </div>
                        <div class="sort-option" data-sort="location-za" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location Z-A
                        </div>
                        <div class="sort-option" data-sort="country" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country A-Z
                        </div>
                        <div class="sort-option" data-sort="country-za" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country Z-A
                        </div>

                        <!-- Advanced sorting -->
                        <div class="sort-group-header" role="presentation">Advanced</div>
                        <div class="sort-option" data-sort="popularity" role="option">
                            <i class="fas fa-star" aria-hidden="true"></i>
                            Most Popular Companies
                        </div>
                        <div class="sort-option" data-sort="product-type" role="option">
                            <i class="fas fa-boxes" aria-hidden="true"></i>
                            Product Type A-Z
                        </div>
                        <div class="sort-option" data-sort="relevance" role="option">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            Relevance Score
                        </div>
                        <div class="sort-option" data-sort="status" role="option">
                            <i class="fas fa-check-circle" aria-hidden="true"></i>
                            Status
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- After results-header div -->
        <div class="results-controls">
            <div class="left-controls">
                <div class="export-options">
                    <a href="@Url.Action("Create", "Certificate")" class="btn btn-add">
                        <i class="fas fa-plus"></i> Add Certificate
                    </a>
                    <button class="btn btn-primary" id="downloadSelectedBtn" disabled title="Select certificates in table view to download">
                        <i class="fas fa-download"></i> Download Selected
                    </button>
                    <button class="btn btn-primary" id="exportAllBtn">
                        <i class="fas fa-file-excel"></i> Export All to Excel
                    </button>
                    @if (User.IsInRole("Admin"))
                    {
                        <button type="button" class="btn btn-outline" id="openImportModalBtn" title="Bulk import certificates from CSV">
                            <i class="fas fa-upload"></i> Import
                        </button>
                        <a href="@Url.Action("DownloadTemplate", "CertificateImport")" class="btn btn-outline" title="Download CSV template with example data">
                            <i class="fas fa-file-download"></i> Template
                        </a>
                    }
                </div>
            </div>

            <div class="right-controls">
                <div class="view-toggle-container">
                    <div class="view-toggle">
                        <button class="toggle-btn active" data-view="tile">
                            <i class="fas fa-th"></i> Tile
                        </button>
                        <button class="toggle-btn" data-view="list">
                            <i class="fas fa-list"></i> List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="certificates-grid" id="certificatesGrid">
            <!-- Certificates will be loaded dynamically by JavaScript -->
        </div>

        <!-- LOADING INDICATOR FOR LAZY LOADING -->
        <div id="loadingIndicator" class="loading-indicator" role="status" aria-live="polite" aria-atomic="true">
            <div class="loading-spinner" aria-hidden="true"></div>
            <div class="loading-text">Loading more certificates...</div>
        </div>

        <!-- TABLE VIEW CONTAINER -->
        <div id="tableView" class="view-container" style="display: none;">
            <!-- Bulk Actions Bar - Compact Selection Info Only -->
            <div class="bulk-actions-bar" style="display: none;" id="bulkActionsBar" role="status">
                <div class="bulk-actions-left">
                    <span class="selected-count" id="selectedCount" aria-live="polite" aria-atomic="true">0 certificates selected</span>
                    <button class="clear-selection-btn" data-action="clear-selection">Clear Selection</button>
                </div>
            </div>

            <!-- Table Grid Container -->
            <div class="table-scroll-wrapper">
                <div class="table-grid-container">
                    <div class="table-grid" id="certificateGrid" role="table" aria-label="Certificates table">

                        <!-- HEADER ROW -->
                        <div class="grid-header" role="rowgroup">
                            <div class="grid-header-cell select-cell" role="columnheader">
                                <input type="checkbox" id="selectAll" title="Select all visible rows" aria-label="Select all certificates">
                            </div>
                            <div class="grid-header-cell actions-column" role="columnheader">
                                <span>Actions</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="certificate" role="columnheader">
                                Certificate #
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="certificationType" role="columnheader">
                                Certification Type
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="csfAttributes" role="columnheader">
                                CSF Attributes
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="status" role="columnheader">
                                Status
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="effectiveDate" role="columnheader">
                                Effective Date
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="expirationDate" role="columnheader">
                                Expiration Date
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="company" role="columnheader">
                                Company
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="companyContact" role="columnheader">
                                Company Contact Email/URL
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productName" role="columnheader">
                                Product Name
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productCategory" role="columnheader">
                                Product Category
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productType" role="columnheader">
                                Product Type
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productSubcategory" role="columnheader">
                                Product Type Subcategory
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="location" role="columnheader">
                                Location
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="country" role="columnheader">
                                Country
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="externalTag" role="columnheader">
                                External Tag
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="internalTag" role="columnheader">
                                Internal Tag
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="partner" role="columnheader">
                                Partner
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="asin" role="columnheader">
                                ASIN
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="upc" role="columnheader">
                                UPC
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="gtin" role="columnheader">
                                GTIN
                                <span class="sort-icon">▼</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="ean" role="columnheader">
                                EAN
                                <span class="sort-icon">▼</span>
                            </div>
                        </div>

                        <!-- BODY CONTAINER -->
                        <div class="grid-body" id="gridBody" role="rowgroup">
                            <!-- Grid rows will be populated here - equivalent to tableBody -->
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <script src="~/js/certificate-tile-view-internal.js"></script>
        <!-- Inline script block removed for CSP compliance -->
        @* All script content moved to external files for CSP compliance *@
    </div>
</div>

@if (User.IsInRole("Admin"))
{
<!-- Certificate Import Modal -->
<div id="certificate-import-modal" class="import-modal-wrapper" style="display: none;">
    <div class="import-modal-backdrop"></div>
    <div class="import-modal-container">
        <div class="import-modal-header">
            <h3 class="import-modal-title">
                <i class="fas fa-file-import"></i> <span id="importModalTitle">Import Certificates</span>
            </h3>
            <button type="button" class="import-modal-close" id="closeImportModalBtn">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="import-modal-body">
            <!-- Step 1: Upload -->
            <div id="importStep1" class="import-step">
                <div class="import-instructions">
                    <h4><i class="fas fa-info-circle"></i> Import Instructions</h4>
                    <ul>
                        <li><strong>Format:</strong> CSV file only (.csv extension)</li>
                        <li><strong>Required:</strong> CERTIFICATE_NUMBER, COMPANY_NAME, PRODUCT_NAME, CERTIFICATION_TYPE</li>
                        <li><strong>Auto-create:</strong> Companies, Products, and Tags will be created if they don't exist</li>
                        <li><strong>Max Size:</strong> 10MB per file</li>
                    </ul>
                </div>

                <div class="import-upload-area" id="importDropZone">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Drag & drop your CSV file here</p>
                    <p class="text-muted">or</p>
                    <label class="btn btn-primary">
                        <i class="fas fa-folder-open"></i> Browse Files
                        <input type="file" id="importFileInput" accept=".csv" style="display: none;">
                    </label>
                    <p id="selectedFileName" class="selected-file-name" style="display: none;"></p>
                </div>

                <div class="import-actions">
                    <button type="button" class="btn btn-secondary" id="cancelImportBtn">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="button" class="btn btn-primary" id="uploadImportBtn" disabled>
                        <i class="fas fa-upload"></i> Upload & Preview
                    </button>
                </div>
            </div>

            <!-- Step 2: Preview -->
            <div id="importStep2" class="import-step" style="display: none;">
                <div class="import-summary">
                    <div class="import-stat import-stat--total">
                        <div class="import-stat-value" id="statTotal">0</div>
                        <div class="import-stat-label">Total Rows</div>
                    </div>
                    <div class="import-stat import-stat--new">
                        <div class="import-stat-value" id="statNew">0</div>
                        <div class="import-stat-label">New</div>
                    </div>
                    <div class="import-stat import-stat--modified">
                        <div class="import-stat-value" id="statModified">0</div>
                        <div class="import-stat-label">Will Update</div>
                    </div>
                    <div class="import-stat import-stat--duplicates">
                        <div class="import-stat-value" id="statDuplicates">0</div>
                        <div class="import-stat-label">Duplicates</div>
                    </div>
                    <div class="import-stat import-stat--errors">
                        <div class="import-stat-value" id="statErrors">0</div>
                        <div class="import-stat-label">Errors</div>
                    </div>
                </div>

                <div class="import-duplicates-info" id="duplicatesInfo" style="display: none;">
                    <h5><i class="fas fa-copy"></i> Duplicate Certificates (Already Exist - No Changes)</h5>
                    <p class="text-muted">These certificate numbers already exist in the system with identical data. They will be skipped.</p>
                    <div class="duplicates-list" id="duplicatesList"></div>
                </div>

                <div class="import-auto-create" id="autoCreateInfo" style="display: none;">
                    <h5><i class="fas fa-magic"></i> Will Auto-Create:</h5>
                    <div id="autoCreateList"></div>
                </div>

                <div class="import-errors" id="importErrorsSection" style="display: none;">
                    <h5><i class="fas fa-exclamation-triangle"></i> Validation Errors</h5>
                    <div class="import-errors-list" id="importErrorsList"></div>
                </div>

                <div class="import-preview-table">
                    <h5><i class="fas fa-list"></i> Preview (first 10 rows)</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Cert #</th>
                                    <th>Company</th>
                                    <th>Product</th>
                                    <th>Type</th>
                                    <th>Dates</th>
                                </tr>
                            </thead>
                            <tbody id="importPreviewBody"></tbody>
                        </table>
                    </div>
                </div>

                <div class="import-actions">
                    <button type="button" class="btn btn-secondary" id="backToUploadBtn">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-success" id="applyImportBtn">
                        Apply Import
                    </button>
                </div>
            </div>

            <!-- Step 3: Processing -->
            <div id="importStep3" class="import-step" style="display: none;">
                <div class="import-processing">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p id="processingMessage">Processing import...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .import-modal-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9997;
    }
    .import-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.85);
        z-index: 9998;
        backdrop-filter: blur(3px);
    }
    .import-modal-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 9999;
        width: 95%;
        max-width: 900px;
        max-height: 90vh;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
    }
    .import-modal-header {
        background-color: #f8f9fa;
        border-bottom: 2px solid #e9ecef;
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 8px 8px 0 0;
    }
    .import-modal-title {
        color: #002B76;
        font-weight: 600;
        margin: 0;
        font-size: 18px;
    }
    .import-modal-close {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: #666;
        padding: 4px 8px;
    }
    .import-modal-close:hover {
        color: #333;
    }
    .import-modal-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
        max-height: calc(90vh - 70px);
    }
    .import-instructions {
        background: #e6f7ff;
        border: 1px solid #91d5ff;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
    }
    .import-instructions h4 {
        margin: 0 0 10px 0;
        color: #002B76;
        font-size: 16px;
    }
    .import-instructions ul {
        margin: 0;
        padding-left: 20px;
    }
    .import-instructions li {
        margin-bottom: 5px;
    }
    .import-upload-area {
        border: 2px dashed #ccc;
        border-radius: 8px;
        padding: 40px;
        text-align: center;
        background: #fafafa;
        transition: all 0.3s ease;
        margin-bottom: 20px;
    }
    .import-upload-area:hover,
    .import-upload-area.drag-over {
        border-color: #447638;
        background: #f0f9f0;
    }
    .import-upload-area i {
        font-size: 48px;
        color: #999;
        margin-bottom: 15px;
    }
    .import-upload-area.drag-over i {
        color: #447638;
    }
    .selected-file-name {
        margin-top: 15px;
        padding: 10px;
        background: #e8f5e1;
        border-radius: 4px;
        color: #447638;
        font-weight: 500;
    }
    .import-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 15px;
        border-top: 1px solid #eee;
        margin-top: 20px;
    }
    .import-summary {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }
    .import-duplicates-info {
        background: #f8f9fa;
        border: 1px solid #6c757d;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
    }
    .import-duplicates-info h5 {
        margin: 0 0 10px 0;
        color: #495057;
    }
    .import-duplicates-info .duplicates-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }
    .import-duplicates-info .duplicate-badge {
        background: #e9ecef;
        border: 1px solid #6c757d;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 13px;
        font-family: monospace;
        color: #495057;
    }
    .import-stat {
        padding: 15px;
        border-radius: 8px;
        text-align: center;
    }
    .import-stat--total { background: #e6f7ff; border: 2px solid #002B76; }
    .import-stat--new { background: #e8f5e1; border: 2px solid #447638; }
    .import-stat--modified { background: #fff3cd; border: 2px solid #ffc107; }
    .import-stat--duplicates { background: #f0f0f0; border: 2px solid #6c757d; }
    .import-stat--errors { background: #ffebee; border: 2px solid #dc3545; }
    .import-stat-value {
        font-size: 28px;
        font-weight: 700;
    }
    .import-stat--total .import-stat-value { color: #002B76; }
    .import-stat--new .import-stat-value { color: #447638; }
    .import-stat--modified .import-stat-value { color: #856404; }
    .import-stat--duplicates .import-stat-value { color: #6c757d; }
    .import-stat--errors .import-stat-value { color: #dc3545; }
    .import-stat-label {
        font-size: 12px;
        color: #666;
        text-transform: uppercase;
        margin-top: 5px;
    }
    .import-auto-create {
        background: #f0f9f0;
        border: 1px solid #92C83E;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
    }
    .import-auto-create h5 {
        margin: 0 0 10px 0;
        color: #447638;
    }
    .import-errors {
        background: #fff5f5;
        border: 1px solid #dc3545;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
        max-height: 150px;
        overflow-y: auto;
    }
    .import-errors h5 {
        margin: 0 0 10px 0;
        color: #dc3545;
    }
    .import-errors-list {
        font-size: 14px;
    }
    .import-preview-table {
        margin-bottom: 15px;
    }
    .import-preview-table h5 {
        margin-bottom: 10px;
        color: #333;
    }
    .import-processing {
        text-align: center;
        padding: 60px 20px;
    }
    .import-processing i {
        color: #447638;
        margin-bottom: 20px;
    }
    .import-processing p {
        font-size: 18px;
        color: #666;
    }
    .status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }
    .status-badge--new { background: #e8f5e1; color: #447638; }
    .status-badge--modified { background: #fff3cd; color: #856404; }
    .status-badge--error { background: #ffebee; color: #dc3545; }

    /* Modal Button Styling - Match Application Theme */
    .import-actions .btn-primary {
        background-color: #92C83E;
        border-color: #92C83E;
        color: white;
    }
    .import-actions .btn-primary:hover {
        background-color: #7fb835;
        border-color: #7fb835;
    }
    .import-actions .btn-primary:disabled {
        background-color: #c5e0a5;
        border-color: #c5e0a5;
    }
    .import-actions .btn-secondary {
        background-color: transparent;
        border: 2px solid #6c757d;
        color: #6c757d;
    }
    .import-actions .btn-secondary:hover {
        background-color: rgba(108, 117, 125, 0.1);
        color: #5a6268;
    }
    .import-actions .btn-success {
        background-color: #92C83E;
        border-color: #92C83E;
        color: white;
    }
    .import-actions .btn-success:hover {
        background-color: #7fb835;
        border-color: #7fb835;
    }
    .import-upload-area .btn-primary {
        background-color: #92C83E;
        border-color: #92C83E;
        color: white;
    }
    .import-upload-area .btn-primary:hover {
        background-color: #7fb835;
        border-color: #7fb835;
    }
</style>

<script>
(function() {
    const modal = document.getElementById('certificate-import-modal');
    const openBtn = document.getElementById('openImportModalBtn');
    const closeBtn = document.getElementById('closeImportModalBtn');
    const cancelBtn = document.getElementById('cancelImportBtn');
    const fileInput = document.getElementById('importFileInput');
    const dropZone = document.getElementById('importDropZone');
    const uploadBtn = document.getElementById('uploadImportBtn');
    const backBtn = document.getElementById('backToUploadBtn');
    const applyBtn = document.getElementById('applyImportBtn');
    const fileNameDisplay = document.getElementById('selectedFileName');

    let selectedFile = null;
    let importId = null;
    let previewData = null;

    // Open modal
    openBtn?.addEventListener('click', () => {
        modal.style.display = 'block';
        resetModal();
    });

    // Close modal
    function closeModal() {
        modal.style.display = 'none';
        resetModal();
    }

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal?.querySelector('.import-modal-backdrop')?.addEventListener('click', closeModal);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.style.display === 'block') {
            closeModal();
        }
    });

    // File selection
    fileInput?.addEventListener('change', (e) => {
        handleFileSelect(e.target.files[0]);
    });

    // Drag and drop
    dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('drag-over');
    });

    dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('drag-over');
    });

    dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file && file.name.endsWith('.csv')) {
            handleFileSelect(file);
        } else {
            showNotification('Please select a CSV file', 'error');
        }
    });

    function handleFileSelect(file) {
        if (!file) return;
        if (!file.name.endsWith('.csv')) {
            showNotification('Please select a CSV file', 'error');
            return;
        }
        selectedFile = file;
        fileNameDisplay.textContent = file.name;
        fileNameDisplay.style.display = 'block';
        uploadBtn.disabled = false;
    }

    // Upload and preview
    uploadBtn?.addEventListener('click', async () => {
        if (!selectedFile) return;

        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';

        const formData = new FormData();
        formData.append('csvFile', selectedFile);

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                          document.querySelector('meta[name="csrf-token"]')?.content;

            const response = await fetch('/api/CertificateImport/Preview', {
                method: 'POST',
                body: formData,
                headers: token ? { 'RequestVerificationToken': token } : {}
            });

            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(errorText || 'Upload failed');
            }

            previewData = await response.json();
            importId = previewData.importId;
            showPreview(previewData);
        } catch (error) {
            showNotification('Upload failed: ' + error.message, 'error');
            uploadBtn.disabled = false;
            uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload & Preview';
        }
    });

    // Back to upload
    backBtn?.addEventListener('click', () => {
        document.getElementById('importStep1').style.display = 'block';
        document.getElementById('importStep2').style.display = 'none';
        uploadBtn.disabled = false;
        uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload & Preview';
    });

    // Apply import
    applyBtn?.addEventListener('click', async () => {
        if (!importId) return;

        // Use AdminCore confirmation modal instead of native confirm()
        const confirmMessage = `${previewData.newCertificates} new certificate(s) will be created and ${previewData.modifiedCertificates} certificate(s) will be updated.`;

        const confirmed = await AdminCore.showConfirmation({
            title: 'Confirm Import',
            message: confirmMessage,
            confirmText: 'Apply Import',
            type: 'warning'
        });

        if (!confirmed) return;

        document.getElementById('importStep2').style.display = 'none';
        document.getElementById('importStep3').style.display = 'block';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                          document.querySelector('meta[name="csrf-token"]')?.content;

            const response = await fetch('/api/CertificateImport/Apply', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({ importId: importId })
            });

            const result = await response.json();

            if (result.success) {
                AdminCore.showNotification(`Import successful! ${result.certificatesCreated} created, ${result.certificatesUpdated} updated.`, 'success');
                closeModal();
                // Refresh the certificate list
                if (typeof loadCertificates === 'function') {
                    loadCertificates();
                } else {
                    location.reload();
                }
            } else {
                throw new Error(result.message || 'Import failed');
            }
        } catch (error) {
            AdminCore.showNotification('Import failed: ' + error.message, 'error');
            document.getElementById('importStep3').style.display = 'none';
            document.getElementById('importStep2').style.display = 'block';
        }
    });

    function showPreview(data) {
        document.getElementById('importStep1').style.display = 'none';
        document.getElementById('importStep2').style.display = 'block';

        // Update stats
        document.getElementById('statTotal').textContent = data.totalRows;
        document.getElementById('statNew').textContent = data.newCertificates;
        document.getElementById('statModified').textContent = data.modifiedCertificates;
        document.getElementById('statDuplicates').textContent = data.unchangedCertificates || 0;
        document.getElementById('statErrors').textContent = data.invalidRows;

        // Show duplicates info (unchanged certificates that already exist)
        const duplicatesInfo = document.getElementById('duplicatesInfo');
        const duplicatesList = document.getElementById('duplicatesList');
        if (data.unchangedRows && data.unchangedRows.length > 0) {
            duplicatesList.innerHTML = data.unchangedRows.map(row =>
                `<span class="duplicate-badge">${row.certificateNumber}</span>`
            ).join('');
            duplicatesInfo.style.display = 'block';
        } else {
            duplicatesInfo.style.display = 'none';
        }

        // Show auto-create info
        const autoCreateInfo = document.getElementById('autoCreateInfo');
        const autoCreateList = document.getElementById('autoCreateList');
        const autoItems = [];
        if (data.companiesToCreate > 0) autoItems.push(`${data.companiesToCreate} company(ies)`);
        if (data.productsToCreate > 0) autoItems.push(`${data.productsToCreate} product(s)`);
        if (data.tagsToCreate > 0) autoItems.push(`${data.tagsToCreate} tag(s)`);

        if (autoItems.length > 0) {
            autoCreateList.innerHTML = autoItems.map(i => `<span class="badge bg-success me-2">${i}</span>`).join('');
            autoCreateInfo.style.display = 'block';
        } else {
            autoCreateInfo.style.display = 'none';
        }

        // Show errors
        const errorsSection = document.getElementById('importErrorsSection');
        const errorsList = document.getElementById('importErrorsList');
        if (data.errorRows && data.errorRows.length > 0) {
            errorsList.innerHTML = data.errorRows.map(e =>
                `<div><strong>Row ${e.rowNumber}:</strong> ${e.errorMessages.join(', ')}</div>`
            ).join('');
            errorsSection.style.display = 'block';
        } else {
            errorsSection.style.display = 'none';
        }

        // Show preview table
        const tbody = document.getElementById('importPreviewBody');
        const rows = [...(data.newRows || []), ...(data.modifiedRows || [])].slice(0, 10);
        tbody.innerHTML = rows.map(row => `
            <tr>
                <td><span class="status-badge status-badge--${row.status === 'New' ? 'new' : 'modified'}">${row.status}</span></td>
                <td><code>${row.certificateNumber}</code></td>
                <td>${row.companyName}</td>
                <td>${row.productName}</td>
                <td>${row.certificationType}</td>
                <td>${row.effectiveDate ? new Date(row.effectiveDate).toLocaleDateString() : ''} - ${row.expirationDate ? new Date(row.expirationDate).toLocaleDateString() : ''}</td>
            </tr>
        `).join('');

        // Enable/disable apply button
        applyBtn.disabled = !data.canApply;
    }

    function resetModal() {
        selectedFile = null;
        importId = null;
        previewData = null;
        fileInput.value = '';
        fileNameDisplay.style.display = 'none';
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload & Preview';
        document.getElementById('importStep1').style.display = 'block';
        document.getElementById('importStep2').style.display = 'none';
        document.getElementById('importStep3').style.display = 'none';
        document.getElementById('importModalTitle').textContent = 'Import Certificates';
    }

    function showNotification(message, type) {
        // Use AdminCore for consistent notifications
        AdminCore.showNotification(message, type);
    }
})();
</script>
}
