@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i>
</span>
        <span class="current">Certificates</span>
    </span>
}
<link rel="stylesheet" href="~/css/certificatetileview.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    /* ====================================================
       INTERNAL VIEW SPECIFIC STYLES
       Grid layout: 21 columns (HAS Internal Tag column)
       Action buttons: Edit + Download + View
       ====================================================*/

    /* Edit button styling - Internal view only */
    .action-icon.edit {
        color: #007bff;
    }

    .action-icon.edit:hover {
        color: #0056b3;
        background-color: #e3f2fd;
    }

    .action-btn.edit,
    .action-btn.edit-btn {
        color: #007bff;
    }

    .action-btn.edit:hover,
    .action-btn.edit-btn:hover {
        color: #0056b3;
        background-color: #e3f2fd;
    }

    /* Fix product name width for internal view */
    .certificate-card .product-name {
        max-width: 100% !important;
        width: 100% !important;
        word-wrap: break-word !important;
        word-break: break-word !important;
        white-space: normal !important;
    }

    /* Grid layout moved to READABLE COMPACT TABLE LAYOUT section below */

    /* Loading spinner animation specific to this view */
    .loading-spinner {
        width: 24px;
        height: 24px;
        border: 3px solid #f3f3f3;
        border-top: 3px solid #007bff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-right: 12px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* ====================================================
       COLLAPSIBLE SIDEBAR - MATCHING MOBILE PATTERN
       ====================================================*/

    /* Show Filters button - visible when sidebar collapsed, narrow strip */
    .sidebar-toggle-tab {
        display: none;
        width: 44px;
        min-width: 44px;
        height: 100%;
        padding: 0;
        margin: 0;
        background: var(--blue-primary, #00AEEF);
        color: var(--white, #fff);
        border: none;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: var(--transition-fast, 0.15s ease);
    }

    .sidebar-toggle-tab:hover {
        background: var(--blue-dark, #002876);
    }

    .sidebar-toggle-tab i {
        color: var(--white, #fff);
        font-size: 16px;
    }

    .sidebar-toggle-tab span {
        display: none;
    }

    .sidebar-toggle-tab.visible {
        display: flex;
    }

    /* Hide Filters button - inside sidebar, full width (16px min per Master Design Guide) */
    .sidebar-collapse-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 10px 16px;
        margin-bottom: 15px;
        background: var(--blue-primary, #00AEEF);
        color: var(--white, #fff);
        border: none;
        border-radius: var(--border-radius-sm, 4px);
        cursor: pointer;
        font-size: 16px;
        font-weight: 500;
        transition: var(--transition-fast, 0.15s ease);
    }

    .sidebar-collapse-btn:hover {
        background: var(--blue-dark, #002876);
    }

    .sidebar-collapse-btn i {
        margin-left: 10px;
        transition: transform 0.3s ease;
        font-size: 14px;
    }

    /* Sidebar collapsed state */
    .sidebar.collapsed {
        display: none !important;
    }

    /* Main container is already flex from base CSS */
    .main-container.sidebar-collapsed {
        max-width: 100% !important;
    }

    .main-container.sidebar-collapsed .main-content {
        max-width: 100%;
    }

    .main-container.sidebar-collapsed .table-scroll-wrapper {
        max-width: 100% !important;
        width: 100%;
    }

    /* ====================================================
       TABLE SCROLL FIX - Ensure all 22 columns are visible
       ====================================================*/

    /* Override base CSS max-width constraint to allow full table scroll */
    .table-scroll-wrapper {
        max-width: none !important;
        width: 100%;
        overflow-x: auto !important;
        overflow-y: visible;
    }

    /* Ensure the table grid container doesn't collapse */
    .table-grid-container {
        min-width: 2520px; /* Total of all 22 column widths */
        width: max-content;
    }

    /* Ensure main content allows table to expand */
    .main-content {
        overflow-x: visible;
        min-width: 0;
    }

    /* ====================================================
       WIDER LAYOUT FOR TABLE VIEW ONLY
       Tiles remain at standard width
       ====================================================*/

    /* Only expand when table view is active - use has selector or JS class */
    body.table-view-active .page-container {
        max-width: 100% !important;
        width: 100% !important;
        padding: 0 15px !important;
        margin: 0 !important;
    }

    body.table-view-active .main-container {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
    }

    body.table-view-active .main-content {
        max-width: 100% !important;
        width: 100% !important;
    }

    /* Compact bulk actions bar */
    #tableView .bulk-actions-bar {
        padding: 4px 10px !important;
        margin-bottom: 8px !important;
        gap: 8px;
    }

    #tableView .bulk-actions-left {
        gap: 8px !important;
    }

    #tableView .selected-count {
        font-size: 16px !important;
    }

    #tableView .clear-selection-btn {
        padding: 6px 12px !important;
        font-size: 16px !important;
    }

    /* ====================================================
       SELECT & ACTIONS COLUMNS - CENTERED LAYOUT
       Width controlled by grid-template-columns above
       ====================================================*/

    /* Select cell - header & body */
    .table-grid .grid-header-cell.select-cell,
    .table-grid .grid-cell.select-cell {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 4px !important;
    }

    /* Actions column - header & body - ensure consistent centering */
    .table-grid .grid-header-cell.actions-column,
    .table-grid .grid-cell.actions-column {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        padding: 4px 8px !important;
        overflow: visible !important;
    }

    /* Actions header text centering */
    .table-grid .grid-header-cell.actions-column span {
        display: inline-block;
        text-align: center;
        width: 100%;
    }

    /* Action buttons container - centered within the cell */
    .table-grid .grid-cell.actions-column .action-buttons {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 4px !important;
        margin: 0 auto;
    }

    /* Individual action buttons - consistent sizing */
    .table-grid .grid-cell.actions-column .action-btn {
        padding: 4px !important;
        min-width: 26px !important;
        height: 26px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        border: none !important;
        background: transparent !important;
        border-radius: 4px !important;
        color: #666 !important;
        cursor: pointer !important;
        flex-shrink: 0;
    }

    .table-grid .grid-cell.actions-column .action-btn:hover {
        background: #e3f2fd !important;
        color: #007bff !important;
    }

    /* Focus indicators for accessibility (WCAG 2.1 AA compliance) */
    .table-grid .grid-cell.actions-column .action-btn:focus,
    .table-grid .grid-cell.actions-column .action-btn:focus-visible {
        outline: 2px solid #007bff !important;
        outline-offset: 2px !important;
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.25) !important;
    }

    .table-grid .grid-cell.actions-column .action-btn i {
        font-size: 14px !important;
    }

    /* Certificate # column styling - ensure alignment */
    .grid-cell[data-column="certificateNumber"],
    .grid-header-cell[data-sort-column="certificate"] {
        font-weight: 600;
        justify-content: flex-start !important;
        text-align: left !important;
    }

    /* ====================================================
       REDUCE SPACING BETWEEN BUTTONS AND TABLE
       ====================================================*/
    .main-content .results-header {
        margin-bottom: 8px !important;
        padding-top: 5px !important;
        padding-bottom: 0 !important;
    }

    .main-content .results-controls {
        margin-bottom: 8px !important;
        margin-top: 0 !important;
        padding: 0 !important;
    }

    .main-content {
        padding: 10px 15px 15px 15px !important;
    }

    /* Remove any extra space before tableView */
    #tableView {
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    /* Remove extra space on certificates grid too */
    .certificates-grid {
        margin-top: 0 !important;
    }

    /* Fix loading indicator - hide completely when not active */
    .loading-indicator {
        display: none !important;
        padding: 10px !important;
    }

    .loading-indicator.active {
        display: flex !important;
    }

    /* ====================================================
       READABLE COMPACT TABLE LAYOUT
       Wider columns, text wrapping for readability
       ====================================================*/

    /* Header cells - readable size (16px min per Master Design Guide) */
    .table-grid .grid-header-cell {
        min-height: 40px !important;
        padding: 8px 10px !important;
        font-size: 16px !important;
        font-weight: 600 !important;
        white-space: nowrap !important;
    }

    /* Body cells - allow wrapping for readability */
    .table-grid .grid-cell {
        min-height: 36px !important;
        padding: 6px 10px !important;
        font-size: 14px !important;
        line-height: 1.4 !important;
        /* Allow text to wrap */
        white-space: normal !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        max-width: 100% !important;
    }

    /* Checkbox styling - vertically and horizontally centered */
    .table-grid .grid-cell.select-cell input[type="checkbox"],
    .table-grid .grid-header-cell.select-cell input[type="checkbox"] {
        margin: 0 !important;
        padding: 0 !important;
        cursor: pointer;
        width: 16px !important;
        height: 16px !important;
        vertical-align: middle !important;
        flex-shrink: 0;
    }

    /* Ensure row checkbox matches header checkbox */
    .table-grid .row-checkbox {
        margin: 0 !important;
        width: 16px !important;
        height: 16px !important;
    }

    /* Short data columns stay single line */
    .table-grid .grid-cell[data-column="status"],
    .table-grid .grid-cell[data-column="effectiveDate"],
    .table-grid .grid-cell[data-column="expirationDate"],
    .table-grid .grid-cell[data-column="country"],
    .table-grid .grid-cell[data-column="asin"],
    .table-grid .grid-cell[data-column="upc"],
    .table-grid .grid-cell[data-column="gtin"],
    .table-grid .grid-cell[data-column="ean"] {
        white-space: nowrap !important;
    }

    /* Grid layout for Internal view (22 columns) - SINGLE DEFINITION */
    .table-grid {
        display: grid;
        grid-template-columns:
            36px      /* 1. Select checkbox - centered */
            90px      /* 2. Actions - 3 icons centered */
            115px     /* 3. Certificate # */
            160px     /* 4. Certification Type */
            130px     /* 5. CSF Attributes */
            75px      /* 6. Status */
            95px      /* 7. Effective Date */
            95px      /* 8. Expiration Date */
            170px     /* 9. Company */
            170px     /* 10. Company Contact */
            170px     /* 11. Product Name */
            130px     /* 12. Product Category */
            130px     /* 13. Product Type */
            140px     /* 14. Product Subcategory */
            100px     /* 15. Location */
            80px      /* 16. Country */
            100px     /* 17. External Tag */
            100px     /* 18. Internal Tag */
            85px      /* 19. ASIN */
            85px      /* 20. UPC */
            85px      /* 21. GTIN */
            85px;     /* 22. EAN */
        min-width: max-content;
        width: 100%;
    }

    /* Ensure grid rows and header inherit the template */
    .table-grid .grid-header,
    .table-grid .grid-body,
    .table-grid .grid-row {
        display: contents;
    }

    /* Force all grid cells to respect column widths */
    .table-grid .grid-cell,
    .table-grid .grid-header-cell {
        box-sizing: border-box;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Update min-width for table container - sum of 22 columns = ~2435px */
    .table-grid-container {
        min-width: 2450px;
    }

    /* Zebra striping */
    .table-grid .grid-row:nth-child(even) .grid-cell {
        background: #fafafa !important;
    }

    .table-grid .grid-row:hover .grid-cell {
        background: #e8f4fc !important;
    }

    .table-grid .grid-row:nth-child(even):hover .grid-cell {
        background: #e8f4fc !important;
    }

    /* Status badge (14px min for badges per Master Design Guide) */
    .table-grid .grid-cell .status-badge {
        padding: 4px 10px !important;
        font-size: 14px !important;
    }

    /* Date columns use monospace for alignment (16px min per Master Design Guide) */
    .table-grid .grid-cell[data-column="effectiveDate"],
    .table-grid .grid-cell[data-column="expirationDate"] {
        font-family: 'Consolas', 'Courier New', monospace !important;
        font-size: 16px !important;
    }

    /* Certificate number styling - same color as all other text */
    .table-grid .grid-cell[data-column="certificateNumber"] {
        font-family: inherit !important;
        font-weight: 500 !important;
        color: inherit !important;
        font-size: 14px !important;
    }

    /* Ensure all grid cells have consistent text color */
    .table-grid .grid-cell {
        color: #333 !important;
    }
</style>
<!-- Main Container -->
<div class="main-container" style="width: 100%;">
    <!-- Show Filters button (visible when sidebar collapsed) -->
    <button class="sidebar-toggle-tab" id="sidebarToggleTab">
        <span>Show Filters</span>
        <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Sidebar (Filters) -->
    <div class="sidebar" id="filterSidebar">
        <!-- Hide Filters button - matches mobile toggle style -->
        <button class="sidebar-collapse-btn" id="sidebarCollapseBtn">
            <span>Hide Filters</span>
            <i class="fas fa-chevron-left"></i>
        </button>

        <button class="mobile-filter-toggle" style="display: none;">
            <span>Show Filters & Search</span>
            <i class="fas fa-chevron-down"></i>
        </button>

        <!-- Search Bar -->
        <div class="search-bar">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search...">
        </div>

        <div class="filters-header">
            <h3 class="filters-title">Filters</h3>
            <a href="#" class="clear-filters">Clear Filters</a>
        </div>

        <!-- Certification Type Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="cert-type">
                <span>Certification Type</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="cert-type-content">
                <ul class="filter-tree">
                    <!-- Certification types will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading certification types...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Product Categories Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="product-cat">
                <span>Product Categories</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="product-cat-content">
                <ul class="filter-tree">
                    <!-- Product categories will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading categories...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Company Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="company">
                <span>Company</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="company-content">
                <ul class="filter-tree">
                    <!-- Companies will be dynamically populated from the database via JavaScript (only companies with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading companies...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Countries Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="countries">
                <span>Countries</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="countries-content">
                <ul class="filter-tree">
                    <!-- Countries will be dynamically populated from the database via JavaScript (only countries with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading countries...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Additional Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="additional">
                <span>Additional</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="additional-content">
                <ul class="filter-tree">
                    <!-- Additional tags will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading additional tags...</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!-- Main Content Area -->
    <div class="main-content">
        <div class="results-header">
            <div class="results-count" id="resultsCount">15 Results</div>


            <div class="sort-controls">
                <span class="sort-label" id="sortByLabel">Sort By</span>
                <div class="sort-dropdown" id="sortDropdown">
                    <button class="sort-dropdown-button" aria-expanded="false" aria-haspopup="listbox" aria-controls="sortContent" aria-labelledby="sortByLabel sortLabel">
                        <span id="sortLabel">Default</span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="sort-dropdown-content" id="sortContent" role="listbox" aria-label="Sort options">
                        <!-- Date-based sorting -->
                        <div class="sort-group-header">By Date</div>
                        <div class="sort-option" data-sort="newest">
                            <i class="fas fa-calendar-plus"></i>
                            Newest Effective Date
                        </div>
                        <div class="sort-option" data-sort="oldest-effective">
                            <i class="fas fa-calendar-minus"></i>
                            Oldest Effective Date
                        </div>
                        <div class="sort-option" data-sort="expiring">
                            <i class="fas fa-clock"></i>
                            Expiring Soon
                        </div>
                        <div class="sort-option" data-sort="longest-validity">
                            <i class="fas fa-hourglass-end"></i>
                            Longest Validity Period
                        </div>
                        <div class="sort-option" data-sort="recently-issued">
                            <i class="fas fa-calendar-check"></i>
                            Recently Issued (Last 30 Days)
                        </div>

                        <!-- Certificate Information -->
                        <div class="sort-group-header">By Certificate</div>
                        <div class="sort-option" data-sort="cert-number-newest">
                            <i class="fas fa-certificate"></i>
                            Certificate Number (Newest)
                        </div>
                        <div class="sort-option" data-sort="cert-number-oldest">
                            <i class="fas fa-certificate"></i>
                            Certificate Number (Oldest)
                        </div>
                        <div class="sort-option" data-sort="cert-type">
                            <i class="fas fa-award"></i>
                            Certification Type A-Z
                        </div>
                        <div class="sort-option" data-sort="cert-type-za">
                            <i class="fas fa-award"></i>
                            Certification Type Z-A
                        </div>

                        <!-- Alphabetical sorting -->
                        <div class="sort-group-header">Alphabetical</div>
                        <div class="sort-option" data-sort="company-az">
                            <i class="fas fa-building"></i>
                            Company A-Z
                        </div>
                        <div class="sort-option" data-sort="company-za">
                            <i class="fas fa-building"></i>
                            Company Z-A
                        </div>
                        <div class="sort-option" data-sort="product-az">
                            <i class="fas fa-tag"></i>
                            Product Name A-Z
                        </div>
                        <div class="sort-option" data-sort="product-za">
                            <i class="fas fa-tag"></i>
                            Product Name Z-A
                        </div>

                        <!-- Location sorting -->
                        <div class="sort-group-header">By Location</div>
                        <div class="sort-option" data-sort="location-az">
                            <i class="fas fa-map-marker-alt"></i>
                            Location A-Z
                        </div>
                        <div class="sort-option" data-sort="location-za">
                            <i class="fas fa-map-marker-alt"></i>
                            Location Z-A
                        </div>
                        <div class="sort-option" data-sort="country">
                            <i class="fas fa-globe"></i>
                            Country A-Z
                        </div>
                        <div class="sort-option" data-sort="country-za">
                            <i class="fas fa-globe"></i>
                            Country Z-A
                        </div>

                        <!-- Advanced sorting -->
                        <div class="sort-group-header">Advanced</div>
                        <div class="sort-option" data-sort="popularity">
                            <i class="fas fa-star"></i>
                            Most Popular Companies
                        </div>
                        <div class="sort-option" data-sort="product-type">
                            <i class="fas fa-boxes"></i>
                            Product Type A-Z
                        </div>
                        <div class="sort-option" data-sort="relevance">
                            <i class="fas fa-search"></i>
                            Relevance Score
                        </div>
                        <div class="sort-option" data-sort="status">
                            <i class="fas fa-check-circle"></i>
                            Status
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- After results-header div -->
        <div class="results-controls">
            <div class="left-controls">
                <div class="export-options">
                    <a href="@Url.Action("Create", "Certificate")" class="btn btn-add">
                        <i class="fas fa-plus"></i> Add Certificate
                    </a>
                    <button class="btn btn-primary" id="downloadSelectedBtn" disabled title="Select certificates in table view to download">
                        <i class="fas fa-download"></i> Download Selected
                    </button>
                    <button class="btn btn-primary" id="exportAllBtn">
                        <i class="fas fa-file-excel"></i> Export All to Excel
                    </button>
                </div>
            </div>

            <div class="right-controls">
                <div class="view-toggle-container">
                    <div class="view-toggle">
                        <button class="toggle-btn active" data-view="tile">
                            <i class="fas fa-th"></i> Tile
                        </button>
                        <button class="toggle-btn" data-view="list">
                            <i class="fas fa-list"></i> List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="certificates-grid" id="certificatesGrid">
            <!-- Certificates will be loaded dynamically by JavaScript -->
        </div>

        <!-- LOADING INDICATOR FOR LAZY LOADING -->
        <div id="loadingIndicator" class="loading-indicator" role="status" aria-live="polite" aria-atomic="true">
            <div class="loading-spinner" aria-hidden="true"></div>
            <div class="loading-text">Loading more certificates...</div>
        </div>

        <!-- TABLE VIEW CONTAINER -->
        <div id="tableView" class="view-container" style="display: none;">
            <!-- Bulk Actions Bar - Compact Selection Info Only -->
            <div class="bulk-actions-bar" style="display: none;" id="bulkActionsBar" role="status">
                <div class="bulk-actions-left">
                    <span class="selected-count" id="selectedCount" aria-live="polite" aria-atomic="true">0 certificates selected</span>
                    <button class="clear-selection-btn" data-action="clear-selection">Clear Selection</button>
                </div>
            </div>

            <!-- Table Grid Container -->
            <div class="table-scroll-wrapper">
                <div class="table-grid-container">
                    <div class="table-grid" id="certificateGrid" role="table" aria-label="Certificates table">

                        <!-- HEADER ROW -->
                        <div class="grid-header" role="rowgroup">
                            <div class="grid-header-cell select-cell" role="columnheader">
