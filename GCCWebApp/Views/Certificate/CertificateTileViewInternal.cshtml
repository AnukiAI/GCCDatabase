@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/certificatetileview.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    /* ====================================================
       INTERNAL VIEW SPECIFIC - Grid Column Definition Only
       All shared styles are in certificatetileview.css
       ==================================================== */

    /* Grid layout for Internal view (22 columns - HAS Internal Tag) */
    .table-grid {
        display: grid;
        grid-template-columns:
            36px      /* 1. Select checkbox */
            90px      /* 2. Actions (Edit + Download + View) */
            145px     /* 3. Certificate # */
            160px     /* 4. Certification Type */
            130px     /* 5. CSF Attributes */
            75px      /* 6. Status */
            95px      /* 7. Effective Date */
            95px      /* 8. Expiration Date */
            170px     /* 9. Company */
            170px     /* 10. Company Contact */
            170px     /* 11. Product Name */
            130px     /* 12. Product Category */
            130px     /* 13. Product Type */
            140px     /* 14. Product Subcategory */
            100px     /* 15. Location */
            80px      /* 16. Country */
            100px     /* 17. External Tag */
            100px     /* 18. Internal Tag */
            85px      /* 19. ASIN */
            85px      /* 20. UPC */
            85px      /* 21. GTIN */
            85px;     /* 22. EAN */
        min-width: max-content;
        width: 100%;
    }

    /* Table container min-width for Internal (22 columns) */
    .table-grid-container {
        min-width: 2450px;
        width: max-content;
    }

    /* ====================================================
       SELECT & ACTIONS COLUMNS - CENTERED LAYOUT
       ====================================================*/

    /* Select cell - header & body - CENTERED checkbox */
    .table-grid .grid-header-cell.select-cell,
    .table-grid .grid-cell.select-cell {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 8px !important;
        text-align: center !important;
    }

    /* Actions column - header & body - CENTERED content */
    .table-grid .grid-header-cell.actions-column,
    .table-grid .grid-cell.actions-column {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        padding: 8px 6px !important;
        overflow: visible !important;
    }

    /* Actions header text centering - full width span */
    .table-grid .grid-header-cell.actions-column span {
        display: block !important;
        text-align: center !important;
        width: 100% !important;
        font-weight: 600 !important;
    }

    /* Action buttons container - centered within the cell */
    .table-grid .grid-cell.actions-column .action-buttons {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 4px !important;
        margin: 0 auto !important;
        width: 100% !important;
    }

    /* Individual action buttons - consistent sizing */
    .table-grid .grid-cell.actions-column .action-btn {
        padding: 4px !important;
        min-width: 26px !important;
        height: 26px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        border: none !important;
        background: transparent !important;
        border-radius: 4px !important;
        color: #666 !important;
        cursor: pointer !important;
        flex-shrink: 0 !important;
    }

    .table-grid .grid-cell.actions-column .action-btn:hover {
        background: #e3f2fd !important;
        color: #007bff !important;
    }

    .table-grid .grid-cell.actions-column .action-btn i {
        font-size: 14px !important;
    }

    /* Certificate # column styling - LEFT aligned */
    .table-grid .grid-header-cell[data-sort-column="certificate"],
    .table-grid .grid-cell[data-column="certificateNumber"] {
        justify-content: flex-start !important;
        text-align: left !important;
        padding-left: 10px !important;
    }

    .table-grid .grid-cell[data-column="certificateNumber"] {
        font-weight: 600 !important;
        font-family: 'Consolas', 'Courier New', monospace !important;
    }
</style>
<!-- Main Container -->
<div class="main-container" style="width: 100%;">
    <!-- Show Filters button (visible when sidebar collapsed) -->
    <button class="sidebar-toggle-tab" id="sidebarToggleTab">
        <span>Show Filters</span>
        <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Sidebar (Filters) -->
    <div class="sidebar" id="filterSidebar">
        <!-- Hide Filters button - matches mobile toggle style -->
        <button class="sidebar-collapse-btn" id="sidebarCollapseBtn">
            <span>Hide Filters</span>
            <i class="fas fa-chevron-left"></i>
        </button>

        <button class="mobile-filter-toggle" style="display: none;">
            <span>Show Filters & Search</span>
            <i class="fas fa-chevron-down"></i>
        </button>

        <!-- Search Bar -->
        <div class="search-bar">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search">
        </div>

        <div class="filters-header">
            <h3 class="filters-title">Filters</h3>
            <a href="#" class="clear-filters">Clear Filters</a>
        </div>

        <!-- Certification Type Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="cert-type">
                <span>Certification Type</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="cert-type-content">
                <ul class="filter-tree">
                    <!-- Certification types will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading certification types...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Product Categories Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="product-cat">
                <span>Product Categories</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="product-cat-content">
                <ul class="filter-tree">
                    <!-- Product categories will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading categories...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Company Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="company">
                <span>Company</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="company-content">
                <ul class="filter-tree">
                    <!-- Companies will be dynamically populated from the database via JavaScript (only companies with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading companies...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Countries Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="countries">
                <span>Countries</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="countries-content">
                <ul class="filter-tree">
                    <!-- Countries will be dynamically populated from the database via JavaScript (only countries with active certificates) -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading countries...</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Additional Filter -->
        <div class="filter-panel">
            <div class="filter-header" data-filter="additional">
                <span>Additional</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="additional-content">
                <ul class="filter-tree">
                    <!-- Additional tags will be dynamically populated from the database via JavaScript -->
                    <li class="filter-item">
                        <span style="color: #999; font-style: italic;">Loading additional tags...</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!-- Main Content Area -->
    <div class="main-content">
        <div class="results-header">
            <div class="results-count" id="resultsCount">15 Results</div>


            <div class="sort-controls">
                <span class="sort-label" id="sortByLabel">Sort By</span>
                <div class="sort-dropdown" id="sortDropdown">
                    <button class="sort-dropdown-button" aria-expanded="false" aria-haspopup="listbox" aria-controls="sortContent" aria-labelledby="sortByLabel sortLabel">
                        <span id="sortLabel">Default</span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="sort-dropdown-content" id="sortContent" role="listbox" aria-label="Sort options">
                        <!-- Date-based sorting -->
                        <div class="sort-group-header" role="presentation">By Date</div>
                        <div class="sort-option" data-sort="newest" role="option">
                            <i class="fas fa-calendar-plus" aria-hidden="true"></i>
                            Newest Effective Date
                        </div>
                        <div class="sort-option" data-sort="oldest-effective" role="option">
                            <i class="fas fa-calendar-minus" aria-hidden="true"></i>
                            Oldest Effective Date
                        </div>
                        <div class="sort-option" data-sort="expiring" role="option">
                            <i class="fas fa-clock" aria-hidden="true"></i>
                            Expiring Soon
                        </div>
                        <div class="sort-option" data-sort="longest-validity" role="option">
                            <i class="fas fa-hourglass-end" aria-hidden="true"></i>
                            Longest Validity Period
                        </div>
                        <div class="sort-option" data-sort="recently-issued" role="option">
                            <i class="fas fa-calendar-check" aria-hidden="true"></i>
                            Recently Issued (Last 30 Days)
                        </div>

                        <!-- Certificate Information -->
                        <div class="sort-group-header" role="presentation">By Certificate</div>
                        <div class="sort-option" data-sort="cert-number-newest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Newest)
                        </div>
                        <div class="sort-option" data-sort="cert-number-oldest" role="option">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                            Certificate Number (Oldest)
                        </div>
                        <div class="sort-option" data-sort="cert-type" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type A-Z
                        </div>
                        <div class="sort-option" data-sort="cert-type-za" role="option">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            Certification Type Z-A
                        </div>

                        <!-- Alphabetical sorting -->
                        <div class="sort-group-header" role="presentation">Alphabetical</div>
                        <div class="sort-option" data-sort="company-az" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company A-Z
                        </div>
                        <div class="sort-option" data-sort="company-za" role="option">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            Company Z-A
                        </div>
                        <div class="sort-option" data-sort="product-az" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name A-Z
                        </div>
                        <div class="sort-option" data-sort="product-za" role="option">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                            Product Name Z-A
                        </div>

                        <!-- Location sorting -->
                        <div class="sort-group-header" role="presentation">By Location</div>
                        <div class="sort-option" data-sort="location-az" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location A-Z
                        </div>
                        <div class="sort-option" data-sort="location-za" role="option">
                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            Location Z-A
                        </div>
                        <div class="sort-option" data-sort="country" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country A-Z
                        </div>
                        <div class="sort-option" data-sort="country-za" role="option">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            Country Z-A
                        </div>

                        <!-- Advanced sorting -->
                        <div class="sort-group-header" role="presentation">Advanced</div>
                        <div class="sort-option" data-sort="popularity" role="option">
                            <i class="fas fa-star" aria-hidden="true"></i>
                            Most Popular Companies
                        </div>
                        <div class="sort-option" data-sort="product-type" role="option">
                            <i class="fas fa-boxes" aria-hidden="true"></i>
                            Product Type A-Z
                        </div>
                        <div class="sort-option" data-sort="relevance" role="option">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            Relevance Score
                        </div>
                        <div class="sort-option" data-sort="status" role="option">
                            <i class="fas fa-check-circle" aria-hidden="true"></i>
                            Status
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- After results-header div -->
        <div class="results-controls">
            <div class="left-controls">
                <div class="export-options">
                    <a href="@Url.Action("Create", "Certificate")" class="btn btn-add">
                        <i class="fas fa-plus"></i> Add Certificate
                    </a>
                    <button class="btn btn-primary" id="downloadSelectedBtn" disabled title="Select certificates in table view to download">
                        <i class="fas fa-download"></i> Download Selected
                    </button>
                    <button class="btn btn-primary" id="exportAllBtn">
                        <i class="fas fa-file-excel"></i> Export All to Excel
                    </button>
                </div>
            </div>

            <div class="right-controls">
                <div class="view-toggle-container">
                    <div class="view-toggle">
                        <button class="toggle-btn active" data-view="tile">
                            <i class="fas fa-th"></i> Tile
                        </button>
                        <button class="toggle-btn" data-view="list">
                            <i class="fas fa-list"></i> List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="certificates-grid" id="certificatesGrid">
            <!-- Certificates will be loaded dynamically by JavaScript -->
        </div>

        <!-- LOADING INDICATOR FOR LAZY LOADING -->
        <div id="loadingIndicator" class="loading-indicator" role="status" aria-live="polite" aria-atomic="true">
            <div class="loading-spinner" aria-hidden="true"></div>
            <div class="loading-text">Loading more certificates...</div>
        </div>

        <!-- TABLE VIEW CONTAINER -->
        <div id="tableView" class="view-container" style="display: none;">
            <!-- Bulk Actions Bar - Compact Selection Info Only -->
            <div class="bulk-actions-bar" style="display: none;" id="bulkActionsBar" role="status">
                <div class="bulk-actions-left">
                    <span class="selected-count" id="selectedCount" aria-live="polite" aria-atomic="true">0 certificates selected</span>
                    <button class="clear-selection-btn" data-action="clear-selection">Clear Selection</button>
                </div>
            </div>

            <!-- Table Grid Container -->
            <div class="table-scroll-wrapper">
                <div class="table-grid-container">
                    <div class="table-grid" id="certificateGrid" role="table" aria-label="Certificates table">

                        <!-- HEADER ROW -->
                        <div class="grid-header" role="rowgroup">
                            <div class="grid-header-cell select-cell" role="columnheader">
                                <input type="checkbox" id="selectAll" title="Select all visible rows" aria-label="Select all certificates">
                            </div>
                            <div class="grid-header-cell actions-column" role="columnheader">
                                <span>Actions</span>
                            </div>
                            <div class="grid-header-cell" data-sort-column="certificate" role="columnheader">
                                Certificate #
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="certificationType" role="columnheader">
                                Certification Type
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="csfAttributes" role="columnheader">
                                CSF Attributes
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="status" role="columnheader">
                                Status
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="effectiveDate" role="columnheader">
                                Effective Date
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="expirationDate" role="columnheader">
                                Expiration Date
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="company" role="columnheader">
                                Company
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="companyContact" role="columnheader">
                                Company Contact Email/URL
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productName" role="columnheader">
                                Product Name
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productCategory" role="columnheader">
                                Product Category
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productType" role="columnheader">
                                Product Type
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="productSubcategory" role="columnheader">
                                Product Type Subcategory
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="location" role="columnheader">
                                Location
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="country" role="columnheader">
                                Country
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="externalTag" role="columnheader">
                                External Tag
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="internalTag" role="columnheader">
                                Internal Tag
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="asin" role="columnheader">
                                ASIN
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="upc" role="columnheader">
                                UPC
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="gtin" role="columnheader">
                                GTIN
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                            <div class="grid-header-cell" data-sort-column="ean" role="columnheader">
                                EAN
                                <i class="fas fa-sort sort-indicator" aria-hidden="true"></i>
                            </div>
                        </div>

                        <!-- BODY CONTAINER -->
                        <div class="grid-body" id="gridBody" role="rowgroup">
                            <!-- Grid rows will be populated here - equivalent to tableBody -->
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <script src="~/js/certificate-tile-view-internal.js"></script>
        <!-- Inline script block removed for CSP compliance -->
        @* All script content moved to external files for CSP compliance *@
    </div>
</div>
