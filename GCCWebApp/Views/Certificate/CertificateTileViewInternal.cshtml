<script>
(function() {
    const modal = document.getElementById('certificate-import-modal');
    const openBtn = document.getElementById('openImportModalBtn');
    const closeBtn = document.getElementById('closeImportModalBtn');
    const cancelBtn = document.getElementById('cancelImportBtn');
    const fileInput = document.getElementById('importFileInput');
    const dropZone = document.getElementById('importDropZone');
    const uploadBtn = document.getElementById('uploadImportBtn');
    const backBtn = document.getElementById('backToUploadBtn');
    const applyBtn = document.getElementById('applyImportBtn');
    const fileNameDisplay = document.getElementById('selectedFileName');

    let selectedFile = null;
    let importId = null;
    let previewData = null;

    // Open modal
    openBtn?.addEventListener('click', () => {
        modal.style.display = 'block';
        resetModal();
    });

    // Close modal
    function closeModal() {
        modal.style.display = 'none';
        resetModal();
    }

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal?.querySelector('.import-modal-backdrop')?.addEventListener('click', closeModal);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.style.display === 'block') {
            closeModal();
        }
    });

    // File selection
    fileInput?.addEventListener('change', (e) => {
        handleFileSelect(e.target.files[0]);
    });

    // Drag and drop
    dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('drag-over');
    });

    dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('drag-over');
    });

    dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file && file.name.endsWith('.csv')) {
            handleFileSelect(file);
        } else {
            showNotification('Please select a CSV file', 'error');
        }
    });

    function handleFileSelect(file) {
        if (!file) return;
        if (!file.name.endsWith('.csv')) {
            showNotification('Please select a CSV file', 'error');
            return;
        }
        selectedFile = file;
        fileNameDisplay.textContent = file.name;
        fileNameDisplay.style.display = 'block';
        uploadBtn.disabled = false;
    }

    // Upload and preview
    uploadBtn?.addEventListener('click', async () => {
        if (!selectedFile) return;

        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';

        const formData = new FormData();
        formData.append('csvFile', selectedFile);

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                          document.querySelector('meta[name="csrf-token"]')?.content;

            const response = await fetch('/api/CertificateImport/Preview', {
                method: 'POST',
                body: formData,
                headers: token ? { 'RequestVerificationToken': token } : {}
            });

            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(errorText || 'Upload failed');
            }

            previewData = await response.json();
            importId = previewData.importId;
            showPreview(previewData);
        } catch (error) {
            showNotification('Upload failed: ' + error.message, 'error');
            uploadBtn.disabled = false;
            uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload & Preview';
        }
    });

    // Back to upload
    backBtn?.addEventListener('click', () => {
        document.getElementById('importStep1').style.display = 'block';
        document.getElementById('importStep2').style.display = 'none';
        uploadBtn.disabled = false;
        uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload & Preview';
    });

    // Apply import
    applyBtn?.addEventListener('click', async () => {
        if (!importId) return;

        // Use AdminCore confirmation modal instead of native confirm()
        const confirmMessage = `${previewData.newCertificates} new certificate(s) will be created and ${previewData.modifiedCertificates} certificate(s) will be updated.`;

        const confirmed = await AdminCore.showConfirmation({
            title: 'Confirm Import',
            message: confirmMessage,
            confirmText: 'Apply Import',
            type: 'warning'
        });

        if (!confirmed) return;

        document.getElementById('importStep2').style.display = 'none';
        document.getElementById('importStep3').style.display = 'block';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                          document.querySelector('meta[name="csrf-token"]')?.content;

            const response = await fetch('/api/CertificateImport/Apply', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({ importId: importId })
            });

            const result = await response.json();

            if (result.success) {
                AdminCore.showNotification(`Import successful! ${result.certificatesCreated} created, ${result.certificatesUpdated} updated.`, 'success');
                closeModal();
                // Refresh the certificate list
                if (typeof loadCertificates === 'function') {
                    loadCertificates();
                } else {
                    location.reload();
                }
            } else {
                throw new Error(result.message || 'Import failed');
            }
        } catch (error) {
            AdminCore.showNotification('Import failed: ' + error.message, 'error');
            document.getElementById('importStep3').style.display = 'none';
            document.getElementById('importStep2').style.display = 'block';
        }
    });

    function showPreview(data) {
        document.getElementById('importStep1').style.display = 'none';
        document.getElementById('importStep2').style.display = 'block';

        // Update stats
        document.getElementById('statTotal').textContent = data.totalRows;
        document.getElementById('statNew').textContent = data.newCertificates;
        document.getElementById('statModified').textContent = data.modifiedCertificates;
        document.getElementById('statDuplicates').textContent = data.unchangedCertificates || 0;
        document.getElementById('statErrors').textContent = data.invalidRows;

        // Show duplicates info (unchanged certificates that already exist)
        const duplicatesInfo = document.getElementById('duplicatesInfo');
        const duplicatesList = document.getElementById('duplicatesList');
        if (data.unchangedRows && data.unchangedRows.length > 0) {
            duplicatesList.innerHTML = data.unchangedRows.map(row =>
                `<span class="duplicate-badge">${row.certificateNumber}</span>`
            ).join('');
            duplicatesInfo.style.display = 'block';
        } else {
            duplicatesInfo.style.display = 'none';
        }

        // Show auto-create info
        const autoCreateInfo = document.getElementById('autoCreateInfo');
        const autoCreateList = document.getElementById('autoCreateList');
        const autoItems = [];
        if (data.companiesToCreate > 0) autoItems.push(`${data.companiesToCreate} company(ies)`);
        if (data.productsToCreate > 0) autoItems.push(`${data.productsToCreate} product(s)`);
        if (data.tagsToCreate > 0) autoItems.push(`${data.tagsToCreate} tag(s)`);

        if (autoItems.length > 0) {
            autoCreateList.innerHTML = autoItems.map(i => `<span class="badge bg-success me-2">${i}</span>`).join('');
            autoCreateInfo.style.display = 'block';
        } else {
            autoCreateInfo.style.display = 'none';
        }

        // Show errors
        const errorsSection = document.getElementById('importErrorsSection');
        const errorsList = document.getElementById('importErrorsList');
        if (data.errorRows && data.errorRows.length > 0) {
            errorsList.innerHTML = data.errorRows.map(e =>
                `<div><strong>Row ${e.rowNumber}:</strong> ${e.errorMessages.join(', ')}</div>`
            ).join('');
            errorsSection.style.display = 'block';
        } else {
            errorsSection.style.display = 'none';
        }

        // Show preview table
        const tbody = document.getElementById('importPreviewBody');
        const rows = [...(data.newRows || []), ...(data.modifiedRows || [])].slice(0, 10);
        tbody.innerHTML = rows.map(row => `
            <tr>
                <td><span class="status-badge status-badge--${row.status === 'New' ? 'new' : 'modified'}">${row.status}</span></td>
                <td><code>${row.certificateNumber}</code></td>
                <td>${row.companyName}</td>
                <td>${row.productName}</td>
                <td>${row.certificationType}</td>
                <td>${row.effectiveDate ? new Date(row.effectiveDate).toLocaleDateString() : ''} - ${row.expirationDate ? new Date(row.expirationDate).toLocaleDateString() : ''}</td>
            </tr>
        `).join('');

        // Enable/disable apply button
        applyBtn.disabled = !data.canApply;
    }

    function resetModal() {
        selectedFile = null;
        importId = null;
        previewData = null;
        fileInput.value = '';
        fileNameDisplay.style.display = 'none';
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload & Preview';
        document.getElementById('importStep1').style.display = 'block';
        document.getElementById('importStep2').style.display = 'none';
        document.getElementById('importStep3').style.display = 'none';
        document.getElementById('importModalTitle').textContent = 'Import Certificates';
    }

    function showNotification(message, type) {
        // Use AdminCore for consistent notifications
        AdminCore.showNotification(message, type);
    }
})();
</script>
}
