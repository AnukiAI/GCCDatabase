@model GCCWebApp.Models.CertificateEditViewModel

@{
    ViewData["Title"] = "Create Certificate";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/certificate-create.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/product-id-manager.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/admin/admin-inline-editing.css" rel="stylesheet" />
}

@section Breadcrumbs {
    @* QC #104 (5\1 follow-up): "Certificate Management" is a top-level nav item, not a child
       of "Administration" — so the trail starts at Certificate Management, not under
       Administration. Same scope-miss pattern as DEF-211 fixed for Companies & Products. *@
    <span class="role-element role-analyst-show role-admin-show">
        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Create Certificate</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">Create Certificate</h1>
                <p class="admin-page-subtitle">Add a new certificate to the GreenCircle Certified database</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Management
                    </a>
                </div>
            </div>
        </div>
    </header>

    @* Success message will be shown as toast notification via JavaScript *@
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        @* QC #193 / DEF-291: show the "created successfully" toast exactly once per server
           render. The guard is keyed on a per-render nonce (NOT the message text) so that
           when the browser restores this page from bfcache/Back/disk-cache — carrying this
           same inline script with the prior cert's message — the nonce is already marked seen
           and the stale toast is suppressed. (TempData is read-once, so a genuine fresh
           "Add Certificate" GET renders no script at all.) *@
        <script>
            (function () {
                var nonce = '@(Guid.NewGuid().ToString("N"))';
                var msg = '@Html.Raw(successMsg.Replace("\\", "\\\\").Replace("'", "\\'"))';
                var seenKey = 'createSuccessMsgShown:' + nonce;
                function showOnce() {
                    try {
                        if (sessionStorage.getItem(seenKey)) return;
                        sessionStorage.setItem(seenKey, '1');
                    } catch (e) { /* sessionStorage unavailable — fall through and show once */ }
                    if (typeof AdminCore !== 'undefined' && AdminCore.showNotification) {
                        AdminCore.showNotification(msg, 'success');
                    }
                }
                // bfcache restore (Back button) re-fires pageshow with persisted=true but NOT
                // DOMContentLoaded; the seen-nonce check below blocks the stale re-show either way.
                window.addEventListener('pageshow', function (e) { if (e.persisted) showOnce(); });
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', showOnce);
                } else {
                    showOnce();
                }
            })();
        </script>
    }

    <div class="admin-content">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate id="certificateCreateForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-section-header">
                <i class="fas fa-file-certificate"></i>
                <span>Certificate Information</span>
            </div>

            <div class="form-grid">
                <div class="main-form">
                    <!-- Company Section -->
                    <div class="form-group">
                        <label asp-for="CompanyId">Company <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CompanyId" class="form-control" required aria-required="true" aria-describedby="company-help">
                            <option value="">Select a company...</option>
                            @if (ViewBag.Companies != null)
                            {
                                @foreach (var company in ViewBag.Companies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CompanyEmail">Company Email <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <input asp-for="CompanyEmail" type="email" placeholder="Auto-populated from company" maxlength="255" />
                        <span asp-validation-for="CompanyEmail" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Pre-filled from company record. Changes here update the company.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="CompanyWebsite">Company URL <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <input asp-for="CompanyWebsite" type="url" placeholder="Auto-populated from company" maxlength="500" />
                        <span asp-validation-for="CompanyWebsite" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Pre-filled from company record. Changes here update the company.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Number">Certification # <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="Number" readonly class="form-control-readonly" aria-required="true" style="background-color: #f8f9fa; font-weight: 600;" />
                        <small class="form-text text-muted">Preview — final number is assigned at save. If another analyst saves first, you'll be given the next available number automatically.</small>
                        <span asp-validation-for="Number" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationTypeId">Certification Type <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CertificationTypeId" id="CertificationTypeId" class="form-control" required aria-required="true">
                            <option value="">Select type...</option>
                            @if (ViewBag.ParentCertificationTypes != null)
                            {
                                @foreach (var certType in ViewBag.ParentCertificationTypes)
                                {
                                    <option value="@certType.Id">@certType.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CertificationTypeId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group" id="subcategory-group">
                        <label>Certificate Subcategories <span class="text-muted" style="font-size: 12px;">(Optional - Multiple)</span></label>
                        <select id="subcategorySelect" class="form-control" aria-label="Select certificate subcategories">
                            <option value="">Select subcategory...</option>
                            <!-- Options populated by JavaScript based on parent type -->
                        </select>
                        <div class="subcategories-container" id="subcategoriesContainer" aria-live="polite" aria-label="Selected subcategories">
                            <!-- Selected subcategories displayed as pills -->
                        </div>
                        <input type="hidden" name="SubcategoryIds" id="subcategoriesHidden" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductId">Product Name <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="ProductId" class="form-control" required aria-required="true">
                            <option value="">Select a company first...</option>
                        </select>
                        <small id="productHelpText" class="form-text text-muted">Select a company to see its products</small>
                        <span asp-validation-for="ProductId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label for="ProductCategoryId">Product Category <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select id="ProductCategoryId" name="ProductCategoryId" class="form-control">
                            <option value="">Select a category...</option>
                            @if (ViewBag.ProductCategories != null)
                            {
                                foreach (var cat in ViewBag.ProductCategories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="ProductTypeId">Product Type <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select id="ProductTypeId" name="ProductTypeId" class="form-control">
                            <option value="">Select category first...</option>
                        </select>
                    </div>

                    <div class="form-group" id="product-subcategory-group">
                        <label for="ProductSubcategoryId">Product Subcategory <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select id="ProductSubcategoryId" name="ProductSubcategoryId" class="form-control">
                            <option value="">Select type first...</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="EffectiveDate">Effective Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="EffectiveDate" type="date" required aria-required="true" />
                        <span asp-validation-for="EffectiveDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ExpirationDate">Expiration Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="ExpirationDate" type="date" required aria-required="true" />
                        <span asp-validation-for="ExpirationDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Status <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="Status" class="form-control" required aria-required="true">
                            <option value="">Select status...</option>
                            @if (ViewBag.Statuses != null)
                            {
                                foreach (var status in ViewBag.Statuses)
                                {
                                    <option value="@status.Key" selected="@(status.Key == "Draft")">@status.Value</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger" role="alert"></span>
                    </div>

                    @{
                        // CR-171: multi-partner. The hidden PartnerIds (CSV of partner IDs) is what the
                        // POST handler consumes; the <select multiple> is the UI that keeps it in sync.
                        var selectedPartnerIds = (Model.PartnerIds ?? "")
                            .Split(',', StringSplitOptions.RemoveEmptyEntries)
                            .Select(s => int.TryParse(s.Trim(), out var n) ? n : -1)
                            .Where(n => n > 0)
                            .ToHashSet();
                    }
                    <div class="form-group">
                        <label for="partnerSelect">Partner(s) <span class="text-muted" style="font-size: 12px;">(Optional - Multiple)</span></label>
                        <select id="partnerSelect" class="form-control" multiple size="4" aria-label="Select one or more partners">
                            @if (ViewBag.Partners != null)
                            {
                                foreach (var partner in ViewBag.Partners)
                                {
                                    <option value="@partner.Id" selected="@(selectedPartnerIds.Contains((int)partner.Id) ? "selected" : null)">@partner.Name</option>
                                }
                            }
                        </select>
                        <input type="hidden" asp-for="PartnerIds" id="partnersHidden" />
                        <small class="form-text text-muted">Select one or more partners. A certificate may be shared with multiple partners; each partner login sees only its own association.</small>
                        <span asp-validation-for="PartnerIds" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationResults">Certification Results <span class="text-muted" style="font-size: 12px;">(Required for Amazon CPF)</span></label>
                        <textarea asp-for="CertificationResults" rows="3" maxlength="1000" placeholder="Enter test results or scores if required by partner (e.g., threshold values for Amazon)"></textarea>
                        <span asp-validation-for="CertificationResults" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Enter numeric certification results (e.g., 65%, 100%)</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="PathwayId">Pathway (for Amazon CPF applicable certs)</label>
                        <select asp-for="PathwayId" class="form-control">
                            <option value="">Select pathway...</option>
                            @if (ViewBag.Pathways != null)
                            {
                                foreach (var pathway in ViewBag.Pathways)
                                {
                                    <option value="@pathway.Id">@pathway.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="PathwayId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Location">Location</label>
                        <input asp-for="Location" placeholder="City, State" maxlength="175" />
                        <span asp-validation-for="Location" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <select asp-for="Country" class="form-control" id="countrySelect">
                            <option value="">Select country...</option>
                            @if (ViewBag.Countries != null)
                            {
                                foreach (var country in (List<string>)ViewBag.Countries)
                                {
                                    <option value="@country">@country</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Country" class="text-danger" role="alert"></span>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="certificate-sidebar">
                    <div class="upload-section card-style">
                        <div class="sidebar-section-header">
                            <div class="section-icon">
                                <i class="fas fa-image"></i>
                            </div>
                            <div>
                                <h3 id="certificate-image-label">Certificate Preview</h3>
                                <p id="certificate-image-help" class="text-muted sidebar-help-text">Auto-generated from uploaded PDF</p>
                            </div>
                        </div>
                        <div class="preview-container certificate-create-preview">
                            <div class="no-preview">
                                <i class="fas fa-file-pdf"></i>
                                <p>Certificate Unavailable</p>
                                <small>Upload a PDF to generate preview</small>
                            </div>
                        </div>
                        <input type="hidden" asp-for="CertificateImagePath" id="certificateImagePathHidden" />
                    </div>

                    <div class="tags-section card-style">
                        <div class="sidebar-section-header">
                            <div class="section-icon">
                                <i class="fas fa-tags"></i>
                            </div>
                            <h3>Certificate Tags</h3>
                        </div>

                        <div class="tags-group">
                            <label for="externalTagSelect">External Tags</label>
                            <select id="externalTagSelect" aria-label="Select external tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.ExternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.ExternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="externalTagsContainer" aria-live="polite" aria-label="Selected external tags">
                                <!-- External tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="ExternalTags" id="externalTagsHidden" />
                        </div>

                        <div class="tags-group">
                            <label for="internalTagSelect">Internal Tags</label>
                            <select id="internalTagSelect" aria-label="Select internal tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.InternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.InternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="internalTagsContainer" aria-live="polite" aria-label="Selected internal tags">
                                <!-- Internal tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="InternalTags" id="internalTagsHidden" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate PDF Upload Section -->
            <div class="certificate-section card-style">
                <div class="form-section-header">
                    <i class="fas fa-file-pdf"></i>
                    <span>Certificate PDF Document</span>
                </div>
                <div class="form-group">
                    <label for="certificatePdf">Upload PDF Certificate <span class="text-danger" aria-label="required">*</span></label>
                    <div class="pdf-upload-zone" id="pdfUploadZone" role="button" tabindex="0" aria-label="Upload PDF certificate. Press Enter or Space to browse files, or drag and drop a PDF file here. Maximum file size 10MB." onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('certificatePdf').click();}">
                        <div class="pdf-upload-placeholder">
                            <i class="fas fa-file-pdf" aria-hidden="true"></i>
                        </div>
                        <div class="pdf-upload-text">Drag and drop PDF here or click to select</div>
                        <small style="color: #6c757d; font-size: 16px;">Maximum file size: 10MB</small>
                    </div>
                    <input type="file" id="certificatePdf" name="certificatePdf" accept="application/pdf" style="display: none;" required aria-required="true" aria-describedby="pdf-help pdf-requirements" />
                    <small id="pdf-help" class="form-text text-muted">PDF file required for certificate creation. Image preview will be generated automatically.</small>
                    <small id="pdf-requirements" class="admin-sr-only">File must be PDF format, maximum 10 megabytes</small>
                    <div id="pdfPreviewContainer" aria-live="polite" aria-atomic="true"></div>
                </div>
            </div>

            <!-- Product ID Manager -->
            <div class="product-manager card-style">
                <div class="form-section-header">
                    <i class="fas fa-barcode"></i>
                    <span>Product Identifiers</span>
                </div>
                <p class="section-description">Manage ASINs, UPCs, GTINs, and other product identifiers</p>
                @{
                    ViewData["CertificateId"] = 0; // New certificate, no ID yet
                    ViewData["IsReadOnly"] = false;
                }
                @await Html.PartialAsync("_ProductIdManager", Model.ProductIds)
            </div>

            <div class="card-style" style="margin-bottom: 24px;">
                <div class="form-section-header">
                    <i class="fas fa-sliders-h"></i>
                    <span>Additional Fields</span>
                </div>

                <div id="custom-fields-container" class="mb-4">
                    <p class="text-muted">Select a certification type to load additional fields.</p>
                </div>
            </div>

            <div class="action-buttons">
                <button type="submit" name="action" value="save" class="btn btn-primary" aria-label="Save certificate">
                    Save
                </button>
                <button type="submit" name="action" value="saveAndAddAnother" class="btn btn-primary" aria-label="Save certificate and add another">
                    Save & Add Another
                </button>
                <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-secondary" aria-label="Cancel and return to certificate management">
                    Cancel
                </a>
                <button type="reset" class="btn btn-outline" aria-label="Reset form to default values">
                    Reset Form
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Image Zoom Modal - Uses CSS from main.css for consistent styling -->
<div id="imageZoomModal" class="image-zoom-modal" onclick="closeImageZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage" alt="Certificate Preview">
    <div class="zoom-caption" id="imageCaption">Certificate Preview - Click anywhere to close</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/product-id-manager.js" asp-append-version="true"></script>
    <script src="~/js/certificate-custom-fields.js" asp-append-version="true"></script>
    <script src="~/js/certificate-create.js" asp-append-version="true"></script>
    <script src="~/js/certificate-inline-create.js" asp-append-version="true"></script>
    <script src="~/js/partner-multiselect.js" asp-append-version="true"></script>
    <script src="~/js/searchable-select.js" asp-append-version="true"></script>
    <script>
        var certTypeSearch = new SearchableSelect('#CertificationTypeId', { placeholder: 'Search certification types...' });
        var productCategorySearch = new SearchableSelect('#ProductCategoryId', { placeholder: 'Search product categories...' });
        new SearchableSelect('#countrySelect', { placeholder: 'Search countries...' });
        // Company and Product dropdowns are handled by certificate-inline-create.js (createCustomDropdown)
        // which provides search + "Add New" functionality. Do NOT also wrap them with SearchableSelect.
    </script>

    <script>
        // CR-171: keep hidden PartnerIds (CSV of partner IDs) in sync with the multi-select.
        (function () {
            var sel = document.getElementById('partnerSelect');
            var hidden = document.getElementById('partnersHidden');
            if (!sel || !hidden) return;
            function sync() {
                hidden.value = Array.from(sel.selectedOptions).map(function (o) { return o.value; }).join(',');
            }
            sel.addEventListener('change', sync);
            sync(); // capture any server-side pre-selection on load
        })();
    </script>

    <script>
        // Image zoom functionality
        function openImageZoom(imageSrc) {
            const modal = document.getElementById('imageZoomModal');
            const modalImg = document.getElementById('zoomedImage');
            const caption = document.getElementById('imageCaption');

            modal.style.display = 'block';
            modalImg.src = imageSrc;
            caption.innerHTML = 'Certificate Preview - Click anywhere to close';

            // Prevent body scroll when modal is open
            document.body.style.overflow = 'hidden';
        }

        function closeImageZoom() {
            const modal = document.getElementById('imageZoomModal');
            modal.style.display = 'none';

            // Restore body scroll
            document.body.style.overflow = 'auto';
        }

        // Close on ESC key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeImageZoom();
            }
        });

        // Store all certification types for subcategory filtering
        var allCertificationTypes = @Html.Raw(Json.Serialize(ViewBag.AllCertificationTypes ?? new List<object>()));

        // Store product data for auto-fill when product is selected
        var companyProducts = [];

        $(document).ready(function() {
            // QC #186 follow-up: guard used while restoring posted state after a validation
            // re-render, so the product->category auto-fill can't overwrite the posted category.
            let suppressProductAutoFillCreate = false;

            // ===== Company → Product Cascading Dropdown (REQ-CERT-10) =====

            // When company changes, load that company's products
            $('#CompanyId').change(async function() {
                const companyId = $(this).val();
                const productSelect = $('#ProductId');
                const helpText = $('#productHelpText');

                // Reset product and dependent dropdowns
                productSelect.html('<option value="">Select a product...</option>');
                $('#ProductCategoryId').val('');
                // Keep the SearchableSelect display in sync with the cleared native value.
                document.querySelector('#ProductCategoryId')?._searchableSelect?.refresh();
                $('#ProductTypeId').html('<option value="">Select category first...</option>');
                $('#ProductSubcategoryId').html('<option value="">Select type first...</option>');
                companyProducts = [];

                if (companyId) {
                    helpText.text('Loading products...');
                    try {
                        const response = await fetch(`/Certificate/GetProductsByCompany?companyId=${companyId}`);
                        const result = await response.json();
                        if (result.success && result.data) {
                            companyProducts = result.data;
                            if (result.data.length > 0) {
                                result.data.forEach(p => {
                                    productSelect.append(`<option value="${p.id}">${p.name}</option>`);
                                });
                                helpText.text(`${result.data.length} product(s) found`);
                            } else {
                                helpText.text('No products found for this company. Use "Add New" below.');
                            }
                            // Auto-populate company email/website
                            $('#CompanyEmail').val(result.companyEmail || '');
                            $('#CompanyWebsite').val(result.companyWebsite || '');
                        }
                    } catch (error) {
                        console.error('Error loading products by company:', error);
                        helpText.text('Error loading products');
                    }
                } else {
                    helpText.text('Select a company to see its products');
                    // Clear company email/website when no company selected
                    $('#CompanyEmail').val('');
                    $('#CompanyWebsite').val('');
                }
            });

            // When product changes: do NOT auto-fill Product Category/Type/Subcategory.
            // QC #195 (Shawn, 2026-06-24 decision): Product Category is optional and
            // analyst-controlled. Previously, picking a product copied that product's hierarchy
            // onto the cert, which propagated the mis-filed default category ("Chemical and Raw
            // Materials") whenever the product itself was mis-categorized. The analyst now sets
            // Category → Type → Subcategory by hand; the picked product's own value is unchanged.
            // (The suppressProductAutoFillCreate guard / DEF-246 restore plumbing below is left
            // intact — it's now a no-op for the hierarchy but still scopes the posted-state restore.)
            $('#ProductId').change(function() {
                // No hierarchy auto-fill by design (QC #195).
            });

            // ===== Product Category/Type/Subcategory 3-Level Cascading Dropdowns =====

            // When product category changes, load types filtered by category
            $('#ProductCategoryId').change(async function() {
                const categoryId = $(this).val();
                const typeSelect = $('#ProductTypeId');
                const subcategorySelect = $('#ProductSubcategoryId');

                // Clear dependent dropdowns
                typeSelect.html('<option value="">Select type...</option>');
                subcategorySelect.html('<option value="">Select type first...</option>');

                if (categoryId) {
                    try {
                        const response = await fetch(`/Certificate/GetProductTypes?categoryId=${categoryId}`);
                        const result = await response.json();
                        if (result.success && result.data) {
                            typeSelect.html('<option value="">Select a type...</option>');
                            result.data.forEach(pt => {
                                typeSelect.append(`<option value="${pt.id}">${pt.name}</option>`);
                            });
                        }
                    } catch (error) {
                        console.error('Error loading product types:', error);
                    }
                }
            });

            // When product type changes, load subcategories (children in ProductTypes table)
            $('#ProductTypeId').change(async function() {
                const typeId = $(this).val();
                const subcategorySelect = $('#ProductSubcategoryId');

                // Clear subcategory options
                subcategorySelect.html('<option value="">Select subcategory...</option>');

                if (typeId) {
                    try {
                        const response = await fetch(`/Certificate/GetProductSubcategories?productTypeId=${typeId}`);
                        const result = await response.json();
                        if (result.success && result.data && result.data.length > 0) {
                            result.data.forEach(sub => {
                                subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                            });
                        } else {
                            subcategorySelect.html('<option value="">No subcategories available</option>');
                        }
                    } catch (error) {
                        console.error('Error loading product subcategories:', error);
                    }
                }
            });

            // ===== Certification Type Subcategories (Multi-Select with Checkboxes) =====

            // Load subcategories when certification type changes
            $('#CertificationTypeId').change(function() {
                const typeId = $(this).val();
                const subcategorySelect = $('#subcategorySelect');

                // Clear existing subcategory options
                subcategorySelect.html('<option value="">Select subcategory...</option>');

                // Clear selected subcategories when parent type changes
                if (window.CertificateInlineCreate && window.CertificateInlineCreate.clearSubcategories) {
                    window.CertificateInlineCreate.clearSubcategories();
                }

                if (typeId) {
                    // Filter subcategories for the selected parent type, sorted alphabetically
                    const subcategories = allCertificationTypes
                        .filter(ct => ct.parentId === parseInt(typeId))
                        .sort((a, b) => a.name.localeCompare(b.name));

                    if (subcategories.length > 0) {
                        // Add subcategory options
                        subcategories.forEach(sub => {
                            subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                        });
                    }

                    // Refresh the multi-select dropdown to show new options
                    if (window.CertificateInlineCreate && window.CertificateInlineCreate.refreshSubcategories) {
                        setTimeout(() => window.CertificateInlineCreate.refreshSubcategories(), 50);
                    }

                    // Load custom fields for the selected type (only if container exists)
                    if (typeof certificateCustomFields !== 'undefined' && document.getElementById('custom-fields-container')) {
                        try {
                            certificateCustomFields.loadFieldsForType(typeId);
                        } catch (err) {
                            console.warn('Custom fields load error (non-blocking):', err);
                        }
                    }
                } else {
                    // Custom fields container may be hidden for initial phase
                    const customFieldsContainer = document.getElementById('custom-fields-container');
                    if (customFieldsContainer) {
                        customFieldsContainer.innerHTML = '<p class="text-muted">Select a certification type to load custom fields.</p>';
                    }
                }
            });

            // Load fields if type is already selected
            const initialTypeId = $('#CertificationTypeId').val();
            if (initialTypeId) {
                $('#CertificationTypeId').trigger('change');
            }

            // ===== Restore posted selections after a server-side validation re-render (QC #186 follow-up) =====
            // CompanyId + CertificationTypeId survive via asp-for, but Product, the Product
            // Category/Type/Subcategory cascade, and the cert Subcategories are JS-driven and would
            // otherwise be lost when the server re-renders the Create form on a validation error.
            const savedCompanyId  = '@(Model.CompanyId > 0 ? Model.CompanyId.ToString() : "")';
            const savedProductId  = '@(Model.ProductId > 0 ? Model.ProductId.ToString() : "")';
            const savedCategoryId = '@(Model.ProductCategoryId?.ToString() ?? "")';
            const savedTypeId     = '@(Model.ProductTypeId?.ToString() ?? "")';
            const savedSubId      = '@(Model.ProductSubcategoryId?.ToString() ?? "")';
            const postedCertSubsRaw = '@Html.Raw(ViewBag.PostedSubcategoryIds ?? "")';

            async function restorePostedCreateState() {
                if (!savedCompanyId) return; // fresh Create — nothing to restore

                // 1) Reload the company's products and re-select the posted product (suppress the
                //    product->category auto-fill so it can't overwrite the posted category).
                suppressProductAutoFillCreate = true;
                $('#CompanyId').trigger('change');
                for (let i = 0; i < 50 && $('#ProductId option').length <= 1; i++) { await new Promise(r => setTimeout(r, 100)); }
                if (savedProductId) {
                    $('#ProductId').val(savedProductId);
                    $('#ProductId')[0].dispatchEvent(new Event('change', { bubbles: true }));
                }
                suppressProductAutoFillCreate = false;

                // 2) Restore the posted Product Category/Type/Subcategory (authoritative).
                if (savedCategoryId) {
                    $('#ProductCategoryId').val(savedCategoryId);
                    document.querySelector('#ProductCategoryId')?._searchableSelect?.refresh(savedCategoryId);
                    try {
                        const tr = await (await fetch(`/Certificate/GetProductTypes?categoryId=${savedCategoryId}`)).json();
                        if (tr.success && tr.data) {
                            const typeSel = $('#ProductTypeId');
                            typeSel.html('<option value="">Select a type...</option>');
                            tr.data.forEach(pt => typeSel.append(`<option value="${pt.id}">${pt.name}</option>`));
                            if (savedTypeId) {
                                typeSel.val(savedTypeId);
                                const sr = await (await fetch(`/Certificate/GetProductSubcategories?productTypeId=${savedTypeId}`)).json();
                                if (sr.success && sr.data && sr.data.length) {
                                    const subSel = $('#ProductSubcategoryId');
                                    subSel.html('<option value="">Select subcategory...</option>');
                                    sr.data.forEach(s => subSel.append(`<option value="${s.id}">${s.name}</option>`));
                                    if (savedSubId) subSel.val(savedSubId);
                                }
                            }
                        }
                    } catch (e) { console.error('Error restoring product cascade:', e); }
                }

                // 3) Restore the posted cert Subcategories into the multi-select (after the
                //    CertificationType change above has loaded/cleared its options).
                let postedCertSubs = [];
                try { postedCertSubs = JSON.parse(postedCertSubsRaw || '[]'); } catch (e) { postedCertSubs = []; }
                if (Array.isArray(postedCertSubs) && postedCertSubs.length && $('#CertificationTypeId').val()) {
                    setTimeout(() => {
                        const items = postedCertSubs.map(id => {
                            const m = (window.allCertificationTypes || []).find(c => c.id === parseInt(id));
                            return { id: parseInt(id), name: m ? m.name : String(id) };
                        });
                        if (window.CertificateInlineCreate && window.CertificateInlineCreate.loadExistingSubcategories) {
                            window.CertificateInlineCreate.loadExistingSubcategories(items);
                        }
                    }, 350);
                }

                // 4) Restore posted Tags (external + internal) — same class of JS-driven field.
                restorePostedTags('@Html.Raw(ViewBag.PostedExternalTags ?? "")', 'external', 'externalTagSelect', 'externalTagsContainer', 'externalTagsHidden');
                restorePostedTags('@Html.Raw(ViewBag.PostedInternalTags ?? "")', 'internal', 'internalTagSelect', 'internalTagsContainer', 'internalTagsHidden');
            }

            function restorePostedTags(rawJson, type, selectId, containerId, hiddenId) {
                let ids = [];
                try { ids = JSON.parse(rawJson || '[]'); } catch (e) { ids = []; }
                if (!Array.isArray(ids) || !ids.length) return;
                const sel = document.getElementById(selectId);
                const container = document.getElementById(containerId);
                window.CertificateCreate = window.CertificateCreate || {};
                window.CertificateCreate.TagManager = window.CertificateCreate.TagManager || { externalTags: [], internalTags: [] };
                const bucket = type === 'external' ? window.CertificateCreate.TagManager.externalTags : window.CertificateCreate.TagManager.internalTags;
                ids.forEach(id => {
                    const idNum = parseInt(id);
                    const opt = sel ? Array.from(sel.options).find(o => parseInt(o.value) === idNum) : null;
                    const name = opt ? opt.textContent : String(id);
                    if (!bucket.includes(idNum)) {
                        bucket.push(idNum);
                        if (container) {
                            const el = document.createElement('span');
                            el.className = `tag ${type}`;
                            el.dataset.tagId = idNum;
                            el.innerHTML = `${name} <button type="button" class="tag-remove" onclick="window.CertificateCreate.removeTag('${idNum}', '${type}')">&times;</button>`;
                            container.appendChild(el);
                        }
                    }
                });
                const hidden = document.getElementById(hiddenId);
                if (hidden) hidden.value = JSON.stringify(bucket);
            }
            restorePostedCreateState();

            // Intercept form submission to handle custom fields
            const form = document.getElementById('certificateCreateForm');

            // Cross-field rule: Expiration Date must be after Effective Date.
            // type="date" values are yyyy-MM-dd, so a string compare is chronological.
            // Validates LIVE on either date's change (fires regardless of other required
            // fields, which otherwise block the submit event from ever dispatching), and is
            // re-checked in the submit handler. Mirrors the server-side IValidatableObject
            // check on CertificateEditViewModel.
            function validateCertDateRange() {
                const effEl = document.getElementById('EffectiveDate');
                const expEl = document.getElementById('ExpirationDate');
                document.querySelectorAll('.date-range-error').forEach(el => el.remove());
                expEl?.closest('.form-group')?.classList.remove('has-error');
                if (effEl && expEl && effEl.value && expEl.value && expEl.value <= effEl.value) {
                    const fg = expEl.closest('.form-group');
                    if (fg) {
                        fg.classList.add('has-error');
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'inline-validation-error date-range-error';
                        errorDiv.textContent = 'Expiration Date must be after the Effective Date.';
                        expEl.insertAdjacentElement('afterend', errorDiv);
                    }
                    return false;
                }
                return true;
            }
            document.getElementById('EffectiveDate')?.addEventListener('change', validateCertDateRange);
            document.getElementById('ExpirationDate')?.addEventListener('change', validateCertDateRange);

            form.addEventListener('submit', function(e) {
                try {
                    // Re-check the date range; block + scroll to the field if invalid.
                    if (!validateCertDateRange()) {
                        e.preventDefault();
                        e.stopPropagation();
                        document.getElementById('ExpirationDate')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return false;
                    }

                    // Only validate custom fields if container exists and fields are loaded
                    const customFieldsContainer = document.getElementById('custom-fields-container');
                    if (customFieldsContainer && typeof certificateCustomFields !== 'undefined' && certificateCustomFields.fields && certificateCustomFields.fields.length > 0) {
                        const validation = certificateCustomFields.validateFields();
                        if (!validation.isValid) {
                            e.preventDefault();
                            e.stopPropagation();
                            // Clear previous custom field errors
                            customFieldsContainer.querySelectorAll('.inline-validation-error').forEach(el => el.remove());
                            customFieldsContainer.querySelectorAll('.form-group.has-error').forEach(fg => fg.classList.remove('has-error'));

                            // Add inline error for each invalid custom field
                            validation.errors.forEach(error => {
                                const formGroups = customFieldsContainer.querySelectorAll('.form-group');
                                formGroups.forEach(fg => {
                                    const label = fg.querySelector('label');
                                    if (label && error.includes(label.textContent.replace('*', '').trim())) {
                                        fg.classList.add('has-error');
                                        const errorDiv = document.createElement('div');
                                        errorDiv.className = 'inline-validation-error';
                                        errorDiv.textContent = error;
                                        const input = fg.querySelector('input, select, textarea');
                                        if (input) {
                                            input.insertAdjacentElement('afterend', errorDiv);
                                        }
                                    }
                                });
                            });

                            customFieldsContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            return false;
                        }

                        // Get custom field values and add them to the form
                        const fieldValues = certificateCustomFields.getFieldValues();
                        form.querySelectorAll('input[name^="CustomFieldValues"]').forEach(input => input.remove());
                        Object.keys(fieldValues).forEach(fieldId => {
                            const hiddenInput = document.createElement('input');
                            hiddenInput.type = 'hidden';
                            hiddenInput.name = `CustomFieldValues[${fieldId}]`;
                            hiddenInput.value = fieldValues[fieldId] || '';
                            form.appendChild(hiddenInput);
                        });
                    }

                    // Add Product IDs to the form (from Product ID Manager)
                    if (typeof window.productIdManager !== 'undefined' && window.productIdManager.productIds && window.productIdManager.productIds.length > 0) {
                        form.querySelectorAll('input[name^="ProductIds"]').forEach(input => input.remove());
                        window.productIdManager.productIds.forEach((pid, index) => {
                            const fields = {
                                'CertificateId': 0,
                                'ProductIdType': pid.productIdType || '',
                                'ProductIdValue': pid.productIdValue || '',
                                'Status': pid.status || 'Active',
                                'Partner': pid.partner || '',
                                'ProductName': pid.productName || '',
                                'ProductSku': pid.productSku || '',
                                'Description': pid.description || ''
                            };
                            Object.entries(fields).forEach(([key, value]) => {
                                const hiddenInput = document.createElement('input');
                                hiddenInput.type = 'hidden';
                                hiddenInput.name = `ProductIds[${index}].${key}`;
                                hiddenInput.value = value;
                                form.appendChild(hiddenInput);
                            });
                        });
                    }

                    return true;
                } catch (error) {
                    console.error('Error in form submit handler:', error);
                    return true;
                }
            });
        });

        // Store original certificate create success handler
        if (typeof window.certificateCreateSuccess === 'undefined') {
            window.originalCertificateCreateSuccess = window.certificateCreateSuccess || function() {};

            // Override success handler to save custom fields after certificate creation
            window.certificateCreateSuccess = async function(result) {
                if (result && result.success && result.certificateId) {
                    // Save custom field values
                    const fieldsSaved = await certificateCustomFields.saveFieldValues(result.certificateId);
                    if (fieldsSaved) {
                        // Redirect to details page
                        window.location.href = `/Certificate/CertificateInternalView/${result.certificateId}`;
                    }
                } else {
                    // Call original success handler if no certificate ID
                    window.originalCertificateCreateSuccess(result);
                }
            };
        }
    </script>
}
