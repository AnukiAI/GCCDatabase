@model GCCWebApp.Models.CertificateEditViewModel

@{
    ViewData["Title"] = "Create Certificate";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/certificate-create.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/product-id-manager.css" asp-append-version="true" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Create Certificate</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Add a new certificate to the GreenCircle Certified database</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Management
                    </a>
                </div>
            </div>
        </div>
    </header>

    @* Success message will be shown as toast notification via JavaScript *@
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof AdminCore !== 'undefined' && AdminCore.showNotification) {
                    AdminCore.showNotification('@Html.Raw(successMsg.Replace("'", "\\'"))', 'success');
                }
            });
        </script>
    }

    <div class="admin-content">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate id="certificateCreateForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-section-header">
                <i class="fas fa-file-certificate"></i>
                <span>Certificate Information</span>
            </div>

            <div class="form-grid">
                <div class="main-form">
                    <!-- Company Section -->
                    <div class="form-group">
                        <label asp-for="CompanyId">Company <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CompanyId" required aria-required="true" aria-describedby="company-help">
                            <option value="">Select a company...</option>
                            @if (ViewBag.Companies != null)
                            {
                                @foreach (var company in ViewBag.Companies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Number">Certification # <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="Number" readonly class="form-control-readonly" aria-required="true" style="background-color: #f8f9fa; font-weight: 600;" />
                        <small class="form-text text-muted">Auto-generated (format: YY-XXXX)</small>
                        <span asp-validation-for="Number" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationTypeId">Certification Type <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CertificationTypeId" id="CertificationTypeId" required aria-required="true">
                            <option value="">Select type...</option>
                            @if (ViewBag.ParentCertificationTypes != null)
                            {
                                @foreach (var certType in ViewBag.ParentCertificationTypes)
                                {
                                    <option value="@certType.Id">@certType.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CertificationTypeId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group" id="subcategory-group">
                        <label asp-for="CertificationTypeSubcategoryId">Certificate Subcategory <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select asp-for="CertificationTypeSubcategoryId" id="CertificationTypeSubcategoryId">
                            <option value="">Select subcategory...</option>
                        </select>
                        <span asp-validation-for="CertificationTypeSubcategoryId" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Select a subcategory if applicable</small>
                    </div>

                    <div class="form-group">
                        <label for="ProductTypeId">Product Type <span class="text-muted" style="font-size: 12px;">(Optional - filters products)</span></label>
                        <select id="ProductTypeId" name="ProductTypeId">
                            <option value="">All Product Types</option>
                        </select>
                        <small class="form-text text-muted">Select to filter products by type</small>
                    </div>

                    <div class="form-group" id="product-subcategory-group">
                        <label for="ProductSubcategoryId">Product Subcategory <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select id="ProductSubcategoryId" name="ProductSubcategoryId">
                            <option value="">All Subcategories</option>
                        </select>
                        <small class="form-text text-muted">Select to further filter products</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductId">Product Name <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="ProductId" required aria-required="true">
                            <option value="">Select a product...</option>
                            @if (ViewBag.Products != null)
                            {
                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id">@product.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EffectiveDate">Effective Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="EffectiveDate" type="date" required aria-required="true" />
                        <span asp-validation-for="EffectiveDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ExpirationDate">Expiration Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="ExpirationDate" type="date" required aria-required="true" />
                        <span asp-validation-for="ExpirationDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Status <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="Status" required aria-required="true">
                            <option value="">Select status...</option>
                            @if (ViewBag.Statuses != null)
                            {
                                foreach (var status in ViewBag.Statuses)
                                {
                                    <option value="@status.Key" selected="@(status.Key == "Draft")">@status.Value</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Partner">Partner</label>
                        <select asp-for="Partner">
                            <option value="">None</option>
                            <option value="Amazon">Amazon</option>
                            <option value="Novi">Novi</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Partner" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationResults">Certification Results <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <textarea asp-for="CertificationResults" rows="3" maxlength="1000" placeholder="Enter test results or scores if required by partner (e.g., threshold values for Amazon)"></textarea>
                        <span asp-validation-for="CertificationResults" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Optional field for recording certification test results or scores.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Location">Location</label>
                        <input asp-for="Location" placeholder="City, State" maxlength="175" />
                        <span asp-validation-for="Location" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <select asp-for="Country">
                            <option value="">Select country...</option>
                            <option value="United States">United States</option>
                            <option value="Canada">Canada</option>
                            <option value="Mexico">Mexico</option>
                            <option value="United Kingdom">United Kingdom</option>
                            <option value="Germany">Germany</option>
                        </select>
                        <span asp-validation-for="Country" class="text-danger" role="alert"></span>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="certificate-sidebar">
                    <div class="upload-section card-style">
                        <div class="section-icon">
                            <i class="fas fa-image"></i>
                        </div>
                        <h3 id="certificate-image-label">Certificate Preview</h3>
                        <p id="certificate-image-help" class="text-muted" style="font-size: 13px;">Auto-generated from uploaded PDF</p>
                        <div class="preview-container" style="width: 350px; height: 350px; display: flex; align-items: center; justify-content: center; background: white; border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden; position: relative;">
                            <div class="no-preview" style="text-align: center; color: #6c757d;">
                                <i class="fas fa-file-pdf" style="font-size: 48px; color: #adb5bd; margin-bottom: 12px; display: block;"></i>
                                <p style="font-size: 14px; font-weight: 600; color: #6c757d; margin: 0 0 4px 0;">Certificate Unavailable</p>
                                <small style="color: #adb5bd; font-size: 11px;">Upload a PDF to generate preview</small>
                            </div>
                        </div>
                        <input type="hidden" asp-for="CertificateImagePath" id="certificateImagePathHidden" />
                    </div>

                    <div class="tags-section card-style">
                        <div class="section-icon">
                            <i class="fas fa-tags"></i>
                        </div>
                        <h3>Certificate Tags</h3>

                        <div class="tags-group">
                            <label for="externalTagSelect">External Tags</label>
                            <select id="externalTagSelect" aria-label="Select external tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.ExternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.ExternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="externalTagsContainer" aria-live="polite" aria-label="Selected external tags">
                                <!-- External tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="ExternalTags" id="externalTagsHidden" />
                        </div>

                        <div class="tags-group">
                            <label for="internalTagSelect">Internal Tags</label>
                            <select id="internalTagSelect" aria-label="Select internal tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.InternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.InternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="internalTagsContainer" aria-live="polite" aria-label="Selected internal tags">
                                <!-- Internal tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="InternalTags" id="internalTagsHidden" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate PDF Upload Section -->
            <div class="certificate-section card-style">
                <div class="form-section-header">
                    <i class="fas fa-file-pdf"></i>
                    <span>Certificate PDF Document</span>
                </div>
                <div class="form-group">
                    <label for="certificatePdf">Upload PDF Certificate <span class="text-danger" aria-label="required">*</span></label>
                    <div class="pdf-upload" id="pdfUploadZone" role="button" tabindex="0" aria-label="Upload PDF certificate file. You can drag and drop a file here or press Enter to select a file." onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('certificatePdf').click();}">
                        <i class="fas fa-file-pdf" style="font-size: 48px; color: #FFC107; margin-bottom: 12px;"></i>
                        <div class="pdf-upload-text">Drag and drop PDF here or click to select</div>
                        <small style="color: #6c757d; font-size: 13px;">Maximum file size: 10MB</small>
                    </div>
                    <input type="file" id="certificatePdf" name="certificatePdf" accept="application/pdf" style="display: none;" required aria-required="true" aria-describedby="pdf-help" />
                    <div id="pdfPreviewContainer" aria-live="polite"></div>
                </div>
            </div>

            <!-- Product ID Manager -->
            <div class="product-manager card-style">
                <div class="form-section-header">
                    <i class="fas fa-barcode"></i>
                    <span>Product Identifiers</span>
                </div>
                <p class="section-description">Manage ASINs, UPCs, GTINs, and other product identifiers</p>
                @{
                    ViewData["CertificateId"] = 0; // New certificate, no ID yet
                    ViewData["IsReadOnly"] = false;
                }
                @await Html.PartialAsync("_ProductIdManager", Model.ProductIds)
            </div>

            <!-- Custom Fields Section -->
            <div class="card-style" style="margin-bottom: 24px;">
                <div class="form-section-header">
                    <i class="fas fa-sliders-h"></i>
                    <span>Custom Fields</span>
                </div>

                <div id="custom-fields-container" class="mb-4">
                    <p class="text-muted">Select a certification type to load custom fields.</p>
                </div>
            </div>

            <div class="action-buttons">
                <button type="submit" name="action" value="save" class="btn btn-primary" aria-label="Save certificate">
                    <i class="fas fa-save" aria-hidden="true"></i> Save
                </button>
                <button type="submit" name="action" value="saveAndAddAnother" class="btn btn-primary" aria-label="Save certificate and add another">
                    <i class="fas fa-plus" aria-hidden="true"></i> Save & Add Another
                </button>
                <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-outline" aria-label="Cancel and return to certificate management">
                    <i class="fas fa-times" aria-hidden="true"></i> Cancel
                </a>
                <button type="reset" class="btn btn-outline" aria-label="Reset form to default values">
                    <i class="fas fa-undo" aria-hidden="true"></i> Reset Form
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="image-zoom-modal" onclick="closeImageZoom()" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.9); overflow: auto;">
    <span class="zoom-close" style="position: absolute; top: 15px; right: 35px; color: #f1f1f1; font-size: 40px; font-weight: bold; cursor: pointer;">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage" style="margin: auto; display: block; max-width: 90%; max-height: 90%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 10px; border-radius: 4px;">
    <div class="zoom-caption" id="imageCaption" style="margin: auto; display: block; width: 80%; max-width: 700px; text-align: center; color: #ccc; padding: 10px 0; position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);">Certificate Preview - Click anywhere to close</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/product-id-manager.js"></script>
    <script src="~/js/certificate-custom-fields.js"></script>
    <script src="~/js/certificate-create.js"></script>
    <script src="~/js/certificate-inline-create.js"></script>

    <script>
        // Image zoom functionality
        function openImageZoom(imageSrc) {
            const modal = document.getElementById('imageZoomModal');
            const modalImg = document.getElementById('zoomedImage');
            const caption = document.getElementById('imageCaption');

            modal.style.display = 'block';
            modalImg.src = imageSrc;
            caption.innerHTML = 'Certificate Preview - Click anywhere to close';

            // Prevent body scroll when modal is open
            document.body.style.overflow = 'hidden';
        }

        function closeImageZoom() {
            const modal = document.getElementById('imageZoomModal');
            modal.style.display = 'none';

            // Restore body scroll
            document.body.style.overflow = 'auto';
        }

        // Close on ESC key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeImageZoom();
            }
        });

        // Store all certification types for subcategory filtering
        var allCertificationTypes = @Html.Raw(Json.Serialize(ViewBag.AllCertificationTypes ?? new List<object>()));

        $(document).ready(function() {
            // ===== Product Type/Subcategory Cascading Dropdowns =====

            // Load product types on page load
            async function loadProductTypes() {
                try {
                    const response = await fetch('/Certificate/GetProductTypes');
                    const result = await response.json();
                    if (result.success && result.data) {
                        const productTypeSelect = $('#ProductTypeId');
                        productTypeSelect.html('<option value="">All Product Types</option>');

                        // Filter to only show parent types (level 0 or no parent)
                        const parentTypes = result.data.filter(pt => !pt.parentId || pt.level === 0);
                        parentTypes.forEach(pt => {
                            productTypeSelect.append(`<option value="${pt.id}">${pt.name}</option>`);
                        });
                    }
                } catch (error) {
                    console.error('Error loading product types:', error);
                }
            }

            // Load product types on page load
            loadProductTypes();

            // When product type changes, load subcategories and filter products
            $('#ProductTypeId').change(async function() {
                const typeId = $(this).val();
                const subcategorySelect = $('#ProductSubcategoryId');
                const productSelect = $('#ProductId');

                // Clear subcategory options
                subcategorySelect.html('<option value="">All Subcategories</option>');

                if (typeId) {
                    // Load subcategories for the selected type
                    try {
                        const response = await fetch(`/Certificate/GetProductSubcategories?productTypeId=${typeId}`);
                        const result = await response.json();
                        if (result.success && result.data && result.data.length > 0) {
                            result.data.forEach(sub => {
                                subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                            });
                            $('#product-subcategory-group').show();
                        } else {
                            $('#product-subcategory-group').hide();
                        }
                    } catch (error) {
                        console.error('Error loading product subcategories:', error);
                    }

                    // Filter products by type
                    await filterProducts(typeId, null);
                } else {
                    $('#product-subcategory-group').hide();
                    // Show all products
                    await filterProducts(null, null);
                }
            });

            // When product subcategory changes, filter products
            $('#ProductSubcategoryId').change(async function() {
                const typeId = $('#ProductTypeId').val();
                const subcategoryId = $(this).val();
                await filterProducts(typeId, subcategoryId);
            });

            // Filter products by type and/or subcategory
            async function filterProducts(typeId, subcategoryId) {
                const productSelect = $('#ProductId');
                const currentValue = productSelect.val();

                try {
                    let url = '/Certificate/GetProductsByType?';
                    if (typeId) url += `productTypeId=${typeId}&`;
                    if (subcategoryId) url += `subcategoryId=${subcategoryId}`;

                    const response = await fetch(url);
                    const result = await response.json();

                    if (result.success && result.data) {
                        productSelect.html('<option value="">Select a product...</option>');
                        result.data.forEach(p => {
                            productSelect.append(`<option value="${p.id}">${p.name}</option>`);
                        });

                        // Restore selection if still valid
                        if (currentValue && productSelect.find(`option[value="${currentValue}"]`).length) {
                            productSelect.val(currentValue);
                        }
                    }
                } catch (error) {
                    console.error('Error filtering products:', error);
                }
            }

            // ===== Certification Type Subcategories =====

            // Load subcategories when certification type changes
            $('#CertificationTypeId').change(function() {
                const typeId = $(this).val();
                const subcategorySelect = $('#CertificationTypeSubcategoryId');

                // Clear existing subcategory options
                subcategorySelect.html('<option value="">Select subcategory...</option>');

                if (typeId) {
                    // Filter subcategories for the selected parent type
                    const subcategories = allCertificationTypes.filter(ct => ct.parentId === parseInt(typeId));

                    if (subcategories.length > 0) {
                        // Add subcategory options
                        subcategories.forEach(sub => {
                            subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                        });
                    }

                    // Load custom fields for the selected type
                    if (typeof certificateCustomFields !== 'undefined') {
                        certificateCustomFields.loadFieldsForType(typeId);
                    }
                } else {
                    $('#custom-fields-container').html('<p class="text-muted">Select a certification type to load custom fields.</p>');
                }
            });

            // Load fields if type is already selected
            const initialTypeId = $('#CertificationTypeId').val();
            if (initialTypeId) {
                $('#CertificationTypeId').trigger('change');
            }

            // Intercept form submission to handle custom fields
            const form = document.getElementById('certificateCreateForm');

            form.addEventListener('submit', function(e) {
                console.log('[Create.cshtml] Form submit handler triggered');
                try {
                    // Only validate custom fields if they exist and are loaded
                    if (typeof certificateCustomFields !== 'undefined' && certificateCustomFields.fields && certificateCustomFields.fields.length > 0) {
                        const validation = certificateCustomFields.validateFields();
                        if (!validation.isValid) {
                            e.preventDefault();
                            e.stopPropagation();
                            // Show inline errors for custom fields
                            const customFieldsContainer = document.getElementById('custom-fields-container');
                            if (customFieldsContainer) {
                                // Clear previous custom field errors
                                customFieldsContainer.querySelectorAll('.inline-validation-error').forEach(el => el.remove());
                                customFieldsContainer.querySelectorAll('.form-group.has-error').forEach(fg => fg.classList.remove('has-error'));

                                // Add inline error for each invalid custom field
                                validation.errors.forEach(error => {
                                    // Find the field by its error message
                                    const formGroups = customFieldsContainer.querySelectorAll('.form-group');
                                    formGroups.forEach(fg => {
                                        const label = fg.querySelector('label');
                                        if (label && error.includes(label.textContent.replace('*', '').trim())) {
                                            fg.classList.add('has-error');
                                            const errorDiv = document.createElement('div');
                                            errorDiv.className = 'inline-validation-error';
                                            errorDiv.textContent = error;
                                            const input = fg.querySelector('input, select, textarea');
                                            if (input) {
                                                input.insertAdjacentElement('afterend', errorDiv);
                                            }
                                        }
                                    });
                                });

                                // Scroll to custom fields section
                                customFieldsContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                            return false;
                        }

                        // Get custom field values and add them to the form
                        const fieldValues = certificateCustomFields.getFieldValues();

                        // Remove any existing custom field hidden inputs
                        form.querySelectorAll('input[name^="CustomFieldValues"]').forEach(input => input.remove());

                        // Add custom field values as hidden inputs to the form
                        Object.keys(fieldValues).forEach(fieldId => {
                            const hiddenInput = document.createElement('input');
                            hiddenInput.type = 'hidden';
                            hiddenInput.name = `CustomFieldValues[${fieldId}]`;
                            hiddenInput.value = fieldValues[fieldId] || '';
                            form.appendChild(hiddenInput);
                        });

                        console.log('Custom field values added to form:', fieldValues);
                    }

                    // Add Product IDs to the form (from Product ID Manager)
                    console.log('[FormSubmit] Checking productIdManager:', {
                        exists: typeof window.productIdManager !== 'undefined',
                        hasProductIds: window.productIdManager?.productIds ? true : false,
                        count: window.productIdManager?.productIds?.length || 0
                    });

                    if (typeof window.productIdManager !== 'undefined' && window.productIdManager.productIds && window.productIdManager.productIds.length > 0) {
                        // Remove any existing product ID hidden inputs
                        form.querySelectorAll('input[name^="ProductIds"]').forEach(input => input.remove());

                        // Add product IDs as hidden inputs for model binding
                        // Format: ProductIds[0].PropertyName, ProductIds[1].PropertyName, etc.
                        // CertificateId is set to 0 here - the backend will assign the correct value after certificate creation
                        window.productIdManager.productIds.forEach((pid, index) => {
                            console.log('[FormSubmit] Adding ProductId:', pid);
                            const fields = {
                                'CertificateId': 0, // Will be set by backend after certificate creation
                                'ProductIdType': pid.productIdType || '',
                                'ProductIdValue': pid.productIdValue || '',
                                'Status': pid.status || 'Active',
                                'Partner': pid.partner || '',
                                'ProductName': pid.productName || '',
                                'ProductSku': pid.productSku || '',
                                'Description': pid.description || ''
                            };

                            Object.entries(fields).forEach(([key, value]) => {
                                const hiddenInput = document.createElement('input');
                                hiddenInput.type = 'hidden';
                                hiddenInput.name = `ProductIds[${index}].${key}`;
                                hiddenInput.value = value;
                                form.appendChild(hiddenInput);
                                console.log('[FormSubmit] Added hidden input:', `ProductIds[${index}].${key}`, '=', value);
                            });
                        });

                        console.log('[FormSubmit] Product IDs added to form:', window.productIdManager.productIds.length);
                    } else {
                        console.log('[FormSubmit] No product IDs to add');
                    }

                    // If no custom fields or validation passes, allow form to submit normally
                    return true;
                } catch (error) {
                    console.error('Error validating custom fields:', error);
                    // Allow form to submit even if validation has an error
                    // (Better to let the server handle validation than block the user)
                    return true;
                }
            });
        });

        // Store original certificate create success handler
        if (typeof window.certificateCreateSuccess === 'undefined') {
            window.originalCertificateCreateSuccess = window.certificateCreateSuccess || function() {};

            // Override success handler to save custom fields after certificate creation
            window.certificateCreateSuccess = async function(result) {
                if (result && result.success && result.certificateId) {
                    // Save custom field values
                    const fieldsSaved = await certificateCustomFields.saveFieldValues(result.certificateId);
                    if (fieldsSaved) {
                        // Redirect to details page
                        window.location.href = `/Certificate/Details/${result.certificateId}`;
                    }
                } else {
                    // Call original success handler if no certificate ID
                    window.originalCertificateCreateSuccess(result);
                }
            };
        }
    </script>
}
