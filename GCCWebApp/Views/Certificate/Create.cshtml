@model GCCWebApp.Models.CertificateEditViewModel

@{
    ViewData["Title"] = "Create Certificate";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/certificate-create.css" rel="stylesheet" />
    <link href="~/css/product-id-manager.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Create Certificate</span>
    </span>
}

@section PageActions {
    <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back to Management
    </a>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Add a new certificate to the GreenCircle Certified database</p>
            </div>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" data-success-message="@TempData["SuccessMessage"]" style="margin-bottom: 24px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="admin-content">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate id="certificateCreateForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-grid">
                <div class="main-form">
                    <!-- Company Section -->
                    <div class="form-group">
                        <label asp-for="CompanyId">Company <span class="text-danger">*</span></label>
                        <select asp-for="CompanyId" required>
                            <option value="">Select a company...</option>
                            @if (ViewBag.Companies != null)
                            {
                                @foreach (var company in ViewBag.Companies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Number">Certification # <span class="text-danger">*</span></label>
                        <input asp-for="Number" placeholder="XX-XXXX" required maxlength="7" />
                        <span asp-validation-for="Number" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationTypeId">Certification Type <span class="text-danger">*</span></label>
                        <select asp-for="CertificationTypeId" required>
                            <option value="">Select type...</option>
                            @if (ViewBag.CertificationTypes != null)
                            {
                                @foreach (var certType in ViewBag.CertificationTypes)
                                {
                                    <option value="@certType.Id">@certType.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CertificationTypeId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductId">Product Name <span class="text-danger">*</span></label>
                        <select asp-for="ProductId" required>
                            <option value="">Select a product...</option>
                            @if (ViewBag.Products != null)
                            {
                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id">@product.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EffectiveDate">Effective Date <span class="text-danger">*</span></label>
                        <input asp-for="EffectiveDate" type="date" required />
                        <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ExpirationDate">Expiration Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpirationDate" type="date" required />
                        <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" required>
                            <option value="">Select status...</option>
                            <option value="Draft">Draft</option>
                            <option value="Client Approved - Not Paid">Client Approved - Not Paid</option>
                            <option value="Client Approved - Confidential">Client Approved - Confidential</option>
                            <option value="Client Approved - Paid">Client Approved - Paid</option>
                            <option value="Hold">Hold</option>
                            <option value="Active" selected>Active</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Partner">Partner</label>
                        <select asp-for="Partner">
                            <option value="">None</option>
                            <option value="Amazon">Amazon</option>
                            <option value="Wayfair">Wayfair</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Partner" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Location">Location</label>
                        <input asp-for="Location" placeholder="City, State" maxlength="175" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <select asp-for="Country">
                            <option value="">Select country...</option>
                            <option value="United States">United States</option>
                            <option value="Canada">Canada</option>
                            <option value="Mexico">Mexico</option>
                            <option value="United Kingdom">United Kingdom</option>
                            <option value="Germany">Germany</option>
                        </select>
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="sidebar">
                    <div class="upload-section">
                        <h3>Upload Certificate Image</h3>
                        <p style="font-size: 13px; color: #666; margin-bottom: 12px;">Upload a snapshot/preview of the certificate (PNG/JPG, max 5MB)</p>
                        <div class="upload-placeholder" id="certificateImageUpload" onclick="document.getElementById('certificateImage').click()" style="cursor: pointer;">
                            <div id="certificateImagePreview" style="display: none;">
                                <img id="certificateImagePreviewImg" src="" alt="Certificate Preview" style="max-width: 100%; max-height: 300px; object-fit: contain;" />
                            </div>
                            <div id="certificateImagePlaceholder">
                                Click to upload certificate image
                            </div>
                        </div>
                        <input type="file" id="certificateImage" name="certificateImage" accept="image/jpeg,image/jpg,image/png" style="display: none;" />
                        <input type="hidden" asp-for="CertificateImagePath" id="certificateImagePathHidden" />
                    </div>

                    <div class="tags-section">
                        <h3>Tags (Multiselect)</h3>

                        <div class="tags-group">
                            <label>External Tags</label>
                            <select id="externalTagSelect">
                                <option value="">Select...</option>
                                @if (ViewBag.ExternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.ExternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="externalTagsContainer">
                                <!-- External tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="ExternalTags" id="externalTagsHidden" />
                        </div>

                        <div class="tags-group">
                            <label>Internal Tags</label>
                            <select id="internalTagSelect">
                                <option value="">Select...</option>
                                @if (ViewBag.InternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.InternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="internalTagsContainer">
                                <!-- Internal tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="InternalTags" id="internalTagsHidden" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate PDF Upload Section -->
            <div class="certificate-section">
                <h3>Certificate PDF</h3>
                <div class="form-group">
                    <label>Upload PDF Certificate <span class="text-danger">*</span></label>
                    <div class="pdf-upload" id="pdfUploadZone">
                        <div class="pdf-upload-text">Drag and drop your certificate PDF here or click to select</div>
                    </div>
                    <input type="file" id="certificatePdf" name="certificatePdf" accept="application/pdf" style="display: none;" required />
                    <div id="pdfPreviewContainer"></div>
                </div>
            </div>

            <!-- Product ID Manager -->
            <div class="product-manager">
                <h3>Product ID Manager</h3>
                <p class="text-muted small">Manage ASINs, UPCs, GTINs, and other product identifiers</p>
                @{
                    ViewData["CertificateId"] = 0; // New certificate, no ID yet
                    ViewData["IsReadOnly"] = false;
                }
                @await Html.PartialAsync("_ProductIdManager", Model.ProductIds)
            </div>

            <div class="action-buttons">
                <button type="submit" name="action" value="save" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save
                </button>
                <button type="submit" name="action" value="saveAndAddAnother" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Save & Add Another
                </button>
                <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-outline">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button type="reset" class="btn btn-outline">
                    <i class="fas fa-undo"></i> Reset Form
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/product-id-manager.js"></script>
    <script src="~/js/certificate-create.js"></script>
}
