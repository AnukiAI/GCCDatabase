        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Create Certificate</span>
    </span>
}

@section PageActions {
    <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back to Management
    </a>
}

<div class="form-container">
    <div class="form-header">
        <h2>Create New Certificate</h2>
        <div class="text-muted small">Add a new certificate to the GreenCircle Certified database</div>
    </div>

    <div class="form-content">
        <form asp-action="Create" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-grid">
                <div class="main-form">
                    <!-- Company Section -->
                    <div class="form-group">
                        <label asp-for="CompanyId">Company</label>
                        <select asp-for="CompanyId" required>
                            <option value="">Select a company...</option>
                            @if (ViewBag.Companies != null)
                            {
                                @foreach (var company in ViewBag.Companies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Company Contact</label>
                        <input type="text" placeholder="Company URL/Phone" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Number">Certification #</label>
                        <input asp-for="Number" placeholder="XX-XXX" required maxlength="7" />
                        <span asp-validation-for="Number" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationTypeId">Certification Type</label>
                        <select asp-for="CertificationTypeId" required>
                            <option value="">Select</option>
                            @if (ViewBag.CertificationTypes != null)
                            {
                                @foreach (var certType in ViewBag.CertificationTypes)
                                {
                                    <option value="@certType.Id">@certType.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CertificationTypeId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EffectiveDate">Effective Date</label>
                        <input asp-for="EffectiveDate" type="date" required />
                        <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ExpirationDate">Expiration Date</label>
                        <input asp-for="ExpirationDate" type="date" required />
                        <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Status</label>
                        <select asp-for="Status" required>
                            <option value="">Select</option>
                            <option value="Draft">Draft</option>
                            <option value="Client Approved - Not Paid">Client Approved - Not Paid</option>
                            <option value="Client Approved - Confidential">Client Approved - Confidential</option>
                            <option value="Client Approved - Paid">Client Approved - Paid</option>
                            <option value="Hold">Hold</option>
                            <option value="Active" selected>Active</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Partner">Partner</label>
                        <select asp-for="Partner">
                            <option value="">Select</option>
                            <option value="Amazon">Amazon</option>
                            <option value="Novi">Novi</option>
                            <option value="None">None</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Partner" class="text-danger"></span>
                    </div>

                    <!-- Product Section -->
                    <div class="section-header">Product</div>

                    <div class="form-group">
                        <label asp-for="ProductId">Product Name</label>
                        <select asp-for="ProductId" required>
                            <option value="">Select a product...</option>
                            @if (ViewBag.Products != null)
                            {
                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id">@product.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Product Category</label>
                        <select>
                            <option value="">Select</option>
                            <option>Building Materials</option>
                            <option>Paper</option>
                            <option>Textiles</option>
                            <option>Packaging</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Product Type</label>
                        <select>
                            <option value="">Select</option>
                            <option>Insulation</option>
                            <option>Flooring</option>
                            <option>Roofing</option>
                            <option>Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Product Type Subcategory</label>
                        <select>
                            <option value="">Select</option>
                            <option>Foam Insulation</option>
                            <option>Batt Insulation</option>
                            <option>Rigid Insulation</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="Location">Location</label>
                        <input asp-for="Location" placeholder="City, State" maxlength="175" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <select asp-for="Country">
                            <option value="">Select</option>
                            <option value="United States">United States</option>
                            <option value="Canada">Canada</option>
                            <option value="Mexico">Mexico</option>
                            <option value="United Kingdom">United Kingdom</option>
                            <option value="Germany">Germany</option>
                        </select>
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>

                </div>

                <!-- Sidebar -->
                <div class="sidebar">
                    <!-- Product Image Upload - NOT A REQUIREMENT (may be added later) -->
                    <!--
                    <div class="upload-section">
                        <h3>Upload Product Image 📎</h3>
                        <div class="upload-placeholder" id="productImageUpload">
                            (Placeholder Image)
                            <input type="file" id="productImages" name="productImages" multiple accept="image/jpeg,image/png" style="display: none;" />
                        </div>
                        <div id="imagePreviewContainer"></div>
                    </div>
                    -->

                    <div class="tags-section">
                        <h3>Tags (Multiselect)</h3>

                        <div class="tags-group">
                            <label>External Tags</label>
                            <select id="externalTagSelect">
                                <option>Select</option>
                            </select>
                            <div class="tags-container" id="externalTagsContainer">
                                <!-- External tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="ExternalTags" id="externalTagsHidden" />
                        </div>

                        <div class="tags-group">
                            <label>Internal Tags</label>
                            <select id="internalTagSelect">
                                <option>Select</option>
                            </select>
                            <div class="tags-container" id="internalTagsContainer">
                                <!-- Internal tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="InternalTags" id="internalTagsHidden" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate Section -->
            <div class="certificate-section">
                <h3>Certificate</h3>

                <div class="main-form">
                    <div class="form-group">
                        <label>Certificate Name</label>
                        <input type="text" placeholder="Enter certificate name" />
                    </div>

                    <div class="form-group">
                        <label>Certification Type</label>
                        <select>
                            <option value="">Select type</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 20px;">
                    <label>Upload PDF</label>
                    <div class="pdf-upload" id="pdfUploadZone">
                        <div class="pdf-upload-text">Drag and drop your certificate here or click to select</div>
                        <input type="file" id="certificatePdf" name="certificatePdf" accept="application/pdf" style="display: none;" />
                    </div>
                    <div id="pdfPreviewContainer"></div>
                </div>
            </div>

            <!-- Product ID Manager -->
            <div class="product-manager">
                <h3>Product ID Manager 📎⬇️</h3>
                @{
                    ViewData["CertificateId"] = 0; // New certificate, no ID yet
                    ViewData["IsReadOnly"] = false;
                }
                @await Html.PartialAsync("_ProductIdManager", Model.ProductIds)
            </div>

            <div class="action-buttons">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-primary">Save & Add Another</button>
                <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-outline">Cancel</a>
                <button type="reset" class="btn btn-outline">Reset Form</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Tag Management System - mockup style
        let externalTags = [];
        let internalTags = [];

        function addTag(type) {
            const select = document.getElementById(type + 'TagSelect');
            const selectedText = select.options[select.selectedIndex].text;

            if (selectedText && selectedText !== 'Select') {
                const tagArray = type === 'external' ? externalTags : internalTags;

                // Check if tag already exists
                if (!tagArray.includes(selectedText)) {
                    tagArray.push(selectedText);
                    createTagElement(selectedText, type);
                    updateHiddenInput(type);
                }

                select.selectedIndex = 0; // Reset to "Select"
            }
        }

        function createTagElement(tagText, type) {
            const container = document.getElementById(type + 'TagsContainer');
            if (!container) return;

            const tagElement = document.createElement('span');
            tagElement.className = `tag ${type}`;
            tagElement.innerHTML = `
                ${tagText}
                <button type="button" class="tag-remove" onclick="removeTag('${tagText}', '${type}')">
                    ×
                </button>
            `;
            container.appendChild(tagElement);
        }

        function removeTag(tagText, type) {
            const tagArray = type === 'external' ? externalTags : internalTags;
            const index = tagArray.indexOf(tagText);

            if (index > -1) {
                tagArray.splice(index, 1);
                updateHiddenInput(type);

                // Remove the visual element
                const container = document.getElementById(type + 'TagsContainer');
                if (container) {
                    const tagElements = container.getElementsByClassName('tag');
                    for (let element of tagElements) {
                        if (element.textContent.trim().replace('×', '').trim() === tagText) {
                            element.remove();
                            break;
                        }
                    }
                }
            }
        }

        function updateHiddenInput(type) {
            const tagArray = type === 'external' ? externalTags : internalTags;
            const hiddenInput = document.getElementById(type + 'TagsHidden');
            if (hiddenInput) {
                hiddenInput.value = JSON.stringify(tagArray);
            }
        }

        // Tag select handlers
        document.addEventListener('change', function(e) {
            if (e.target.id === 'externalTagSelect') {
                addTag('external');
            } else if (e.target.id === 'internalTagSelect') {
                addTag('internal');
            }
        });

        // File Upload Functionality - mockup style
        function initializeFileUploads() {
            // Product Image Upload - DISABLED (not a requirement)
            // const imageUploadZone = document.getElementById('productImageUpload');
            // const imageInput = document.getElementById('productImages');

            // PDF Upload
            const pdfUploadZone = document.getElementById('pdfUploadZone');
            const pdfInput = document.getElementById('certificatePdf');

            // Image upload handlers - DISABLED (not a requirement)
            /*
            if (imageUploadZone && imageInput) {
                imageUploadZone.addEventListener('click', () => imageInput.click());

                imageUploadZone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    imageUploadZone.style.borderColor = '#007bff';
                });

                imageUploadZone.addEventListener('dragleave', () => {
                    imageUploadZone.style.borderColor = '#dee2e6';
                });

                imageUploadZone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    imageUploadZone.style.borderColor = '#dee2e6';
                    handleImageFiles(e.dataTransfer.files);
                });

                imageInput.addEventListener('change', (e) => {
                    handleImageFiles(e.target.files);
                });
            }
            */

            // PDF upload handlers
            if (pdfUploadZone && pdfInput) {
                pdfUploadZone.addEventListener('click', () => pdfInput.click());

                pdfUploadZone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    pdfUploadZone.style.borderColor = '#0056b3';
                });

                pdfUploadZone.addEventListener('dragleave', () => {
                    pdfUploadZone.style.borderColor = '#007bff';
                });

                pdfUploadZone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    pdfUploadZone.style.borderColor = '#007bff';
                    handlePdfFile(e.dataTransfer.files[0]);
                });

                pdfInput.addEventListener('change', (e) => {
                    if (e.target.files.length > 0) {
                        handlePdfFile(e.target.files[0]);
                    }
                });
            }
        }

        // Product Image handling - DISABLED (not a requirement)
        /*
        function handleImageFiles(files) {
            const previewContainer = document.getElementById('imagePreviewContainer');
            if (!previewContainer) return;

            Array.from(files).forEach(file => {
                if (file.type.startsWith('image/') && file.size <= 5 * 1024 * 1024) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
