                        previewDiv.style.cssText = 'margin-top: 10px; padding: 10px; border: 1px solid #dee2e6; border-radius: 4px; display: flex; align-items: center; gap: 10px;';
                        previewDiv.innerHTML = `
                            <img src="${e.target.result}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" alt="Preview">
                            <div style="flex-grow: 1;">
                                <div style="font-size: 12px; font-weight: 500;">${file.name}</div>
                                <div style="font-size: 11px; color: #6c757d;">${(file.size / 1024).toFixed(1)}KB</div>
                            </div>
                            <button type="button" onclick="removeImagePreview(this)" style="background: none; border: none; color: #dc3545; cursor: pointer;">×</button>
                        `;
                        previewContainer.appendChild(previewDiv);
                    };
                    reader.readAsDataURL(file);
                } else {
                    alert('Please select valid image files (JPG/PNG) under 5MB.');
                }
            });
        }
        */

        function handlePdfFile(file) {
            if (file && file.type === 'application/pdf' && file.size <= 10 * 1024 * 1024) {
                const previewContainer = document.getElementById('pdfPreviewContainer');
                if (previewContainer) {
                    previewContainer.innerHTML = `
                        <div style="margin-top: 10px; padding: 15px; border: 1px solid #dee2e6; border-radius: 4px; display: flex; align-items: center; gap: 10px;">
                            <div style="color: #dc3545; font-size: 20px;">📄</div>
                            <div style="flex-grow: 1;">
                                <div style="font-weight: 500;">${file.name}</div>
                                <div style="font-size: 12px; color: #6c757d;">${(file.size / 1024 / 1024).toFixed(2)}MB</div>
                            </div>
                            <button type="button" onclick="removePdfPreview()" style="background: none; border: none; color: #dc3545; cursor: pointer; font-size: 16px;">×</button>
                        </div>
                    `;
                }
            } else {
                alert('Please select a valid PDF file under 10MB.');
            }
        }

        // DISABLED (not a requirement)
        /*
        function removeImagePreview(button) {
            button.parentElement.remove();
        }
        */

        function removePdfPreview() {
            const previewContainer = document.getElementById('pdfPreviewContainer');
            const pdfInput = document.getElementById('certificatePdf');
            if (previewContainer) previewContainer.innerHTML = '';
            if (pdfInput) pdfInput.value = '';
        }

        // Form validation enhancement
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                // Initialize file uploads
                initializeFileUploads();
                
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();

        // Date validation
        document.addEventListener('DOMContentLoaded', function() {
            const effectiveDate = document.querySelector('input[name="EffectiveDate"]');
            const expirationDate = document.querySelector('input[name="ExpirationDate"]');
            
            function validateDates() {
                if (effectiveDate.value && expirationDate.value) {
                    const effective = new Date(effectiveDate.value);
                    const expiration = new Date(expirationDate.value);
                    
                    if (expiration <= effective) {
                        expirationDate.setCustomValidity('Expiration date must be after effective date');
                    } else {
                        expirationDate.setCustomValidity('');
                    }
                }
            }
            
            effectiveDate.addEventListener('change', validateDates);
            expirationDate.addEventListener('change', validateDates);
        });
    </script>
