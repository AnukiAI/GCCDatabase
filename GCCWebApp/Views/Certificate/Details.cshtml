@model GCCWebApp.Models.CertificateDetailsViewModelSimple

@{
    ViewData["Title"] = $"Certificate {Model.Certificate.Number} - {Model.Certificate.Product?.Name ?? "N/A"}";
    ViewData["BodyClass"] = "role-admin";
    ViewData["UserName"] = "Jane Smith";
}

@section Styles {
    <link href="~/css/certificates.css" rel="stylesheet" />
    <style>
        .section-header {
            font-size: 16px;
            font-weight: 600;
            color: #002B76;
            margin-top: 20px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 1px solid #e0e0e0;
        }

        .section-header:first-child {
            margin-top: 0;
        }
    </style>
}

@section Breadcrumbs {
    <span class="role-element role-public-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="/Certificate">Certificates</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificate Details</span>
    </span>
    <span class="role-element role-external-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="Index">Certificates</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificate Details</span>
    </span>
    <span class="role-element role-analyst-show role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="Management">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificate Details</span>
    </span>
}

@section PageActions {
    <button class="btn btn-outline role-element role-public-show role-external-show" onclick="window.history.back()">
        <i class="fas fa-arrow-left"></i> Back to Search
    </button>
    <button class="btn btn-outline role-element role-public-show role-external-show" onclick="downloadCertificate()">
        <i class="fas fa-download"></i> Download Certificate
    </button>
    <button class="btn btn-outline role-element role-public-show role-external-show" onclick="printCertificate()">
        <i class="fas fa-print"></i> Print
    </button>

    <button class="btn btn-outline role-element role-analyst-show role-admin-show" onclick="window.history.back()">
        <i class="fas fa-arrow-left"></i> Back to Management
    </button>
    <button class="btn btn-outline role-element role-analyst-show role-admin-show" onclick="downloadCertificate()">
        <i class="fas fa-download"></i> Download PDF
    </button>
    <button class="btn btn-outline role-element role-analyst-show role-admin-show" onclick="exportCertificateData()">
        <i class="fas fa-file-export"></i> Export Data
    </button>
    <button class="btn btn-primary role-element role-analyst-show role-admin-show" onclick="editCertificate()">
        <i class="fas fa-edit"></i> Edit Certificate
    </button>

    <div class="btn-group role-element role-admin-show">
        <button class="btn btn-outline dropdown-toggle" data-bs-toggle="dropdown">
            <i class="fas fa-cog"></i> Admin Actions
        </button>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#" onclick="duplicateCertificate()"><i class="fas fa-copy"></i> Duplicate</a></li>
            <li><a class="dropdown-item" href="#" onclick="addInternalNote()"><i class="fas fa-sticky-note"></i> Add Note</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="#" onclick="updateCertificateStatus('Suspended')"><i class="fas fa-pause"></i> Suspend</a></li>
            <li><a class="dropdown-item text-danger" href="#" onclick="updateCertificateStatus('Revoked')"><i class="fas fa-ban"></i> Revoke</a></li>
        </ul>
    </div>
}

<div class="certificate-badge">Certificate 1.1</div>

<div class="certificate-details">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>@Model.Certificate.Number</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Company:</dt>
                        <dd class="col-sm-9">@(Model.Certificate.Company?.Name ?? "N/A")</dd>

                        <dt class="col-sm-3">Product:</dt>
                        <dd class="col-sm-9">@(Model.Certificate.Product?.Name ?? "N/A")</dd>

                        <dt class="col-sm-3">Certification Type:</dt>
                        <dd class="col-sm-9">@(Model.Certificate.CertificationType?.Name ?? "N/A")</dd>

                        <dt class="col-sm-3">Effective Date:</dt>
                        <dd class="col-sm-9">@Model.Certificate.EffectiveDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-3">Expiration Date:</dt>
                        <dd class="col-sm-9">@Model.Certificate.ExpirationDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-3">Country:</dt>
                        <dd class="col-sm-9">@Model.Certificate.Country</dd>

                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9"><span class="badge badge-@(Model.Certificate.Status == "Active" ? "success" : "secondary")">@Model.Certificate.Status</span></dd>
                    </dl>
                </div>
            </div>

            @* Custom Fields Section *@
            @if (Model.CustomFieldValues != null && Model.CustomFieldValues.Any())
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h3>Additional Information</h3>
                    </div>
                    <div class="card-body">
                        @foreach (var section in Model.CustomFieldValues.GroupBy(f => f.Field.Section))
                        {
                            <h4 class="section-header">@(section.Key)</h4>
                            <dl class="row mb-4">
                                @foreach (var fieldValue in section)
                                {
                                    @if (!string.IsNullOrWhiteSpace(fieldValue.Value))
                                    {
                                        <dt class="col-sm-3">@fieldValue.Field.Name:</dt>
                                        <dd class="col-sm-9">@fieldValue.DisplayValue</dd>
                                    }
                                }
                            </dl>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function downloadCertificate() {
            window.location.href = '@Url.Action("Download", "Certificate", new { id = Model.Certificate.Id })';
        }

        function printCertificate() {
            window.print();
        }

        function exportCertificateData() {
            window.location.href = '@Url.Action("Export", "Certificate", new { id = Model.Certificate.Id })';
        }

        function editCertificate() {
            window.location.href = '@Url.Action("Edit", "Certificate", new { id = Model.Certificate.Id })';
        }

        function duplicateCertificate() {
            if (confirm('Are you sure you want to duplicate this certificate?')) {
                window.location.href = '@Url.Action("Duplicate", "Certificate", new { id = Model.Certificate.Id })';
            }
        }

        function addInternalNote() {
            // TODO: Implement add internal note functionality
            alert('Add internal note functionality coming soon');
        }

        function updateCertificateStatus(status) {
            if (confirm('Are you sure you want to change the certificate status to ' + status + '?')) {
                // TODO: Implement status update
                alert('Status update functionality coming soon');
            }
        }
    </script>
}
