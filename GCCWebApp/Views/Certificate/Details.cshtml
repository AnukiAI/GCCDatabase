@model GCCWebApp.Models.CertificateDetailsViewModelSimple
@{
    ViewData["Title"] = $"Certificate {Model.Certificate.Number} - {Model.Certificate.Product?.Name ?? "N/A"}";
    ViewData["BodyClass"] = "certificate-single-view";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get data from model with safe defaults
    var certificateId = Model.Certificate?.Id.ToString() ?? "0";
    var certificateNumber = Model.Certificate?.Number ?? "";
    var certificationType = Model.Certificate?.CertificationType?.Name ?? "Certified Environmental Facts";
    var company = Model.Certificate?.Company?.Name ?? "Unknown Company";
    var productName = Model.Certificate?.Product?.Name ?? "Unknown Product";
    var productType = Model.Certificate?.Product?.ProductType?.Name ?? "General Product";
    var location = Model.Certificate?.Location ?? "Unknown Location";
    var country = Model.Certificate?.Country ?? "Unknown Country";
    var effectiveDate = Model.Certificate?.EffectiveDate.ToString("M/d/yyyy") ?? "Unknown";
    var expirationDate = Model.Certificate?.ExpirationDate.ToString("M/d/yyyy") ?? "Unknown";
    var status = Model.Certificate?.Status ?? "Unknown";
}

@* No additional styles needed - uses main.css for certificate-single-card styling *@

@section Breadcrumbs {
    <span class="role-element role-public-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="/Certificate/CertificateTileView">Certificates</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificate Details</span>
    </span>
    <span class="role-element role-external-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="CertificateTileViewExternal">Certificates</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificate Details</span>
    </span>
    <span class="role-element role-analyst-show role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Certificate Details</span>
    </span>
}

@* Success message will be shown as toast notification via JavaScript *@
@if (TempData["SuccessMessage"] is string successMsg)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AdminCore !== 'undefined' && AdminCore.showNotification) {
                AdminCore.showNotification('@Html.Raw(successMsg.Replace("'", "\\'"))', 'success');
            }
        });
    </script>
}

<!-- Certificate Details -->
<div class="certificate-single-container" data-id="@certificateId">
    <!-- Certificate Card styled like tile view -->
    <div class="certificate-card certificate-single-card">
        <div class="card-header">
            <div class="header-row">
                <div class="certificate-category">@certificationType.ToUpper()</div>
                <div class="certificate-id">@certificateNumber</div>
            </div>
            <div class="company-name">@company</div>
        </div>
        <div class="card-body">
            <div class="product-info">
                <div class="product-name" style="font-size: 22px; font-weight: 700;">@productName</div>
                <div class="product-type" style="font-size: 18px;">@productType</div>
            </div>
            <!-- Main Detail Grid -->
            <div class="certificate-details-grid">
                <!-- Left Column: Certificate Info -->
                <div class="details-column">
                    <!-- Certification Details -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Details</h3>
                        <div class="certificate-field"><strong>Status:</strong> <span class="status-@status.ToLower()">@status</span></div>
                        <div class="certificate-field"><strong>Product Type:</strong> <span>@productType</span></div>
                        @if (!string.IsNullOrEmpty(Model.Certificate?.Partner) && Model.Certificate.Partner != "None")
                        {
                            <div class="certificate-field"><strong>Partner:</strong> <span>@Model.Certificate.Partner</span></div>
                        }
                        <div class="certificate-location">
                            <i class="fas fa-map-marker-alt"></i>
                            @location@if (!string.IsNullOrEmpty(country))
                            {
                                <text>, @country</text>
                            }
                        </div>
                    </div>

                    <!-- Certification Period -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Certification Period</h3>
                        <div class="certificate-period">
                            <strong>Effective Date:</strong> @effectiveDate<br>
                            <strong>Expiration Date:</strong> @expirationDate
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="detail-section">
                        <h3 class="certificate-section-title">Contact Information</h3>
                        <div class="certificate-field">
                            <strong>Company Email:</strong>
                            <span>
                                @if (!string.IsNullOrEmpty(Model.Certificate?.Company?.Email))
                                {
                                    <a href="mailto:@Model.Certificate.Company.Email">@Model.Certificate.Company.Email</a>
                                }
                                else
                                {
                                    <text>Available upon request</text>
                                }
                            </span>
                        </div>
                        <div class="certificate-field">
                            <strong>Company URL:</strong>
                            <span>
                                @if (!string.IsNullOrEmpty(Model.Certificate?.Company?.Website))
                                {
                                    <a href="@Model.Certificate.Company.Website" target="_blank" rel="noopener">@Model.Certificate.Company.Website</a>
                                }
                                else
                                {
                                    <text>Not provided</text>
                                }
                            </span>
                        </div>
                    </div>

                    @* Certification Results - Admin/Analyst only *@
                    @if (Model.ShowInternalData && !string.IsNullOrWhiteSpace(Model.Certificate?.CertificationResults))
                    {
                        <div class="detail-section role-element role-analyst-show role-admin-show">
                            <h3 class="certificate-section-title">Certification Results</h3>
                            <div class="certificate-field">@Model.Certificate.CertificationResults</div>
                        </div>
                    }

                    @* Custom Fields Section *@
                    @if (Model.CustomFieldValues != null && Model.CustomFieldValues.Any())
                    {
                        @foreach (var section in Model.CustomFieldValues.GroupBy(f => f.Field.Section))
                        {
                            <div class="detail-section">
                                <h3 class="certificate-section-title">@(section.Key)</h3>
                                @foreach (var fieldValue in section)
                                {
                                    @if (!string.IsNullOrWhiteSpace(fieldValue.Value))
                                    {
                                        <div class="certificate-field"><strong>@fieldValue.Field.Name:</strong> <span>@fieldValue.DisplayValue</span></div>
                                    }
                                }
                            </div>
                        }
                    }

                    <!-- Tags -->
                    @if (Model.Certificate?.Tags != null && Model.Certificate.Tags.Any())
                    {
                        <div class="certificate-tags">
                            @foreach (var tag in Model.Certificate.Tags)
                            {
                                <div class="tag @(tag.TagType?.ToLower() ?? "external")">@tag.Name</div>
                            }
                        </div>
                    }
                </div>

                <!-- Right Column: Certificate Image/PDF Preview -->
                <div class="certificate-image-column" style="padding-right: 30px;">
                    @{
                        // Only consider it a valid snapshot if it's a generated thumbnail (contains "_thumb_" or is in uploads/images/)
                        var imagePath = Model.Certificate?.CertificateImagePath ?? "";
                        bool hasValidSnapshot = !string.IsNullOrEmpty(imagePath) &&
                            (imagePath.Contains("_thumb_") || imagePath.Contains("uploads/images/"));
                        string certificateImageSrc = "";
                        if (hasValidSnapshot)
                        {
                            certificateImageSrc = imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? imagePath
                                : imagePath.StartsWith("/")
                                    ? imagePath
                                    : $"/{imagePath}";
                        }
                    }
                    <!-- Consistent square preview container -->
                    <div class="certificate-preview-box" style="width: 200px; height: 200px; border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden; background: #f8f9fa; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative;">
                        @if (hasValidSnapshot)
                        {
                            <img src="@certificateImageSrc" alt="Certificate @certificateNumber"
                                 style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                 onclick="openImageZoom('@certificateImageSrc')" />
                            <!-- Magnifying Glass Icon overlay -->
                            <div class="zoom-icon-overlay" onclick="openImageZoom('@certificateImageSrc')" title="Click to zoom"
                                 style="position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.6); color: white; padding: 6px 10px; border-radius: 4px; font-size: 12px;">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        }
                        else
                        {
                            <!-- Certificate Unavailable placeholder -->
                            <div style="text-align: center; padding: 20px;">
                                <i class="fas fa-file-pdf" style="font-size: 48px; color: #adb5bd; margin-bottom: 12px; display: block;"></i>
                                <p style="font-size: 14px; font-weight: 600; color: #6c757d; margin: 0 0 4px 0;">Certificate Unavailable</p>
                                <small style="color: #adb5bd; font-size: 11px;">Preview not generated</small>
                            </div>
                        }
                    </div>

                    <!-- Download Button directly below image (only if PDF exists) -->
                    @if (!string.IsNullOrEmpty(Model.Certificate?.CertificateFile))
                    {
                        <div class="certificate-download-action">
                            <div class="action-icon download" title="Download PDF" onclick="downloadCertificate('@certificateNumber')">
                                <i class="fas fa-download"></i>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <!-- Edit/Delete Actions at end of card-body, right-aligned -->
            @if (Model.CanEdit || Model.CanDelete)
            {
                <div class="certificate-internal-actions" style="display: flex; justify-content: flex-end; gap: 15px; margin-top: 20px; padding: 15px 0;">
                    @if (Model.CanEdit)
                    {
                        <div class="action-icon edit" title="Edit Certificate" onclick="editCertificate('@certificateNumber')">
                            <i class="fas fa-edit"></i>
                        </div>
                    }
                    @if (Model.CanDelete)
                    {
                        <div class="action-icon delete" title="Delete Certificate" onclick="deleteCertificate('@certificateId')">
                            <i class="fas fa-trash"></i>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="image-zoom-modal" onclick="closeImageZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
    <div class="zoom-caption" id="imageCaption">Certificate Preview</div>
</div>

@section Scripts {
    <script src="~/js/certificates.js"></script>
    <script>
        // Image zoom functionality
        function openImageZoom(imageSrc) {
            const modal = document.getElementById('imageZoomModal');
            const modalImg = document.getElementById('zoomedImage');
            const caption = document.getElementById('imageCaption');

            modal.style.display = 'block';
            modalImg.src = imageSrc;
            caption.innerHTML = 'Certificate @certificateNumber - Click anywhere to close';

            // Prevent body scroll when modal is open
            document.body.style.overflow = 'hidden';
        }

        function closeImageZoom() {
            const modal = document.getElementById('imageZoomModal');
            modal.style.display = 'none';

            // Restore body scroll
            document.body.style.overflow = 'auto';
        }

        // Close on ESC key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeImageZoom();
            }
        });

        // Certificate action functions
        window.downloadCertificate = function(certificateNumber) {
            if (!certificateNumber) {
                console.error('Certificate number is missing');
                return;
            }
            try {
                window.open(`/Certificate/Download/${encodeURIComponent(certificateNumber)}`, '_blank');
                console.log('Certificate download started');
            } catch (error) {
                console.error('Error downloading certificate:', error);
            }
        };

        window.editCertificate = function(certificateNumber) {
            if (!certificateNumber) {
                console.error('Certificate number is missing');
                return;
            }
            window.location.href = `/Certificate/Edit/${encodeURIComponent(certificateNumber)}`;
        };

        window.deleteCertificate = function(certificateId) {
            if (!certificateId) {
                console.error('Certificate ID is missing');
                return;
            }

            if (confirm('Are you sure you want to delete this certificate? This action cannot be undone.')) {
                fetch(`/Certificate/Delete/${certificateId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => {
                    if (response.ok) {
                        alert('Certificate deleted successfully');
                        window.location.href = '/Certificate/CertificateTileViewInternal';
                    } else {
                        alert('Failed to delete certificate');
                    }
                })
                .catch(error => {
                    console.error('Error deleting certificate:', error);
                    alert('An error occurred while deleting the certificate');
                });
            }
        };
    </script>
}
