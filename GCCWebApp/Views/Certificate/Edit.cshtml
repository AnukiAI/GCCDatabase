@model GCCWebApp.Models.CertificateEditViewModel

@{
    ViewData["Title"] = "Edit Certificate";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/certificate-create.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/product-id-manager.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/admin/admin-inline-editing.css" rel="stylesheet" />
}

@section Breadcrumbs {
    @* QC #104 (5\1 follow-up): "Certificate Management" is a top-level nav item, not a child
       of "Administration" — so the trail starts at Certificate Management, not under
       Administration. Same scope-miss pattern as DEF-211 fixed for Companies & Products. *@
    <span class="role-element role-analyst-show role-admin-show">
        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Edit Certificate @Model.Number</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">Edit Certificate</h1>
                <p class="admin-page-subtitle">Edit certificate @Model.Number in the GreenCircle Certified database</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Management
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-content">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate id="certificateEditForm">
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            @Html.HiddenFor(m => m.Id)

            <div class="form-section-header">
                <i class="fas fa-file-certificate"></i>
                <span>Certificate Information</span>
            </div>

            <div class="form-grid">
                <div class="main-form">
                    <!-- Company Section -->
                    <div class="form-group">
                        <label asp-for="CompanyId">Company <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CompanyId" class="form-control" required aria-required="true">
                            <option value="">Select a company...</option>
                            @if (ViewBag.Companies != null)
                            {
                                @foreach (var company in ViewBag.Companies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CompanyEmail">Company Email <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <input asp-for="CompanyEmail" type="email" placeholder="Auto-populated from company" maxlength="255" />
                        <span asp-validation-for="CompanyEmail" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Pre-filled from company record. Changes here update the company.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="CompanyWebsite">Company URL <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <input asp-for="CompanyWebsite" type="url" placeholder="Auto-populated from company" maxlength="500" />
                        <span asp-validation-for="CompanyWebsite" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Pre-filled from company record. Changes here update the company.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Number">Certification # <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="Number" readonly class="form-control-readonly" aria-required="true" style="background-color: #f8f9fa; font-weight: 600;" />
                        <small class="form-text text-muted">Certificate number cannot be changed</small>
                        <span asp-validation-for="Number" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationTypeId">Certification Type <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CertificationTypeId" id="CertificationTypeId" class="form-control" required aria-required="true">
                            <option value="">Select type...</option>
                            @if (ViewBag.ParentCertificationTypes != null)
                            {
                                @foreach (var certType in ViewBag.ParentCertificationTypes)
                                {
                                    <option value="@certType.Id">@certType.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CertificationTypeId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group" id="subcategory-group">
                        <label>Certificate Subcategories <span class="text-muted" style="font-size: 12px;">(Optional - Multiple)</span></label>
                        <select id="subcategorySelect" class="form-control" aria-label="Select certificate subcategories">
                            <option value="">Select subcategory...</option>
                            <!-- Options populated by JavaScript based on parent type -->
                        </select>
                        <div class="subcategories-container" id="subcategoriesContainer" aria-live="polite" aria-label="Selected subcategories">
                            <!-- Selected subcategories displayed as pills -->
                        </div>
                        <input type="hidden" name="SubcategoryIds" id="subcategoriesHidden" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductId">Product Name <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="ProductId" class="form-control" required aria-required="true">
                            <option value="">Select a product...</option>
                            @* Products loaded dynamically based on company selection *@
                        </select>
                        <small id="productHelpText" class="form-text text-muted">Products filtered by selected company</small>
                        <span asp-validation-for="ProductId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label for="ProductCategoryId">Product Category <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select id="ProductCategoryId" name="ProductCategoryId" class="form-control">
                            <option value="">Select a category...</option>
                            @if (ViewBag.ProductCategories != null)
                            {
                                foreach (var cat in ViewBag.ProductCategories)
                                {
                                    if (Model.ProductCategoryId != null && cat.Id == Model.ProductCategoryId)
                                    {
                                        <option value="@cat.Id" selected>@cat.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="ProductTypeId">Product Type <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select id="ProductTypeId" name="ProductTypeId" class="form-control">
                            <option value="">Select category first...</option>
                        </select>
                    </div>

                    <div class="form-group" id="product-subcategory-group">
                        <label for="ProductSubcategoryId">Product Subcategory <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select id="ProductSubcategoryId" name="ProductSubcategoryId" class="form-control">
                            <option value="">Select type first...</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="EffectiveDate">Effective Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="EffectiveDate" type="date" required aria-required="true" />
                        <span asp-validation-for="EffectiveDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ExpirationDate">Expiration Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="ExpirationDate" type="date" required aria-required="true" />
                        <span asp-validation-for="ExpirationDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Status <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="Status" class="form-control" required aria-required="true">
                            <option value="">Select status...</option>
                            @if (ViewBag.Statuses != null)
                            {
                                foreach (var status in ViewBag.Statuses)
                                {
                                    <option value="@status.Key" selected="@(status.Key == Model.Status)">@status.Value</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Partner">Partner</label>
                        <select asp-for="Partner" class="form-control">
                            <option value="None">None</option>
                            @if (ViewBag.Partners != null)
                            {
                                foreach (var partner in ViewBag.Partners)
                                {
                                    <option value="@partner.Name" selected="@(Model.Partner == partner.Name ? "selected" : null)">@partner.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Partner" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationResults">Certification Results <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <textarea asp-for="CertificationResults" rows="3" maxlength="1000" placeholder="Enter test results or scores if required by partner (e.g., threshold values for Amazon)"></textarea>
                        <span asp-validation-for="CertificationResults" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Optional field for recording certification test results or scores.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="PathwayId">Pathway (for Amazon CPF applicable certs)</label>
                        <select asp-for="PathwayId" class="form-control">
                            <option value="">Select pathway...</option>
                            @if (ViewBag.Pathways != null)
                            {
                                foreach (var pathway in ViewBag.Pathways)
                                {
                                    <option value="@pathway.Id" selected="@(Model.PathwayId == pathway.Id)">@pathway.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="PathwayId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Location">Location</label>
                        <input asp-for="Location" placeholder="City, State" maxlength="175" />
                        <span asp-validation-for="Location" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <select asp-for="Country" class="form-control" id="countrySelect">
                            <option value="">Select country...</option>
                            @if (ViewBag.Countries != null)
                            {
                                foreach (var country in (List<string>)ViewBag.Countries)
                                {
                                    if (Model.Country == country)
                                    {
                                        <option value="@country" selected>@country</option>
                                    }
                                    else
                                    {
                                        <option value="@country">@country</option>
                                    }
                                }
                            }
                        </select>
                        <span asp-validation-for="Country" class="text-danger" role="alert"></span>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="certificate-sidebar">
                    <div class="upload-section card-style">
                        <div class="sidebar-section-header">
                            <div class="section-icon">
                                <i class="fas fa-image"></i>
                            </div>
                            <div>
                                <h3 id="certificate-image-label">Certificate Preview</h3>
                                <p id="certificate-image-help" class="text-muted sidebar-help-text">Auto-generated from uploaded PDF</p>
                            </div>
                        </div>
                        @{
                            // DEF-208: route image through controller (gate enforced) instead of
                            // rendering the raw /uploads/* path that static-file middleware would serve.
                            // For a cert mid-edit (no Id yet on Create), fall back to the raw path —
                            // it'll 404 until the cert is saved, which matches existing UX for
                            // unsaved Create-mode previews. The hidden CertificateImagePath input
                            // still carries the path for form persistence.
                            var editImagePath = Model.CertificateImagePath ?? "";
                            bool editHasValidSnapshot = !string.IsNullOrEmpty(editImagePath);
                            string editImageSrc = "";
                            if (editHasValidSnapshot)
                            {
                                editImageSrc = Model.Id > 0
                                    ? Url.Action("ViewCertificateImage", "Certificate", new { id = Model.Id }) ?? ""
                                    : (editImagePath.StartsWith("/") ? editImagePath : $"/{editImagePath}");
                            }
                        }
                        <div class="preview-container certificate-create-preview">
                            @if (editHasValidSnapshot)
                            {
                                <img id="certificateImagePreviewImg" src="@editImageSrc" alt="Certificate Preview"
                                     onclick="openImageZoom('@editImageSrc')" title="Click to view full size" />
                            }
                            else
                            {
                                <div class="no-preview">
                                    <i class="fas fa-file-pdf"></i>
                                    <p>Certificate Unavailable</p>
                                    <small>Preview not generated</small>
                                </div>
                            }
                        </div>
                        <input type="hidden" asp-for="CertificateImagePath" id="certificateImagePathHidden" />
                    </div>

                    <div class="tags-section card-style">
                        <div class="sidebar-section-header">
                            <div class="section-icon">
                                <i class="fas fa-tags"></i>
                            </div>
                            <h3>Certificate Tags</h3>
                        </div>

                        <div class="tags-group">
                            <label for="externalTagSelect">External Tags</label>
                            <select id="externalTagSelect" aria-label="Select external tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.ExternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.ExternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="externalTagsContainer" aria-live="polite" aria-label="Selected external tags">
                                <!-- External tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="ExternalTags" id="externalTagsHidden" />
                        </div>

                        <div class="tags-group">
                            <label for="internalTagSelect">Internal Tags</label>
                            <select id="internalTagSelect" aria-label="Select internal tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.InternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.InternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="internalTagsContainer" aria-live="polite" aria-label="Selected internal tags">
                                <!-- Internal tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="InternalTags" id="internalTagsHidden" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate PDF Upload Section -->
            <div class="certificate-section card-style">
                <div class="form-section-header">
                    <i class="fas fa-file-pdf"></i>
                    <span>Certificate PDF Document</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.CertificateImagePath))
                {
                    <div class="current-pdf-info" style="background-color: #e8f5e9; border: 1px solid #4caf50; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
                        <i class="fas fa-check-circle" style="color: #4caf50; font-size: 20px;"></i>
                        <div style="flex: 1;">
                            <strong style="color: #2e7d32;">Current PDF:</strong>
                            <span style="color: #1b5e20; margin-left: 8px;">@System.IO.Path.GetFileName(Model.CertificateImagePath)</span>
                        </div>
                        @if (editHasValidSnapshot)
                        {
                            <button type="button" onclick="openImageZoom('@editImageSrc')"
                                    class="btn btn-sm"
                                    style="background-color: #4caf50; color: white; padding: 4px 12px; border-radius: 4px; border: none; cursor: pointer;"
                                    title="View Certificate Preview">
                                <i class="fas fa-eye"></i> View
                            </button>
                        }
                        <button type="button" onclick="window.CertificateEdit.confirmRemovePdf(@Model.Id)"
                                class="btn btn-sm"
                                style="background-color: #FF5252; color: white; padding: 4px 12px; border-radius: 4px; border: none; cursor: pointer;"
                                title="Remove uploaded PDF">
                            <i class="fas fa-trash-alt"></i> Remove
                        </button>
                    </div>
                }
                <div class="form-group">
                    <label for="certificatePdf">@(string.IsNullOrEmpty(Model.CertificateImagePath) ? "Upload PDF Certificate" : "Replace PDF Certificate (optional)")</label>
                    <div class="pdf-upload-zone" id="pdfUploadZone" role="button" tabindex="0" aria-label="Upload PDF certificate file. You can drag and drop a file here or press Enter to select a file." onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('certificatePdf').click();}">
                        <div class="pdf-upload-placeholder">
                            <i class="fas fa-file-pdf" aria-hidden="true"></i>
                        </div>
                        <div class="pdf-upload-text">Drag and drop PDF here or click to select</div>
                        <small class="form-text text-muted">Maximum file size: 10MB. @(string.IsNullOrEmpty(Model.CertificateImagePath) ? "" : "Leave empty to keep existing PDF.")</small>
                    </div>
                    <input type="file" id="certificatePdf" name="certificatePdf" accept="application/pdf" style="display: none;" aria-describedby="pdf-help" />
                    <small id="pdf-help" class="form-text text-muted">PDF file optional for editing. Leave empty to keep existing PDF. Image preview will be regenerated if new file uploaded.</small>
                    <div id="pdfPreviewContainer" aria-live="polite"></div>
                </div>
            </div>

            <!-- Product ID Manager -->
            <div class="product-manager card-style">
                <div class="form-section-header">
                    <i class="fas fa-barcode"></i>
                    <span>Product Identifiers</span>
                </div>
                <p class="section-description">Manage ASINs, UPCs, GTINs, and other product identifiers</p>
                @* DEF-149: Edit-page commits product ID changes immediately (independent of the cert form's Save).
                   Surface this so users aren't surprised that Cancel doesn't revert these. *@
                <div class="product-id-save-note" role="note" aria-label="Product ID save behavior"
                     style="background-color: #e7f3ff; border-left: 4px solid #002B76; border-radius: 4px;
                            padding: 10px 14px; margin-bottom: 16px; font-size: 16px; color: #002B76;
                            display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-info-circle" aria-hidden="true" style="font-size: 18px;"></i>
                    <span>Add, edit, and delete actions on product identifiers <strong>save immediately</strong> and apply even if you cancel the certificate edit. Use this if you need to quickly correct a wrong identifier.</span>
                </div>
                @{
                    ViewData["CertificateId"] = Model.Id;
                    ViewData["IsReadOnly"] = false;
                }
                @await Html.PartialAsync("_ProductIdManager", Model.ProductIds)
            </div>

            <div class="card-style" style="margin-bottom: 24px;">
                <div class="form-section-header">
                    <i class="fas fa-sliders-h"></i>
                    <span>Additional Fields</span>
                </div>

                <div id="custom-fields-container" class="mb-4">
                    <p class="text-muted">Loading additional fields...</p>
                </div>
            </div>

            <div class="action-buttons">
                <button type="submit" name="action" value="save" class="btn btn-primary" aria-label="Save certificate changes" id="saveButton">
                    Save Changes
                </button>
                <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-secondary" aria-label="Cancel and return to certificate management">
                    Cancel
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <button type="button" class="btn btn-outline" style="background-color: #FF5252; color: white; border: none;" onclick="window.CertificateEdit.confirmDelete('@Model.Number')" aria-label="Delete this certificate permanently">
                        Delete
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- Image Zoom Modal - Uses CSS from main.css for consistent styling -->
<div id="imageZoomModal" class="image-zoom-modal" onclick="closeImageZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage" alt="Certificate Preview">
    <div class="zoom-caption" id="imageCaption">Certificate Preview - Click anywhere to close</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/product-id-manager.js"></script>
    <script src="~/js/certificate-custom-fields.js"></script>
    <script src="~/js/certificate-create.js"></script>
    <script src="~/js/certificate-inline-create.js"></script>
    <script src="~/js/searchable-select.js"></script>
    <script>
        var certTypeSearch = new SearchableSelect('#CertificationTypeId', { placeholder: 'Search certification types...' });
        var productCategorySearch = new SearchableSelect('#ProductCategoryId', { placeholder: 'Search product categories...' });
        new SearchableSelect('#countrySelect', { placeholder: 'Search countries...' });
        // Company and Product dropdowns are handled by certificate-inline-create.js (createCustomDropdown)
        // which provides search + "Add New" functionality. Do NOT also wrap them with SearchableSelect.
    </script>

    <script>
        console.log('[Edit.cshtml] Script section loaded');

        // Image zoom functionality
        function openImageZoom(imageSrc) {
            const modal = document.getElementById('imageZoomModal');
            const modalImg = document.getElementById('zoomedImage');
            const caption = document.getElementById('imageCaption');

            modal.style.display = 'block';
            modalImg.src = imageSrc;
            caption.innerHTML = 'Certificate @Model.Number - Click anywhere to close';

            // Prevent body scroll when modal is open
            document.body.style.overflow = 'hidden';
        }

        function closeImageZoom() {
            const modal = document.getElementById('imageZoomModal');
            modal.style.display = 'none';

            // Restore body scroll
            document.body.style.overflow = 'auto';
        }

        // Close on ESC key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeImageZoom();
            }
        });

        // Store all certification types for subcategory filtering
        var allCertificationTypes = @Html.Raw(Json.Serialize(ViewBag.AllCertificationTypes ?? new List<object>()));

        // Store product data for auto-fill when product is selected
        var companyProducts = [];

        $(document).ready(async function() {
            const certificateId = @Model.Id;
            const typeId = @Model.CertificationTypeId;
            const savedProductId = '@(Model.ProductId > 0 ? Model.ProductId.ToString() : "")';
            const savedCompanyId = '@(Model.CompanyId > 0 ? Model.CompanyId.ToString() : "")';

            // ===== Company → Product Cascading Dropdown (REQ-CERT-10) =====

            // Load products for a company and optionally pre-select a product
            async function loadProductsForCompany(companyId, preselectProductId) {
                const productSelect = $('#ProductId');
                const helpText = $('#productHelpText');
                productSelect.html('<option value="">Select a product...</option>');
                companyProducts = [];

                if (!companyId) {
                    helpText.text('Select a company to see its products');
                    $('#CompanyEmail').val('');
                    $('#CompanyWebsite').val('');
                    return;
                }

                helpText.text('Loading products...');
                try {
                    const response = await fetch(`/Certificate/GetProductsByCompany?companyId=${companyId}`);
                    const result = await response.json();
                    if (result.success && result.data) {
                        companyProducts = result.data;
                        if (result.data.length > 0) {
                            // Build all options at once to avoid multiple MutationObserver triggers
                            let optionsHtml = '<option value="">Select a product...</option>';
                            result.data.forEach(p => {
                                optionsHtml += `<option value="${p.id}">${p.name}</option>`;
                            });
                            productSelect.html(optionsHtml);
                            // Explicitly set value after all options are in the DOM
                            if (preselectProductId) {
                                setTimeout(() => {
                                    productSelect.val(preselectProductId);
                                    productSelect.trigger('change');
                                    // DEF-225: jQuery .trigger('change') doesn't fire native event
                                    // listeners; the custom-dropdown-wrapper uses addEventListener
                                    // and would otherwise stay on the placeholder text.
                                    productSelect[0].dispatchEvent(new Event('change', { bubbles: true }));
                                }, 50);
                            }
                            helpText.text(`${result.data.length} product(s) found`);
                        } else {
                            helpText.text('No products found for this company. Use "Add New" below.');
                        }
                        // Auto-populate company email/website
                        $('#CompanyEmail').val(result.companyEmail || '');
                        $('#CompanyWebsite').val(result.companyWebsite || '');
                    }
                } catch (error) {
                    console.error('Error loading products by company:', error);
                    helpText.text('Error loading products');
                }
            }

            // Initial load: populate products for the saved company with saved product pre-selected
            if (savedCompanyId) {
                await loadProductsForCompany(savedCompanyId, savedProductId);
            }

            // When company changes, reload products and reset category/type/subcategory
            $('#CompanyId').change(async function() {
                const companyId = $(this).val();
                $('#ProductCategoryId').val('');
                $('#ProductTypeId').html('<option value="">Select category first...</option>');
                $('#ProductSubcategoryId').html('<option value="">Select type first...</option>');
                await loadProductsForCompany(companyId);
            });

            // When product changes, auto-fill category/type/subcategory
            $('#ProductId').change(async function() {
                const productId = parseInt($(this).val());
                if (!productId) return;

                const product = companyProducts.find(p => p.id === productId);
                if (!product) return;

                if (product.categoryId) {
                    $('#ProductCategoryId').val(product.categoryId);
                    try {
                        const response = await fetch(`/Certificate/GetProductTypes?categoryId=${product.categoryId}`);
                        const result = await response.json();
                        if (result.success && result.data) {
                            const typeSelect = $('#ProductTypeId');
                            typeSelect.html('<option value="">Select a type...</option>');
                            result.data.forEach(pt => {
                                typeSelect.append(`<option value="${pt.id}">${pt.name}</option>`);
                            });
                            if (product.productTypeId) {
                                typeSelect.val(product.productTypeId);
                                const subResponse = await fetch(`/Certificate/GetProductSubcategories?productTypeId=${product.productTypeId}`);
                                const subResult = await subResponse.json();
                                if (subResult.success && subResult.data && subResult.data.length > 0) {
                                    const subSelect = $('#ProductSubcategoryId');
                                    subSelect.html('<option value="">Select subcategory...</option>');
                                    subResult.data.forEach(sub => {
                                        subSelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                                    });
                                    if (product.productSubcategoryId) {
                                        subSelect.val(product.productSubcategoryId);
                                    }
                                }
                            }
                        }
                    } catch (error) {
                        console.error('Error auto-filling product hierarchy:', error);
                    }
                }
            });

            // ===== Product Category/Type/Subcategory 3-Level Cascading Dropdowns =====

            // Saved values from model for pre-selection
            const savedCategoryId = '@(Model.ProductCategoryId?.ToString() ?? "")';
            const savedTypeId = '@(Model.ProductTypeId?.ToString() ?? "")';
            const savedSubcategoryId = '@(Model.ProductSubcategoryId?.ToString() ?? "")';

            // On page load: if category is pre-selected, load types then subcategories
            async function initProductCascade() {
                if (savedCategoryId) {
                    // Load types for saved category
                    try {
                        const response = await fetch(`/Certificate/GetProductTypes?categoryId=${savedCategoryId}`);
                        const result = await response.json();
                        if (result.success && result.data) {
                            const typeSelect = $('#ProductTypeId');
                            typeSelect.html('<option value="">Select a type...</option>');
                            result.data.forEach(pt => {
                                const selected = pt.id.toString() === savedTypeId ? ' selected' : '';
                                typeSelect.append(`<option value="${pt.id}"${selected}>${pt.name}</option>`);
                            });
                        }
                    } catch (error) {
                        console.error('Error loading product types:', error);
                    }

                    // If type is also saved, load subcategories
                    if (savedTypeId) {
                        try {
                            const response = await fetch(`/Certificate/GetProductSubcategories?productTypeId=${savedTypeId}`);
                            const result = await response.json();
                            if (result.success && result.data && result.data.length > 0) {
                                const subSelect = $('#ProductSubcategoryId');
                                subSelect.html('<option value="">Select subcategory...</option>');
                                result.data.forEach(sub => {
                                    const selected = sub.id.toString() === savedSubcategoryId ? ' selected' : '';
                                    subSelect.append(`<option value="${sub.id}"${selected}>${sub.name}</option>`);
                                });
                            } else {
                                $('#ProductSubcategoryId').html('<option value="">No subcategories available</option>');
                            }
                        } catch (error) {
                            console.error('Error loading product subcategories:', error);
                        }
                    }
                }
            }

            await initProductCascade();

            // When product category changes, load types filtered by category
            $('#ProductCategoryId').change(async function() {
                const categoryId = $(this).val();
                const typeSelect = $('#ProductTypeId');
                const subcategorySelect = $('#ProductSubcategoryId');

                // Clear dependent dropdowns
                typeSelect.html('<option value="">Select type...</option>');
                subcategorySelect.html('<option value="">Select type first...</option>');

                if (categoryId) {
                    try {
                        const response = await fetch(`/Certificate/GetProductTypes?categoryId=${categoryId}`);
                        const result = await response.json();
                        if (result.success && result.data) {
                            typeSelect.html('<option value="">Select a type...</option>');
                            result.data.forEach(pt => {
                                typeSelect.append(`<option value="${pt.id}">${pt.name}</option>`);
                            });
                        }
                    } catch (error) {
                        console.error('Error loading product types:', error);
                    }
                }
            });

            // When product type changes, load subcategories (children in ProductTypes table)
            $('#ProductTypeId').change(async function() {
                const ptypeId = $(this).val();
                const subcategorySelect = $('#ProductSubcategoryId');

                // Clear subcategory options
                subcategorySelect.html('<option value="">Select subcategory...</option>');

                if (ptypeId) {
                    try {
                        const response = await fetch(`/Certificate/GetProductSubcategories?productTypeId=${ptypeId}`);
                        const result = await response.json();
                        if (result.success && result.data && result.data.length > 0) {
                            result.data.forEach(sub => {
                                subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                            });
                        } else {
                            subcategorySelect.html('<option value="">No subcategories available</option>');
                        }
                    } catch (error) {
                        console.error('Error loading product subcategories:', error);
                    }
                }
            });

            // ===== Certification Type Subcategories (Multi-Select) =====

            // Initialize subcategory dropdown based on current type
            function initializeSubcategory() {
                const subcategorySelect = $('#subcategorySelect');

                subcategorySelect.html('<option value="">Select subcategory...</option>');

                if (typeId) {
                    const subcategories = allCertificationTypes
                        .filter(ct => ct.parentId === typeId)
                        .sort((a, b) => a.name.localeCompare(b.name));

                    if (subcategories.length > 0) {
                        subcategories.forEach(sub => {
                            subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                        });
                    }
                    // Field always stays visible
                }
            }

            initializeSubcategory();

            // Load existing subcategories for this certificate (multi-select with checkboxes)
            @if (ViewBag.ExistingSubcategories != null && ((IEnumerable<dynamic>)ViewBag.ExistingSubcategories).Any())
            {
                <text>
                const existingSubcategories = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingSubcategories));
                // Wait for multi-select dropdown to be initialized
                setTimeout(function() {
                    if (window.CertificateInlineCreate && window.CertificateInlineCreate.loadExistingSubcategories) {
                        window.CertificateInlineCreate.loadExistingSubcategories(existingSubcategories);
                    }
                }, 200);
                </text>
            }

            // Load subcategories when certification type changes
            $('#CertificationTypeId').change(function() {
                const newTypeId = parseInt($(this).val());
                const subcategorySelect = $('#subcategorySelect');

                subcategorySelect.html('<option value="">Select subcategory...</option>');

                // Clear selected subcategories when parent type changes
                if (window.CertificateInlineCreate && window.CertificateInlineCreate.clearSubcategories) {
                    window.CertificateInlineCreate.clearSubcategories();
                }

                if (newTypeId) {
                    const subcategories = allCertificationTypes
                        .filter(ct => ct.parentId === newTypeId)
                        .sort((a, b) => a.name.localeCompare(b.name));

                    if (subcategories.length > 0) {
                        subcategories.forEach(sub => {
                            subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                        });
                    }
                    // Field always stays visible

                    // Refresh the multi-select dropdown to show new options
                    if (window.CertificateInlineCreate && window.CertificateInlineCreate.refreshSubcategories) {
                        setTimeout(() => window.CertificateInlineCreate.refreshSubcategories(), 50);
                    }

                    // Load custom fields for the selected type (only if container exists)
                    if (typeof certificateCustomFields !== 'undefined' && document.getElementById('custom-fields-container')) {
                        certificateCustomFields.loadFieldsForType(newTypeId);
                    }
                } else {
                    // Custom fields container may be hidden for initial phase
                    const customFieldsContainer = document.getElementById('custom-fields-container');
                    if (customFieldsContainer) {
                        customFieldsContainer.innerHTML = '<p class="text-muted">Select a certification type to load custom fields.</p>';
                    }
                }
            });

            // Load custom fields for the certificate type (only if container exists)
            async function loadCustomFields() {
                const customFieldsContainer = document.getElementById('custom-fields-container');
                if (typeId && customFieldsContainer && typeof certificateCustomFields !== 'undefined') {
                    await certificateCustomFields.loadFieldsForType(typeId);
                    await certificateCustomFields.loadFieldValues(certificateId);
                }
            }

            await loadCustomFields();

            // Rebaseline unsaved changes tracking after all async initialization
            // (product types, custom fields, subcategories, tags all trigger change events)
            setTimeout(function() {
                if (window.CertificateCreate && window.CertificateCreate.rebaselineUnsavedChanges) {
                    window.CertificateCreate.rebaselineUnsavedChanges();
                }
            }, 1000);

            // Intercept form submission to handle custom fields
            const form = document.getElementById('certificateEditForm');

            form.addEventListener('submit', function(e) {
                try {
                    // Only validate custom fields if container exists and fields are loaded
                    const customFieldsContainer = document.getElementById('custom-fields-container');
                    if (customFieldsContainer && typeof certificateCustomFields !== 'undefined' && certificateCustomFields.fields && certificateCustomFields.fields.length > 0) {
                        const validation = certificateCustomFields.validateFields();
                        if (!validation.isValid) {
                            e.preventDefault();
                            e.stopPropagation();
                            customFieldsContainer.querySelectorAll('.inline-validation-error').forEach(el => el.remove());
                            customFieldsContainer.querySelectorAll('.form-group.has-error').forEach(fg => fg.classList.remove('has-error'));

                            validation.errors.forEach(error => {
                                const formGroups = customFieldsContainer.querySelectorAll('.form-group');
                                formGroups.forEach(fg => {
                                    const label = fg.querySelector('label');
                                    if (label && error.includes(label.textContent.replace('*', '').trim())) {
                                        fg.classList.add('has-error');
                                        const errorDiv = document.createElement('div');
                                        errorDiv.className = 'inline-validation-error';
                                        errorDiv.textContent = error;
                                        const input = fg.querySelector('input, select, textarea');
                                        if (input) {
                                            input.insertAdjacentElement('afterend', errorDiv);
                                        }
                                    }
                                });
                            });

                            customFieldsContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            return false;
                        }

                        // Get custom field values and add them to the form
                        const fieldValues = certificateCustomFields.getFieldValues();
                        form.querySelectorAll('input[name^="CustomFieldValues"]').forEach(input => input.remove());
                        Object.keys(fieldValues).forEach(fieldId => {
                            const hiddenInput = document.createElement('input');
                            hiddenInput.type = 'hidden';
                            hiddenInput.name = `CustomFieldValues[${fieldId}]`;
                            hiddenInput.value = fieldValues[fieldId] || '';
                            form.appendChild(hiddenInput);
                        });
                    }

                    // CR-018: Do NOT post product IDs through the cert form on Edit.
                    // Product ID changes are immediate-save via /api/productids
                    // (per DEF-149 — the user-facing hint above the manager
                    // explains this), so the cert form's submit doesn't need to
                    // carry them. With server-side paging the JS only holds the
                    // currently visible page; posting that subset would tell the
                    // controller's merge logic to delete every off-page row.
                    // The hidden-input writer is intentionally removed.
                    if (false && typeof window.productIdManager !== 'undefined' && window.productIdManager.productIds) {
                        form.querySelectorAll('input[name^="ProductIds"]').forEach(input => input.remove());
                        window.productIdManager.productIds.forEach((pid, index) => {
                            const fields = {
                                'Id': pid.id || 0,
                                'CertificateId': pid.certificateId || @Model.Id,
                                'ProductIdType': pid.productIdType || '',
                                'ProductIdValue': pid.productIdValue || '',
                                'Status': pid.status || 'Active',
                                'Partner': pid.partner || '',
                                'ProductName': pid.productName || '',
                                'ProductSku': pid.productSku || '',
                                'Description': pid.description || ''
                            };
                            Object.entries(fields).forEach(([key, value]) => {
                                const hiddenInput = document.createElement('input');
                                hiddenInput.type = 'hidden';
                                hiddenInput.name = `ProductIds[${index}].${key}`;
                                hiddenInput.value = value;
                                form.appendChild(hiddenInput);
                            });
                        });
                    }

                    return true;
                } catch (error) {
                    console.error('Error in form submit handler:', error);
                    return true;
                }
            });
        });
    </script>

    <script>
        // Extend certificate-create.js for Edit page specifics
        window.CertificateEdit = window.CertificateEdit || {};

        // Delete confirmation using custom modal
        window.CertificateEdit.confirmDelete = async function(certificateNumber) {
            if (!certificateNumber) {
                console.error('Certificate number is missing');
                return;
            }

            const confirmed = await window.CertificateCreate.showConfirmation({
                title: 'Delete Certificate',
                message: 'Are you sure you want to delete this certificate? This action cannot be undone.',
                confirmText: 'Delete',
                type: 'danger'
            });

            if (!confirmed) return;

            try {
                const response = await fetch(`/Certificate/Delete/${encodeURIComponent(certificateNumber)}`, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });
                let payload = null;
                try { payload = await response.json(); } catch (_) { /* non-JSON response */ }

                if (response.ok && payload && payload.success) {
                    const target = payload.redirectUrl || '@Url.Action("CertificateTileViewInternal", "Certificate")';
                    window.location.href = target;
                } else {
                    const msg = (payload && payload.message) || `Failed to delete certificate (HTTP ${response.status})`;
                    console.error('Delete failed:', response.status, payload);
                    if (window.AdminCore && AdminCore.showNotification) {
                        AdminCore.showNotification(msg, 'error');
                    } else {
                        alert(msg);
                    }
                }
            } catch (error) {
                console.error('Error deleting certificate:', error);
                if (window.AdminCore && AdminCore.showNotification) {
                    AdminCore.showNotification('An error occurred while deleting the certificate', 'error');
                } else {
                    alert('An error occurred while deleting the certificate');
                }
            }
        };

        // Remove saved PDF confirmation and API call
        window.CertificateEdit.confirmRemovePdf = async function(certificateId) {
            const confirmed = await window.CertificateCreate.showConfirmation({
                title: 'Remove Certificate PDF',
                message: 'Are you sure you want to remove the uploaded PDF and its preview? This action cannot be undone.',
                confirmText: 'Remove',
                type: 'danger'
            });

            if (confirmed) {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const response = await fetch(`/api/CertificatesApi/${certificateId}/pdf`, {
                        method: 'DELETE',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    if (response.ok) {
                        // Hide the current PDF info bar
                        const pdfInfo = document.querySelector('.current-pdf-info');
                        if (pdfInfo) pdfInfo.style.display = 'none';

                        // Reset sidebar preview
                        const sidebarPreview = document.querySelector('.preview-container');
                        if (sidebarPreview) {
                            sidebarPreview.innerHTML = `
                                <div class="no-preview" style="text-align: center; color: #6c757d;">
                                    <i class="fas fa-file-pdf" style="font-size: 48px; color: #adb5bd; margin-bottom: 12px; display: block;"></i>
                                    <p style="font-size: 14px; font-weight: 600; color: #6c757d; margin: 0 0 4px 0;">Certificate Unavailable</p>
                                    <small style="color: #adb5bd; font-size: 11px;">Upload a PDF to generate preview</small>
                                </div>
                            `;
                        }

                        // Clear hidden input
                        const hiddenInput = document.getElementById('certificateImagePathHidden') || document.getElementById('CertificateImagePath');
                        if (hiddenInput) hiddenInput.value = '';

                        // Update upload label
                        const uploadLabel = document.querySelector('label[for="certificatePdf"]');
                        if (uploadLabel) uploadLabel.textContent = 'Upload PDF Certificate';

                        ModalSystem.showNotification('Certificate PDF removed successfully.', 'success');
                    } else {
                        const result = await response.json();
                        ModalSystem.showNotification(result.message || 'Failed to remove PDF.', 'error');
                    }
                } catch (error) {
                    console.error('Error removing PDF:', error);
                    ModalSystem.showNotification('An error occurred while removing the PDF.', 'error');
                }
            }
        };

        // Load existing tags on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Load existing external tags
            @if (ViewBag.ExistingExternalTags != null && ViewBag.ExistingExternalTags.Count > 0)
            {
                <text>
                const existingExternalTags = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingExternalTags));
                existingExternalTags.forEach(tag => {
                    window.CertificateCreate.TagManager = window.CertificateCreate.TagManager || { externalTags: [], internalTags: [] };
                    if (!window.CertificateCreate.TagManager.externalTags.includes(tag.Id)) {
                        window.CertificateCreate.TagManager.externalTags.push(tag.Id);
                        const container = document.getElementById('externalTagsContainer');
                        if (container) {
                            const tagElement = document.createElement('span');
                            tagElement.className = 'tag external';
                            tagElement.dataset.tagId = tag.Id;
                            tagElement.innerHTML = `
                                ${tag.Name}
                                <button type="button" class="tag-remove" onclick="window.CertificateCreate.removeTag('${tag.Id}', 'external')">
                                    &times;
                                </button>
                            `;
                            container.appendChild(tagElement);
                        }
                    }
                });
                document.getElementById('externalTagsHidden').value = JSON.stringify(existingExternalTags.map(t => t.Id));
                </text>
            }

            // Load existing internal tags
            @if (ViewBag.ExistingInternalTags != null && ViewBag.ExistingInternalTags.Count > 0)
            {
                <text>
                const existingInternalTags = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingInternalTags));
                existingInternalTags.forEach(tag => {
                    window.CertificateCreate.TagManager = window.CertificateCreate.TagManager || { externalTags: [], internalTags: [] };
                    if (!window.CertificateCreate.TagManager.internalTags.includes(tag.Id)) {
                        window.CertificateCreate.TagManager.internalTags.push(tag.Id);
                        const container = document.getElementById('internalTagsContainer');
                        if (container) {
                            const tagElement = document.createElement('span');
                            tagElement.className = 'tag internal';
                            tagElement.dataset.tagId = tag.Id;
                            tagElement.innerHTML = `
                                ${tag.Name}
                                <button type="button" class="tag-remove" onclick="window.CertificateCreate.removeTag('${tag.Id}', 'internal')">
                                    &times;
                                </button>
                            `;
                            container.appendChild(tagElement);
                        }
                    }
                });
                document.getElementById('internalTagsHidden').value = JSON.stringify(existingInternalTags.map(t => t.Id));
                </text>
            }
        });
    </script>
}
