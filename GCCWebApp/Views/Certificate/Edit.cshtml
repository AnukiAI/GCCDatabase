@model GCCWebApp.Models.CertificateEditViewModel
@{
    ViewData["Title"] = "Edit Certificate";
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Edit Certificate @Model.Number</span>
    </span>
}

@section Styles {
    <link href="~/css/product-id-manager.css" rel="stylesheet" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-primary fs-2 fw-semibold">Edit Certificate</h1>
                <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="text-muted text-decoration-none">← Back to Certificate Management</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h2 class="card-title mb-1 fs-5 fw-medium">Edit Certificate</h2>
                    <div class="text-muted small">General</div>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("Edit", "Certificate", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)

                        <div class="row">
                            <div class="col-lg-8">
                                <div class="row g-3">
                                    <!-- Company Section -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.CompanyId, new { @class = "form-label fw-medium" })
                                            @Html.DropDownListFor(m => m.CompanyId,
                                                new SelectList(ViewBag.Companies, "Id", "Name", Model.CompanyId),
                                                "Select Company",
                                                new { @class = "form-select", required = "required" })
                                            @Html.ValidationMessageFor(m => m.CompanyId, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Number, new { @class = "form-label fw-medium" })
                                            @Html.TextBoxFor(m => m.Number, new { @class = "form-control", required = "required", maxlength = "7" })
                                            @Html.ValidationMessageFor(m => m.Number, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.CertificationTypeId, new { @class = "form-label fw-medium" })
                                            @Html.DropDownListFor(m => m.CertificationTypeId,
                                                new SelectList(ViewBag.CertificationTypes, "Id", "Name", Model.CertificationTypeId),
                                                "Select Certification Type",
                                                new { @class = "form-select", required = "required" })
                                            @Html.ValidationMessageFor(m => m.CertificationTypeId, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.EffectiveDate, new { @class = "form-label fw-medium" })
                                            @Html.TextBoxFor(m => m.EffectiveDate, new { @class = "form-control", type = "date", required = "required" })
                                            @Html.ValidationMessageFor(m => m.EffectiveDate, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.ExpirationDate, new { @class = "form-label fw-medium" })
                                            @Html.TextBoxFor(m => m.ExpirationDate, new { @class = "form-control", type = "date", required = "required" })
                                            @Html.ValidationMessageFor(m => m.ExpirationDate, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Status, new { @class = "form-label fw-medium" })
                                            @Html.DropDownListFor(m => m.Status,
                                                new SelectList(new[] {
                                                    new { Value = "Active", Text = "Active" },
                                                    new { Value = "Draft", Text = "Draft" },
                                                    new { Value = "Client Approved - Not Paid", Text = "Client Approved - Not Paid" },
                                                    new { Value = "Client Approved - Confidential", Text = "Client Approved - Confidential" },
                                                    new { Value = "Client Approved - Paid", Text = "Client Approved - Paid" },
                                                    new { Value = "Hold", Text = "Hold" },
                                                    new { Value = "Expired", Text = "Expired" }
                                                }, "Value", "Text", Model.Status),
                                                new { @class = "form-select", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Partner, new { @class = "form-label fw-medium" })
                                            @Html.DropDownListFor(m => m.Partner,
                                                new SelectList(new[] {
                                                    new { Value = "None", Text = "None" },
                                                    new { Value = "Amazon", Text = "Amazon" },
                                                    new { Value = "Wayfair", Text = "Wayfair" },
                                                    new { Value = "Other", Text = "Other" }
                                                }, "Value", "Text", Model.Partner),
                                                "Select Partner",
                                                new { @class = "form-select" })
                                            @Html.ValidationMessageFor(m => m.Partner, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <!-- Product Section -->
                                    <div class="col-12">
                                        <hr class="my-4">
                                        <h3 class="text-secondary fs-5 mb-3">Product Information</h3>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.ProductId, new { @class = "form-label fw-medium" })
                                            @Html.DropDownListFor(m => m.ProductId,
                                                new SelectList(ViewBag.Products, "Id", "Name", Model.ProductId),
                                                "Select Product",
                                                new { @class = "form-select", required = "required" })
                                            @Html.ValidationMessageFor(m => m.ProductId, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Location, new { @class = "form-label fw-medium" })
                                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", maxlength = "175" })
                                            @Html.ValidationMessageFor(m => m.Location, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Country, new { @class = "form-label fw-medium" })
                                            @Html.DropDownListFor(m => m.Country,
                                                new SelectList(new[] {
                                                    new { Value = "United States", Text = "United States" },
                                                    new { Value = "Canada", Text = "Canada" },
                                                    new { Value = "Mexico", Text = "Mexico" },
                                                    new { Value = "United Kingdom", Text = "United Kingdom" },
                                                    new { Value = "Germany", Text = "Germany" }
                                                }, "Value", "Text", Model.Country),
                                                "Select Country",
                                                new { @class = "form-select" })
                                            @Html.ValidationMessageFor(m => m.Country, "", new { @class = "invalid-feedback" })
                                        </div>
                                    </div>

                                    <!-- Product ID Manager Section -->
                                    <div class="col-12">
                                        <hr class="my-4">
                                        @{
                                            ViewData["CertificateId"] = Model.Id;
                                            ViewData["IsReadOnly"] = false;
                                        }
                                        @await Html.PartialAsync("_ProductIdManager", Model.ProductIds)
                                    </div>
                                </div>
                            </div>

                            <!-- Sidebar -->
                            <div class="col-lg-4">
                                <div class="border border-2 border-dashed rounded p-4 text-center bg-light mb-4">
                                    <h5 class="text-secondary mb-3">Upload Certificate Image 📎</h5>
                                    <div class="border border-dashed rounded p-4 mb-3 bg-white" style="min-height: 120px; display: flex; align-items: center; justify-content: center;">
                                        <span class="text-muted small">(Placeholder Image)</span>
                                    </div>
                                    <small class="text-muted">Drag and drop or click to select</small>
                                </div>

                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">Certificate Information</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label fw-medium small">Certificate Status</label>
                                            <span class="badge bg-success ms-2">@Model.Status</span>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-medium small">Partner Program</label>
                                            <span class="badge bg-warning text-dark ms-2">@(Model.Partner ?? "None")</span>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-medium small">Created</label>
                                            <div class="text-muted small">@DateTime.Now.ToString("yyyy-MM-dd")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <hr class="my-4">
                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                            <a href="@Url.Action("Details", "Certificate", new { id = Model.Id })" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Delete", "Certificate", new { id = Model.Id })" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this certificate?')">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();

        // Date validation - expiration date should be after effective date
        document.addEventListener('DOMContentLoaded', function() {
            const effectiveDate = document.getElementById('@Html.IdFor(m => m.EffectiveDate)');
            const expirationDate = document.getElementById('@Html.IdFor(m => m.ExpirationDate)');

            function validateDates() {
                if (effectiveDate.value && expirationDate.value) {
                    if (new Date(expirationDate.value) <= new Date(effectiveDate.value)) {
                        expirationDate.setCustomValidity('Expiration date must be after effective date');
                    } else {
                        expirationDate.setCustomValidity('');
                    }
                }
            }

            effectiveDate.addEventListener('change', validateDates);
            expirationDate.addEventListener('change', validateDates);
        });
    </script>
    <script src="~/js/product-id-manager.js"></script>
    <script>
        // Initialize Product ID Manager for edit form
        document.addEventListener('DOMContentLoaded', function() {
            const productIdManager = new ProductIdManager('.product-id-manager', @Model.Id, false);
        });
    </script>
}