@model GCCWebApp.Models.CertificateEditViewModel

@{
    ViewData["Title"] = "Edit Certificate";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/certificate-create.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/product-id-manager.css" asp-append-version="true" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <a href="/">Home</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a asp-controller="Certificate" asp-action="CertificateTileViewInternal">Certificate Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Edit Certificate @Model.Number</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">Edit Certificate</h1>
                <p class="admin-page-subtitle">Edit certificate @Model.Number in the GreenCircle Certified database</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Management
                    </a>
                </div>
            </div>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" data-success-message="@TempData["SuccessMessage"]" style="margin-bottom: 24px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="admin-content">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate id="certificateEditForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            @Html.HiddenFor(m => m.Id)

            <div class="form-section-header">
                <i class="fas fa-file-certificate"></i>
                <span>Certificate Information</span>
            </div>

            <div class="form-grid">
                <div class="main-form">
                    <!-- Company Section -->
                    <div class="form-group">
                        <label asp-for="CompanyId">Company <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CompanyId" required aria-required="true">
                            <option value="">Select a company...</option>
                            @if (ViewBag.Companies != null)
                            {
                                @foreach (var company in ViewBag.Companies)
                                {
                                    <option value="@company.Id" selected="@(company.Id == Model.CompanyId)">@company.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Number">Certification # <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="Number" placeholder="XX-XXXX" required maxlength="7" aria-required="true" />
                        <span asp-validation-for="Number" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationTypeId">Certification Type <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="CertificationTypeId" id="CertificationTypeId" required aria-required="true">
                            <option value="">Select type...</option>
                            @if (ViewBag.ParentCertificationTypes != null)
                            {
                                @foreach (var certType in ViewBag.ParentCertificationTypes)
                                {
                                    <option value="@certType.Id" selected="@(certType.Id == Model.CertificationTypeId)">@certType.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CertificationTypeId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group" id="subcategory-group" style="display: none;">
                        <label asp-for="CertificationTypeSubcategoryId">Subcategory <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <select asp-for="CertificationTypeSubcategoryId" id="CertificationTypeSubcategoryId">
                            <option value="">Select subcategory...</option>
                        </select>
                        <span asp-validation-for="CertificationTypeSubcategoryId" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Select a subcategory if applicable (e.g., "Consumer Behavior" under "Certified Energy Savings")</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductId">Product Name <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="ProductId" required aria-required="true">
                            <option value="">Select a product...</option>
                            @if (ViewBag.Products != null)
                            {
                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id" selected="@(product.Id == Model.ProductId)">@product.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EffectiveDate">Effective Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="EffectiveDate" type="date" required aria-required="true" />
                        <span asp-validation-for="EffectiveDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ExpirationDate">Expiration Date <span class="text-danger" aria-label="required">*</span></label>
                        <input asp-for="ExpirationDate" type="date" required aria-required="true" />
                        <span asp-validation-for="ExpirationDate" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Status <span class="text-danger" aria-label="required">*</span></label>
                        <select asp-for="Status" required aria-required="true">
                            <option value="">Select status...</option>
                            @if (ViewBag.Statuses != null)
                            {
                                foreach (var status in ViewBag.Statuses)
                                {
                                    <option value="@status.Key" selected="@(status.Key == Model.Status)">@status.Value</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Partner">Partner</label>
                        <select asp-for="Partner">
                            <option value="">None</option>
                            <option value="Amazon" selected="@(Model.Partner == "Amazon")">Amazon</option>
                            <option value="Novi" selected="@(Model.Partner == "Novi")">Novi</option>
                            <option value="Other" selected="@(Model.Partner == "Other")">Other</option>
                        </select>
                        <span asp-validation-for="Partner" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CertificationResults">Certification Results <span class="text-muted" style="font-size: 12px;">(Optional)</span></label>
                        <textarea asp-for="CertificationResults" rows="3" maxlength="1000" placeholder="Enter test results or scores if required by partner (e.g., threshold values for Amazon)"></textarea>
                        <span asp-validation-for="CertificationResults" class="text-danger" role="alert"></span>
                        <small class="form-text text-muted">Optional field for recording certification test results or scores.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Location">Location</label>
                        <input asp-for="Location" placeholder="City, State" maxlength="175" />
                        <span asp-validation-for="Location" class="text-danger" role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <select asp-for="Country">
                            <option value="">Select country...</option>
                            <option value="United States" selected="@(Model.Country == "United States")">United States</option>
                            <option value="Canada" selected="@(Model.Country == "Canada")">Canada</option>
                            <option value="Mexico" selected="@(Model.Country == "Mexico")">Mexico</option>
                            <option value="United Kingdom" selected="@(Model.Country == "United Kingdom")">United Kingdom</option>
                            <option value="Germany" selected="@(Model.Country == "Germany")">Germany</option>
                        </select>
                        <span asp-validation-for="Country" class="text-danger" role="alert"></span>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="certificate-sidebar">
                    <div class="upload-section card-style">
                        <div class="section-icon">
                            <i class="fas fa-image"></i>
                        </div>
                        <h3 id="certificate-image-label">Certificate Preview</h3>
                        <p id="certificate-image-help" class="text-muted" style="font-size: 13px;">Auto-generated from uploaded PDF</p>
                        <div class="preview-container" style="min-height: 150px; display: flex; align-items: center; justify-content: center; background: #f8f9fa; border: 1px dashed #dee2e6; border-radius: 6px; padding: 16px;">
                            @if (!string.IsNullOrEmpty(Model.CertificateImagePath))
                            {
                                <img id="certificateImagePreviewImg" src="/@Model.CertificateImagePath" alt="Certificate Preview" style="max-width: 100%; max-height: 300px; object-fit: contain; border-radius: 4px;" />
                            }
                            else
                            {
                                <div class="no-preview" style="text-align: center; color: #6c757d;">
                                    <i class="fas fa-file-pdf" style="font-size: 48px; margin-bottom: 8px;"></i>
                                    <p style="margin: 0;">No preview available</p>
                                    <small>Upload a PDF certificate to generate preview</small>
                                </div>
                            }
                        </div>
                        <input type="hidden" asp-for="CertificateImagePath" id="certificateImagePathHidden" />
                    </div>

                    <div class="tags-section card-style">
                        <div class="section-icon">
                            <i class="fas fa-tags"></i>
                        </div>
                        <h3>Certificate Tags</h3>

                        <div class="tags-group">
                            <label for="externalTagSelect">External Tags</label>
                            <select id="externalTagSelect" aria-label="Select external tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.ExternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.ExternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="externalTagsContainer" aria-live="polite" aria-label="Selected external tags">
                                <!-- External tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="ExternalTags" id="externalTagsHidden" />
                        </div>

                        <div class="tags-group">
                            <label for="internalTagSelect">Internal Tags</label>
                            <select id="internalTagSelect" aria-label="Select internal tags for this certificate">
                                <option value="">Select...</option>
                                @if (ViewBag.InternalTags != null)
                                {
                                    @foreach (var tag in ViewBag.InternalTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                }
                            </select>
                            <div class="tags-container" id="internalTagsContainer" aria-live="polite" aria-label="Selected internal tags">
                                <!-- Internal tags will be added dynamically -->
                            </div>
                            <input type="hidden" name="InternalTags" id="internalTagsHidden" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate PDF Upload Section -->
            <div class="certificate-section card-style">
                <div class="form-section-header">
                    <i class="fas fa-file-pdf"></i>
                    <span>Certificate PDF Document</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.CertificateImagePath))
                {
                    <div class="current-pdf-info" style="background-color: #e8f5e9; border: 1px solid #4caf50; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
                        <i class="fas fa-check-circle" style="color: #4caf50; font-size: 20px;"></i>
                        <div style="flex: 1;">
                            <strong style="color: #2e7d32;">Current PDF:</strong>
                            <span style="color: #1b5e20; margin-left: 8px;">@System.IO.Path.GetFileName(Model.CertificateImagePath)</span>
                        </div>
                        <a href="@Url.Action("Download", "Certificate", new { id = Model.Id })"
                           class="btn btn-sm"
                           style="background-color: #4caf50; color: white; padding: 4px 12px; border-radius: 4px; text-decoration: none;"
                           target="_blank"
                           title="Download current PDF">
                            <i class="fas fa-download"></i> View
                        </a>
                    </div>
                }
                <div class="form-group">
                    <label for="certificatePdf">@(string.IsNullOrEmpty(Model.CertificateImagePath) ? "Upload PDF Certificate" : "Replace PDF Certificate (optional)")</label>
                    <div class="pdf-upload" id="pdfUploadZone" role="button" tabindex="0" aria-label="Upload PDF certificate file. You can drag and drop a file here or press Enter to select a file." onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('certificatePdf').click();}">
                        <i class="fas fa-file-pdf" style="font-size: 48px; color: var(--warning); margin-bottom: 12px;"></i>
                        <div class="pdf-upload-text">Drag and drop PDF here or click to select</div>
                        <small style="color: var(--text-secondary); font-size: 13px;">Maximum file size: 10MB. @(string.IsNullOrEmpty(Model.CertificateImagePath) ? "" : "Leave empty to keep existing PDF.")</small>
                    </div>
                    <input type="file" id="certificatePdf" name="certificatePdf" accept="application/pdf" style="display: none;" aria-describedby="pdf-help" />
                    <div id="pdfPreviewContainer" aria-live="polite"></div>
                </div>
            </div>

            <!-- Product ID Manager -->
            <div class="product-manager card-style">
                <div class="form-section-header">
                    <i class="fas fa-barcode"></i>
                    <span>Product Identifiers</span>
                </div>
                <p class="section-description">Manage ASINs, UPCs, GTINs, and other product identifiers</p>
                @{
                    ViewData["CertificateId"] = Model.Id;
                    ViewData["IsReadOnly"] = false;
                }
                @await Html.PartialAsync("_ProductIdManager", Model.ProductIds)
            </div>

            <!-- Custom Fields Section -->
            <div class="card-style" style="margin-bottom: 24px;">
                <div class="form-section-header">
                    <i class="fas fa-sliders-h"></i>
                    <span>Custom Fields</span>
                </div>

                <div id="custom-fields-container" class="mb-4">
                    <p class="text-muted">Loading custom fields...</p>
                </div>
            </div>

            <div class="action-buttons">
                <button type="submit" name="action" value="save" class="btn btn-primary" aria-label="Save certificate changes">
                    <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                </button>
                <a href="@Url.Action("CertificateTileViewInternal", "Certificate")" class="btn btn-outline" aria-label="Cancel and return to certificate management">
                    <i class="fas fa-times" aria-hidden="true"></i> Cancel
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <button type="button" class="btn btn-outline" style="background-color: #FF5252; color: white; border: none;" onclick="window.CertificateEdit.confirmDelete(@Model.Id)" aria-label="Delete this certificate permanently">
                        <i class="fas fa-trash" aria-hidden="true"></i> Delete
                    </button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/product-id-manager.js"></script>
    <script src="~/js/certificate-custom-fields.js"></script>
    <script src="~/js/certificate-create.js"></script>
    <script src="~/js/certificate-inline-create.js"></script>

    <script>
        // Store all certification types for subcategory filtering
        var allCertificationTypes = @Html.Raw(Json.Serialize(ViewBag.AllCertificationTypes ?? new List<object>()));
        var initialSubcategoryId = @(Model.CertificationTypeSubcategoryId.HasValue ? Model.CertificationTypeSubcategoryId.Value.ToString() : "null");

        $(document).ready(async function() {
            const certificateId = @Model.Id;
            const typeId = @Model.CertificationTypeId;

            // Initialize subcategory dropdown based on current type
            function initializeSubcategory() {
                const subcategorySelect = $('#CertificationTypeSubcategoryId');
                const subcategoryGroup = $('#subcategory-group');

                subcategorySelect.html('<option value="">Select subcategory...</option>');

                if (typeId) {
                    const subcategories = allCertificationTypes.filter(ct => ct.parentId === typeId);

                    if (subcategories.length > 0) {
                        subcategories.forEach(sub => {
                            const selected = sub.id === initialSubcategoryId ? 'selected' : '';
                            subcategorySelect.append(`<option value="${sub.id}" ${selected}>${sub.name}</option>`);
                        });
                        subcategoryGroup.show();
                    } else {
                        subcategoryGroup.hide();
                    }
                }
            }

            initializeSubcategory();

            // Load subcategories when certification type changes
            $('#CertificationTypeId').change(function() {
                const newTypeId = parseInt($(this).val());
                const subcategorySelect = $('#CertificationTypeSubcategoryId');
                const subcategoryGroup = $('#subcategory-group');

                subcategorySelect.html('<option value="">Select subcategory...</option>');

                if (newTypeId) {
                    const subcategories = allCertificationTypes.filter(ct => ct.parentId === newTypeId);

                    if (subcategories.length > 0) {
                        subcategories.forEach(sub => {
                            subcategorySelect.append(`<option value="${sub.id}">${sub.name}</option>`);
                        });
                        subcategoryGroup.show();
                    } else {
                        subcategoryGroup.hide();
                    }

                    // Load custom fields for the selected type
                    if (typeof certificateCustomFields !== 'undefined') {
                        certificateCustomFields.loadFieldsForType(newTypeId);
                    }
                } else {
                    subcategoryGroup.hide();
                    $('#custom-fields-container').html('<p class="text-muted">Select a certification type to load custom fields.</p>');
                }
            });

            // Load custom fields for the certificate type
            async function loadCustomFields() {
                if (typeId) {
                    await certificateCustomFields.loadFieldsForType(typeId);
                    // Load existing values after fields are rendered
                    await certificateCustomFields.loadFieldValues(certificateId);
                }
            }

            await loadCustomFields();

            // Intercept form submission to handle custom fields
            const form = document.getElementById('certificateEditForm');

            form.addEventListener('submit', function(e) {
                // First validate custom fields
                const validation = certificateCustomFields.validateFields();
                if (!validation.isValid) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (typeof AdminCore !== 'undefined' && AdminCore.showNotification) {
                        AdminCore.showNotification('Please fix validation errors: ' + validation.errors.join(', '), 'error');
                    } else {
                        console.error('Validation errors: ' + validation.errors.join(', '));
                    }
                    return false;
                }

                // Get custom field values
                const fieldValues = certificateCustomFields.getFieldValues();

                // Remove any existing custom field hidden inputs
                form.querySelectorAll('input[name^="CustomFieldValues"]').forEach(input => input.remove());

                // Add custom field values as hidden inputs to the form
                // Format: CustomFieldValues[fieldId] = value
                Object.keys(fieldValues).forEach(fieldId => {
                    const hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = `CustomFieldValues[${fieldId}]`;
                    hiddenInput.value = fieldValues[fieldId] || '';
                    form.appendChild(hiddenInput);
                });

                console.log('Custom field values added to form:', fieldValues);

                // Add Product IDs to the form (from Product ID Manager)
                // This ensures product IDs are submitted with the form like custom fields
                if (typeof window.productIdManager !== 'undefined' && window.productIdManager.productIds) {
                    // Remove any existing ProductIds hidden inputs to avoid duplicates
                    form.querySelectorAll('input[name^="ProductIds"]').forEach(input => input.remove());

                    // Add each product ID as hidden inputs in the format ProductIds[index].PropertyName
                    window.productIdManager.productIds.forEach((pid, index) => {
                        const fields = {
                            'Id': pid.id || 0,
                            'CertificateId': pid.certificateId || @Model.Id,
                            'ProductIdType': pid.productIdType || '',
                            'ProductIdValue': pid.productIdValue || '',
                            'Status': pid.status || 'Active',
                            'Partner': pid.partner || '',
                            'ProductName': pid.productName || '',
                            'ProductSku': pid.productSku || '',
                            'Description': pid.description || ''
                        };

                        Object.entries(fields).forEach(([key, value]) => {
                            const hiddenInput = document.createElement('input');
                            hiddenInput.type = 'hidden';
                            hiddenInput.name = `ProductIds[${index}].${key}`;
                            hiddenInput.value = value;
                            form.appendChild(hiddenInput);
                        });
                    });

                    console.log('Product IDs added to form:', window.productIdManager.productIds.length);
                }

                // Allow form to submit normally
                return true;
            });
        });
    </script>

    <script>
        // Extend certificate-create.js for Edit page specifics
        window.CertificateEdit = window.CertificateEdit || {};

        // Delete confirmation using custom modal
        window.CertificateEdit.confirmDelete = async function(certificateId) {
            const confirmed = await window.CertificateCreate.showConfirmation({
                title: 'Delete Certificate',
                message: 'Are you sure you want to delete this certificate? This action cannot be undone.',
                confirmText: 'Delete',
                type: 'danger'
            });

            if (confirmed) {
                // Redirect to delete action
                window.location.href = '@Url.Action("Delete", "Certificate")/' + certificateId;
            }
        };

        // Load existing tags on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Load existing external tags
            @if (ViewBag.ExistingExternalTags != null && ViewBag.ExistingExternalTags.Count > 0)
            {
                <text>
                const existingExternalTags = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingExternalTags));
                existingExternalTags.forEach(tag => {
                    window.CertificateCreate.TagManager = window.CertificateCreate.TagManager || { externalTags: [], internalTags: [] };
                    if (!window.CertificateCreate.TagManager.externalTags.includes(tag.Id)) {
                        window.CertificateCreate.TagManager.externalTags.push(tag.Id);
                        const container = document.getElementById('externalTagsContainer');
                        if (container) {
                            const tagElement = document.createElement('span');
                            tagElement.className = 'tag external';
                            tagElement.dataset.tagId = tag.Id;
                            tagElement.innerHTML = `
                                ${tag.Name}
                                <button type="button" class="tag-remove" onclick="window.CertificateCreate.removeTag('${tag.Id}', 'external')">
                                    ×
                                </button>
                            `;
                            container.appendChild(tagElement);
                        }
                    }
                });
                document.getElementById('externalTagsHidden').value = JSON.stringify(existingExternalTags.map(t => t.Id));
                </text>
            }

            // Load existing internal tags
            @if (ViewBag.ExistingInternalTags != null && ViewBag.ExistingInternalTags.Count > 0)
            {
                <text>
                const existingInternalTags = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingInternalTags));
                existingInternalTags.forEach(tag => {
                    window.CertificateCreate.TagManager = window.CertificateCreate.TagManager || { externalTags: [], internalTags: [] };
                    if (!window.CertificateCreate.TagManager.internalTags.includes(tag.Id)) {
                        window.CertificateCreate.TagManager.internalTags.push(tag.Id);
                        const container = document.getElementById('internalTagsContainer');
                        if (container) {
                            const tagElement = document.createElement('span');
                            tagElement.className = 'tag internal';
                            tagElement.dataset.tagId = tag.Id;
                            tagElement.innerHTML = `
                                ${tag.Name}
                                <button type="button" class="tag-remove" onclick="window.CertificateCreate.removeTag('${tag.Id}', 'internal')">
                                    ×
                                </button>
                            `;
                            container.appendChild(tagElement);
                        }
                    }
                });
                document.getElementById('internalTagsHidden').value = JSON.stringify(existingInternalTags.map(t => t.Id));
                </text>
            }
        });
    </script>
}
