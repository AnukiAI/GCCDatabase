@{
    ViewData["Title"] = "Certificate Import";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <a href="@Url.Action("CertificateTileViewInternal", "Certificate")">Certificates</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Import</span>
    </span>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="admin-container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle"></i> @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <p class="admin-page-subtitle">Bulk import certificates from CSV file</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <a href="@Url.Action("DownloadTemplate", "CertificateImport")"
                       class="admin-btn admin-btn--secondary"
                       title="Download CSV template with example data">
                        <i class="fas fa-file-download"></i> Download Template
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="admin-content">
        <!-- Info Panel -->
        <div class="alert alert-info" style="margin-bottom: 2rem;">
            <h4 style="margin-top: 0;"><i class="fas fa-info-circle"></i> Import Instructions</h4>
            <ul style="margin-bottom: 0;">
                <li><strong>Format:</strong> CSV file only (.csv extension)</li>
                <li><strong>Required Columns:</strong> CertificateNumber, CompanyName, ProductName, CertificationType</li>
                <li><strong>Behavior:</strong> Existing certificates will be updated, new ones will be created</li>
                <li><strong>Validation:</strong> Company, Product, and CertificationType must exist in database</li>
                <li><strong>Max Size:</strong> 10MB per file</li>
                <li><strong>Preview:</strong> You'll see all changes before applying them</li>
            </ul>
        </div>

        <!-- Upload Form -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">Upload Certificate CSV File</h3>
            </div>
            <div class="admin-card-body">
                <form asp-action="Upload" asp-controller="CertificateImport"
                      method="post" enctype="multipart/form-data" id="uploadForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="csvFile" class="form-label">
                            <i class="fas fa-file-csv"></i> Select CSV File
                        </label>
                        <div class="custom-file" style="margin-bottom: 1rem;">
                            <input type="file"
                                   class="custom-file-input"
                                   id="csvFile"
                                   name="csvFile"
                                   accept=".csv"
                                   required>
                            <label class="custom-file-label" for="csvFile">Choose file...</label>
                        </div>
                        <small class="form-text text-muted">
                            Select a CSV file containing certificate data. Download the template above if you need a format reference.
                        </small>
                    </div>

                    <div class="admin-button-group" style="margin-top: 2rem;">
                        <button type="submit" class="admin-btn admin-btn--primary">
                            <i class="fas fa-upload"></i> Upload & Preview
                        </button>
                        <a href="@Url.Action("CertificateTileView", "Certificate")"
                           class="admin-btn admin-btn--secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Recent Imports (Optional - for future enhancement) -->
        <div class="admin-card" style="margin-top: 2rem;">
            <div class="admin-card-header">
                <h3 class="admin-card-title">CSV Format Reference</h3>
            </div>
            <div class="admin-card-body">
                <p><strong>Required Columns:</strong></p>
                <ul>
                    <li><code>CERTIFICATE_NUMBER</code> - Unique certificate number (e.g., "24-0001")</li>
                    <li><code>COMPANY_NAME</code> - Company name (auto-created if not exists)</li>
                    <li><code>PRODUCT_NAME</code> - Product name (auto-created if not exists)</li>
                    <li><code>CERTIFICATION_TYPE</code> - Must match existing certification type (e.g., "Recycled Content")</li>
                </ul>

                <p><strong>Company Columns (Optional):</strong></p>
                <ul>
                    <li><code>COMPANY_LOCATION</code> - Company location (City, State)</li>
                    <li><code>COMPANY_COUNTRY</code> - Company country</li>
                    <li><code>COMPANY_EMAIL</code> - Company contact email</li>
                    <li><code>COMPANY_WEBSITE</code> - Company website URL</li>
                </ul>

                <p><strong>Product Columns (Optional):</strong></p>
                <ul>
                    <li><code>PRODUCT_TYPE</code> - Product type (auto-created if not exists)</li>
                </ul>

                <p><strong>Certificate Columns (Optional):</strong></p>
                <ul>
                    <li><code>EFFECTIVE_DATE</code> - Date format: YYYY-MM-DD</li>
                    <li><code>EXPIRATION_DATE</code> - Date format: YYYY-MM-DD</li>
                    <li><code>CERTIFICATE_LOCATION</code> - Certificate location (City, State)</li>
                    <li><code>CERTIFICATE_COUNTRY</code> - Certificate country</li>
                    <li><code>PARTNER</code> - Amazon, Novi, or None</li>
                    <li><code>CERTIFICATION_RESULTS</code> - Results/percentage achieved (e.g., "95%")</li>
                    <li><code>TAGS</code> - Comma-separated tags (e.g., "Sustainable,Verified")</li>
                </ul>

                <p><strong>Product ID Columns (Optional):</strong></p>
                <ul>
                    <li><code>ASIN</code> - Amazon Standard ID</li>
                    <li><code>UPC</code> - Universal Product Code</li>
                    <li><code>GTIN</code> - Global Trade Item Number</li>
                    <li><code>EAN</code> - European Article Number</li>
                </ul>

                <p class="text-muted" style="margin-top: 1rem;">
                    <i class="fas fa-info-circle"></i> PDF attachments are managed separately after import.
                </p>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        // Update file input label with selected filename
        document.getElementById('csvFile').addEventListener('change', function(e) {
            var fileName = e.target.files[0]?.name || 'Choose file...';
            e.target.nextElementSibling.textContent = fileName;
        });

        // Show loading state on form submit
        document.getElementById('uploadForm').addEventListener('submit', function() {
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        });
    </script>
}
