@{
    ViewData["Title"] = "Certificate Import";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <a href="@Url.Action("CertificateTileViewInternal", "Certificate")">Certificates</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Import</span>
    </span>
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.4.0/css/all.min.css">

<div class="admin-container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle"></i> @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Bulk import certificates from CSV file</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <a href="@Url.Action("History", "CertificateImport")"
                       class="admin-btn admin-btn--secondary"
                       title="View past imports and undo a mistaken import">
                        <i class="fas fa-clock-rotate-left"></i> Import History
                    </a>
                    <a href="@Url.Action("DownloadTemplate", "CertificateImport")"
                       class="admin-btn admin-btn--secondary"
                       title="Download CSV template with example data">
                        <i class="fas fa-file-download"></i> Download Template
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="admin-content">
        <!-- Info Panel -->
        <div class="alert alert-info" style="margin-bottom: 2rem;">
            <h4 style="margin-top: 0;"><i class="fas fa-info-circle"></i> Import Instructions</h4>
            <ul style="margin-bottom: 0;">
                <li><strong>Format:</strong> CSV file only (.csv extension). Use the <strong>Download Template</strong> button above &mdash; its headers are the column names described on this page.</li>
                <li><strong>Required columns:</strong> <code>Company</code>, <code>Product Name</code>, <code>Certification Type</code>. <strong>Certificate # is not required.</strong></li>
                <li><strong>To add a new certificate:</strong> leave <strong>Certificate #</strong> blank and the next available number is assigned automatically. Each blank row gets its own number.</li>
                <li><strong>To edit an existing certificate:</strong> enter its <strong>Certificate #</strong> and that certificate is updated. Only the columns present in your file are changed &mdash; any column you leave out is left untouched.</li>
                <li><strong>Overwrite confirmation:</strong> if any row would update an existing certificate you must tick an acknowledgement before it is applied, and a backup of those certificates is saved automatically first.</li>
                @* DEF-418 reopened 2026-09-16: "Tags" added so this list and the Import Certificates
                   modal on the certificate listing say the same thing. Tags genuinely are
                   auto-created (CertificateImportService.cs:787-798, as "external" type) — the modal
                   was right about that and this page had omitted it. *@
                <li><strong>Created automatically:</strong> Company, Product, Product Type and Tags are created if they don't already exist. <strong>Product Category must already exist</strong> &mdash; an unrecognised one rejects the row.</li>
                <li><strong>Max size:</strong> 10MB per file</li>
                <li><strong>Preview:</strong> you'll see every change, field by field, before anything is written.</li>
            </ul>
        </div>

        <!-- Upload Form -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">Upload Certificate CSV File</h3>
            </div>
            <div class="admin-card-body">
                <form asp-action="Upload" asp-controller="CertificateImport"
                      method="post" enctype="multipart/form-data" id="uploadForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="csvFile" class="form-label">
                            <i class="fas fa-file-csv"></i> Select CSV File
                        </label>
                        <div class="custom-file" style="margin-bottom: 1rem;">
                            <input type="file"
                                   class="custom-file-input"
                                   id="csvFile"
                                   name="csvFile"
                                   accept=".csv"
                                   required>
                            <label class="custom-file-label" for="csvFile">Choose file...</label>
                        </div>
                        <small class="form-text text-muted">
                            Select a CSV file containing certificate data. Download the template above if you need a format reference.
                        </small>
                    </div>

                    <div class="admin-button-group" style="margin-top: 2rem;">
                        <button type="submit" class="admin-btn admin-btn--primary">
                            <i class="fas fa-upload"></i> Upload & Preview
                        </button>
                        <a href="@Url.Action("CertificateTileView", "Certificate")"
                           class="admin-btn admin-btn--secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Recent Imports (Optional - for future enhancement) -->
        <div class="admin-card" style="margin-top: 2rem;">
            <div class="admin-card-header">
                <h3 class="admin-card-title">CSV Format Reference</h3>
            </div>
            <div class="admin-card-body">
                <p class="text-muted">
                    Column names below are the headers produced by <strong>Download Template</strong>.
                    Columns may appear in any order, and a column you omit entirely is left untouched
                    on an update.
                </p>

                <p><strong>Certificate # &mdash; optional; this is how you choose add vs. edit:</strong></p>
                <ul>
                    <li><code>Certificate #</code> &mdash; <strong>Leave blank</strong> to create a new certificate; the next available number is assigned for you.
                        <strong>Enter an existing number</strong> (e.g. "24-0001") to update that certificate instead. Updates require an
                        on-screen acknowledgement, and a backup is taken automatically before anything is changed.</li>
                </ul>

                <p><strong>Required Columns</strong> &mdash; a row without these is rejected:</p>
                <ul>
                    <li><code>Company</code> &mdash; Company name (created automatically if it doesn't exist)</li>
                    <li><code>Product Name</code> &mdash; Product name (created automatically if it doesn't exist)</li>
                    <li><code>Certification Type</code> &mdash; e.g. "Recycled Content". If the value isn't in the system the certificate
                        still imports and is set to the <em>Unspecified</em> placeholder for an analyst to correct.</li>
                </ul>

                <p><strong>Company Columns (Optional):</strong></p>
                <ul>
                    <li><code>Company Email</code> &mdash; Company contact email</li>
                    <li><code>Company URL</code> &mdash; Company website URL</li>
                    <li><code>COMPANY_LOCATION</code> &mdash; Company location, City, State (not in the template; accepted if you add it)</li>
                    <li><code>COMPANY_COUNTRY</code> &mdash; Company country (not in the template; accepted if you add it)</li>
                </ul>

                <p><strong>Product Columns (Optional):</strong></p>
                <ul>
                    <li><code>Product Category</code> &mdash; <strong>Must already exist.</strong> An unrecognised category rejects the row,
                        so that a typo cannot create a new category.</li>
                    <li><code>Product Type</code> &mdash; Product type (created automatically if it doesn't exist)</li>
                    @* DEF-418 sequencing note discharged 2026-09-16: DEF-421 wired this column up
                       (CertificateImportService.cs:95), so it is now documented. Parent-scoped
                       resolution and warn-don't-reject are both from DEF-421. *@
                    <li><code>Subcategory</code> &mdash; Product subcategory. Matched <strong>within the Product Type in the same row</strong>,
                        so the same subcategory name under a different type won't be picked by mistake. An unrecognised value is a
                        warning, not a rejection &mdash; the certificate still imports and the subcategory is left blank.</li>
                </ul>

                <p><strong>Certificate Columns (Optional):</strong></p>
                <ul>
                    <li><code>Status</code> &mdash; Draft, Client Approved - Not Paid, Client Approved - Confidential,
                        Client Approved - Paid, Hold, Expired, Republished, or Expired - No Annual Verification.
                        <strong>Defaults to Draft if blank.</strong></li>
                    @* DEF-418 sequencing note discharged 2026-09-16: wired by DEF-421
                       (CertificateImportService.cs:99). It is also an export column
                       (CertificateService.cs:1495), so the export → edit → re-import round-trip
                       depends on it being documented correctly. *@
                    <li><code>Cert Subcategories</code> &mdash; One or more certificate subcategories, separated by commas.
                        Each must belong to <strong>the Certification Type in the same row</strong>; an entry belonging to a different
                        type is skipped with a warning rather than rejecting the row. This column is also included in exports, so an
                        export &rarr; edit &rarr; re-import round-trip keeps it.</li>
                    <li><code>Effective Date</code> &mdash; YYYY-MM-DD recommended (other common date formats are accepted)</li>
                    <li><code>Expiration Date</code> &mdash; YYYY-MM-DD recommended (other common date formats are accepted)</li>
                    <li><code>Location</code> &mdash; Certificate location (City, State)</li>
                    <li><code>Country (separate by comma)</code> &mdash; One or more countries, separated by commas</li>
                    <li><code>Partner (separate by comma)</code> &mdash; One or more partners, separated by commas; leave blank for none</li>
                    <li><code>Pathway</code> &mdash; Optional pathway name; an unrecognised value is ignored rather than rejected</li>
                    <li><code>Cert Results</code> &mdash; Certification results achieved. Stored and displayed exactly as typed (e.g. "95%")</li>
                    <li><code>External Tag</code> &mdash; Comma-separated tags visible to external users (e.g. "Sustainable,Verified")</li>
                    <li><code>Internal Tag</code> &mdash; Comma-separated tags visible to internal users only</li>
                </ul>

                <p><strong>Product ID Columns (Optional):</strong></p>
                <ul>
                    <li><code>ASIN</code> &mdash; Amazon Standard ID</li>
                    <li><code>UPC</code> &mdash; Universal Product Code</li>
                    <li><code>GTIN</code> &mdash; Global Trade Item Number</li>
                    <li><code>EAN</code> &mdash; European Article Number</li>
                </ul>

                <p class="text-muted" style="margin-top: 1rem;">
                    <i class="fas fa-info-circle"></i> PDF attachments are managed separately after import.
                </p>
                <p class="text-muted">
                    <i class="fas fa-info-circle"></i> Older header spellings are still accepted for
                    backward compatibility &mdash; <code>CERTIFICATE_NUMBER</code>, <code>COMPANY_NAME</code>,
                    <code>PRODUCT_NAME</code>, <code>CERTIFICATION_TYPE</code> and the matching
                    <code>PascalCase</code> forms all import the same way.
                </p>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        var csvInput = document.getElementById('csvFile');
        var uploadForm = document.getElementById('uploadForm');

        // QC #190 (DEF-284): clear the value each time the picker opens so re-selecting a REVISED
        // file with the SAME name still fires 'change' and uploads the fresh file. Browsers suppress
        // the change event when the chosen path is identical to the input's current value, so without
        // this the form would keep the stale first selection (the "can't replace the attached file
        // with a same-named revision" bug).
        csvInput.addEventListener('click', function() { this.value = ''; });

        // Update file input label with selected filename
        csvInput.addEventListener('change', function(e) {
            var fileName = e.target.files[0]?.name || 'Choose file...';
            e.target.nextElementSibling.textContent = fileName;
        });

        // Show loading state on form submit
        uploadForm.addEventListener('submit', function() {
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        });

        // QC #190 (DEF-284): when the user returns here via the browser Back button (bfcache) after
        // viewing the preview, reset the stuck "Processing..." button and the (now-empty) file label
        // so they can immediately re-upload a revised file instead of hitting a disabled form.
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) {
                var submitBtn = uploadForm.querySelector('button[type="submit"]');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-upload"></i> Upload & Preview';
                csvInput.value = '';
                csvInput.nextElementSibling.textContent = 'Choose file...';
            }
        });
    </script>
}
