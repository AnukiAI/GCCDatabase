@model GCCWebApp.Models.Import.CertificateImportPreviewResult
@{
    ViewData["Title"] = "Import Preview";
    ViewData["BodyClass"] = "role-admin";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/pages/certificate-import.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <a href="@Url.Action("CertificateTileViewInternal", "Certificate")">Certificates</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="@Url.Action("Index", "CertificateImport")">Import</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Preview</span>
    </span>
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.4.0/css/all.min.css">

<div class="admin-container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Review changes before applying</p>
            </div>
        </div>
    </header>

    <main class="admin-content">
        <!-- Summary Stats -->
        <div class="row" style="margin-bottom: 2rem;">
            <div class="col-md-3">
                <div class="stat-card stat-card--primary">
                    <div class="stat-card-value">@Model.TotalRows</div>
                    <div class="stat-card-label">Total Rows</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card--success">
                    <div class="stat-card-value">@Model.NewCertificates</div>
                    <div class="stat-card-label">New</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card--warning">
                    <div class="stat-card-value">@Model.ModifiedCertificates</div>
                    <div class="stat-card-label">Modified</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card @(Model.InvalidRows > 0 ? "stat-card--danger" : "stat-card--secondary")">
                    <div class="stat-card-value">@Model.InvalidRows</div>
                    <div class="stat-card-label">Errors</div>
                </div>
            </div>
        </div>

        <!-- Company Reassignment Warning (miskeyed cert-number guard) -->
        @if (Model.HasCompanyReassignments)
        {
            <div class="alert alert-danger" style="margin-bottom: 2rem;" id="reassignmentWarning">
                <h4 style="margin-top: 0;">
                    <i class="fas fa-exclamation-triangle"></i>
                    @Model.CompanyReassignmentCount certificate(s) would change company
                </h4>
                <p style="margin-bottom: 0.75rem;">
                    The certificate number(s) below already exist under a <strong>different company</strong>.
                    Applying this import will <strong>overwrite those existing certificates</strong> and reassign
                    them. If a number was mistyped, this would replace the wrong certificate. Confirm each one is
                    intentional before applying.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm" style="margin-bottom: 0;">
                        <thead>
                            <tr>
                                <th>Row</th>
                                <th>Certificate #</th>
                                <th>Current Company</th>
                                <th></th>
                                <th>New Company (from file)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.CompanyReassignmentRows)
                            {
                                var companyChange = row.Changes.FirstOrDefault(c => c.FieldName == GCCWebApp.Models.Import.FieldChange.CompanyFieldName);
                                <tr>
                                    <td>@row.RowNumber</td>
                                    <td><code>@row.CertificateNumber</code></td>
                                    <td>@(string.IsNullOrEmpty(companyChange?.OldValue) ? "(empty)" : companyChange!.OldValue)</td>
                                    <td><i class="fas fa-arrow-right"></i></td>
                                    <td><strong>@(string.IsNullOrEmpty(companyChange?.NewValue) ? "(empty)" : companyChange!.NewValue)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Action Buttons -->
        @if (Model.CanApply)
        {
            <div class="admin-card" style="margin-bottom: 2rem; background-color: #f8f9fa;">
                <div class="admin-card-body">
                    <form asp-action="Apply" asp-controller="CertificateImport" method="post" id="applyForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="importId" value="@Model.ImportId" />

                        @if (Model.HasCompanyReassignments)
                        {
                            <div class="alert alert-warning" style="margin-bottom: 1rem;">
                                <label style="margin-bottom: 0; font-weight: 600; cursor: pointer;">
                                    <input type="checkbox"
                                           name="acknowledgeReassignments"
                                           value="true"
                                           id="acknowledgeReassignments" />
                                    I confirm the @Model.CompanyReassignmentCount certificate(s) above should be
                                    reassigned to a different company.
                                </label>
                            </div>
                        }

                        <div class="row align-items-end">
                            <div class="col-md-8">
                                <label for="reason" class="form-label">
                                    <i class="fas fa-comment"></i> Reason for Import (Optional)
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="reason"
                                       name="reason"
                                       placeholder="e.g., Q4 2024 certification updates"
                                       maxlength="500">
                            </div>
                            <div class="col-md-4">
                                <div class="admin-button-group">
                                    <button type="submit" class="admin-btn admin-btn--primary" id="applyBtn">
                                        <i class="fas fa-check"></i> Apply Import
                                    </button>
                                    <a href="@Url.Action("Index", "CertificateImport")" class="admin-btn admin-btn--secondary">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
        else if (Model.HasCriticalErrors)
        {
            <div class="alert alert-danger">
                <h4><i class="fas fa-exclamation-triangle"></i> Cannot Apply Import</h4>
                <p>This import contains critical errors and cannot be applied. Please fix the errors and upload again.</p>
            </div>
        }

        <!-- Error Rows -->
        @if (Model.ErrorRows.Any())
        {
            <div class="admin-card" style="margin-bottom: 2rem;">
                <div class="admin-card-header" style="background-color: #dc3545; color: white;">
                    <h3 class="admin-card-title">
                        <i class="fas fa-exclamation-circle"></i> Validation Errors (@Model.ErrorRows.Count)
                    </h3>
                </div>
                <div class="admin-card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Certificate Number</th>
                                    <th>Errors</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var error in Model.ErrorRows)
                                {
                                    <tr>
                                        <td>@error.RowNumber</td>
                                        <td><code>@error.CertificateNumber</code></td>
                                        <td>
                                            <ul style="margin: 0; padding-left: 1.2rem;">
                                                @foreach (var msg in error.ErrorMessages)
                                                {
                                                    <li>@msg</li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- New Certificates -->
        @if (Model.NewRows.Any())
        {
            <div class="admin-card" style="margin-bottom: 2rem;">
                <div class="admin-card-header" style="background-color: #28a745; color: white;">
                    <h3 class="admin-card-title">
                        <i class="fas fa-plus-circle"></i> New Certificates (@Model.NewCertificates)
                    </h3>
                </div>
                <div class="admin-card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Certificate #</th>
                                    <th>Company</th>
                                    <th>Product</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Dates</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.NewRows.Take(50))
                                {
                                    <tr>
                                        <td>@row.RowNumber</td>
                                        <td><code>@row.CertificateNumber</code></td>
                                        <td>@row.CompanyName</td>
                                        <td>@row.ProductName</td>
                                        <td>@row.CertificationType</td>
                                        <td><span class="badge badge-info">@row.Status</span></td>
                                        <td style="font-size: 0.85rem;">
                                            @row.EffectiveDate?.ToString("yyyy-MM-dd") - @row.ExpirationDate?.ToString("yyyy-MM-dd")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.NewRows.Count > 50)
                    {
                        <p class="text-muted" style="margin-top: 1rem;">
                            <i class="fas fa-info-circle"></i> Showing first 50 of @Model.NewRows.Count new certificates
                        </p>
                    }
                </div>
            </div>
        }

        <!-- Modified Certificates -->
        @if (Model.ModifiedRows.Any())
        {
            <div class="admin-card" style="margin-bottom: 2rem;">
                <div class="admin-card-header" style="background-color: #ffc107; color: #000;">
                    <h3 class="admin-card-title">
                        <i class="fas fa-edit"></i> Modified Certificates (@Model.ModifiedCertificates)
                    </h3>
                </div>
                <div class="admin-card-body">
                    @foreach (var row in Model.ModifiedRows.Take(50))
                    {
                        <div class="card" style="margin-bottom: 1rem; border-left: 4px solid #ffc107;">
                            <div class="card-header" style="background-color: #fff3cd;">
                                <strong>Row @row.RowNumber:</strong>
                                <code>@row.CertificateNumber</code> - @row.CompanyName / @row.ProductName
                            </div>
                            <div class="card-body">
                                <table class="table table-sm" style="margin-bottom: 0;">
                                    <thead>
                                        <tr>
                                            <th style="width: 25%;">Field</th>
                                            <th style="width: 37.5%;">Old Value</th>
                                            <th style="width: 37.5%;">New Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var change in row.Changes)
                                        {
                                            <tr>
                                                <td><strong>@change.FieldName</strong></td>
                                                <td style="background-color: #ffebee; text-decoration: line-through;">
                                                    @(string.IsNullOrEmpty(change.OldValue) ? "(empty)" : change.OldValue)
                                                </td>
                                                <td style="background-color: #e8f5e9;">
                                                    @(string.IsNullOrEmpty(change.NewValue) ? "(empty)" : change.NewValue)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    @if (Model.ModifiedRows.Count > 50)
                    {
                        <p class="text-muted" style="margin-top: 1rem;">
                            <i class="fas fa-info-circle"></i> Showing first 50 of @Model.ModifiedRows.Count modified certificates
                        </p>
                    }
                </div>
            </div>
        }

        <!-- Unchanged Certificates -->
        @if (Model.UnchangedRows.Any())
        {
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="fas fa-check-circle"></i> Unchanged Certificates (@Model.UnchangedCertificates)
                    </h3>
                </div>
                <div class="admin-card-body">
                    <p class="text-muted">
                        These certificates already exist in the database with the same data and will be skipped.
                    </p>
                    <details>
                        <summary style="cursor: pointer; color: #002B76;">
                            <i class="fas fa-list"></i> View unchanged certificates
                        </summary>
                        <div class="table-responsive" style="margin-top: 1rem;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Row</th>
                                        <th>Certificate Number</th>
                                        <th>Company</th>
                                        <th>Product</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.UnchangedRows.Take(100))
                                    {
                                        <tr>
                                            <td>@row.RowNumber</td>
                                            <td><code>@row.CertificateNumber</code></td>
                                            <td>@row.CompanyName</td>
                                            <td>@row.ProductName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </div>
        }
    </main>
</div>

@section Scripts {
    <script>
        // Confirm before applying
        document.getElementById('applyForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();

            // Company-reassignment guard: don't even open the confirm dialog until the analyst has
            // ticked the acknowledgement box. (The server enforces this too — this is just the UX.)
            const ackBox = document.getElementById('acknowledgeReassignments');
            if (ackBox && !ackBox.checked) {
                AdminCore.showNotification(
                    'Please confirm the company reassignment(s) by checking the acknowledgement box before applying.',
                    'warning');
                document.getElementById('reassignmentWarning')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            const reassignmentLine = ackBox
                ? '<br><strong style="color:#dc3545;">@Model.CompanyReassignmentCount certificate(s) will be reassigned to a different company.</strong><br>'
                : '';

            const confirmed = await AdminCore.showConfirmation({
                title: 'Apply Import',
                message: 'Are you sure you want to apply this import?<br><br>' +
                         '<strong>@Model.NewCertificates</strong> new certificate(s) will be created<br>' +
                         '<strong>@Model.ModifiedCertificates</strong> certificate(s) will be updated<br>' +
                         reassignmentLine +
                         '<br>All changes will be logged to audit history.',
                confirmText: 'Apply',
                cancelText: 'Cancel',
                type: 'warning',
                allowHtml: true
            });

            if (confirmed) {
                const submitBtn = document.getElementById('applyBtn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Applying...';
                this.submit();
            }
        });
    </script>
}

