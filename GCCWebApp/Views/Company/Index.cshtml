@{
    ViewData["Title"] = "Company Management";
    ViewData["BodyClass"] = "admin-company-management";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/admin/admin-inline-editing.css" rel="stylesheet" />
    <link href="~/css/company-management.css" rel="stylesheet" />
    <link href="~/css/admin-company-style.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <a href="@Url.Action("Index", "Admin")">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span>Companies & Products</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Companies</span>
    </span>
}

<div class="admin-container">
    @Html.AntiForgeryToken()
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage company information and contacts</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="template-btn" class="admin-btn admin-btn--secondary" title="Download CSV template for bulk import" aria-label="Download CSV template for bulk company import">
                        <i class="fas fa-file-download" aria-hidden="true"></i> Template
                    </button>
                    <button id="import-btn" class="admin-btn admin-btn--secondary" aria-label="Import companies from CSV file">
                        <i class="fas fa-download" aria-hidden="true"></i> Import
                    </button>
                    <button id="export-btn" class="admin-btn admin-btn--secondary" aria-label="Export companies to CSV file">
                        <i class="fas fa-upload" aria-hidden="true"></i> Export
                    </button>
                    <button id="add-company-btn" class="admin-btn admin-btn--primary" aria-label="Add a new company">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add New Company
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Unified toolbar + content wrapper (US-016 Hybrid Layout) -->
    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <label for="search-input" class="admin-sr-only">Search companies</label>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search" aria-label="Search companies">
                    <i class="fas fa-search admin-search-icon"></i>
                </div>
            </div>
        </div>

        <div class="admin-content">
            <div class="admin-table-container">
                <table id="company-table" class="admin-table">
                    <thead class="admin-table-header">
                        <tr>
                            <th class="admin-table-th admin-table-th--sortable" data-sort="name" style="width: 30%;">Company Name <span class="sort-icon">▼</span></th>
                            <th class="admin-table-th admin-table-th--sortable" data-sort="email" style="width: 30%;">Email <span class="sort-icon">▼</span></th>
                            <th class="admin-table-th admin-table-th--sortable" data-sort="url" style="width: auto;">URL <span class="sort-icon">▼</span></th>
                            <th class="admin-table-th admin-table-th--actions" style="width: 120px; min-width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="admin-table-body">
                        <!-- Data will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <div class="admin-footer-info">
            <span id="company-count" class="admin-count-display">Showing 0 of 0 companies</span>
        </div>
    </div> <!-- End admin-body-content -->
</div>

<!-- Import Preview Modal (US-015 Backdrop Standard) -->
<div id="import-preview-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9997;">
    <!-- Backdrop (sibling) -->
    <div class="import-modal-backdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container (sibling) -->
    <div class="import-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; width: 95%; max-width: 900px; max-height: 90vh; background-color: white; border-radius: 8px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column; opacity: 1;">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 8px 8px 0 0;">
            <h3 class="admin-modal-title" style="color: #002B76; font-weight: 600; margin: 0; font-size: 18px;">
                <i class="fas fa-download" style="margin-right: 8px;"></i> Import Preview - Companies
            </h3>
            <button class="admin-modal-close" onclick="closeImportPreviewModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #666; padding: 4px 8px;">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="admin-modal-body" style="background-color: white; padding: 20px; overflow-y: auto; flex: 1;">
            <p id="import-filename" style="margin-bottom: 15px; color: #666;"></p>

            <!-- Summary Stats -->
            <div id="import-summary" class="import-summary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 20px;">
                <div class="import-stat" style="background: #e8f5e1; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="stat-new" style="font-size: 24px; font-weight: 600; color: #447638;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">New</div>
                </div>
                <div class="import-stat" style="background: #e6f7ff; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="stat-modified" style="font-size: 24px; font-weight: 600; color: #002B76;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Modified</div>
                </div>
                <div class="import-stat" style="background: #f5f5f5; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="stat-unchanged" style="font-size: 24px; font-weight: 600; color: #999;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Unchanged</div>
                </div>
                <div class="import-stat" style="background: #ffebee; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="stat-errors" style="font-size: 24px; font-weight: 600; color: #ff5252;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Errors</div>
                </div>
            </div>

            <!-- Preview Table -->
            <div class="import-preview-table-container" style="border: 1px solid #e9ecef; border-radius: 6px; overflow: hidden; overflow-x: auto;">
                <table class="import-preview-table" style="width: 100%; border-collapse: collapse; font-size: 14px; min-width: 800px;">
                    <thead>
                        <tr style="background: #f8f9fa;">
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 40px;">
                                <input type="checkbox" id="select-all-import" checked onchange="toggleAllImportRows(this.checked)">
                            </th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 100px;">Status</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Name</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Email</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Website</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="import-preview-body">
                        <!-- Rows populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Legend -->
            <div class="import-legend" style="margin-top: 16px; display: flex; gap: 20px; flex-wrap: wrap; font-size: 12px; color: #666;">
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #92C83E; border-radius: 2px; margin-right: 4px;"></span> New - Will be created</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #002B76; border-radius: 2px; margin-right: 4px;"></span> Modified - Will be updated</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #999; border-radius: 2px; margin-right: 4px;"></span> Unchanged - No action needed</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #ff5252; border-radius: 2px; margin-right: 4px;"></span> Error - Has validation errors</span>
            </div>

            <p id="import-selected-count" style="margin-top: 15px; color: #666; font-style: italic;"></p>
        </div>

        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 0 0 8px 8px;">
            <div class="import-selected-count" style="font-size: 14px; color: #666;">
                <span id="selected-count">0</span> of <span id="total-count">0</span> rows selected
            </div>
            <div class="admin-modal-actions" style="display: flex; gap: 12px;">
                <button type="button" class="admin-btn admin-btn--secondary" onclick="closeImportPreviewModal()">
                    Cancel
                </button>
                <button type="button" id="apply-import-btn" class="admin-btn admin-btn--primary" onclick="applySelectedImport()">
                    <i class="fas fa-check"></i> Apply Import
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Companies array - will be loaded from database
        let companies = [];

        // DOM Elements
        const companyTable = document.getElementById('company-table');
        const companyTableBody = companyTable.querySelector('tbody');
        const companyCountElement = document.getElementById('company-count');
        const searchInput = document.getElementById('search-input');
        const importBtn = document.getElementById('import-btn');
        const exportBtn = document.getElementById('export-btn');
        const addCompanyBtn = document.getElementById('add-company-btn');

        // Sorting variables
        let sortColumn = 'name';
        let sortDirection = 'asc';
        let currentEditingId = null;

        // Function to sort data
        function sortData() {
            // Filter data based on search input
            const searchTerm = searchInput.value.toLowerCase();
            const filteredCompanies = companies.filter(company =>
                company.name.toLowerCase().includes(searchTerm) ||
                company.email.toLowerCase().includes(searchTerm) ||
                company.url.toLowerCase().includes(searchTerm)
            );

            // Sort the filtered data
            filteredCompanies.sort((a, b) => {
                const aValue = a[sortColumn] || '';
                const bValue = b[sortColumn] || '';

                if (sortDirection === 'asc') {
                    return aValue.localeCompare(bValue);
                } else {
                    return bValue.localeCompare(aValue);
                }
            });

            populateTable(filteredCompanies);
        }

        // Function to populate the table with inline editing
        function populateTable(data) {
            companyTableBody.innerHTML = '';
            let visibleCount = 0;

            // Add new company row (initially hidden)
            const addRow = document.createElement('tr');
            addRow.className = 'company-add-row';
            addRow.id = 'company-add-row';

            const nameCell = document.createElement('td');
            nameCell.innerHTML = `<input type="text" class="company-edit-input" id="new-company-name" placeholder="Enter company name">`;

            const emailCell = document.createElement('td');
            emailCell.innerHTML = `<input type="email" class="company-edit-input" id="new-company-email" placeholder="Enter email">`;

            const urlCell = document.createElement('td');
            urlCell.innerHTML = `<input type="text" class="company-edit-input" id="new-company-url" placeholder="Enter URL">`;

            const actionsCell = document.createElement('td');
            actionsCell.className = 'company-edit-actions';
            actionsCell.innerHTML = `
                <button class="company-btn-save" onclick="saveNewCompany()" title="Save">
                    <i class="fas fa-check"></i>
                </button>
                <button class="company-btn-cancel" onclick="cancelAddCompany()" title="Cancel">
                    <i class="fas fa-times"></i>
                </button>
            `;

            addRow.appendChild(nameCell);
            addRow.appendChild(emailCell);
            addRow.appendChild(urlCell);
            addRow.appendChild(actionsCell);
            companyTableBody.appendChild(addRow);

            // Add existing companies
            data.forEach(company => {
                const row = document.createElement('tr');
                row.setAttribute('data-id', company.id);

                // Company Name cell
                const nameCell = document.createElement('td');

                // View mode
                const nameSpan = document.createElement('span');
                nameSpan.className = 'company-name';
                nameSpan.textContent = company.name;
                nameCell.appendChild(nameSpan);

                // Edit mode
                const nameEditDiv = document.createElement('div');
                nameEditDiv.className = 'company-name-edit';
                nameEditDiv.innerHTML = `<input type="text" class="company-edit-input" value="${company.name}">`;
                nameCell.appendChild(nameEditDiv);

                row.appendChild(nameCell);

                // Email cell
                const emailCell = document.createElement('td');

                // View mode
                const emailSpan = document.createElement('span');
                emailSpan.className = 'company-email';
                emailSpan.textContent = company.email || '';
                emailCell.appendChild(emailSpan);

                // Edit mode
                const emailEditDiv = document.createElement('div');
                emailEditDiv.className = 'company-email-edit';
                emailEditDiv.innerHTML = `<input type="email" class="company-edit-input" value="${company.email || ''}">`;
                emailCell.appendChild(emailEditDiv);

                row.appendChild(emailCell);

                // URL cell
                const urlCell = document.createElement('td');

                // View mode
                const urlSpan = document.createElement('span');
                urlSpan.className = 'company-url';
                if (company.url) {
                    urlSpan.innerHTML = `<a href="${company.url}" target="_blank" class="url-link">${company.url}</a>`;
                }
                urlCell.appendChild(urlSpan);

                // Edit mode
                const urlEditDiv = document.createElement('div');
                urlEditDiv.className = 'company-url-edit';
                urlEditDiv.innerHTML = `<input type="text" class="company-edit-input" value="${company.url || ''}">`;
                urlCell.appendChild(urlEditDiv);

                row.appendChild(urlCell);

                // Actions cell
                const actionsCell = document.createElement('td');
                actionsCell.className = 'actions-cell';

                // Regular action buttons
                const actionButtons = document.createElement('div');
                actionButtons.className = 'action-buttons';
                actionButtons.innerHTML = `
                    <button class="btn-edit" onclick="editCompany(${company.id})" title="Edit Company">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn-delete" onclick="deleteCompany(${company.id})" title="Delete Company">
                        <i class="fas fa-trash"></i>
                    </button>
                `;
                actionsCell.appendChild(actionButtons);

                // Edit action buttons
                const editActions = document.createElement('div');
                editActions.className = 'company-edit-actions';
                editActions.innerHTML = `
                    <button class="company-btn-save" onclick="saveCompany(${company.id})" title="Save">
                        <i class="fas fa-check"></i>
                    </button>
                    <button class="company-btn-cancel" onclick="cancelEdit(${company.id})" title="Cancel">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                actionsCell.appendChild(editActions);

                row.appendChild(actionsCell);
                companyTableBody.appendChild(row);
                visibleCount++;
            });

            // Update the company count
            companyCountElement.textContent = `Showing ${visibleCount} of ${companies.length} companies`;
        }

        // Show add new company row
        function showAddRow() {
            // Cancel any active edits
            if (currentEditingId) {
                cancelEdit(currentEditingId);
            }

            const addRow = document.getElementById('company-add-row');
            if (addRow) {
                addRow.classList.add('active');
                const nameInput = document.getElementById('new-company-name');
                if (nameInput) {
                    nameInput.focus();
                }
            }
        }

        // Save new company
        async function saveNewCompany() {
            const nameInput = document.getElementById('new-company-name');
            const emailInput = document.getElementById('new-company-email');
            const urlInput = document.getElementById('new-company-url');

            const name = nameInput ? nameInput.value.trim() : '';
            const email = emailInput ? emailInput.value.trim() : '';
            let url = urlInput ? urlInput.value.trim() : '';

            // Basic validation
            if (!name) {
                AdminCore.showNotification('Company name cannot be empty', 'error');
                if (nameInput) nameInput.focus();
                return;
            }

            // Add protocol to URL if missing
            if (url && !url.match(/^https?:\/\//)) {
                url = 'https://' + url;
            }

            try {
                // Get anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                // Save to database
                const response = await fetch('/Company/SaveCompany', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({
                        id: 0,
                        name: name,
                        email: email,
                        url: url
                    })
                });

                const result = await response.json();

                if (result.success && result.data) {
                    // Add the new company with the ID from database
                    companies.push({
                        id: result.data.id,
                        name: result.data.name,
                        email: result.data.email,
                        url: result.data.url
                    });

                    // Reset add row
                    if (nameInput) nameInput.value = '';
                    if (emailInput) emailInput.value = '';
                    if (urlInput) urlInput.value = '';
                    const addRow = document.getElementById('company-add-row');
                    if (addRow) addRow.classList.remove('active');

                    // Refresh table
                    sortData();
                    await AdminCore.showSuccessModal({
                        title: 'Company Added',
                        message: 'The company has been added successfully.',
                        buttonText: 'OK'
                    });
                } else {
                    // Show validation errors if available
                    let errorMsg = result.message || 'Failed to save company';
                    if (result.errors && result.errors.length > 0) {
                        errorMsg = result.errors.join(', ');
                    }
                    console.error('Save error:', result);
                    AdminCore.showNotification('Error: ' + errorMsg, 'error');
                }
            } catch (error) {
                console.error('Error saving company:', error);
                AdminCore.showNotification('Error saving company: ' + error.message, 'error');
            }
        }

        // Cancel adding new company
        function cancelAddCompany() {
            const nameInput = document.getElementById('new-company-name');
            const emailInput = document.getElementById('new-company-email');
            const urlInput = document.getElementById('new-company-url');

            if (nameInput) nameInput.value = '';
            if (emailInput) emailInput.value = '';
            if (urlInput) urlInput.value = '';

            const addRow = document.getElementById('company-add-row');
            if (addRow) addRow.classList.remove('active');
        }

        // Edit company
        function editCompany(id) {
            // Cancel any other active edits
            if (currentEditingId && currentEditingId !== id) {
                cancelEdit(currentEditingId);
            }

            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (!row) return;

            currentEditingId = id;
            row.classList.add('company-edit-row');
            
            const nameInput = row.querySelector('.company-name-edit .company-edit-input');
            if (nameInput) {
                nameInput.focus();
                nameInput.select();
            }
        }

        // Save company
        async function saveCompany(id) {
            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (!row) return;

            const nameInput = row.querySelector('.company-name-edit .company-edit-input');
            const emailInput = row.querySelector('.company-email-edit .company-edit-input');
            const urlInput = row.querySelector('.company-url-edit .company-edit-input');

            const newName = nameInput ? nameInput.value.trim() : '';
            const newEmail = emailInput ? emailInput.value.trim() : '';
            let newUrl = urlInput ? urlInput.value.trim() : '';

            if (!newName) {
                AdminCore.showNotification('Company name cannot be empty', 'error');
                if (nameInput) nameInput.focus();
                return;
            }

            // Add protocol to URL if missing
            if (newUrl && !newUrl.match(/^https?:\/\//)) {
                newUrl = 'https://' + newUrl;
            }

            try {
                // Get anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                // Update in database
                const response = await fetch('/Company/SaveCompany', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({
                        id: id,
                        name: newName,
                        email: newEmail,
                        url: newUrl
                    })
                });

                const result = await response.json();

                if (result.success) {
                    // Update local data
                    const companyIndex = companies.findIndex(c => c.id === id);
                    if (companyIndex !== -1) {
                        companies[companyIndex].name = newName;
                        companies[companyIndex].email = newEmail;
                        companies[companyIndex].url = newUrl;
                    }

                    // Update display
                    const nameSpan = row.querySelector('.company-name');
                    const emailSpan = row.querySelector('.company-email');
                    const urlSpan = row.querySelector('.company-url');

                    if (nameSpan) nameSpan.textContent = newName;
                    if (emailSpan) emailSpan.textContent = newEmail;
                    if (urlSpan) {
                        if (newUrl) {
                            urlSpan.innerHTML = `<a href="${newUrl}" target="_blank" class="url-link">${newUrl}</a>`;
                        } else {
                            urlSpan.innerHTML = '';
                        }
                    }

                    // Remove edit class
                    row.classList.remove('company-edit-row');
                    currentEditingId = null;
                    await AdminCore.showSuccessModal({
                        title: 'Update Successful',
                        message: 'The company has been updated successfully.',
                        buttonText: 'OK'
                    });
                } else {
                    // Show validation errors if available
                    let errorMsg = result.message || 'Failed to update company';
                    if (result.errors && result.errors.length > 0) {
                        errorMsg = result.errors.join(', ');
                    }
                    console.error('Save error:', result);
                    AdminCore.showNotification('Error: ' + errorMsg, 'error');
                }
            } catch (error) {
                console.error('Error updating company:', error);
                AdminCore.showNotification('Error updating company: ' + error.message, 'error');
            }
        }

        // Cancel edit
        function cancelEdit(id) {
            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (!row) return;

            // Get original data
            const company = companies.find(c => c.id === id);
            if (!company) return;

            // Reset input values to original
            const nameInput = row.querySelector('.company-name-edit .company-edit-input');
            const emailInput = row.querySelector('.company-email-edit .company-edit-input');
            const urlInput = row.querySelector('.company-url-edit .company-edit-input');

            if (nameInput) nameInput.value = company.name;
            if (emailInput) emailInput.value = company.email || '';
            if (urlInput) urlInput.value = company.url || '';

            // Remove edit class
            row.classList.remove('company-edit-row');
            currentEditingId = null;
        }

        // Delete company
        async function deleteCompany(id) {
            const company = companies.find(c => c.id === id);
            const confirmed = await AdminCore.showConfirmation({
                title: 'Delete Confirmation',
                message: `Are you sure you want to delete <strong>${company?.name}</strong>? This action cannot be undone.`,
                confirmText: 'Delete',
                cancelText: 'Cancel',
                type: 'danger',
                allowHtml: true
            });

            if (!confirmed) return;

            try {
                // Delete from database
                const response = await fetch(`/Company/DeleteCompany?id=${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const result = await response.json();

                if (result.success) {
                    // Remove from local array only if database delete succeeded
                    companies = companies.filter(company => company.id !== id);
                    sortData();
                    await AdminCore.showSuccessModal({
                        title: 'Delete Successful',
                        message: 'The company has been deleted successfully.',
                        buttonText: 'OK'
                    });
                } else {
                    AdminCore.showNotification('Error: ' + (result.message || 'Failed to delete company'), 'error');
                }
            } catch (error) {
                console.error('Error deleting company:', error);
                AdminCore.showNotification('Error deleting company: ' + error.message, 'error');
            }
        }

        // Initialize sortable headers
        function initializeSortableHeaders() {
            const headers = companyTable.querySelectorAll('th[data-sort]');

            headers.forEach(header => {
                header.addEventListener('click', () => {
                    const column = header.getAttribute('data-sort');

                    // Toggle sort direction if clicking the same column
                    if (sortColumn === column) {
                        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortColumn = column;
                        sortDirection = 'asc';
                    }

                    // Update visual indicators
                    headers.forEach(h => h.classList.remove('active-sort'));
                    header.classList.add('active-sort');

                    const sortIcon = header.querySelector('.sort-icon');
                    sortIcon.textContent = sortDirection === 'asc' ? '▲' : '▼';

                    sortData();
                });
            });
        }

        // Download import template
        function downloadImportTemplate() {
            try {
                // Headers only - no sample data to avoid accidental import
                const headers = ['Name', 'Email', 'Website'];
                const csvContent = headers.join(',');

                // Download file
                const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                const url = URL.createObjectURL(blob);
                link.setAttribute('href', url);
                link.setAttribute('download', `companies_import_template_${new Date().toISOString().split('T')[0]}.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                AdminCore.showNotification('Import template downloaded successfully', 'success');
            } catch (error) {
                console.error('Error downloading template:', error);
                AdminCore.showNotification('Error downloading template. Please try again.', 'error');
            }
        }

        // Import Preview Data
        let importPreviewData = [];
        let importFileName = '';

        // Import CSV - Show file picker and parse
        function importCSV() {
            try {
                const fileInput = document.createElement('input');
                fileInput.type = 'file';
                fileInput.accept = '.csv';

                fileInput.addEventListener('change', (event) => {
                    const file = event.target.files[0];
                    if (!file) return;

                    importFileName = file.name;
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            parseAndPreviewImport(e.target.result);
                        } catch (parseError) {
                            console.error('Error parsing CSV:', parseError);
                            AdminCore.showNotification('Error parsing CSV: ' + parseError.message, 'error');
                        }
                    };
                    reader.onerror = (e) => {
                        console.error('Error reading file:', e);
                        AdminCore.showNotification('Error reading file', 'error');
                    };
                    reader.readAsText(file);
                });

                fileInput.click();
            } catch (error) {
                console.error('Error in importCSV:', error);
                AdminCore.showNotification('Error starting import: ' + error.message, 'error');
            }
        }

        // Parse CSV and build preview
        function parseAndPreviewImport(contents) {
            const lines = contents.split('\n');
            if (lines.length < 2) {
                AdminCore.showNotification('CSV file is empty or has no data rows', 'warning');
                return;
            }

            // Parse header row
            const headerLine = lines[0].trim();
            const headers = parseCSVLine(headerLine).map(h => h.toLowerCase().trim());

            // Find column indexes - support both 'url' and 'website'
            const nameIdx = headers.findIndex(h => h === 'name');
            const emailIdx = headers.findIndex(h => h === 'email');
            const urlIdx = headers.findIndex(h => h === 'url' || h === 'website');

            if (nameIdx === -1) {
                AdminCore.showNotification('CSV must have a "Name" column', 'error');
                return;
            }

            // Parse data rows
            const parsedCompanies = [];
            for (let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if (!line) continue;

                const fields = parseCSVLine(line);
                const name = fields[nameIdx]?.trim() || '';
                const email = emailIdx !== -1 ? (fields[emailIdx]?.trim() || '') : '';
                let url = urlIdx !== -1 ? (fields[urlIdx]?.trim() || '') : '';

                // Add protocol to URL if missing
                if (url && !url.match(/^https?:\/\//)) {
                    url = 'https://' + url;
                }

                if (name) {
                    parsedCompanies.push({ name, email, url });
                }
            }

            if (parsedCompanies.length === 0) {
                AdminCore.showNotification('No valid companies found in CSV', 'warning');
                return;
            }

            buildImportPreview(parsedCompanies);
        }

        // Build import preview data with comparison
        function buildImportPreview(parsedCompanies) {
            importPreviewData = [];

            for (const imported of parsedCompanies) {
                // Find existing company by name (case-insensitive)
                const existing = companies.find(c =>
                    c.name.trim().toLowerCase() === imported.name.trim().toLowerCase()
                );

                const row = {
                    importData: imported,
                    existingData: existing || null,
                    status: 'new',
                    changes: [],
                    errors: [],
                    action: 'create',
                    selected: true
                };

                // Validate required fields
                if (!imported.name.trim()) {
                    row.errors.push('Name is required');
                }

                // Validate email format if provided
                if (imported.email && !imported.email.match(/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/)) {
                    row.errors.push('Invalid email format');
                }

                if (row.errors.length > 0) {
                    row.status = 'error';
                    row.action = 'skip';
                    row.selected = false;
                } else if (existing) {
                    // Compare fields for changes
                    if ((existing.email || '').toLowerCase() !== (imported.email || '').toLowerCase()) {
                        row.changes.push({ field: 'email', oldValue: existing.email || '', newValue: imported.email || '' });
                    }
                    if ((existing.url || '').toLowerCase() !== (imported.url || '').toLowerCase()) {
                        row.changes.push({ field: 'url', oldValue: existing.url || '', newValue: imported.url || '' });
                    }

                    if (row.changes.length > 0) {
                        row.status = 'modified';
                        row.action = 'update';
                    } else {
                        row.status = 'unchanged';
                        row.action = 'skip';
                        row.selected = false;
                    }
                }

                importPreviewData.push(row);
            }

            showImportPreviewModal();
        }

        // Show import preview modal
        function showImportPreviewModal() {
            try {
                console.log('showImportPreviewModal called, data count:', importPreviewData.length);

                // Update stats
                const newCount = importPreviewData.filter(r => r.status === 'new').length;
                const modifiedCount = importPreviewData.filter(r => r.status === 'modified').length;
                const unchangedCount = importPreviewData.filter(r => r.status === 'unchanged').length;
                const errorCount = importPreviewData.filter(r => r.status === 'error').length;

                console.log('Stats:', { newCount, modifiedCount, unchangedCount, errorCount });

                const statNew = document.getElementById('stat-new');
                const statModified = document.getElementById('stat-modified');
                const statUnchanged = document.getElementById('stat-unchanged');
                const statErrors = document.getElementById('stat-errors');

                if (!statNew || !statModified || !statUnchanged || !statErrors) {
                    console.error('Missing stat elements:', { statNew, statModified, statUnchanged, statErrors });
                    AdminCore.showNotification('Modal elements not found - please refresh the page', 'error');
                    return;
                }

                statNew.textContent = newCount;
                statModified.textContent = modifiedCount;
                statUnchanged.textContent = unchangedCount;
                statErrors.textContent = errorCount;

                document.getElementById('import-filename').textContent = `File: ${importFileName}`;

            // Build table rows
            const tbody = document.getElementById('import-preview-body');
            tbody.innerHTML = '';

            importPreviewData.forEach((row, index) => {
                const tr = document.createElement('tr');

                // Status colors
                let statusBg = '#d4edda'; // new - green
                let statusColor = '#155724';
                if (row.status === 'modified') { statusBg = '#cce5ff'; statusColor = '#004085'; }
                else if (row.status === 'unchanged') { statusBg = '#e2e3e5'; statusColor = '#383d41'; }
                else if (row.status === 'error') { statusBg = '#f8d7da'; statusColor = '#721c24'; }

                // Checkbox
                const checkboxDisabled = row.status === 'error' || row.status === 'unchanged';
                const checkedAttr = row.selected ? 'checked' : '';
                const disabledAttr = checkboxDisabled ? 'disabled' : '';
                const statusLabel = row.status.charAt(0).toUpperCase() + row.status.slice(1);
                const changesHtml = row.changes.length > 0
                    ? '<div style="font-size: 11px; color: #666; margin-top: 4px;">Changes: ' + row.changes.map(function(c) { return c.field === 'url' ? 'Website' : c.field.charAt(0).toUpperCase() + c.field.slice(1); }).join(', ') + '</div>'
                    : '';
                const errorsHtml = row.errors.length > 0
                    ? '<div style="font-size: 11px; color: #dc3545; margin-top: 4px;">' + row.errors.join(', ') + '</div>'
                    : '';

                tr.innerHTML =
                    '<td style="padding: 8px; border: 1px solid #dee2e6; text-align: center; vertical-align: top;">' +
                        '<input type="checkbox" ' + checkedAttr + ' ' + disabledAttr + ' onchange="updateImportRowSelection(' + index + ', this.checked)">' +
                    '</td>' +
                    '<td style="padding: 8px; border: 1px solid #dee2e6; vertical-align: top;">' +
                        '<span style="background: ' + statusBg + '; color: ' + statusColor + '; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 500;">' +
                            statusLabel +
                        '</span>' +
                        changesHtml +
                        errorsHtml +
                    '</td>' +
                    '<td style="padding: 8px; border: 1px solid #dee2e6; vertical-align: top;">' + renderFieldWithDiff(row, 'name') + '</td>' +
                    '<td style="padding: 8px; border: 1px solid #dee2e6; vertical-align: top;">' + renderFieldWithDiff(row, 'email') + '</td>' +
                    '<td style="padding: 8px; border: 1px solid #dee2e6; vertical-align: top;">' + renderFieldWithDiff(row, 'url') + '</td>' +
                    '<td style="padding: 8px; border: 1px solid #dee2e6; vertical-align: top;">' + renderActionDropdown(row, index) + '</td>';

                // Apply visual feedback based on action
                if (row.action === 'skip') {
                    tr.style.backgroundColor = '#f5f5f5';
                    tr.style.opacity = '0.7';
                } else if (row.action === 'keep') {
                    tr.style.backgroundColor = '#fafafa';
                    tr.style.opacity = '0.9';
                }

                tbody.appendChild(tr);
            });

            updateSelectedCount();

            // Show modal (use setProperty with important to override any CSS)
            const modal = document.getElementById('import-preview-modal');
            console.log('Modal element:', modal);
            if (modal) {
                modal.style.setProperty('display', 'block', 'important');
                console.log('Modal display set to block with important');
            } else {
                console.error('Import preview modal not found!');
                AdminCore.showNotification('Import preview modal not found', 'error');
            }
            } catch (error) {
                console.error('Error in showImportPreviewModal:', error);
                AdminCore.showNotification('Error showing import preview: ' + error.message, 'error');
            }
        }

        // Render field with diff display
        function renderFieldWithDiff(row, field) {
            const importValue = row.importData[field] || '';
            const existingValue = row.existingData ? (row.existingData[field] || '') : '';

            // For new records or unchanged fields, just show import value
            if (row.status === 'new' || row.status === 'error') {
                return '<span style="word-break: break-word;">' + importValue + '</span>';
            }

            // Check if this specific field changed
            const fieldChanged = row.changes.some(function(c) { return c.field.toLowerCase() === field.toLowerCase(); });

            if (!fieldChanged) {
                return '<span style="word-break: break-word;">' + (importValue || existingValue) + '</span>';
            }

            // Show diff - vertical layout
            const currentDisplay = existingValue || '<em style="color: #999;">empty</em>';
            const importDisplay = importValue || '<em style="color: #999;">empty</em>';
            return '<div style="display: flex; flex-direction: column; gap: 4px; min-width: 120px;">' +
                '<div style="padding: 4px 8px; background: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; font-size: 12px; word-break: break-word;">' +
                    '<strong>Current:</strong> ' + currentDisplay +
                '</div>' +
                '<div style="padding: 4px 8px; background: #d4edda; border: 1px solid #28a745; border-radius: 4px; font-size: 12px; word-break: break-word;">' +
                    '<strong>Import:</strong> ' + importDisplay +
                '</div>' +
            '</div>';
        }

        // Render action dropdown
        function renderActionDropdown(row, index) {
            if (row.status === 'error') {
                return '<span style="color: #dc3545; font-size: 12px;">Cannot import</span>';
            }

            if (row.status === 'unchanged') {
                return '<span style="color: #6c757d; font-size: 12px;">No changes</span>';
            }

            if (row.status === 'new') {
                const createSelected = row.action === 'create' ? 'selected' : '';
                const skipSelected1 = row.action === 'skip' ? 'selected' : '';
                return '<select onchange="updateImportRowAction(' + index + ', this.value)" style="padding: 4px 8px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px;">' +
                    '<option value="create" ' + createSelected + '>Create New</option>' +
                    '<option value="skip" ' + skipSelected1 + '>Skip</option>' +
                    '</select>';
            }

            // Modified
            const updateSelected = row.action === 'update' ? 'selected' : '';
            const keepSelected = row.action === 'keep' ? 'selected' : '';
            const skipSelected2 = row.action === 'skip' ? 'selected' : '';
            return '<select onchange="updateImportRowAction(' + index + ', this.value)" style="padding: 4px 8px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px;">' +
                '<option value="update" ' + updateSelected + '>Apply Import</option>' +
                '<option value="keep" ' + keepSelected + '>Keep Current</option>' +
                '<option value="skip" ' + skipSelected2 + '>Skip</option>' +
                '</select>';
        }

        // Update row selection
        function updateImportRowSelection(index, selected) {
            importPreviewData[index].selected = selected;
            if (selected) {
                importPreviewData[index].action = importPreviewData[index].status === 'new' ? 'create' : 'update';
            } else {
                importPreviewData[index].action = 'skip';
            }
            // Re-render row to update visual feedback
            showImportPreviewModal();
        }

        // Update row action
        function updateImportRowAction(index, action) {
            importPreviewData[index].action = action;
            importPreviewData[index].selected = action !== 'skip' && action !== 'keep';

            // Update visual feedback
            const rows = document.querySelectorAll('#import-preview-body tr');
            if (rows[index]) {
                if (action === 'skip') {
                    rows[index].style.backgroundColor = '#f5f5f5';
                    rows[index].style.opacity = '0.7';
                } else if (action === 'keep') {
                    rows[index].style.backgroundColor = '#fafafa';
                    rows[index].style.opacity = '0.9';
                } else {
                    rows[index].style.backgroundColor = '';
                    rows[index].style.opacity = '1';
                }

                // Update checkbox
                const checkbox = rows[index].querySelector('input[type="checkbox"]');
                if (checkbox && !checkbox.disabled) {
                    checkbox.checked = action !== 'skip' && action !== 'keep';
                }
            }

            updateSelectedCount();
        }

        // Toggle all import rows
        function toggleAllImportRows(checked) {
            importPreviewData.forEach((row, index) => {
                if (row.status !== 'error' && row.status !== 'unchanged') {
                    row.selected = checked;
                    row.action = checked ? (row.status === 'new' ? 'create' : 'update') : 'skip';
                }
            });
            showImportPreviewModal();
        }

        // Update selected count display
        function updateSelectedCount() {
            const toImport = importPreviewData.filter(r => r.action === 'create' || r.action === 'update').length;
            const keepCurrent = importPreviewData.filter(r => r.action === 'keep').length;
            const total = importPreviewData.filter(r => r.status !== 'error' && r.status !== 'unchanged').length;

            let msg = `${toImport} of ${total} rows will be imported`;
            if (keepCurrent > 0) {
                msg += ` (${keepCurrent} keeping current)`;
            }

            document.getElementById('import-selected-count').textContent = msg;
        }

        // Close import preview modal
        function closeImportPreviewModal() {
            const modal = document.getElementById('import-preview-modal');
            if (modal) {
                modal.style.display = 'none';
            }
            importPreviewData = [];
            importFileName = '';
        }

        // Apply selected imports
        async function applySelectedImport() {
            const toProcess = importPreviewData.filter(r => r.action === 'create' || r.action === 'update');

            if (toProcess.length === 0) {
                AdminCore.showNotification('No rows selected for import', 'warning');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            let successCount = 0;
            let errorCount = 0;
            const errors = [];

            for (const row of toProcess) {
                try {
                    const response = await fetch('/Company/SaveCompany', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token || ''
                        },
                        body: JSON.stringify({
                            id: row.action === 'update' && row.existingData ? row.existingData.id : 0,
                            name: row.importData.name,
                            email: row.importData.email,
                            url: row.importData.url
                        })
                    });

                    // Check if response is JSON
                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        const text = await response.text();
                        console.error('Non-JSON response:', text.substring(0, 200));
                        throw new Error('Server returned non-JSON response (status: ' + response.status + ')');
                    }

                    const result = await response.json();

                    if (result.success) {
                        successCount++;
                    } else {
                        errorCount++;
                        errors.push(row.importData.name + ': ' + (result.message || 'Unknown error'));
                    }
                } catch (error) {
                    errorCount++;
                    errors.push(`${row.importData.name}: ${error.message}`);
                }
            }

            closeImportPreviewModal();
            await loadCompanies();

            if (errorCount === 0) {
                AdminCore.showNotification(`Imported ${successCount} companies successfully`, 'success');
            } else if (successCount > 0) {
                AdminCore.showNotification(`Imported ${successCount} companies. ${errorCount} failed.`, 'warning');
                console.error('Import errors:', errors);
            } else {
                AdminCore.showNotification(`Import failed. ${errorCount} errors occurred.`, 'error');
                console.error('Import errors:', errors);
            }
        }

        // Parse CSV line handling quoted fields
        function parseCSVLine(line) {
            const result = [];
            let current = '';
            let inQuotes = false;

            for (let i = 0; i < line.length; i++) {
                const char = line[i];

                if (char === '"') {
                    if (inQuotes && line[i + 1] === '"') {
                        current += '"';
                        i++;
                    } else {
                        inQuotes = !inQuotes;
                    }
                } else if (char === ',' && !inQuotes) {
                    result.push(current);
                    current = '';
                } else {
                    current += char;
                }
            }
            result.push(current);
            return result;
        }

        // Export to CSV
        function exportCSV() {
            const headers = ['Company Name', 'Email', 'URL'];
            const rows = companies.map(company => [
                company.name,
                company.email,
                company.url
            ]);

            const csvContent = [
                headers.join(','),
                ...rows.map(row => row.join(','))
            ].join('\n');

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.setAttribute('href', url);
            link.setAttribute('download', 'company_data.csv');
            link.style.visibility = 'hidden';

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            AdminCore.showNotification('Companies exported successfully', 'success');
        }

        // Load companies from database
        async function loadCompanies() {
            try {
                const response = await fetch('/Company/GetCompanies');

                // Check if response is JSON
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    const text = await response.text();
                    console.error('Non-JSON response from GetCompanies:', text.substring(0, 200));
                    throw new Error('Server returned non-JSON response (status: ' + response.status + ')');
                }

                const result = await response.json();

                if (result.success && result.data) {
                    // Map server data to match client format
                    companies = result.data.map(c => ({
                        id: c.id,
                        name: c.name,
                        email: c.email,
                        url: c.url // Server returns 'url' property from CompanyViewModel
                    }));
                    console.log(`Loaded ${companies.length} companies from database`);
                    sortData();
                } else {
                    console.error('Failed to load companies:', result.message);
                    AdminCore.showNotification('Failed to load companies: ' + (result.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error loading companies:', error);
                AdminCore.showNotification('Error loading companies: ' + error.message, 'error');
            }
        }

        // Event Listeners
        const templateBtn = document.getElementById('template-btn');
        templateBtn.addEventListener('click', downloadImportTemplate);
        importBtn.addEventListener('click', importCSV);
        exportBtn.addEventListener('click', exportCSV);
        addCompanyBtn.addEventListener('click', showAddRow);

        searchInput.addEventListener('input', () => {
            sortData();
        });

        // Initialize - Load data from database
        initializeSortableHeaders();
        loadCompanies();
    </script>
}