@{
    ViewData["Title"] = "Company Management";
    ViewData["BodyClass"] = "company-management";
}

@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/company-management.css" rel="stylesheet" />
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage company records and contact information</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="import-btn" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-file-arrow-down"></i> Import
                    </button>
                    <button id="export-btn" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-file-arrow-up"></i> Export
                    </button>
                    <button id="add-company-btn" class="admin-btn admin-btn--primary">
                        <i class="fas fa-plus"></i> Add New Company
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-body-content">
        <div class="admin-toolbar">
            <div class="admin-search-section">
                <div class="admin-search-box">
                    <i class="fas fa-search admin-search-icon"></i>
                    <input type="text" id="search-input" class="admin-search-input" placeholder="Search">
                </div>
            </div>
        </div>

        <div class="admin-content">
            <table id="company-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th width="30%" data-sort="name" class="admin-table-th--sortable">Company Name <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th width="30%" data-sort="email" class="admin-table-th--sortable">Email <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th width="30%" data-sort="url" class="admin-table-th--sortable">URL <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th width="10%" class="actions-col">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>

        <div class="admin-footer-info">
            <span id="company-count" class="admin-count-display">Showing 0 of 0 companies</span>
        </div>
    </div>
</div>

<!-- Add/Edit Company Modal -->
<div id="company-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="modal-title">Add New Company</h3>
            <span class="modal-close">&times;</span>
        </div>
        <form id="company-form">
            <input type="hidden" id="company-id">

            <div class="form-group">
                <label for="company-name">Company Name</label>
                <input type="text" id="company-name" required>
            </div>

            <div class="form-group">
                <label for="company-email">Email</label>
                <input type="email" id="company-email" required>
            </div>

            <div class="form-group">
                <label for="company-url">Website URL</label>
                <input type="url" id="company-url" placeholder="https://example.com">
            </div>

            <div class="form-actions">
                <button type="button" class="btn" id="cancel-btn">Cancel</button>
                <button type="submit" class="btn btn-primary" id="save-btn">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Import Preview Modal (US-015 Backdrop Standard) -->
<div id="import-preview-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9997;">
    <!-- Backdrop -->
    <div class="import-modal-backdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container -->
    <div class="import-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; width: 95%; max-width: 900px; max-height: 90vh; background-color: white; border-radius: 8px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column;">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 8px 8px 0 0;">
            <h3 class="admin-modal-title" style="color: #002B76; font-weight: 600; margin: 0; font-size: 18px;">
                <i class="fas fa-upload" style="margin-right: 8px;"></i> Import Preview - <span id="import-filename"></span>
            </h3>
            <button class="admin-modal-close" onclick="companyManagement.closeImportPreviewModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #666; padding: 4px 8px;">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="admin-modal-body" style="background-color: white; padding: 20px; overflow-y: auto; flex: 1;">
            <!-- Summary Stats -->
            <div id="import-summary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 20px;">
                <div style="background: #e8f5e1; padding: 12px; border-radius: 6px; text-align: center;">
                    <div id="stat-new" style="font-size: 24px; font-weight: 600; color: #447638;">0</div>
                    <div style="font-size: 12px; color: #666;">New</div>
                </div>
                <div style="background: #e6f7ff; padding: 12px; border-radius: 6px; text-align: center;">
                    <div id="stat-modified" style="font-size: 24px; font-weight: 600; color: #002B76;">0</div>
                    <div style="font-size: 12px; color: #666;">Modified</div>
                </div>
                <div style="background: #f5f5f5; padding: 12px; border-radius: 6px; text-align: center;">
                    <div id="stat-unchanged" style="font-size: 24px; font-weight: 600; color: #999;">0</div>
                    <div style="font-size: 12px; color: #666;">Unchanged</div>
                </div>
                <div style="background: #ffebee; padding: 12px; border-radius: 6px; text-align: center;">
                    <div id="stat-errors" style="font-size: 24px; font-weight: 600; color: #ff5252;">0</div>
                    <div style="font-size: 12px; color: #666;">Errors</div>
                </div>
            </div>

            <!-- Preview Table -->
            <div style="border: 1px solid #e9ecef; border-radius: 6px; overflow: hidden; overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 14px; min-width: 700px;">
                    <thead>
                        <tr style="background: #f8f9fa;">
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 40px;">
                                <input type="checkbox" id="select-all-import" checked onchange="companyManagement.toggleAllImportRows(this.checked)">
                            </th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 50px;">Row</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 110px;">Import Status</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Company Name</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Email</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Website</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="import-preview-body">
                        <!-- Rows populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Legend -->
            <div style="margin-top: 16px; display: flex; gap: 20px; flex-wrap: wrap; font-size: 12px; color: #666;">
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #92C83E; border-radius: 2px; margin-right: 4px;"></span> New - Will be created</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #002B76; border-radius: 2px; margin-right: 4px;"></span> Modified - Will be updated</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #999; border-radius: 2px; margin-right: 4px;"></span> Unchanged - No action needed</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #ff5252; border-radius: 2px; margin-right: 4px;"></span> Error - Has validation errors</span>
            </div>
        </div>

        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 0 0 8px 8px;">
            <div id="import-selected-count" style="font-size: 14px; color: #666;">
                0 of 0 rows will be imported
            </div>
            <div style="display: flex; gap: 12px;">
                <button type="button" class="btn" onclick="companyManagement.closeImportPreviewModal()">
                    Cancel
                </button>
                <button type="button" id="apply-import-btn" class="btn btn-primary" onclick="companyManagement.applySelectedImport()">
                    <i class="fas fa-check"></i> Apply Import
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/companyManagement.js"></script>
}