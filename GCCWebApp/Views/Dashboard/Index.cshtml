@model GCCWebApp.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/pages/dashboard.css" rel="stylesheet" />
}

<!-- Dashboard Container -->
<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Overview of certificates, companies, and products</p>
            </div>
        </div>
    </header>
    <div class="admin-body-content">

<!-- Stats Grid -->
<div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="fas fa-certificate"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.ActiveCertificates.ToString("N0")</div>
                <div class="stat-title">Total Active Certs</div>
            </div>
            <button class="stat-download-icon" data-stat-type="total-active-certs" title="Download Data" aria-label="Download Total Active Certs data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">
                <i class="fas fa-building"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.TotalCompanies.ToString("N0")</div>
                <div class="stat-title"># Companies with Active Certs</div>
            </div>
            <button class="stat-download-icon" data-stat-type="companies-with-active-certs" title="Download Data" aria-label="Download Companies with Active Certs data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.TotalCertificationTypes.ToString("N0")</div>
                <div class="stat-title"># Product Categories with Active Certs</div>
            </div>
            <button class="stat-download-icon" data-stat-type="product-categories-with-active-certs" title="Download Data" aria-label="Download Product Categories data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon total">
                <i class="fas fa-tags"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.TotalProducts.ToString("N0")</div>
                <div class="stat-title"># Product Types with Active Certs</div>
            </div>
            <button class="stat-download-icon" data-stat-type="product-types-with-active-certs" title="Download Data" aria-label="Download Product Types data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon total">
                <i class="fas fa-sitemap"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("ProductSubcategories", 0).ToString("N0")</div>
                <div class="stat-title"># Product Type Subcategories with Active Certs</div>
            </div>
            <button class="stat-download-icon" data-stat-type="product-subcategories-with-active-certs" title="Download Data" aria-label="Download Product Subcategories data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">
                <i class="fas fa-box"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("ActiveProducts", 0).ToString("N0")</div>
                <div class="stat-title"># Products with Active Certs</div>
            </div>
            <button class="stat-download-icon" data-stat-type="products-with-active-certs" title="Download Data" aria-label="Download Products data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="fas fa-calendar-plus"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("PublishedLastMonth", 0).ToString("N0")</div>
                <div class="stat-title"># Certs Published Last Month</div>
            </div>
            <button class="stat-download-icon" data-stat-type="certs-published-last-month" title="Download Data" aria-label="Download Certs Published Last Month data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon expired">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("ExpiringThisMonth", 0).ToString("N0")</div>
                <div class="stat-title"># Certs Expiring This Month</div>
            </div>
            <button class="stat-download-icon" data-stat-type="certs-expiring-this-month" title="Download Data" aria-label="Download Certs Expiring This Month data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon expired">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("ExpiredLastMonth", 0).ToString("N0")</div>
                <div class="stat-title"># Certs Expired Last Month</div>
            </div>
            <button class="stat-download-icon" data-stat-type="certs-expired-last-month" title="Download Data" aria-label="Download Certs Expired Last Month data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon expired">
                <i class="fas fa-calendar-week"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("ExpiringNextMonth", 0).ToString("N0")</div>
                <div class="stat-title"># Certs Expiring Next Month</div>
            </div>
            <button class="stat-download-icon" data-stat-type="certs-expiring-next-month" title="Download Data" aria-label="Download Certs Expiring Next Month data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("PublishedThisYear", 0).ToString("N0")</div>
                <div class="stat-title"># Certs Published This Year</div>
            </div>
            <button class="stat-download-icon" data-stat-type="certs-published-this-year" title="Download Data" aria-label="Download Certs Published This Year data">
                <i class="fas fa-download"></i>
            </button>
        </div>

        <div class="stat-card">
            <div class="stat-icon total">
                <i class="fas fa-history"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@Model.Statistics.GetValueOrDefault("PublishedLastYear", 0).ToString("N0")</div>
                <div class="stat-title"># Certs Published Last Year</div>
            </div>
            <button class="stat-download-icon" data-stat-type="certs-published-last-year" title="Download Data" aria-label="Download Certs Published Last Year data">
                <i class="fas fa-download"></i>
            </button>
        </div>
    </div>

    <!-- Tables Container -->
    <div class="tables-container">
        <!-- Total Active Certs by Certification Type -->
        <div class="table-section">
            <div class="table-header">
                <div class="table-title">Total Active Certs by Certification Type</div>
                <button class="table-download-icon" data-table-type="cert-types" title="Download Table Data" aria-label="Download certification types table">
                    <i class="fas fa-download"></i>
                </button>
            </div>
            <table>
                <caption class="admin-sr-only">Total Active Certificates by Certification Type</caption>
                <thead>
                    <tr>
                        <th>Certification Type</th>
                        <th>Total Active Certs</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CertificationTypeBreakdown.Any())
                    {
                        @foreach (var certType in Model.CertificationTypeBreakdown)
                        {
                            <tr>
                                <td>@certType.Name</td>
                                <td>@certType.Count.ToString("N0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="2" style="text-align: center; font-style: italic;">No certification type data available</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Top 10 Companies by Active Cert Count -->
        <div class="table-section">
            <div class="table-header">
                <div class="table-title">Top 10 Companies by Active Cert Count</div>
                <button class="table-download-icon" data-table-type="top-companies" title="Download Table Data" aria-label="Download top companies table">
                    <i class="fas fa-download"></i>
                </button>
            </div>
            <table>
                <caption class="admin-sr-only">Top 10 Companies by Active Certificate Count</caption>
                <thead>
                    <tr>
                        <th>Company</th>
                        <th># of Active Certificates</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.IsInternal)
                    {
                        @if (Model.TopCompaniesBreakdown.Any())
                        {
                            @foreach (var company in Model.TopCompaniesBreakdown)
                            {
                                <tr>
                                    <td>@company.Name</td>
                                    <td>@company.Count.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" style="text-align: center; font-style: italic;">No company data available</td></tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="2" style="text-align: center; font-style: italic;">Access restricted to internal users</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Certs by Status -->
        <div class="table-section">
            <div class="table-header">
                <div class="table-title"># Certs by Status</div>
                <button class="table-download-icon" data-table-type="cert-status" title="Download Table Data" aria-label="Download certificate status table">
                    <i class="fas fa-download"></i>
                </button>
            </div>
            <table>
                <caption class="admin-sr-only">Number of Certificates by Status</caption>
                <thead>
                    <tr>
                        <th>Status</th>
                        <th># of Certificates</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Statistics.Any())
                    {
                        <tr><td>Active</td><td>@Model.ActiveCertificates.ToString("N0")</td></tr>
                        <tr><td>Expired</td><td>@Model.ExpiredCertificates.ToString("N0")</td></tr>
                        <tr><td>Expiring Soon</td><td>@Model.ExpiringSoonCertificates.ToString("N0")</td></tr>
                        @* TODO: Add detailed status breakdown to model and controller *@
                    }
                    else
                    {
                        <tr><td colspan="2" style="text-align: center; font-style: italic;">No certificate status data available</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Top 10 Product Types by Active Cert Count -->
        <div class="table-section">
            <div class="table-header">
                <div class="table-title">Top 10 Product Types by Active Cert Count</div>
                <button class="table-download-icon" data-table-type="product-types" title="Download Table Data" aria-label="Download product types table">
                    <i class="fas fa-download"></i>
                </button>
            </div>
            <table>
                <caption class="admin-sr-only">Top 10 Product Types by Active Certificate Count</caption>
                <thead>
                    <tr>
                        <th>Product Type</th>
                        <th># of Active Certificates</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.IsInternal)
                    {
                        @if (Model.ProductTypeBreakdown.Any())
                        {
                            @foreach (var productType in Model.ProductTypeBreakdown)
                            {
                                <tr>
                                    <td>@productType.Name</td>
                                    <td>@productType.Count.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" style="text-align: center; font-style: italic;">No product type data available</td></tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="2" style="text-align: center; font-style: italic;">Access restricted to internal users</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Top 5 Product Categories by Active Cert Count -->
        <div class="table-section">
            <div class="table-header">
                <div class="table-title">Top 5 Product Categories by Active Cert Count</div>
                <button class="table-download-icon" data-table-type="product-categories" title="Download Table Data" aria-label="Download product categories table">
                    <i class="fas fa-download"></i>
                </button>
            </div>
            <table>
                <caption class="admin-sr-only">Top 5 Product Categories by Active Certificate Count</caption>
                <thead>
                    <tr>
                        <th>Product Category</th>
                        <th># of Active Certificates</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.IsInternal)
                    {
                        @if (Model.CertificationTypeBreakdown.Any())
                        {
                            @foreach (var certType in Model.CertificationTypeBreakdown.Take(5))
                            {
                                <tr>
                                    <td>@certType.Name</td>
                                    <td>@certType.Count.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" style="text-align: center; font-style: italic;">No product category data available</td></tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="2" style="text-align: center; font-style: italic;">Access restricted to internal users</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

<!-- Action Buttons -->
<div class="action-buttons">
    <button type="button" class="action-button" onclick="event.preventDefault(); DashboardFunctions.showExpiringCerts(3)" aria-label="Download expiring certificates report for next 3 months">
        <i class="fas fa-download" aria-hidden="true"></i>
        Download Expiring Certs Report (Next 3 Months)
    </button>
    <button type="button" class="action-button" onclick="event.preventDefault(); DashboardFunctions.showActiveCerts()" aria-label="Download current active certificates report">
        <i class="fas fa-download" aria-hidden="true"></i>
        Download Current Active Certs Report
    </button>
    <button type="button" class="action-button" onclick="event.preventDefault(); DashboardFunctions.showExpiringCerts(1)" aria-label="Download expiring certificates report for next 30 days">
        <i class="fas fa-download" aria-hidden="true"></i>
        Download Expiring Certs Report (Next 30 Days)
    </button>
</div>

    </div> <!-- End admin-body-content -->
</div> <!-- End admin-container -->

@section Scripts {
    <script src="~/js/dashboard.js"></script>
}