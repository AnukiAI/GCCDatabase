@{
    ViewData["Title"] = "Product Management";
    ViewData["BodyClass"] = "admin-product-management";
}

@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()

@section Styles {
    <link href="~/css/admin/admin.css" rel="stylesheet" />
    <link href="~/css/admin/admin-mockup-override.css" rel="stylesheet" />
    <link href="~/css/product-management.css" rel="stylesheet" />
    <link href="~/css/admin-company-style.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <span>Companies & Products</span>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="@Url.Action("Index", "Product")">Products</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <span class="current">Product Management</span>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <p class="admin-page-subtitle">Manage product catalog and identifiers</p>
            </div>
            <div class="admin-actions-section">
                <div class="admin-button-group">
                    <button id="template-btn" class="admin-btn admin-btn--secondary role-element role-analyst-show role-admin-show" onclick="downloadImportTemplate()" title="Download CSV template for bulk import">
                        <i class="fas fa-file-download"></i> Template
                    </button>
                    <button id="import-btn" class="admin-btn admin-btn--secondary role-element role-analyst-show role-admin-show">
                        <i class="fas fa-upload"></i> Import
                    </button>
                    <button id="export-btn" class="admin-btn admin-btn--secondary">
                        <i class="fas fa-download"></i> Export
                    </button>
                    <button id="add-product-btn" class="admin-btn admin-btn--primary role-element role-analyst-show role-admin-show">
                        <i class="fas fa-plus"></i> Add New Product
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="admin-body-content">
        <!-- Search Row - Full Width -->
        <div class="admin-search-row">
            <div class="admin-search-box search-box">
                <i class="fas fa-search admin-search-icon search-icon"></i>
                <input type="text" id="search-input" class="admin-search-input" placeholder="Search" autocomplete="off">
                <div id="search-suggestions" class="search-suggestions"></div>
            </div>
        </div>

        <!-- Filter Row -->
        <div class="admin-toolbar">
            <div class="admin-filter-section filters">
                <div class="filter-group">
                    <label class="filter-label">Category</label>
                    <select id="category-filter" class="admin-filter-select filter-select">
                        <option value="all">All Categories</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Company</label>
                    <select id="company-filter" class="admin-filter-select filter-select">
                        <option value="all">All Companies</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Status</label>
                    <select id="status-filter" class="admin-filter-select filter-select">
                        <option value="all">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Certificates</label>
                    <select id="certificate-filter" class="admin-filter-select filter-select">
                        <option value="all">All</option>
                        <option value="has-certificates">With Certificates</option>
                        <option value="no-certificates">No Certificates</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button id="clear-filters-btn" class="btn btn-clear" title="Clear all filters">
                        <i class="fas fa-times"></i> Clear
                    </button>
                </div>
            </div>
        </div>

        <div class="admin-content">
            <table id="product-table" class="admin-table">
                <thead class="admin-table-header">
                    <tr>
                        <th style="width: 40px;"></th>
                        <th data-sort="name" class="admin-table-th--sortable" style="min-width: 160px;">Product Name <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th data-sort="company" class="admin-table-th--sortable" style="min-width: 130px;">Company <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th data-sort="category" class="admin-table-th--sortable" style="min-width: 130px;">Category <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th data-sort="productType" class="admin-table-th--sortable" style="min-width: 130px;">Product Type <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th data-sort="subcategory" class="admin-table-th--sortable" style="min-width: 130px;">Subcategory <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th data-sort="status" class="admin-table-th--sortable" style="width: 120px; min-width: 120px;">Status <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th data-sort="certificates" class="admin-table-th--sortable" style="width: 100px; min-width: 100px;">Certs <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th data-sort="identifiers" class="admin-table-th--sortable" style="width: 90px; min-width: 90px;">IDs <span class="sort-icon admin-sort-icon">▼</span></th>
                        <th class="actions-col role-element role-analyst-show role-admin-show" style="width: 100px; min-width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody class="admin-table-body">
                    <!-- Data will be populated by JavaScript -->
                </tbody>
            </table>
        </div>

        <div class="admin-footer-info" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <span id="product-count" class="admin-count-display">Showing 0 of 0 products</span>
            <div id="pagination-controls" class="pagination-controls" style="display: flex; align-items: center; gap: 4px;">
                <!-- Populated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- Import Preview Modal (US-015 Backdrop Standard) -->
<div id="import-preview-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9997;">
    <!-- Backdrop (sibling) -->
    <div class="import-modal-backdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container (sibling) -->
    <div class="import-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; width: 95%; max-width: 1200px; max-height: 90vh; background-color: white; border-radius: 8px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column; opacity: 1;">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 8px 8px 0 0;">
            <h3 class="admin-modal-title" style="color: #002B76; font-weight: 600; margin: 0; font-size: 18px;">
                <i class="fas fa-file-import" style="margin-right: 8px;"></i> Import Preview - Products
                <span id="import-filename" style="font-size: 12px; font-weight: normal; color: #666; margin-left: 10px;"></span>
            </h3>
            <button class="admin-modal-close" onclick="productManagement.closeImportPreviewModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #666; padding: 4px 8px;">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="admin-modal-body" style="background-color: white; padding: 20px; overflow-y: auto; flex: 1;">
            <!-- Summary Stats -->
            <div id="import-summary" class="import-summary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 20px;">
                <div class="import-stat" style="background: #e8f5e1; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-new" style="font-size: 24px; font-weight: 600; color: #447638;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">New</div>
                </div>
                <div class="import-stat" style="background: #e6f7ff; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-modified" style="font-size: 24px; font-weight: 600; color: #002B76;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Modified</div>
                </div>
                <div class="import-stat" style="background: #f5f5f5; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-unchanged" style="font-size: 24px; font-weight: 600; color: #999;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Unchanged</div>
                </div>
                <div class="import-stat" style="background: #ffebee; padding: 12px; border-radius: 6px; text-align: center;">
                    <div class="import-stat-value" id="import-stat-errors" style="font-size: 24px; font-weight: 600; color: #ff5252;">0</div>
                    <div class="import-stat-label" style="font-size: 12px; color: #666;">Errors</div>
                </div>
            </div>

            <!-- Preview Table -->
            <div class="import-preview-table-container" style="border: 1px solid #e9ecef; border-radius: 6px; overflow: hidden; overflow-x: auto;">
                <table class="import-preview-table" style="width: 100%; border-collapse: collapse; font-size: 16px; min-width: 900px;">
                    <thead>
                        <tr style="background: #f8f9fa;">
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 40px;">
                                <input type="checkbox" id="import-select-all" checked>
                            </th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 50px;">Row</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 100px;">Import Status</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Product Name</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef;">Description</th>
                            <th style="padding: 12px; text-align: left; border-bottom: 2px solid #e9ecef; width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="import-preview-tbody">
                        <!-- Rows populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Legend -->
            <div class="import-legend" style="margin-top: 16px; display: flex; gap: 20px; flex-wrap: wrap; font-size: 12px; color: #666;">
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #92C83E; border-radius: 2px; margin-right: 4px;"></span> New - Will be created</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #002B76; border-radius: 2px; margin-right: 4px;"></span> Modified - Will be updated</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #999; border-radius: 2px; margin-right: 4px;"></span> Unchanged - No action needed</span>
                <span><span style="display: inline-block; width: 12px; height: 12px; background: #ff5252; border-radius: 2px; margin-right: 4px;"></span> Error - Has validation errors</span>
            </div>
        </div>

        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 0 0 8px 8px;">
            <div class="import-selected-count" style="font-size: 16px; color: #666;">
                <span id="import-selected-count">0</span> of <span id="import-total-count">0</span> rows selected
            </div>
            <div class="admin-modal-actions" style="display: flex; gap: 12px;">
                <button type="button" class="admin-btn admin-btn--secondary" onclick="productManagement.closeImportPreviewModal()" style="padding: 10px 20px; border: 1px solid #ccc; background: white; border-radius: 4px; cursor: pointer;">
                    Cancel
                </button>
                <button type="button" id="import-apply-btn" class="admin-btn admin-btn--primary" onclick="productManagement.applySelectedImport()" style="padding: 10px 20px; background: #92C83E; color: white; border: none; border-radius: 4px; cursor: pointer;">
                    <i class="fas fa-check"></i> Apply Import
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Product Modal (US-015 Backdrop Standard) -->
<div id="product-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9997;">
    <!-- Backdrop (sibling) -->
    <div class="product-modal-backdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

    <!-- Modal Container (sibling) -->
    <div class="product-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; width: 95%; max-width: 650px; max-height: 90vh; background-color: white; border-radius: 8px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column; opacity: 1;">
        <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 8px 8px 0 0;">
            <h3 class="admin-modal-title" id="modal-title" style="color: #002B76; font-weight: 600; margin: 0; font-size: 18px;">
                <i class="fas fa-box" style="margin-right: 8px;"></i> Add New Product
            </h3>
            <button class="admin-modal-close modal-close" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #666; padding: 4px 8px;">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="admin-modal-body" style="background-color: white; padding: 20px; overflow-y: auto; flex: 1;">
            <form id="product-form">
                <input type="hidden" id="product-id">

                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                    <div class="form-group">
                        <label for="product-name" style="display: block; font-weight: 500; margin-bottom: 6px; color: #333;">Product Name *</label>
                        <input type="text" id="product-name" required style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 16px;">
                    </div>
                    <div class="form-group">
                        <label for="product-company" style="display: block; font-weight: 500; margin-bottom: 6px; color: #333;">Company *</label>
                        <select id="product-company" required style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 16px;">
                            <option value="">Select Company</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label for="product-description" style="display: block; font-weight: 500; margin-bottom: 6px; color: #333;">Description</label>
                    <textarea id="product-description" rows="3" placeholder="Enter product description..." style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 16px; resize: vertical;"></textarea>
                </div>

                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                    <div class="form-group">
                        <label for="product-category" style="display: block; font-weight: 500; margin-bottom: 6px; color: #333;">Category</label>
                        <select id="product-category" style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 16px;">
                            <option value="">Select Category</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="product-type" style="display: block; font-weight: 500; margin-bottom: 6px; color: #333;">Product Type</label>
                        <select id="product-type" style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 16px;">
                            <option value="">Select Type</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label for="product-subcategory" style="display: block; font-weight: 500; margin-bottom: 6px; color: #333;">Subcategory</label>
                    <select id="product-subcategory" style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 16px;">
                        <option value="">Select Subcategory</option>
                    </select>
                </div>

            </form>
        </div>

        <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: flex-end; gap: 12px; border-radius: 0 0 8px 8px;">
            <button type="button" class="admin-btn admin-btn--secondary" id="cancel-btn" style="padding: 10px 20px; border: 1px solid #ccc; background: white; border-radius: 4px; cursor: pointer; font-size: 16px;">
                Cancel
            </button>
            <button type="submit" class="admin-btn admin-btn--primary" id="save-btn" form="product-form" style="padding: 10px 20px; background: #92C83E; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; font-weight: 500;">
                <i class="fas fa-check" style="margin-right: 6px;"></i> Save Product
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Products will be loaded from API
        let products = [];

        let companies = [];
        let categories = [];
        let productTypes = [];

        // DOM Elements - declared but assigned after DOMContentLoaded
        let productTable, productTableBody, productCountElement;
        let searchInput, searchSuggestions;
        let categoryFilter, companyFilter, statusFilter, certificateFilter;
        let clearFiltersBtn;
        let importBtn, exportBtn, addProductBtn;
        let productModal, modalTitle, productForm, modalClose, cancelBtn;

        // Sorting variables
        let sortColumn = 'name';
        let sortDirection = 'asc';
        let currentEditingId = null;

        // Pagination variables
        const PAGE_SIZE = 50;
        let currentPage = 1;

        // Search suggestions
        let searchSuggestionsData = {
            products: [],
            companies: [],
            categories: [],
            types: []
        };
        let selectedSuggestionIndex = -1;

        // Initialize page
        document.addEventListener('DOMContentLoaded', async function() {
            try {
                console.log('Step 1: Initializing DOM elements...');

                // Initialize DOM elements after DOM is ready
                productTable = document.getElementById('product-table');
                productTableBody = productTable ? productTable.querySelector('tbody') : null;
                productCountElement = document.getElementById('product-count');
                searchInput = document.getElementById('search-input');
                searchSuggestions = document.getElementById('search-suggestions');
                categoryFilter = document.getElementById('category-filter');
                companyFilter = document.getElementById('company-filter');
                statusFilter = document.getElementById('status-filter');
                certificateFilter = document.getElementById('certificate-filter');
                clearFiltersBtn = document.getElementById('clear-filters-btn');
                importBtn = document.getElementById('import-btn');
                exportBtn = document.getElementById('export-btn');
                addProductBtn = document.getElementById('add-product-btn');
                productModal = document.getElementById('product-modal');
                modalTitle = document.getElementById('modal-title');
                productForm = document.getElementById('product-form');
                modalClose = document.querySelector('.modal-close');
                cancelBtn = document.getElementById('cancel-btn');

                // Validate critical elements
                if (!productTable || !productTableBody) {
                    console.error('Critical: Product table not found');
                    return;
                }

                console.log('Step 2: Loading initial data...');
                await loadInitialData();
                console.log('Step 3: Initializing event listeners...');
                initializeEventListeners();
                console.log('Step 4: Initializing sortable headers...');
                initializeSortableHeaders();
                console.log('Step 5: Populating table...');
                populateTable();
                console.log('Done!');
            } catch (error) {
                console.error('Error at:', error.stack);
                AdminCore.showNotification('Error: ' + error.message + '. Check console for details.', 'error');
            }
        });

        async function loadInitialData() {
            try {
                // Load products from API
                await loadProducts();

                // Load companies for dropdown
                const companyResponse = await fetch('/Product/GetCompanies');
                if (companyResponse.ok) {
                    const companyData = await companyResponse.json();
                    if (companyData.success) {
                        companies = companyData.data;
                        // Expose to global scope for productManagement.js import validation
                        window.companies = companies;
                        populateCompanyDropdowns();
                    }
                }

                // Load categories for dropdown
                const categoryResponse = await fetch('/Product/GetCategories');
                if (categoryResponse.ok) {
                    const categoryData = await categoryResponse.json();
                    if (categoryData.success) {
                        categories = categoryData.data;
                        // Expose to global scope for productManagement.js import validation
                        window.categories = categories;
                        populateCategoryDropdowns();
                    }
                }

                // Load product types for dropdown
                const typesResponse = await fetch('/Product/GetProductTypes');
                if (typesResponse.ok) {
                    const typesData = await typesResponse.json();
                    if (typesData.success) {
                        productTypes = typesData.data;
                        // Expose to global scope for productManagement.js import validation
                        window.productTypes = productTypes;
                        buildSearchSuggestionsData();
                    }
                }
            } catch (error) {
                console.error('Error loading initial data:', error);
            }
        }

        async function loadProducts() {
            try {
                const response = await fetch('/Product/GetProducts');
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        products = data.data;
                        buildSearchSuggestionsData();
                    } else {
                        console.error('Failed to load products:', data.message);
                    }
                } else {
                    console.error('Failed to fetch products');
                }
            } catch (error) {
                console.error('Error loading products:', error);
            }
        }

        function populateCompanyDropdowns() {
            const companySelect = document.getElementById('product-company');
            const companyFilterSelect = document.getElementById('company-filter');
            
            // Clear existing options (keep first option)
            companySelect.innerHTML = '<option value="">Select Company</option>';
            companyFilterSelect.innerHTML = '<option value="all">All Companies</option>';
            
            companies.forEach(company => {
                const option1 = new Option(company.name, company.id);
                const option2 = new Option(company.name, company.name);
                companySelect.add(option1);
                companyFilterSelect.add(option2);
            });
        }

        function populateCategoryDropdowns() {
            const categorySelect = document.getElementById('product-category');
            const categoryFilterSelect = document.getElementById('category-filter');
            
            // Clear existing options (keep first option)
            categorySelect.innerHTML = '<option value="">Select Category</option>';
            categoryFilterSelect.innerHTML = '<option value="all">All Categories</option>';
            
            categories.forEach(category => {
                const option1 = new Option(category.name, category.id);
                const option2 = new Option(category.name, category.name);
                categorySelect.add(option1);
                categoryFilterSelect.add(option2);
            });
        }

        function populateTypeDropdown(categoryId) {
            const typeSelect = document.getElementById('product-type');
            if (!typeSelect) return;
            typeSelect.innerHTML = '<option value="">Select Type</option>';
            if (!categoryId) return;
            // productTypes already loaded with categoryId
            const filtered = productTypes.filter(t => t.categoryId === categoryId);
            filtered.forEach(t => {
                typeSelect.add(new Option(t.name, t.id));
            });
        }

        async function populateSubcategoryDropdown(typeId) {
            const subSelect = document.getElementById('product-subcategory');
            if (!subSelect) return;
            subSelect.innerHTML = '<option value="">Select Subcategory</option>';
            if (!typeId) return;
            try {
                const response = await fetch(`/Certificate/GetProductSubcategories?productTypeId=${typeId}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.data) {
                        data.data.forEach(s => {
                            subSelect.add(new Option(s.name, s.id));
                        });
                    }
                }
            } catch (error) {
                console.error('Error loading subcategories:', error);
            }
        }

        function initializeEventListeners() {
            // Search and filter events (with null checks)
            if (searchInput) {
                searchInput.addEventListener('input', handleSearchInput);
                searchInput.addEventListener('keydown', handleSearchKeydown);
                searchInput.addEventListener('blur', hideSuggestions);
            }
            if (categoryFilter) categoryFilter.addEventListener('change', handleFilterChange);
            if (companyFilter) companyFilter.addEventListener('change', handleFilterChange);
            if (statusFilter) statusFilter.addEventListener('change', handleFilterChange);
            if (certificateFilter) certificateFilter.addEventListener('change', handleFilterChange);
            if (clearFiltersBtn) clearFiltersBtn.addEventListener('click', clearAllFilters);

            // Button events (with null checks)
            if (addProductBtn) addProductBtn.addEventListener('click', showAddProductModal);
            // Use productManagement.handleImportClick() for import pre-requisite checking
            if (importBtn) {
                importBtn.addEventListener('click', () => {
                    if (window.productManagement && typeof window.productManagement.handleImportClick === 'function') {
                        window.productManagement.handleImportClick();
                    } else {
                        // Fallback to legacy function if productManagement not loaded
                        importProducts();
                    }
                });
            }
            if (exportBtn) exportBtn.addEventListener('click', exportProducts);

            // Modal cascade dropdowns: Category → Type → Subcategory
            const categorySelect = document.getElementById('product-category');
            const typeSelect = document.getElementById('product-type');
            if (categorySelect) {
                categorySelect.addEventListener('change', () => {
                    const categoryId = parseInt(categorySelect.value);
                    populateTypeDropdown(categoryId);
                    // Reset subcategory when category changes
                    const subSelect = document.getElementById('product-subcategory');
                    if (subSelect) subSelect.innerHTML = '<option value="">Select Subcategory</option>';
                });
            }
            if (typeSelect) {
                typeSelect.addEventListener('change', () => {
                    const typeId = parseInt(typeSelect.value);
                    populateSubcategoryDropdown(typeId);
                });
            }

            // Modal events (with null checks)
            if (modalClose) modalClose.addEventListener('click', closeModal);
            if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
            if (productForm) productForm.addEventListener('submit', saveProduct);

            // Close modal when clicking outside
            window.addEventListener('click', function(event) {
                if (productModal && event.target === productModal) {
                    closeModal();
                }
            });
        }

        function populateTable() {
            // Guard against missing DOM elements
            if (!productTableBody || !productCountElement) {
                console.error('Product table elements not found');
                return;
            }

            const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
            const categoryFilterValue = categoryFilter ? categoryFilter.value : 'all';
            const companyFilterValue = companyFilter ? companyFilter.value : 'all';
            const statusFilterValue = statusFilter ? statusFilter.value : 'all';
            const certificateFilterValue = certificateFilter ? certificateFilter.value : 'all';

            // Filter products
            let filteredProducts = products.filter(product => {
                const matchesSearch = product.name.toLowerCase().includes(searchTerm) ||
                                    (product.companyName && product.companyName.toLowerCase().includes(searchTerm)) ||
                                    (product.categoryName && product.categoryName.toLowerCase().includes(searchTerm)) ||
                                    (product.productTypeName && product.productTypeName.toLowerCase().includes(searchTerm)) ||
                                    (product.productSubcategoryName && product.productSubcategoryName.toLowerCase().includes(searchTerm)) ||
                                    (product.sku && product.sku.toLowerCase().includes(searchTerm)) ||
                                    (product.model && product.model.toLowerCase().includes(searchTerm));
                const matchesCategory = categoryFilterValue === 'all' || product.categoryName === categoryFilterValue;
                const matchesCompany = companyFilterValue === 'all' || product.companyName === companyFilterValue;
                const matchesStatus = statusFilterValue === 'all' || product.status.toLowerCase() === statusFilterValue;
                const matchesCertificates = certificateFilterValue === 'all' ||
                    (certificateFilterValue === 'has-certificates' && product.certificateCount > 0) ||
                    (certificateFilterValue === 'no-certificates' && product.certificateCount === 0);

                return matchesSearch && matchesCategory && matchesCompany && matchesStatus && matchesCertificates;
            });
            
            updateActiveFiltersDisplay();

            // Sort filtered products - map data-sort attribute to actual property names
            filteredProducts.sort((a, b) => {
                let aValue, bValue;
                const sortMap = {
                    'name': 'name',
                    'company': 'companyName',
                    'category': 'categoryName',
                    'productType': 'productTypeName',
                    'subcategory': 'productSubcategoryName',
                    'status': 'status'
                };

                if (sortColumn === 'certificates') {
                    aValue = a.certificateCount || 0;
                    bValue = b.certificateCount || 0;
                    return sortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                } else if (sortColumn === 'identifiers') {
                    aValue = a.identifiers ? Object.values(a.identifiers).reduce((sum, arr) => sum + arr.length, 0) : 0;
                    bValue = b.identifiers ? Object.values(b.identifiers).reduce((sum, arr) => sum + arr.length, 0) : 0;
                    return sortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                } else {
                    const prop = sortMap[sortColumn] || sortColumn;
                    aValue = a[prop] || '';
                    bValue = b[prop] || '';
                }

                if (sortDirection === 'asc') {
                    return aValue.toString().localeCompare(bValue.toString());
                } else {
                    return bValue.toString().localeCompare(aValue.toString());
                }
            });

            // Pagination
            const totalFiltered = filteredProducts.length;
            const totalPages = Math.ceil(totalFiltered / PAGE_SIZE);
            if (currentPage > totalPages) currentPage = totalPages || 1;
            const startIndex = (currentPage - 1) * PAGE_SIZE;
            const pagedProducts = filteredProducts.slice(startIndex, startIndex + PAGE_SIZE);

            // Populate table
            productTableBody.innerHTML = '';

            pagedProducts.forEach(product => {
                // Main row
                const row = document.createElement('tr');
                row.className = 'main-row expandable-row';
                row.setAttribute('data-product-id', product.id);

                const totalIdentifiers = product.identifiers ?
                    Object.values(product.identifiers).reduce((sum, arr) => sum + arr.length, 0) : 0;

                row.innerHTML = `
                    <td data-label="">
                        <span class="expand-indicator" onclick="toggleRowDetails(${product.id})">▶</span>
                    </td>
                    <td data-label="Product">
                        <div class="product-info">
                            <div class="product-name">${product.name}</div>
                            <div class="product-sku">SKU: ${product.sku || 'N/A'}</div>
                        </div>
                    </td>
                    <td data-label="Company">${product.companyName || ''}</td>
                    <td data-label="Category">${product.categoryName || ''}</td>
                    <td data-label="Product Type">${product.productTypeName || ''}</td>
                    <td data-label="Subcategory">${product.productSubcategoryName || ''}</td>
                    <td data-label="Status">
                        <span class="status-badge status-${product.status.toLowerCase()}">${product.status}</span>
                    </td>
                    <td data-label="Certs">
                        <span class="certificate-count">
                            <i class="fas fa-certificate"></i> ${product.certificateCount || 0}
                        </span>
                    </td>
                    <td data-label="IDs">
                        <span class="product-identifiers-summary">
                            <span class="identifier-count">${totalIdentifiers}</span>
                        </span>
                    </td>
                    <td class="actions-cell role-element role-analyst-show role-admin-show" data-label="Actions">
                        <div class="action-buttons">
                            <button class="btn-edit role-element role-analyst-show role-admin-show" onclick="editProduct(${product.id})" title="Edit Product">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn-delete role-element role-analyst-show role-admin-show" onclick="deleteProduct(${product.id})" title="Delete Product">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                productTableBody.appendChild(row);

                // Detail row
                const detailRow = document.createElement('tr');
                detailRow.className = 'detail-row';
                detailRow.setAttribute('data-product-id', product.id);
                detailRow.innerHTML = `
                    <td colspan="10" class="detail-cell">
                        <div class="detail-content">
                            ${createIdentifierSections(product.identifiers || {})}
                        </div>
                    </td>
                `;
                productTableBody.appendChild(detailRow);
            });

            // Update count with pagination info
            const showingStart = totalFiltered > 0 ? startIndex + 1 : 0;
            const showingEnd = Math.min(startIndex + PAGE_SIZE, totalFiltered);
            productCountElement.textContent = `Showing ${showingStart}-${showingEnd} of ${totalFiltered} products`;

            // Render pagination controls
            renderPagination(totalPages, totalFiltered);
        }

        function renderPagination(totalPages, totalFiltered) {
            const container = document.getElementById('pagination-controls');
            if (!container) return;

            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = '';

            // Previous button
            html += `<button class="pagination-btn${currentPage === 1 ? ' disabled' : ''}"
                        onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>
                        <i class="fas fa-chevron-left"></i>
                    </button>`;

            // Page numbers with ellipsis
            const maxVisible = 7;
            let startPage = 1;
            let endPage = totalPages;

            if (totalPages > maxVisible) {
                const half = Math.floor(maxVisible / 2);
                startPage = Math.max(1, currentPage - half);
                endPage = Math.min(totalPages, startPage + maxVisible - 1);
                if (endPage - startPage < maxVisible - 1) {
                    startPage = Math.max(1, endPage - maxVisible + 1);
                }
            }

            if (startPage > 1) {
                html += `<button class="pagination-btn" onclick="goToPage(1)">1</button>`;
                if (startPage > 2) html += `<span class="pagination-ellipsis">...</span>`;
            }

            for (let i = startPage; i <= endPage; i++) {
                html += `<button class="pagination-btn${i === currentPage ? ' active' : ''}"
                            onclick="goToPage(${i})">${i}</button>`;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += `<span class="pagination-ellipsis">...</span>`;
                html += `<button class="pagination-btn" onclick="goToPage(${totalPages})">${totalPages}</button>`;
            }

            // Next button
            html += `<button class="pagination-btn${currentPage === totalPages ? ' disabled' : ''}"
                        onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>
                        <i class="fas fa-chevron-right"></i>
                    </button>`;

            container.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            populateTable();
            // Scroll to top of table
            const tableEl = document.getElementById('product-table');
            if (tableEl) tableEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function initializeSortableHeaders() {
            const headers = productTable.querySelectorAll('th[data-sort]');
            headers.forEach(header => {
                header.addEventListener('click', () => {
                    const column = header.getAttribute('data-sort');
                    if (sortColumn === column) {
                        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortColumn = column;
                        sortDirection = 'asc';
                    }
                    
                    headers.forEach(h => {
                        h.classList.remove('active-sort');
                        const icon = h.querySelector('.sort-icon');
                        if (icon) icon.textContent = '▼';
                    });
                    header.classList.add('active-sort');

                    const sortIcon = header.querySelector('.sort-icon');
                    sortIcon.textContent = sortDirection === 'asc' ? '▲' : '▼';

                    populateTable();
                });
            });
        }

        function showAddProductModal() {
            modalTitle.innerHTML = '<i class="fas fa-box" style="margin-right: 8px;"></i> Add New Product';
            document.getElementById('product-id').value = '';
            productForm.reset();
            productModal.style.display = 'flex';
            productModal.style.alignItems = 'center';
            productModal.style.justifyContent = 'center';
        }

        function editProduct(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            modalTitle.innerHTML = '<i class="fas fa-edit" style="margin-right: 8px;"></i> Edit Product';
            document.getElementById('product-id').value = product.id;
            document.getElementById('product-name').value = product.name;
            document.getElementById('product-description').value = product.description || '';

            productModal.style.display = 'flex';
            productModal.style.alignItems = 'center';
            productModal.style.justifyContent = 'center';
        }


        async function deleteProduct(id) {
            const product = products.find(p => p.id === id);
            const productName = product ? product.name : 'this product';

            const confirmed = await AdminCore.showConfirmation({
                title: 'Delete Confirmation',
                message: `Are you sure you want to delete <strong>${productName}</strong>? This action cannot be undone.`,
                confirmText: 'Delete',
                cancelText: 'Cancel',
                type: 'danger',
                allowHtml: true
            });

            if (confirmed) {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch(`/Product/DeleteProduct?id=${id}`, {
                        method: 'DELETE',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        if (result.success) {
                            await loadProducts();
                            populateTable();
                            AdminCore.showNotification(result.message || 'Product deleted successfully', 'success');
                        } else {
                            // Show error in modal notification so it's clearly visible
                            AdminCore.showConfirmation({
                                title: 'Cannot Delete Product',
                                message: result.message || 'This product could not be deleted.',
                                confirmText: 'OK',
                                cancelText: null,
                                type: 'warning',
                                allowHtml: true
                            });
                        }
                    } else {
                        AdminCore.showConfirmation({
                            title: 'Delete Failed',
                            message: 'An unexpected error occurred while trying to delete this product. Please try again.',
                            confirmText: 'OK',
                            cancelText: null,
                            type: 'danger',
                            allowHtml: true
                        });
                    }
                } catch (error) {
                    console.error('Error deleting product:', error);
                    AdminCore.showConfirmation({
                        title: 'Delete Failed',
                        message: 'A network error occurred while trying to delete this product. Please check your connection and try again.',
                        confirmText: 'OK',
                        cancelText: null,
                        type: 'danger',
                        allowHtml: true
                    });
                }
            }
        }

        async function saveProduct(e) {
            e.preventDefault();

            const companyVal = document.getElementById('product-company').value;
            if (!companyVal) {
                AdminCore.showNotification('Company is required. Please select a company.', 'error');
                document.getElementById('product-company').focus();
                return;
            }

            const formData = {
                id: parseInt(document.getElementById('product-id').value) || 0,
                name: document.getElementById('product-name').value,
                description: document.getElementById('product-description').value,
                categoryId: parseInt(document.getElementById('product-category').value) || 0,
                productTypeId: parseInt(document.getElementById('product-type').value) || null,
                productSubcategoryId: parseInt(document.getElementById('product-subcategory').value) || null,
                companyId: parseInt(companyVal),
                isActive: true
            };

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('/Product/SaveProduct', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        await loadProducts();
                        closeModal();
                        populateTable();
                        const message = result.message || (formData.id ? 'Product updated successfully' : 'Product added successfully');
                        showNotification(message, 'success');
                        showToast(message);
                    } else {
                        showToast(result.message || 'Error saving product', 'error');
                    }
                } else {
                    showToast('Error saving product', 'error');
                }
            } catch (error) {
                console.error('Error saving product:', error);
                showToast('Error saving product', 'error');
            }
        }

        function closeModal() {
            productModal.style.display = 'none';
            productForm.reset();
        }

        async function importProducts() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.csv';
            input.onchange = async function(e) {
                const file = e.target.files[0];
                if (file) {
                    const formData = new FormData();
                    formData.append('file', file);

                    // Get anti-forgery token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) {
                        formData.append('__RequestVerificationToken', token);
                    }

                    try {
                        showToast('Importing products...', 'info');

                        const response = await fetch('/Product/ImportProducts', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token
                            }
                        });

                        const result = await response.json();

                        if (result.success) {
                            showToast(result.message || 'Products imported successfully', 'success');

                            // Show detailed results if there are errors
                            if (result.data && result.data.errors && result.data.errors.length > 0) {
                                let errorMsg = `Import completed with ${result.data.successCount} successes and ${result.data.errorCount} errors.\n\nFirst errors:\n`;
                                errorMsg += result.data.errors.slice(0, 5).join('\n');
                                if (result.data.errors.length > 5) {
                                    errorMsg += `\n... and ${result.data.errors.length - 5} more`;
                                }
                                console.warn('Import errors:', result.data.errors);
                                AdminCore.showNotification(errorMsg, 'warning');
                            }

                            // Reload products
                            await loadProducts();
                            populateTable();
                        } else {
                            showToast(result.message || 'Import failed', 'error');
                        }
                    } catch (error) {
                        console.error('Import error:', error);
                        showToast('Error importing products', 'error');
                    }
                }
            };
            input.click();
        }

        function downloadImportTemplate() {
            window.location.href = '/Product/DownloadProductImportTemplate';
        }

        function exportProducts() {
            // Each identifier gets its own row, product info repeated
            const headers = ['Name', 'Company', 'Category', 'Product Type', 'Subcategory', 'Status', 'Identifier Type', 'Identifier Value'];
            const rows = [];

            products.forEach(p => {
                const identifiers = p.identifiers || {};
                const baseRow = [
                    p.name || '',
                    p.companyName || p.company || '',
                    p.categoryName || p.category || '',
                    p.productTypeName || '',
                    p.productSubcategoryName || '',
                    p.status || (p.isActive ? 'Active' : 'Inactive')
                ];

                // Collect all identifiers into type/value pairs
                const allIds = [];
                Object.keys(identifiers).forEach(type => {
                    const values = identifiers[type] || [];
                    values.forEach(val => {
                        allIds.push({ type: type.toUpperCase(), value: val });
                    });
                });

                // Also check direct fields
                if (p.sku) allIds.push({ type: 'SKU', value: p.sku });
                if (p.model) allIds.push({ type: 'Model', value: p.model });

                if (allIds.length > 0) {
                    allIds.forEach(id => {
                        rows.push([...baseRow, id.type, id.value]);
                    });
                } else {
                    rows.push([...baseRow, '', '']);
                }
            });

            const escapeCell = (val) => {
                const str = String(val ?? '');
                if (str.includes(',') || str.includes('"') || str.includes('\n') || /^\d{10,}$/.test(str))
                    return `"${str.replace(/"/g, '""')}"`;
                return `"${str}"`;
            };

            const csvContent = [
                headers.map(h => `"${h}"`).join(','),
                ...rows.map(row => row.map(cell => escapeCell(cell)).join(','))
            ].join('\n');

            const blob = new Blob([csvContent], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `products_export_${new Date().toISOString().split('T')[0]}.csv`;
            a.click();
            URL.revokeObjectURL(url);

            showToast(`Exported ${rows.length} rows (${products.length} products) successfully`);
        }
        
        function buildSearchSuggestionsData() {
            // Extract unique values for suggestions
            searchSuggestionsData.products = [...new Set(products.map(p => p.name))].sort();
            searchSuggestionsData.companies = [...new Set(companies.map(c => c.name))].sort();
            searchSuggestionsData.categories = [...new Set(categories.map(c => c.name))].sort();
            searchSuggestionsData.types = [...new Set(productTypes.map(t => t.name))].sort();
        }
        
        function handleSearchInput(e) {
            const query = e.target.value.toLowerCase().trim();
            
            if (query.length >= 2) {
                showSearchSuggestions(query);
            } else {
                hideSuggestions();
            }
            
            // Debounce the table population for better performance
            clearTimeout(window.searchTimeout);
            window.searchTimeout = setTimeout(() => {
                currentPage = 1;
                populateTable();
            }, 300);
        }
        
        function showSearchSuggestions(query) {
            const suggestions = [];
            
            // Add product suggestions
            searchSuggestionsData.products
                .filter(name => name.toLowerCase().includes(query))
                .slice(0, 3)
                .forEach(name => {
                    suggestions.push({ text: name, type: 'product', icon: 'fas fa-box' });
                });
            
            // Add company suggestions
            searchSuggestionsData.companies
                .filter(name => name.toLowerCase().includes(query))
                .slice(0, 3)
                .forEach(name => {
                    suggestions.push({ text: name, type: 'company', icon: 'fas fa-building' });
                });
            
            // Add category suggestions
            searchSuggestionsData.categories
                .filter(name => name.toLowerCase().includes(query))
                .slice(0, 2)
                .forEach(name => {
                    suggestions.push({ text: name, type: 'category', icon: 'fas fa-tags' });
                });
            
            // Add type suggestions
            searchSuggestionsData.types
                .filter(name => name.toLowerCase().includes(query))
                .slice(0, 2)
                .forEach(name => {
                    suggestions.push({ text: name, type: 'type', icon: 'fas fa-sitemap' });
                });
            
            if (suggestions.length > 0) {
                displaySuggestions(suggestions);
            } else {
                hideSuggestions();
            }
        }
        
        function displaySuggestions(suggestions) {
            selectedSuggestionIndex = -1;
            
            searchSuggestions.innerHTML = suggestions.map((suggestion, index) => `
                <div class="suggestion-item" data-index="${index}" onclick="selectSuggestion('${suggestion.text}')">
                    <i class="${suggestion.icon} suggestion-icon"></i>
                    <span class="suggestion-text">${suggestion.text}</span>
                    <span class="suggestion-type">${suggestion.type}</span>
                </div>
            `).join('');
            
            searchSuggestions.style.display = 'block';
        }
        
        function handleSearchKeydown(e) {
            const suggestionItems = searchSuggestions.querySelectorAll('.suggestion-item');
            
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                selectedSuggestionIndex = Math.min(selectedSuggestionIndex + 1, suggestionItems.length - 1);
                updateSuggestionSelection(suggestionItems);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                selectedSuggestionIndex = Math.max(selectedSuggestionIndex - 1, -1);
                updateSuggestionSelection(suggestionItems);
            } else if (e.key === 'Enter' && selectedSuggestionIndex >= 0) {
                e.preventDefault();
                const selectedItem = suggestionItems[selectedSuggestionIndex];
                if (selectedItem) {
                    const text = selectedItem.querySelector('.suggestion-text').textContent;
                    selectSuggestion(text);
                }
            } else if (e.key === 'Escape') {
                hideSuggestions();
            }
        }
        
        function updateSuggestionSelection(items) {
            items.forEach((item, index) => {
                if (index === selectedSuggestionIndex) {
                    item.classList.add('selected');
                } else {
                    item.classList.remove('selected');
                }
            });
        }
        
        function selectSuggestion(text) {
            searchInput.value = text;
            hideSuggestions();
            populateTable();
        }
        
        function hideSuggestions() {
            setTimeout(() => {
                searchSuggestions.style.display = 'none';
                selectedSuggestionIndex = -1;
            }, 200);
        }
        
        function handleFilterChange() {
            currentPage = 1;
            populateTable();
            updateActiveFiltersDisplay();
        }
        
        function clearAllFilters() {
            categoryFilter.value = 'all';
            companyFilter.value = 'all';
            statusFilter.value = 'all';
            certificateFilter.value = 'all';
            searchInput.value = '';
            populateTable();
            updateActiveFiltersDisplay();
            showToast('All filters cleared', 'info');
        }
        
        function updateActiveFiltersDisplay() {
            const activeFilters = [];
            
            if (categoryFilter.value !== 'all') {
                activeFilters.push({ type: 'Category', value: categoryFilter.options[categoryFilter.selectedIndex].text });
            }
            if (companyFilter.value !== 'all') {
                activeFilters.push({ type: 'Company', value: companyFilter.options[companyFilter.selectedIndex].text });
            }
            if (statusFilter.value !== 'all') {
                activeFilters.push({ type: 'Status', value: statusFilter.options[statusFilter.selectedIndex].text });
            }
            if (certificateFilter.value !== 'all') {
                activeFilters.push({ type: 'Certificates', value: certificateFilter.options[certificateFilter.selectedIndex].text });
            }
            if (searchInput.value.trim()) {
                activeFilters.push({ type: 'Search', value: searchInput.value.trim() });
            }
            
            displayActiveFilters(activeFilters);
        }
        
        function displayActiveFilters(filters) {
            let activeFiltersContainer = document.getElementById('active-filters');
            if (!activeFiltersContainer) {
                const toolbar = document.querySelector('.admin-toolbar');
                if (!toolbar) return; // Exit if toolbar not found
                activeFiltersContainer = document.createElement('div');
                activeFiltersContainer.id = 'active-filters';
                activeFiltersContainer.className = 'active-filters';
                toolbar.appendChild(activeFiltersContainer);
            }

            if (filters.length === 0) {
                activeFiltersContainer.style.display = 'none';
                return;
            }
            
            activeFiltersContainer.style.display = 'flex';
            activeFiltersContainer.innerHTML = `
                ${filters.map(filter => `
                    <div class="filter-tag">
                        <span class="filter-tag-value">${filter.value}</span>
                        <button class="filter-tag-remove" onclick="removeFilter('${filter.type.toLowerCase()}')" title="Remove filter">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `).join('')}
            `;
        }
        
        function removeFilter(filterType) {
            switch(filterType) {
                case 'category':
                    categoryFilter.value = 'all';
                    break;
                case 'company':
                    companyFilter.value = 'all';
                    break;
                case 'status':
                    statusFilter.value = 'all';
                    break;
                case 'certificates':
                    certificateFilter.value = 'all';
                    break;
                case 'search':
                    searchInput.value = '';
                    break;
            }
            populateTable();
        }

        function initializeRealTimeUpdates() {
            // Add real-time controls to header
            const headerButtonsArea = document.querySelector('.admin-button-group');
            if (!headerButtonsArea) return; // Exit if button area not found
            const realTimeToggle = document.createElement('button');
            realTimeToggle.id = 'realtime-toggle';
            realTimeToggle.className = 'btn btn-secondary';
            realTimeToggle.innerHTML = '<i class="fas fa-sync-alt"></i> Auto Refresh: OFF';
            realTimeToggle.title = 'Toggle auto-refresh (Ctrl+R)';
            realTimeToggle.addEventListener('click', toggleAutoRefresh);
            headerButtonsArea.insertBefore(realTimeToggle, headerButtonsArea.firstChild);
            
            // Initialize with auto-refresh disabled
            lastUpdateTimestamp = Date.now();
        }
        
        function toggleAutoRefresh() {
            isAutoRefreshEnabled = !isAutoRefreshEnabled;
            const toggleBtn = document.getElementById('realtime-toggle');
            
            if (isAutoRefreshEnabled) {
                startAutoRefresh();
                toggleBtn.innerHTML = '<i class="fas fa-sync-alt spinning"></i> Auto Refresh: ON';
                toggleBtn.classList.remove('btn-secondary');
                toggleBtn.classList.add('btn-success');
                showNotification('Auto-refresh enabled - Updates every 30 seconds', 'success');
            } else {
                stopAutoRefresh();
                toggleBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Auto Refresh: OFF';
                toggleBtn.classList.remove('btn-success');
                toggleBtn.classList.add('btn-secondary');
                showNotification('Auto-refresh disabled', 'info');
            }
        }
        
        function startAutoRefresh() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
            }
            
            autoRefreshInterval = setInterval(async () => {
                if (!document.hidden) { // Only refresh when page is visible
                    try {
                        const oldProductsLength = products.length;
                        await loadProducts();
                        
                        if (products.length !== oldProductsLength) {
                            const diff = products.length - oldProductsLength;
                            if (diff > 0) {
                                showNotification(`${diff} new product(s) added`, 'success');
                            } else {
                                showNotification(`${Math.abs(diff)} product(s) removed`, 'warning');
                            }
                            populateTable();
                        }
                        
                        // Update timestamp indicator
                        updateLastRefreshIndicator();
                    } catch (error) {
                        console.error('Auto-refresh failed:', error);
                        showNotification('Auto-refresh failed', 'error');
                    }
                }
            }, 30000); // 30 seconds
        }
        
        function stopAutoRefresh() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
                autoRefreshInterval = null;
            }
        }
        
        function updateLastRefreshIndicator() {
            lastUpdateTimestamp = Date.now();
            const indicator = document.getElementById('last-update-indicator');
            if (!indicator) {
                const footerInfo = document.querySelector('.admin-footer-info');
                if (!footerInfo) return; // Exit if footer not found
                const updateIndicator = document.createElement('span');
                updateIndicator.id = 'last-update-indicator';
                updateIndicator.className = 'last-update';
                footerInfo.appendChild(updateIndicator);
            }
            
            const now = new Date();
            document.getElementById('last-update-indicator').textContent = 
                ` • Last updated: ${now.toLocaleTimeString()}`;
        }
        
        function createNotificationContainer() {
            const container = document.createElement('div');
            container.id = 'notification-container';
            container.className = 'notification-container';
            document.body.appendChild(container);
        }
        
        function showNotification(message, type = 'info', duration = 4000) {
            notificationQueue.push({ message, type, duration });
            if (!isProcessingNotification) {
                processNotificationQueue();
            }
        }
        
        function processNotificationQueue() {
            if (notificationQueue.length === 0) {
                isProcessingNotification = false;
                return;
            }
            
            isProcessingNotification = true;
            const notification = notificationQueue.shift();
            displayNotification(notification);
        }
        
        function displayNotification({ message, type, duration }) {
            const container = document.getElementById('notification-container');
            const notification = document.createElement('div');
            notification.className = `notification notification-${type}`;
            
            const icon = getNotificationIcon(type);
            notification.innerHTML = `
                <div class="notification-content">
                    <i class="${icon} notification-icon"></i>
                    <span class="notification-message">${message}</span>
                    <button class="notification-close" onclick="closeNotification(this)">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="notification-progress"></div>
            `;
            
            container.appendChild(notification);
            
            // Animate in
            setTimeout(() => {
                notification.classList.add('show');
            }, 10);
            
            // Auto-remove after duration
            setTimeout(() => {
                removeNotification(notification);
            }, duration);
        }
        
        function getNotificationIcon(type) {
            switch(type) {
                case 'success': return 'fas fa-check-circle';
                case 'error': return 'fas fa-exclamation-circle';
                case 'warning': return 'fas fa-exclamation-triangle';
                default: return 'fas fa-info-circle';
            }
        }
        
        function closeNotification(button) {
            const notification = button.closest('.notification');
            removeNotification(notification);
        }
        
        function removeNotification(notification) {
            notification.classList.add('hide');
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
                processNotificationQueue();
            }, 300);
        }
        
        function handleKeyboardShortcuts(e) {
            if (e.ctrlKey || e.metaKey) {
                switch(e.key.toLowerCase()) {
                    case 'r':
                        if (!e.shiftKey) {
                            e.preventDefault();
                            toggleAutoRefresh();
                        }
                        break;
                    case 'f':
                        if (e.shiftKey) {
                            e.preventDefault();
                            clearAllFilters();
                        }
                        break;
                    case '/':
                        e.preventDefault();
                        searchInput.focus();
                        break;
                }
            }
        }

        function createIdentifierSections(identifiers) {
            let sections = '';

            Object.keys(identifiers).forEach(type => {
                if (identifiers[type] && identifiers[type].length > 0) {
                    const typeLabel = type.toUpperCase();
                    const items = identifiers[type];

                    sections += `
                        <div class="detail-section">
                            <div class="detail-section-title">${typeLabel} (${items.length})</div>
                            <div class="detail-grid">
                                ${items.map(item => `<div class="detail-item">${item}</div>`).join('')}
                            </div>
                        </div>
                    `;
                }
            });

            return sections || '<div class="detail-section"><div class="detail-section-title">No identifiers available</div></div>';
        }

        function toggleRowDetails(productId) {
            const indicator = document.querySelector(`tr[data-product-id="${productId}"] .expand-indicator`);
            const detailRow = document.querySelector(`tr.detail-row[data-product-id="${productId}"]`);
            
            if (detailRow) {
                const isExpanded = detailRow.classList.contains('show');
                
                if (isExpanded) {
                    detailRow.classList.remove('show');
                    indicator.textContent = '▶';
                    indicator.classList.remove('expanded');
                } else {
                    detailRow.classList.add('show');
                    indicator.textContent = '▼';
                    indicator.classList.add('expanded');
                }
            }
        }

        function showToast(message, type = 'success') {
            AdminCore.showNotification(message, type);
        }
    </script>
    <!-- Import productManagement.js for import modal functionality -->
    <script src="~/js/admin/productManagement.js"></script>
}

