@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@using GCCWebApp.Data
@inject ApplicationDbContext DbContext
@{
    // Get the user role from session or set to "Public" for unauthenticated users
    var userRole = Context.Session.GetString("UserRole") ?? "Public";
    var roleCssClass = $"role-{userRole.ToLower()}";

    // Get user name for display
    var userName = Context.Session.GetString("UserName") ?? "Sign In";

    // Get Google Analytics settings (safe for fresh deployments)
    GCCWebApp.Models.GoogleAnalyticsSettings? gaSettings = null;
    try
    {
        gaSettings = await DbContext.GoogleAnalyticsSettings.FirstOrDefaultAsync();
    }
    catch (Exception)
    {
        // Database not initialized yet - this is normal for fresh deployments
        gaSettings = null;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Html.AntiForgeryToken()
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>

    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" crossorigin="anonymous" />

    <!-- Preload critical icon fonts -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <!-- Unified CSS -->
    <link href="~/css/main.css" rel="stylesheet" />

    <!-- Admin Tables - Unified styling for all admin page tables -->
    <link href="~/css/admin-tables.css" rel="stylesheet" />

    <!-- Admin Core & Modals - Required for AdminCore notifications -->
    <link href="~/css/admin/admin-core.css" rel="stylesheet" />
    <link href="~/css/admin/admin-modals.css" rel="stylesheet" />

    <!-- Unified Component System (standardized buttons, modals, layouts) -->
    <link href="~/css/unified-components.css" rel="stylesheet" />

    <!-- Accessibility Enhancements - Low Priority Fixes (WCAG 2.1 Level AA) -->
    <link href="~/css/accessibility-enhancements-low-priority.css" rel="stylesheet" />

    <!-- Component-specific CSS loaded per page -->
    @RenderSection("Styles", required: false)

    @if (gaSettings != null && gaSettings.IsEnabled && !string.IsNullOrEmpty(gaSettings.TrackingId))
    {
        @if (!string.IsNullOrEmpty(gaSettings.CustomScript))
        {
            <!-- Custom Google Analytics Script -->
            @Html.Raw(gaSettings.CustomScript)
        }
        else
        {
            <!-- Google Analytics 4 -->
            <script async src="https://www.googletagmanager.com/gtag/js?id=@gaSettings.TrackingId"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());

                var config = { @if (gaSettings.AnonymizeIp) { <text>anonymize_ip: true,</text> } };
                @if (gaSettings.EnhancedLinkAttribution)
                {
                    <text>config.link_attribution = true;</text>
                }
                @if (gaSettings.DebugMode)
                {
                    <text>config.debug_mode = true;</text>
                }
                gtag('config', '@gaSettings.TrackingId', config);
            </script>
        }
    }
</head>
<body class="theme-option4 @roleCssClass @ViewData["BodyClass"]">
    <!-- Skip to main content link for keyboard navigation -->
    <a href="#main-content" class="admin-sr-only skip-to-main">Skip to main content</a>

    <!-- Header -->
    <header class="header">
        <!-- Top bar with user controls -->
        <div class="header-top">
            <div class="logo-text"></div>
            <div class="user-controls">
                <div class="user-profile">
                    <span class="user-name">@userName</span>
                    <div class="user-dropdown">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account" asp-action="TwoFactorPreferences" class="dropdown-item">
                                <i class="fas fa-shield-alt"></i> 2FA Settings
                            </a>
                            <form asp-controller="Account" asp-action="LogoutPost" method="post" id="logoutForm" class="logout-form">
                                <button type="submit" class="dropdown-item logout-button">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="dropdown-item">
                                <i class="fas fa-sign-in-alt"></i> Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Middle section with logo and branding - Always Option 4 -->
        <div class="header-middle header-option4">
            <div class="page-container">
                <div class="logo-area">
                    <div class="logo-img">
                        <img src="~/img/gcclogo.png" alt="GreenCircle Certified Logo" class="main-logo" />
                    </div>
                    <div class="logo-text-group">
                        <div class="logo-text">GreenCircle Certified Database</div>
                        <div class="logo-subtext">
                            Browse the directory to access active GreenCircle certifications.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation wrapper - Always visible for design consistency -->
        <div class="nav-wrapper">
            <nav class="main-nav" aria-label="Main navigation">
                <div class="mobile-toggle" id="mobile-toggle" role="button" aria-label="Open navigation menu" tabindex="0">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </div>
                <ul class="nav-links">
                    <li class="mobile-nav-close-item">
                        <button class="mobile-nav-close" id="mobile-nav-close" 
                                title="Close navigation menu" 
                                aria-label="Close navigation menu">
                            <i class="fas fa-times"></i>
                        </button>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (userRole == "External")
                        {
                            <!-- External Navigation Items - Only Products, no Companies -->
                            <li class="nav-item">
                                <a asp-controller="Certificate" asp-action="CertificateTileViewExternal" class="nav-link">
                                    Certificates
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Product" asp-action="Management" class="nav-link">
                                    Products
                                </a>
                            </li>
                        }
                        else if (userRole == "Analyst" || userRole == "Admin")
                        {
                            <!-- Analyst & Admin Navigation Items -->
                            <li class="nav-item">
                                <a asp-controller="Certificate" asp-action="CertificateTileViewInternal" class="nav-link">
                                    Certificates
                                </a>
                            </li>
                        }
                    }
                    @* Public users have no navigation items since they're already on the only page they can access *@

                    @if (User.Identity?.IsAuthenticated == true && (userRole == "Analyst" || userRole == "Admin"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                Companies & Products
                                <i class="fas fa-chevron-down dropdown-icon"></i>
                            </a>
                            <div class="submenu">
                                <a asp-controller="Company" asp-action="Index">
                                    Companies
                                </a>
                                <a asp-controller="Product" asp-action="Management">
                                    Products
                                </a>
                            </div>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated == true && userRole == "Admin")
                    {
                        <li class="nav-item">
                        <a href="#" class="nav-link">
                            Administration
                            <i class="fas fa-chevron-down dropdown-icon"></i>
                        </a>
                        <div class="submenu">
                            <a asp-controller="Admin" asp-action="RoleManagement">
                                Role Management
                            </a>
                            <a asp-controller="Admin" asp-action="UserManagement">
                                User Management
                            </a>
                           @*  <a asp-controller="Admin" asp-action="CreateUser">Create User</a> *@

                            <!-- Configuration/Settings submenu -->
                            <div class="submenu-item">
                                <div class="submenu-toggle">
                                    Configuration/Settings
                                    <i class="fas fa-chevron-right toggle-icon"></i>
                                </div>
                                <div class="nested-submenu">
                                    <a asp-controller="Admin" asp-action="GoogleAnalytics">
                                        Google Analytics Tracking
                                    </a>
                                </div>
                            </div>

                            <!-- API Management submenu -->
                            <div class="submenu-item">
                                <div class="submenu-toggle">
                                    API Management
                                    <i class="fas fa-chevron-right toggle-icon"></i>
                                </div>
                                <div class="nested-submenu">
                                    <a asp-controller="Admin" asp-action="PartnerAPI">
                                        Partner API Access
                                    </a>
                                </div>
                            </div>

                            <!-- Data Management submenu -->
                            <div class="submenu-item">
                                <div class="submenu-toggle">
                                    Data Management
                                    <i class="fas fa-chevron-right toggle-icon"></i>
                                </div>
                                <div class="nested-submenu">
                                    <a asp-controller="Admin" asp-action="CertificateTypes">
                                        Certificate Types
                                    </a>
                                    <a asp-controller="Admin" asp-action="ProductTypes">
                                        Product Types
                                    </a>
                                    <a asp-controller="Admin" asp-action="CertificateFields">
                                        Certificate Fields
                                    </a>
                                    <a asp-controller="Admin" asp-action="CSFAttributes">
                                        CSF Attributes
                                    </a>
                                    <a asp-controller="Admin" asp-action="Tags">
                                        Tags
                                    </a>
                                    <a asp-controller="Admin" asp-action="Partners">
                                        Partners
                                    </a>
                                    <a asp-controller="Admin" asp-action="Pathways">
                                        Pathways
                                    </a>
                                </div>
                            </div>
                        </div>
                    </li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <!-- Breadcrumbs - Only visible for Admin role -->
    <nav class="breadcrumbs role-element role-admin-show" aria-label="Breadcrumb">
        <div class="breadcrumb-wrapper">
            @RenderSection("Breadcrumbs", required: false)
        </div>
    </nav>

    <!-- Main content -->
    <main id="main-content" class="main-content">
        <div class="page-container">
            <div class="page-header">
                <h1 class="page-title">@ViewData["Title"]</h1>
                <div class="page-actions">
                    @RenderSection("PageActions", required: false)
                </div>
            </div>
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer id="footer" role="contentinfo">
        <div class="footer-content">
            <div class="disclaimer">
                The certificates in this public database are available for viewing at the consent of the client; not all awarded certificates are made publicly available. Additionally, some previously awarded certificates might not come up in a search of this database but may be valid for products in circulation that were produced during the evaluation period.
                Please contact <a href="mailto:info@greencirclecertified.com">GreenCircle</a> with questions.
            </div>
            <div class="disclaimer">
                &copy; @DateTime.Now.Year GreenCircle Certified. All rights reserved.
            </div>
        </div>
    </footer>


    <!-- JavaScript -->
    <!-- jQuery (required for validation) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap 5 Bundle (includes Popper for modals, tooltips, etc.) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/admin/admin-core.js"></script>
    <script src="~/js/accessibility-enhancements.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>