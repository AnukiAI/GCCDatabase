@model List<GCCWebApp.Models.CertificateProductId>

@{
    var certificateId = ViewData["CertificateId"] as int? ?? 0;
    var isReadOnly = ViewData["IsReadOnly"] as bool? ?? false;
}

<div class="product-id-manager" data-certificate-id="@certificateId">
    <div class="product-manager-header">
        <h3 class="product-manager-title">
            <i class="fas fa-barcode me-2"></i>
            Product ID Manager
        </h3>

        @if (!isReadOnly)
        {
            <div class="product-manager-actions">
                <div class="btn-group me-2" role="group">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="downloadSample" title="Download CSV template for bulk import">
                        <i class="fas fa-file-download me-1"></i>Template
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="importProductIds">
                        <i class="fas fa-download me-1"></i>Import
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="exportProductIds">
                        <i class="fas fa-upload me-1"></i>Export
                    </button>
                </div>

                @* DEF-194: Bulk delete via row checkboxes + select-all. Hidden until at least one row is selected. *@
                <button type="button" class="btn btn-danger btn-sm me-2" id="bulkDeleteProductIds" style="display: none;"
                        title="Delete all selected product IDs">
                    <i class="fas fa-trash me-1"></i>Delete Selected (<span id="bulkDeleteCount">0</span>)
                </button>

                <button type="button" class="btn btn-primary btn-sm" id="addProductId">
                    <i class="fas fa-plus me-1"></i>Add Product ID
                </button>
            </div>
        }
    </div>

    @* DEF-194 cross-page: Gmail-style banner. Shown after the user ticks the
       header select-all (i.e. every visible row is selected). Click the link
       to flip into "select all N matching" mode — the bulk-delete then hits
       the bulk endpoint with deleteAll=true + current filter chips. *@
    @if (!isReadOnly)
    {
        <div id="bulkSelectAllBanner" class="bulk-select-all-banner" style="display: none;" role="status" aria-live="polite">
            <span id="bulkSelectAllBannerText">All <span id="bulkBannerVisibleCount">0</span> on this page are selected.</span>
            <button type="button" class="bulk-select-all-link" id="bulkSelectAllLink">
                Select all <span id="bulkBannerTotalCount">0</span> product IDs
            </button>
            <button type="button" class="bulk-select-all-clear" id="bulkSelectAllClear" style="display: none;">
                Clear selection
            </button>
        </div>
    }

    <!-- Filter Section -->
    <div class="product-manager-filters mb-3">
        <div class="product-manager-filter-row">
            <select class="form-select form-select-sm pid-filter-type" id="filterByType">
                <option value="">All Types</option>
                <option value="ASIN">ASIN</option>
                <option value="UPC">UPC</option>
                <option value="GTIN">GTIN</option>
                <option value="EAN">EAN</option>
                <option value="ISBN">ISBN</option>
                <option value="SKU">SKU</option>
                <option value="MPN">MPN</option>
                <option value="OTHER">Other</option>
            </select>
            @* CR-015: Status filter removed — product ID status follows parent certificate. *@
            <select class="form-select form-select-sm pid-filter-partner" id="filterByPartner">
                <option value="">All Partners</option>
                <option value="Amazon">Amazon</option>
                <option value="Novi">Novi</option>
                <option value="None">None</option>
                <option value="Other">Other</option>
            </select>
            <input type="text" class="form-control form-control-sm pid-filter-search" id="searchProductIds" placeholder="Search">
        </div>
    </div>

    <!-- Product IDs Table -->
    <div class="product-ids-table-container">
        <table class="table table-sm table-hover" id="productIdsTable">
            <thead class="table-light">
                <tr>
                    @* DEF-194: Select-all checkbox for bulk delete. Hidden when read-only. *@
                    @if (!isReadOnly)
                    {
                        <th style="width: 40px; text-align: center;">
                            <input type="checkbox" id="selectAllProductIds" class="bulk-select-all"
                                   aria-label="Select all product IDs on this page" />
                        </th>
                    }
                    @* DEF-150: Sortable headers match Views/Product/Management.cshtml convention.
                       Click toggles asc/desc; ▼ default, ▲ asc, ▼ desc. *@
                    <th data-sort="type" class="admin-table-th--sortable" style="width: 80px;">Type <span class="sort-icon admin-sort-icon">▼</span></th>
                    <th data-sort="value" class="admin-table-th--sortable" style="width: 120px;">Product ID <span class="sort-icon admin-sort-icon">▼</span></th>
                    <th data-sort="name" class="admin-table-th--sortable" style="width: 250px;">Product Name <span class="sort-icon admin-sort-icon">▼</span></th>
                    <th data-sort="sku" class="admin-table-th--sortable" style="width: 100px;">SKU <span class="sort-icon admin-sort-icon">▼</span></th>
                    @* CR-015: Status column removed — product ID status follows parent certificate. *@
                    <th data-sort="partner" class="admin-table-th--sortable" style="width: 100px;">Partner <span class="sort-icon admin-sort-icon">▼</span></th>
                    <th data-sort="created" class="admin-table-th--sortable" style="width: 100px;">Created <span class="sort-icon admin-sort-icon">▼</span></th>
                    <th data-sort="createdBy" class="admin-table-th--sortable" style="width: 100px;">Created By <span class="sort-icon admin-sort-icon">▼</span></th>
                    @if (!isReadOnly)
                    {
                        <th style="width: 70px; text-align: right;">Actions</th>
                    }
                </tr>
            </thead>
            <tbody id="productIdsTableBody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var productId in Model)
                    {
                        <tr data-product-id="@productId.Id">
                            @if (!isReadOnly)
                            {
                                <td style="text-align: center;">
                                    <input type="checkbox" class="bulk-select-checkbox"
                                           data-product-id="@productId.Id"
                                           aria-label="Select product ID @productId.ProductIdValue" />
                                </td>
                            }
                            <td>
                                <span class="product-type-badge product-type-@productId.ProductIdType.ToLower()">
                                    @productId.ProductIdType
                                </span>
                            </td>
                            <td class="product-id-value" title="@productId.ProductIdValue">
                                @productId.ProductIdValue
                            </td>
                            <td class="product-name" title="@productId.ProductName">
                                @(productId.ProductName ?? "-")
                            </td>
                            <td class="product-sku" title="@productId.ProductSku">
                                @(productId.ProductSku ?? "-")
                            </td>
                            @* CR-015: Status cell removed — derived from parent cert. *@
                            <td>
                                @if (!string.IsNullOrEmpty(productId.Partner))
                                {
                                    <span class="partner-badge partner-@productId.Partner.ToLower()">
                                        @productId.Partner
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="created-date" title="@productId.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                                @productId.CreatedAt.ToString("yyyy-MM-dd")
                            </td>
                            <td class="created-by" title="@productId.CreatedByUser?.Username">
                                @(productId.CreatedByUser?.Username ?? "System")
                            </td>
                            @if (!isReadOnly)
                            {
                                <td>
                                    <div class="admin-inline-actions">
                                        <button type="button" class="admin-inline-action-btn admin-inline-action-btn--edit btn-edit-product-id"
                                                data-product-id="@productId.Id"
                                                title="Edit"
                                                aria-label="Edit product ID @productId.ProductIdValue">
                                            <i class="fas fa-edit" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="admin-inline-action-btn admin-inline-action-btn--delete btn-delete-product-id"
                                                data-product-id="@productId.Id"
                                                title="Delete"
                                                aria-label="Delete product ID @productId.ProductIdValue">
                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr id="noProductIdsRow">
                        @* DEF-194: colspan grew by 1 when bulk-select column added for non-readonly. *@
                        <td colspan="@(isReadOnly ? 7 : 9)" class="text-center text-muted py-4">
                            <i class="fas fa-barcode fa-2x mb-2 d-block text-muted"></i>
                            No product IDs added yet.
                            @if (!isReadOnly)
                            {
                                <br><small>Click "Add Product ID" to get started.</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Info -->
    <div class="pagination-info text-end text-muted mt-2" id="paginationInfo">
        @if (Model != null && Model.Any())
        {
            <small>Showing @Model.Count product ID(s)</small>
        }
    </div>
</div>

<!-- Add/Edit Product ID Modal -->
@if (!isReadOnly)
{
    <div class="modal fade" id="productIdModal" tabindex="-1" aria-labelledby="productIdModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productIdModalLabel">Add Product ID</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                    <div class="modal-body" id="productIdForm">
                        <input type="hidden" id="productIdId" name="Id" value="0">
                        <input type="hidden" id="certificateId" name="CertificateId" value="@certificateId">

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="productIdType" class="form-label">Type <span class="text-danger">*</span></label>
                                    <select class="form-select" id="productIdType" name="ProductIdType" required>
                                        <option value="">Select Type</option>
                                        <option value="ASIN">ASIN - Amazon Standard ID</option>
                                        <option value="UPC">UPC - Universal Product Code</option>
                                        <option value="GTIN">GTIN - Global Trade Item Number</option>
                                        <option value="EAN">EAN - European Article Number</option>
                                        <option value="ISBN">ISBN - Book Identifier</option>
                                        <option value="SKU">SKU - Stock Keeping Unit</option>
                                        <option value="MPN">MPN - Manufacturer Part Number</option>
                                        <option value="OTHER">Other</option>
                                    </select>
                                    <div class="form-text" id="typeHelp">Format requirements will be shown here</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="productIdValue" class="form-label">Product ID <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="productIdValue" name="ProductIdValue" required>
                                    <div class="invalid-feedback" id="valueValidation"></div>
                                </div>
                            </div>
                        </div>

                        @* CR-015: Status field removed — auto-derived from parent certificate, not user-controlled. *@
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="productIdPartner" class="form-label">Partner(s) <span class="text-muted" style="font-size: 12px;">(Optional - Multiple)</span></label>
                                    <select class="form-select" id="productIdPartner" name="Partner" multiple size="4" aria-label="Select one or more partners for this product ID">
                                        @if (ViewBag.Partners != null)
                                        {
                                            foreach (var partner in ViewBag.Partners)
                                            {
                                                <option value="@partner.Name">@partner.Name</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="Amazon">Amazon</option>
                                            <option value="Novi">Novi</option>
                                            <option value="Other">Other</option>
                                        }
                                    </select>
                                    <small class="form-text text-muted">CR-171: leave empty to share this product ID with all of the certificate's partners; select one or more to restrict it. Hold Ctrl (Cmd on Mac) for multiple.</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="productName" class="form-label">Product Name</label>
                            <input type="text" class="form-control" id="productName" name="ProductName" placeholder="Optional product name">
                        </div>

                        <div class="mb-3">
                            <label for="productSku" class="form-label">SKU</label>
                            <input type="text" class="form-control" id="productSku" name="ProductSku" placeholder="Optional SKU">
                        </div>

                        <div class="mb-3">
                            <label for="productDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="productDescription" name="Description" rows="2" placeholder="Optional description or notes"></textarea>
                        </div>
                    </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveProductId">Save Product ID</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Import Preview Modal (US-015 Backdrop Standard) -->
    <div id="import-preview-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9997;">
        <!-- Backdrop (sibling) -->
        <div class="import-modal-backdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); z-index: 9998; backdrop-filter: blur(3px);"></div>

        <!-- Modal Container (sibling) -->
        <div class="import-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; width: 95%; max-width: 1200px; max-height: 90vh; background-color: white; border-radius: 8px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column;">
            <div class="admin-modal-header" style="background-color: #f8f9fa; border-bottom: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 8px 8px 0 0;">
                <h3 class="admin-modal-title" style="color: #002B76; font-weight: 600; margin: 0; font-size: 18px;">
                    <i class="fas fa-download" style="margin-right: 8px;"></i> Import Preview - Product IDs
                </h3>
                <button class="admin-modal-close" onclick="productIdManager.closeImportPreviewModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #666; padding: 4px 8px;">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="admin-modal-body" style="background-color: white; padding: 20px; overflow-y: auto; flex: 1;">
                <!-- Summary Stats -->
                <div id="import-summary" class="import-summary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 20px;">
                    <div class="import-stat" style="background: #e8f5e1; padding: 12px; border-radius: 6px; text-align: center;">
                        <div class="import-stat-value" id="stat-new" style="font-size: 24px; font-weight: 600; color: #447638;">0</div>
                        <div class="import-stat-label" style="font-size: 12px; color: #666;">New</div>
                    </div>
                    <div class="import-stat" style="background: #e6f7ff; padding: 12px; border-radius: 6px; text-align: center;">
                        <div class="import-stat-value" id="stat-modified" style="font-size: 24px; font-weight: 600; color: #002B76;">0</div>
                        <div class="import-stat-label" style="font-size: 12px; color: #666;">Modified</div>
                    </div>
                    <div class="import-stat" style="background: #f5f5f5; padding: 12px; border-radius: 6px; text-align: center;">
                        <div class="import-stat-value" id="stat-unchanged" style="font-size: 24px; font-weight: 600; color: #999;">0</div>
                        <div class="import-stat-label" style="font-size: 12px; color: #666;">Unchanged</div>
                    </div>
                    <div class="import-stat" style="background: #ffebee; padding: 12px; border-radius: 6px; text-align: center;">
                        <div class="import-stat-value" id="stat-errors" style="font-size: 24px; font-weight: 600; color: #ff5252;">0</div>
                        <div class="import-stat-label" style="font-size: 12px; color: #666;">Errors</div>
                    </div>
                </div>

                <!-- Preview Table -->
                <div style="overflow-x: auto; max-height: 400px; border: 1px solid #e9ecef; border-radius: 6px;">
                    <table class="table table-sm table-hover mb-0" style="font-size: 14px;">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th style="width: 40px; padding: 10px;">
                                    <input type="checkbox" id="select-all-import" checked onchange="productIdManager.toggleAllImportRows(this.checked)">
                                </th>
                                <th style="padding: 10px;">Status</th>
                                <th style="padding: 10px;">Type</th>
                                <th style="padding: 10px;">Product ID</th>
                                <th style="padding: 10px;">Product Name</th>
                                @* DEF-202 (QC #179): SKU was being imported into the DB
                                   (productSku field is parsed in product-id-manager.js:1266)
                                   but the preview popup didn't show it as a column, so the
                                   client couldn't sanity-check SKU values before confirming. *@
                                <th style="padding: 10px;">SKU</th>
                                <th style="padding: 10px;">Partner</th>
                                <th style="padding: 10px;">Changes / Errors</th>
                            </tr>
                        </thead>
                        <tbody id="import-preview-body">
                            <!-- Preview rows will be inserted here -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-modal-footer" style="background-color: #f8f9fa; border-top: 2px solid #e9ecef; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 0 0 8px 8px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    @* DEF-159: Replace-All toggle styled to be visually obvious. Carly didn't know
                       this control existed; she imported a 1-row file and got confused when 2 prior
                       IDs stayed. The pill-shaped highlight + explicit label + tooltip make the two
                       import modes (append vs replace-all) discoverable from the modal footer. *@
                    <label id="overwrite-existing-label"
                           style="display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; cursor: pointer; margin: 0; padding: 6px 12px; border: 1px solid #f0ad4e; background: #fff8e6; border-radius: 16px; color: #8a5a00;"
                           title="When checked: this import file is the new full list. Existing Product IDs not in the file will be deactivated. When unchecked (default): rows in the file are added or updated; nothing is deactivated.">
                        <input type="checkbox" id="overwrite-existing-toggle" style="margin: 0;">
                        <i class="fas fa-exchange-alt" aria-hidden="true" style="font-size: 12px;"></i>
                        <span>Replace all existing IDs with this file</span>
                    </label>
                </div>
                <div>
                    <button type="button" class="btn btn-secondary me-2" onclick="productIdManager.closeImportPreviewModal()">Cancel</button>
                    <button type="button" class="btn btn-primary" id="apply-import-btn" onclick="productIdManager.applyImport()">
                        <i class="fas fa-check me-1"></i> Apply Import
                    </button>
                </div>
            </div>
        </div>
    </div>
}