@{
    var isAdmin = ViewBag.UserRole == "Admin";
    var isAnalyst = ViewBag.UserRole == "Analyst" || isAdmin;
}

<div class="review-instructions-container" id="reviewInstructions">
    <div class="instructions-header">
        <h3><i class="fas fa-clipboard-check"></i> Review Instructions</h3>
        <button class="btn btn-outline btn-sm toggle-instructions" onclick="toggleInstructions()">
            <i class="fas fa-chevron-down"></i> Toggle
        </button>
    </div>

    <div class="instructions-content" id="instructionsContent">
        <!-- Requirements Review Section -->
        <div class="review-section">
            <div class="section-header">
                <span class="check-icon">✅</span>
                <h4>REQUIREMENTS REVIEW</h4>
            </div>
            <p><strong>Purpose:</strong> Ensure all system capabilities and business needs are accounted for and traceable to wireframes or user stories.</p>

            <div class="steps-container">
                <h5>Steps:</h5>
                <ol>
                    <li>Cross-reference requirements in the GCC Database Field Requirements with wireframes (Certificate List, Add Certificate, Product Management).</li>
                    <li>Validate against user stories for each user role (Public, External Client/Partner, Analyst, Admin).</li>
                    <li>
                        Confirm completeness:
                        <ul>
                            <li>Each required field and CRUD permission is documented</li>
                            <li>All roles and access types are covered with appropriate filtering/sorting</li>
                            <li>Out-of-scope items (notifications, bulk upload for ASINs) are clearly excluded</li>
                        </ul>
                    </li>
                    <li>
                        Mark discrepancies for escalation:
                        <ul>
                            <li>Fields shown in designs but not documented in requirements</li>
                            <li>Missing validations or conditional rules (e.g., Partner = required for certain certs)</li>
                        </ul>
                    </li>
                </ol>
            </div>
        </div>

        <!-- Comment Review Section -->
        <div class="review-section">
            <div class="section-header">
                <span class="comment-icon">💬</span>
                <h4>COMMENT REVIEW</h4>
            </div>
            <p><strong>Purpose:</strong> Capture, prioritize, and clarify stakeholder feedback from UI Design Options and Requirements discussions.</p>

            <div class="steps-container">
                <h5>Steps:</h5>
                <ol>
                    <li>Review all global and screen-specific comments from UI Design Options discussions.</li>
                    <li>
                        Categorize comments:
                        <div class="category-tags">
                            <span class="tag design-fix">✅ Design Fix</span>
                            <span class="tag functional-req">📋 Functional Requirement</span>
                            <span class="tag content-correction">🛠️ Content Correction</span>
                            <span class="tag usability-concern">⚠️ Usability Concern</span>
                        </div>
                    </li>
                    <li>Flag repeated or critical issues (e.g., CSF being listed twice, inconsistent dropdown order).</li>
                </ol>
            </div>
        </div>

        <!-- Screen Review Section -->
        <div class="review-section">
            <div class="section-header">
                <span class="screen-icon">📱</span>
                <h4>SCREEN REVIEW</h4>
            </div>
            <p><strong>Purpose:</strong> Validate wireframe screens for UX/UI consistency, ADA compliance, and functional alignment.</p>

            <div class="screen-sections">
                <h5>Review Screens:</h5>
                <ul>
                    <li>1.x – Public Certificate Views</li>
                    <li>2.x – Dashboard (Admin/Analyst)</li>
                    <li>3.x – External Certificate Views</li>
                    <li>3.3 – Add/Edit Certificate</li>
                    <li>5.x – Company/Product Management</li>
                    <li>7.x – Admin/User Management</li>
                </ul>
            </div>
        </div>

        @if (isAnalyst)
        {
            <!-- Feedback Template Section -->
            <div class="review-section">
                <div class="section-header">
                    <span class="template-icon">🧩</span>
                    <h4>CONSOLIDATED FEEDBACK TEMPLATE</h4>
                </div>
                <div class="feedback-table-container">
                    <table class="feedback-template-table">
                        <thead>
                            <tr>
                                <th>Item Type</th>
                                <th>Page</th>
                                <th>Comment</th>
                                <th>Status</th>
                                <th>Owner</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="example-row">
                                <td><span class="tag design-fix">Design Fix</span></td>
                                <td>Cert List Public</td>
                                <td>Fix alignment of cards</td>
                                <td><span class="status in-progress">In Progress</span></td>
                                <td>UI Team</td>
                                <td>Based on Option 4</td>
                            </tr>
                            <tr class="example-row">
                                <td><span class="tag functional-req">Requirement</span></td>
                                <td>Add Certificate</td>
                                <td>Missing field: Partner (Amazon/Wayfair)</td>
                                <td><span class="status resolved">Resolved</span></td>
                                <td>Dev</td>
                                <td>Now mandatory</td>
                            </tr>
                            <tr class="example-row">
                                <td><span class="tag usability-concern">Usability</span></td>
                                <td>Global</td>
                                <td>Font &lt; 12pt on mobile</td>
                                <td><span class="status open">Open</span></td>
                                <td>UI/QA</td>
                                <td>Confirm during device testing</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>