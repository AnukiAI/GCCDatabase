{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_PRODUCTION_CONNECTION_STRING",
    "SqlServerConnection": "Server=your-sql-server;Database=GCCDatabase;User Id=gccuser;Password=REPLACE_PASSWORD;TrustServerCertificate=true;Encrypt=true",
    "MySQLConnection": "Server=localhost;Database=gccdb;User=gccuser;Password=REPLACE_PASSWORD;",
    "SqliteConnection": "Data Source=gcc_database.db"
  },

  "DatabaseProvider": "SqlServer",

  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_SECURE_64_CHAR_JWT_SECRET_KEY_FOR_PRODUCTION_USE_ONLY",
    "Issuer": "https://yourdomain.com",
    "Audience": "https://yourdomain.com",
    "ExpirationMinutes": 60
  },

  "ApiSettings": {
    "BaseUrl": "https://yourdomain.com/api",
    "EnableSwagger": false,
    "RateLimitRequests": 1000,
    "RateLimitPeriodMinutes": 60
  },

  "Security": {
    "RequireHttps": true,
    "EnableCors": true,
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://www.yourdomain.com"
    ],
    "EnableApiKeyAuthentication": true,
    "EnableJwtAuthentication": true
  },

  "Features": {
    "EnableAzureAdB2C": false,
    "EnableEmailNotifications": false,
    "EnableTwoFactorAuth": false,
    "EnableDataExport": true,
    "EnableBulkOperations": true,
    "EnableAuditLogging": true
  },

  "AzureAdB2C": {
    "Instance": "https://your-tenant.b2clogin.com/",
    "Domain": "your-tenant.onmicrosoft.com",
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "ClientSecret": "REPLACE_WITH_CLIENT_SECRET",
    "SignUpSignInPolicyId": "B2C_1_signupsignin",
    "CallbackPath": "/signin-oidc"
  },

  "Email": {
    "SmtpHost": "smtp.yourmailserver.com",
    "SmtpPort": 587,
    "SmtpUser": "noreply@yourdomain.com",
    "SmtpPassword": "REPLACE_WITH_SMTP_PASSWORD",
    "EnableSsl": true,
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "GCC Web App"
  },

  "Application": {
    "Name": "GCC Web Application",
    "Version": "1.0.0",
    "Environment": "Production",
    "SiteName": "Green Circle Certified",
    "SiteUrl": "https://yourdomain.com",
    "SupportEmail": "support@yourdomain.com"
  },

  "Caching": {
    "DefaultExpirationMinutes": 30,
    "EnableResponseCaching": true,
    "EnableMemoryCache": true,
    "EnableDistributedCache": false
  },

  "FileStorage": {
    "MaxFileSize": 10485760,
    "AllowedExtensions": [".pdf", ".jpg", ".jpeg", ".png", ".csv", ".xlsx"],
    "StoragePath": "/app/uploads",
    "EnableCloudStorage": false
  },

  "Monitoring": {
    "EnableApplicationInsights": false,
    "InstrumentationKey": "REPLACE_WITH_APP_INSIGHTS_KEY",
    "EnableHealthChecks": true,
    "HealthCheckPath": "/health"
  },

  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "RequestHeadersTimeout": "00:00:30",
      "MaxRequestBodySize": 10485760
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/gccwebapp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}