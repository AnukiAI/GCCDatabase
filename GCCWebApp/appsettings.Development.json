{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5101"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "EnableTestMode": true,
    "Enable2FA": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=ANUKI01;Database=GCCDatabase_Dev;User Id=GCC_DevUser;Password=DevP@ss2024!SQL;MultipleActiveResultSets=true;TrustServerCertificate=true;Encrypt=false"
  },
  "Jwt": {
    "Key": "ThisIsAVeryLongSecretKeyForJwtTokenGenerationAtLeast64CharactersLong123456789",
    "Issuer": "GCCWebApp",
    "Audience": "GCCWebApp",
    "ExpiryMinutes": 60
  },
  "Features": {
    "TwoFactorAuthentication": true,
    "RequireEmailConfirmation": false,
    "AllowGuestAccess": true
  },
  "FileStorage": {
    // DEF-286: uploads root (the folder that directly contains certificates/ and images/).
    // Moved OUT of the repo 2026-08-13. App_Data/uploads sits inside the OneDrive-synced
    // project folder, and once the migration PDFs landed there (~4 GB) OneDrive sync churn
    // coincided with the link job stalling mid-run with a live process and no progress.
    // Uploads are not source code and must not be synced, backed up by OneDrive, or swept
    // into a publish. Same convention as appsettings.Production.template.json.
    "StoragePath": "C:\\GCCData\\uploads"
  },
  "Jobs": {
    "CertificateExpiration": {
      "IntervalMinutes": 1,
      "StartupDelaySeconds": 5
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s", 
        "Limit": 1000
      }
    ]
  }
}
