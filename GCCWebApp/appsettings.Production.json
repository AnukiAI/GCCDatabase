{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "GCCWebApp": "Information",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.AspNetCore.Authorization": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "Microsoft.EntityFrameworkCore.Query": "Error",
      "GCCWebApp.Services.ETL": "Warning"
    },
    "Console": {
      "IncludeScopes": false
    },
    "EventLog": {
      "LogLevel": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  
  // PRODUCTION SECURITY SETTINGS
  // AccuWeb SQL Server Configuration
  // Update these values in your hosting control panel or use environment variables
  "ConnectionStrings": {
    "DefaultConnection": "Server={SQL_SERVER_HOST};Database={DATABASE_NAME};User Id={DATABASE_USER};Password={DATABASE_PASSWORD};Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true;",
    "PostgresConnection": "Host={POSTGRES_HOST};Port=5432;Database={DATABASE_NAME};Username={DATABASE_USER};Password={DATABASE_PASSWORD};SSL Mode=Require;",
    "SqliteConnection": "Data Source=gcc_database.db"
  },

  // Database provider will be auto-detected from connection string
  // For SQL Server, ensure connection string contains "Server=" and doesn't contain "Host=" or ".db"
  "DatabaseProvider": "sqlserver",
  
  "Jwt": {
    "Key": "E4wgkFxDMrAcrkfKZXzfNrNEo6xkdJj/N4jAyEyNbq9P/Ji4wtOsI+ReuIWGgHhhgkgkpJ+/EVRrVC5iOFhZIA==",
    "Issuer": "GCCWebApp-Production",
    "Audience": "GCCWebApp-Production",
    "ExpiryMinutes": 60
  },
  
  "Authentication": {
    "Enable2FA": true,
    "EnableTestMode": false,
    "RequireEmailConfirmation": false
  },
  
  "SmtpSettings": {
    "Host": "",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "GCC Database System"
  },
  
  "AzureAdB2C": {
    "Instance": "{AZURE_AD_B2C_INSTANCE}",
    "ClientId": "{AZURE_AD_B2C_CLIENT_ID}",
    "ClientSecret": "{AZURE_AD_B2C_CLIENT_SECRET}",
    "Domain": "{AZURE_AD_B2C_DOMAIN}",
    "TenantId": "{AZURE_AD_B2C_TENANT_ID}",
    "SignUpSignInPolicyId": "{SIGNUP_SIGNIN_POLICY}",
    "ResetPasswordPolicyId": "{RESET_PASSWORD_POLICY}",
    "EditProfilePolicyId": "{EDIT_PROFILE_POLICY}",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  
  // PRODUCTION CORS - Update with your actual production domain
  "AllowedOrigins": [
    "https://greencirclecertified.com",
    "https://www.greencirclecertified.com"
  ],
  
  // PRODUCTION RATE LIMITING - MORE RESTRICTIVE
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": true,
    "RealIpHeader": "X-Forwarded-For",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{ \"message\": \"Rate limit exceeded. Please try again later.\", \"details\": \"Too many requests from {0}\" }}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1h",
        "Limit": 1000
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1d",
        "Limit": 5000
      },
      {
        "Endpoint": "*/api/*/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*/api/*/auth/login",
        "Period": "1h",
        "Limit": 20
      }
    ]
  },
  
  "IpRateLimitPolicies": {
    "IpRules": []
  },
  
  // PRODUCTION PASSWORD POLICY
  "PasswordPolicy": {
    "MinLength": 14,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigits": true,
    "RequireSpecialCharacters": true,
    "MaxPasswordHistory": 10,
    "PasswordExpirationDays": 90,
    "AccountLockoutThreshold": 3,
    "AccountLockoutDurationMinutes": 30,
    "RequireTwoFactor": true
  },
  
  // PRODUCTION TLS/SSL SETTINGS
  "Certificates": {
    "Default": {
      "Source": "Store",
      "StoreLocation": "CurrentUser",
      "StoreName": "My",
      "Subject": "{PRODUCTION_CERTIFICATE_SUBJECT}"
    }
  },
  
  // PRODUCTION SECURITY MONITORING
  "SecurityMonitoring": {
    "EnableSecurityEventLogging": true,
    "EnableFailedLoginTracking": true,
    "EnableSuspiciousActivityDetection": true,
    "AlertThresholds": {
      "FailedLoginsPerMinute": 10,
      "SuspiciousIpDetectionEnabled": true,
      "UnusualUserAgentDetection": true
    }
  },
  
  // PRODUCTION DATA PROTECTION
  "DataProtection": {
    "ApplicationName": "GCC-Production",
    "KeyLifetime": "90.00:00:00",
    "PersistKeysToAzureBlobStorage": true,
    "AzureBlobStorageConnectionString": "{AZURE_BLOB_CONNECTION_STRING}",
    "AzureBlobStorageContainerName": "gcc-dataprotection-keys"
  },
  
  // PRODUCTION FEATURE FLAGS
  "FeatureFlags": {
    "EnableDetailedErrorMessages": false,
    "EnableDebugEndpoints": false,
    "EnableSwagger": false,
    "EnableDeveloperExceptionPage": false,
    "RequireHttpsForAllRequests": true,
    "EnableSecurityHeaders": true,
    "EnableCorsRestrictions": true
  }
}