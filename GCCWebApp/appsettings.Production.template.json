{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "GCCWebApp": "Information",
      "Program": "Information",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.AspNetCore.Authorization": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "Microsoft.EntityFrameworkCore.Query": "Error",
      "GCCWebApp.Services.ETL": "Warning"
    },
    "Console": {
      "IncludeScopes": false
    },
    "EventLog": {
      "LogLevel": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  // NOTE: "FeatureFlags" used to appear TWICE in this file (here and again at the bottom).
  // Both blocks were live — the JSON config provider flattens to leaf paths, so the two
  // objects merged rather than one replacing the other. That only held because their leaf
  // names happened not to collide: the provider throws FormatException("A duplicate key ...
  // was found") on a repeated leaf path, which at startup is an HTTP 500.30 with no page.
  // The two blocks are now merged into the single "FeatureFlags" section at the bottom.

  // Background jobs.
  // CertificateExpiration sweep: runs daily at 00:00 UTC by default (omit IntervalMinutes to use
  // the midnight schedule). Save-time enforcement in CertificateService.UpdateCertificateAsync
  // catches manual edits at the moment they happen; this BG sweep only needs to catch certs that
  // naturally age past their expiration date without anyone touching them — a date-granular event,
  // so a date-aligned sweep is the right cadence.
  // To force a fixed interval for verification, set IntervalMinutes to a positive integer.
  "Jobs": {
    "CertificateExpiration": {
      "StartupDelaySeconds": 30
    }
  },

  // Test environment access gate.
  // NOTE: Current "Production" env IS the test deployment (gccwebapp.com) running
  // against the prod DB. When the real production host goes live
  // (database.greencirclecertified.com), set Enabled=false and ShowBanner=false
  // on that environment's config. Partner API (/api/*) always bypasses the gate.
  //
  // The production host is a DEDICATED SUBDOMAIN, decided 2026-08-14. The earlier
  // path-based address (greencirclecertified.com/database) was published in the
  // Amazon developer guide v1.0-v1.1 but NEVER ACTIVATED, and is retired: the app
  // is not path-mounted (no UsePathBase anywhere), so it could not have served that
  // address without a code change. Do not reinstate it.
  "TestEnvironmentGate": {
    "Enabled": true,
    "Mode": "Cookie",
    "ShowBanner": true,
    "Username": "gcc",
    // NOTE: changing this value requires an app-pool recycle. TestEnvironmentGateMiddleware
    // binds its options once in the constructor and is registered as a singleton, so a config
    // edit alone has no effect until the process restarts.
    "Password": "<REQUEST: from project owner>",
    "Realm": "GCC Test Environment",
    "CookieDays": 7
  },

  // PRODUCTION SECURITY SETTINGS
  // AccuWeb SQL Server Configuration
  "ConnectionStrings": {
    "DefaultConnection": "Server=<db-host>;Database=<db-name>;User Id=<db-user>;Password=<REQUEST: from project owner>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    "PostgresConnection": "Host=<db-host>;Port=5432;Database=<db-name>;Username=<db-user>;Password=<REQUEST: from project owner>;SSL Mode=Require;",
    "SqliteConnection": "<REPLACE>"
  },

  // Database provider will be auto-detected from connection string
  // For SQL Server, ensure connection string contains "Server=tcp:" to match Program.cs detection
  "DatabaseProvider": "SqlServer",

  // Apply pending EF migrations automatically on startup (DEF-252 / recurrence of DEF-239).
  // gccwebapp.com is a single-tenant pre-launch TEST env — auto-migrate keeps the schema in
  // lock-step with deployed code so a forgotten Gate-7 SQL run can't cause another login
  // outage. For a true production cutover with manual DBA-controlled migrations, set false.
  // NOT the whole "Database" section. Config merges by LEAF path, so
  // Database:CommandTimeoutSeconds = 120 is inherited from appsettings.json (the DEF-360 fix
  // for the 30s export timeout) and is live here even though it is not repeated below.
  // Deliberately not duplicated — two copies of a timeout drift apart. Verify with the base
  // file before concluding a timeout value is unset.
  "Database": {
    // Set FALSE for the 2026-09-02 deploy (Shawn's call). gccwebapp.com has NO separate database
    // — it runs against the real production data (<db-host> / <db-name>, see the filled-in copy),
    // so leaving this true would have auto-applied the CR-037 migration, unattended, on the first
    // request after deploy: CreateTable CertificateCountries plus an INSERT...SELECT backfill over
    // every certificate row. Schema and data changes on that database are applied deliberately,
    // after a backup, not as a side effect of an app-pool start.
    //
    // ORDER MATTERS. The new code REQUIRES the new table — CertificateRepository
    // .WithSingleViewIncludes has .Include(c => c.Countries), so a deploy that lands before the
    // migration breaks every certificate detail page with "Invalid object name
    // 'CertificateCountries'". Run the migration script FIRST, then deploy the code. Adding a
    // table does not disturb the currently-deployed build, so migration-first is the safe order.
    //
    // Turning it back to true is a decision, not a cleanup: it re-arms unattended schema changes
    // against production data.
    "AutoMigrateOnStartup": false
  },

  // UPLOAD STORAGE — currently UNSET, so uploads default to
  // <app root>\App_Data\uploads\{certificates,images,import-backups} (UploadPathResolver.cs:99),
  // i.e. INSIDE the deploy folder. Deploy bundles exclude App_Data so a normal extract cannot
  // delete them, but a manual "delete everything" wipe of the app root takes the PDFs with it —
  // which is exactly what happened on 2026-08-17 (23 certificate PDFs lost, no local copy).
  //
  // Setting an absolute path OUTSIDE the app root fixes that permanently, and is SAFE for
  // existing files: TryResolveExisting (UploadPathResolver.cs:158-166) falls back to App_Data
  // and then to the legacy wwwroot location, so anything already stored stays readable and only
  // NEW writes land in the new root.
  //
  // The server's real content root, from the 2026-08-18 startup log, is
  // D:\Inetpub\vhosts\gccwebapp.com\httpdocs — so a relative value here would resolve against
  // that. The intended end state is "..\gcc-uploads", a sibling of httpdocs.
  //
  // STILL UNSET (DEF-363, 2026-08-18).
  // "..\gcc-uploads" would move uploads out of the deploy folder -- still the right end
  // state, and the reason a directory wipe destroyed 23 certificate PDFs. But it needs the
  // SAME vhost-root write permission that KeyPath proved the app pool does not have. Unlike
  // KeyPath this cannot crash startup (UploadPathResolver try/catches its own creation) --
  // it would fail silently at upload time instead, which is worse to diagnose.
  // Unset = <app root>\App_Data\uploads, matching the known-good 2026-08-04 bundle.
  // Re-enable once the permission is confirmed; existing files stay readable either way via
  // the App_Data / legacy wwwroot fallbacks in TryResolveExisting.

  "Jwt": {
    "Key": "<GENERATE: openssl rand -base64 64>",
    "Issuer": "GCCWebApp-Production",
    "Audience": "GCCWebApp-Production",
    "ExpiryMinutes": 60
  },
  
  "_Authentication_note": "DEF-365. Enable2FA is a MASTER SWITCH, not a per-user setting. Since 2026-08-19 a challenge additionally requires User.TwoFactorEnabled on the individual account (AccountController.Resolve2FARequirementAsync), so turning this on affects only accounts that have opted in - it was flipped to true once that per-user check existed. BEFORE this fix the flag was the ONLY condition, so setting it true would have forced 2FA onto every account at once, including accounts with no enrolment and therefore no way to pass the challenge. If this is ever set back to false, note that it silently disables 2FA for users who believe theirs is on: the toggle in their profile keeps showing enabled.",
  "Authentication": {
    "Enable2FA": true,
    "EnableTestMode": false,
    "RequireEmailConfirmation": false
  },
  
  "_SmtpSettings_note": "DEF-263. Host MUST be accumail3.accuwebhosting.com, NOT mail.gccwebapp.com - both resolve to 72.18.135.96, but the server's TLS certificate (DigiCert, CN=accumail3.accuwebhosting.com) does not cover the mail.gccwebapp.com name, so MailKit rejects that host on certificate validation before authentication is even attempted. Port 465 with Security=SslOnConnect is likewise required, not a preference: port 587 advertises no STARTTLS and answers an explicit STARTTLS with '503 TLS is not allowed'. Username and Password are deliberately left empty here and supplied in appsettings.Secrets.json on the server, which is excluded from the deploy zip and from git - see appsettings.Secrets.template.json. Empty credentials make Program.cs fall back to MockEmailService, which logs and delivers nothing, so a missing overlay fails closed and silently: after any deploy read the 'Email:' banner in logs/stdout and send a real password reset (Gate 12).",
  "SmtpSettings": {
    "Host": "accumail3.accuwebhosting.com",
    "Port": "465",
    "Security": "SslOnConnect",
    "EnableSsl": "true",
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@db.greencirclecertified.com",
    "FromName": "GCC Database System"
  },
  
  "AzureAdB2C": {
    "Instance": "{AZURE_AD_B2C_INSTANCE}",
    "ClientId": "{AZURE_AD_B2C_CLIENT_ID}",
    "ClientSecret": "<AZURE: App registrations -> Certificates & secrets>",
    "Domain": "{AZURE_AD_B2C_DOMAIN}",
    "TenantId": "{AZURE_AD_B2C_TENANT_ID}",
    "SignUpSignInPolicyId": "{SIGNUP_SIGNIN_POLICY}",
    "ResetPasswordPolicyId": "{RESET_PASSWORD_POLICY}",
    "EditProfilePolicyId": "{EDIT_PROFILE_POLICY}",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  
  // PRODUCTION CORS - read by Program.cs:473 (top-level "AllowedOrigins", NOT
  // Security:AllowedOrigins, which nothing reads). These are the origins of PAGES
  // allowed to call this app from a browser - not the hosts this app runs on.
  //
  // database.greencirclecertified.com added 2026-08-24. It is DEFENSIVE, not required:
  // the app serves its own UI and its own /api from one host, so the UI's calls are
  // same-origin and never consult this list; and partners call server-to-server with
  // X-API-Key, which sends no Origin header, so CORS does not apply to them either.
  // It only starts mattering if the UI and API are ever split across hosts.
  //
  // The entry that DOES do work is greencirclecertified.com (+www) - the marketing
  // website, a different server. Keep those so pages there can call the API.
  "AllowedOrigins": [
    "https://database.greencirclecertified.com",
    "https://gccwebapp.com",
    "https://www.gccwebapp.com",
    "https://greencirclecertified.com",
    "https://www.greencirclecertified.com"
  ],
  
  // PRODUCTION RATE LIMITING - MORE RESTRICTIVE
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": true,
    "RealIpHeader": "X-Forwarded-For",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{ \"message\": \"Rate limit exceeded. Please try again later.\", \"details\": \"Too many requests from {0}\" }}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1h",
        "Limit": 1000
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1d",
        "Limit": 5000
      },
      {
        "Endpoint": "*/api/*/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*/api/*/auth/login",
        "Period": "1h",
        "Limit": 20
      }
    ]
  },
  
  "IpRateLimitPolicies": {
    "IpRules": []
  },
  
  // PRODUCTION PASSWORD POLICY
  // WARNING — this section is NOT read by the login path. AccountController.cs:1044 hardcodes
  // `MaxFailedLoginAttempts = 5`, so the real lockout threshold is 5, not the 3 below, and
  // AccountLockoutDurationMinutes is likewise ignored in favour of the hardcoded duration.
  // Left as-is rather than silently "corrected": changing these numbers changes nothing at
  // runtime, and editing the constant is a code change that needs its own defect. Treat the
  // values below as documentation of intent, not as live configuration.
  "PasswordPolicy": {
    "MinLength": 14,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigits": true,
    "RequireSpecialCharacters": true,
    "MaxPasswordHistory": 10,
    "PasswordExpirationDays": 90,
    "AccountLockoutThreshold": 3,
    "AccountLockoutDurationMinutes": 30,
    "RequireTwoFactor": false
  },
  
  // PRODUCTION TLS/SSL SETTINGS
  "Certificates": {
    "Default": {
      "Source": "Store",
      "StoreLocation": "CurrentUser",
      "StoreName": "My",
      "Subject": "{PRODUCTION_CERTIFICATE_SUBJECT}"
    }
  },
  
  // PRODUCTION SECURITY MONITORING
  "SecurityMonitoring": {
    "EnableSecurityEventLogging": true,
    "EnableFailedLoginTracking": true,
    "EnableSuspiciousActivityDetection": true,
    "AlertThresholds": {
      "FailedLoginsPerMinute": 10,
      "SuspiciousIpDetectionEnabled": true,
      "UnusualUserAgentDetection": true
    }
  },
  
  // PRODUCTION DATA PROTECTION
  //
  // READ THIS BEFORE CHANGING ANYTHING HERE. AddDataProtection() is called TWICE and the second
  // call wins, so which of these keys is live is not what it looks like:
  //   1. Program.cs:100                                (registers first)
  //   2. Program.cs:487 -> SecurityServicesExtensions.cs:72  (registers LAST, therefore wins)
  //
  //   "KeyPath"                        LIVE as of DEF-395 (2026-09-02). See below.
  //   "ApplicationName"                LIVE - pins the key-ring discriminator.
  //                                    DO NOT change or remove it: every existing auth cookie
  //                                    becomes undecryptable at once and every user is signed out.
  //   "KeyLifetime"                    LIVE - read at SecurityServicesExtensions.cs:77.
  //                                    (Currently 90 days, identical to the Program.cs default,
  //                                    so it has no visible effect today - but it IS read.)
  //   "PersistKeysToAzureBlobStorage"  LIVE - false today; setting it true with a valid
  //   "AzureBlobStorageConnectionString"     connection string genuinely moves the key ring to
  //   "AzureBlobStorageContainerName"        blob storage. Not inert. Treat as a real switch.
  //
  // Never copy key files here from another machine: they are stored UNENCRYPTED and anyone
  // holding them can forge an auth cookie for any user. See DEF-361.
  "DataProtection": {
    // ------------------------------------------------------------------------------------
    // "KeyPath" IS LIVE AGAIN AS OF DEF-395 (2026-09-02). Read this before setting it.
    // ------------------------------------------------------------------------------------
    // HISTORY, because the wrong lesson is easy to draw here. Until 2026-09-02 this setting did
    // NOTHING: SecurityServicesExtensions re-registered a hardcoded <content root>\DataProtectionKeys
    // AFTER Program.cs had resolved KeyPath, so the keys always landed in the in-folder default
    // while the startup line claimed otherwise. Program.cs also called Directory.CreateDirectory()
    // on the configured path with no try/catch, so setting KeyPath could only ever crash startup
    // (HTTP 500.30, the 2026-08-18 outage) and never move anything. DEF-395 removed the override
    // and guarded the directory creation.
    //
    // It is therefore now SAFE to set, and it does what it says:
    //   * an un-writable path no longer takes the site down. It logs a loud "ERROR:
    //     DataProtection:KeyPath ... is not usable" and falls back to <app root>\DataProtectionKeys.
    //   * a relative value resolves against the content root, so "..\DataProtectionKeys" lands
    //     beside the app folder rather than inside the directory IIS watches.
    //
    // Still UNSET here deliberately: unset = the in-folder default = the known-good behaviour the
    // 2026-08-04 bundle shipped, and moving a live key ring signs every user out. Set it only as a
    // planned change, after granting the app-pool identity write access to the target.
    //
    // VERIFY BY WHERE THE key-*.xml FILE LANDS, never by the startup line alone. The two agree
    // again as of DEF-395, but the file on disk is the only thing that cannot lie.
    "ApplicationName": "GCC-Production",
    "KeyLifetime": "90.00:00:00",
    "PersistKeysToAzureBlobStorage": false,
    "AzureBlobStorageConnectionString": "",
    "AzureBlobStorageContainerName": "gcc-dataprotection-keys"
  },
  
  // PRODUCTION FEATURE FLAGS — single merged section (see note near the top of this file).
  "FeatureFlags": {
    // Was in the now-removed duplicate block. Read by CertificateTilesApiController.cs:36 and
    // ProductController.cs:28 (both default false) and returns exception detail in API error
    // bodies. TRUE here for test-environment debugging, which is deliberate but sits oddly
    // beside EnableDetailedErrorMessages=false below — flip to false when the site stops
    // being a debugging target.
    "ShowDetailedApiErrors": true,
    "EnableDetailedErrorMessages": false,
    "EnableDebugEndpoints": false,
    "EnableSwagger": false,
    "EnableDeveloperExceptionPage": false,
    "RequireHttpsForAllRequests": true,
    "EnableSecurityHeaders": true,
    "EnableCorsRestrictions": true
  }
}
