{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "GCCWebApp": "Information",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.AspNetCore.Authorization": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning",
      "GCCWebApp.Services.ETL": "Information"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",

  // STAGING CONFIGURATION - MIRRORS PRODUCTION WITH RELAXED SETTINGS FOR TESTING
  // Using SQL Server (NOT Azure SQL Database)
  "ConnectionStrings": {
    "DefaultConnection": "Server=<db-host>;Database=<db-name>;User Id=<db-user>;Password=<REQUEST: from project owner>;MultipleActiveResultSets=true;TrustServerCertificate=true;Encrypt=true;",
    "SqliteConnection": "<REPLACE>"
  },

  "DatabaseProvider": "SqlServer",

  "Jwt": {
    "Key": "<GENERATE: openssl rand -base64 64>",
    "Issuer": "GCCWebApp-Staging",
    "Audience": "GCCWebApp-Staging",
    "ExpiryMinutes": 30
  },

  "Authentication": {
    "Enable2FA": true,
    "EnableTestMode": false,
    "RequireEmailConfirmation": false
  },

  "SmtpSettings": {
    "Host": "{STAGING_SMTP_HOST}",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "{STAGING_SMTP_USERNAME}",
    "Password": "<REQUEST: from project owner>",
    "FromEmail": "staging-noreply@{STAGING_DOMAIN}",
    "FromName": "GCC Database System - Staging"
  },

  "AzureAdB2C": {
    "Instance": "https://{STAGING_TENANT_NAME}.b2clogin.com/",
    "ClientId": "{STAGING_AZURE_AD_B2C_CLIENT_ID}",
    "ClientSecret": "<AZURE: App registrations -> Certificates & secrets>",
    "Domain": "{STAGING_TENANT_NAME}.onmicrosoft.com",
    "TenantId": "{STAGING_AZURE_AD_B2C_TENANT_ID}",
    "SignUpSignInPolicyId": "B2C_1_SignUpSignIn",
    "ResetPasswordPolicyId": "B2C_1_PasswordReset",
    "EditProfilePolicyId": "B2C_1_ProfileEdit",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  // STAGING CORS - ALLOW STAGING DOMAINS AND TESTING ORIGINS
  "AllowedOrigins": [
    "https://gcc-staging.azurewebsites.net",
    "https://gcc-staging.{STAGING_DOMAIN}.com",
    "https://test.{STAGING_DOMAIN}.com",
    "https://api-staging.{STAGING_DOMAIN}.com"
  ],

  "ApplicationInsights": {
    "ConnectionString": "<REPLACE>"
  },

  "KeyVault": {
    "VaultUri": "https://{STAGING_KEYVAULT_NAME}.vault.azure.net/"
  },

  // STAGING RATE LIMITING - MORE PERMISSIVE THAN PRODUCTION FOR TESTING
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": true,
    "RealIpHeader": "X-Forwarded-For",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{ \"message\": \"Rate limit exceeded. Please try again later.\", \"details\": \"Too many requests from {0}\" }}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 200
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1h",
        "Limit": 5000
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1d",
        "Limit": 50000
      },
      {
        "Endpoint": "*/api/*/auth/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*/api/*/auth/login",
        "Period": "1h",
        "Limit": 100
      }
    ]
  },

  "IpRateLimitPolicies": {
    "IpRules": []
  },

  // STAGING PASSWORD POLICY - SLIGHTLY RELAXED FOR TESTING
  "PasswordPolicy": {
    "MinLength": 10,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigits": true,
    "RequireSpecialCharacters": true,
    "MaxPasswordHistory": 3,
    "PasswordExpirationDays": 365,
    "AccountLockoutThreshold": 5,
    "AccountLockoutDurationMinutes": 10,
    "RequireTwoFactor": false
  },

  // STAGING SECURITY MONITORING
  "SecurityMonitoring": {
    "EnableSecurityEventLogging": true,
    "EnableFailedLoginTracking": true,
    "EnableSuspiciousActivityDetection": true,
    "AlertThresholds": {
      "FailedLoginsPerMinute": 50,
      "SuspiciousIpDetectionEnabled": true,
      "UnusualUserAgentDetection": false
    }
  },

  // STAGING DATA PROTECTION
  "DataProtection": {
    "ApplicationName": "GCC-Staging",
    "KeyLifetime": "30.00:00:00",
    "PersistKeysToAzureBlobStorage": false,
    "PersistKeysToFileSystem": true,
    "KeysPath": "./DataProtectionKeys"
  },

  // STAGING FEATURE FLAGS - TESTING-FRIENDLY
  "FeatureFlags": {
    "EnableDetailedErrorMessages": true,
    "EnableDebugEndpoints": false,
    "EnableSwagger": true,
    "EnableDeveloperExceptionPage": false,
    "RequireHttpsForAllRequests": true,
    "EnableSecurityHeaders": true,
    "EnableCorsRestrictions": true
  },

  // STAGING SPECIFIC SETTINGS
  "StagingSpecific": {
    "EnableTestDataSeeding": false,
    "EnablePerformanceProfiling": true,
    "EnableDetailedLogging": true,
    "AllowTestUserAccounts": true,
    "EnableLoadTesting": true,
    "SimulateProductionLatency": false
  }
}
