{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=<db-host>;Database=<db-name>;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "SqliteConnection": "<REPLACE>"
  },
  "Jwt": {
    "Key": "<GENERATE: openssl rand -base64 64>",
    "Issuer": "GCCWebApp-Test",
    "Audience": "GCCWebApp-Test",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:5000",
    "https://localhost:5001",
    "https://YOUR_TEST_DOMAIN.com"
  ],
  "Authentication": {
    "Enable2FA": true,
    "EnableTestMode": false,
    "RequireEmailConfirmation": false
  },
  "SmtpSettings": {
    "Host": "YOUR_SMTP_HOST",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "YOUR_EMAIL@DOMAIN.COM",
    "Password": "<REQUEST: from project owner>",
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "GCC Database - Test Environment"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1h",
        "Limit": 1000
      }
    ]
  },
  "DataProtection": {
    "ApplicationName": "GCCWebApp-Test"
  },
  "Security": {
    "EnableHttpsRedirection": true,
    "EnableHsts": false,
    "EnableCors": true,
    "RequireAuthenticatedUsers": false
  },
  "TestConfiguration": {
    "BaseUrl": "https://gccwebapp.com",
    "ScreenshotDirectory": "./Screenshots",
    "AdminCredentials": {
      "Username": "admin",
      "Password": "<REQUEST: from project owner>"
    },
    "AnalystCredentials": {
      "Username": "analyst",
      "Password": "<REQUEST: from project owner>"
    },
    "ExternalCredentials": {
      "Username": "external",
      "Password": "<REQUEST: from project owner>"
    }
  }
}
