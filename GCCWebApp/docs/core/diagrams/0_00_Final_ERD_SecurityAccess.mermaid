erDiagram
    %% User and Group Relationships
    User }o--o{ Group : "member of"
    Group }o--o{ Permission : "granted"
    User ||--o{ AuditLog : "creates"
    
    %% Partner Security Relationships (NEW)
    Partner ||--o{ User : "has users"
    Partner }o--o{ Company : "has access to"
    Partner ||--o{ PartnerPermission : "granted"
    Partner ||--o{ APIClient : "uses API"
    
    %% Certificate Access Control (NEW)
    Certificate }o--o{ Partner : "accessible by"
    Certificate ||--|| StatusType : "has status type"
    Certificate ||--o{ CertificateAccess : "access control"
    
    %% Tag Visibility Control (NEW)
    InternalTag ||--o{ TagVisibility : "visibility rules"
    ExternalTag ||--o{ TagVisibility : "visibility rules"
    User ||--o{ TagVisibility : "can see tags"
    
    %% Data Segregation (NEW)
    Partner ||--o{ DataSegregationRule : "isolation rules"
    Company ||--o{ DataSegregationRule : "access rules"
    
    %% Enhanced Entities
    User {
        id int PK
        username varchar UK
        email varchar UK
        partner_id int FK "NEW: Partner association"
        role varchar "Admin/Analyst/External/Internal/Public"
        is_active boolean
    }
    
    Partner {
        id int PK "NEW ENTITY"
        name varchar UK
        code varchar UK
        api_enabled boolean
        data_segregation boolean
        can_create_certificates boolean
        can_modify_certificates boolean
    }
    
    Certificate {
        id int PK
        status varchar
        status_type varchar "NEW: Client progression"
        partner varchar "NEW: Amazon/Wayfair/None"
        is_partner_accessible boolean
    }
    
    StatusType {
        id int PK "NEW ENTITY"
        name varchar UK
        description text
        is_active boolean
        requires_admin_approval boolean
    }
    
    CertificateAccess {
        id int PK "NEW ENTITY"
        certificate_id int FK
        user_id int FK
        partner_id int FK
        access_level varchar "read/write/export"
        granted_by int FK
        granted_at timestamp
    }
    
    TagVisibility {
        id int PK "NEW ENTITY"
        tag_id int FK
        tag_type varchar "internal/external"
        user_id int FK
        partner_id int FK
        visibility_level varchar "none/assigned/all"
    }
    
    DataSegregationRule {
        id int PK "NEW ENTITY"
        partner_id int FK
        company_id int FK
        resource_type varchar "certificate/product/tag"
        access_permitted boolean
        created_at timestamp
    }
    
    PartnerPermission {
        id int PK "NEW ENTITY"
        partner_id int FK
        permission_name varchar
        resource_type varchar
        can_read boolean
        can_write boolean
        can_delete boolean
    }
    
    APIClient {
        id int PK
        name varchar
        partner_id int FK "NEW: Partner-only API"
        client_id varchar UK
        rate_limit int
        is_active boolean
    }
    
    Group {
        id int PK
        name varchar UK
        partner_specific boolean "NEW: Partner group flag"
    }
    
    Permission {
        id int PK
        name varchar
        codename varchar UK
        applies_to_partner boolean "NEW: Partner permission"
    }
    
    AuditLog {
        id int PK
        user_id int FK
        partner_id int FK "NEW: Track partner actions"
        action varchar
        resource_type varchar
        resource_id int
        timestamp timestamp
    }