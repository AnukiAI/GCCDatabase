erDiagram
    %% Partner-Only API Architecture (UPDATED)
    Partner ||--o{ API_CLIENT : "has API access"
    API_CLIENT ||--o{ API_KEY : "manages keys"
    API_CLIENT ||--o{ RATE_LIMIT : "applies to"
    API_CLIENT ||--o{ REQUEST_LOG : "logs requests"
    API_CLIENT ||--|| ENDPOINT_ACCESS : "permitted endpoints"
    
    %% No Direct Client API Access (REMOVED)
    %% User ||--o{ API_KEY : "NO LONGER APPLICABLE"
    
    %% Partner Authentication (NEW)
    Partner ||--o{ OAUTH_CLIENT : "OAuth2 credentials"
    OAUTH_CLIENT ||--o{ ACCESS_TOKEN : "generates tokens"
    ACCESS_TOKEN ||--o{ REQUEST_LOG : "tracks usage"
    
    %% API Endpoint Management
    API_ENDPOINT ||--o{ ENDPOINT_ACCESS : "controls access"
    API_ENDPOINT ||--o{ REQUEST_LOG : "receives calls"
    RATE_LIMIT ||--o{ REQUEST_LOG : "enforces limits"
    
    %% Partner-Specific API Configuration
    Partner ||--o{ PARTNER_API_CONFIG : "custom settings"
    PARTNER_API_CONFIG ||--o{ ENDPOINT_ACCESS : "defines permissions"
    
    %% Enhanced Entities
    Partner {
        id int PK
        name varchar UK "Amazon, Wayfair, etc."
        code varchar UK
        api_enabled boolean "NEW: API access flag"
        api_rate_limit int "Requests per minute"
        data_segregation boolean "Isolate data access"
    }
    
    API_CLIENT {
        id int PK
        partner_id int FK "NEW: Partner-only API"
        client_name varchar
        client_id varchar UK
        client_secret varchar
        is_active boolean
        created_at timestamp
        last_used timestamp
    }
    
    OAUTH_CLIENT {
        id int PK "NEW: OAuth2 support"
        partner_id int FK
        client_id varchar UK
        client_secret varchar
        redirect_uri varchar
        scope varchar "read/write/admin"
        grant_types varchar "client_credentials/authorization_code"
    }
    
    ACCESS_TOKEN {
        id int PK "NEW: Token management"
        oauth_client_id int FK
        access_token varchar UK
        refresh_token varchar
        expires_at timestamp
        scope varchar
        is_revoked boolean
    }
    
    API_KEY {
        id int PK
        api_client_id int FK
        key_value varchar UK
        key_name varchar
        permissions varchar "read/write/admin"
        expires_at timestamp
        is_active boolean
    }
    
    RATE_LIMIT {
        id int PK
        partner_id int FK "NEW: Partner-level limits"
        api_client_id int FK
        endpoint_pattern varchar
        requests_per_minute int
        requests_per_hour int
        requests_per_day int
        burst_limit int
    }
    
    API_ENDPOINT {
        id int PK
        path varchar UK "/api/certificates, /api/products"
        method varchar "GET/POST/PUT/DELETE"
        requires_auth boolean
        partner_only boolean "NEW: Partner-only endpoints"
        description text
        is_active boolean
    }
    
    ENDPOINT_ACCESS {
        id int PK "NEW: Partner endpoint permissions"
        partner_id int FK
        api_endpoint_id int FK
        access_level varchar "none/read/write/admin"
        granted_by int FK
        granted_at timestamp
        expires_at timestamp
    }
    
    REQUEST_LOG {
        id int PK
        partner_id int FK "NEW: Track partner usage"
        api_client_id int FK
        oauth_client_id int FK "NEW: OAuth tracking"
        api_endpoint_id int FK
        request_method varchar
        request_path varchar
        request_headers text
        response_code int
        response_time_ms int
        request_size_bytes int
        response_size_bytes int
        ip_address varchar
        user_agent varchar
        timestamp timestamp
        error_message text
    }
    
    PARTNER_API_CONFIG {
        id int PK "NEW: Partner-specific settings"
        partner_id int FK
        webhook_url varchar "Callback URL for notifications"
        data_format varchar "JSON/XML preference"
        pagination_limit int "Max records per request"
        allowed_origins varchar "CORS origins"
        custom_fields text "Partner-specific data fields"
        notification_events varchar "Certificate updates, etc."
    }
    
    %% API Usage Analytics (NEW)
    API_USAGE_ANALYTICS {
        id int PK "NEW: Usage tracking"
        partner_id int FK
        date date
        total_requests int
        successful_requests int
        failed_requests int
        avg_response_time_ms int
        data_transferred_mb decimal
        rate_limit_hits int
    }