%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontSize": "16px",
    "fontFamily": "Inter, Segoe UI, system-ui, sans-serif",
    "primaryColor": "#00AEEF",
    "primaryTextColor": "#0F172A",
    "primaryBorderColor": "#002B76",
    "lineColor": "#667085",
    "tertiaryColor": "#F6F8FA",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#D0D5DD"
  }
}}%%
flowchart TB
  %% ======= L1 CLIENT =======
  subgraph L1["Client Layer"]
    direction LR
    PU["Public Users"]
    AU["Admin Users"]
    EXT["External API Consumers"]
    AMZ["Amazon (Partner)"]
  end

  %% ======= L2 PRESENTATION =======
  subgraph L2["Presentation Layer"]
    direction LR
    PublicUI["Public Web Interface"]
    AdminUI["Admin Portal"]
  end

  %% ======= L3 API =======
  subgraph L3["API Layer"]
    direction LR
    REST["REST API Gateway"]
    OAuth["OAuth2 / OIDC"]
    subgraph EP["API Endpoints"]
      direction LR
      EP_Auth["Auth"]
      EP_Cert["Certificates"]
      EP_Prod["Products"]
      EP_Search["Search"]
      EP_Amazon["Amazon Connector"]
    end
  end

  %% ======= L4 APPLICATION =======
  subgraph L4["Application Layer"]
    direction LR
    Views["MVC Controllers"]
    Biz["Business Services"]
    Valid["Validation Rules"]
    Authz["Authorization Policies (RBAC/ABAC)"]
  end

  %% ======= L5 DATA ACCESS =======
  subgraph L5["Data Access Layer"]
    direction LR
    ORM["Entity Framework"]
    QRY["Query Services"]
  end

  %% ======= L6 STORAGE =======
  subgraph L6["Storage Layer"]
    direction LR
    DB[("SQL Server")]:::db
    Files["Object Storage (Certificates)"]
  end

  %% ======= L7 OPS =======
  subgraph L7["Monitoring & Operations"]
    direction LR
    Logs["Centralized Logging"]
    Mon["APM / Metrics / Tracing"]
    Bkp["Backups & DR"]
  end

  %% Connections (kept simple & readable)
  PU --> PublicUI
  AU --> AdminUI
  EXT --> REST
  AMZ --> EP_Amazon

  PublicUI --> Views
  AdminUI --> Views
  Views --> Biz
  Biz --> Valid
  Biz --> Authz
  Biz --> ORM

  REST --> EP
  EP_Auth --> OAuth
  OAuth --> Authz

  ORM --> DB
  ORM --> Files
  QRY --> DB

  L4 -.-> Logs
  L5 -.-> Logs
  L6 -.-> Mon
  DB -.-> Bkp
  Files -.-> Bkp

  %% Styles (brand-aligned, restrained)
  classDef client fill:#FEF6E7,stroke:#E67E22,stroke-width:2px,color:#111827,font-weight:bold;
  classDef ui fill:#E7F2FB,stroke:#00AEEF,stroke-width:2px,font-weight:bold;
  classDef api fill:#E8F7EE,stroke:#27AE60,stroke-width:2px,font-weight:bold;
  classDef app fill:#FDEBEB,stroke:#C0392B,stroke-width:2px,font-weight:bold;
  classDef data fill:#EEE6F4,stroke:#8E44AD,stroke-width:2px,font-weight:bold;
  classDef storage fill:#F7F7F7,stroke:#7F8C8D,stroke-width:2px,font-weight:bold;
  classDef ops fill:#FFF6D8,stroke:#F39C12,stroke-width:2px,font-weight:bold;
  classDef db fill:#FFFFFF,stroke:#8E44AD,stroke-width:3px;

  class L1 client
  class L2 ui
  class L3 api
  class L4 app
  class L5 data
  class L6 storage
  class L7 ops
  class DB db
