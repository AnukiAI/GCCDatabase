-- View for public certificates
CREATE VIEW public_certificates AS
SELECT c.id, c.certificate_number, c.effective_date, c.expiration_date, 
       c.location, c.country, c.asin, c.upc, c.gtin, c.ean,
       co.name AS company_name, co.contact_info AS company_contact,
       p.name AS product_name, 
       pc.name AS product_category,
       pt.name AS product_type,
       ps.name AS product_subcategory,
       ct.name AS certification_type
FROM certificates c
JOIN companies co ON c.company_id = co.id
JOIN products p ON c.product_id = p.id
JOIN product_categories pc ON p.category_id = pc.id
LEFT JOIN product_types pt ON p.product_type_id = pt.id
LEFT JOIN product_subcategories ps ON p.subcategory_id = ps.id
JOIN certification_types ct ON c.certification_type_id = ct.id
WHERE c.status = 'CLIENT_APPROVED_PAID'
  AND c.effective_date <= CURRENT_DATE
  AND (c.expiration_date IS NULL OR c.expiration_date >= CURRENT_DATE);

-- View for Amazon API integration
CREATE VIEW amazon_certificates AS
SELECT c.certificate_number,
       'greencircle' AS certification_agency,
       ct.amazon_code AS certification_type,
       'ACTIVE' AS certification_status,
       c.country AS certification_country,
       c.effective_date,
       c.expiration_date,
       c.asin, c.upc, c.gtin, c.ean
FROM certificates c
JOIN certification_types ct ON c.certification_type_id = ct.id
WHERE (c.status = 'CLIENT_APPROVED_PAID' OR c.status = 'CLIENT_APPROVED_CONFIDENTIAL')
  AND c.effective_date <= CURRENT_DATE
  AND (c.expiration_date IS NULL OR c.expiration_date >= CURRENT_DATE);