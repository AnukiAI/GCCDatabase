  "database_design": {
    "core_entities": {
      "Certificate": {
        "primary_key": "Id",
        "unique_constraints": ["Number"],
        "foreign_keys": ["CompanyId", "ProductId", "CertificationTypeId", "CreatedBy", "UpdatedBy"],
        "relationships": ["Company", "Product", "CertificationType", "CustomFieldValues", "Tags"]
      },
      "Company": {
        "primary_key": "Id",
        "unique_constraints": ["Name"],
        "relationships": ["Certificates", "Products", "Users"]
      },
      "Product": {
        "primary_key": "Id",
        "foreign_keys": ["CategoryId", "ProductTypeId", "ProductSubcategoryId", "CompanyId"],
        "relationships": ["Certificates", "ProductIdentifiers", "Tags"]
      },
      "User": {
        "primary_key": "Id",
        "unique_constraints": ["Username", "Email"],
        "relationships": ["Roles", "Companies", "CreatedCertificates", "UpdatedCertificates"]
      }
    },
    "supporting_entities": {
      "ProductCategory": "Product classification hierarchy root",
      "ProductType": "Product type with hierarchical support",
      "ProductSubcategory": "Product subcategory classification",
      "ProductIdentifier": "UPC, GTIN, EAN, ASIN identifiers",
      "CertificationType": "Types of certifications",
      "CustomField": "Dynamic field definitions",
      "CustomFieldValue": "Dynamic field values per certificate",
      "Tag": "Labeling and categorization",
      "Role": "User roles for authorization",
      "Permission": "Granular permissions"
    },
    "etl_entities": {
      "ETLConfiguration": "ETL job configurations",
      "ETLLogEntry": "ETL process logging",
      "ETLAlert": "ETL error alerts",
      "ETLDataQualityIssue": "Data quality monitoring",
      "CertificateAggregateData": "Aggregated certificate statistics"
    }
