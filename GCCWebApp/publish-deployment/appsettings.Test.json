{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GCC_Test;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "SqliteConnection": "Data Source=gcc_database_test.db"
  },
  "Jwt": {
    "Key": "TestJwtSecretKeyForAutomatedTestingEnvironmentAtLeast64CharactersLongForSecurity123456789",
    "Issuer": "GCCWebApp-Test",
    "Audience": "GCCWebApp-Test",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:5000",
    "https://localhost:5001",
    "https://YOUR_TEST_DOMAIN.com"
  ],
  "Authentication": {
    "Enable2FA": true,
    "EnableTestMode": false,
    "RequireEmailConfirmation": false
  },
  "SmtpSettings": {
    "Host": "YOUR_SMTP_HOST",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "YOUR_EMAIL@DOMAIN.COM",
    "Password": "YOUR_EMAIL_PASSWORD",
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "GCC Database - Test Environment"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1h",
        "Limit": 1000
      }
    ]
  },
  "DataProtection": {
    "ApplicationName": "GCCWebApp-Test"
  },
  "Security": {
    "EnableHttpsRedirection": true,
    "EnableHsts": false,
    "EnableCors": true,
    "RequireAuthenticatedUsers": false
  }
}