{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning",
      "GCCWebApp.Services.ETL": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "ShowDetailedApiErrors": false
  },
  "AzureAdB2C": {
    "Instance": "https://{tenant-name}.b2clogin.com/",
    "ClientId": "{client-id}",
    "ClientSecret": "{client-secret}",
    "Domain": "{tenant-name}.onmicrosoft.com",
    "TenantId": "{tenant-id}",
    "SignUpSignInPolicyId": "B2C_1_SignUpSignIn",
    "ResetPasswordPolicyId": "B2C_1_PasswordReset",
    "EditProfilePolicyId": "B2C_1_ProfileEdit",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "{tenant-domain}",
    "TenantId": "{tenant-id}",
    "ClientId": "{client-id}",
    "ClientSecret": "{client-secret}",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "MicrosoftGraph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0/",
    "Scopes": "User.Read User.ReadWrite.All Directory.Read.All"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=ANUKI01;Database=GCCDatabase;Integrated Security=true;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "SqliteConnection": "Data Source=gcc_database.db"
  },
  "Jwt": {
    "Key": "{JWT_SECRET_KEY}",
    "Issuer": "GCCWebApp",
    "Audience": "GCCWebApp",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://localhost:3001",
    "http://localhost:5000",
    "https://localhost:5001",
    "http://localhost:5101",
    "https://localhost:5101"
  ],
  "SmsSettings": {
    "Provider": "mock",
    "Twilio": {
      "AccountSid": "{TWILIO_ACCOUNT_SID}",
      "AuthToken": "{TWILIO_AUTH_TOKEN}",
      "FromNumber": "{TWILIO_PHONE_NUMBER}",
      "TestNumber": "{TEST_PHONE_NUMBER}"
    },
    "TextBelt": {
      "ApiKey": "{TEXTBELT_API_KEY}",
      "TestNumber": "{TEST_PHONE_NUMBER}"
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1h",
        "Limit": 1000
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1d",
        "Limit": 10000
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": [
      {
        "Ip": "127.0.0.1",
        "Rules": [
          {
            "Endpoint": "*",
            "Period": "1m",
            "Limit": 200
          }
        ]
      }
    ]
  }
}