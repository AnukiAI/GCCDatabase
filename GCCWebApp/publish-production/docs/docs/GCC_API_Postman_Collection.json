              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "products"]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/products/1",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "products", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Health & Monitoring",
      "description": "Health checks and system monitoring",
      "item": [
        {
          "name": "Health Check - Complete",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Complete health status with all checks"
          }
        },
        {
          "name": "Health Check - Readiness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health/ready",
              "host": ["{{base_url}}"],
              "path": ["health", "ready"]
            },
            "description": "Readiness probe for load balancers"
          }
        },
        {
          "name": "Health Check - Liveness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health/live",
