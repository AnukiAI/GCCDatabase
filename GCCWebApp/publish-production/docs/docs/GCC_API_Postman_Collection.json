          }
        },
        {
          "name": "API Metrics",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/metrics",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "metrics"]
            },
            "description": "Get API usage metrics"
          }
        }
      ]
    },
    {
      "name": "🚨 Error Scenarios",
      "description": "Examples of error responses and handling",
      "item": [
        {
          "name": "401 - No Authentication",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/certificates",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "certificates"]
            },
            "description": "Example of unauthorized access"
          }
        },
        {
          "name": "404 - Certificate Not Found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/certificates/999999",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "certificates", "999999"]
            },
            "description": "Example of resource not found"
          }
        },
        {
          "name": "400 - Invalid Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"\",\n  \"productId\": \"invalid\",\n  \"companyId\": -1,\n  \"effectiveDate\": \"invalid-date\",\n  \"expirationDate\": \"2020-01-01\",\n  \"status\": \"InvalidStatus\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/certificates",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "certificates"]
            },
            "description": "Example of validation errors"
          }
        },
        {
          "name": "429 - Rate Limit Test",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This will make multiple rapid requests to test rate limiting",
                  "// Note: Only run this if you want to test rate limits",
                  "console.log('Testing rate limits - this request may be throttled');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/certificates",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "certificates"]
            },
            "description": "Make rapid requests to test rate limiting"
          }
        }
      ]
    }
  ]
}