{
  "Performance": {
    "MemoryCache": {
      "SizeLimit": 100000000,
      "CompactionPercentage": 0.25
    },
    "ResponseCompression": {
      "EnableForHttps": true,
      "Level": "Optimal"
    },
    "OutputCache": {
      "DefaultExpirationMinutes": 10,
      "StaticFilesExpirationDays": 1,
      "CertificatesListExpirationMinutes": 5,
      "CertificateDetailsExpirationMinutes": 15,
      "CompanyDetailsExpirationMinutes": 30,
      "ProductsListExpirationMinutes": 20,
      "PartnersListExpirationHours": 1
    },
    "Database": {
      "EnableQueryLogging": false,
      "SlowQueryThresholdMs": 1000,
      "EnableStatisticsCollection": true,
      "OptimizationSchedule": "0 2 * * 0"
    },
    "BundlingAndMinification": {
      "EnableInProduction": true,
      "CacheDurationHours": 1,
      "EnableMinification": true,
      "Bundles": {
        "css": {
          "main": ["css/main.css", "css/certificates.css"],
          "admin": ["css/main.css", "css/admin.css"],
          "external": ["css/main.css", "css/certificatesexternal.css"]
        },
        "js": {
          "main": ["js/main.js", "js/certificates.js"],
          "admin": ["js/main.js", "js/admin.js"],
          "external": ["js/main.js", "js/certificatesexternal.js"]
        }
      }
    },
    "CDN": {
      "Enabled": false,
      "BaseUrl": "https://cdn.your-domain.com",
      "StaticFilesCacheDays": 365,
      "EnablePurging": false
    }
  },
  
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "FeatureFlags": {
    "EnableResponseCaching": true,
    "EnableOutputCaching": true,
    "EnableDatabaseOptimization": true,
    "EnableBundlingAndMinification": true,
    "EnableCDN": false,
    "EnablePerformanceMonitoring": true
  }
}