<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- DEF-363: stdoutLogFile is back to ".\logs\stdout" (INSIDE the app folder).
           It was briefly changed to "..\logs\stdout" on 2026-08-18 to move writes out of the
           directory IIS monitors. That went out in the same build as DataProtection:KeyPath,
           which caused HTTP 500.30, so the stdout move was never independently proven and is
           REVERTED to the value the known-good 2026-08-04 bundle shipped.
           Evidence it is safe here: the 2026-08-04 bundle runs with this exact value.
           Do not move it again without first confirming the app-pool identity can write to the
           vhost root - the same permission that KeyPath needed and did not have. -->
      <aspNetCore processPath=".\GCCWebApp.exe"
                  arguments=""
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- CRITICAL: Set to Production to use SQL Server -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Force SQL Server provider -->
          <environmentVariable name="DatabaseProvider" value="SqlServer" />
          <environmentVariable name="USE_SQL_SERVER" value="true" />
          <!-- Outbound sender on the client domain — docs/cutover/outbound-email-client-domain.md.
               Env vars load AFTER appsettings*.json and the Secrets overlay (Program.cs:41,46), so
               this wins over FromEmail everywhere. SMTP auth is unchanged (still admin@gccwebapp.com
               via the Secrets overlay). Since 2026-09-22 appsettings.Production.json carries the SAME
               value, so this line is now belt-and-braces, not the only place it is set.
               Delivery depends on the SPF TXT on db.greencirclecertified.com (DMARC p=quarantine).
               ROLLBACK: set this value to admin@gccwebapp.com (deleting the line is NOT enough any
               more - appsettings.Production.json would still supply noreply@db). -->
          <environmentVariable name="SmtpSettings__FromEmail" value="noreply@db.greencirclecertified.com" />
        </environmentVariables>
      </aspNetCore>
      
      <!-- Security Headers — DEF-107 follow-up 2026-05-21:
           Headers are now managed exclusively by Middleware/SecurityHeadersMiddleware.cs.
           This <httpProtocol> block previously injected the same set in IIS, causing
           every response to carry duplicates (Permissions-Policy count=2 observed live
           on gccwebapp.com 2026-05-21). Multiple values also conflicted between the two
           sources (X-Frame-Options: SAMEORIGIN vs DENY; X-XSS-Protection: "1; mode=block"
           vs "0"; CSP and Permissions-Policy values differed). Removing the IIS-level
           headers makes the middleware the single source of truth — environment-aware,
           applies before UseStaticFiles (per Program.cs:570/657), and covers Kestrel
           dev hosting consistently with IIS in-process prod hosting. -->

      <!-- URL Rewrite -->
      <rewrite>

        <!-- Legacy deep-link map: the legacy public database's integer record_id -> certificate
             number. GENERATED, 5,999 entries — regenerate with
             Scripts/cutover/generate-legacy-redirect-map.py, never by hand.

             ⚠ If this file is missing from the publish output, IIS raises a configuration
             error and returns 500 on EVERY path — the same total-outage shape as DEF-363.
             It is kept in the bundle by an explicit <Content Include> in GCCWebApp.csproj, and
             Scripts/cutover/verify-redirect-map.py asserts it is present in the zip. Run that
             before any deploy that carries this. -->
        <rewriteMaps configSource="rewritemaps.config" />

        <rules>

          <!-- ============================================================
               LEGACY DEEP LINKS — go-live cutover
               Plan: docs/cutover/go-live-plan-2026-09-21.md §A7 · Audit §10

               At cutover the db. A record moves off Vercel onto this server. Every link in
               circulation to the legacy site — printed, emailed, bookmarked — dies at that
               instant unless these rules ship with it. DNS has no partial state.

               These sit FIRST, ahead of the canonical-host rules, because they redirect to an
               ABSOLUTE db. URL: a legacy link arriving on any hostname resolves in ONE hop
               instead of being canonicalised and then translated.

               SHIPPED ENABLED. They are inert until db. points here — nothing requests these
               paths on gccwebapp.com — so there is no cutover-day step to forget.
               ============================================================ -->

          <!-- /api/certificates/{record_id}/download  ->  the certificate's detail page.
               An unknown id resolves to the map's empty defaultValue, the condition fails, and
               the request falls through to a normal 404. Deliberate: a clean 404 beats a
               redirect to a certificate that is not the one the link meant.

               NOTE this deliberately does NOT cover the legacy /api/certificates list or
               /api/trpc/* — audit §10. Redirecting those would turn a working unauthenticated
               integration into a 401, which is worse than a 404 with a message. -->
          <rule name="Legacy deep link - certificate download by record id" stopProcessing="true">
            <match url="^api/certificates/([0-9]+)/download/?$" />
            <conditions>
              <add input="{LegacyCertIds:{R:1}}" pattern="(.+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateSingleView/{C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <!-- /certificate/{record_id} (the legacy preview page) -> the certificate's detail page.
               Added 2026-09-23 from a client-reported example: /certificate/5815 was a 404.
               Same map and same unknown-id fall-through as the download rule above. -->
          <rule name="Legacy deep link - certificate page by record id" stopProcessing="true">
            <match url="^certificate/([0-9]+)/?$" />
            <conditions>
              <add input="{LegacyCertIds:{R:1}}" pattern="(.+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateSingleView/{C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <!-- /api/v1/certificates/{record_id}/generate-certificate -> the certificate's detail page.
               Found 2026-09-23 in the legacy site's _buildManifest (the full route inventory, read
               from the still-running Vercel deployment via curl - -resolve to 76.76.21.21).
               Anchored on the /generate-certificate suffix so it can NEVER match the Amazon
               partner API (/api/v1/certificates and /api/v1/certificates/{number}), whose
               contract is immutable. The legacy app also served it under an /en/ locale prefix. -->
          <rule name="Legacy deep link - generate certificate by record id" stopProcessing="true">
            <match url="^(?:en/)?api/v1/certificates/([0-9]+)/generate-certificate/?$" />
            <conditions>
              <add input="{LegacyCertIds:{R:1}}" pattern="(.+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateSingleView/{C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <!-- ============================================================
               LEGACY TABLE FILTERS - /certificate?<filter>=X -> CertificateTileView?search=X
               The legacy /certificate page reads EXACTLY eight URL params (read from its page
               chunk 2026-09-23): certificateNumber, company.name, product.name,
               product.productType.name, certificateType.name, location, effectiveDate,
               expirationDate. The first six map to ?search= - the new public search was
               verified live to match number, company, product, cert type, product type and
               location. The two dates have no equivalent and fall through to the plain
               listing rule below.

               All map to ?search=, never to the exact-match filters (?company=, ?certType=),
               because legacy filters were fuzzy/substring and links carry partial names.

               ORDER = priority when a link carries several filters (search takes one value):
               most specific first. Each pattern is anchored on (^|&) so product\.name cannot
               match inside product.productType.name. {C:1} passes through still URL-encoded,
               which is what the target needs. All must sit BEFORE the plain listing rule,
               which drops the query string.
               ============================================================ -->
          <rule name="Legacy filter - certificate number" stopProcessing="true">
            <match url="^certificate/?$" />
            <conditions>
              <add input="{QUERY_STRING}" pattern="(?:^|&amp;)certificateNumber=([^&amp;]+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateTileView?search={C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <rule name="Legacy filter - product name" stopProcessing="true">
            <match url="^certificate/?$" />
            <conditions>
              <add input="{QUERY_STRING}" pattern="(?:^|&amp;)product\.name=([^&amp;]+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateTileView?search={C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <!-- /certificate?company.name=X -> the public tile view searching for X.
               Added 2026-09-23 from a client-reported example (company.name=dupont).
               Mapped to ?search=, NOT ?company=: the company filter needs the exact stored
               name ("DuPont de Nemours..."), while legacy links carry loose lowercase names.
               {C:1} is passed through still URL-encoded, which is what the target needs.
               Must sit BEFORE the plain listing rule below, which drops the query string. -->
          <rule name="Legacy deep link - company search" stopProcessing="true">
            <match url="^certificate/?$" />
            <conditions>
              <add input="{QUERY_STRING}" pattern="(?:^|&amp;)company\.name=([^&amp;]+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateTileView?search={C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <rule name="Legacy filter - product type" stopProcessing="true">
            <match url="^certificate/?$" />
            <conditions>
              <add input="{QUERY_STRING}" pattern="(?:^|&amp;)product\.productType\.name=([^&amp;]+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateTileView?search={C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <rule name="Legacy filter - certification type" stopProcessing="true">
            <match url="^certificate/?$" />
            <conditions>
              <add input="{QUERY_STRING}" pattern="(?:^|&amp;)certificateType\.name=([^&amp;]+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateTileView?search={C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <rule name="Legacy filter - location" stopProcessing="true">
            <match url="^certificate/?$" />
            <conditions>
              <add input="{QUERY_STRING}" pattern="(?:^|&amp;)location=([^&amp;]+)" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateTileView?search={C:1}"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <!-- /portal and everything under it (the legacy STAFF admin area) -> the new login page.
               Only GCC staff would hold these bookmarks. The new app has no /portal routes, so
               without this they 404. Not mapped page-for-page: the legacy admin ids are not
               the new app's ids. -->
          <rule name="Legacy staff portal" stopProcessing="true">
            <match url="^portal(?:/.*)?$" />
            <action type="Redirect" url="https://db.greencirclecertified.com/Account/Login"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <!-- /certificate -> the public tile view. Matched case-insensitively on purpose:
               the legacy site emits lowercase, but /Certificate has no Index action on
               CertificateController and 404s today, so catching both is strictly better than
               catching one. Anything deeper than /certificate does not match. -->
          <rule name="Legacy deep link - certificate listing" stopProcessing="true">
            <match url="^certificate/?$" />
            <action type="Redirect" url="https://db.greencirclecertified.com/Certificate/CertificateTileView"
                    redirectType="Permanent" appendQueryString="false" />
          </rule>

          <!-- ============================================================
               CANONICAL HOST — go-live cutover to db.greencirclecertified.com
               Plan: docs/cutover/go-live-plan-2026-09-21.md §A6 and §2.2
               Audit: docs/cutover/database.greencirclecertified.com-audit.md §9

               These sit BEFORE the HTTPS rule on purpose: a plain-HTTP request to a
               retired host is then upgraded and canonicalised in ONE 301, not two.

               They must never match db.greencirclecertified.com itself (redirect loop),
               nor test.gccwebapp.com / dbtest.greencirclecertified.com, which keep
               serving their own hostnames. Matching is by explicit host, not a wildcard,
               for exactly that reason.

               NOTE web.config is tracked in git and REPUBLISHED ON EVERY DEPLOY. A rule
               enabled by hand on the server is silently lost at the next publish. Any
               lasting change belongs here, in the repo.
               ============================================================ -->

          <!-- Rule 1 — database.greencirclecertified.com
               SHIPPED ENABLED, and it is a no-op before cutover: that hostname already
               302s to db. today via an nginx shim at 70.32.82.212. Once its A record
               moves here, this rule takes over the same job and upgrades it to a 301
               that preserves path and query, which the shim does not. -->
          <rule name="Canonical host - database subdomain" enabled="true" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTP_HOST}" pattern="^database\.greencirclecertified\.com$" ignoreCase="true" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/{R:1}"
                    redirectType="Permanent" appendQueryString="true" />
          </rule>

          <!-- Rule 2 — gccwebapp.com retirement
               ENABLED 2026-09-23 (runbook step 11). The db. A record moved here 2026-09-22 and
               the gated test environment is now test.gccwebapp.com (its own site), so
               gccwebapp.com no longer needs to serve anything itself.

               /api/* is EXCLUDED: the 2026-08-14 Amazon host-change note told the partner
               gccwebapp.com/api/v1 keeps working, and a cross-host 301 can drop the API key
               header in HTTP clients. Remove the exclusion only once the Amazon notice
               (runbook step 13) confirms nothing calls gccwebapp.com/api any more.

               ROLLBACK: set enabled="false". A config flip, never a redeploy. -->
          <rule name="Canonical host - gccwebapp retirement" enabled="true" stopProcessing="true">
            <match url="(.*)" />
            <conditions logicalGrouping="MatchAll">
              <add input="{HTTP_HOST}" pattern="^(www\.)?gccwebapp\.com$" ignoreCase="true" />
              <add input="{R:1}" pattern="^api/" ignoreCase="true" negate="true" />
            </conditions>
            <action type="Redirect" url="https://db.greencirclecertified.com/{R:1}"
                    redirectType="Permanent" appendQueryString="true" />
          </rule>

          <!-- HTTPS upgrade for every host that was not canonicalised above -->
          <rule name="Redirect to HTTPS" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                    redirectType="Permanent" />
          </rule>
        </rules>
      </rewrite>
      
      <!-- Request Filtering - fileExtensions and hiddenSegments are DELIBERATELY ABSENT.
           This server (Plesk) rejects them. Do not add them back. Proven twice:

           2026-08-18 (DEF-363): they were added to stop appsettings.Production.json being
           downloadable during the morning's exposure. Every deploy carrying them failed to start
           - the site returned an empty HTTP 500 on every path - and the site came back the moment
           this file was reverted to the 2026-08-04 version, with the binaries left unchanged.
           That was a clean one-variable test: config was byte-identical, only this differed.
           An earlier hand notes the same conclusion in the line this comment replaced:
           "REMOVED fileExtensions and hiddenSegments to avoid Plesk conflicts".

           WHY THEY ARE NOT NEEDED: the exposure they guarded against only happens when the
           AspNetCoreModuleV2 handler is INACTIVE. When the handler is mapped it takes path="*"
           and nothing is served raw - verified live 2026-08-18, /appsettings.Production.json and
           /GCCWebApp.dll both 302 to the gate rather than returning content. Request filtering
           was defence in depth for a broken-handler state, not a requirement.

           THE REAL CONTROL is a post-deploy check, because a leak here is silent:
               /appsettings.Production.json  must NOT return 200
               /GCCWebApp.dll                must NOT return 200
               /robots.txt                   must return 200
               /wwwroot/robots.txt           must NOT return 200
           Static assets work while binaries and config do not. If that is inverted, the handler
           is unmapped and secrets are public - stop the site. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      
      <!-- Static Content -->
      <staticContent>
        <remove fileExtension=".css" />
        <mimeMap fileExtension=".css" mimeType="text/css" />
        <remove fileExtension=".json" />
        <mimeMap fileExtension=".json" mimeType="application/json" />
        <remove fileExtension=".woff" />
        <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      </staticContent>
      
      <!-- HTTP Compression -->
      <httpCompression>
        <dynamicTypes>
          <add mimeType="application/json" enabled="true" />
          <add mimeType="application/javascript" enabled="true" />
        </dynamicTypes>
      </httpCompression>
      
      <!-- Default Documents -->
      <defaultDocument>
        <files>
          <clear />
          <add value="index.html" />
        </files>
      </defaultDocument>
      
      <!-- Error Pages -->
      <httpErrors errorMode="Custom" defaultResponseMode="Redirect">
        <remove statusCode="404" subStatusCode="-1" />
        <error statusCode="404" responseMode="ExecuteURL" path="/Home/NotFound" />
        <remove statusCode="500" subStatusCode="-1" />
        <error statusCode="500" responseMode="ExecuteURL" path="/Home/Error" />
      </httpErrors>
    </system.webServer>
  </location>
</configuration>