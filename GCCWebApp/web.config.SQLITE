<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Self-contained deployment for AccuWebHosting -->
      <aspNetCore processPath=".\GCCWebApp.exe"
                  arguments=""
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- CRITICAL: Set environment to Production -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- TEMPORARY: Use SQLite (no SQL Server authentication needed) -->
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="Data Source=gcc_database.db" />

          <!-- JWT Secret (required for API authentication) -->
          <environmentVariable name="GCC_JWT_SECRET" value="your-jwt-secret-key-minimum-64-characters-long-change-this-in-production-please-make-this-unique" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
