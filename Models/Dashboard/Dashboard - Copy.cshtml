                <thead><tr><th>Certification Type</th><th>Total Active Certs</th></tr></thead>
                <tbody>
                    <tr><td>Cert Type 1</td><td>287</td></tr>
                    <tr><td>Cert Type 2</td><td>261</td></tr>
                    <tr><td>Cert Type 3</td><td>302</td></tr>
                    <tr><td>Cert Type 4</td><td>342</td></tr>
                    <tr><td>Cert Type 5</td><td>201</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Top 10 Companies by Active Cert Count -->
