    <!-- Action Buttons -->
    <div class="action-buttons">
        <button class="action-button">Export Selected Metric</button>
        <button class="action-button">Expiring Certs Next 3 Months</button>
        <button class="action-button">Current Active Certs</button>
        <button class="action-button">Expiring Certs Next 30 Days</button>
    </div>
</div>

