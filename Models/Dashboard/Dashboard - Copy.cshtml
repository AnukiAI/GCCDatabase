@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container dashboard-container">
    <h2 class="dashboard-title">Analytics Dashboard</h2>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card"><div class="stat-title">Total Active Certs</div><div class="stat-value">1293</div></div>
        <div class="stat-card"><div class="stat-title"># Companies with Active Certs</div><div class="stat-value">187</div></div>
        <div class="stat-card"><div class="stat-title"># Product Categories with Active Certs</div><div class="stat-value">110</div></div>
        <div class="stat-card"><div class="stat-title"># Product Types with Active Certs</div><div class="stat-value">110</div></div>
        <div class="stat-card"><div class="stat-title"># Product Type Subcategories with Active Certs</div><div class="stat-value">110</div></div>
        <div class="stat-card"><div class="stat-title"># Products with Active Certs</div><div class="stat-value">1213</div></div>
        <div class="stat-card"><div class="stat-title"># Certs Published Last Month</div><div class="stat-value">49</div></div>
        <div class="stat-card"><div class="stat-title"># Certs Expiring This Month</div><div class="stat-value">39</div></div>
        <div class="stat-card"><div class="stat-title"># Certs Expired Last Month</div><div class="stat-value">49</div></div>
        <div class="stat-card"><div class="stat-title"># Certs Expiring Next Month</div><div class="stat-value">116</div></div>
        <div class="stat-card"><div class="stat-title"># Certs Published This Year</div><div class="stat-value">742</div></div>
        <div class="stat-card"><div class="stat-title"># Certs Published Last Year</div><div class="stat-value">1514</div></div>
    </div>

    <!-- Tables Container -->
