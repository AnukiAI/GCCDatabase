                    <tr><td>Company 2</td><td>357</td></tr>
                    <tr><td>Company 3</td><td>307</td></tr>
                    <tr><td>Company 4</td><td>279</td></tr>
                    <tr><td>Company 5</td><td>175</td></tr>
                    <tr><td>Company 6</td><td>124</td></tr>
                    <tr><td>Company 7</td><td>96</td></tr>
                    <tr><td>Company 8</td><td>74</td></tr>
                    <tr><td>Company 9</td><td>61</td></tr>
