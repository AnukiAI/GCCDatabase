                    <tr><td>Product Type 2</td><td>161</td></tr>
                    <tr><td>Product Type 3</td><td>144</td></tr>
                    <tr><td>Product Type 4</td><td>140</td></tr>
                    <tr><td>Product Type 5</td><td>135</td></tr>
                    <tr><td>Product Type 6</td><td>126</td></tr>
