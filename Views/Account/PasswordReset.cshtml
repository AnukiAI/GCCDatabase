@{
    ViewData["Title"] = "Reset Password";
    ViewData["BodyClass"] = "login-page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenCircle Certified Database</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        .login-page {
            background: linear-gradient(135deg, #002B76 0%, #00AEEF 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .auth-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            max-width: 500px;
            width: 100%;
            padding: 40px;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .auth-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #92C83E 0%, #447638 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 10px 30px rgba(146, 200, 62, 0.3);
        }

        .auth-icon i {
            font-size: 36px;
            color: white;
        }

        .auth-header h2 {
            font-size: 28px;
            font-weight: 700;
            color: #002B76;
            margin-bottom: 10px;
        }

        .auth-header p {
            color: #6b7280;
            font-size: 16px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #374151;
            font-size: 14px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #d1d5db;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s ease;
            background-color: #f9fafb;
        }

        .form-control:focus {
            outline: none;
            border-color: #92C83E;
            background-color: white;
            box-shadow: 0 0 0 3px rgba(146, 200, 62, 0.1);
        }

        .password-requirements {
            background: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .password-requirements h4 {
            color: #0369a1;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .password-requirements ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .password-requirements li {
            color: #0369a1;
            font-size: 12px;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .password-requirements li i {
            font-size: 10px;
        }

        .requirement-valid {
            color: #16a34a;
        }

        .requirement-invalid {
            color: #dc2626;
        }

        .password-strength {
            margin-top: 8px;
        }

        .strength-bar {
            height: 4px;
            background: #e5e7eb;
            border-radius: 2px;
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            transition: all 0.3s ease;
            border-radius: 2px;
        }

        .strength-weak { background: #dc2626; width: 25%; }
        .strength-fair { background: #f59e0b; width: 50%; }
        .strength-good { background: #10b981; width: 75%; }
        .strength-strong { background: #16a34a; width: 100%; }

        .strength-label {
            font-size: 12px;
            margin-top: 4px;
            font-weight: 600;
        }

        .btn-lime {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            background: linear-gradient(135deg, #92C83E 0%, #7bb82e 100%);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 20px;
        }

        .btn-lime:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(146, 200, 62, 0.3);
        }

        .btn-lime:active {
            transform: translateY(0);
        }

        .btn-lime:disabled {
            background: #9ca3af;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #6b7280;
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .back-link:hover {
            color: #002B76;
        }

        .alert-error {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding: 15px;
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #dc2626;
        }

        .alert-success {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding: 15px;
            background-color: #f0fdf4;
            border: 1px solid #86efac;
            border-radius: 8px;
            color: #16a34a;
        }

        .security-note {
            background: #fffbeb;
            border: 1px solid #fbbf24;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .security-note h4 {
            color: #f59e0b;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .security-note p {
            color: #92400e;
            font-size: 12px;
            margin: 0;
            line-height: 1.4;
        }

        @@media (max-width: 480px) {
            .auth-container {
                padding: 30px 20px;
            }

            .auth-header h2 {
                font-size: 24px;
            }
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
</head>
<body class="login-page">
    <div class="auth-container">
        <a href="@Url.Action("Login", "Account")" class="back-link">
            <i class="fas fa-arrow-left"></i>
            Back to login
        </a>

        <div class="auth-header">
            <div class="auth-icon">
                <i class="fas fa-key"></i>
            </div>
            <h2>Reset Password</h2>
            <p>Enter your new password below</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert-error">
                <i class="fas fa-exclamation-circle"></i>
                @ViewBag.Error
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.Success))
        {
            <div class="alert-success">
                <i class="fas fa-check-circle"></i>
                @ViewBag.Success
            </div>
        }

        <div class="security-note">
            <h4><i class="fas fa-shield-alt"></i> Security Note</h4>
            <p>Choose a strong password that you haven't used before. It will be encrypted and stored securely.</p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetForm">
            <input type="hidden" name="Token" value="@ViewBag.Token" />
            <input type="hidden" name="Email" value="@ViewBag.Email" />
            
            <div class="form-group">
                <label for="Password">New Password</label>
                <input type="password" id="Password" name="Password" class="form-control" placeholder="Enter your new password" required />
            </div>

            <div class="password-requirements">
                <h4>Password Requirements:</h4>
                <ul id="requirements">
                    <li id="req-length"><i class="fas fa-times requirement-invalid"></i> At least 8 characters</li>
                    <li id="req-uppercase"><i class="fas fa-times requirement-invalid"></i> One uppercase letter</li>
                    <li id="req-lowercase"><i class="fas fa-times requirement-invalid"></i> One lowercase letter</li>
                    <li id="req-number"><i class="fas fa-times requirement-invalid"></i> One number</li>
                    <li id="req-special"><i class="fas fa-times requirement-invalid"></i> One special character</li>
                </ul>
            </div>

            <div class="password-strength">
                <div class="strength-bar">
                    <div class="strength-fill" id="strengthFill"></div>
                </div>
                <div class="strength-label" id="strengthLabel">Password strength</div>
            </div>

            <div class="form-group">
                <label for="ConfirmPassword">Confirm Password</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" placeholder="Confirm your new password" required />
                <div id="passwordMatch" style="font-size: 12px; margin-top: 4px;"></div>
            </div>

            <button type="submit" class="btn-lime" id="submitBtn" disabled>
                <i class="fas fa-lock"></i>
                Reset Password
            </button>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const passwordInput = document.getElementById('Password');
            const confirmInput = document.getElementById('ConfirmPassword');
            const submitBtn = document.getElementById('submitBtn');
            const strengthFill = document.getElementById('strengthFill');
            const strengthLabel = document.getElementById('strengthLabel');
            const passwordMatch = document.getElementById('passwordMatch');

            const requirements = {
                length: { element: document.getElementById('req-length'), test: (pwd) => pwd.length >= 8 },
                uppercase: { element: document.getElementById('req-uppercase'), test: (pwd) => /[A-Z]/.test(pwd) },
                lowercase: { element: document.getElementById('req-lowercase'), test: (pwd) => /[a-z]/.test(pwd) },
                number: { element: document.getElementById('req-number'), test: (pwd) => /[0-9]/.test(pwd) },
                special: { element: document.getElementById('req-special'), test: (pwd) => /[!@@#$%^&*(),.?":{}|<>]/.test(pwd) }
            };

            function updateRequirements(password) {
                let validCount = 0;
                
                Object.values(requirements).forEach(req => {
                    const isValid = req.test(password);
                    const icon = req.element.querySelector('i');
                    
                    if (isValid) {
                        icon.className = 'fas fa-check requirement-valid';
                        req.element.className = 'requirement-valid';
                        validCount++;
                    } else {
                        icon.className = 'fas fa-times requirement-invalid';
                        req.element.className = 'requirement-invalid';
                    }
                });

                return validCount;
            }

            function updateStrength(password) {
                const validCount = updateRequirements(password);
                
                strengthFill.className = 'strength-fill';
                
                if (validCount === 0) {
                    strengthLabel.textContent = 'Password strength';
                    strengthLabel.style.color = '#6b7280';
                } else if (validCount <= 2) {
                    strengthFill.classList.add('strength-weak');
                    strengthLabel.textContent = 'Weak';
                    strengthLabel.style.color = '#dc2626';
                } else if (validCount <= 3) {
                    strengthFill.classList.add('strength-fair');
                    strengthLabel.textContent = 'Fair';
                    strengthLabel.style.color = '#f59e0b';
                } else if (validCount <= 4) {
                    strengthFill.classList.add('strength-good');
                    strengthLabel.textContent = 'Good';
                    strengthLabel.style.color = '#10b981';
                } else {
                    strengthFill.classList.add('strength-strong');
                    strengthLabel.textContent = 'Strong';
                    strengthLabel.style.color = '#16a34a';
                }

                return validCount === 5;
            }

            function checkPasswordMatch() {
                const password = passwordInput.value;
                const confirm = confirmInput.value;
                
                if (confirm === '') {
                    passwordMatch.textContent = '';
                    return false;
                } else if (password === confirm) {
                    passwordMatch.textContent = '✓ Passwords match';
                    passwordMatch.style.color = '#16a34a';
                    return true;
                } else {
                    passwordMatch.textContent = '✗ Passwords do not match';
                    passwordMatch.style.color = '#dc2626';
                    return false;
                }
            }

            function updateSubmitButton() {
                const isStrongPassword = updateStrength(passwordInput.value);
                const passwordsMatch = checkPasswordMatch();
                
                submitBtn.disabled = !(isStrongPassword && passwordsMatch && confirmInput.value !== '');
            }

            passwordInput.addEventListener('input', updateSubmitButton);
            confirmInput.addEventListener('input', updateSubmitButton);

            // Form submission
            document.getElementById('resetForm').addEventListener('submit', function(e) {
                if (submitBtn.disabled) {
                    e.preventDefault();
                    return false;
                }
                
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Resetting Password...';
                submitBtn.disabled = true;
            });
        });
    </script>
</body>
</html>