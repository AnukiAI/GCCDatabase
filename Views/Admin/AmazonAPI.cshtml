    <script>
        function toggleAdvancedOptions() {
            const content = document.getElementById('advanced-content');
            const button = document.querySelector('.toggle-advanced');

            if (content.classList.contains('show')) {
                content.classList.remove('show');
                button.textContent = 'Show Advanced Options';
            } else {
                content.classList.add('show');
                button.textContent = 'Hide Advanced Options';
            }
        }

        // Show keyboard shortcuts on hover over help icon
        document.addEventListener('mouseover', function(e) {
            if (e.target.classList.contains('fa-question-circle')) {
                document.getElementById('shortcuts-help').classList.add('show');
            }
        });

        document.addEventListener('mouseout', function(e) {
            if (e.target.classList.contains('fa-question-circle')) {
                document.getElementById('shortcuts-help').classList.remove('show');
            }
        });

        // Add help icon to header
        const headerElement = document.querySelector('.section-title');
        if (headerElement) {
            headerElement.innerHTML += ' <i class="fas fa-question-circle" style="font-size: 0.6em; cursor: help;"></i>';
        }
    </script>