@{
    ViewData["Title"] = "GreenCircle API Management";
    ViewData["BodyClass"] = "admin-greencircle-api";
}

@section Styles {
    <link href="~/css/amazon-api.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">API Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Amazon API Integration</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="buttons-area">
            <button class="btn" onclick="testApiEndpoint()" aria-label="Test API endpoint">
                <i class="fas fa-vial" aria-hidden="true"></i> Test API
            </button>
            <button class="btn btn-add" onclick="generateApiKey()" aria-label="Generate new API key">
                <i class="fas fa-key" aria-hidden="true"></i> Generate API Key
            </button>
        </div>
    </header>

    <!-- Summary Statistics -->
    <div class="stats-container">
        <div class="stat-card green">
            <div class="stat-value" id="api-status">Active</div>
            <div class="stat-label">API Status</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="total-requests">247</div>
            <div class="stat-label">Requests Today</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="success-rate">98%</div>
            <div class="stat-label">Success Rate</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="avg-response">125ms</div>
            <div class="stat-label">Avg Response Time</div>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="grid-layout">
        <!-- Main Content -->
        <div class="main-content">
            <!-- Configuration Section -->
            <section>
                <h2>API Configuration</h2>

                <div class="api-config">
                    <h4>GreenCircle API Settings</h4>
                    <div class="form-group">
                        <label>API Endpoint</label>
                        <input type="url" id="api-endpoint" value="https://api.greencircledb.com/v1/certifications" readonly>
                    </div>
                    <div class="form-group">
                        <label>API Access Key <span class="required">*</span></label>
                        <input type="password" id="api-key" placeholder="Enter GreenCircle API access key">
                    </div>
                    <div class="form-group">
                        <label>Amazon Partner ID</label>
                        <input type="text" id="partner-id" value="amazon_partner_2024" readonly>
                    </div>
                </div>

                <div class="status-indicator status-ready" id="connection-status">
                    <i class="fas fa-check-circle"></i>
                    API Ready for Requests
                </div>

                <div class="form-group">
                    <label for="rate-limit">Request Rate Limit</label>
                    <select id="rate-limit">
                        <option value="1000">1,000 requests/hour</option>
                        <option value="5000" selected>5,000 requests/hour</option>
                        <option value="10000">10,000 requests/hour</option>
                        <option value="unlimited">Unlimited</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" id="require-https" checked>
                        Require HTTPS for all requests
                    </label>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" id="enable-cors" checked>
                        Enable CORS for web applications
                    </label>
                </div>

                <div class="form-group">
                    <label for="ip-whitelist">IP Whitelist (Optional)</label>
                    <textarea id="ip-whitelist" rows="3" placeholder="Enter IP addresses separated by commas&#10;e.g., 192.168.1.1, 10.0.0.1, 52.0.0.0/8"></textarea>
                </div>
            </section>

            <!-- API Security Section -->
            <section>
                <h2>API Security & Access Control</h2>

                <div class="form-group">
                    <label for="api-key-expiry">API Key Expiry</label>
                    <select id="api-key-expiry">
                        <option value="30">30 days</option>
                        <option value="90" selected>90 days</option>
                        <option value="365">1 year</option>
                        <option value="never">Never expires</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Authentication Methods</label>
                    <div style="margin-top: 10px;">
                        <label style="display: block; margin-bottom: 5px;">
                            <input type="checkbox" checked> API Key Authentication
                        </label>
                        <label style="display: block; margin-bottom: 5px;">
                            <input type="checkbox"> OAuth 2.0
                        </label>
                        <label style="display: block;">
                            <input type="checkbox"> JWT Tokens
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Request Logging</label>
                    <div style="margin-top: 10px;">
                        <label style="display: block; margin-bottom: 5px;">
                            <input type="checkbox" checked> Log all requests
                        </label>
                        <label style="display: block; margin-bottom: 5px;">
                            <input type="checkbox" checked> Log failed requests
                        </label>
                        <label style="display: block;">
                            <input type="checkbox"> Log request payloads
                        </label>
                    </div>
                </div>
            </section>

            <!-- API Documentation Section -->
            <section>
                <h2>API Schema & Documentation</h2>

                <div class="json-preview" id="json-preview">
{
  "endpoint": "/api/v1/certifications",
  "method": "GET",
  "parameters": {
    "product_id": "string (ASIN, UPC, GTIN, etc.)",
    "certification_type": "string (optional)",
    "company_id": "string (optional)"
  },
  "response": {
    "status": "success",
    "data": [
      {
        "id": "cert_12345",
        "product_name": "EcoSmart LED Bulb",
        "product_ids": ["B08X7N9MRQ", "123456789012"],
        "certifications": [
          {
            "type": "Energy Savings",
            "agency": "GreenCircle",
            "status": "certified",
            "valid_until": "2025-12-31"
          }
        ]
      }
    ]
  }
}
                </div>

                <div class="action-buttons">
                    <button class="btn btn-success" onclick="testApiEndpoint()">
                        <i class="fas fa-vial"></i>
                        Test API Endpoint
                    </button>
                    <button class="btn btn-warning" onclick="refreshApiDocs()">
                        <i class="fas fa-sync"></i>
                        Refresh Documentation
                    </button>
                    <button class="btn btn-secondary" onclick="saveConfiguration()">
                        <i class="fas fa-save"></i>
                        Save Configuration
                    </button>
                    <button class="btn" onclick="exportApiDocs()">
                        <i class="fas fa-download"></i>
                        Export API Docs
                    </button>
                </div>

                <div class="response-preview" id="response-section" style="display: none;">
                    <h4>Test Response:</h4>
                    <div class="json-preview" id="api-response"></div>
                </div>
            </section>

            <!-- Activity Logs Section -->
            <section>
                <h2>API Request Logs</h2>

                <div class="logs-section" id="activity-logs">
                    <div class="log-entry log-info">
                        <strong>[2025-07-31 14:30:00]</strong> GreenCircle API service started successfully
                    </div>
                    <div class="log-entry log-success">
                        <strong>[2025-07-31 14:28:15]</strong> Amazon request processed - 12 certifications returned
                    </div>
                    <div class="log-entry log-info">
                        <strong>[2025-07-31 14:25:32]</strong> Incoming API request from Amazon partner system
                    </div>
                </div>

                <div style="margin-top: 15px;">
                    <button class="btn btn-secondary" onclick="clearLogs()">
                        <i class="fas fa-trash"></i>
                        Clear Logs
                    </button>
                    <button class="btn btn-secondary" onclick="exportLogs()">
                        <i class="fas fa-download"></i>
                        Export Logs
                    </button>
                </div>
            </section>
        </div>

        <!-- Side Panel -->
        <div class="side-panel">
            <!-- API Status -->
            <div class="panel-header">
                <h3 class="panel-title">API Status</h3>
            </div>
            <div class="panel-content">
                <div class="form-group">
                    <label for="api-status-panel">Service Status</label>
                    <div class="status-indicator status-ready" id="api-status-panel">
                        <i class="fas fa-check-circle"></i>
                        API Service Online
                    </div>
                </div>

                <div class="form-group">
                    <label>API Management</label>
                    <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
                        <button class="btn" onclick="refreshApiStatus()" style="width: 100%; justify-content: flex-start;">
                            <i class="fas fa-sync" aria-hidden="true"></i> Refresh Status
                        </button>
                        <button class="btn" onclick="testApiEndpoint()" style="width: 100%; justify-content: flex-start;">
                            <i class="fas fa-vial" aria-hidden="true"></i> Test Endpoint
                        </button>
                        <button class="btn" onclick="exportLogs()" style="width: 100%; justify-content: flex-start;">
                            <i class="fas fa-download" aria-hidden="true"></i> Export Logs
                        </button>
                    </div>
                </div>

                <button class="btn btn-primary" style="width: 100%; margin-top: 15px;" onclick="viewApiDocumentation()">
                    <i class="fas fa-book"></i> View API Docs
                </button>
            </div>

            <!-- Today's Activity -->
            <div class="panel-header" style="border-top: 1px solid #eee;">
                <h3 class="panel-title">Request Analytics</h3>
            </div>
            <div class="panel-content">
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span>Successful Requests:</span>
                    <strong id="successful-requests">242</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span>Failed Requests:</span>
                    <strong style="color: var(--warning);" id="failed-requests">5</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span>Certifications Served:</span>
                    <strong id="certifications-served">1,247</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span>Data Served:</span>
                    <strong id="data-served">8.2 MB</strong>
                </div>
            </div>

            <!-- Documentation Links -->
            <div class="panel-header" style="border-top: 1px solid #eee;">
                <h3 class="panel-title">Resources</h3>
            </div>
            <div class="panel-content">
                <a href="#" class="btn" style="width: 100%; margin-bottom: 8px; justify-content: flex-start;">
                    <i class="fas fa-book" aria-hidden="true"></i> GreenCircle API Docs
                </a>
                <a href="#" class="btn" style="width: 100%; margin-bottom: 8px; justify-content: flex-start;">
                    <i class="fas fa-code" aria-hidden="true"></i> Integration Guide
                </a>
                <a href="#" class="btn" style="width: 100%; margin-bottom: 8px; justify-content: flex-start;">
                    <i class="fas fa-shield-alt" aria-hidden="true"></i> Security Settings
                </a>
                <a href="#" class="btn" style="width: 100%; justify-content: flex-start;">
                    <i class="fas fa-life-ring" aria-hidden="true"></i> Support Center
                </a>
            </div>
        </div>
    </div>

    <!-- Loading Modal -->
    <div id="loading-modal" class="modal">
        <div class="modal-content">
            <h3>Sending to Amazon API...</h3>
            <div class="progress-bar">
                <div class="progress-fill" id="progress-fill"></div>
            </div>
            <p id="progress-text">Preparing payload...</p>
        </div>
    </div>

    <script>
        // Global variables
        let activityLogs = [];
        let validationResults = {};

        // Initialize the form
        document.addEventListener('DOMContentLoaded', function() {
            updateJsonPreview();
            attachEventListeners();
            loadSampleData();
        });

        function updateAPIEndpoint() {
            // This function is not used in the current implementation
            // as partner selection is not part of the interface
        }

        function attachEventListeners() {
            // Add event listeners for real-time JSON preview updates
            const inputs = document.querySelectorAll('input, select');
            inputs.forEach(input => {
                input.addEventListener('input', updateJsonPreview);
                input.addEventListener('change', updateJsonPreview);
            });

            // Partner selection listener removed as it's not part of the interface
        }

        function loadSampleData() {
            // Load sample data for demonstration
            document.getElementById('product-name').value = 'EcoSmart LED Bulb';
            document.getElementById('certification-country').value = 'US';
            document.getElementById('certification-agency').value = 'greencircle_energy_savings';
            document.getElementById('certification-end-date').value = '2025-12-31';
            document.getElementById('certification-status').value = 'certified';
            document.querySelector('[data-type="ASIN"]').value = 'B08X7N9MRQ';
            updateJsonPreview();
        }

        function updateJsonPreview() {
            const productName = document.getElementById('product-name').value;
            const certCountry = document.getElementById('certification-country').value;
            const certAgency = document.getElementById('certification-agency').value;
            const certStandard = document.getElementById('certification-standard').value;
            const certValue = document.getElementById('certification-value').value;
            const certEndDate = document.getElementById('certification-end-date').value;
            const certStatus = document.getElementById('certification-status').value;

            const productIds = getProductIds();
            const payload = [];

            productIds.forEach(id => {
                if (id.value.trim()) {
                    payload.push({
                        "product_name": productName || "",
                        "product_id_type": id.type,
                        "product_id": id.value,
                        "certification_country": certCountry || "",
                        "certification_agency": certAgency || "",
                        "certification_standard": certStandard || "",
                        "certification_value": certValue || "",
                        "certification_end_date": certEndDate || "",
                        "certification_status": certStatus || ""
                    });
                }
            });

            const jsonPreview = document.getElementById('json-preview');
            if (payload.length > 0) {
                jsonPreview.textContent = JSON.stringify(payload, null, 2);
            } else {
                jsonPreview.textContent = '{\n  "status": "Waiting for input...",\n  "payload": []\n}';
            }
        }

        function getProductIds() {
            const productIdElements = document.querySelectorAll('.product-id-value');
            const productIds = [];

            productIdElements.forEach(element => {
                if (element.value.trim()) {
                    productIds.push({
                        type: element.getAttribute('data-type'),
                        value: element.value.trim()
                    });
                }
            });

            return productIds;
        }

        function addProductId(type) {
            const container = document.getElementById('product-ids-container');
            const newItem = document.createElement('div');
            newItem.className = 'product-id-item';
            newItem.innerHTML = `
                <span class="product-id-type">${type}:</span>
                <input type="text" class="product-id-value" placeholder="Enter ${type}" data-type="${type}">
                <button type="button" class="remove-btn" onclick="removeProductId(this)">
                    <i class="fas fa-times"></i>
                </button>
            `;
            container.appendChild(newItem);

            // Add event listener for real-time updates
            const newInput = newItem.querySelector('.product-id-value');
            newInput.addEventListener('input', updateJsonPreview);

            addLog('info', `Added new ${type} field`);
        }

        function removeProductId(button) {
            const item = button.closest('.product-id-item');
            const type = item.querySelector('.product-id-type').textContent.replace(':', '');
            item.remove();
            updateJsonPreview();
            addLog('info', `Removed ${type} field`);
        }

        function validatePayload() {
            const productName = document.getElementById('product-name').value;
            const certCountry = document.getElementById('certification-country').value;
            const certAgency = document.getElementById('certification-agency').value;
            const certEndDate = document.getElementById('certification-end-date').value;
            const certStatus = document.getElementById('certification-status').value;
            const apiKey = document.getElementById('api-key').value;

            const errors = [];
            const warnings = [];

            // Required field validation
            if (!productName.trim()) errors.push('Product Name is required');
            if (!certCountry) errors.push('Certification Country is required');
            if (!certAgency) errors.push('Certification Agency is required');
            if (!certEndDate) errors.push('Certification End Date is required');
            if (!certStatus) errors.push('Certification Status is required');
            if (!apiKey.trim()) errors.push('API Key is required');

            // Product ID validation
            const productIds = getProductIds();
            if (productIds.length === 0) {
                errors.push('At least one Product ID is required');
            }

            // ASIN validation for Amazon API
            if (!productIds.some(id => id.type === 'ASIN')) {
                warnings.push('Amazon typically requires ASIN product identifiers');
            }

            // Date validation
            if (certEndDate) {
                const endDate = new Date(certEndDate);
                const today = new Date();
                if (endDate < today && certStatus === 'certified') {
                    warnings.push('Certification end date is in the past for a certified product');
                }
            }

            // Product ID format validation
            productIds.forEach(id => {
                if (id.type === 'ASIN' && !/^[A-Z0-9]{10}$/.test(id.value)) {
                    warnings.push(`ASIN ${id.value} may not be in correct format (should be 10 alphanumeric characters)`);
                }
                if (id.type === 'UPC' && !/^\d{12}$/.test(id.value)) {
                    warnings.push(`UPC ${id.value} may not be in correct format (should be 12 digits)`);
                }
                if (id.type === 'GTIN' && !/^\d{8,14}$/.test(id.value)) {
                    warnings.push(`GTIN ${id.value} may not be in correct format (should be 8-14 digits)`);
                }
                if (id.type === 'EAN' && !/^\d{13}$/.test(id.value)) {
                    warnings.push(`EAN ${id.value} may not be in correct format (should be 13 digits)`);
                }
            });

            // Rate limiting check (simulate)
            const lastRequestTime = localStorage.getItem('lastAPIRequest');
            if (lastRequestTime) {
                const timeDiff = Date.now() - parseInt(lastRequestTime);
                if (timeDiff < 600) { // Less than 1 second
                    warnings.push('Rate limiting: Please wait before making another request');
                }
            }

            // Update status indicator
            const statusElement = document.getElementById('connection-status');
            if (errors.length > 0) {
                statusElement.className = 'status-indicator status-error';
                statusElement.innerHTML = '<i class="fas fa-exclamation-circle"></i> Validation Failed';
                addLog('error', `Validation failed: ${errors.join(', ')}`);
            } else if (warnings.length > 0) {
                statusElement.className = 'status-indicator status-sending';
                statusElement.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Warnings Found';
                addLog('info', `Validation passed with warnings: ${warnings.join(', ')}`);
            } else {
                statusElement.className = 'status-indicator status-ready';
                statusElement.innerHTML = '<i class="fas fa-check-circle"></i> Validation Passed';
                addLog('success', 'Payload validation successful');
            }

            validationResults = { errors, warnings };
            return errors.length === 0;
        }

        function sendToAmazon() {
            if (!validatePayload()) {
                alert('Please fix validation errors before sending.');
                return;
            }

            const modal = document.getElementById('loading-modal');
            const progressFill = document.getElementById('progress-fill');
            const progressText = document.getElementById('progress-text');

            modal.style.display = 'block';
            progressFill.style.width = '0%';

            addLog('info', 'Starting transmission to Amazon API...');

            // Simulate API call with progress
            let progress = 0;
            const interval = setInterval(() => {
                progress += Math.random() * 15;
                if (progress > 100) progress = 100;

                progressFill.style.width = progress + '%';

                if (progress < 30) {
                    progressText.textContent = 'Authenticating with Amazon API...';
                } else if (progress < 60) {
                    progressText.textContent = 'Sending certification data...';
                } else if (progress < 90) {
                    progressText.textContent = 'Processing response...';
                } else {
                    progressText.textContent = 'Finalizing...';
                }

                if (progress >= 100) {
                    clearInterval(interval);
                    setTimeout(() => {
                        modal.style.display = 'none';
                        showApiResponse();
                    }, 500);
                }
            }, 200);
        }

        function showApiResponse() {
            const responseSection = document.getElementById('response-section');
            const apiResponse = document.getElementById('api-response');

            // Simulate API response (with potential errors for demo)
            const isSuccess = Math.random() > 0.2; // 80% success rate

            if (isSuccess) {
                const mockResponse = {
                    "status": "success",
                    "message": "Certification data sent successfully",
                    "timestamp": new Date().toISOString(),
                    "records_processed": getProductIds().length,
                    "partner_reference_id": getPartnerReferenceId(),
                    "processing_time_ms": Math.floor(Math.random() * 500) + 200,
                    "rate_limit_remaining": 95,
                    "rate_limit_reset": new Date(Date.now() + 60000).toISOString()
                };

                apiResponse.textContent = JSON.stringify(mockResponse, null, 2);
                addLog('success', `Successfully sent ${getProductIds().length} product certification(s) to Amazon`);
                addLog('info', `Partner Reference ID: ${mockResponse.partner_reference_id}`);

                // Store last request time for rate limiting
                localStorage.setItem('lastAPIRequest', Date.now().toString());
            } else {
                // Simulate various error types
                const errorTypes = [
                    {
                        "status": "error",
                        "error": {
                            "code": "authentication_failed",
                            "message": "Invalid API key",
                            "details": "The provided API key is not valid or has been revoked"
                        }
                    },
                    {
                        "status": "error",
                        "error": {
                            "code": "rate_limit_exceeded",
                            "message": "Too many requests",
                            "details": "Rate limit of 100 requests per minute exceeded. Please wait before retrying.",
                            "retry_after": 45
                        }
                    },
                    {
                        "status": "error",
                        "error": {
                            "code": "validation_failed",
                            "message": "Invalid product identifier",
                            "details": "ASIN format is invalid - must be 10 alphanumeric characters"
                        }
                    }
                ];

                const randomError = errorTypes[Math.floor(Math.random() * errorTypes.length)];
                apiResponse.textContent = JSON.stringify(randomError, null, 2);
                addLog('error', `API Error: ${randomError.error.message}`);
                addLog('error', randomError.error.details);
            }

            responseSection.style.display = 'block';

            // Update status
            const statusElement = document.getElementById('connection-status');
            if (isSuccess) {
                statusElement.className = 'status-indicator status-ready';
                statusElement.innerHTML = '<i class="fas fa-check-circle"></i> Transmission Complete';
            } else {
                statusElement.className = 'status-indicator status-error';
                statusElement.innerHTML = '<i class="fas fa-exclamation-circle"></i> Transmission Failed';
            }
        }

        function getPartnerReferenceId() {
            const prefix = 'AMZ';
            return `${prefix}-` + Math.random().toString(36).substr(2, 9).toUpperCase();
        }

        function saveAsDraft() {
            const draftData = {
                product_name: document.getElementById('product-name').value,
                certification_country: document.getElementById('certification-country').value,
                certification_agency: document.getElementById('certification-agency').value,
                certification_standard: document.getElementById('certification-standard').value,
                certification_value: document.getElementById('certification-value').value,
                certification_end_date: document.getElementById('certification-end-date').value,
                certification_status: document.getElementById('certification-status').value,
                product_ids: getProductIds(),
                saved_at: new Date().toISOString()
            };

            // In a real implementation, this would save to backend
            localStorage.setItem('amazon_api_draft', JSON.stringify(draftData));
            addLog('info', 'Draft saved successfully');

            alert('Draft saved successfully!');
        }

        function loadDraft() {
            const draft = localStorage.getItem('amazon_api_draft');
            if (draft) {
                const draftData = JSON.parse(draft);

                document.getElementById('product-name').value = draftData.product_name || '';
                document.getElementById('certification-country').value = draftData.certification_country || '';
                document.getElementById('certification-agency').value = draftData.certification_agency || '';
                document.getElementById('certification-standard').value = draftData.certification_standard || '';
                document.getElementById('certification-value').value = draftData.certification_value || '';
                document.getElementById('certification-end-date').value = draftData.certification_end_date || '';
                document.getElementById('certification-status').value = draftData.certification_status || '';

                // Clear existing product IDs and load from draft
                const container = document.getElementById('product-ids-container');
                container.innerHTML = '';

                if (draftData.product_ids && draftData.product_ids.length > 0) {
                    draftData.product_ids.forEach(id => {
                        addProductId(id.type);
                        const newInput = container.lastElementChild.querySelector('.product-id-value');
                        newInput.value = id.value;
                    });
                } else {
                    // Add default ASIN field if no product IDs in draft
                    addProductId('ASIN');
                }

                updateJsonPreview();
                addLog('success', 'Draft loaded successfully');
            } else {
                addLog('info', 'No draft found');
                alert('No saved draft found.');
            }
        }

        function clearForm() {
            if (confirm('Are you sure you want to clear all form data?')) {
                document.getElementById('product-name').value = '';
                document.getElementById('certification-country').value = '';
                document.getElementById('certification-agency').value = '';
                document.getElementById('certification-standard').value = '';
                document.getElementById('certification-value').value = '';
                document.getElementById('certification-end-date').value = '';
                document.getElementById('certification-status').value = '';

                // Reset product IDs to single ASIN field
                const container = document.getElementById('product-ids-container');
                container.innerHTML = `
                    <div class="product-id-item">
                        <span class="product-id-type">ASIN:</span>
                        <input type="text" class="product-id-value" placeholder="e.g., B08X7N9MRQ" data-type="ASIN">
                        <button type="button" class="remove-btn" onclick="removeProductId(this)">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;

                // Re-attach event listener
                const newInput = container.querySelector('.product-id-value');
                newInput.addEventListener('input', updateJsonPreview);

                // Hide response section
                document.getElementById('response-section').style.display = 'none';

                // Reset status
                const statusElement = document.getElementById('connection-status');
                statusElement.className = 'status-indicator status-ready';
                statusElement.innerHTML = '<i class="fas fa-check-circle"></i> Ready to Send';

                updateJsonPreview();
                addLog('info', 'Form cleared successfully');
            }
        }

        function addLog(type, message) {
            const timestamp = new Date().toLocaleString();
            const logEntry = {
                timestamp: timestamp,
                type: type,
                message: message
            };

            activityLogs.push(logEntry);

            const logsContainer = document.getElementById('activity-logs');
            const logElement = document.createElement('div');
            logElement.className = `log-entry log-${type}`;
            logElement.innerHTML = `<strong>[${timestamp}]</strong> ${message}`;

            logsContainer.appendChild(logElement);
            logsContainer.scrollTop = logsContainer.scrollHeight;

            // Keep only last 50 logs
            if (activityLogs.length > 50) {
                activityLogs.shift();
                logsContainer.removeChild(logsContainer.firstElementChild);
            }
        }

        function clearLogs() {
            if (confirm('Are you sure you want to clear all activity logs?')) {
                activityLogs = [];
                document.getElementById('activity-logs').innerHTML = '';
                addLog('info', 'Activity logs cleared');
            }
        }

        function exportLogs() {
            if (activityLogs.length === 0) {
                alert('No logs to export.');
                return;
            }

            const logText = activityLogs.map(log =>
                `[${log.timestamp}] ${log.type.toUpperCase()}: ${log.message}`
            ).join('\n');

            const blob = new Blob([logText], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `amazon_api_logs_${new Date().toISOString().slice(0, 10)}.txt`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);

            addLog('info', 'Activity logs exported successfully');
        }

        function testConnection() {
            const apiKey = document.getElementById('api-key').value;
            if (!apiKey.trim()) {
                alert('Please enter an API key to test the connection.');
                return;
            }

            addLog('info', 'Testing connection to Amazon API...');

            // Simulate connection test
            setTimeout(() => {
                const success = Math.random() > 0.2; // 80% success rate for demo

                if (success) {
                    addLog('success', 'Connection test successful');
                    const statusElement = document.getElementById('connection-status');
                    statusElement.className = 'status-indicator status-ready';
                    statusElement.innerHTML = '<i class="fas fa-check-circle"></i> Connection Verified';
                } else {
                    addLog('error', 'Connection test failed - check API key and network');
                    const statusElement = document.getElementById('connection-status');
                    statusElement.className = 'status-indicator status-error';
                    statusElement.innerHTML = '<i class="fas fa-exclamation-circle"></i> Connection Failed';
                }
            }, 1500);
        }

        function bulkImport() {
            // Note: Bulk upload capabilities are out of scope for this phase
            // This feature is disabled per project requirements
            addLog('info', 'Bulk import feature is not available in current scope');
            alert('Bulk import functionality is not included in the current project scope. Please enter data manually or contact your administrator for future enhancements.');
        }

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey || e.metaKey) {
                switch(e.key) {
                    case 's':
                        e.preventDefault();
                        saveAsDraft();
                        break;
                    case 'Enter':
                        e.preventDefault();
                        if (e.shiftKey) {
                            sendToAmazon();
                        } else {
                            validatePayload();
                        }
                        break;
                    case 'r':
                        e.preventDefault();
                        clearForm();
                        break;
                }
            }
        });

        // Auto-save draft every 30 seconds
        setInterval(() => {
            const productName = document.getElementById('product-name').value;
            if (productName.trim()) {
                saveAsDraft();
            }
        }, 30000);

        // Connection status check every 60 seconds
        setInterval(() => {
            const apiKey = document.getElementById('api-key').value;
            if (apiKey.trim()) {
                // Simulate periodic connection check
                const isConnected = Math.random() > 0.1; // 90% uptime
                const statusElement = document.getElementById('connection-status');

                if (!isConnected && statusElement.classList.contains('status-ready')) {
                    statusElement.className = 'status-indicator status-error';
                    statusElement.innerHTML = '<i class="fas fa-exclamation-circle"></i> Connection Lost';
                    addLog('error', 'Lost connection to Amazon API');
                } else if (isConnected && statusElement.classList.contains('status-error')) {
                    statusElement.className = 'status-indicator status-ready';
                    statusElement.innerHTML = '<i class="fas fa-check-circle"></i> Connection Restored';
                    addLog('success', 'Connection to Amazon API restored');
                }
            }
        }, 60000);
    </script>

