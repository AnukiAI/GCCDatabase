@{
    ViewData["Title"] = "CSF Attributes";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>CSF Attributes</h1>
            <p class="text-muted">Manage Certificate Sustainability Features (CSF) attributes</p>
            
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                This is a placeholder view for CSF Attributes Management. The full implementation will include management of sustainability attributes for certificates.
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h5>CSF Attributes Overview</h5>
                </div>
                <div class="card-body">
                    <p>Features coming soon:</p>
                    <ul>
                        <li>List of all CSF attributes (Biobased, Biodegradable, etc.)</li>
                        <li>Create new sustainability attributes</li>
                        <li>Edit attribute descriptions</li>
                        <li>Enable/disable attributes</li>
                        <li>Attribute usage statistics</li>
                        <li>Category grouping for attributes</li>
                        <li>Import/export attribute definitions</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>