@{
    ViewData["Title"] = "Certificate Field Management";
    ViewData["BodyClass"] = "admin-certificate-fields";
}

@section Styles {
    <link href="~/css/certificate-fields.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Data Management</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Certificate Fields</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="buttons-area">
            <button class="btn btn-export" id="export-btn">
                <i class="fas fa-download"></i> Export
            </button>
            <button class="btn btn-add" id="add-field-btn">
                <i class="fas fa-plus"></i> Add New Field
            </button>
        </div>
    </header>

    <div class="search-filter-bar">
        <div class="search-box">
            <input type="text" id="search-input" placeholder="Search fields...">
            <i class="fas fa-search search-icon"></i>
        </div>
    </div>


    <div class="table-container">
        <table id="certificate-fields-table">
            <thead>
                <tr>
                    <th width="15%">Section <span class="info-icon">i</span></th>
                    <th width="18%">Field Name <span class="info-icon">i</span></th>
                    <th width="12%">Control Type <span class="info-icon">i</span></th>
                    <th width="12%">Required <span class="info-icon">i</span></th>
                    <th width="33%">Notes <span class="info-icon">i</span></th>
                    <th width="10%">Actions</th>
                </tr>
            </thead>
            <tbody id="fields-table-body">
                <!-- Fields will be populated by JavaScript -->
            </tbody>
        </table>
    </div>

    <div class="footer-info">
        <span id="field-count">Showing 0 of 0 fields</span>
        <div>
            <button class="btn btn-outline" id="show-more-btn" style="display: none;">
                <i class="fas fa-chevron-down"></i> Show More
            </button>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container"></div>

@section Scripts {
    <script>
        // Certificate Fields Management System
        document.addEventListener('DOMContentLoaded', function() {
        // Sample data based on wireframe requirements
        let fields = [
            // Core Certificate Information
            { id: 1, section: "Core Certificate Information", name: "Certificate #", type: "text", required: "Optional", notes: "Auto-generated if left blank", order: 1 },
            { id: 2, section: "Core Certificate Information", name: "Certification Type", type: "dropdown", required: "Required", notes: "Type of certification issued", order: 2 },
            { id: 3, section: "Core Certificate Information", name: "CSF Attributes", type: "multi-select", required: "Optional", notes: "Certification specific framework attributes", order: 3 },
            { id: 4, section: "Core Certificate Information", name: "Status", type: "dropdown", required: "Required", notes: "Required for public visibility", order: 4 },
            { id: 5, section: "Core Certificate Information", name: "Effective Date", type: "date", required: "Required", notes: "When the certification becomes effective", order: 5 },
            { id: 6, section: "Core Certificate Information", name: "Expiration Date", type: "date", required: "Required", notes: "When the certification expires", order: 6 },
            
            // Company Information
            { id: 7, section: "Company Information", name: "Company", type: "text", required: "Required", notes: "Company receiving certification", order: 7 },
            { id: 8, section: "Company Information", name: "Company Contact Email", type: "text", required: "Optional", notes: "Company email contact", order: 8 },
            { id: 9, section: "Company Information", name: "Company Contact URL", type: "text", required: "Optional", notes: "Company website URL", order: 9 },
            
            // Product Information
            { id: 10, section: "Product Information", name: "Product Name", type: "text", required: "Required", notes: "Name of the certified product", order: 10 },
            { id: 11, section: "Product Information", name: "Product Category", type: "dropdown", required: "Required", notes: "Main category of the product", order: 11 },
            { id: 12, section: "Product Information", name: "Product Type", type: "dropdown", required: "Required", notes: "Specific type within category", order: 12 },
            { id: 13, section: "Product Information", name: "Product Type Subcategory", type: "dropdown", required: "Required", notes: "Subcategory within product type", order: 13 },
            { id: 14, section: "Product Information", name: "Location", type: "text", required: "Optional", notes: "Manufacturing or certification location", order: 14 },
            { id: 15, section: "Product Information", name: "Country", type: "dropdown", required: "Required", notes: "Country of origin", order: 15 },
            
            // Product Identifiers
            { id: 16, section: "Product Identifiers", name: "ASIN", type: "text", required: "Optional", notes: "Amazon Standard Identification Number", order: 16 },
            { id: 17, section: "Product Identifiers", name: "UPC", type: "text", required: "Optional", notes: "Universal Product Code", order: 17 },
            { id: 18, section: "Product Identifiers", name: "GTIN", type: "text", required: "Optional", notes: "Global Trade Item Number", order: 18 },
            { id: 19, section: "Product Identifiers", name: "EAN", type: "text", required: "Optional", notes: "European Article Number", order: 19 },
            
            // Tagging & Classification
            { id: 20, section: "Tagging & Classification", name: "External Tag", type: "multi-select", required: "Optional", notes: "External classification tags", order: 20 },
            { id: 21, section: "Tagging & Classification", name: "Internal Tag", type: "multi-select", required: "Optional", notes: "Internal classification tags", order: 21 },
            
            // New Required Fields
            { id: 22, section: "New Required Fields", name: "Partner", type: "multi-select", required: "Required", notes: "Amazon/Wayfair/None/Other partners", order: 22 },
            { id: 23, section: "New Required Fields", name: "Status Type", type: "dropdown", required: "Optional", notes: "To signify if client doesn't want to move forward", order: 23 },
            
            // File Management
            { id: 24, section: "File Management", name: "Certificate Upload", type: "file", required: "Optional", notes: "Upload certificate document", order: 24 },
            { id: 25, section: "File Management", name: "Preview", type: "system-generated", required: "Auto", notes: "Certificate preview/thumbnail", order: 25 },
            
            // Record Management
            { id: 26, section: "Record Management", name: "Record Created Date", type: "date", required: "Auto-generated", notes: "When record was created", order: 26 },
            { id: 27, section: "Record Management", name: "Record Last Updated Date", type: "date", required: "Auto-generated", notes: "When record was last modified", order: 27 },
            { id: 28, section: "Record Management", name: "Last Edited By", type: "system-generated", required: "Auto", notes: "User who last edited the record", order: 28 }
        ];

        // DOM Elements
        const fieldsTableBody = document.getElementById('fields-table-body');
        const fieldCountElement = document.getElementById('field-count');
        const searchInput = document.getElementById('search-input');
        const addFieldBtn = document.getElementById('add-field-btn');
        const showMoreBtn = document.getElementById('show-more-btn');

        // State variables
        let currentEditingId = null;
        let filteredFields = [...fields];
        let displayedFields = [];
        const initialDisplayCount = 7;
        let isShowingAll = false;

        // Initialize the application
        function init() {
            renderFields();
            bindEvents();
        }

        // Bind event listeners
        function bindEvents() {
            addFieldBtn.addEventListener('click', startAddNew);
            searchInput.addEventListener('input', debounce(handleSearch, 300));
            showMoreBtn.addEventListener('click', showAllFields);

            // Add event delegation for edit/delete buttons
            fieldsTableBody.addEventListener('click', handleTableClick);
        }

        // Start adding a new field inline
        function startAddNew() {
            if (currentEditingId !== null) {
                cancelEdit();
            }

            // Create a new field object with default values
            const newId = fields.length > 0 ? Math.max(...fields.map(f => f.id)) + 1 : 1;
            const newField = {
                id: newId,
                section: 'Core Certificate Information',
                name: '',
                type: 'text',
                required: 'Optional',
                notes: '',
                order: getNextOrder()
            };

            // Create a new row
            const newRow = document.createElement('tr');
            newRow.setAttribute('data-id', newId);

            // Render as an edit row
            renderEditRow(newRow, newField);

            // Add at the top of the table
            if (fieldsTableBody.firstChild) {
                fieldsTableBody.insertBefore(newRow, fieldsTableBody.firstChild);
            } else {
                fieldsTableBody.appendChild(newRow);
            }

            // Set editing state
            currentEditingId = newId;
            
            // Focus the name input
            setTimeout(() => {
                const nameInput = newRow.querySelector('.edit-input');
                if (nameInput) nameInput.focus();
            }, 0);
        }

        // Add new field to the data
        function addField(formData) {
            const newField = {
                id: Math.max(...fields.map(f => f.id)) + 1,
                ...formData
            };

            fields.push(newField);
            fields.sort((a, b) => a.order - b.order);
            filteredFields = [...fields];
            renderFields();
            showToast('Certificate field added successfully', 'success');
        }

        // Update existing field
        function updateField(id, formData) {
            const fieldIndex = fields.findIndex(f => f.id === id);
            if (fieldIndex !== -1) {
                fields[fieldIndex] = { ...fields[fieldIndex], ...formData };
                fields.sort((a, b) => a.order - b.order);
                filteredFields = [...fields];
                renderFields();
                hideAddForm();
                showToast('Certificate field updated successfully', 'success');
            }
        }

        // Get next order number
        function getNextOrder() {
            return Math.max(...fields.map(f => f.order), 0) + 1;
        }

        // Handle table click events
        function handleTableClick(e) {
            const target = e.target.closest('button');
            if (!target) return;

            const row = target.closest('tr');
            const fieldId = parseInt(row.dataset.id);

            if (target.classList.contains('edit-btn')) {
                editField(fieldId);
            } else if (target.classList.contains('delete-btn')) {
                deleteField(fieldId);
            } else if (target.classList.contains('save-btn')) {
                saveInlineEdit(fieldId);
            } else if (target.classList.contains('cancel-btn')) {
                cancelInlineEdit(fieldId);
            }
        }

        // Edit field inline
        function editField(id) {
            if (currentEditingId && currentEditingId !== id) {
                cancelInlineEdit(currentEditingId);
            }

            const field = fields.find(f => f.id === id);
            if (!field) return;

            currentEditingId = id;
            const row = document.querySelector(`tr[data-id="${id}"]`);
            renderEditRow(row, field);
        }

        // Delete field
        function deleteField(id) {
            const field = fields.find(f => f.id === id);
            if (!field) return;

            if (confirm(`Are you sure you want to delete the field "${field.name}"?`)) {
                fields = fields.filter(f => f.id !== id);
                filteredFields = filteredFields.filter(f => f.id !== id);
                renderFields();
                showToast('Certificate field deleted successfully', 'success');
            }
        }

        // Save inline edit
        function saveInlineEdit(id) {
            const row = document.querySelector(`tr[data-id="${id}"]`);
            const inputs = row.querySelectorAll('.edit-input, .edit-select');

            const updatedData = {
                section: inputs[0].value,
                name: inputs[1].value.trim(),
                type: inputs[2].value,
                required: inputs[3].value,
                notes: inputs[4].value.trim()
            };

            if (!updatedData.section || !updatedData.name || !updatedData.type || !updatedData.required) {
                showToast('Please fill in all required fields', 'error');
                return;
            }

            // Check for duplicate names
            if (fields.some(field => field.name.toLowerCase() === updatedData.name.toLowerCase() && field.id !== id)) {
                showToast('A field with this name already exists', 'error');
                return;
            }

            // Check if this is a new field (not in the original fields array) or existing field
            const existingField = fields.find(f => f.id === id);
            if (existingField) {
                // Update existing field
                updateField(id, updatedData);
            } else {
                // Add new field
                updatedData.id = id;
                updatedData.order = getNextOrder();
                addField(updatedData);
            }
            
            currentEditingId = null;
        }

        // Cancel inline edit
        function cancelInlineEdit(id) {
            const existingField = fields.find(f => f.id === id);
            
            if (!existingField) {
                // This is a new field that was being added - just remove the row
                const row = document.querySelector(`tr[data-id="${id}"]`);
                if (row) {
                    row.remove();
                }
            } else {
                // This is an existing field being edited - revert to normal view
                renderFields();
            }
            
            currentEditingId = null;
        }

        // Render fields table
        function renderFields() {
            fieldsTableBody.innerHTML = '';

            displayedFields = isShowingAll ? filteredFields : filteredFields.slice(0, initialDisplayCount);

            displayedFields.forEach(field => {
                const row = document.createElement('tr');
                row.setAttribute('data-id', field.id);

                if (currentEditingId === field.id) {
                    renderEditRow(row, field);
                } else {
                    renderNormalRow(row, field);
                }

                fieldsTableBody.appendChild(row);
            });

            updateFieldCount();
            updateShowMoreButton();
        }

        // Render normal row
        function renderNormalRow(row, field) {
            row.innerHTML = `
                <td style="font-size: 13px; color: #666;">${field.section}</td>
                <td>${field.name}</td>
                <td><span class="field-type type-${field.type.toLowerCase().replace(/[-\s]/g, '')}">${formatFieldType(field.type)}</span></td>
                <td><span class="required-label required-${field.required.toLowerCase().replace('-', '')}">${field.required}</span></td>
                <td>${field.notes || ''}</td>
                <td>
                    <div class="action-buttons">
                        <button class="action-btn edit-btn" title="Edit Field">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="action-btn delete-btn" title="Delete Field">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </td>
            `;
        }

        // Render edit row
        function renderEditRow(row, field) {
            row.classList.add('edit-row');

            const sections = [
                'Core Certificate Information',
                'Company Information',
                'Product Information',
                'Product Identifiers',
                'Tagging & Classification',
                'New Required Fields',
                'File Management',
                'Record Management'
            ];
            const controlTypes = ['text', 'dropdown', 'multi-select', 'date', 'file', 'number', 'checkbox', 'system-generated'];
            const requiredOptions = ['Required', 'Optional', 'Auto-generated', 'Auto'];

            row.innerHTML = `
                <td>
                    <select class="edit-select" required>
                        ${sections.map(section =>
                            `<option value="${section}" ${section === field.section ? 'selected' : ''}>${section}</option>`
                        ).join('')}
                    </select>
                </td>
                <td>
                    <input type="text" class="edit-input" value="${field.name}" required>
                </td>
                <td>
                    <select class="edit-select" required>
                        ${controlTypes.map(type =>
                            `<option value="${type}" ${type === field.type ? 'selected' : ''}>${formatFieldType(type)}</option>`
                        ).join('')}
                    </select>
                </td>
                <td>
                    <select class="edit-select" required>
                        ${requiredOptions.map(option =>
                            `<option value="${option}" ${option === field.required ? 'selected' : ''}>${option}</option>`
                        ).join('')}
                    </select>
                </td>
                <td>
                    <input type="text" class="edit-input" value="${field.notes || ''}" placeholder="Optional notes">
                </td>
                <td>
                    <div class="action-buttons edit-actions">
                        <button class="action-btn save-btn" title="Save Changes">
                            <i class="fas fa-check"></i>
                        </button>
                        <button class="action-btn cancel-btn" title="Cancel Edit">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </td>
            `;
        }

        // Format field type for display
        function formatFieldType(type) {
            const typeMap = {
                'text': 'Text',
                'dropdown': 'Dropdown',
                'multi-select': 'Multi-Select',
                'date': 'Date',
                'file': 'File',
                'number': 'Number',
                'checkbox': 'Checkbox',
                'system-generated': 'System Generated'
            };
            return typeMap[type] || type;
        }

        // Handle search
        function handleSearch(e) {
            const searchTerm = e.target.value.toLowerCase().trim();

            if (searchTerm === '') {
                filteredFields = [...fields];
            } else {
                filteredFields = fields.filter(field =>
                    (field.section && field.section.toLowerCase().includes(searchTerm)) ||
                    field.name.toLowerCase().includes(searchTerm) ||
                    field.type.toLowerCase().includes(searchTerm) ||
                    field.required.toLowerCase().includes(searchTerm) ||
                    (field.notes && field.notes.toLowerCase().includes(searchTerm))
                );
            }

            isShowingAll = false;
            renderFields();
        }

        // Show all fields
        function showAllFields() {
            isShowingAll = true;
            renderFields();
        }

        // Update field count
        function updateFieldCount() {
            const totalFields = filteredFields.length;
            const displayedCount = displayedFields.length;

            if (filteredFields.length !== fields.length) {
                fieldCountElement.textContent = `Showing ${displayedCount} of ${totalFields} filtered fields (${fields.length} total)`;
            } else {
                fieldCountElement.textContent = `Showing ${displayedCount} of ${totalFields} fields`;
            }
        }

        // Update show more button
        function updateShowMoreButton() {
            if (filteredFields.length > initialDisplayCount && !isShowingAll) {
                showMoreBtn.style.display = 'inline-flex';
                showMoreBtn.innerHTML = `<i class="fas fa-chevron-down"></i> Show ${filteredFields.length - initialDisplayCount} More`;
            } else {
                showMoreBtn.style.display = 'none';
            }
        }

        // Show toast notification
        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                <span>${message}</span>
            `;

            document.getElementById('toast-container').appendChild(toast);

            // Trigger animation
            setTimeout(() => toast.classList.add('show'), 100);

            // Remove toast after 3 seconds
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Debounce function for search
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Add tooltip functionality for info icons
        function addTooltips() {
            const tooltips = {
                'Field Name': 'The display name for this certificate field',
                'Control Type': 'The type of input control users will see',
                'Required': 'Whether this field must be filled out',
                'Notes': 'Additional information about this field'
            };

            document.querySelectorAll('.info-icon').forEach(icon => {
                const th = icon.closest('th');
                const columnName = th.textContent.trim().replace(' i', '');

                if (tooltips[columnName]) {
                    icon.title = tooltips[columnName];
                }
            });
        }

        // Initialize tooltips after DOM is ready
        setTimeout(addTooltips, 100);


        // Add double-click to edit functionality
        fieldsTableBody.addEventListener('dblclick', function(e) {
            const row = e.target.closest('tr');
            if (row && row.dataset.id && !row.classList.contains('edit-row')) {
                const fieldId = parseInt(row.dataset.id);
                editField(fieldId);
            }
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Escape key to cancel edits
            if (e.key === 'Escape') {
                if (currentEditingId) {
                    cancelInlineEdit(currentEditingId);
                }
            }

            // Ctrl/Cmd + N to add new field
            if ((e.ctrlKey || e.metaKey) && e.key === 'n') {
                e.preventDefault();
                startAddNew();
            }
        });


        // Initialize the application
        init();

        // Export functionality for future implementation
        window.CertificateFieldsManager = {
            getFields: () => [...fields],
            exportFields: () => {
                const dataStr = JSON.stringify(fields, null, 2);
                const dataBlob = new Blob([dataStr], {type: 'application/json'});
                const url = URL.createObjectURL(dataBlob);
                const link = document.createElement('a');
                link.href = url;
                link.download = 'certificate_fields.json';
                link.click();
                URL.revokeObjectURL(url);
            },
            importFields: (importedFields) => {
                if (Array.isArray(importedFields)) {
                    fields = importedFields.map((field, index) => ({
                        ...field,
                        id: field.id || index + 1,
                        order: field.order || index + 1
                    }));
                    filteredFields = [...fields];
                    renderFields();
                    showToast('Fields imported successfully', 'success');
                }
            }
        };
        });
    </script>
}