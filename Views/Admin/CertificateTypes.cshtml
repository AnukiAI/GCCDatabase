@{
    ViewData["Title"] = "Certificate Types";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>Certificate Types</h1>
            <p class="text-muted">Manage certificate types and their properties</p>
            
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
