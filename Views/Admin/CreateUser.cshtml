@model GCCWebApp.Models.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>Create User</h1>
            <p class="text-muted">Add a new user to the system</p>
            
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                This is a placeholder view for Create User. The full implementation will include a comprehensive user creation form with validation.
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h5>User Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateUser" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Name">Name</label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Email">Email</label>
                                    <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Role">Role</label>
                                    <select asp-for="Role" class="form-control">
                                        <option value="">Select a role</option>
                                        <option value="Admin">Admin</option>
                                        <option value="User">User</option>
                                        <option value="Partner">Partner</option>
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Password">Password</label>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <div class="form-check">
                                <input asp-for="RequirePasswordReset" class="form-check-input" type="checkbox" />
                                <label asp-for="RequirePasswordReset" class="form-check-label">
                                    Require password reset on first login
                                </label>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Create User</button>
                            <a href="@Url.Action("UserManagement")" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                    
                    <div class="mt-3">
                        <small class="text-muted">
                            Note: This is a placeholder form. The full implementation will include company and partner assignment options.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}