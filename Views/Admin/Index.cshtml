@model GCCWebApp.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["BodyClass"] = "admin-dashboard";
}

@section Styles {
    <link href="~/css/admin-dashboard.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Admin</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Dashboard</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="title-area">
            <h1>Admin Dashboard</h1>
            <p class="subtitle">System overview and management tools</p>
        </div>
    </header>

    <div class="dashboard-cards">
        <div class="card">
            <div class="card-header">
                <h3>Certificates</h3>
                <i class="fas fa-certificate"></i>
            </div>
            <div class="card-content">
                <div class="stat-number">@Model.TotalCertificates</div>
                <div class="stat-label">Total Certificates</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Companies</h3>
                <i class="fas fa-building"></i>
            </div>
            <div class="card-content">
                <div class="stat-number">@Model.TotalCompanies</div>
                <div class="stat-label">Total Companies</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Users</h3>
                <i class="fas fa-users"></i>
            </div>
            <div class="card-content">
                <div class="stat-number">@Model.TotalUsers</div>
                <div class="stat-label">Total Users</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Products</h3>
                <i class="fas fa-box"></i>
            </div>
            <div class="card-content">
                <div class="stat-number">@Model.TotalProducts</div>
                <div class="stat-label">Total Products</div>
            </div>
        </div>
    </div>

    <div class="quick-actions">
        <h2>Quick Actions</h2>
        <div class="actions-grid">
            <a href="@Url.Action("UserManagement", "Admin")" class="action-card">
                <i class="fas fa-users"></i>
                <span>Manage Users</span>
            </a>
            <a href="@Url.Action("RoleManagement", "Admin")" class="action-card">
                <i class="fas fa-user-shield"></i>
                <span>Manage Roles</span>
            </a>
            <a href="@Url.Action("ProductManagement", "Admin")" class="action-card">
                <i class="fas fa-box"></i>
                <span>Manage Products</span>
            </a>
            <a href="@Url.Action("CertificateTypes", "Admin")" class="action-card">
                <i class="fas fa-certificate"></i>
                <span>Certificate Types</span>
            </a>
            <a href="@Url.Action("Tags", "Admin")" class="action-card">
                <i class="fas fa-tags"></i>
                <span>Manage Tags</span>
            </a>
            <a href="@Url.Action("Partners", "Admin")" class="action-card">
                <i class="fas fa-handshake"></i>
                <span>Manage Partners</span>
            </a>
        </div>
    </div>
</div>