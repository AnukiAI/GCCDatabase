                    <span class="form-subtitle" id="formSubtitle">Categories contain Product Types</span>
                </div>

                <div class="form-cascade-info" id="cascadeInfo">
                    <i class="fas fa-info-circle"></i>
                    <span id="cascadeText">New categories can contain multiple product types and subcategories.</span>
                </div>

                <div class="form-row" id="parentRow" style="display: none;">
                    <div class="form-group">
                        <label class="form-label" id="parentLabel">Parent Category</label>
                        <select id="parentSelect" disabled>
                            <option value="">Select parent...</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" id="nameLabel">Category Name</label>
                        <input type="text" id="addInput" placeholder="Enter category name...">
                    </div>
                    <div class="form-group" id="statusGroup">
                        <label class="form-label">Status</label>
                        <select id="statusSelect">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-outline btn-sm" onclick="hideAddForm()">
