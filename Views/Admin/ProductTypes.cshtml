@{
    ViewData["Title"] = "Product Types";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>Product Types</h1>
            <p class="text-muted">Manage product type hierarchy and categories</p>
            
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                This is a placeholder view for Product Types Management. The full implementation will include hierarchical product type management with parent-child relationships.
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h5>Product Types Overview</h5>
                </div>
                <div class="card-body">
                    <p>Features coming soon:</p>
                    <ul>
                        <li>Hierarchical product type tree view</li>
                        <li>Create new product types and categories</li>
                        <li>Edit existing product types</li>
                        <li>Parent-child relationship management</li>
                        <li>Drag and drop sorting</li>
                        <li>Product count per type</li>
                        <li>Search and filter capabilities</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>