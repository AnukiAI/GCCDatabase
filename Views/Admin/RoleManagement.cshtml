@{
    ViewData["Title"] = "Role Management";
    ViewData["BodyClass"] = "admin-role-management";
}

@section Styles {
    <link href="~/css/role-management.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Administration</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Role Management</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="buttons-area">
            <button id="export-btn" class="btn">
                <i class="fas fa-download"></i> Export
            </button>
            <button id="add-role-btn" class="btn btn-add">
                <i class="fas fa-plus"></i> + Add New Role
            </button>
        </div>
    </header>

    <div class="search-filter-bar" style="width: 100% !important;">
        <div class="search-box" style="width: 100% !important; max-width: none !important;">
            <input type="text" id="search-input" placeholder="Search roles..." style="width: 100% !important; max-width: none !important;">
            <i class="fas fa-search search-icon"></i>
        </div>
    </div>

    <div class="table-container">
        <table id="role-table">
            <thead>
                <tr>
                    <th width="20%" data-sort="name">Role Name <span class="sort-icon">▼</span></th>
                    <th width="30%" data-sort="description">Description <span class="sort-icon">▼</span></th>
                    <th width="35%">Permissions</th>
                    <th width="10%" data-sort="users">Users <span class="sort-icon">▼</span></th>
                    <th width="5%">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be populated by JavaScript -->
            </tbody>
        </table>
    </div>

    <div class="footer-info">
        <span id="role-count">Showing 0 roles</span>
    </div>
</div>

<!-- Add/Edit Role Modal -->
<div id="role-modal" class="modal">
    <div class="modal-overlay"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="modal-title">Add New Role</h3>
            <span class="modal-close">&times;</span>
        </div>
        <div class="modal-body">
            <form id="role-form">
                <input type="hidden" id="role-id">

                <div class="form-group">
                    <label for="role-name" class="form-label">Role Name</label>
                    <input type="text" id="role-name" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="role-description" class="form-label">Description</label>
                    <textarea id="role-description" class="form-textarea" placeholder="Enter role description..."></textarea>
                </div>

                <div class="permissions-section">
                    <h4>Access Rights</h4>
                    
                    <!-- System Access Category -->
                    <div class="permission-category">
                        <div class="permission-category-header">System Access</div>
                        <div class="permissions-grid">
                            <div class="permission-item">
                                <input type="checkbox" id="perm-admin-panel" value="admin-panel">
                                <label for="perm-admin-panel">Admin Panel</label>
                            </div>
                            <div class="permission-item">
                                <input type="checkbox" id="perm-dashboard" value="dashboard">
                                <label for="perm-dashboard">Dashboard</label>
                            </div>
                        </div>
                    </div>

                    <!-- Certificate Management Category -->
                    <div class="permission-category">
                        <div class="permission-category-header">Certificate Management</div>
                        <div class="permissions-grid">
                            <div class="permission-item">
                                <input type="checkbox" id="perm-certificate-list" value="certificate-list">
                                <label for="perm-certificate-list">Certificate List</label>
                            </div>
                            <div class="permission-item">
                                <input type="checkbox" id="perm-add-certificate" value="add-certificate">
                                <label for="perm-add-certificate">Add Certificate</label>
                            </div>
                            <div class="permission-item">
                                <input type="checkbox" id="perm-edit-certificate" value="edit-certificate">
                                <label for="perm-edit-certificate">Edit Certificate</label>
                            </div>
                            <div class="permission-item">
                                <input type="checkbox" id="perm-manage-companies" value="manage-companies">
                                <label for="perm-manage-companies">Manage Companies</label>
                            </div>
                            <div class="permission-item">
                                <input type="checkbox" id="perm-manage-products" value="manage-products">
                                <label for="perm-manage-products">Manage Products</label>
                            </div>
                            <div class="permission-item">
                                <input type="checkbox" id="perm-view-certificate" value="view-certificate">
                                <label for="perm-view-certificate">View Certificate</label>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-cancel" id="cancel-btn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="save-btn" form="role-form">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/exportUtils.js"></script>
    <script>
        // Sample role data
        let roles = [
            {
                id: 1,
                name: 'Admin',
                description: 'Full system access with admin panel',
                permissions: ['admin-panel', 'dashboard', 'certificate-list', 'add-certificate', 'edit-certificate', 'manage-companies', 'manage-products', 'view-certificate'],
                users: 2
            },
            {
                id: 2,
                name: 'Analyst',
                description: 'Access to dashboard and certificate management',
                permissions: ['dashboard', 'certificate-list', 'edit-certificate', 'manage-products', 'view-certificate'],
                users: 8
            },
            {
                id: 3,
                name: 'External',
                description: 'Limited access for external certificate viewing',
                permissions: ['certificate-list', 'view-certificate'],
                users: 15
            }
        ];

        // DOM Elements
        const roleTable = document.getElementById('role-table');
        const roleTableBody = roleTable.querySelector('tbody');
        const roleCountElement = document.getElementById('role-count');
        const searchInput = document.getElementById('search-input');
        const addRoleBtn = document.getElementById('add-role-btn');

        const modal = document.getElementById('role-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalClose = document.querySelector('.modal-close');
        const cancelBtn = document.getElementById('cancel-btn');
        const roleForm = document.getElementById('role-form');
        const roleIdInput = document.getElementById('role-id');
        const roleNameInput = document.getElementById('role-name');
        const roleDescriptionInput = document.getElementById('role-description');

        // Sorting variables
        let sortColumn = 'name';
        let sortDirection = 'asc';

        // Permission labels
        const permissionLabels = {
            'admin-panel': 'Admin Panel',
            'dashboard': 'Dashboard',
            'certificate-list': 'Certificate List',
            'add-certificate': 'Add Certificate',
            'edit-certificate': 'Edit Certificate',
            'manage-companies': 'Manage Companies',
            'manage-products': 'Manage Products',
            'view-certificate': 'View Certificate'
        };

        // Function to populate the table
        function populateTable(data) {
            roleTableBody.innerHTML = '';

            data.forEach(role => {
                const row = document.createElement('tr');
                row.dataset.id = role.id;

                // Role name
                const nameCell = document.createElement('td');
                nameCell.textContent = role.name;
                row.appendChild(nameCell);

                // Description
                const descCell = document.createElement('td');
                descCell.textContent = role.description;
                row.appendChild(descCell);

                // Permissions
                const permCell = document.createElement('td');
                const permTags = document.createElement('div');
                permTags.className = 'permission-tags';
                role.permissions.forEach(perm => {
                    const tag = document.createElement('span');
                    tag.className = 'permission-tag';
                    tag.textContent = permissionLabels[perm] || perm;
                    permTags.appendChild(tag);
                });
                permCell.appendChild(permTags);
                row.appendChild(permCell);

                // Users count
                const usersCell = document.createElement('td');
                usersCell.textContent = role.users;
                row.appendChild(usersCell);

                // Actions
                const actionsCell = document.createElement('td');
                const editButton = document.createElement('button');
                editButton.className = 'btn-edit';
                editButton.innerHTML = '<i class="fas fa-edit"></i>';
                editButton.title = 'Edit';
                editButton.addEventListener('click', () => openEditModal(role));
                actionsCell.appendChild(editButton);

                const deleteButton = document.createElement('button');
                deleteButton.className = 'btn-delete';
                deleteButton.innerHTML = '<i class="fas fa-trash-alt"></i>';
                deleteButton.title = 'Delete';
                deleteButton.addEventListener('click', () => deleteRole(role.id));
                actionsCell.appendChild(deleteButton);

                row.appendChild(actionsCell);
                roleTableBody.appendChild(row);
            });

            roleCountElement.textContent = `Showing ${data.length} roles`;
        }

        // Sorting functionality
        function initializeSortableHeaders() {
            const headers = roleTable.querySelectorAll('th[data-sort]');

            headers.forEach(header => {
                header.addEventListener('click', () => {
                    const column = header.getAttribute('data-sort');

                    if (sortColumn === column) {
                        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortColumn = column;
                        sortDirection = 'asc';
                    }

                    headers.forEach(h => {
                        h.classList.remove('active-sort');
                        const icon = h.querySelector('.sort-icon');
                        if (icon) {
                            icon.textContent = '▼';
                            icon.style.opacity = '0.6';
                        }
                    });

                    header.classList.add('active-sort');
                    const sortIcon = header.querySelector('.sort-icon');
                    if (sortIcon) {
                        sortIcon.textContent = sortDirection === 'asc' ? '▼' : '▲';
                        sortIcon.style.opacity = '1';
                    }

                    applyFiltersAndSort();
                });
            });
        }

        // Search and filter
        function applyFiltersAndSort() {
            const searchTerm = searchInput.value.toLowerCase();

            let filteredData = roles.filter(role => {
                return searchTerm === '' ||
                    role.name.toLowerCase().includes(searchTerm) ||
                    role.description.toLowerCase().includes(searchTerm);
            });

            filteredData.sort((a, b) => {
                let valueA = a[sortColumn];
                let valueB = b[sortColumn];

                if (typeof valueA === 'string') {
                    valueA = valueA.toLowerCase();
                    valueB = valueB.toLowerCase();
                }

                if (sortDirection === 'asc') {
                    return valueA > valueB ? 1 : -1;
                } else {
                    return valueA < valueB ? 1 : -1;
                }
            });

            populateTable(filteredData);
        }

        // Modal functions
        function openAddModal() {
            modalTitle.textContent = 'Add New Role';
            roleForm.reset();
            roleIdInput.value = '';
            modal.style.display = 'block';
        }

        function openEditModal(role) {
            modalTitle.textContent = 'Edit Role';
            roleIdInput.value = role.id;
            roleNameInput.value = role.name;
            roleDescriptionInput.value = role.description;

            // Set permissions
            document.querySelectorAll('.permissions-grid input[type="checkbox"]').forEach(checkbox => {
                checkbox.checked = role.permissions.includes(checkbox.value);
            });

            modal.style.display = 'block';
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        function saveRole(event) {
            event.preventDefault();

            const roleId = roleIdInput.value;
            const selectedPermissions = Array.from(document.querySelectorAll('.permissions-grid input[type="checkbox"]:checked'))
                .map(cb => cb.value);

            const roleData = {
                name: roleNameInput.value,
                description: roleDescriptionInput.value,
                permissions: selectedPermissions
            };

            if (roleId) {
                // Update existing role
                const index = roles.findIndex(r => r.id.toString() === roleId);
                if (index !== -1) {
                    roles[index] = {
                        ...roles[index],
                        ...roleData
                    };
                }
            } else {
                // Add new role
                const newId = roles.length > 0 ? Math.max(...roles.map(r => r.id)) + 1 : 1;
                roles.push({
                    id: newId,
                    users: 0,
                    ...roleData
                });
            }

            closeModal();
            applyFiltersAndSort();
        }

        function deleteRole(id) {
            if (confirm('Are you sure you want to delete this role?')) {
                roles = roles.filter(role => role.id !== id);
                applyFiltersAndSort();
            }
        }

        // Export functionality
        function exportRoles() {
            console.log('exportRoles called');
            console.log('roles array:', roles);
            
            // Get currently filtered data
            const searchTerm = searchInput.value.toLowerCase();
            let filteredData = roles.filter(role => {
                return searchTerm === '' ||
                    role.name.toLowerCase().includes(searchTerm) ||
                    role.description.toLowerCase().includes(searchTerm);
            });

            console.log('filtered data:', filteredData);

            if (filteredData.length === 0) {
                alert('No roles to export');
                return;
            }

            // Transform data for export
            const exportData = filteredData.map(role => ({
                id: role.id,
                name: role.name,
                description: role.description,
                permissions: role.permissions.join('; '),
                users: role.users
            }));
            
            console.log('export data:', exportData);

            const columns = [
                { key: 'id', header: 'ID' },
                { key: 'name', header: 'Role Name' },
                { key: 'description', header: 'Description' },
                { key: 'permissions', header: 'Permissions' },
                { key: 'users', header: 'User Count' }
            ];
            
            // Try modal export first, fallback to quick CSV if there's an issue
            try {
                ExportUtils.showExportModal(
                    exportData, 
                    columns, 
                    'roles',
                    (message, type) => {
                        console.log(`Export: ${message} (${type})`);
                        alert(message);
                    }
                );
            } catch (error) {
                console.error('Modal export failed, trying quick CSV:', error);
                // Fallback to quick CSV export
                ExportUtils.quickCSVExport(
                    exportData,
                    'roles_fallback',
                    (message, type) => {
                        console.log(`Fallback Export: ${message} (${type})`);
                        alert(message);
                    }
                );
            }
        }

        // Event listeners
        addRoleBtn.addEventListener('click', openAddModal);
        modalClose.addEventListener('click', closeModal);
        cancelBtn.addEventListener('click', closeModal);
        roleForm.addEventListener('submit', saveRole);
        searchInput.addEventListener('input', applyFiltersAndSort);
        
        // Export button
        const exportBtn = document.getElementById('export-btn');
        if (exportBtn) {
            exportBtn.addEventListener('click', exportRoles);
        }
        

        window.addEventListener('click', (event) => {
            if (event.target === modal) {
                closeModal();
            }
        });

        // Initialize
        initializeSortableHeaders();
        applyFiltersAndSort();
    </script>
}