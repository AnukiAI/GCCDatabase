@{
    ViewData["Title"] = "Tags Management";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>Tags Management</h1>
            <p class="text-muted">Manage internal and external tags for products and certificates</p>
            
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                This is a placeholder view for Tags Management. The full implementation will include management of internal and external tags for categorizing products and certificates.
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h5>Tags Overview</h5>
                </div>
                <div class="card-body">
                    <p>Features coming soon:</p>
                    <ul>
                        <li>List of all tags (Internal and External)</li>
                        <li>Create new tags with type selection</li>
                        <li>Edit tag names and descriptions</li>
                        <li>Product count per tag</li>
                        <li>Tag usage analytics</li>
                        <li>Bulk tag operations</li>
                        <li>Tag merging and cleanup tools</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>