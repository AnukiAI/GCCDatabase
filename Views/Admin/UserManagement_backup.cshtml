@{
    ViewData["Title"] = "User Management";
    ViewData["BodyClass"] = "admin-user-management";
}

@section Styles {
    <link href="~/css/user-management.css" rel="stylesheet" />
}
            --text-secondary: #666;
            --border-color: #eaeaea;
            --light-gray: #f9f9f9;
            --white: #ffffff;
            --warning: #ff5252;
            --success: #92C83E;
            /* Layout */
            --border-radius-sm: 4px;
            --border-radius-md: 8px;
            --border-radius-lg: 12px;
            --space-xs: 4px;
            --space-sm: 8px;
            --space-md: 16px;
            --space-lg: 24px;
            --space-xl: 32px;
            /* Effects */
            --shadow-light: 0 2px 4px rgba(0, 0, 0, 0.04);
            --shadow-medium: 0 4px 6px rgba(0, 0, 0, 0.1);
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --transition: 0.3s ease;
            /* Typography - 16px minimum */
            --font-size-base: 16px;
            --font-size-sm: 14px;
            --font-size-lg: 18px;
            --font-size-xl: 20px;
        }

        /* ===== LAYOUT CONTAINERS ===== */
        .admin-container {
            background-color: var(--white);
            padding: var(--space-xl);
            max-width: 1400px;
            margin: var(--space-xl) auto;
            border-radius: var(--border-radius-md);
            box-shadow: var(--shadow);
        }

        /* ===== HEADER SECTION ===== */
        .admin-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: var(--space-xl);
            flex-wrap: wrap;
            gap: var(--space-md);
        }

        .title-area {
            flex-grow: 1;
        }

        .admin-container h1 {
            color: var(--blue-dark);
            margin: 0;
            font-size: var(--font-size-xl);
            font-weight: 500;
        }

        .buttons-area {
            display: flex;
            gap: var(--space-sm);
        }

        /* ===== BUTTON STYLES ===== */
        .btn {
            background-color: var(--white);
            color: var(--blue-dark);
            border: 1px solid var(--border-color);
            padding: var(--space-sm) var(--space-md);
            border-radius: var(--border-radius-sm);
            cursor: pointer;
            font-size: var(--font-size-base);
            font-family: inherit;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: var(--space-xs);
            min-height: 44px;
        }

        .btn:hover {
            background-color: var(--light-gray);
            transform: translateY(-1px);
        }

        .btn-primary {
            background-color: var(--green-primary);
            color: var(--white);
            border: none;
        }

        .btn-primary:hover {
            background-color: #0089BC;
        }

        .btn-add {
            background-color: var(--green-primary);
            color: var(--white);
            border: none;
        }

        .btn-add:hover {
            background-color: var(--green-secondary);
        }

        .btn-delete,
        .btn-edit {
            background: none;
            border: none;
            padding: 6px;
            font-size: 16px;
            cursor: pointer;
            transition: var(--transition);
            border-radius: var(--border-radius-sm);
            min-width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 2px;
        }

        .btn-delete {
            color: var(--warning);
        }

        .btn-edit {
            color: var(--blue-primary);
        }

        .btn-delete:hover {
            background-color: rgba(255, 82, 82, 0.1);
        }

        .btn-edit:hover {
            background-color: rgba(0, 174, 239, 0.1);
        }

        /* ===== SEARCH AND FILTER BAR ===== */
        .search-filter-bar {
            display: flex;
            align-items: center;
            background-color: var(--light-gray);
            border-radius: var(--border-radius-sm);
            padding: var(--space-md);
            margin-bottom: var(--space-md);
            gap: var(--space-md);
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex-grow: 1;
            min-width: 200px;
        }

        .search-box input {
            width: 100%;
            padding: var(--space-sm) var(--space-md) var(--space-sm) 35px;
            border-radius: var(--border-radius-sm);
            border: 1px solid var(--border-color);
            background-color: var(--white);
            font-family: inherit;
            font-size: var(--font-size-base);
            box-sizing: border-box;
        }

        .search-icon {
            position: absolute;
            left: var(--space-sm);
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
        }

        .filters {
            display: flex;
            gap: var(--space-md);
            flex-wrap: wrap;
        }

        .filter-select {
            padding: var(--space-sm);
            border-radius: var(--border-radius-sm);
            border: 1px solid var(--border-color);
            background-color: var(--white);
            font-family: inherit;
            font-size: var(--font-size-base);
            min-width: 120px;
        }

        /* ===== TABLE STYLES ===== */
        .table-container {
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            overflow: hidden;
            margin-bottom: var(--space-lg);
        }

        #user-table {
            width: 100%;
            border-collapse: collapse;
        }

        #user-table th,
        #user-table td {
            padding: var(--space-md);
            text-align: left;
            border-bottom: 1px solid var(--border-color);
        }

        #user-table th {
            background-color: var(--light-gray);
            color: var(--blue-dark);
            font-weight: 500;
            position: sticky;
            top: 0;
            cursor: pointer;
            font-size: var(--font-size-base);
            white-space: nowrap;
        }

        #user-table th .sort-icon {
            display: inline-block;
            margin-left: var(--space-xs);
            font-size: 10px;
            opacity: 0.6;
            transition: var(--transition);
        }

        #user-table th.active-sort .sort-icon {
            opacity: 1;
        }

        #user-table tbody tr:hover {
            background-color: var(--light-gray);
        }

        /* Actions column specific styling */
        .actions-col {
            text-align: center;
            white-space: nowrap;
            min-width: 80px;
        }

        #user-table td:last-child {
            text-align: center;
            white-space: nowrap;
            padding: 8px 4px;
        }

        /* ===== STATUS INDICATORS ===== */
        .status-indicator {
            width: 10px;
            height: 10px;
            display: inline-block;
            border-radius: 50%;
            margin-right: var(--space-xs);
        }

        .status-active {
            background-color: var(--green-primary);
        }

        .status-inactive {
            background-color: #ccc;
        }

        /* ===== MULTI-SELECT STYLES ===== */
        .multi-select-container {
            position: relative;
            width: 100%;
        }

        .multi-select-display {
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            padding: var(--space-sm);
            min-height: 44px;
            background-color: var(--white);
            cursor: pointer;
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-xs);
            align-items: center;
            font-size: var(--font-size-base);
        }

        .multi-select-tag {
            background-color: var(--blue-primary);
            color: var(--white);
            padding: 4px var(--space-sm);
            border-radius: 3px;
            font-size: var(--font-size-sm);
            display: flex;
            align-items: center;
            gap: var(--space-xs);
        }

        .multi-select-tag .remove {
            cursor: pointer;
            font-weight: bold;
            font-size: var(--font-size-base);
        }

        .multi-select-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background-color: var(--white);
            border: 1px solid var(--border-color);
            border-top: none;
            border-radius: 0 0 var(--border-radius-sm) var(--border-radius-sm);
            max-height: 200px;
            overflow-y: auto;
            z-index: 1000;
            display: none;
            box-shadow: var(--shadow-medium);
        }

        .multi-select-option {
            padding: var(--space-sm);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            transition: var(--transition);
            font-size: var(--font-size-base);
        }

        .multi-select-option:hover {
            background-color: var(--light-gray);
        }

        .multi-select-option input[type="checkbox"] {
            margin: 0;
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: var(--blue-primary);
        }

        .multi-select-option label {
            cursor: pointer;
            flex: 1;
            text-align: left;
            margin: 0;
            font-size: var(--font-size-base);
        }

        /* ===== MODAL STYLES ===== */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
        }

        .modal-content {
            background-color: var(--white);
            margin: 5% auto;
            padding: var(--space-xl);
            width: 60%;
            max-width: 600px;
            border-radius: var(--border-radius-md);
            box-shadow: var(--shadow);
            max-height: 85vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-lg);
        }

        .modal-title {
            color: var(--blue-dark);
            margin: 0;
            font-size: var(--font-size-lg);
            font-weight: 500;
        }

        .modal-close {
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
            color: var(--text-secondary);
            transition: var(--transition);
        }

        .modal-close:hover {
            color: var(--text-color);
        }

        .form-group {
            margin-bottom: var(--space-md);
        }

        .form-group label {
            display: block;
            margin-bottom: var(--space-xs);
            color: var(--text-color);
            font-weight: 500;
            font-size: var(--font-size-base);
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: var(--space-sm);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-family: inherit;
            font-size: var(--font-size-base);
            box-sizing: border-box;
            min-height: 44px;
        }

        .form-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            margin: 0;
            cursor: pointer;
            transform: scale(1);
            accent-color: var(--blue-primary);
        }

        .form-group label input[type="checkbox"] {
            margin-right: var(--space-sm);
            vertical-align: middle;
        }

        .password-help {
            font-size: var(--font-size-sm);
            color: var(--text-secondary);
            margin-top: var(--space-xs);
            font-style: italic;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: var(--space-md);
            margin-top: var(--space-lg);
        }

        .footer-info {
            text-align: right;
            color: var(--text-secondary);
            font-size: var(--font-size-sm);
            margin-top: var(--space-xs);
        }

        .edit-mode {
            background-color: rgba(0, 174, 239, 0.05);
            border-bottom: 2px dashed var(--blue-primary) !important;
        }

        .text-input {
            border: none;
            border-bottom: 1px solid var(--border-color);
            border-radius: 0;
            padding: var(--space-xs) 2px;
            background: transparent;
            font-family: inherit;
            font-size: var(--font-size-base);
        }

        .text-input:focus {
            outline: none;
            border-bottom-color: var(--blue-primary);
        }

        /* ===== RESPONSIVE DESIGN ===== */
        @@media (max-width: 1024px) {
            .admin-container {
                padding: var(--space-lg);
                margin: var(--space-md);
            }
        }

        @@media (max-width: 768px) {
            .admin-container {
                padding: var(--space-md);
                margin: var(--space-sm);
            }

            .admin-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .buttons-area {
                width: 100%;
                justify-content: space-between;
            }

            .search-filter-bar {
                flex-direction: column;
                align-items: flex-start;
            }

            .search-box {
                width: 100%;
            }

            .filters {
                width: 100%;
                justify-content: space-between;
            }

            .filter-select {
                flex: 1;
                min-width: auto;
            }

            .modal-content {
                width: 90%;
                margin: 10% auto;
                padding: var(--space-lg);
            }

            .btn-delete, .btn-edit {
                min-width: 32px;
                height: 32px;
                margin: 0 1px;
            }

            #user-table {
                font-size: var(--font-size-base);
            }

            #user-table th,
            #user-table td {
                padding: var(--space-sm);
            }
        }

        @@media (max-width: 480px) {
            .admin-container {
                padding: var(--space-sm);
                margin: var(--space-xs);
            }

            .btn {
                font-size: var(--font-size-base);
                padding: var(--space-xs) var(--space-sm);
            }

            .admin-container h1 {
                font-size: var(--font-size-lg);
            }

            .filters {
                flex-direction: column;
                width: 100%;
            }

            .filter-select {
                width: 100%;
            }
        }
    </style>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="title-area">
            <h1>User Management</h1>
        </div>
        <div class="buttons-area">
            <button id="import-btn" class="btn">
                <i class="fas fa-upload"></i> Import
            </button>
            <button id="export-btn" class="btn">
                <i class="fas fa-download"></i> Export
            </button>
            <button id="add-user-btn" class="btn btn-add">
                <i class="fas fa-plus"></i> Add New User
            </button>
        </div>
    </header>

    <div class="search-filter-bar">
        <div class="search-box">
            <input type="text" id="search-input" placeholder="Search users...">
            <i class="fas fa-search search-icon"></i>
        </div>
        <div class="filters">
            <select id="status-filter" class="filter-select">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            <select id="role-filter" class="filter-select">
                <option value="all">All Roles</option>
                <option value="admin">Admin</option>
                <option value="gcc-user">GCC User</option>
                <option value="external-user">External User</option>
            </select>
            <select id="company-filter" class="filter-select">
                <option value="all">All Companies</option>
                <option value="acme-corp">ACME Corp</option>
                <option value="tech-solutions">Tech Solutions</option>
                <option value="global-industries">Global Industries</option>
            </select>
        </div>
    </div>

    <div class="table-container">
        <table id="user-table">
            <thead>
                <tr>
                    <th width="18%" data-sort="name">Name <span class="sort-icon">▼</span></th>
                    <th width="20%" data-sort="company">Company <span class="sort-icon">▼</span></th>
                    <th width="22%" data-sort="email">Email <span class="sort-icon">▼</span></th>
                    <th width="12%" data-sort="role">Role <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="status">Status <span class="sort-icon">▼</span></th>
                    <th width="12%" data-sort="lastLogin">Last Login <span class="sort-icon">▼</span></th>
                    <th width="6%" class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be populated by JavaScript -->
            </tbody>
        </table>
    </div>

    <div class="footer-info">
        <span id="user-count">Showing 0 of 0 users</span>
    </div>
</div>

<!-- Add/Edit User Modal -->
<div id="user-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="modal-title">Add New User</h3>
            <span class="modal-close">&times;</span>
        </div>
        <form id="user-form">
            <input type="hidden" id="user-id">

            <div class="form-group">
                <label for="user-name">Name</label>
                <input type="text" id="user-name" required>
            </div>

            <div class="form-group">
                <label for="user-company">Company</label>
                <div class="multi-select-container">
                    <div class="multi-select-display" id="company-display">
                        <span style="color: #999;">Select companies...</span>
                    </div>
                    <div class="multi-select-dropdown" id="company-dropdown">
                        <div class="multi-select-option">
                            <input type="checkbox" value="acme-corp" id="company-acme">
                            <label for="company-acme">ACME Corp</label>
                        </div>
                        <div class="multi-select-option">
                            <input type="checkbox" value="tech-solutions" id="company-tech">
                            <label for="company-tech">Tech Solutions</label>
                        </div>
                        <div class="multi-select-option">
                            <input type="checkbox" value="global-industries" id="company-global">
                            <label for="company-global">Global Industries</label>
                        </div>
                        <div class="multi-select-option">
                            <input type="checkbox" value="assa-abloy" id="company-assa">
                            <label for="company-assa">ASSA ABLOY</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="user-partners">Partners</label>
                <div class="multi-select-container">
                    <div class="multi-select-display" id="partners-display">
                        <span style="color: #999;">Select partners...</span>
                    </div>
                    <div class="multi-select-dropdown" id="partners-dropdown">
                        <div class="multi-select-option">
                            <input type="checkbox" value="amazon" id="partner-amazon">
                            <label for="partner-amazon">Amazon</label>
                        </div>
                        <div class="multi-select-option">
                            <input type="checkbox" value="wayfair" id="partner-wayfair">
                            <label for="partner-wayfair">Wayfair</label>
                        </div>
                        <div class="multi-select-option">
                            <input type="checkbox" value="home-depot" id="partner-depot">
                            <label for="partner-depot">Home Depot</label>
                        </div>
                        <div class="multi-select-option">
                            <input type="checkbox" value="lowes" id="partner-lowes">
                            <label for="partner-lowes">Lowe's</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="user-email">Email</label>
                <input type="email" id="user-email" required>
            </div>

            <div class="form-group">
                <label for="user-role">Role</label>
                <select id="user-role" required>
                    <option value="admin">Admin</option>
                    <option value="gcc-user">GCC User</option>
                    <option value="external-user">External User</option>
                </select>
            </div>

            <div class="form-group">
                <label for="user-status">Status</label>
                <select id="user-status" required>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="form-group">
                <label for="user-password">Password</label>
                <input type="password" id="user-password">
                <div class="password-help">Leave blank to keep current password</div>
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" id="require-password-reset"> Require password reset on next login
                </label>
            </div>

            <div class="form-actions">
                <button type="button" class="btn" id="cancel-btn">Cancel</button>
                <button type="submit" class="btn btn-primary" id="save-btn">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/userManagement.js"></script>
}
