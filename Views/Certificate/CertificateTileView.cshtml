@{
    // ViewData["Title"] = "Certificate Database";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/certificatetileview.css" />
<link rel="stylesheet" href="~/css/certificate-autocomplete.css" />

<!-- Main Container -->
<div class="main-container">
    <!-- Sidebar (Filters) -->
    <div class="sidebar">
        <button class="mobile-filter-toggle" onclick="toggleMobileFilters()" style="display: none;">
            <span>Show Filters & Search</span>
            <i class="fas fa-chevron-down"></i>
        </button>

        <!-- Search Bar -->
        <div class="search-bar">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search certificates, companies, products...">
        </div>

        <div class="filters-header">
            <h3 class="filters-title">Filters</h3>
            <a href="#" class="clear-filters" onclick="certificateTileView.clearAllFilters(); return false;">Clear Filters</a>
        </div>

        <!-- Certification Type Filter -->
        <div class="filter-panel">
            <div class="filter-header" onclick="toggleFilter('cert-type')">
                <span>Certification Type</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="cert-type-content">
                <ul class="filter-tree">
                    <!-- Populated dynamically via JavaScript -->
                </ul>
            </div>
        </div>

        <!-- Product Categories Filter -->
        <div class="filter-panel">
            <div class="filter-header" onclick="toggleFilter('product-cat')">
                <span>Product Categories</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="product-cat-content">
                <ul class="filter-tree">
                    <!-- Populated dynamically via JavaScript -->
                </ul>
            </div>
        </div>

        <!-- Company Filter -->
        <div class="filter-panel">
            <div class="filter-header" onclick="toggleFilter('company')">
                <span>Company</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="company-content">
                <ul class="filter-tree">
                    <!-- Populated dynamically via JavaScript -->
                </ul>
            </div>
        </div>

        <!-- Countries Filter -->
        <div class="filter-panel">
            <div class="filter-header" onclick="toggleFilter('countries')">
                <span>Countries</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="countries-content">
                <ul class="filter-tree">
                    <!-- Populated dynamically via JavaScript -->
                </ul>
            </div>
        </div>

        <!-- Certificate Tags Filter -->
        <div class="filter-panel">
            <div class="filter-header" onclick="toggleFilter('cert-tags')">
                <span>Certificate Tags</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-content" id="cert-tags-content">
                <ul class="filter-tree">
                    <!-- Populated dynamically via JavaScript -->
                </ul>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <div class="results-header">
            <div class="results-count" id="resultsCount">Loading...</div>
            <div class="sort-controls">
                <span class="sort-label">Sort By</span>
                <div class="sort-dropdown" id="sortDropdown">
                    <button class="sort-dropdown-button" id="sortDropdownBtn">
                        <span id="sortLabel">Newest Effective Date</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="sort-dropdown-content" id="sortContent">
                        <!-- Date-based sorting -->
                        <div class="sort-group-header">By Date</div>
                        <div class="sort-option" data-sort="newest">
                            <i class="fas fa-calendar-plus"></i>
                            Newest Effective Date
                        </div>
                        <div class="sort-option" data-sort="oldest-effective">
                            <i class="fas fa-calendar-minus"></i>
                            Oldest Effective Date
                        </div>
                        <div class="sort-option" data-sort="expiring">
                            <i class="fas fa-clock"></i>
                            Expiring Soon
                        </div>
                        <div class="sort-option" data-sort="longest-validity">
                            <i class="fas fa-hourglass-end"></i>
                            Longest Validity Period
                        </div>
                        <div class="sort-option" data-sort="recently-issued">
                            <i class="fas fa-calendar-check"></i>
                            Recently Issued (Last 30 Days)
                        </div>

                        <!-- Certificate Information -->
                        <div class="sort-group-header">By Certificate</div>
                        <div class="sort-option" data-sort="cert-number-newest">
                            <i class="fas fa-certificate"></i>
                            Certificate Number (Newest)
                        </div>
                        <div class="sort-option" data-sort="cert-number-oldest">
                            <i class="fas fa-certificate"></i>
                            Certificate Number (Oldest)
                        </div>
                        <div class="sort-option" data-sort="cert-type">
                            <i class="fas fa-award"></i>
                            Certification Type A-Z
                        </div>
                        <div class="sort-option" data-sort="cert-type-za">
                            <i class="fas fa-award"></i>
                            Certification Type Z-A
                        </div>

                        <!-- Alphabetical sorting -->
                        <div class="sort-group-header">Alphabetical</div>
                        <div class="sort-option" data-sort="company-az">
                            <i class="fas fa-building"></i>
                            Company A-Z
                        </div>
                        <div class="sort-option" data-sort="company-za">
                            <i class="fas fa-building"></i>
                            Company Z-A
                        </div>
                        <div class="sort-option" data-sort="product-az">
                            <i class="fas fa-tag"></i>
                            Product Name A-Z
                        </div>
                        <div class="sort-option" data-sort="product-za">
                            <i class="fas fa-tag"></i>
                            Product Name Z-A
                        </div>

                        <!-- Location sorting -->
                        <div class="sort-group-header">By Location</div>
                        <div class="sort-option" data-sort="location-az">
                            <i class="fas fa-map-marker-alt"></i>
                            Location A-Z
                        </div>
                        <div class="sort-option" data-sort="location-za">
                            <i class="fas fa-map-marker-alt"></i>
                            Location Z-A
                        </div>
                        <div class="sort-option" data-sort="country">
                            <i class="fas fa-globe"></i>
                            Country A-Z
                        </div>
                        <div class="sort-option" data-sort="country-za">
                            <i class="fas fa-globe"></i>
                            Country Z-A
                        </div>

                        <!-- Advanced sorting -->
                        <div class="sort-group-header">Advanced</div>
                        <div class="sort-option" data-sort="product-type">
                            <i class="fas fa-boxes"></i>
                            Product Type A-Z
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="certificates-grid" id="certificatesGrid">
            <!-- Certificates will be loaded dynamically -->
        </div>

        <!-- Loading indicator -->
        <div class="loading-container" id="loadingContainer" style="display: none;">
            <div class="spinner">
                <i class="fas fa-spinner fa-spin"></i>
            </div>
        </div>
    </div>
</div>

<!-- Include the certificate tile view JavaScript -->
<script src="~/js/certificate-tile-view.js"></script>

<script>
    // Additional mobile filter functionality
    function toggleFilter(filterId) {
        const content = document.getElementById(filterId + '-content');
        const header = content.previousElementSibling;
        const icon = header.querySelector('i');
        
        if (content.style.display === 'none' || content.style.display === '') {
            content.style.display = 'block';
            icon.className = 'fas fa-chevron-up';
        } else {
            content.style.display = 'none';
            icon.className = 'fas fa-chevron-down';
        }
    }

    function toggleMobileFilters() {
        const sidebar = document.querySelector('.sidebar');
        const toggleBtn = document.querySelector('.mobile-filter-toggle');
        
        if (sidebar && toggleBtn) {
            const isExpanded = sidebar.classList.contains('expanded');
            
            if (isExpanded) {
                sidebar.classList.remove('expanded');
                hideAllFilters(sidebar);
            } else {
                sidebar.classList.add('expanded');
                showAllFilters(sidebar);
            }
            
            // Update toggle button appearance
            const icon = toggleBtn.querySelector('i');
            const span = toggleBtn.querySelector('span');
            
            if (span && icon) {
                span.textContent = isExpanded ? 'Show Filters & Search' : 'Hide Filters';
                icon.className = isExpanded ? 'fas fa-chevron-down' : 'fas fa-chevron-up';
            }
        }
    }

    function hideAllFilters(sidebar) {
        const elementsToHide = sidebar.querySelectorAll('.search-bar, .filters-header, .filter-panel, .filter-content');
        elementsToHide.forEach(el => {
            el.style.display = 'none';
            el.style.visibility = 'hidden';
        });
    }
    
    function showAllFilters(sidebar) {
        const elements = sidebar.querySelectorAll('.search-bar, .filters-header, .filter-panel');
        elements.forEach(el => {
            el.style.display = '';
            el.style.visibility = '';
        });
    }

    // Handle responsive behavior
    function updateMobileFilterToggle() {
        const mobileToggle = document.querySelector('.mobile-filter-toggle');
        const sidebar = document.querySelector('.sidebar');
        
        if (mobileToggle && sidebar) {
            if (window.innerWidth <= 768) {
                // Mobile/Tablet mode
                mobileToggle.style.display = 'flex';
                
                // Force hide filters unless expanded
                if (!sidebar.classList.contains('expanded')) {
                    hideAllFilters(sidebar);
                }
            } else {
                // Desktop mode
                mobileToggle.style.display = 'none';
                sidebar.classList.remove('expanded');
                
                // Show all filters on desktop
                showAllFilters(sidebar);
            }
        }
    }

    // Initialize mobile toggle on load and resize
    document.addEventListener('DOMContentLoaded', function() {
        updateMobileFilterToggle();
        window.addEventListener('resize', updateMobileFilterToggle);
        window.addEventListener('orientationchange', function() {
            setTimeout(updateMobileFilterToggle, 300);
        });
    });
</script>