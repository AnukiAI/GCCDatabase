<script src="~/js/certificateslist.js"></script>
<script>
    // Toast notification function
    function showToast(message, type = 'success') {
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;

        const iconMap = {
            success: 'check-circle',
            error: 'exclamation-circle',
            warning: 'exclamation-triangle',
            info: 'info-circle'
        };

        toast.innerHTML = `
            <i class="fas fa-${iconMap[type]}"></i>
            <span>${message}</span>
        `;

        document.body.appendChild(toast);

        // Show with animation
        setTimeout(() => {
            toast.classList.add('show');
        }, 100);

        // Auto remove after 3 seconds
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => {
                if (document.body.contains(toast)) {
                    document.body.removeChild(toast);
                }
            }, 300);
        }, 3000);
    }

    // Sort functionality
    function toggleSort() {
        const dropdown = document.getElementById('sortDropdown');
        dropdown.classList.toggle('open');
    }

    function selectSort(value, label) {
        document.getElementById('sortLabel').textContent = label;
        document.getElementById('sortDropdown').classList.remove('open');

        console.log('Sorting by:', value);
        applySorting(value);
        showToast(`Sorted by ${label}`, 'info');
    }

    function applySorting(sortType) {
        const grid = document.getElementById('certificatesGrid');
        const cards = Array.from(grid.children);

        cards.sort((a, b) => {
            switch (sortType) {
                case 'newest':
                    return new Date(b.dataset.date) - new Date(a.dataset.date);
                case 'expiring':
                    return 0;
                case 'product-az':
                    return a.querySelector('.product-name').textContent.localeCompare(
                        b.querySelector('.product-name').textContent
                    );
                case 'company-az':
                    return a.querySelector('.company-name').textContent.localeCompare(
                        b.querySelector('.company-name').textContent
                    );
                default:
                    return 0;
            }
        });

        cards.forEach(card => grid.appendChild(card));
    }

    // Filter functionality
    function toggleFilter(filterId) {
        const content = document.getElementById(filterId + '-content');
        const header = content.previousElementSibling;
        const icon = header.querySelector('i');

        if (content.style.display === 'none') {
            content.style.display = 'block';
            icon.className = 'fas fa-chevron-up';
        } else {
            content.style.display = 'none';
            icon.className = 'fas fa-chevron-down';
        }
    }

    function clearAllFilters() {
        const checkboxes = document.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(checkbox => checkbox.checked = false);
        applyFilters();
        showToast('All filters cleared', 'info');
    }

    function applyFilters() {
        const cards = document.querySelectorAll('.certificate-card');
        let visibleCount = 0;

        cards.forEach(card => {
            let shouldShow = true;

            // Check certification type filters
            const certTypeChecked = document.querySelectorAll('input[name="cert-type"]:checked');
            if (certTypeChecked.length > 0) {
                const cardType = card.dataset.type;
                const typeMatch = Array.from(certTypeChecked).some(cb => cb.value === cardType);
                if (!typeMatch) shouldShow = false;
            }

            // Check product category filters
            const productCatChecked = document.querySelectorAll('input[name="product-cat"]:checked');
            if (productCatChecked.length > 0) {
                const cardCategory = card.dataset.category;
                const categoryMatch = Array.from(productCatChecked).some(cb => cb.value === cardCategory);
                if (!categoryMatch) shouldShow = false;
            }

            // Check company filters
            const companyChecked = document.querySelectorAll('input[name="company"]:checked');
            if (companyChecked.length > 0) {
                const cardCompany = card.dataset.company;
                const companyMatch = Array.from(companyChecked).some(cb => cb.value === cardCompany);
                if (!companyMatch) shouldShow = false;
            }

            // Check country filters
            const countryChecked = document.querySelectorAll('input[name="countries"]:checked');
            if (countryChecked.length > 0) {
                const cardCountry = card.dataset.country;
                const countryMatch = Array.from(countryChecked).some(cb => cb.value === cardCountry);
                if (!countryMatch) shouldShow = false;
            }

            // Check tags filters
            const tagsChecked = document.querySelectorAll('input[name="tags"]:checked');
            if (tagsChecked.length > 0) {
                const cardType = card.dataset.type;
                const tagsMatch = Array.from(tagsChecked).some(cb => cb.value === cardType);
                if (!tagsMatch) shouldShow = false;
            }

            if (shouldShow) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('resultsCount').textContent = `${visibleCount} Results`;
    }

    // Certificate actions
    function downloadCertificate(certId) {
        console.log('Downloading certificate:', certId);
        showToast(`Certificate ${certId} download started`, 'success');
    }

    function viewCertificate(certId) {
        console.log('Viewing certificate:', certId);
        showToast(`Opening certificate ${certId} details`, 'info');
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function (event) {
        const dropdown = document.getElementById('sortDropdown');
        if (!dropdown.contains(event.target)) {
            dropdown.classList.remove('open');
        }
    });

    // Mobile filter functionality
    function toggleMobileFilters() {
        const sidebar = document.querySelector('.sidebar');
        const toggleBtn = document.querySelector('.mobile-filter-toggle');

        if (sidebar && toggleBtn) {
            const isExpanded = sidebar.classList.contains('expanded');

            if (isExpanded) {
                sidebar.classList.remove('expanded');
                hideAllFilters(sidebar);
            } else {
                sidebar.classList.add('expanded');
                showAllFilters(sidebar);
            }

            // Update toggle button appearance
            const icon = toggleBtn.querySelector('i');
            const span = toggleBtn.querySelector('span');

            if (span && icon) {
                span.textContent = isExpanded ? 'Show Filters & Search' : 'Hide Filters';
                icon.className = isExpanded ? 'fas fa-chevron-down' : 'fas fa-chevron-up';
            }
        }
    }

    function hideAllFilters(sidebar) {
        const elementsToHide = sidebar.querySelectorAll('.search-bar, .filters-header, .filter-panel, .filter-content');
        elementsToHide.forEach(el => {
            el.style.display = 'none';
            el.style.visibility = 'hidden';
        });
    }
    
    function showAllFilters(sidebar) {
        const elements = sidebar.querySelectorAll('.search-bar, .filters-header, .filter-panel, .filter-content');
        elements.forEach(el => {
            el.classList.remove('sidebar-element-hidden');
            el.classList.add('sidebar-element-visible');
        });
    }

    function updateMobileFilterToggle() {
        const mobileToggle = document.querySelector('.mobile-filter-toggle');
        const sidebar = document.querySelector('.sidebar');

        if (mobileToggle && sidebar) {
            if (window.innerWidth <= 768) {
                // MOBILE/TABLET MODE
                mobileToggle.style.display = 'flex';
                mobileToggle.style.position = 'relative';
                mobileToggle.style.zIndex = '10';

                // Force hide filters unless expanded
                if (!sidebar.classList.contains('expanded')) {
                    hideAllFilters(sidebar);
                }
            } else {
                // DESKTOP MODE
                mobileToggle.style.display = 'none';
                sidebar.classList.remove('expanded');

                // Show all filters on desktop
                showAllFilters(sidebar);
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize checkboxes
        const checkboxes = document.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            checkbox.addEventListener('change', applyFilters);
        });

        // Initialize with current filter state
        applyFilters();

        // Enhanced mobile filter initialization
        updateMobileFilterToggle();
        window.addEventListener('resize', function() {
            updateMobileFilterToggle();
            setTimeout(updateMobileFilterToggle, 100);
        });

        // Listen for orientation change
        window.addEventListener('orientationchange', function() {
            setTimeout(updateMobileFilterToggle, 300);
        });
    });
</script>