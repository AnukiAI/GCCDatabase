@{
    ViewData["Title"] = "Certificate Tile View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Certificate Badge -->
<div class="certificate-badge">Certificate 1.0</div>

<!-- Search Section -->
<div class="search-section">
    <div class="search-container">
        <div class="search-bar">
            <input type="text" class="search-input" placeholder="Search..." />
            <button class="search-button">
                <!-- Search icon SVG -->
                ...
            </button>
        </div>

        <div class="sort-by">
            <div class="sort-by-label">Sort By</div>
            <div class="sort-dropdown">
                <button class="sort-dropdown-button">
                    <span>Default</span>
                    <!-- Dropdown icon SVG -->
                </button>
                <div class="sort-dropdown-content">
                    <!-- All sort options -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Container -->
<div class="main-container">
    <!-- Sidebar (Filters) -->
    <div class="sidebar">
        <!-- Filter Panels -->
        ...
    </div>

    <!-- Main Content Area -->
    <div class="certificates-content">
        <div class="results-count">201 Results</div>

        <div class="certificates-grid">
            <!-- Certificate Card -->
            <div class="certificate-card" data-id="24-1605">
                <div class="certificate-header"><h3>CERTIFIED SUSTAINABILITY FACTS</h3></div>
                <div class="certificate-info">
                    <div class="certificate-number">Certificate #: 24-1605</div>
                    <div class="company-name">ASSA ABLOY Access & Egress Hardware Group, Inc. - Corbin Russwin Division</div>
                    <div class="product-name">900ET Exit Device Trim with EcoFlex®</div>
                    <div class="product-category">Construction / Building Products</div>
                    <div class="certification-period">
                        <strong>Certification Period:</strong><br />
                        7/1/2024 - 6/31/2027
                    </div>
                    <div class="certificate-location">Berlin, CT<br />United States</div>
                </div>
                <div class="certificate-actions">
                    <button class="action-button" title="Download Certificate">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
                        </svg>
                    </button>
                    <button class="action-button" title="Expand Certificate">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.828 10.172a.5.5 0 0 0-.707 0l-4.096 4.096V11.5a.5.5 0 0 0-1 0v3.975a.5.5 0 0 0 .5.5H4.5a.5.5 0 0 0 0-1H1.732l4.096-4.096a.5.5 0 0 0 0-.707zm4.344 0a.5.5 0 0 1 .707 0l4.096 4.096V11.5a.5.5 0 1 1 1 0v3.975a.5.5 0 0 1-.5.5H11.5a.5.5 0 0 1 0-1h2.768l-4.096-4.096a.5.5 0 0 1 0-.707zm0-4.344a.5.5 0 0 0 .707 0l4.096-4.096V4.5a.5.5 0 1 0 1 0V.525a.5.5 0 0 0-.5-.5H11.5a.5.5 0 0 0 0 1h2.768l-4.096 4.096a.5.5 0 0 0 0 .707zm-4.344 0a.5.5 0 0 1-.707 0L1.025 1.732V4.5a.5.5 0 0 1-1 0V.525a.5.5 0 0 1 .5-.5H4.5a.5.5 0 0 1 0 1H1.732l4.096 4.096a.5.5 0 0 1 0 .707z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/certificates.js"></script>
