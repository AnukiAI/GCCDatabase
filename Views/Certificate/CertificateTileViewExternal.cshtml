            function hideAllFilters(sidebar) {
                const elements = sidebar.querySelectorAll('.search-bar, .filters-header, .filter-panel, .filter-content');
                elements.forEach(el => {
                    el.classList.add('sidebar-element-hidden');
                    el.classList.remove('sidebar-element-visible');
                });
            }

            function clearAllFilters() {
                const checkboxes = document.querySelectorAll('input[type="checkbox"]:not(#selectAll)');
                checkboxes.forEach(checkbox => checkbox.checked = false);
                applyFilters();
                showToast('All filters cleared', 'info');
            }
            function updateMobileFilterToggle() {
                const mobileToggle = document.querySelector('.mobile-filter-toggle');
                const sidebar = document.querySelector('.sidebar');

                if (mobileToggle && sidebar) {
                    if (window.innerWidth <= 768) {
                        // MOBILE/TABLET MODE
                        mobileToggle.style.display = 'flex';
                        mobileToggle.style.position = 'relative';
                        mobileToggle.style.zIndex = '10';

                        // Force hide filters unless expanded
                        if (!sidebar.classList.contains('expanded')) {
                            hideAllFilters(sidebar);
                        }
                    } else {
                        // DESKTOP MODE
                        mobileToggle.style.display = 'none';
                        sidebar.classList.remove('expanded');

                        // Show all filters on desktop
                        showAllFilters(sidebar);
                    }
                }
            }

            // Close dropdown when clicking outside
            document.addEventListener('click', function (event) {
                const dropdown = document.getElementById('sortDropdown');
                if (!dropdown.contains(event.target)) {
                    dropdown.classList.remove('open');
                }
            });

                          document.addEventListener('DOMContentLoaded', function() {
                // Initialize checkboxes
                const checkboxes = document.querySelectorAll('input[type="checkbox"]:not(#selectAll)');
                checkboxes.forEach(checkbox => {
                    checkbox.addEventListener('change', applyFilters);
                });

                // Add event listener for Clear Filters
                const clearFiltersLink = document.querySelector('.clear-filters');
                if (clearFiltersLink) {
                    clearFiltersLink.addEventListener('click', function(e) {
                        e.preventDefault();
                        clearAllFilters();
                    });
                }

                // Handle table scroll indicator
                const tableWrapper = document.querySelector('.table-wrapper');
                if (tableWrapper) {
                    tableWrapper.addEventListener('scroll', function() {
                        if (this.scrollLeft > 0) {
                            this.classList.add('scrollable');
                        } else {
                            this.classList.remove('scrollable');
                        }
                    });

                    // Check initial scroll state
                    if (tableWrapper.scrollWidth > tableWrapper.clientWidth) {
                        tableWrapper.classList.add('scrollable');
                    }
                }

                // Initialize with current filter state
                applyFilters();

                // Enhanced mobile filter initialization
                updateMobileFilterToggle();
                window.addEventListener('resize', function() {
                    updateMobileFilterToggle();
                    setTimeout(updateMobileFilterToggle, 100);
                });

                // Listen for orientation change
                window.addEventListener('orientationchange', function() {
                    setTimeout(updateMobileFilterToggle, 300);
                });

                // Add change event to row checkboxes
                document.addEventListener('change', function(e) {
                    if (e.target.classList.contains('row-select')) {
                        updateSelectionCount();
                    }
                });

                // Check for saved view preference and set initial visibility ONCE
                const savedView = sessionStorage.getItem('preferredView') || 'tile';
                const sortControls = document.querySelector('.sort-controls');

                if (savedView === 'list') {
                    // Set initial state for list view
                    if (sortControls) {
                        sortControls.style.display = 'none';
                    }
                    toggleView('list');
                } else {
                    // Set initial state for tile view
                    if (sortControls) {
                        sortControls.style.display = 'flex';
                    }
                }
            });


