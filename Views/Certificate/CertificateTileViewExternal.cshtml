             function populateGridView() {
                console.log('Populating grid view with real data');

                const gridBody = document.getElementById('gridBody');

                if (!gridBody) {
                    console.error('Grid body not found');
                    return;
                }

                // Clear existing rows
                gridBody.innerHTML = '';

                // Use the real certificateData instead of extracting from cards
                certificateData.forEach(cert => {
                    const row = createGridRowFromData(cert);
                    if (row) {
                        gridBody.appendChild(row);
                    }
                });

                console.log('Added', gridBody.children.length, 'rows to grid');
            }

                        function createGridRowFromData(cert) {
                try {
                    const row = document.createElement('div');
                    row.className = 'grid-row';
                    row.dataset.certId = cert.id;

                    // Create all grid cells with real data
                    row.innerHTML = `
                        <div class="grid-cell select-cell">
                            <input type="checkbox" class="row-select" value="${cert.id}" onchange="updateBulkActions()">
