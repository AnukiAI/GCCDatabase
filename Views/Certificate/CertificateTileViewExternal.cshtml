                        // Helper functions to map data
            function getCsfAttributesFromType(type) {
                const mappings = {
                    'greencircle-audited': 'GreenCircle Audited',
                    'environmental-facts': 'Environmental Facts',
                    'energy-savings': 'Energy Savings',
                    'recycled-content': 'Recycled Content',
                    'csf': 'CSF',
                    'lca-optimized': 'LCA Optimized',
                    'material-ingredient': 'Material Ingredient'
                };
                return mappings[type] || type;
            }

            function getCategoryFromType(category) {
                const mappings = {
                    'construction': 'Construction / Building Products',
                    'electronics': 'Electronics, Computers, and Accessories',
                    'paper': 'Packaging',
                    'recycling': 'Chemicals and Raw Materials',
                    'packaging': 'Packaging'
                };
                return mappings[category] || category;
            }

            function getCompanyContact(company) {
                const contacts = {
                    'ASSA ABLOY': 'info@assaabloy.com',
                    'Superior Essex�': 'www.superioressex.com',
                    'GAF': 'info@gaf.com',
                    'Domtar Corporation': 'customerservice@domtar.com',
                    'Alcamare International Recycling Group': 'info@alcamare.com',
                    'CertainTeed Insulation Group': 'www.certainteed.com',
                    'Charter Next Generation': 'info@charternext.com',
                    'MAPEI': 'www.mapei.com'
                };

                // Check if company contains key phrases
                for (const [key, contact] of Object.entries(contacts)) {
                    if (company.includes(key)) {
                        return contact;
                    }
                }
                return 'info@company.com';
            }

            function getSubcategory(productType) {
                const subcategories = {
                    'Door Hardware': 'Door Hardware',
                    'Exit Device': 'Exit Device',
                    'Lock': 'Lock',
                    'Copper Cable': 'Copper Cable',
                    'Roof Insulation': 'Roof Insulation',
                    'Paper': 'Copy Paper',
                    'Plastic Pellets': 'HDPE',
                    'Roofing Product': 'Roofing Product',
                    'Insulation': 'Fiberglass Insulation',
                    'Plastic Film': 'Plastic Film',
                    'Lightweight Polymer Modified Mortars': 'Mortars'
                };
                return subcategories[productType] || productType;
            }

            function getExternalTag(certificationType) {
                const tags = {
                    'CERTIFIED SUSTAINABILITY FACTS': 'Energy Efficient',
                    'CERTIFIED ENVIRONMENTAL FACTS': 'Environmental',
                    'CERTIFIED ENERGY SAVINGS': 'Energy Star',
                    'RECYCLED CONTENT': 'Post-Consumer'
                };
                return tags[certificationType] || 'Sustainable';
            }

            function getInternalTag(effectiveDate) {
                if (!effectiveDate) return '';
                const date = new Date(effectiveDate);
                const quarter = Math.floor(date.getMonth() / 3) + 1;
                const year = date.getFullYear();
                return `Q${quarter}-${year}`;
            }

            // Generate example IDs (in production, these would come from your database)
            function generateASIN(certId) {
                return 'B0' + certId.replace('-', '') + 'XYZ';
            }

            function generateUPC(certId) {
                const num = certId.replace('-', '');
                return num.padEnd(12, '0');
            }

            function generateGTIN(certId) {
                return '00' + generateUPC(certId);
            }

            function generateEAN(certId) {
                return generateUPC(certId) + '0';
            }

