@{
    ViewData["Title"] = "Products";
    ViewData["BodyClass"] = "products-index";
}

@section Styles {
    <link href="~/css/product-index.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Companies & Products</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Products</a>
    </span>
}

<div class="container">
    <header class="page-header">
        <h1>Product Management</h1>
        <p class="subtitle">Manage products, categories, and product relationships</p>
    </header>

    <div class="products-grid">
        <div class="product-section">
            <h2 class="section-title">Product Management</h2>
            <p class="section-description">Add, edit, and manage individual products with their specifications and relationships.</p>
            <div class="section-stats">
                <div>
                    <div class="stat-number" id="total-products">0</div>
                    <div class="stat-label">Products</div>
                </div>
            </div>
            <a href="@Url.Action("Management", "Product")" class="btn">
                <i class="fas fa-cogs"></i> Manage Products
            </a>
        </div>

        <div class="product-section">
            <h2 class="section-title">Product Categories</h2>
            <p class="section-description">Organize products into hierarchical categories for better classification and navigation.</p>
            <div class="section-stats">
                <div>
                    <div class="stat-number" id="total-categories">0</div>
                    <div class="stat-label">Categories</div>
                </div>
            </div>
            <a href="@Url.Action("Categories", "Product")" class="btn">
                <i class="fas fa-sitemap"></i> Manage Categories
            </a>
        </div>

        <div class="product-section">
            <h2 class="section-title">Product Types</h2>
            <p class="section-description">Define and manage product types and their hierarchical relationships within categories.</p>
            <div class="section-stats">
                <div>
                    <div class="stat-number" id="total-types">0</div>
                    <div class="stat-label">Types</div>
                </div>
            </div>
            <a href="@Url.Action("ProductTypes", "Admin")" class="btn">
                <i class="fas fa-tags"></i> Manage Types
            </a>
        </div>

        <div class="product-section">
            <h2 class="section-title">Product Analytics</h2>
            <p class="section-description">View insights and analytics about products, categories, and their relationships with certificates.</p>
            <div class="section-stats">
                <div>
                    <div class="stat-number" id="total-certified-products">0</div>
                    <div class="stat-label">Certified</div>
                </div>
            </div>
            <a href="#" class="btn btn-secondary" onclick="showAnalytics()">
                <i class="fas fa-chart-line"></i> View Analytics
            </a>
        </div>
    </div>

    <div class="quick-stats">
        <h2>Quick Statistics</h2>
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-value" id="products-by-category">0</div>
                <div class="stat-label">Most Popular Category</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="recent-products">0</div>
                <div class="stat-label">Products Added This Month</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="active-products">0</div>
                <div class="stat-label">Active Products</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="companies-with-products">0</div>
                <div class="stat-label">Companies with Products</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load dashboard statistics
        async function loadDashboardStats() {
            try {
                // Load product statistics
                const response = await fetch('/Product/GetDashboardStats');
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        document.getElementById('total-products').textContent = data.data.totalProducts || 0;
                        document.getElementById('total-categories').textContent = data.data.totalCategories || 0;
                        document.getElementById('total-types').textContent = data.data.totalTypes || 0;
                        document.getElementById('total-certified-products').textContent = data.data.totalCertifiedProducts || 0;
                        document.getElementById('products-by-category').textContent = data.data.mostPopularCategory || 'N/A';
                        document.getElementById('recent-products').textContent = data.data.recentProducts || 0;
                        document.getElementById('active-products').textContent = data.data.activeProducts || 0;
                        document.getElementById('companies-with-products').textContent = data.data.companiesWithProducts || 0;
                    }
                }
            } catch (error) {
                console.error('Error loading dashboard stats:', error);
                // Set default values if API fails
                document.getElementById('total-products').textContent = '0';
                document.getElementById('total-categories').textContent = '0';
                document.getElementById('total-types').textContent = '0';
                document.getElementById('total-certified-products').textContent = '0';
                document.getElementById('products-by-category').textContent = 'N/A';
                document.getElementById('recent-products').textContent = '0';
                document.getElementById('active-products').textContent = '0';
                document.getElementById('companies-with-products').textContent = '0';
            }
        }

        function showAnalytics() {
            alert('Product analytics feature coming soon!');
        }

        // Load stats when page loads
        document.addEventListener('DOMContentLoaded', loadDashboardStats);
    </script>
}
