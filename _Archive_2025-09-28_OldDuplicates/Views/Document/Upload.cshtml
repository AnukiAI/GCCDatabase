@model GCCWebApp.Models.CertificateDocumentUploadViewModel
@{
    ViewData["Title"] = "Upload Certificate Document";
    var certificate = ViewBag.Certificate as GCCWebApp.Models.Certificate;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-upload"></i> Upload Document
                    </h4>
                    @if (certificate != null)
                    {
                        <small class="text-muted">
                            Certificate: @certificate.Number - @certificate.Company?.Name - @certificate.Product?.Name
                        </small>
                    }
                </div>
                <div class="card-body">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                        <input type="hidden" asp-for="CertificateId" />
                        
                        <div class="mb-3">
                            <label asp-for="File" class="form-label">Select Document</label>
                            <input asp-for="File" type="file" class="form-control" id="fileInput" accept=".pdf,.jpg,.jpeg,.png,.tiff,.doc,.docx" />
                            <span asp-validation-for="File" class="text-danger"></span>
                            <div class="form-text">
                                Allowed file types: PDF, JPG, PNG, TIFF, DOC, DOCX. Maximum file size: 10MB.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DocumentType" class="form-label">Document Type</label>
                            <select asp-for="DocumentType" class="form-select">
                                <option value="Certificate">Certificate</option>
                                <option value="Supporting">Supporting Document</option>
                                <option value="Amendment">Amendment</option>
                                <option value="Renewal">Renewal</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="DocumentType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description (Optional)</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter a description for this document..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsPublic" class="form-check-input" type="checkbox" />
                                <label asp-for="IsPublic" class="form-check-label">
                                    Make this document publicly accessible
                                </label>
                                <div class="form-text">
                                    Public documents can be viewed by external users without authentication.
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Details", "Certificate", new { id = Model.CertificateId })" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Certificate
                            </a>
                            <button type="submit" class="btn btn-primary" id="uploadBtn">
                                <i class="fas fa-upload"></i> Upload Document
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i> Upload Guidelines
                    </h5>
                </div>
                <div class="card-body">
                    <h6>Supported File Types:</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-file-pdf text-danger"></i> PDF documents</li>
                        <li><i class="fas fa-file-image text-primary"></i> Images (JPG, PNG, TIFF)</li>
                        <li><i class="fas fa-file-word text-primary"></i> Word documents (DOC, DOCX)</li>
                    </ul>

                    <h6 class="mt-3">Security:</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-shield-alt text-success"></i> Files are virus scanned</li>
                        <li><i class="fas fa-lock text-success"></i> Secure file storage</li>
                        <li><i class="fas fa-fingerprint text-success"></i> File integrity verification</li>
                    </ul>

                    <h6 class="mt-3">File Size Limits:</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-file"></i> Maximum: 10MB per file</li>
                        <li><i class="fas fa-compress"></i> Consider compressing large files</li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i> Document Types
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Certificate</dt>
                        <dd class="col-sm-8">Main certificate document</dd>
                        
                        <dt class="col-sm-4">Supporting</dt>
                        <dd class="col-sm-8">Additional supporting documentation</dd>
                        
                        <dt class="col-sm-4">Amendment</dt>
                        <dd class="col-sm-8">Certificate amendments or corrections</dd>
                        
                        <dt class="col-sm-4">Renewal</dt>
                        <dd class="col-sm-8">Certificate renewal documents</dd>
                        
                        <dt class="col-sm-4">Other</dt>
                        <dd class="col-sm-8">Other related documents</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // File input change handler
            $('#fileInput').on('change', function() {
                const file = this.files[0];
                if (file) {
                    const fileSize = file.size;
                    const maxSize = 10 * 1024 * 1024; // 10MB
                    
                    if (fileSize > maxSize) {
                        alert('File size exceeds the maximum limit of 10MB. Please select a smaller file.');
                        $(this).val('');
                        return;
                    }
                    
                    // Display file info
                    const fileSizeMB = (fileSize / (1024 * 1024)).toFixed(2);
                    console.log(`Selected file: ${file.name} (${fileSizeMB} MB)`);
                }
            });

            // Upload form submit handler
            $('#uploadForm').on('submit', function(e) {
                const fileInput = $('#fileInput')[0];
                if (!fileInput.files || fileInput.files.length === 0) {
                    e.preventDefault();
                    alert('Please select a file to upload.');
                    return false;
                }
                
                // Disable submit button to prevent double submission
                $('#uploadBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Uploading...');
            });

            // Drag and drop functionality
            const form = document.getElementById('uploadForm');
            const fileInput = document.getElementById('fileInput');

            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                form.addEventListener(eventName, preventDefaults, false);
                document.body.addEventListener(eventName, preventDefaults, false);
            });

            ['dragenter', 'dragover'].forEach(eventName => {
                form.addEventListener(eventName, highlight, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                form.addEventListener(eventName, unhighlight, false);
            });

            form.addEventListener('drop', handleDrop, false);

            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }

            function highlight(e) {
                form.classList.add('drag-highlight');
            }

            function unhighlight(e) {
                form.classList.remove('drag-highlight');
            }

            function handleDrop(e) {
                const dt = e.dataTransfer;
                const files = dt.files;

                if (files.length > 0) {
                    fileInput.files = files;
                    $(fileInput).trigger('change');
                }
            }
        });
    </script>

    <style>
        .drag-highlight {
            border: 2px dashed #007bff !important;
            background-color: #f8f9fa !important;
        }
        
        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border: 1px solid rgba(0, 0, 0, 0.125);
        }
        
        .form-text {
            font-size: 0.875em;
            color: #6c757d;
        }
        
        .list-unstyled li {
            margin-bottom: 0.25rem;
        }
        
        .fas {
            width: 1.2em;
        }
    </style>
}