@{
    ViewData["Title"] = "Product Management V2";
    ViewData["BodyClass"] = "admin-product-management-v2";
}

@section Styles {
    <link href="~/css/product-management-v2.css" rel="stylesheet" />
}

@section Breadcrumbs {
    <span class="role-element role-analyst-show role-admin-show">
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Companies & Products</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="@Url.Action("Index", "Product")">Products</a>
        <span class="separator"><i class="fas fa-chevron-right"></i></span>
        <a href="#">Product Management V2</a>
    </span>
}

<div class="admin-container">
    <header class="admin-header">
        <div class="title-area">
            <h1>Product Management</h1>
            <p class="subtitle">Streamlined view with integrated export capabilities</p>
        </div>
        <div class="buttons-area">
            <button id="import-btn" class="btn">
                <i class="fas fa-upload"></i> Import
            </button>
            <button id="export-all-btn" class="btn">
                <i class="fas fa-download"></i> Export All
            </button>
            <button id="add-product-btn" class="btn btn-add">
                <i class="fas fa-plus"></i> Add New Product
            </button>
        </div>
    </header>

    <div class="search-filter-bar">
        <div class="search-box">
            <input type="text" id="search-input" placeholder="Search products...">
            <i class="fas fa-search search-icon"></i>
        </div>
        <div class="filters">
            <select id="category-filter" class="filter-select">
                <option value="all">All Categories</option>
            </select>
            <select id="company-filter" class="filter-select">
                <option value="all">All Companies</option>
            </select>
            <select id="status-filter" class="filter-select">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
    </div>

    <div class="export-options-panel" id="export-options-panel">
        <div class="panel-header">
            <h3>Export Options</h3>
            <button class="close-panel" onclick="closeExportPanel()">×</button>
        </div>
        <div class="panel-content">
            <div class="export-format-section">
                <label>Export Format:</label>
                <div class="format-options">
                    <label><input type="radio" name="export-format" value="csv" checked> CSV</label>
                    <label><input type="radio" name="export-format" value="excel"> Excel</label>
                    <label><input type="radio" name="export-format" value="json"> JSON</label>
                </div>
            </div>
            <div class="export-fields-section">
                <label>Include Identifier Types:</label>
                <div class="identifier-checkboxes">
                    <label><input type="checkbox" name="identifier-types" value="asin" checked> ASIN</label>
                    <label><input type="checkbox" name="identifier-types" value="upc" checked> UPC</label>
                    <label><input type="checkbox" name="identifier-types" value="gtin" checked> GTIN</label>
                    <label><input type="checkbox" name="identifier-types" value="ean" checked> EAN</label>
                </div>
            </div>
            <div class="export-structure-section">
                <label>Export Structure:</label>
                <div class="structure-options">
                    <label><input type="radio" name="export-structure" value="grouped" checked> One row per product (comma-separated) - Recommended</label>
                    <label><input type="radio" name="export-structure" value="columns"> Separate columns per identifier type</label>
                    <label><input type="radio" name="export-structure" value="expanded"> One row per identifier (for analysis)</label>
                </div>
            </div>
            <div class="panel-actions">
                <button class="btn btn-secondary" onclick="closeExportPanel()">Cancel</button>
                <button class="btn btn-primary" onclick="performExport()">Export</button>
            </div>
        </div>
    </div>

    <div class="table-container">
        <table id="product-table">
            <thead>
                <tr>
                    <th width="5%"></th>
                    <th width="20%" data-sort="name">Product Name <span class="sort-icon">▼</span></th>
                    <th width="15%" data-sort="company">Company <span class="sort-icon">▼</span></th>
                    <th width="15%" data-sort="category">Category <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="status">Status <span class="sort-icon">▼</span></th>
                    <th width="10%" data-sort="certificates">Certificates <span class="sort-icon">▼</span></th>
                    <th width="15%" data-sort="identifiers">Identifiers <span class="sort-icon">▼</span></th>
                    <th class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be populated by JavaScript -->
            </tbody>
        </table>
    </div>

    <div class="footer-info">
        <span id="product-count">Showing 0 of 0 products</span>
    </div>
</div>

<!-- Add/Edit Product Modal -->
<div id="product-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="modal-title">Add New Product</h3>
            <span class="modal-close">&times;</span>
        </div>
        <form id="product-form">
            <input type="hidden" id="product-id">

            <div class="form-row">
                <div class="form-group">
                    <label for="product-name">Product Name *</label>
                    <input type="text" id="product-name" required>
                </div>
                <div class="form-group">
                    <label for="product-company">Company *</label>
                    <select id="product-company" required>
                        <option value="">Select Company</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="product-description">Description</label>
                <textarea id="product-description" rows="3" placeholder="Enter product description..."></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="product-category">Category</label>
                    <select id="product-category">
                        <option value="">Select Category</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="product-type">Product Type</label>
                    <select id="product-type">
                        <option value="">Select Type</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="product-subcategory">Subcategory</label>
                    <select id="product-subcategory">
                        <option value="">Select Subcategory</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="product-status">Status *</label>
                    <select id="product-status" required>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="product-sku">SKU</label>
                    <input type="text" id="product-sku" placeholder="Product SKU">
                </div>
                <div class="form-group">
                    <label for="product-model">Model Number</label>
                    <input type="text" id="product-model" placeholder="Model number">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="product-manufacturer">Manufacturer</label>
                    <input type="text" id="product-manufacturer" placeholder="Manufacturer name">
                </div>
                <div class="form-group">
                    <label for="product-country">Country of Origin</label>
                    <input type="text" id="product-country" placeholder="Country">
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn" id="cancel-btn">Cancel</button>
                <button type="submit" class="btn btn-primary" id="save-btn">Save Product</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Sample data with complex identifier sets
        let products = [
            {
                id: 1,
                name: 'Premium Door Handle',
                company: 'Acme Corporation',
                category: 'Building Materials',
                type: 'Door Hardware',
                status: 'Active',
                certificates: 2,
                description: 'High-quality door handle with stainless steel finish',
                sku: 'ACM-DH-001',
                model: 'DH-Premium-2024',
                manufacturer: 'Acme Corp',
                country: 'USA',
                identifiers: {
                    asin: ['B08XYZ1234', 'B09ABC5678', 'B07DEF9012'],
                    upc: ['123456789012', '234567890123', '345678901234'],
                    gtin: ['01234567890128', '12345678901235', '23456789012342'],
                    ean: ['1234567890128', '2345678901235', '3456789012342']
                }
            },
            {
                id: 2,
                name: 'Thermal Insulation Board',
                company: 'Globex Industries',
                category: 'Building Materials',
                type: 'Insulation',
                status: 'Active',
                certificates: 3,
                description: 'Energy-efficient insulation board for construction',
                sku: 'GLX-INS-002',
                model: 'Thermal-Pro-X1',
                manufacturer: 'Globex Inc',
                country: 'Canada',
                identifiers: {
                    asin: ['B10MNO3456', 'B11PQR7890', 'B12STU1234', 'B13VWX5678', 'B14YZA9012'],
                    upc: ['456789012345', '567890123456', '678901234567', '789012345678', '890123456789'],
                    gtin: ['34567890123456', '45678901234567', '56789012345678', '67890123456789', '78901234567890'],
                    ean: ['4567890123456', '5678901234567', '6789012345678', '7890123456789', '8901234567890']
                }
            },
            {
                id: 3,
                name: 'LED Light Fixture',
                company: 'Stark Enterprises',
                category: 'Electronics / Electrical',
                type: 'Lighting',
                status: 'Active',
                certificates: 1,
                description: 'Energy-efficient LED lighting solution',
                sku: 'STK-LED-003',
                model: 'LED-Bright-500',
                manufacturer: 'Stark Tech',
                country: 'Germany',
                identifiers: {
                    asin: ['B14YZA9012', 'B15BCD3456'],
                    upc: ['890123456789', '901234567890'],
                    gtin: ['78901234567890', '89012345678901'],
                    ean: ['8901234567890', '9012345678901']
                }
            },
            {
                id: 4,
                name: 'Network Cable Cat6',
                company: 'Wayne Technologies',
                category: 'Electronics / Electrical',
                type: 'Network Cables',
                status: 'Inactive',
                certificates: 0,
                description: 'High-speed network cable for data transmission',
                sku: 'WYN-CAB-004',
                model: 'Cat6-Ultra-100m',
                manufacturer: 'Wayne Tech',
                country: 'Japan',
                identifiers: {
                    asin: ['B16EFG7890', 'B17HIJ1234', 'B18KLM5678', 'B19NOP9012', 'B20QRS3456', 'B21TUV7890', 'B22WXY1234'],
                    upc: ['012345678901', '123456789012', '234567890123', '345678901234', '456789012345', '567890123456', '678901234567'],
                    gtin: ['90123456789012', '01234567890123', '12345678901234', '23456789012345', '34567890123456', '45678901234567', '56789012345678'],
                    ean: ['0123456789012', '1234567890123', '2345678901234', '3456789012345', '4567890123456', '5678901234567', '6789012345678']
                }
            },
            {
                id: 5,
                name: 'Smart Thermostat Pro',
                company: 'TechHome Solutions',
                category: 'Electronics / Electrical',
                type: 'HVAC Controls',
                status: 'Active',
                certificates: 4,
                description: 'WiFi-enabled smart thermostat with energy optimization',
                sku: 'THS-STP-005',
                model: 'SmartTherm-Pro-2024',
                manufacturer: 'TechHome',
                country: 'China',
                identifiers: {
                    asin: ['B23ABC1234', 'B24DEF5678', 'B25GHI9012', 'B26JKL3456'],
                    upc: ['789012345678', '890123456789', '901234567890', '012345678901'],
                    gtin: ['67890123456789', '78901234567890', '89012345678901', '90123456789012'],
                    ean: ['7890123456789', '8901234567890', '9012345678901', '0123456789012']
                }
            }
        ];

        let companies = [];
        let categories = [];
        let productTypes = [];
        let exportingProductId = null;

        // DOM Elements
        const productTable = document.getElementById('product-table');
        const productTableBody = productTable.querySelector('tbody');
        const productCountElement = document.getElementById('product-count');
        const searchInput = document.getElementById('search-input');
        const categoryFilter = document.getElementById('category-filter');
        const companyFilter = document.getElementById('company-filter');
        const statusFilter = document.getElementById('status-filter');
        const importBtn = document.getElementById('import-btn');
        const exportAllBtn = document.getElementById('export-all-btn');
        const addProductBtn = document.getElementById('add-product-btn');
        const exportOptionsPanel = document.getElementById('export-options-panel');
        
        // Modal elements
        const productModal = document.getElementById('product-modal');
        const modalTitle = document.getElementById('modal-title');
        const productForm = document.getElementById('product-form');
        const modalClose = document.querySelector('.modal-close');
        const cancelBtn = document.getElementById('cancel-btn');

        // Sorting variables
        let sortColumn = 'name';
        let sortDirection = 'asc';
        let currentEditingId = null;

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            loadInitialData();
            initializeEventListeners();
            initializeSortableHeaders();
            populateTable();
        });

        async function loadInitialData() {
            try {
                // Load products from API
                await loadProducts();

                // Load companies for dropdown
                const companyResponse = await fetch('/Product/GetCompanies');
                if (companyResponse.ok) {
                    const companyData = await companyResponse.json();
                    if (companyData.success) {
                        companies = companyData.data;
                        populateCompanyDropdowns();
                    }
                }

                // Load categories for dropdown
                const categoryResponse = await fetch('/Product/GetCategories');
                if (categoryResponse.ok) {
                    const categoryData = await categoryResponse.json();
                    if (categoryData.success) {
                        categories = categoryData.data;
                        populateCategoryDropdowns();
                    }
                }

                // Load product types for dropdown
                const typesResponse = await fetch('/Product/GetProductTypes');
                if (typesResponse.ok) {
                    const typesData = await typesResponse.json();
                    if (typesData.success) {
                        productTypes = typesData.data;
                    }
                }
            } catch (error) {
                console.error('Error loading initial data:', error);
            }
        }

        async function loadProducts() {
            try {
                const response = await fetch('/Product/GetProducts');
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        products = data.data.map(p => ({
                            ...p,
                            identifiers: p.identifiers || {}
                        }));
                    } else {
                        console.error('Failed to load products:', data.message);
                    }
                } else {
                    console.error('Failed to fetch products');
                }
            } catch (error) {
                console.error('Error loading products:', error);
            }
        }

        function populateCompanyDropdowns() {
            const companySelect = document.getElementById('product-company');
            const companyFilterSelect = document.getElementById('company-filter');
            
            companySelect.innerHTML = '<option value="">Select Company</option>';
            companyFilterSelect.innerHTML = '<option value="all">All Companies</option>';
            
            companies.forEach(company => {
                const option1 = new Option(company.name, company.id);
                const option2 = new Option(company.name, company.name);
                companySelect.add(option1);
                companyFilterSelect.add(option2);
            });
        }

        function populateCategoryDropdowns() {
            const categorySelect = document.getElementById('product-category');
            const categoryFilterSelect = document.getElementById('category-filter');
            
            categorySelect.innerHTML = '<option value="">Select Category</option>';
            categoryFilterSelect.innerHTML = '<option value="all">All Categories</option>';
            
            categories.forEach(category => {
                const option1 = new Option(category.name, category.id);
                const option2 = new Option(category.name, category.name);
                categorySelect.add(option1);
                categoryFilterSelect.add(option2);
            });
        }

        function initializeEventListeners() {
            // Search and filter events
            searchInput.addEventListener('input', populateTable);
            categoryFilter.addEventListener('change', populateTable);
            companyFilter.addEventListener('change', populateTable);
            statusFilter.addEventListener('change', populateTable);

            // Button events
            addProductBtn.addEventListener('click', showAddProductModal);
            importBtn.addEventListener('click', importProducts);
            exportAllBtn.addEventListener('click', () => showExportOptions(null));

            // Modal events
            modalClose.addEventListener('click', closeModal);
            cancelBtn.addEventListener('click', closeModal);
            productForm.addEventListener('submit', saveProduct);

            // Close modal when clicking outside
            window.addEventListener('click', function(event) {
                if (event.target === productModal) {
                    closeModal();
                }
                if (event.target === exportOptionsPanel) {
                    closeExportPanel();
                }
            });
        }

        function populateTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const categoryFilter = document.getElementById('category-filter').value;
            const companyFilter = document.getElementById('company-filter').value;
            const statusFilter = document.getElementById('status-filter').value;

            // Filter products
            let filteredProducts = products.filter(product => {
                const matchesSearch = product.name.toLowerCase().includes(searchTerm) ||
                                    product.company.toLowerCase().includes(searchTerm) ||
                                    product.category.toLowerCase().includes(searchTerm) ||
                                    product.type.toLowerCase().includes(searchTerm);
                const matchesCategory = categoryFilter === 'all' || product.category === categoryFilter;
                const matchesCompany = companyFilter === 'all' || product.company === companyFilter;
                const matchesStatus = statusFilter === 'all' || product.status.toLowerCase() === statusFilter;
                
                return matchesSearch && matchesCategory && matchesCompany && matchesStatus;
            });

            // Sort filtered products
            filteredProducts.sort((a, b) => {
                const aValue = a[sortColumn] || '';
                const bValue = b[sortColumn] || '';
                
                if (sortDirection === 'asc') {
                    return aValue.toString().localeCompare(bValue.toString());
                } else {
                    return bValue.toString().localeCompare(aValue.toString());
                }
            });

            // Populate table
            productTableBody.innerHTML = '';
            
            filteredProducts.forEach(product => {
                // Main row
                const row = document.createElement('tr');
                row.className = 'main-row expandable-row';
                row.setAttribute('data-product-id', product.id);
                
                const totalIdentifiers = product.identifiers ? 
                    Object.values(product.identifiers).reduce((sum, arr) => sum + arr.length, 0) : 0;
                
                row.innerHTML = `
                    <td>
                        <span class="expand-indicator" onclick="toggleRowDetails(${product.id})">▶</span>
                    </td>
                    <td>
                        <div class="product-info">
                            <div class="product-name">${product.name}</div>
                            <div class="product-sku">SKU: ${product.sku || 'N/A'}</div>
                        </div>
                    </td>
                    <td>${product.company}</td>
                    <td>
                        <div class="category-info">
                            <div class="category-name">${product.category}</div>
                            <div class="product-type">${product.type}</div>
                        </div>
                    </td>
                    <td>
                        <span class="status-badge status-${product.status.toLowerCase()}">${product.status}</span>
                    </td>
                    <td>
                        <span class="certificate-count">
                            <i class="fas fa-certificate"></i> ${product.certificates}
                        </span>
                    </td>
                    <td>
                        <div class="identifiers-cell">
                            <span class="identifier-count">${totalIdentifiers}</span> identifiers
                            <button class="btn-view-identifiers" onclick="toggleRowDetails(${product.id})" title="View identifiers">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </td>
                    <td class="actions-cell">
                        <button class="btn-edit" onclick="editProduct(${product.id})" title="Edit Product">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn-view" onclick="viewProduct(${product.id})" title="View Details">
                            <i class="fas fa-info-circle"></i>
                        </button>
                        <button class="btn-export-product" onclick="exportSingleProduct(${product.id})" title="Export identifiers">
                            <i class="fas fa-download"></i>
                        </button>
                        <button class="btn-delete" onclick="deleteProduct(${product.id})" title="Delete Product">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                `;
                productTableBody.appendChild(row);

                // Detail row
                const detailRow = document.createElement('tr');
                detailRow.className = 'detail-row';
                detailRow.setAttribute('data-product-id', product.id);
                detailRow.innerHTML = `
                    <td colspan="8" class="detail-cell">
                        <div class="detail-content">
                            ${createIdentifierSections(product.identifiers || {})}
                        </div>
                    </td>
                `;
                productTableBody.appendChild(detailRow);
            });

            // Update count
            productCountElement.textContent = `Showing ${filteredProducts.length} of ${products.length} products`;
        }

        function createIdentifierSections(identifiers) {
            let sections = '';
            
            Object.keys(identifiers).forEach(type => {
                if (identifiers[type] && identifiers[type].length > 0) {
                    const typeLabel = type.toUpperCase();
                    const items = identifiers[type];
                    
                    sections += `
                        <div class="detail-section">
                            <div class="detail-section-title">${typeLabel} (${items.length})</div>
                            <div class="detail-grid">
                                ${items.map(item => `<div class="detail-item">${item}</div>`).join('')}
                            </div>
                            <div class="copy-section">
                                <div class="copy-header">
                                    <span>Copy All ${typeLabel}:</span>
                                    <button class="copy-btn" onclick="copyToClipboard('${items.join(', ')}')">Copy</button>
                                </div>
                                <div class="copy-text">${items.join(', ')}</div>
                            </div>
                        </div>
                    `;
                }
            });
            
            return sections || '<div class="detail-section"><div class="detail-section-title">No identifiers available</div></div>';
        }

        function toggleRowDetails(productId) {
            const indicator = document.querySelector(`tr[data-product-id="${productId}"] .expand-indicator`);
            const detailRow = document.querySelector(`tr.detail-row[data-product-id="${productId}"]`);
            const viewBtn = document.querySelector(`tr[data-product-id="${productId}"] .btn-view-identifiers i`);
            
            if (detailRow) {
                const isExpanded = detailRow.classList.contains('show');
                
                // Close all other expanded rows
                document.querySelectorAll('.detail-row.show').forEach(row => {
                    if (row !== detailRow) {
                        row.classList.remove('show');
                        const otherId = row.getAttribute('data-product-id');
                        const otherIndicator = document.querySelector(`tr[data-product-id="${otherId}"] .expand-indicator`);
                        const otherViewBtn = document.querySelector(`tr[data-product-id="${otherId}"] .btn-view-identifiers i`);
                        if (otherIndicator) {
                            otherIndicator.textContent = '▶';
                            otherIndicator.classList.remove('expanded');
                        }
                        if (otherViewBtn) {
                            otherViewBtn.classList.remove('fa-eye-slash');
                            otherViewBtn.classList.add('fa-eye');
                        }
                    }
                });
                
                if (isExpanded) {
                    detailRow.classList.remove('show');
                    indicator.textContent = '▶';
                    indicator.classList.remove('expanded');
                    if (viewBtn) {
                        viewBtn.classList.remove('fa-eye-slash');
                        viewBtn.classList.add('fa-eye');
                    }
                } else {
                    detailRow.classList.add('show');
                    indicator.textContent = '▼';
                    indicator.classList.add('expanded');
                    if (viewBtn) {
                        viewBtn.classList.remove('fa-eye');
                        viewBtn.classList.add('fa-eye-slash');
                    }
                }
            }
        }

        function showExportOptions(productId) {
            exportingProductId = productId;
            exportOptionsPanel.style.display = 'block';
        }

        function closeExportPanel() {
            exportOptionsPanel.style.display = 'none';
            exportingProductId = null;
        }

        function performExport() {
            const format = document.querySelector('input[name="export-format"]:checked').value;
            const structure = document.querySelector('input[name="export-structure"]:checked').value;
            const selectedTypes = Array.from(document.querySelectorAll('input[name="identifier-types"]:checked'))
                .map(cb => cb.value);
            
            if (selectedTypes.length === 0) {
                showToast('Please select at least one identifier type to export', 'error');
                return;
            }
            
            const productsToExport = exportingProductId 
                ? products.filter(p => p.id === exportingProductId)
                : products;
            
            exportData(productsToExport, format, structure, selectedTypes);
            closeExportPanel();
        }

        function exportSingleProduct(productId) {
            showExportOptions(productId);
        }

        function exportData(productsToExport, format, structure, identifierTypes) {
            let data;
            let filename;
            let contentType;
            
            switch (format) {
                case 'csv':
                    data = generateCSV(productsToExport, structure, identifierTypes);
                    filename = `products_export_${new Date().toISOString().split('T')[0]}.csv`;
                    contentType = 'text/csv';
                    break;
                case 'excel':
                    data = generateCSV(productsToExport, structure, identifierTypes);
                    filename = `products_export_${new Date().toISOString().split('T')[0]}.csv`;
                    contentType = 'text/csv';
                    showToast('Excel export will use CSV format', 'info');
                    break;
                case 'json':
                    data = generateJSON(productsToExport, identifierTypes);
                    filename = `products_export_${new Date().toISOString().split('T')[0]}.json`;
                    contentType = 'application/json';
                    break;
            }
            
            downloadFile(data, filename, contentType);
            showToast(`Exported ${productsToExport.length} product${productsToExport.length > 1 ? 's' : ''} successfully`, 'success');
        }

        function generateCSV(productsToExport, structure, identifierTypes) {
            let csvContent = '';
            
            switch (structure) {
                case 'expanded':
                    // One row per identifier
                    csvContent = 'Product Name,Company,Category,Status,Identifier Type,Identifier Value,SKU,Model\n';
                    productsToExport.forEach(product => {
                        identifierTypes.forEach(type => {
                            if (product.identifiers[type]) {
                                product.identifiers[type].forEach(identifier => {
                                    csvContent += `"${product.name}","${product.company}","${product.category}","${product.status}","${type.toUpperCase()}","${identifier}","${product.sku || ''}","${product.model || ''}"\n`;
                                });
                            }
                        });
                    });
                    break;
                    
                case 'grouped':
                    // One row per product, comma-separated identifiers
                    const typeHeaders = identifierTypes.map(t => t.toUpperCase()).join(',');
                    csvContent = `Product Name,Company,Category,Status,SKU,Model,${typeHeaders}\n`;
                    productsToExport.forEach(product => {
                        const identifierValues = identifierTypes.map(type => {
                            const ids = product.identifiers[type] || [];
                            return `"${ids.join(', ')}"`;
                        }).join(',');
                        csvContent += `"${product.name}","${product.company}","${product.category}","${product.status}","${product.sku || ''}","${product.model || ''}",${identifierValues}\n`;
                    });
                    break;
                    
                case 'columns':
                    // Separate columns for each identifier (up to max found)
                    const maxIdentifiers = Math.max(...productsToExport.map(p => 
                        Math.max(...identifierTypes.map(t => (p.identifiers[t] || []).length))
                    ));
                    
                    let headers = 'Product Name,Company,Category,Status,SKU,Model';
                    identifierTypes.forEach(type => {
                        for (let i = 1; i <= maxIdentifiers; i++) {
                            headers += `,${type.toUpperCase()}_${i}`;
                        }
                    });
                    csvContent = headers + '\n';
                    
                    productsToExport.forEach(product => {
                        let row = `"${product.name}","${product.company}","${product.category}","${product.status}","${product.sku || ''}","${product.model || ''}"`;
                        identifierTypes.forEach(type => {
                            const ids = product.identifiers[type] || [];
                            for (let i = 0; i < maxIdentifiers; i++) {
                                row += `,"${ids[i] || ''}"`;
                            }
                        });
                        csvContent += row + '\n';
                    });
                    break;
            }
            
            return csvContent;
        }

        function generateJSON(productsToExport, identifierTypes) {
            const exportData = productsToExport.map(product => ({
                id: product.id,
                name: product.name,
                company: product.company,
                category: product.category,
                status: product.status,
                sku: product.sku,
                model: product.model,
                identifiers: Object.fromEntries(
                    identifierTypes
                        .filter(type => product.identifiers[type])
                        .map(type => [type, product.identifiers[type]])
                )
            }));
            
            return JSON.stringify(exportData, null, 2);
        }

        function downloadFile(content, filename, contentType) {
            const blob = new Blob([content], { type: contentType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                showToast('Copied to clipboard!', 'success');
            }).catch(err => {
                console.error('Failed to copy: ', err);
                showToast('Failed to copy to clipboard', 'error');
            });
        }

        function initializeSortableHeaders() {
            const headers = productTable.querySelectorAll('th[data-sort]');
            headers.forEach(header => {
                header.addEventListener('click', () => {
                    const column = header.getAttribute('data-sort');
                    if (sortColumn === column) {
                        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortColumn = column;
                        sortDirection = 'asc';
                    }
                    
                    headers.forEach(h => h.classList.remove('active-sort'));
                    header.classList.add('active-sort');
                    
                    const sortIcon = header.querySelector('.sort-icon');
                    sortIcon.textContent = sortDirection === 'asc' ? '▲' : '▼';
                    
                    populateTable();
                });
            });
        }

        // Modal and other functions
        function showAddProductModal() {
            modalTitle.textContent = 'Add New Product';
            document.getElementById('product-id').value = '';
            productForm.reset();
            productModal.style.display = 'block';
        }

        function editProduct(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            modalTitle.textContent = 'Edit Product';
            document.getElementById('product-id').value = product.id;
            document.getElementById('product-name').value = product.name;
            document.getElementById('product-description').value = product.description || '';
            document.getElementById('product-status').value = product.status.toLowerCase();
            document.getElementById('product-sku').value = product.sku || '';
            document.getElementById('product-model').value = product.model || '';
            document.getElementById('product-manufacturer').value = product.manufacturer || '';
            document.getElementById('product-country').value = product.country || '';
            
            productModal.style.display = 'block';
        }

        function viewProduct(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;
            
            alert(`Product Details:\n\nName: ${product.name}\nCompany: ${product.company}\nCategory: ${product.category}\nType: ${product.type}\nStatus: ${product.status}\nCertificates: ${product.certificates}\n\nDescription: ${product.description || 'N/A'}`);
        }

        async function deleteProduct(id) {
            if (confirm('Are you sure you want to delete this product?')) {
                try {
                    const response = await fetch(`/Product/DeleteProduct?id=${id}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        const result = await response.json();
                        if (result.success) {
                            await loadProducts();
                            populateTable();
                            showToast(result.message || 'Product deleted successfully');
                        } else {
                            showToast(result.message || 'Error deleting product', 'error');
                        }
                    } else {
                        showToast('Error deleting product', 'error');
                    }
                } catch (error) {
                    console.error('Error deleting product:', error);
                    showToast('Error deleting product', 'error');
                }
            }
        }

        async function saveProduct(e) {
            e.preventDefault();
            
            const formData = {
                id: parseInt(document.getElementById('product-id').value) || 0,
                name: document.getElementById('product-name').value,
                description: document.getElementById('product-description').value,
                categoryId: parseInt(document.getElementById('product-category').value) || 0,
                productTypeId: parseInt(document.getElementById('product-type').value) || null,
                companyId: parseInt(document.getElementById('product-company').value) || null,
                isActive: document.getElementById('product-status').value === 'active',
                model: document.getElementById('product-model').value,
                sku: document.getElementById('product-sku').value
            };

            try {
                const response = await fetch('/Product/SaveProduct', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        await loadProducts();
                        closeModal();
                        populateTable();
                        showToast(result.message || (formData.id ? 'Product updated successfully' : 'Product added successfully'));
                    } else {
                        showToast(result.message || 'Error saving product', 'error');
                    }
                } else {
                    showToast('Error saving product', 'error');
                }
            } catch (error) {
                console.error('Error saving product:', error);
                showToast('Error saving product', 'error');
            }
        }

        function closeModal() {
            productModal.style.display = 'none';
            productForm.reset();
        }

        function importProducts() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.csv';
            input.onchange = function(e) {
                const file = e.target.files[0];
                if (file) {
                    showToast('Import functionality will be implemented with backend integration');
                }
            };
            input.click();
        }

        function showToast(message, type = 'success') {
            let toast = document.getElementById('product-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'product-toast';
                toast.className = 'product-toast';
                document.body.appendChild(toast);
            }
            
            toast.textContent = message;
            toast.className = `product-toast ${type} show`;
            
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }
    </script>
}