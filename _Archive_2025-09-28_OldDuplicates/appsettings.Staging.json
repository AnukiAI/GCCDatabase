{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAdB2C": {
    "Instance": "https://{tenant-name}.b2clogin.com/",
    "ClientId": "{staging-client-id}",
    "ClientSecret": "{staging-client-secret}",
    "Domain": "{tenant-name}.onmicrosoft.com",
    "TenantId": "{staging-tenant-id}",
    "SignUpSignInPolicyId": "B2C_1_SignUpSignIn",
    "ResetPasswordPolicyId": "B2C_1_PasswordReset",
    "EditProfilePolicyId": "B2C_1_ProfileEdit",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:{staging-server}.database.windows.net,1433;Database=GCCDatabase_Staging;Authentication=Active Directory Default;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;",
    "SqliteConnection": "Data Source=gcc_database_staging.db"
  },
  "Jwt": {
    "Key": "{STAGING_JWT_SECRET_KEY}",
    "Issuer": "GCCWebApp-Staging",
    "Audience": "GCCWebApp-Staging",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": [
    "https://gcc-staging.azurewebsites.net",
    "https://gcc-staging.{your-domain}.com"
  ],
  "ApplicationInsights": {
    "ConnectionString": "{staging-app-insights-connection-string}"
  },
  "KeyVault": {
    "VaultUri": "https://{staging-keyvault-name}.vault.azure.net/"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1h",
        "Limit": 1000
      }
    ]
  }
}