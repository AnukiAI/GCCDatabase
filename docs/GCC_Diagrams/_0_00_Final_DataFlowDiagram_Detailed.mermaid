flowchart TB
    %% External entities
    User[fa:fa-user Users]
    Admins[fa:fa-user-cog Administrators]
    ApiUsers[fa:fa-plug API Users]
    Amazon[fa:fa-shopping-cart Amazon]
    
    %% Processes
    AuthProcess[("1.0\nAuthentication\nProcess")]
    CertMgmt[("2.0\nCertificate\nManagement")]
    ProdMgmt[("3.0\nProduct & Company\nManagement")]
    SearchProcess[("4.0\nSearch & Filter\nProcess")]
    ApiProcess[("5.0\nAPI\nProcessing")]
    ReportProcess[("6.0\nReporting\nProcess")]
    
    %% Data stores
    UserDS[(User Database)]
    CertDS[(Certificate Database)]
    ProductDS[(Product Database)]
    AuthLogDS[(Authentication Logs)]
    AuditLogDS[(Audit Logs)]
    ApiLogDS[(API Logs)]
    
    %% External user flows
    User -->|Login credentials| AuthProcess
    User -->|Search criteria| SearchProcess
    User -->|View certificate| CertMgmt
    
    %% Admin flows
    Admins -->|Login credentials| AuthProcess
    Admins -->|Create/Update certificates| CertMgmt
    Admins -->|Manage products & companies| ProdMgmt
    Admins -->|Generate reports| ReportProcess
    
    %% API user flows
    ApiUsers -->|API credentials| AuthProcess
    ApiUsers -->|API requests| ApiProcess
    
    %% Amazon specific flow
    Amazon -->|Certificate verification requests| ApiProcess
    
    %% Authentication process
    AuthProcess -->|Store session| UserDS
    AuthProcess -->|Log activity| AuthLogDS
    AuthProcess -->|Grant access| User
    AuthProcess -->|Grant access| Admins
    AuthProcess -->|Grant access token| ApiUsers
    
    %% Certificate management
    CertMgmt -->|Store certificate data| CertDS
    CertMgmt -->|Fetch product data| ProductDS
    CertMgmt -->|Record actions| AuditLogDS
    CertMgmt -->|Certificate details| User
    
    %% Product management
    ProdMgmt -->|Store product/company data| ProductDS
    ProdMgmt -->|Record actions| AuditLogDS
    
    %% Search process
    SearchProcess -->|Query certificates| CertDS
    SearchProcess -->|Query products| ProductDS
    SearchProcess -->|Return results| User
    
    %% API process
    ApiProcess -->|Verify auth token| UserDS
    ApiProcess -->|Query certificates| CertDS
    ApiProcess -->|Record API usage| ApiLogDS
    ApiProcess -->|Certificate data| ApiUsers
    ApiProcess -->|Certificate validation| Amazon
    
    %% Reporting process
    ReportProcess -->|Query certificates| CertDS
    ReportProcess -->|Query user data| UserDS
    ReportProcess -->|Query API usage| ApiLogDS
    ReportProcess -->|Reports| Admins
    
    %% Subprocesses - Authentication
    subgraph AuthSubprocess[Authentication Subprocesses]
        direction TB
        Login[("1.1\nUser\nLogin")]
        TokenGen[("1.2\nToken\nGeneration")]
        PermCheck[("1.3\nPermission\nCheck")]
        
        Login --> TokenGen
        TokenGen --> PermCheck
    end
    
    %% Subprocesses - Certificate Management
    subgraph CertSubprocess[Certificate Management Subprocesses]
        direction TB
        Create[("2.1\nCreate\nCertificate")]
        Update[("2.2\nUpdate\nCertificate")]
        StatusChange[("2.3\nStatus\nManagement")]
        FileUpload[("2.4\nDocument\nManagement")]
        
        Create --> StatusChange
        Update --> StatusChange
        StatusChange --> FileUpload
    end
    
    %% Subprocesses - API
    subgraph ApiSubprocess[API Subprocesses]
        direction TB
        ApiAuth[("5.1\nAPI\nAuthentication")]
        ApiQuery[("5.2\nQuery\nProcessing")]
        ApiRateLimit[("5.3\nRate\nLimiting")]
        
        ApiAuth --> ApiRateLimit
        ApiRateLimit --> ApiQuery
    end
    
    %% Connect subprocesses to main processes
    AuthProcess -.-> AuthSubprocess
    CertMgmt -.-> CertSubprocess
    ApiProcess -.-> ApiSubprocess
    
    %% Data store connections refinement
    UserDS -.->|User roles & permissions| AuthSubprocess
    CertDS -.->|Certificate data| CertSubprocess
    ApiLogDS -.->|Usage metrics| ApiSubprocess
    
    %% Styling
    classDef external fill:#90caf9,stroke:#1e88e5,color:#212121
    classDef process fill:#a5d6a7,stroke:#43a047,color:#212121
    classDef datastore fill:#ffe082,stroke:#ffa000,color:#212121
    classDef subprocess fill:#ce93d8,stroke:#8e24aa,color:#212121
    
    class User,Admins,ApiUsers,Amazon external
    class AuthProcess,CertMgmt,ProdMgmt,SearchProcess,ApiProcess,ReportProcess process
    class UserDS,CertDS,ProductDS,AuthLogDS,AuditLogDS,ApiLogDS datastore
    class AuthSubprocess,CertSubprocess,ApiSubprocess subprocess