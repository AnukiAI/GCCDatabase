    CERTIFICATES }|--|| PRODUCTS : certifies
    CERTIFICATES }|--|| CERTIFICATION_TYPES : has_type
    
    CSF_ATTRIBUTES ||--o{ CERTIFICATE_CSF_ATTRIBUTES : assigned_to
    EXTERNAL_TAGS ||--o{ CERTIFICATE_EXTERNAL_TAGS : assigned_to
    INTERNAL_TAGS ||--o{ CERTIFICATE_INTERNAL_TAGS : assigned_to
    CUSTOM_FIELDS ||--o{ CUSTOM_FIELD_VALUES : has_value
    
