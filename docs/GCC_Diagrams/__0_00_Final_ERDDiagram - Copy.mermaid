erDiagram
    %% Core business entities and relationships
    Certificate ||--|| Company : "belongs to"
    Certificate ||--|| Product : describes
    Certificate ||--|| CertificationType : "has type"
    Certificate }o--o{ CSFAttribute : "has"
    Certificate }o--o{ ExternalTag : "has"
    Certificate }o--o{ InternalTag : "has"
    Certificate ||--|| User : "created by"
    Certificate ||--o{ ProductIdentifier : "has"

    Product ||--|| ProductCategory : "in"
    ProductCategory ||--o{ ProductType : has
    ProductType ||--o{ ProductSubcategory : has

    User }o--o{ Group : "in"
    Group }o--o{ Permission : has
    User ||--o{ AuditLog : creates

    Certificate ||--o{ CustomFieldValue : has
    CustomFieldValue ||--|| CustomField : "for"

    API ||--|{ ENDPOINT : "has"
    API ||--|{ API_KEY : "manages"
    User ||--|{ API_KEY : "owns"
    API_KEY ||--|{ REQUEST_LOG : "logs"
    ENDPOINT ||--|{ REQUEST_LOG : "receives"
    API ||--|{ RATE_LIMIT : "applies to"
    User ||--|{ RATE_LIMIT : "restricted by"

    %% Entities
    Certificate {
        int id PK
        string certificate_number "Certificate #"
        int certification_type_id FK "Certification Type"
        string status
        date effective_date
        date expiration_date
        int company_id FK
        int product_id FK
        string location
        string country
        file certificate_file
        datetime created_at
        datetime updated_at
        int created_by_id FK
        int updated_by_id FK
    }

    ProductIdentifier {
        int id PK
        int certificate_id FK
        string type
        string value
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    Company {
        int id PK
        string name
        string contact_info
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    Product {
        int id PK
        string name
        int category_id FK
        int product_type_id FK
        int subcategory_id FK
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    ProductCategory {
        int id PK
        string name
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    ProductType {
        int id PK
        string name
        int category_id FK
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    ProductSubcategory {
        int id PK
        string name
        int product_type_id FK
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    CertificationType {
        int id PK
        string name
        string amazon_code
    }

    User {
        int id PK
        string username
        string email
        string password_hash
        boolean is_active
        boolean is_staff
        datetime created_at
        datetime updated_at
    }

    Group {
        int id PK
        string name
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    Permission {
        int id PK
        string codename
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    AuditLog {
        int id PK
        string action
        datetime timestamp
        string target_entity
        int target_id
    }

    CustomField {
        int id PK
        string name
        string field_type
        boolean is_public
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    CustomFieldValue {
        int id PK
        int certificate_id FK
        int field_id FK
        variant value
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    CSFAttribute {
        int id PK
        string name
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    ExternalTag {
        int id PK
        string name
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    InternalTag {
        int id PK
        string name
        int created_by_id FK
        int updated_by_id FK
        datetime created_at
        datetime updated_at
    }

    API {
        int id PK
        string name
        string description
        string base_url
        string version
        datetime created_at
        datetime updated_at
        int created_by_id FK
        int updated_by_id FK
    }

    ENDPOINT {
        int id PK
        int api_id FK
        string path
        string http_method
        string description
        boolean requires_auth
        datetime created_at
        datetime updated_at
        int created_by_id FK
        int updated_by_id FK
    }

    API_KEY {
        int id PK
        int user_id FK
        int api_id FK
        string key
        boolean is_active
        datetime expiration_date
        datetime created_at
    }

    REQUEST_LOG {
        int id PK
        int endpoint_id FK
        int api_key_id FK
        string client_ip
        datetime request_time
        int response_code
        string response_time
    }

    RATE_LIMIT {
        int id PK
        int api_id FK
        int user_id FK
        int max_requests
        int time_window
        datetime created_at
    }
