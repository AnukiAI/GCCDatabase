flowchart LR
    %% === Client Layer ===
    subgraph L1["Client Layer"]
        PublicUsers["🌐 Public Users"]
        AdminUsers["🛠 Admin Users"]
        Amazon["🛒 Amazon Marketplace"]
        ExternalAPI["🔗 External API Users"]
    end

    %% === Presentation Layer ===
    subgraph L2["Presentation Layer"]
        PublicUI["Public Interface"]
        AdminUI["Admin Interface"]
    end

    %% === API Layer ===
    subgraph L3["API Layer"]
        RESTAPI["RESTful API"]
        OAuth["OAuth2 Auth"]
        subgraph Endpoints["API Endpoints"]
            AuthEP["Auth"]
            CertEP["Certificates"]
            ProdEP["Products"]
            SearchEP["Search"]
            AmazonEP["Amazon API"]
        end
    end

    %% === Data Access Layer (Floating Left) ===
    subgraph L5["Data Access Layer"]
        ORM["Django ORM"]
        Query["Query Services"]
    end

    %% === Storage Layer (Floating Left) ===
    subgraph L6["Storage Layer"]
        DB[(🗄 PostgreSQL)]
        FileStore["📂 Certificate Files"]
    end

    %% === Application Layer (Center) ===
    subgraph L4["Application Layer"]
        Views["Django Views"]
        Logic["Business Logic"]
        Validation["Data Validation"]
        Authz["Authorization Logic"]
    end

    %% === Monitoring & Ops ===
    subgraph L7["Monitoring & Operations"]
        Logs["📝 Logging"]
        Monitor["📊 Monitoring"]
        Backup["💾 Backup System"]
    end

    %% === Database Models ===
    subgraph Models["Key Database Models"]
        Cert["Certificate"]
        Comp["Company"]
        Prod["Product"]
        Hier["Product Hierarchy"]
        CertType["Certification Type"]
        CSF["CSF Attribute"]
        Tags["Tags"]
        Custom["Custom Fields"]
    end

    %% === Connections ===

    %% Client to UI/API
     %%PublicUsers --> PublicUI
     %%AdminUsers --> AdminUI
    %% Amazon --> AmazonEP
     %%ExternalAPI --> RESTAPI

    %% UI to App
     %%PublicUI --> Views
     %%AdminUI --> Views

    %% API Flow
    %% RESTAPI --> Endpoints
    %% AuthEP --> OAuth
    %% OAuth --> Authz

    %% App Layer Flow
    %% Views --> Logic
    %% Logic --> Validation
   %%  Logic --> Authz
    %% Logic --> ORM

    %% Data & Storage to App
    %% ORM --> DB
     %%ORM --> FileStore
     %%Query --> DB

    %% Visual hint: float DAL/Storage to left
     %%ORM -.-> Logic
     %%DB -.-> Logic

    %% Monitoring/Logging
    %% L4 -.-> Logs
     %%L5 -.-> Logs
     %%L6 -.-> Monitor
     %%DB -.-> Backup
     %%FileStore -.-> Backup

    %% Database Models
     %%DB --- Models

    %% === Styling by Layer ===
    classDef client fill:#fdf2e9,stroke:#e67e22
    classDef ui fill:#d6eaf8,stroke:#2980b9
    classDef api fill:#d5f5e3,stroke:#27ae60
    classDef app fill:#fadbd8,stroke:#c0392b
    classDef data fill:#e8daef,stroke:#8e44ad
    classDef storage fill:#f2f3f4,stroke:#7f8c8d
    classDef ops fill:#fcf3cf,stroke:#f39c12
    classDef models fill:#f8f9f9,stroke:#95a5a6

    class L1 client
    class L2 ui
    class L3 api
    class L4 app
    class L5 data
    class L6 storage
    class L7 ops
    class Models models
